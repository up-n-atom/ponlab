
config network 'iface_0'
	option type 'veth'
	option flags 'up'
	option link 'br-lan'
	option hwaddr '00:FF:AA:00:00:00'
	option name 'veth_0'
	option mtu '1500'
	option ipv4 '192.168.1.101'

config network 'iface_1'
	option type 'veth'
	option flags 'up'
	option link 'br-lan'
	option hwaddr '00:FF:AA:00:00:01'
	option name 'veth_1'
	option mtu '1500'
	option ipv4 '192.168.1.102'

config container
	option container_name 'openwrt_container'
	option container_command 'down'
	option container_path '/srv/lxc'
	option arch 'mips'
	option rootfs_targz_url 'tftp://192.168.1.2/lede-malta-be-default-rootfs.tar.gz'
	option container_privilege 'unprivileged'
	option lxcuser 'lxcuser1'
	option uid_rootmap '20000'
	option uid_range '1000'
	option gid_rootmap '20000'
	option gid_range '1000'
	option kill_timeout '0'
	option utsname 'openwrt'
	option network_ipv4_gw '192.168.1.1'
	list interfaces 'iface_0'
	list mount_auto 'proc sys cgroup'
	list mount_auto 'proc:rw sys:rw cgroup-full:rw'
	list include_path '/usr/share/lxc/config/openwrt.common.conf'

config container
	option container_name 'buildroot_container'
	option container_command 'down'
	option container_path '/srv/lxc'
	option arch 'mips'
	option rootfs_targz_url 'tftp://192.168.1.2/rootfs.tar.gz'
	option container_privilege 'unprivileged'
	option lxcuser 'lxcuser2'
	option uid_rootmap '21001'
	option uid_range '1000'
	option gid_rootmap '21001'
	option gid_range '1000'
	option kill_timeout '0'
	option utsname 'buildroot'
	option network_ipv4_gw '192.168.1.1'
	list interfaces 'iface_1'
	list mount_auto 'proc sys cgroup'
	list mount_auto 'proc:rw sys:rw cgroup-full:rw'
	list include_path '/usr/share/lxc/config/openwrt.common.conf'

