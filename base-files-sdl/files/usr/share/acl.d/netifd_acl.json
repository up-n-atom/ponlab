{
	"user": "nwk",
	"group": "nwk",
	"access": {
		"service": {
			"methods": [
				"set",
				"add",
				"list",
				"delete",
				"signal",
				"update_start",
				"update_complete",
				"event",
				"validate",
				"get_data"
			]
		},
		"network.interface": {
			"methods": [
				"up",
				"down",
				"status",
				"prepare",
				"dump",
				"add_device",
				"remove_device",
				"notify_proto",
				"remove",
				"set_data"
			]
		},
		"network": {
			"methods": [
				"restart",
				"reload",
				"add_host_route",
				"get_proto_handlers",
				"add_dynamic"
			]
		},
		"network.wireless": {
			"methods": [
				"up",
				"down",
				"status",
				"status",
				"notify",
				"get_validate"
			]
		},
		"servd": {
			"methods": [
				"notify"
			]
		},
		"hostapd": {
			"methods": [
				"config_add",
				"config_remove"
			]
		},
		"hostapd.wlan*": {
			"methods": [
				"reload"
			]
		},
		"firewalld": {
			"methods": [
				"notify_netifd_update"
			]
		},
		"uci": {
			"methods": [
				"set",
				"get",
				"add",
				"delete",
				"order",
				"commit",
				"backup_restore"
			]
		}
	},
	"publish": [
		"dhcp_event",
		"network",
		"network.device",
		"network.wireless",
		"network.interface",
		"network.interface.*",
		"hostapd",
		"hostapd.wlan*"
	]
}
