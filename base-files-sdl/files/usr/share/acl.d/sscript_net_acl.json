{
	"group": "netctrl",
	"access": {
		"network": {
			"methods": [ "reload" ]
		},
		"network.interface": {
			"methods": [ "up", "down", "status", "prepare", "dump", "add_device", "remove_device", "notify_proto", "remove", "set_data" ]
		},
		"network.wireless": {
			"methods": [ "up", "down", "status", "notify", "get_validate" ]
		}
	},
	"listen": [ "ubus.object.add" ]
}
