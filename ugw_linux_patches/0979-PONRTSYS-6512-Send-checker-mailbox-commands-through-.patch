From 21d462cb7484e4efe28d182bbb595d31e833ad4f Mon Sep 17 00:00:00 2001
From: ofirbitt <ofir1.bitton@intel.com>
Date: Mon, 30 Dec 2019 14:11:27 +0200
Subject: [PATCH] PONRTSYS-6512: Send checker mailbox commands through egress
 uC

---
 drivers/net/ppv4/pp-hal/checker/checker.c              | 16 ++++++++++++----
 drivers/net/ppv4/pp-hal/checker/checker_internal.h     | 10 ++++++++++
 drivers/net/ppv4/pp-hal/micro-controller/uc.c          |  4 ++--
 drivers/net/ppv4/pp-hal/micro-controller/uc.h          |  4 +++-
 drivers/net/ppv4/pp-hal/micro-controller/uc_egr_mbox.c |  2 +-
 drivers/net/ppv4/pp-hal/micro-controller/uc_internal.h |  2 +-
 6 files changed, 29 insertions(+), 9 deletions(-)

diff --git a/drivers/net/ppv4/pp-hal/checker/checker.c b/drivers/net/ppv4/pp-hal/checker/checker.c
index f6e04ac99f50..76b0c66335af 100644
--- a/drivers/net/ppv4/pp-hal/checker/checker.c
+++ b/drivers/net/ppv4/pp-hal/checker/checker.c
@@ -19,7 +19,7 @@
 #include "checker.h"
 #include "infra.h"
 #include "pp_si.h"
-
+#include "uc.h"
 #include "fpga_ppv4.h"
 
 /**
@@ -95,10 +95,18 @@ dma_addr_t chk_excp_si_phys_base_get(void)
  */
 static inline void __chk_cmd_dispatch(u32 id, u32 cmd)
 {
+	struct uc_chk_cmd uc_cmd;
+	s32 ret;
+
+	uc_cmd.id = id;
+	uc_cmd.cmd = cmd;
 	pr_debug("id %u, cmd %#x\n", id, cmd);
-	PP_REG_WR32(PP_CHK_MBX_SESSION_ID_REG, id);
-	PP_REG_WR32(PP_CHK_MBX_COMMAND_REG, cmd);
-	PP_REG_WR32(CHK_MBOX_KICK_REG, 0);
+
+	/* send command */
+	ret = uc_egr_mbox_cmd_send_buff(UC_CMD_CHK_MBX, (u32 *)&uc_cmd,
+					sizeof(uc_cmd));
+	if (ret)
+		pr_err("UC_CMD_CHK_MBX command failed\n");
 }
 
 /**
diff --git a/drivers/net/ppv4/pp-hal/checker/checker_internal.h b/drivers/net/ppv4/pp-hal/checker/checker_internal.h
index a9ae608596d6..e51c8908e391 100644
--- a/drivers/net/ppv4/pp-hal/checker/checker_internal.h
+++ b/drivers/net/ppv4/pp-hal/checker/checker_internal.h
@@ -105,6 +105,16 @@ enum chk_mbox_cmd {
 	CHK_MBOX_CMD_COUNTERS,
 };
 
+/**
+ * @brief UC Mailbox command intended to checker
+ * @param id session id
+ * @param cmd checker mailbox command
+ */
+struct uc_chk_cmd {
+	u32 id;
+	u32 cmd;
+};
+
 /**
  * @brief Checker mailbox commands fields encoding
  */
diff --git a/drivers/net/ppv4/pp-hal/micro-controller/uc.c b/drivers/net/ppv4/pp-hal/micro-controller/uc.c
index e1ca6f40937c..8745f8bd53bb 100644
--- a/drivers/net/ppv4/pp-hal/micro-controller/uc.c
+++ b/drivers/net/ppv4/pp-hal/micro-controller/uc.c
@@ -73,6 +73,7 @@
 struct eg_uc_init_info {
 	u32 logger_buff;    /* logger buffer base address  */
 	u32 logger_buff_sz; /* logger buffer size in bytes */
+	u32 chk_base;       /* checker base address */
 };
 
 /**
@@ -85,7 +86,6 @@ struct reassembly_info {
 	u8  reserved;
 	u16 host_q;       /*! host queue to send packets to host upon failure */
 	u16 pp_rx_q;      /*! 2nd round queue                                 */
-	u32 chk_base;     /*! checker regs base for session counters update   */
 	u32 excp_si_base; /*! exception si base address                       */
 	u32 rxdma_base;   /*! rxdma regs base for calculating buffer size     */
 	u32 si_base;      /*! si base address                                 */
@@ -915,7 +915,6 @@ s32 __nf_reass_set(u16 tx_queue, u16 dflt_hif)
 	info.host_base_policy   = dflt_si.base_policy;
 	info.host_policies_bmap = dflt_si.policies_map;
 	info.host_pid           = dflt_si.eg_port;
-	info.chk_base           = UC_PP_ADDR(chk_base_addr);
 	info.rxdma_base         = UC_PP_ADDR(rxdma_base_addr);
 	info.excp_si_base       = UC_PP_ADDR(chk_excp_si_phys_base_get());
 	info.si_base            = (u32)cls_si_phys_base_get();
@@ -1164,6 +1163,7 @@ s32 __uc_egr_info_set(void)
 	memset(&info, 0, sizeof(info));
 	info.logger_buff    = (u32)logger_buff_phys;
 	info.logger_buff_sz = logger_buff_sz;
+	info.chk_base       = UC_PP_ADDR(chk_base_addr);
 
 	return uc_egr_mbox_cmd_send_buff(UC_CMD_INIT, (const u32 *)&info,
 					 sizeof(info));
diff --git a/drivers/net/ppv4/pp-hal/micro-controller/uc.h b/drivers/net/ppv4/pp-hal/micro-controller/uc.h
index 4583b040a3ed..a81546d3c01b 100644
--- a/drivers/net/ppv4/pp-hal/micro-controller/uc.h
+++ b/drivers/net/ppv4/pp-hal/micro-controller/uc.h
@@ -146,8 +146,10 @@ enum uc_mbox_cmd_type {
 	UC_CMD_TDOX_REMOVE,
 	/*! Get Tdox record */
 	UC_CMD_TDOX_STATS,
+	/*! Checker mailbox */
+	UC_CMD_CHK_MBX,
 
-	UC_CMD_LAST      = UC_CMD_FRAG_STATS,
+	UC_CMD_LAST      = UC_CMD_CHK_MBX,
 	UC_CMD_MAX       = U32_MAX,
 };
 
diff --git a/drivers/net/ppv4/pp-hal/micro-controller/uc_egr_mbox.c b/drivers/net/ppv4/pp-hal/micro-controller/uc_egr_mbox.c
index c945ad963681..724718c73931 100644
--- a/drivers/net/ppv4/pp-hal/micro-controller/uc_egr_mbox.c
+++ b/drivers/net/ppv4/pp-hal/micro-controller/uc_egr_mbox.c
@@ -206,7 +206,7 @@ s32 uc_egr_mbox_cmd_send_buff(enum uc_mbox_cmd_type type, const u32 *buff,
 
 	__mbox_lock();
 	/* copy data to FW buffer */
-	DDR_RD_REP(mbox_buf_virt, buff, len);
+	DDR_RD_REP(buff, mbox_buf_virt, len);
 	/* cache flush/evict */
 	if (IS_ENABLED(CONFIG_OF))
 		dma_map_single(pp_dev_get(), mbox_buf_virt, len, DMA_TO_DEVICE);
diff --git a/drivers/net/ppv4/pp-hal/micro-controller/uc_internal.h b/drivers/net/ppv4/pp-hal/micro-controller/uc_internal.h
index 9f11e0b60247..a821b240fa59 100644
--- a/drivers/net/ppv4/pp-hal/micro-controller/uc_internal.h
+++ b/drivers/net/ppv4/pp-hal/micro-controller/uc_internal.h
@@ -17,7 +17,7 @@
  * the version here
  */
 #define EGRESS_VER_MAJOR              (1)
-#define EGRESS_VER_MINOR              (6)
+#define EGRESS_VER_MINOR              (7)
 #define INGRESS_VER_MAJOR             (1)
 #define INGRESS_VER_MINOR             (1)
 #define UC_VER_MAJOR(t)               (t ## _VER_MAJOR)
