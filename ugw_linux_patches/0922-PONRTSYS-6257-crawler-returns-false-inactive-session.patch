From ca5bd8c8e2c8f7680da996fe0125763927cfebe2 Mon Sep 17 00:00:00 2001
From: Emergi Idan <idan.emergi@intel.com>
Date: Sun, 15 Dec 2019 13:21:25 +0200
Subject: [PATCH] PONRTSYS-6257: crawler returns false inactive sessions

Memset DSI memory to zero

Signed-off-by: Emergi Idan <idan.emergi@intel.com>
---
 .../ppv4/pp-api/pp-session-mgr/pp_session_mgr.c    | 26 +++++++++++-----------
 .../pp-api/pp-session-mgr/pp_session_mgr_debugfs.c |  9 +++++---
 drivers/net/ppv4/pp-hal/checker/checker.c          | 12 +++++++++-
 drivers/net/ppv4/pp-hal/classifier/classifier.c    |  3 +++
 4 files changed, 33 insertions(+), 17 deletions(-)

diff --git a/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c b/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c
index dd5843b6e589..8ab806993c48 100644
--- a/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c
+++ b/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c
@@ -3682,13 +3682,12 @@ static void __smgr_inactive_sess_list_get(struct inactive_work_args *w)
 	}
 
 	id = w->base_id - w->it_sz;
-	pr_debug("coverting sessions %u - %u\n",
-		 id, id + w->it_sz - 1);
-	for_each_set_bit_from(id, map, w->it_sz) {
+	pr_debug("converting sessions [%u - %u)\n", id, w->base_id);
+
+	for_each_set_bit_from(id, map, w->n_sessions) {
 		w->inact[w->inact_found++] = id;
-		pr_debug("session %u is inactive\n", id);
 		/* did we use all entries ?*/
-		if (w->inact_found == w->inact_n)
+		if (w->inact_found == w->inact_n || id == w->base_id)
 			break;
 	}
 
@@ -3824,14 +3823,15 @@ __smgr_inactive_args_prepare(struct pp_request *req, u32 *inact, u32 inact_sz)
 		return args;
 
 	/* set arguments for scanning all sessions */
-	args->base_id    = 0;
-	args->n_sessions = db->n_sessions;
-	args->it_sz      = it_sz;
-	args->bmap_phys  = db->inact_bmap_phys;
-	args->bmap_sz    = db->inact_bmap_sz;
-	args->inact      = inact;
-	args->inact_n    = inact_sz;
-	args->delay      = (ulong)delay;
+	args->base_id     = 0;
+	args->n_sessions  = db->n_sessions;
+	args->it_sz       = it_sz;
+	args->bmap_phys   = db->inact_bmap_phys;
+	args->bmap_sz     = db->inact_bmap_sz;
+	args->inact       = inact;
+	args->inact_n     = inact_sz;
+	args->inact_found = 0;
+	args->delay       = (ulong)delay;
 
 	return args;
 }
diff --git a/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr_debugfs.c b/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr_debugfs.c
index e55fe0224260..4876520fbad0 100644
--- a/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr_debugfs.c
+++ b/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr_debugfs.c
@@ -59,9 +59,12 @@ static void __smgr_dbg_inactive_cb(struct pp_inactive_list_cb_args *args)
 	}
 
 	pr_buf(buf, sz, n, "\n");
-	pr_buf_cat(buf, sz, n, " PP Inactive Sessions - Scan time %u ms\n",
-		   jiffies_to_msecs(scan_time));
-	pr_buf_cat(buf, sz, n, "======================\n");
+	pr_buf_cat(buf, sz, n,
+		   " %u PP Inactive Sessions Found - Scan time %u ms\n",
+		   args->n_sessions, jiffies_to_msecs(scan_time));
+	pr_buf_cat(buf, sz, n,
+		   "===================================================\n");
+
 	for (i = 1; i <= args->n_sessions; i++) {
 		pr_buf_cat(buf, sz, n, "%u ", args->inact_sess[i - 1]);
 		if (!(i % 10))
diff --git a/drivers/net/ppv4/pp-hal/checker/checker.c b/drivers/net/ppv4/pp-hal/checker/checker.c
index 8e806111b2fe..f6e04ac99f50 100644
--- a/drivers/net/ppv4/pp-hal/checker/checker.c
+++ b/drivers/net/ppv4/pp-hal/checker/checker.c
@@ -424,6 +424,15 @@ s32 chk_crawler_idle_wait(u32 *attempts)
 		return -EBUSY;
 	}
 
+	ret = pp_raw_reg_poll(PP_CHK_MBX_CRWLR_STATUS_REG,
+			      CHK_CRWLR_STATUS_CMD_CNTR, 0,
+			      PP_REG_MAX_RETRIES, attempts,
+			      NULL, PP_POLL_EQ);
+	if (unlikely(ret)) {
+		pr_err("crawler stuck in busy state\n");
+		return -EBUSY;
+	}
+
 	return ret;
 }
 
@@ -998,7 +1007,6 @@ s32 __chk_ddr_allocate(void)
 		db->dsi_base_virt = (void *)DDR_DSI_BASE;
 		db->dsi_base_phys = DDR_DSI_BASE;
 #endif
-		DDR_MEMSET(db->dsi_base_phys, db->dsi_sz, 0);
 	} else {
 		db->dsi_sz = PAGE_ALIGN(db->n_sessions *
 					sizeof(struct pp_hw_dsi));
@@ -1012,6 +1020,8 @@ s32 __chk_ddr_allocate(void)
 			return -ENOMEM;
 		}
 	}
+	DDR_MEMSET(db->dsi_base_virt, db->dsi_sz, 0);
+
 	return 0;
 }
 
diff --git a/drivers/net/ppv4/pp-hal/classifier/classifier.c b/drivers/net/ppv4/pp-hal/classifier/classifier.c
index 50d8fa0b7a1e..5114510d7348 100644
--- a/drivers/net/ppv4/pp-hal/classifier/classifier.c
+++ b/drivers/net/ppv4/pp-hal/classifier/classifier.c
@@ -1216,6 +1216,9 @@ s32 __cls_ddr_allocate(void)
 		goto mem_alloc_failed_ht2;
 	}
 
+	memset(db->ht1_base_virt, 0, db->ht1_sz);
+	memset(db->ht2_base_virt, 0, db->ht2_sz);
+
 	return 0;
 
 mem_alloc_failed_ht2:
