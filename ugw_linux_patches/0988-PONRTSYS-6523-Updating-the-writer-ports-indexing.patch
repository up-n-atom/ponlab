From 84bc6a9d080a15f8ace76a59050f84aa1ed979b8 Mon Sep 17 00:00:00 2001
From: Elad Fernandes <elad.fernandes@intel.com>
Date: Thu, 16 Jan 2020 18:32:45 +0200
Subject: [PATCH] PONRTSYS-6523: Updating the writer ports indexing

---
 drivers/net/ppv4/pp-hal/micro-controller/uc.c            |  3 +++
 drivers/net/ppv4/pp-hal/micro-controller/uc_egr_mbox.c   | 14 ++++++--------
 drivers/net/ppv4/pp-hal/micro-controller/uc_internal.h   | 16 ++++++++++++----
 drivers/net/ppv4/pp-hal/micro-controller/uc_regs.h       |  7 +------
 .../net/ppv4/pp-hal/micro-controller/uc_shared_engines.h |  4 ++--
 5 files changed, 24 insertions(+), 20 deletions(-)

diff --git a/drivers/net/ppv4/pp-hal/micro-controller/uc.c b/drivers/net/ppv4/pp-hal/micro-controller/uc.c
index 236fa00fe84f..ab67be636304 100644
--- a/drivers/net/ppv4/pp-hal/micro-controller/uc.c
+++ b/drivers/net/ppv4/pp-hal/micro-controller/uc.c
@@ -1178,6 +1178,9 @@ s32 uc_nf_set(enum pp_nf_type nf, u16 pid, u16 qos_port, u16 tx_queue,
 		return -EINVAL;
 	}
 
+	if (pp_silicon_step_get() != PP_SSTEP_A)
+		uc_port += UC_B_TXMGR_PORT_OFF;
+
 	return __writer_port_enable(uc_port, qos_port);
 }
 
diff --git a/drivers/net/ppv4/pp-hal/micro-controller/uc_egr_mbox.c b/drivers/net/ppv4/pp-hal/micro-controller/uc_egr_mbox.c
index 1ecc33e37c0e..26d6daac1a54 100644
--- a/drivers/net/ppv4/pp-hal/micro-controller/uc_egr_mbox.c
+++ b/drivers/net/ppv4/pp-hal/micro-controller/uc_egr_mbox.c
@@ -2,7 +2,7 @@
  * Description: PP Egress micro-controllers mailbox
  *
  * SPDX-License-Identifier: GPL-2.0-only
- * Copyright (C) 2019 Intel Corporation
+ * Copyright (C) 2019-2020 Intel Corporation
  */
 
 #define pr_fmt(fmt) "[PP_UC_MBOX]:%s:%d: " fmt, __func__, __LINE__
@@ -106,14 +106,12 @@ static bool __cmd_port_is_ready(void)
 {
 	u64 reg;
 
-	if (pp_silicon_step_get() == PP_SSTEP_A)
+	if (pp_silicon_step_get() == PP_SSTEP_A) {
 		reg = UC_EGR_A_MBOX_MSG0_WR_STATUS;
-	else
-		reg = UC_EGR_B_MBOX_PORT_WR_STATUS(UC_MBOX_PORT);
-
-	if (unlikely(pp_reg_poll(reg, 0xFF, 0))) {
-		pr_err("command interface not ready\n");
-		return false;
+		if (unlikely(pp_reg_poll(reg, 0xFF, 0))) {
+			pr_err("command interface not ready\n");
+			return false;
+		}
 	}
 
 	return true;
diff --git a/drivers/net/ppv4/pp-hal/micro-controller/uc_internal.h b/drivers/net/ppv4/pp-hal/micro-controller/uc_internal.h
index 7822adadfe91..6e22c66ff2e7 100644
--- a/drivers/net/ppv4/pp-hal/micro-controller/uc_internal.h
+++ b/drivers/net/ppv4/pp-hal/micro-controller/uc_internal.h
@@ -17,9 +17,9 @@
  * the version here
  */
 #define EGRESS_VER_MAJOR              (1)
-#define EGRESS_VER_MINOR              (7)
+#define EGRESS_VER_MINOR              (8)
 #define INGRESS_VER_MAJOR             (1)
-#define INGRESS_VER_MINOR             (1)
+#define INGRESS_VER_MINOR             (2)
 #define UC_VER_MAJOR(t)               (t ## _VER_MAJOR)
 #define UC_VER_MINOR(t)               (t ## _VER_MINOR)
 
@@ -58,17 +58,25 @@ struct uc_log_msg {
 	char func[16];
 };
 
+/**
+ * @brief for B-step the tx manager uc ports starts from port 16
+ */
+#define UC_B_TXMGR_PORT_OFF 4
+
 /**
  * @enum uc_egr_port
  * @brief uc egress port type
  */
 enum uc_egr_port {
-	UC_MCAST_PORT,
+	/*! mailbox port is valid only for B-step */
+	UC_MBOX_PORT = 0,
+	/*! tx manager ports starting from port 0 */
+	/*! in B-step required UC_B_TXMGR_PORT_OFF offset */
+	UC_MCAST_PORT = 0,
 	UC_REASS_PORT,
 	UC_FRAG_PORT,
 	UC_TDOX_PORT,
 	UC_IPSEC_PORT,
-	UC_MBOX_PORT = 16,
 	UC_EGR_MAX_PORT,
 };
 
diff --git a/drivers/net/ppv4/pp-hal/micro-controller/uc_regs.h b/drivers/net/ppv4/pp-hal/micro-controller/uc_regs.h
index 015013af67fa..77c2d52af460 100644
--- a/drivers/net/ppv4/pp-hal/micro-controller/uc_regs.h
+++ b/drivers/net/ppv4/pp-hal/micro-controller/uc_regs.h
@@ -213,9 +213,6 @@ extern u64 uc_ing_base_addr;
  */
 #define UC_SHRD_REG_IDX(t, a, r, w)    (UC_SHRD_REG(t, a, r) | ((w) << 2))
 
-#define UC_SHRD_REG_IDX_IDX(t, e, r, x, y)\
-	(UC_SHRD_REG(t, e, r) | ((x) << 8) | ((y) << 2))
-
 /***** READER REGISTERS *****/
 /* READER_IRR */
 #define UC_A_READER_IRR(t)             UC_SHRD_REG(t, READER_A, IRR)
@@ -266,7 +263,7 @@ extern u64 uc_ing_base_addr;
 #define UC_B_READER_MB_BUSY(t, n)      UC_SHRD_REG_IDX(t, READER_B, MB_BUSY, n)
 
 #define UC_B_WRITER_PORT_SPEC(t, x, y)\
-	(UC_SHRD_REG(t, WRITER_B, PORT_SPEC) | (((x) * 12) + ((y) << 2)))
+	(UC_SHRD_REG(t, WRITER_B, PORT_SPEC) | ((((x) * 12) + (y)) << 2))
 
 /***** WRITER EGRESS REGISTERS *****/
 /* WRITER_TX_PORT */
@@ -316,8 +313,6 @@ extern u64 uc_ing_base_addr;
 
 #define UC_EGR_A_MBOX_MSG0_WR_STATUS   \
 	UC_SHRD_REG_IDX(EGRESS, WRITER_A, MB_STATUS,  0)
-#define UC_EGR_B_MBOX_PORT_WR_STATUS(p)\
-	UC_SHRD_REG_IDX(EGRESS, WRITER_B, STATUS_SPEC, p)
 
 #define UC_EGR_MBOX_MSG1_WR_ADDRESS    \
 	UC_SHRD_REG_IDX(EGRESS, WRITER_A, MB_MESSAGE, 4)
diff --git a/drivers/net/ppv4/pp-hal/micro-controller/uc_shared_engines.h b/drivers/net/ppv4/pp-hal/micro-controller/uc_shared_engines.h
index 8dce141032ee..da8751d39fdf 100644
--- a/drivers/net/ppv4/pp-hal/micro-controller/uc_shared_engines.h
+++ b/drivers/net/ppv4/pp-hal/micro-controller/uc_shared_engines.h
@@ -160,7 +160,7 @@
  */
 #define CLUSTERBRIDGE_B_FAT       1
 #define CLUSTERBRIDGE_B_IRR       3
-#define CLUSTERBRIDGE_B_VALID     6
-#define CLUSTERBRIDGE_B_BASE      7
+#define CLUSTERBRIDGE_B_BASE      6
+#define CLUSTERBRIDGE_B_VALID     7
 
 #endif /* __PP_UC_SHARED_ENGINES_H__ */
