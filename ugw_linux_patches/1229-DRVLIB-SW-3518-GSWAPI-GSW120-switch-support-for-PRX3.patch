 	return GSW_statusOk;
 }
 
+static void prx300_gsw_ext_config(void *cdev)
+{
+	u8 port_idx;
+
+	/*  Enable and Restart Autonegotiation
+	 * Timer Delay is 1.6 ms for SGMII
+	 */
+	gsw_w32(cdev, SGMII_TBI_ANEGCTL_OFFSET,
+		SGMII_TBI_ANEGCTL_SHIFT,
+		SGMII_TBI_ANEGCTL_SIZE, 0xFD);
+	/*  Enable Autonegotiation
+	 * Timer Delay is 1.6 ms for SGMII
+	 */
+	gsw_w32(cdev, SGMII_TBI_ANEGCTL_OFFSET,
+		SGMII_TBI_ANEGCTL_SHIFT,
+		SGMII_TBI_ANEGCTL_SIZE, 0xF5);
+	/* All unknown multicast are forwarded
+	 * to SGMII (SoC) Port
+	 */
+	gsw_w32(cdev, PCE_PMAP_2_DMCPMAP_OFFSET,
+		PCE_PMAP_2_DMCPMAP_SHIFT,
+		PCE_PMAP_2_DMCPMAP_SIZE, 0x10);
+	/* All unknown unicast are forwarded
+	 * to SGMII (SoC) Port
+	 */
+	gsw_w32(cdev, PCE_PMAP_3_UUCMAP_OFFSET,
+		PCE_PMAP_3_UUCMAP_SHIFT,
+		PCE_PMAP_3_UUCMAP_SIZE, 0x10);
+	gsw_w32(cdev, (PCE_PCTRL_0_IGSTEN_OFFSET + (0xa * 4)),
+		PCE_PCTRL_0_IGSTEN_SHIFT,
+		PCE_PCTRL_0_IGSTEN_SIZE, 1);
+	gsw_w32(cdev, (PCE_PCTRL_0_EGSTEN_OFFSET + (0xa * 4)),
+		PCE_PCTRL_0_EGSTEN_SHIFT,
+		PCE_PCTRL_0_EGSTEN_SIZE, 1);
+	/* Special Tag Insertion Enable, special tag can be
+	 * inserted to egress frames
+	 */
+	gsw_w32(cdev, (FDMA_PCTRL_STEN_OFFSET + (0x6 * 4)),
+		FDMA_PCTRL_STEN_SHIFT,
+		FDMA_PCTRL_STEN_SIZE, 1);
+	/* Egress Special Tag Ethertype */
+	gsw_w32(cdev, FDMA_STETYPE_ETYPE_OFFSET,
+		FDMA_STETYPE_ETYPE_SHIFT,
+		FDMA_STETYPE_ETYPE_SIZE, 0x88C4);
+	for (port_idx = 0; port_idx <= 4; port_idx++)
+		/** Disable learning on the port specified. */
+		gsw_w32(cdev, (PCE_PCTRL_3_LNDIS_OFFSET + (0xA * port_idx)),
+			PCE_PCTRL_3_LNDIS_SHIFT,
+			PCE_PCTRL_3_LNDIS_SIZE, 1);
+
+	gsw_w32(cdev, SGMII_TBI_LPSTAT_OFFSET,
+		SGMII_TBI_LPSTAT_SHIFT,
+		SGMII_TBI_LPSTAT_SIZE, 0x41);
+}
