+			BM_PCFG_CNTEN_SHIFT,
+			BM_PCFG_CNTEN_SIZE, 1);
+	}
 
-	/*Initalize GSWIP Irq*/
-	GSW_Irq_init(cdev);
+	if (gswdev->gipver == LTQ_GSWIP_3_0)
+		/*Initialize GSWIP Irq*/
+		GSW_Irq_init(cdev);
 
 	return GSW_statusOk;
 }
