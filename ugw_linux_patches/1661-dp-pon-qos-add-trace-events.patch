+		__entry->port = sch->port;
+		__entry->sch_id = sch->sch_id;
+		__entry->qid = q->qid;
+	),
+
+	TP_printk("[%s] hdls:%#x/%#x port:%u sch_id:%u qid:%u",
+		  __get_str(name), __entry->parent, __entry->handle,
+		  __entry->port, __entry->sch_id, __entry->qid)
+);
