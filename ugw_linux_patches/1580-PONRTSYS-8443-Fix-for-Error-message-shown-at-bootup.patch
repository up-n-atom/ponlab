From 6860aaa0746c0fb51e1723a0d5cc6433adbe95d1 Mon Sep 17 00:00:00 2001
From: thampan <joby.thampan@intel.com>
Date: Tue, 19 Jan 2021 10:28:17 +0800
Subject: [PATCH] PONRTSYS-8443: Fix for Error message shown at bootup

---
 drivers/net/datapath/dpm/gswip31/datapath_misc.c | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/drivers/net/datapath/dpm/gswip31/datapath_misc.c b/drivers/net/datapath/dpm/gswip31/datapath_misc.c
index 0fda89273823..9df8d14fdb10 100644
--- a/drivers/net/datapath/dpm/gswip31/datapath_misc.c
+++ b/drivers/net/datapath/dpm/gswip31/datapath_misc.c
@@ -977,6 +977,10 @@ int alloc_cpu_q(int inst, struct cbm_cpu_port_data *cpu_data,
 		q_port->tx_ring_size = re_insertion->tx_ring_size;
 
 	} else {
+		/* All CPU ports enabled have valid CQM Deq port otherwise -1 */
+		if (tx_push->deq_port == -1)
+			return DP_FAILURE;
+
 		q_port->cqe_deq = tx_push->deq_port;
 		q_port->tx_pkt_credit = tx_push->tx_pkt_credit;
 		q_port->tx_ring_addr = (void *)tx_push->txpush_addr_qos;
