From 9f82e62414d2f4930c1de102be7dc78491f4b8f1 Mon Sep 17 00:00:00 2001
From: Elad Fernandes <elad.fernandes@intel.com>
Date: Mon, 13 Apr 2020 12:31:13 +0300
Subject: [PATCH] PONRTSYS-7747: Adding parser fallback option for ip packets
 in a-step

---
 drivers/net/ppv4/pp-hal/parser/parser_protocols.c | 21 +++++++++++++++++----
 1 file changed, 17 insertions(+), 4 deletions(-)

diff --git a/drivers/net/ppv4/pp-hal/parser/parser_protocols.c b/drivers/net/ppv4/pp-hal/parser/parser_protocols.c
index 9cde969d0b5b..b69cc5bac2a4 100644
--- a/drivers/net/ppv4/pp-hal/parser/parser_protocols.c
+++ b/drivers/net/ppv4/pp-hal/parser/parser_protocols.c
@@ -13,6 +13,7 @@
 #include <linux/errno.h>
 #include <linux/bitops.h>
 
+#include "infra.h"
 #include "parser_protocols.h"
 #include "pp_fv.h"
 #include "parser.h"
@@ -834,6 +835,10 @@ static s32 __proto_ipv4_init(struct protocol_info *info)
 	/* set fv index value to the first IPv4 */
 	params->ext.fld[0].fv_idx = offsetof(struct pp_fv, first.l3.v4);
 	params->ext.fld[1].fv_idx = offsetof(struct pp_fv, first.l3.v4.saddr);
+	/* for A-step, sending all ip packets to the ingress uc */
+	if (pp_silicon_step_get() == PP_SSTEP_A)
+		params->fallback = true;
+
 	__proto_pr_debug(info);
 	pr_debug("done\n");
 
@@ -966,6 +971,10 @@ static s32 __proto_ipv6_init(struct protocol_info *info)
 	/* extracting info */
 	params->ext.fld[0].fv_idx = offsetof(struct pp_fv, first.l3.v6);
 	params->ext.fld[1].fv_idx = offsetof(struct pp_fv, first.l3.v6.saddr);
+	/* for A-step, sending all ip packets to the ingress uc */
+	if (pp_silicon_step_get() == PP_SSTEP_A)
+		params->fallback = true;
+
 	__proto_pr_debug(info);
 	pr_debug("done\n");
 
@@ -2115,8 +2124,7 @@ static s32 __proto_vxlan_init(struct protocol_info *info)
 	params->proto_id   = VXLAN_UDP_DPORT;
 	params->hw_idx     = TABLE_ENTRY_INVALID_IDX;
 	params->hdr_len    = sizeof(struct vxlanhdr);
-	/* TBD - type NONE is bypassing the HW abort validation */
-	params->entry_type = ETYPE_RSRV_L4;
+	params->entry_type = ETYPE_NONE;
 	/* next protocol info - next protocol is always MAC header */
 	np = &params->np;
 	np->logic = NP_LOGIC_END;
@@ -2173,8 +2181,7 @@ static s32 __proto_geneve_init(struct protocol_info *info)
 	params->proto_id   = GENEVE_UDP_DPORT;
 	params->hw_idx     = TABLE_ENTRY_INVALID_IDX;
 	params->hdr_len    = offsetof(struct genevehdr, options);
-	/* TBD - type NONE is bypassing the HW abort validation */
-	params->entry_type = ETYPE_RSRV_L4;
+	params->entry_type = ETYPE_NONE;
 	/* next protocol info - next protocol is always MAC header */
 	np = &params->np;
 	np->logic = NP_LOGIC_END;
@@ -2389,6 +2396,12 @@ s32 __prsr_protocols_init(struct protocols *protos)
 	INIT_MERGE(PRSR_PROFILE_COMMON, PRSR_PROTO_MAC_INT,
 		   PRSR_PROTO_QINQ, PRSR_PROTO_QINQ,
 		   protos, ret, i);
+	INIT_MERGE(PRSR_PROFILE_COMMON, PRSR_PROTO_UDP,
+		   PRSR_PROTO_VXLAN, PRSR_PROTO_VXLAN,
+		   protos, ret, i);
+	INIT_MERGE(PRSR_PROFILE_COMMON, PRSR_PROTO_UDP,
+		   PRSR_PROTO_GENEVE, PRSR_PROTO_GENEVE,
+		   protos, ret, i);
 	protos->n_merge = i;
 
 	return ret;
