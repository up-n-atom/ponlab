From 74ce449c70c3bdff364c80ddf5190baf53620dcf Mon Sep 17 00:00:00 2001
From: "Vishnu Swaroop Kumar Sarma, Duddu" <duddu.swaroop@intel.com>
Date: Tue, 14 Apr 2020 00:37:33 +0530
Subject: [PATCH] UGW_SW-49323 add dev2 switch api routines to access from
 kernel

---
 drivers/net/ethernet/lantiq/switch-api/gsw_ioctl_wrapper.c | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/drivers/net/ethernet/lantiq/switch-api/gsw_ioctl_wrapper.c b/drivers/net/ethernet/lantiq/switch-api/gsw_ioctl_wrapper.c
index b921227c98a2..2c3e9a86876f 100644
--- a/drivers/net/ethernet/lantiq/switch-api/gsw_ioctl_wrapper.c
+++ b/drivers/net/ethernet/lantiq/switch-api/gsw_ioctl_wrapper.c
@@ -464,6 +464,8 @@ GSW_API_HANDLE gsw_api_kopen(char *name)
 		}
 	} else if (!strcmp(name, "1")) {
 		pLlHandle = pdev->pEthSWDev[1];
+	} else if (!strcmp(name, "2")) {
+		pLlHandle = pdev->pEthSWDev[2];
 	} else {
 		pr_err("\nNot support external switch number = %s\n\n", name);
 		return 0;
@@ -498,6 +500,8 @@ int gsw_api_kioctl(GSW_API_HANDLE handle, u32 command, void *arg)
 		cmd_handle->pLlHandle = pdev->pEthSWDev[0];
 	} else if (handle == (GSW_API_HANDLE)pdev->pEthSWDev[1]) {
 		cmd_handle->pLlHandle = pdev->pEthSWDev[1];
+	} else if (handle == (GSW_API_HANDLE)pdev->pEthSWDev[2]) {
+		cmd_handle->pLlHandle = pdev->pEthSWDev[2];
 	}	else {
 		pr_err("ERROR:Provided wrong address ( Address:0x%p) %s:%s:%d\n",
 		       handle, __FILE__, __func__, __LINE__);
