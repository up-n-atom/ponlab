+	pool_id  = find_first_bit(active_pools, PP_BM_MAX_POOLS);
+	pool_id2 = find_next_bit(active_pools, PP_BM_MAX_POOLS, pool_id + 1);
+	pr_info("pool_id %u, pool_id2 %u\n", pool_id, pool_id2);
