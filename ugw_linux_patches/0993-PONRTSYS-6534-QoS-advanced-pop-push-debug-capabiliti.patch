-s32 bmgr_test_dma(u32 num_bytes)
-{
-	void          *addr = NULL;
-	void          *addr1 = NULL;
-	dma_addr_t    dma;
-	dma_addr_t    dma1;
-
-#ifdef CONFIG_PPV4_FPGA
-	addr = (void *)DDR_PP_DEBUG_BM_COPY_DMA_TEST_ADDR;
-	dma = (u32)addr;
-	addr1 = (void *)(DDR_PP_DEBUG_BM_COPY_DMA_TEST_ADDR + 8);
-	dma1 = (u32)addr1;
-	DDR_WR32((u32)addr, 0);
-	DDR_WR32((u32)(addr + 4), 0);
-	DDR_WR32((u32)addr1, 0xcafecafe);
-	DDR_WR32((u32)(addr1 + 4), 0x12345678);
-#else
-	addr = dma_alloc_coherent(NULL, 2 * sizeof(u32), &dma,
-				  GFP_KERNEL | GFP_DMA);
-	if (!addr) {
-		pr_err("Could not allocate addr using dma_alloc_coherent\n");
-		return -ENOMEM;
-	}
-
-	addr1 = dma_alloc_coherent(NULL, 2 * sizeof(u32), &dma1,
-				   GFP_KERNEL | GFP_DMA);
-	if (!addr1) {
-		pr_err("Could not allocate addr1 using dma_alloc_coherent\n");
-		dma_free_coherent(NULL, 2 * sizeof(u32), addr, dma);
-		return -ENOMEM;
-	}
-	PP_REG_WR32(addr, 0);
-	PP_REG_WR32((addr + 4), 0);
-	PP_REG_WR32(addr1, 0xcafecafe);
-	PP_REG_WR32((addr1 + 4), 0x12345678);
-#endif
-
-	pr_info("ADDRESSES ======> %#lx[%#lx] ; %#lx[%#lx] ; %#lx[%#lx] ; %#lx[%#lx]\n",
-		(ulong)addr, (ulong)dma, (ulong)addr + 4, (ulong)dma + 4,
-		(ulong)addr1, (ulong)dma1, (ulong)addr1 + 4, (ulong)dma1 + 4);
-
-#ifdef CONFIG_PPV4_FPGA
-	pr_info("Before TEST ======> 0x%x ; 0x%x ; 0x%x ; 0x%x\n",
-		DDR_RD32((u32)addr), DDR_RD32((u32)addr + 4),
-		DDR_RD32((u32)addr1), DDR_RD32((u32)addr1 + 4));
-	/* BIT(31): kick, 4<<18: 8 byte burst */
-	__copy_dma((u32)dma1, (u32)dma, (BIT(31) | 4 << 18 | num_bytes));
-	pr_info("After TEST ======> 0x%x ; 0x%x ; 0x%x ; 0x%x\n",
-		DDR_RD32((u32)addr), DDR_RD32((u32)(addr + 4)),
-		DDR_RD32((u32)addr1), DDR_RD32((u32)(addr1 + 4)));
-
-	if ((DDR_RD32((u32)addr) == DDR_RD32((u32)addr1)) &&
-	    (DDR_RD32((u32)(addr + 4)) == DDR_RD32((u32)(addr1 + 4)))) {
-		pr_info("\nDMA Test OK\n");
-	} else {
-		pr_info("\nDMA Test Failed\n");
-	}
-#else
-	pr_info("Before TEST ======> 0x%x ; 0x%x ; 0x%x ; 0x%x\n",
-		PP_REG_RD32(addr), PP_REG_RD32(addr + 4),
-		PP_REG_RD32(addr1), PP_REG_RD32(addr1 + 4));
-	__copy_dma((u32)dma1, (u32)dma, (BIT(31) | 4 << 18 | num_bytes));
-	pr_info("After TEST ======> 0x%x ; 0x%x ; 0x%x ; 0x%x\n",
-		PP_REG_RD32(addr), PP_REG_RD32(addr + 4),
-		PP_REG_RD32(addr1), PP_REG_RD32(addr1 + 4));
-
-	if ((PP_REG_RD32(addr) == PP_REG_RD32(addr1)) &&
-	    (PP_REG_RD32(addr + 4) == PP_REG_RD32(addr1 + 4))) {
-		pr_info("\nDMA Test OK\n");
-	} else {
-		pr_info("\nDMA Test Failed\n");
-	}
-
-	dma_free_coherent(NULL, 2 * sizeof(u32), addr1, dma1);
-	dma_free_coherent(NULL, 2 * sizeof(u32), addr, dma);
-#endif
-	return 0;
