-s32 bmgr_pop_buffer(struct pp_bmgr_buff_info * const buff_info)
-{
-	dma_addr_t dma;
-	u32        address = BM_DATAPATH_BASE;
-	u32        idx = 0;
-	u32        low = 0;
-	u32        high = 0;
-	void       *addr;
-	u16        offset = 0;
-	struct     bmgr_policy_db_entry *policy;
-
-	if (unlikely(!__bmgr_is_ready()))
-		return -EPERM;
-
-	if (!buff_info) {
-		pr_err("buff_info is NULL\n");
-		return -EINVAL;
-	}
-
-	if (buff_info->num_allocs > PP_BM_MAX_BURST_IN_POP) {
-		pr_err("num_allocs %d is limited with %d\n",
-		       buff_info->num_allocs, PP_BM_MAX_BURST_IN_POP);
-		return -EINVAL;
-	}
-
-	/* Write the Single/Burst bit */
-	if (buff_info->num_allocs > 1)
-		address |= BIT(16);
-
-	policy = &db->policies[buff_info->policy_id];
-
-	/* Write the Policy */
-	address |= (buff_info->policy_id << 8);
-
-#ifdef CONFIG_PPV4_FPGA
-	addr = (void *)DDR_PP_DEBUG_BM_POP_TEST_ADDR;
-	dma = (u32)addr;
-#else
-	addr = dma_alloc_coherent(NULL,
-				  2 * sizeof(u32) * buff_info->num_allocs,
-				  &dma, GFP_KERNEL | GFP_DMA);
-	if (!addr) {
-		pr_err("Could not allocate using dma_alloc_coherent\n");
-		return -ENOMEM;
-	}
-#endif
-
-	__copy_dma(address, (u32)dma,
-		   (0x80100000 | (8 * buff_info->num_allocs)));
-
-	for (idx = 0; idx < buff_info->num_allocs; idx++) {
-#ifdef CONFIG_PPV4_FPGA
-		low = DDR_RD32((u32)(addr + offset));
-		high = DDR_RD32((u32)(addr + offset + 4));
-#else
-		low = PP_REG_RD32(addr + offset);
-		high = PP_REG_RD32(addr + offset + 4);
-#endif
-		offset += 8;
-
-		pr_info("POP ======> 0x%x ; 0x%x\n", low, high);
-
-		buff_info->addr_low[idx] = low;
-		buff_info->addr_high[idx] = high & 0xF;
-		buff_info->pool_id[idx] = (high & 0xFF000000) >> 24;
-
-		pr_info("---> pop buffer from address 0x%x (pool %u, addr low 0x%x, addr high 0x%x)\n",
-			address, buff_info->pool_id[idx],
-			buff_info->addr_low[idx],
-			buff_info->addr_high[idx]);
-
-		if (buff_info->pool_id[idx] >=
-		    db->cfg.max_pools) {
-			policy->num_allocated_buffers += idx;
-			pr_info("Can't pop from policy %d\n",
-				buff_info->policy_id);
-			return -ENOSPC;
-		}
-
-		db->pools[buff_info->pool_id[idx]].
-			num_allocated_buffers++;
-	}
-
-	policy->num_allocated_buffers += buff_info->num_allocs;
-
-	return 0;
-}
-
-s32 bmgr_push_buffer(struct pp_bmgr_buff_info * const buff_info)
-{
-	u32 address = BM_DATAPATH_BASE;
-	u32 value = 0;
-	u32 idx = 0;
-	u32 ptr2push[2 * PP_BM_MAX_BURST_IN_POP]; /* 64 bit per allocation */
-	struct bmgr_policy_db_entry *policy;
-
-	if (unlikely(!__bmgr_is_ready()))
-		return -EPERM;
-
-	if (unlikely(!buff_info)) {
-		pr_err("buff_info is NULL\n");
-		return -EINVAL;
-	}
-
-	if (unlikely(!buff_info->num_allocs)) {
-		pr_err("num_allocs cannnot be 0\n");
-		return -EINVAL;
-	}
-
-	if (unlikely(buff_info->num_allocs > PP_BM_MAX_BURST_IN_POP)) {
-		pr_err("num_allocs %d is limited with %d\n",
-		       buff_info->num_allocs, PP_BM_MAX_BURST_IN_POP);
-		return -EINVAL;
-	}
-
-	/* Write the Single/Burst bit */
-	if (buff_info->num_allocs > 1)
-		address |= BIT(16);
-
-	/* Write the Policy */
-	address |= (buff_info->policy_id << 8);
-
-	/* write to ddr */
-	for (idx = 0; idx < buff_info->num_allocs; idx++) {
-		ptr2push[2 * idx] = buff_info->addr_low[idx];
-		value = (buff_info->addr_high[idx] & 0xF) |
-			 ((buff_info->pool_id[idx] & U8_MAX) << 24);
-		ptr2push[2 * idx + 1] = value;
-
-		pr_info("<--- push buffer to address 0x%x (pool %d, addr low 0x%x, addr high 0x%x, value %u)\n",
-			address, buff_info->pool_id[idx],
-			buff_info->addr_low[idx],
-			buff_info->addr_high[idx], value);
-
-		db->pools[buff_info->pool_id[idx]].
-			num_deallocated_buffers++;
-	}
-
-	__copy_dma(ptr2push[0], address,
-		   (0x80100000 | (8 * buff_info->num_allocs))/*0x80100008*/);
-
-	policy = &db->policies[buff_info->policy_id];
-	policy->num_deallocated_buffers += buff_info->num_allocs;
-
-	return 0;
-}
-
 static s32
 __bmgr_pool_configure(const struct pp_bmgr_pool_params * const pool_params,
 		      u8 *pool_id, bool lock)
