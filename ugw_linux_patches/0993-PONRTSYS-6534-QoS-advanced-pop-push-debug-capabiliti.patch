-/**
- * @TODO Move to QoS Driver
- */
-static void __copy_dma(u32 src, u32 dst, u32 flags)
-{
-	ulong qos_uc_mcdm0_base = (qos_uc_base_addr + QOS_UC_MCDM0_OFF);
-	ulong mcdm0_ctrl = qos_uc_mcdm0_base + MCDMA_CONTROL_OFFSET;
-
-	/* source address */
-	PP_REG_WR32(qos_uc_mcdm0_base + MCDMA_SRC_OFFSET, src);
-	/* destination address */
-	PP_REG_WR32(qos_uc_mcdm0_base + MCDMA_DST_OFFSET, dst);
-
-	pr_info("Copying from ADDR 0x%x to ADDR 0x%x\n", src, dst);
-
-	/* 8 bytes burst, total size is 8 byte which is 64 bits */
-	PP_REG_WR32(mcdm0_ctrl, flags);
-
-	/* wait for Active bit will be 0 */
-	if (pp_reg_poll(mcdm0_ctrl, MCDMA_ACTIVE_MASK, 0)) {
-		pr_err("pp_reg_poll failed - dma timeout\n");
-		return;
-	}
-
-	pr_info("Copying DONE (control 0x%x)\n", PP_REG_RD32(mcdm0_ctrl));
-}
