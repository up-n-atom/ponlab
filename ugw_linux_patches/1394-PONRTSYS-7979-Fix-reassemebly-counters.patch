From 07d73962ee11cf9a3979d43d2b4374a42f46bf7f Mon Sep 17 00:00:00 2001
From: Emergi Idan <idan.emergi@intel.com>
Date: Mon, 16 Mar 2020 09:45:23 +0200
Subject: [PATCH] PONRTSYS-7979: Fix reassemebly counters

Signed-off-by: Emergi Idan <idan.emergi@intel.com>
---
 .../ppv4/pp-api/pp-session-mgr/pp_session_mgr_debugfs.c | 17 ++++++++++++-----
 drivers/net/ppv4/pp-hal/micro-controller/uc.c           |  2 +-
 drivers/net/ppv4/pp-hal/micro-controller/uc_common.h    | 11 +++++++++--
 3 files changed, 22 insertions(+), 8 deletions(-)

diff --git a/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr_debugfs.c b/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr_debugfs.c
index c3c538d6bcbe..910d3368826d 100644
--- a/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr_debugfs.c
+++ b/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr_debugfs.c
@@ -2286,13 +2286,20 @@ s32 __smgr_reass_stats_show(char *buf, size_t sz, size_t *n, void *s, u32 num,
 		"reassembled",
 		"accelerated",
 		"diverted",
+		"early_diverted",
 		"matched",
 		"not_matched",
 		"cntxs_starv",
+		"cntxs_busy",
 		"cntx_overflow",
 		"timedout",
+		"timeout_err",
 		"frags_starv",
 		"duplicates",
+		"unsupported_frag",
+		"unsupported_ext",
+		"unsupported_proto",
+		"ext_overflow",
 		"unsupported",
 		"invalid_len",
 		"dropped",
@@ -2301,18 +2308,18 @@ s32 __smgr_reass_stats_show(char *buf, size_t sz, size_t *n, void *s, u32 num,
 
 	pr_buf(buf, sz, *n, "\n");
 	pr_buf_cat(buf, sz, *n,
-		   "|=====================================================================|\n");
+		   "|=======================================================================|\n");
 	pr_buf_cat(buf, sz, *n,
-		   "|              Reassembly UC Statistics                               |\n");
+		   "|                Reassembly UC Statistics                               |\n");
 	pr_buf_cat(buf, sz, *n,
-		   "|=====================================================================|\n");
+		   "|=======================================================================|\n");
 	pr_buf_cat(buf, sz, *n,
-		   "| %-15s ", "Counter");
+		   "| %-17s ", "Counter");
 	for (cid = 0; cid < num; cid++)
 		pr_buf_cat(buf, sz, *n, "|  CPU%u      ", cid);
 	pr_buf_cat(buf, sz, *n, "|\n");
 	pr_buf_cat(buf, sz, *n,
-		   "|-----------------+------------+------------+------------+------------|\n");
+		   "|-------------------+------------+------------+------------+------------|\n");
 
 	cid = 0;
 	stats = (struct reassembly_stats *)s;
diff --git a/drivers/net/ppv4/pp-hal/micro-controller/uc.c b/drivers/net/ppv4/pp-hal/micro-controller/uc.c
index 6217f9bbe010..b53a43df5378 100644
--- a/drivers/net/ppv4/pp-hal/micro-controller/uc.c
+++ b/drivers/net/ppv4/pp-hal/micro-controller/uc.c
@@ -1430,7 +1430,7 @@ s32 __nf_reass_set(u16 tx_queue, u16 dflt_hif)
 	info.host_pid           = dflt_si.eg_port;
 	info.rxdma_base         = UC_PP_ADDR(rxdma_base_addr);
 	info.excp_si_base       = UC_PP_ADDR(chk_excp_si_phys_base_get());
-	info.si_base            = (u32)cls_si_phys_base_get();
+	info.si_base            = cls_si_phys_base_get();
 
 	port_cfg.port_id = dflt_si.eg_port;
 	ret = rx_dma_port_get(&port_cfg);
diff --git a/drivers/net/ppv4/pp-hal/micro-controller/uc_common.h b/drivers/net/ppv4/pp-hal/micro-controller/uc_common.h
index ce47adfd580e..c133804fd84b 100644
--- a/drivers/net/ppv4/pp-hal/micro-controller/uc_common.h
+++ b/drivers/net/ppv4/pp-hal/micro-controller/uc_common.h
@@ -13,7 +13,7 @@
  * the version here
  */
 #define EGRESS_VER_MAJOR  1
-#define EGRESS_VER_MINOR  16
+#define EGRESS_VER_MINOR  17
 
 #define INGRESS_VER_MAJOR 1
 #define INGRESS_VER_MINOR 2
@@ -222,13 +222,20 @@ struct reassembly_stats {
 	u64 reassembled;
 	u64 accelerated;
 	u64 diverted;
+	u64 early_diverted;
 	u64 matched;
 	u64 not_matched;
 	u64 cntxs_starv;
+	u64 cntxs_busy;
 	u64 cntx_overflow;
 	u64 timedout;
+	u64 timeout_err;
 	u64 frags_starv;
 	u64 duplicates;
+	u64 unsupported_frag;
+	u64 unsupported_ext;
+	u64 unsupported_proto;
+	u64 ext_overflow;
 	u64 unsupported;
 	u64 invalid_len;
 	u64 dropped;
@@ -295,7 +302,7 @@ struct reassembly_info {
 	/*! rxdma regs base for calculating buffer size */
 	u32 rxdma_base;
 	/*! si base address */
-	u32 si_base;
+	u64 si_base;
 };
 
 /**
