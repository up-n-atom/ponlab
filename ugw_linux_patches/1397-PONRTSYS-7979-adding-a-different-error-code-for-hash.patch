From 31346b5f62b757fe445252ed8e6fcdba89d5b36c Mon Sep 17 00:00:00 2001
From: Elad Fernandes <elad.fernandes@intel.com>
Date: Tue, 1 Sep 2020 10:46:27 +0300
Subject: [PATCH] PONRTSYS-7979: adding a different error code for hash calc
 request on A0

---
 .../net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c  | 20 ++++++++++++++++++--
 1 file changed, 18 insertions(+), 2 deletions(-)

diff --git a/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c b/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c
index 34d4091a0161..823bf0025c79 100644
--- a/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c
+++ b/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c
@@ -1865,15 +1865,26 @@ static bool __smgr_is_cls_info_valid(struct pp_sess_create_args *args)
 		}
 	}
 
+	return res;
+}
+
+/**
+ * @brief Test whether hash internal calculation is supported
+ * @param args the args to check
+ * @return bool true if supported, false otherwise
+ */
+static bool __smgr_is_hash_calc_supported(struct pp_sess_create_args *args)
+{
 	/* Hash calculation is not supported in A Step */
 	if (test_bit(PP_SESS_FLAG_INTERNAL_HASH_CALC_BIT, &args->flags)) {
 		if (unlikely(pp_silicon_step_get() == PP_SSTEP_A)) {
 			pr_err("hash calc is not supported in A step\n");
-			res = false;
+			__smgr_stats_invalid_args();
+			return false;
 		}
 	}
 
-	return res;
+	return true;
 }
 
 /**
@@ -3026,6 +3037,11 @@ static s32 __smgr_sess_create(struct sess_info *s)
 		goto err;
 	}
 
+	if (unlikely(!__smgr_is_hash_calc_supported(s->args))) {
+		ret = -EOPNOTSUPP;
+		goto err;
+	}
+
 	if (unlikely(!__smgr_is_sess_supported(s))) {
 		ret = -EPROTONOSUPPORT;
 		goto err;
