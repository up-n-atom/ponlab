 				tep_sec_writel((phys_addr_t)addr, val);
 				break;
@@ -288,30 +287,70 @@ void pfn_icc_regmap_callback(icc_wake_type wake_type)
 				break;
 
 			default:
-				icc_reply_msg.param_attr = 1;
+				icc_reply_msg.param[2] = 1;
 				break;
-			}
-			icc_write(RM, &icc_reply_msg);
-		} else {
-			pr_err("Read from ICC REGMAP failed\n");
 		}
