From fe7827897ebaf2f87531accab6e483214ffc4bb4 Mon Sep 17 00:00:00 2001
From: thampan <joby.thampan@intel.com>
Date: Wed, 19 May 2021 14:27:00 +0800
Subject: [PATCH] DRV_DPM_SW-481: Skb leakage fix for Error case in DPM

---
 drivers/net/datapath/dpm/datapath_api.c | 23 +++++++++++++----------
 1 file changed, 13 insertions(+), 10 deletions(-)

diff --git a/drivers/net/datapath/dpm/datapath_api.c b/drivers/net/datapath/dpm/datapath_api.c
index 2816e0c4b8f2..3b387fd76587 100644
--- a/drivers/net/datapath/dpm/datapath_api.c
+++ b/drivers/net/datapath/dpm/datapath_api.c
@@ -853,12 +853,11 @@ int32_t dp_deregister_subif_private(int inst, struct module *owner,
 	DP_DEBUG(DP_DBG_FLAG_REG,
 		 "Found matched subif: port_id=%d subif=%x vap=%d\n",
 		 subif_id->port_id, subif_id->subif, i);
-	if (sif->netif != dev) {
-		/* device not match. Maybe it is unexplicit logical dev */
-		res = del_logic_dev(inst, &sif->logic_dev,
-				    dev, flags);
-		return res;
-	}
+
+	/* device not match. Maybe it is unexplicit logical dev */
+	if (sif->netif != dev)
+		return del_logic_dev(inst, &sif->logic_dev, dev, flags);
+
 	/* reset LCT port */
 	if (data->flag_ops & DP_F_DATA_LCT_SUBIF)
 		port_info->lct_idx = 0;
@@ -877,8 +876,7 @@ int32_t dp_deregister_subif_private(int inst, struct module *owner,
 	/* subif_hw_reset */
 	if (dp_info->subif_platform_set(inst, port_id, i, &platfrm_data,
 					flags)) {
-		pr_err("subif_platform_set fail\n");
-		/*return res;*/
+		pr_err("subif_hw_reset fail\n");
 	}
 
 	/* for pmapper and non-pmapper both
@@ -2624,22 +2622,26 @@ int32_t dp_xmit(struct net_device *rx_if, dp_subif_t *rx_subif,
 #if IS_ENABLED(CONFIG_INTEL_DATAPATH_EXTRA_DEBUG)
 	if (unlikely(!dp_init_ok)) {
 		printk_ratelimited("%s failed for dp no init yet\n", __func__);
+		dev_kfree_skb_any(skb);
 		goto exit;
 	}
 
 	if (unlikely(!rx_subif)) {
 		printk_ratelimited("%s failed for rx_subif null\n", __func__);
+		dev_kfree_skb_any(skb);
 		goto exit;
 	}
 
 	if (unlikely(!skb)) {
 		printk_ratelimited("%s skb NULL\n", __func__);
+		dev_kfree_skb_any(skb);
 		goto exit;
 	}
 
 	if (unlikely(in_irq())) {
 		printk_ratelimited("%s not allowed in interrupt context\n",
 				   __func__);
+		dev_kfree_skb_any(skb);
 		goto exit;
 	}
 #endif
@@ -2649,6 +2651,7 @@ int32_t dp_xmit(struct net_device *rx_if, dp_subif_t *rx_subif,
 		printk_ratelimited("rx_subif->port_id >= max_ports");
 		UP_STATS(get_dp_port_info(0, 0)->tx_err_drop);
 		MIB_G_STATS_INC(tx_drop);
+		dev_kfree_skb_any(skb);
 		goto exit;
 	}
 
@@ -2660,6 +2663,7 @@ int32_t dp_xmit(struct net_device *rx_if, dp_subif_t *rx_subif,
 	port = get_dp_port_info(inst, rx_subif->port_id);
 	if (unlikely(!rx_if && !is_dsl(port))) {
 		printk_ratelimited("null dev but not DSL\n");
+		dev_kfree_skb_any(skb);
 		goto exit;
 	}
 
@@ -2683,7 +2687,6 @@ int32_t dp_xmit(struct net_device *rx_if, dp_subif_t *rx_subif,
 		/* In LGM Fail case DPM free skb, Success case CQM Free
 		 * In PRX Fail and Success case CQM free
 		 */
-exit:
 		if (is_soc_lgm(ex.cmn.inst))
 			dev_kfree_skb_any(skb);
 	}
@@ -2696,7 +2699,7 @@ int32_t dp_xmit(struct net_device *rx_if, dp_subif_t *rx_subif,
 		MIB_G_STATS_INC(tx_drop);
 		dev_kfree_skb_any(skb);
 	}
-
+exit:
 	return ret ? DP_FAILURE : DP_SUCCESS;
 }
 EXPORT_SYMBOL(dp_xmit);
