From a7679cb00b8e7f005929d44fd079abfeb9da7f01 Mon Sep 17 00:00:00 2001
From: ofirbitt <ofir1.bitton@intel.com>
Date: Wed, 23 Oct 2019 14:23:04 +0300
Subject: [PATCH] PONRTSYS-5569: Fix PPv4 shaper rate limit

---
 drivers/net/ethernet/lantiq/ppv4/qos/pp_qos_main.c  | 9 +++++++++
 drivers/net/ethernet/lantiq/ppv4/qos/pp_qos_utils.c | 9 +++++----
 drivers/net/ethernet/lantiq/ppv4/qos/pp_qos_utils.h | 1 +
 include/net/pp_qos_drv.h                            | 2 +-
 4 files changed, 16 insertions(+), 5 deletions(-)

diff --git a/drivers/net/ethernet/lantiq/ppv4/qos/pp_qos_main.c b/drivers/net/ethernet/lantiq/ppv4/qos/pp_qos_main.c
index 5bd8f6827702..d4eb79fcef63 100644
--- a/drivers/net/ethernet/lantiq/ppv4/qos/pp_qos_main.c
+++ b/drivers/net/ethernet/lantiq/ppv4/qos/pp_qos_main.c
@@ -33,6 +33,11 @@
 #define PP_QOS_ENTER_FUNC()
 #define PP_QOS_EXIT_FUNC()
 
+/* CREDIT_MAX  = BW Limit Credit max value is (2^21) 2097152 */
+/* NUM_UPDATES = There are ~91 updates per second per Mhz    */
+/* KBPS        = CREDIT_MAX * NUM_UPDATES / 500 ~= 300000    */
+#define QOS_MAX_BW_KBPS_PER_1MHZ_CLK (300000)
+
 static bool qos_fw_log;
 
 void update_cmd_id(struct driver_cmds *drvcmds)
@@ -2534,6 +2539,10 @@ int pp_qos_dev_init(struct pp_qos_dev *qdev, struct pp_qos_init_param *conf)
 		      qdev->hwconf.qm_num_pages);
 	QOS_LOG_DEBUG("clock\t\t\t%u\n", qdev->hwconf.qos_clock);
 
+	/* Calculate maximum bw limit */
+	qdev->hwconf.max_bw_limit_kbps =
+		QOS_MAX_BW_KBPS_PER_1MHZ_CLK * qdev->hwconf.qos_clock;
+
 	qdev->hwconf.wred_const_p = conf->wred_p_const;
 	qdev->hwconf.wred_max_q_size = conf->wred_max_q_size;
 
diff --git a/drivers/net/ethernet/lantiq/ppv4/qos/pp_qos_utils.c b/drivers/net/ethernet/lantiq/ppv4/qos/pp_qos_utils.c
index 79118311e365..cbc6eb63286b 100644
--- a/drivers/net/ethernet/lantiq/ppv4/qos/pp_qos_utils.c
+++ b/drivers/net/ethernet/lantiq/ppv4/qos/pp_qos_utils.c
@@ -2072,10 +2072,11 @@ static int common_cfg_valid(
 {
 	unsigned int shared;
 
-	if (!(node->bandwidth_limit == QOS_NO_BANDWIDTH_LIMIT ||
-				node->bandwidth_limit <=
-				QOS_MAX_BANDWIDTH_LIMIT)) {
-		QOS_LOG("Invalid bandwidth limit %u\n", node->bandwidth_limit);
+	if (!((node->bandwidth_limit == QOS_NO_BANDWIDTH_LIMIT) ||
+	      (node->bandwidth_limit <= qdev->hwconf.max_bw_limit_kbps))) {
+		QOS_LOG_ERR("Invalid bandwidth limit %u. maximum is %u Kbps\n",
+			    node->bandwidth_limit,
+			    qdev->hwconf.max_bw_limit_kbps);
 		return 0;
 	}
 
diff --git a/drivers/net/ethernet/lantiq/ppv4/qos/pp_qos_utils.h b/drivers/net/ethernet/lantiq/ppv4/qos/pp_qos_utils.h
index d66dcb604f30..acac3e61d52f 100644
--- a/drivers/net/ethernet/lantiq/ppv4/qos/pp_qos_utils.h
+++ b/drivers/net/ethernet/lantiq/ppv4/qos/pp_qos_utils.h
@@ -226,6 +226,7 @@ struct hw_conf {
 	unsigned int	fw_logger_start;
 	unsigned int	fw_stat;
 	unsigned int	qos_clock; /* In MHZ. */
+	unsigned int	max_bw_limit_kbps;
 	void*		max_allowed_ddr_virt;
 	dma_addr_t	max_allowed_ddr_phys;
 	unsigned int	*bwl_ddr_virt;
diff --git a/include/net/pp_qos_drv.h b/include/net/pp_qos_drv.h
index ffa92e778c0f..ff5e0e5b3832 100644
--- a/include/net/pp_qos_drv.h
+++ b/include/net/pp_qos_drv.h
@@ -114,7 +114,7 @@ enum pp_qos_arbitration {
  */
 struct pp_qos_common_node_properties {
 	#define QOS_NO_BANDWIDTH_LIMIT          0
-	#define QOS_MAX_BANDWIDTH_LIMIT         0xFFFF
+	#define QOS_MAX_BANDWIDTH_LIMIT         10485760
 	unsigned int bandwidth_limit;
 
 	#define QOS_NO_SHARED_BANDWIDTH_GROUP   0x0
