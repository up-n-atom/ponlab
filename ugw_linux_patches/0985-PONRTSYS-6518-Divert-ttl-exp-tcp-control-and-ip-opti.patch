From 477117a5170ec41c15dbd70664966f1524b22cab Mon Sep 17 00:00:00 2001
From: Elad Fernandes <elad.fernandes@intel.com>
Date: Tue, 7 Jan 2020 14:25:51 +0200
Subject: [PATCH] PONRTSYS-6518: Divert ttl exp, tcp control and ip option
 packets

---
 drivers/net/ppv4/pp-hal/checker/checker.h | 13 +++++++------
 1 file changed, 7 insertions(+), 6 deletions(-)

diff --git a/drivers/net/ppv4/pp-hal/checker/checker.h b/drivers/net/ppv4/pp-hal/checker/checker.h
index cedbac333db0..0656c841af3d 100644
--- a/drivers/net/ppv4/pp-hal/checker/checker.h
+++ b/drivers/net/ppv4/pp-hal/checker/checker.h
@@ -71,13 +71,14 @@
 
 /**
  * @define Session's default checker flags
- * @note  'SI_CHCK_FLAG_DVRT_FRAG' flag should be added once
- *        fragmentor uc will be enabled
  */
-#define SESS_CHCK_DFLT_FLAGS                       \
-		(BIT(SI_CHCK_FLAG_UPDT_SESS_CNT) | \
-		 BIT(SI_CHCK_FLAG_DVRT_FRAG)     | \
-		 BIT(SI_CHCK_FLAG_DYN_SESS))
+#define SESS_CHCK_DFLT_FLAGS               \
+	(BIT(SI_CHCK_FLAG_DVRT_L3_OPTS)  | \
+	 BIT(SI_CHCK_FLAG_DVRT_TTL_EXP)  | \
+	 BIT(SI_CHCK_FLAG_DVRT_TCP_CTRL) | \
+	 BIT(SI_CHCK_FLAG_UPDT_SESS_CNT) | \
+	 BIT(SI_CHCK_FLAG_DVRT_FRAG)     | \
+	 BIT(SI_CHCK_FLAG_DYN_SESS))
 
 /**
  * @struct Checker module init parameters
