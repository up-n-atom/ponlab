 		snprintf(buf, size, "%d", shaper_limit);
 }
 
+#define BUF_SIZE 1048
+static int deq_port_res_get(int inst, int dp_port, int deq_idx)
+{
+	struct dp_dequeue_res dp_res;
+	struct dp_queue_res *queue_res;
+	int i, j, num_q, num;
+	char *p;
+	size_t len;
+
+	/* retrieve the num_q for DP port*/
+	memset(&dp_res, 0, sizeof(dp_res));
+	dp_res.inst = inst;
+	dp_res.dp_port = dp_port;
+	dp_res.cqm_deq_idx = deq_idx;
+	if (dp_deq_port_res_get(&dp_res, 0))
+		return -1;
+	num_q = dp_res.num_q;
+	pr_info("num of q:%d\n", dp_res.num_q);
+	/* retrieve the Q info */
+	len = sizeof(struct dp_queue_res) * num_q;
+	queue_res = kzalloc(len, GFP_ATOMIC);
+	if (!queue_res)
+		return -1;
+	dp_res.q_res = queue_res;
+	dp_res.q_res_size = num_q;
+	dp_res.cqm_deq_idx = deq_idx;
+	if (dp_deq_port_res_get(&dp_res, 0)) {
+		pr_err("dp_deq_port_res_get fail: inst=%d dp_port=%d idx:%d\n",
+				inst, dp_port, i);
+		kfree(queue_res);
+		return -1;
+	}
+	pr_info("deq_ports:%d\n", dp_res.num_deq_ports);
+	p = kzalloc(BUF_SIZE, GFP_ATOMIC);
+	if (!p) {
+		kfree(queue_res);
+		return -1;
+	}
+
+	for (i = 0; i < num_q; i++) {
+		num = 0;
+		pr_info("sch_level:%d\n", dp_res.q_res[i].sch_lvl);
+		num = snprintf(p, BUF_SIZE - 1,
+			       "qid[%d]/qnode:%d/%d->", i,
+			       dp_res.q_res[i].q_id, dp_res.q_res[i].q_node);
+		for (j = 0; j < dp_res.q_res[i].sch_lvl; j++) {
+			num += snprintf(p + num, BUF_SIZE - num - 1,
+					"sched[%d]:%d->",
+					j, dp_res.q_res[i].sch_id[j]);
+		}
+		num += snprintf(p + num, BUF_SIZE - num - 1,
+			       "cqm_deq_port/logical_port:%d/%d",
+			       dp_res.q_res[i].cqm_deq_port,
+			       dp_res.q_res[i].qos_deq_port);
+		pr_info("%s\n", p);
+	}
+	kfree(queue_res);
+	kfree(p);
+	return 0;
+}
+
 int get_num_deq_ports(int inst, int dp_port)
 {
 	memset(&tmp_res, 0, sizeof(tmp_res));
