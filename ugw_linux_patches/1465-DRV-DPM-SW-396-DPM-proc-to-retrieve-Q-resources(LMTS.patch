+		if (deq_port_res_get(0, dp_port, cqm_deq_idx)) {
+			pr_err("deq_res_get failed\n");
+			return count;
+		}
+
 	} else if (dp_strncmpi(param_list[0], "set_q_conf",
 			       strlen("q_conf")) == 0) {
 		struct dp_queue_conf cfg = {0};
