From b7e808ad0774fd2c990f7378d6fb4e610fc690cd Mon Sep 17 00:00:00 2001
From: Rekha Eswaran <rekha.eswaran@intel.com>
Date: Mon, 10 Feb 2020 14:04:44 +0800
Subject: [PATCH] DRV_DPM_SW-162 - DP FLM enhance QoS proc to support SP, WRR
 priority settings

---
 drivers/net/datapath/dpm/datapath_proc_qos.c | 10 ++++------
 1 file changed, 4 insertions(+), 6 deletions(-)

diff --git a/drivers/net/datapath/dpm/datapath_proc_qos.c b/drivers/net/datapath/dpm/datapath_proc_qos.c
index 8b645616c9f1..e2f31d015df8 100644
--- a/drivers/net/datapath/dpm/datapath_proc_qos.c
+++ b/drivers/net/datapath/dpm/datapath_proc_qos.c
@@ -992,7 +992,7 @@ ssize_t proc_qos_write(struct file *file, const char *buf, size_t count,
 		cfg.cqm_deq_port = dp_atoi(param_list[num - 1]);
 
 		cfg.q_leaf = 0;
-		cfg.q_arbi = 1;
+		cfg.q_arbi = ARBITRATION_WSP; /* default WSP */
 		cfg.q_prio_wfq = 0;
 		cfg.n_sch_lvl = level;
 
@@ -1006,9 +1006,9 @@ ssize_t proc_qos_write(struct file *file, const char *buf, size_t count,
 					ARRAY_SIZE(temp_list));
 			cfg.sch[i].id = dp_atoi(temp_list[0]);
 			cfg.sch[i].leaf = dp_atoi(temp_list[1]);
-			cfg.sch[i].arbi = 1;
+			/* Later get child arbi & update accordingly */
+			cfg.sch[i].arbi = ARBITRATION_WSP;
 			cfg.sch[i].prio_wfq = 0;
-
 			pr_info("SCH %d:LEAF %d->", cfg.sch[i].id,
 				cfg.sch[i].leaf);
 		}
@@ -1127,9 +1127,7 @@ ssize_t proc_qos_write(struct file *file, const char *buf, size_t count,
 			return count;
 		}
 
-		if (dp_atoi(param_list[4]))
-			node_prio.prio_wfq = dp_atoi(param_list[4]);
-
+		node_prio.prio_wfq = dp_atoi(param_list[4]);
 		if (dp_qos_link_prio_set(&node_prio, 0)) {
 			pr_err("dp_qos_link_prio_set failed\n");
 			return count;
