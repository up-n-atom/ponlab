From: arathinx <ayyappanx.rathinam@intel.com>
Date: Wed, 10 Jun 2020 18:53:36 +0800
Subject: [PATCH] DRVLIB_SW-3672: Corrected the wrong validation check in
 cpufreq driver

---
 drivers/cpufreq/xrx500-cpufreq.c | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/drivers/cpufreq/xrx500-cpufreq.c b/drivers/cpufreq/xrx500-cpufreq.c
index 8e4f94faddb6..d802aac3d6de 100644
--- a/drivers/cpufreq/xrx500-cpufreq.c
+++ b/drivers/cpufreq/xrx500-cpufreq.c
@@ -101,8 +101,8 @@ static int xrx500_cpufreq_transition_notifier(struct notifier_block *nb,
 	return NOTIFY_OK;
 }
 
-static unsigned int xrx500_pnum2version(struct device *dev, unsigned int id,
-					unsigned int *plf)
+static int xrx500_pnum2version(struct device *dev, unsigned int id,
+			       unsigned int *plf)
 {
 	switch (id) {
 	case SOC_ID_GRX5838:
@@ -151,8 +151,8 @@ static unsigned int xrx500_pnum2version(struct device *dev, unsigned int id,
 
 int xrx500_opp_set_supported_hw(struct device *cpu_dev)
 {
-	unsigned int version, id, platform;
-	int ret;
+	unsigned int id, platform;
+	int ret = 0, version;
 
 	id = ltq_get_cpu_id();
 
