From bc5d1ef332fd48323b4d7d647a4a33b16358203f Mon Sep 17 00:00:00 2001
From: Rekha Eswaran <rekha.eswaran@intel.com>
Date: Mon, 14 Sep 2020 17:21:18 +0800
Subject: [PATCH] DRV_DPM_SW-380 - DPM porting changes between LGM & FLM

---
 drivers/net/datapath/dpm/datapath.h              |  1 -
 drivers/net/datapath/dpm/datapath_api.c          | 16 +++++------
 drivers/net/datapath/dpm/datapath_instance.c     | 11 ++++----
 drivers/net/datapath/dpm/datapath_tx.c           |  5 ----
 drivers/net/datapath/dpm/gswip31/datapath_misc.c |  2 +-
 drivers/net/datapath/dpm/gswip31/datapath_misc.h |  8 ++++++
 drivers/net/datapath/dpm/gswip31/datapath_rx.c   | 35 +++++++++++++-----------
 7 files changed, 42 insertions(+), 36 deletions(-)

diff --git a/drivers/net/datapath/dpm/datapath.h b/drivers/net/datapath/dpm/datapath.h
index ba914aa0fd82..dd49e1693036 100644
--- a/drivers/net/datapath/dpm/datapath.h
+++ b/drivers/net/datapath/dpm/datapath.h
@@ -43,7 +43,6 @@
 #define MAX_SUBIFS 256  /* Max subif per DPID */
 #define MAX_DP_PORTS  16
 #define PMAC_SIZE 8
-#define PMAC_SIZE_GSW32	16
 #define PMAC_CPU_ID  0
 #define DP_MAX_BP_NUM 128
 #define DP_MAX_QUEUE_NUM 256
diff --git a/drivers/net/datapath/dpm/datapath_api.c b/drivers/net/datapath/dpm/datapath_api.c
index c7c162569521..9f5e2c232408 100644
--- a/drivers/net/datapath/dpm/datapath_api.c
+++ b/drivers/net/datapath/dpm/datapath_api.c
@@ -1416,9 +1416,10 @@ int32_t dp_register_dev_ext(int inst, struct module *owner, u32 port_id,
 #endif
 			res = DP_SUCCESS;
 		} else {
-			DP_DEBUG(DP_DBG_FLAG_REG,
-				 "fail to de-register for unknown status:%d\n",
-				 port_info->status);
+			pr_err("(%s)de-register fail for status:%d,%s(%d)\n",
+			       owner->name,
+			       port_info->status, "num_subif",
+			       port_info->num_subif);
 		}
 		DP_LIB_UNLOCK(&dp_lock);
 		return res;
@@ -1426,16 +1427,15 @@ int32_t dp_register_dev_ext(int inst, struct module *owner, u32 port_id,
 
 	/*register a device */
 	if (port_info->status != PORT_ALLOCATED) {
-		DP_DEBUG(DP_DBG_FLAG_REG,
-			 "No de-register for %s for unknown status:%d\n",
-			 owner->name, port_info->status);
+		pr_err("register dev fail for %s for unknown status:%d\n",
+		       owner->name, port_info->status);
 		DP_LIB_UNLOCK(&dp_lock);
 		return DP_FAILURE;
 	}
 
 	if (port_info->owner != owner) {
-		DP_DEBUG(DP_DBG_FLAG_REG, "No matched owner(%s):%px->%px\n",
-			 owner->name, owner, port_info->owner);
+		pr_err("No matched owner(%s):%px->%px\n",
+		       owner->name, owner, port_info->owner);
 		DP_LIB_UNLOCK(&dp_lock);
 		return res;
 	}
diff --git a/drivers/net/datapath/dpm/datapath_instance.c b/drivers/net/datapath/dpm/datapath_instance.c
index f274c175d7e9..f902bc538bd3 100644
--- a/drivers/net/datapath/dpm/datapath_instance.c
+++ b/drivers/net/datapath/dpm/datapath_instance.c
@@ -211,9 +211,10 @@ static int dp_ndo_setup_tc(struct net_device *dev, u32 handle,
 	if (qos_mgr_hook_setup_tc)
 		return qos_mgr_hook_setup_tc(dev, handle, protocol, tc);
 #endif
-	if (dev->netdev_ops->ndo_setup_tc)
-		return dev->netdev_ops->ndo_setup_tc(dev, handle, protocol, tc);
-	pr_err("Cannot support ndo_setup_tc\n");
+	if (dev->netdev_ops->ndo_setup_tc) {
+		pr_err("Cannot support ndo_setup_tc\n");
+		return -1;
+	}
 	return -1;
 }
 #else
@@ -385,8 +386,8 @@ int dp_inst_del_dev(struct net_device *dev, int inst,
 		return 0;
 	}
 
-	DP_DEBUG(DP_DBG_FLAG_INST, "dp_del_dev fail(%s): not found ctp=%d\n",
-		 dev ? dev->name : "NULL", ctp);
+	pr_err("dp_del_dev fail(%s): not found ctp=%d\n",
+	       dev ? dev->name : "NULL", ctp);
 	return -1;
 }
 
diff --git a/drivers/net/datapath/dpm/datapath_tx.c b/drivers/net/datapath/dpm/datapath_tx.c
index 38b35795b4b2..fb9d4db343f8 100644
--- a/drivers/net/datapath/dpm/datapath_tx.c
+++ b/drivers/net/datapath/dpm/datapath_tx.c
@@ -334,11 +334,6 @@ int dp_register_tx(enum DP_TX_PRIORITY priority, tx_fn fn, void *priv)
 {
 	int ret;
 
-	if (unlikely(!dp_init_ok)) {
-		pr_err("%s failed: datapath not initialized yet\n", __func__);
-		return DP_FAILURE;
-	}
-
 	if (!dp_tx_ctx)
 		return -ENOMEM;
 	/* add spin lock to protect modules update TX list concurrently */
diff --git a/drivers/net/datapath/dpm/gswip31/datapath_misc.c b/drivers/net/datapath/dpm/gswip31/datapath_misc.c
index e04ae45ebf77..9ff45628e4ba 100644
--- a/drivers/net/datapath/dpm/gswip31/datapath_misc.c
+++ b/drivers/net/datapath/dpm/gswip31/datapath_misc.c
@@ -1404,7 +1404,7 @@ static int port_platform_set(int inst, u8 ep, struct dp_port_data *data,
 		 priv ? priv->qdev : NULL);
 	idx = port_info->deq_port_base;
 
-	if ((flags & (DP_F_GPON | DP_F_EPON)) ||
+	if ((is_xpon(flags)) ||
 		(data->flag_ops & DP_F_DATA_NO_LOOP))
 		port_info->loop_dis = 1;
 	if (flags & DP_F_FAST_WLAN)
diff --git a/drivers/net/datapath/dpm/gswip31/datapath_misc.h b/drivers/net/datapath/dpm/gswip31/datapath_misc.h
index 14300315160e..f1434fdb3743 100644
--- a/drivers/net/datapath/dpm/gswip31/datapath_misc.h
+++ b/drivers/net/datapath/dpm/gswip31/datapath_misc.h
@@ -118,6 +118,14 @@ struct hal_priv {
 	DP_LOCK_T qos_lock;
 };
 
+static inline bool is_xpon(int flags)
+{
+	if (flags & (DP_F_GPON | DP_F_EPON))
+		return true;
+
+	return false;
+}
+
 static inline bool is_qid_valid(int q_id)
 {
 	if (q_id < 0 || q_id >= MAX_QUEUE) {
diff --git a/drivers/net/datapath/dpm/gswip31/datapath_rx.c b/drivers/net/datapath/dpm/gswip31/datapath_rx.c
index f8fd2930f0fd..62f0ca2ed7ab 100644
--- a/drivers/net/datapath/dpm/gswip31/datapath_rx.c
+++ b/drivers/net/datapath/dpm/gswip31/datapath_rx.c
@@ -74,9 +74,13 @@ static void rx_dbg_zero_port(struct sk_buff *skb, struct dma_rx_desc_0 *desc0,
 
 /* clone skb to send one copy to lct dev for multicast/broadcast
  * otherwise for unicast send only to lct device
- * return 0 - Caller will not proceed handling i.e. for unicast do rx only for
- *	      LCT port
- *	  1 - Caller continue to handle rx for other device
+ * return 0 -> matched unicast pkt is forwarded to LCT device. skb is
+ *            consumed and done
+ *       -1 -> Failed to forward multicast/broadcast pkt to LCT device and
+ *             need continue to handle rx for other dev
+ *        1 -> multicast/broadcast pkt (which is cloned and forwarded one
+ *            copy to LCT device)  and non-matched unicast pkt need continue
+ *            to handle rx for other dev
  */
 static int dp_handle_lct(struct pmac_port_info *dp_port,
 			 struct sk_buff *skb, dp_rx_fn_t rx_fn)
@@ -151,7 +155,6 @@ int32_t dp_rx_31(struct sk_buff *skb, u32 flags)
 #if IS_ENABLED(CONFIG_INTEL_DATAPATH_PTP1588)
 	struct mac_ops *ops;
 #endif
-	int ret_lct = 1;
 	struct dp_subif_info *sif;
 	struct dev_mib *mib;
 
@@ -221,7 +224,7 @@ int32_t dp_rx_31(struct sk_buff *skb, u32 flags)
 	}
 #endif
 	/*PON traffic always have timestamp attached,removing Timestamp */
-	if (dp_port->alloc_flags & (DP_F_GPON | DP_F_EPON)) {
+	if (is_xpon(dp_port->alloc_flags)) {
 		/* Stripping of last 10 bytes timestamp */
 #if IS_ENABLED(CONFIG_INTEL_DATAPATH_PTP1588)
 		if (!dp_port->f_ptp)
@@ -294,18 +297,18 @@ int32_t dp_rx_31(struct sk_buff *skb, u32 flags)
 			skb->offload_fwd_mark = 1;
 #endif
 		if (rx_tx_flag == 0) {
-			if (dp_port->lct_idx > 0)
-				ret_lct = dp_handle_lct(dp_port, skb, rx_fn);
-			if (ret_lct) {
-				if (STATS_GET(sif->rx_flag) <= 0) {
-					UP_STATS(mib->rx_fn_dropped);
-					MIB_G_STATS_INC(rx_drop);
-					goto RX_DROP2;
-				}
-				rx_fn(dev, NULL, skb, skb->len);
-				UP_STATS(mib->rx_fn_rxif_pkt);
-				MIB_G_STATS_INC(rx_rxif_pkts);
+			if (dp_port->lct_idx > 0) {
+				if (!(dp_handle_lct(dp_port, skb, rx_fn)))
+					return DP_SUCCESS;
 			}
+			if (STATS_GET(sif->rx_flag) <= 0) {
+				UP_STATS(mib->rx_fn_dropped);
+				MIB_G_STATS_INC(rx_drop);
+				goto RX_DROP2;
+			}
+			rx_fn(dev, NULL, skb, skb->len);
+			UP_STATS(mib->rx_fn_rxif_pkt);
+			MIB_G_STATS_INC(rx_rxif_pkts);
 		} else {
 			if (STATS_GET(sif->rx_flag) <= 0) {
 				UP_STATS(mib->rx_fn_dropped);
