From 2a97b3a324a4d58e9724354160cff85b382e12f9 Mon Sep 17 00:00:00 2001
From: Lishan Liu <lishan.liu@intel.com>
Date: Thu, 26 Nov 2020 13:26:41 +0800
Subject: [PATCH] DRVLIB_SW-3910: PRX300 CQM to save dp info

---
 drivers/net/ethernet/lantiq/cqm/prx300/cqm.c | 82 ++++++++++++++++++++++------
 drivers/net/ethernet/lantiq/cqm/prx300/cqm.h |  4 ++
 2 files changed, 68 insertions(+), 18 deletions(-)

diff --git a/drivers/net/ethernet/lantiq/cqm/prx300/cqm.c b/drivers/net/ethernet/lantiq/cqm/prx300/cqm.c
index 9624004fdd42..53d24b29bcea 100644
--- a/drivers/net/ethernet/lantiq/cqm/prx300/cqm.c
+++ b/drivers/net/ethernet/lantiq/cqm/prx300/cqm.c
@@ -2220,7 +2220,8 @@ dp_port_alloc(struct module *owner, struct net_device *dev, u32 dev_port,
 	data->flags = 0;
 	if (!owner)
 		return CBM_FAILURE;
-	dev_dbg(cqm_ctrl->dev, "flags 0x%x\n", flags);
+	dev_dbg(cqm_ctrl->dev, "%s: port_id %d, flags 0x%x\n",
+		__func__, port_id, flags);
 	/*to allocate port*/
 
 	if (cqm_ctrl->radio_num) {
@@ -2383,6 +2384,8 @@ dp_port_alloc(struct module *owner, struct net_device *dev, u32 dev_port,
 	}
 	cqm_add_to_list(&local_entry);
 	fill_dp_alloc_data(data, port_id, cbm_port[0], flags);
+	dev_dbg(cqm_ctrl->dev, "%s: port_id:%d, cbm_port:%d\n",
+		__func__, port_id, cbm_port[0]);
 	return CBM_SUCCESS;
 }
 
@@ -2579,7 +2582,8 @@ static s32 dp_port_alloc_complete(struct module *owner, struct net_device *dev,
 {
 	u32 reg;
 
-	dev_dbg(cqm_ctrl->dev, "%s: enter\n", __func__);
+	dev_dbg(cqm_ctrl->dev, "%s: enter dp_port:%d, flags:0x%x\n",
+		__func__, dp_port, flags);
 
 	if (!owner)
 		return CBM_FAILURE;
@@ -2614,6 +2618,7 @@ static s32 handle_dma_chnl_init(int port, u32 flags)
 		p_info = &dqm_port_info[port];
 
 	chan = p_info->dma_ch;
+
 	if (flags & CBM_PORT_F_DISABLE) {
 		if (port_type != DQM_PON_TYPE) {
 			if (chan)
@@ -2709,16 +2714,21 @@ static void cqm_deq_pon_port_disable(u32 port, u32 alloc_flags)
 static s32 dp_enable(struct module *owner, u32 port_id,
 		     struct cbm_dp_en_data *data, u32 flags, u32 alloc_flags)
 {
-	int port, type, i;
-	u32 val = 0;
+	int port, type, i, found = 0;
+	u32 val, dma_flag = 0;
 	struct core_ops *ops;
 	GSW_PMAC_Glbl_Cfg_t glbl_cfg;
 
 	static bool set_bsl;
 	void *deq = cqm_ctrl->deq;
 	struct cqm_dqm_port_info *dqp_info;
+	struct cqm_pmac_port_map *entry_ptr = NULL;
 
 	port = data->deq_port;
+
+	dev_dbg(cqm_ctrl->dev, "%s cbm_port:%d , port_id %d flags:%x, alloc_flags:%x\n",
+		__func__, port, port_id, flags, alloc_flags);
+
 	if (port == -1) {
 		dev_err(cqm_ctrl->dev, "Invalid port number\n");
 		return CBM_FAILURE;
@@ -2726,32 +2736,68 @@ static s32 dp_enable(struct module *owner, u32 port_id,
 
 	dqp_info = &dqm_port_info[data->deq_port];
 	if (flags & CBM_PORT_F_DISABLE) {
-		flags |= CBM_PORT_F_FLUSH;
-		dqp_info->ref_cnt--;
-		if (dqp_info->ref_cnt)
+		if (dqp_info->ref_cnt) {
+			flags |= CBM_PORT_F_FLUSH;
+			dqp_info->ref_cnt--;
+		} else {
 			return CBM_SUCCESS;
+		}
 	} else {
-		dqp_info->ref_cnt++;
-		if (dqp_info->ref_cnt > 1)
+		if (!dqp_info->ref_cnt)
+			dqp_info->ref_cnt++;
+		else
 			return CBM_SUCCESS;
 	}
-	if (data->dma_chnl_init) {
-		for (i = 0; i < data->num_dma_chan; i++)
+
+	list_for_each_entry(entry_ptr, &pmac_mapping_list, list) {
+		if (entry_ptr->pmac == port_id) {
+			found = 1;
+			break;
+		}
+	}
+	if (!found) {
+		dev_err(cqm_ctrl->dev, "Invalid port_id:%d\n", port_id);
+		return CBM_FAILURE;
+	}
+
+	if (flags & CBM_PORT_F_DISABLE) {
+		if (entry_ptr->eqp_en_cnt) {
+			entry_ptr->eqp_en_cnt--;
+			if (!entry_ptr->eqp_en_cnt)
+				dma_flag = 1;
+		}
+	} else {
+		if (!entry_ptr->eqp_en_cnt) {
+			entry_ptr->dma_chnl_init = data->dma_chnl_init;
+			entry_ptr->num_dma_chan = data->num_dma_chan;
+			dma_flag = 1;
+		}
+		entry_ptr->eqp_en_cnt++;
+	}
+
+	if ((entry_ptr->dma_chnl_init) && dma_flag) {
+		for (i = 0; i < entry_ptr->num_dma_chan; i++)
 			handle_dma_chnl_init((port + i), flags);
 	}
 	type = find_dqm_port_type(port);
 	switch (type) {
 	case DQM_CPU_TYPE:
 	case DQM_ACA_TYPE:
-		init_cqm_deq_cpu_port(port, data->tx_ring_size);
-		if ((type == DQM_ACA_TYPE) && (flags & CBM_PORT_F_DISABLE))
-			cqm_free_aca_port(port);
+		if (flags & CBM_PORT_F_DISABLE) {
+			if (type == DQM_ACA_TYPE)
+				cqm_free_aca_port(port);
+		} else {
+			init_cqm_deq_cpu_port(port, data->tx_ring_size);
+			dqp_info->tx_ring_size = data->tx_ring_size;
+		}
 		break;
 	case DQM_PON_TYPE:
-		if ((flags & CBM_PORT_F_DISABLE) && (data->dma_chnl_init))
+		if ((flags & CBM_PORT_F_DISABLE) &&
+		    (entry_ptr->dma_chnl_init) && dma_flag)
 			cqm_deq_pon_port_disable(port, alloc_flags);
 
-		if ((flags & CBM_PORT_F_DISABLE) && (!data->dma_chnl_init) &&
+		if ((flags & CBM_PORT_F_DISABLE) &&
+		    ((!entry_ptr->dma_chnl_init) || !dma_flag) &&
 		    (alloc_flags & (DP_F_EPON | DP_F_GPON))) {
 			val = ((port - DQM_PON_START_ID)
 				<< PIB_PON_IP_CMD_PORT_ID_POS) | 0x28000;
@@ -3045,7 +3091,8 @@ s32 qos_q_flush(s32 cqm_inst, s32 cqm_drop_port, s32 qid, s32 nodeid)
 			no_packet++;
 			dev_dbg(cqm_ctrl->dev, "no_packet %d\n", no_packet);
 			if (no_packet >= Q_FLUSH_NO_PACKET_CNT) {
-				if (dp_qos_get_q_qocc(&qocc_info, 0) == DP_SUCCESS) {
+				if (dp_qos_get_q_qocc(&qocc_info,
+						      0) == DP_SUCCESS) {
 					qocc_q = qocc_info.qocc;
 					if (qocc_q)
 						no_packet = 0;
@@ -3660,7 +3707,6 @@ static int get_bufsize(int size)
 
 static int cqm_get_dc_config(struct cbm_dc_res *dc_res, int flag)
 {
-	struct cqm_pmac_port_map *ptr = NULL;
 	struct cqm_dqm_port_info *dqp_info = dqm_port_info;
 	struct cqm_res_t *res = NULL;
 	u32 num, cbm_port;
diff --git a/drivers/net/ethernet/lantiq/cqm/prx300/cqm.h b/drivers/net/ethernet/lantiq/cqm/prx300/cqm.h
index 89a3cb10f8e5..39d62e5dc6fa 100644
--- a/drivers/net/ethernet/lantiq/cqm/prx300/cqm.h
+++ b/drivers/net/ethernet/lantiq/cqm/prx300/cqm.h
@@ -524,6 +524,7 @@ struct cqm_dqm_port_info {
 	u32 valid;
 	s32 ref_cnt;
 	u32 flush_index;
+	u32 tx_ring_size;
 };
 
 struct cqm_eqm_port_info {
@@ -550,6 +551,9 @@ struct cqm_pmac_port_map {
 	 *High priority/Low priority
 	 */
 	u32 egp_type;
+	u32 dma_chnl_init;
+	u32 num_dma_chan;
+	u32 eqp_en_cnt;
 	struct list_head list;
 };
 
