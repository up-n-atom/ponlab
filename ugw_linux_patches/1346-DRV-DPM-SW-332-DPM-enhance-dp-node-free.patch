From 43e24bc5600af753cc0522164e41ed84a9aa82b9 Mon Sep 17 00:00:00 2001
From: Rekha Eswaran <rekha.eswaran@intel.com>
Date: Thu, 9 Jul 2020 18:19:44 +0800
Subject: [PATCH] DRV_DPM_SW-332 - DPM enhance dp_node_free

---
 drivers/net/datapath/dpm/gswip31/datapath_ppv4_api.c | 19 +++++++++++++++----
 1 file changed, 15 insertions(+), 4 deletions(-)

diff --git a/drivers/net/datapath/dpm/gswip31/datapath_ppv4_api.c b/drivers/net/datapath/dpm/gswip31/datapath_ppv4_api.c
index 683c0a8bb21b..227d29ec8d34 100644
--- a/drivers/net/datapath/dpm/gswip31/datapath_ppv4_api.c
+++ b/drivers/net/datapath/dpm/gswip31/datapath_ppv4_api.c
@@ -1787,6 +1787,10 @@ int dp_node_free_31(struct dp_node_alloc *node, int flag)
 				goto EXIT;
 			}
 		}
+		if (!(qos_queue_stat->flag & PP_NODE_ACTIVE)) {
+			res = DP_SUCCESS;
+			goto EXIT;
+		}
 		if (node_stat_update(node->inst, t->node_id, DP_NODE_DEC)) {
 			pr_err("node_stat_update failed\n");
 			goto EXIT;
@@ -1834,6 +1838,7 @@ int dp_node_free_31(struct dp_node_alloc *node, int flag)
 		res = DP_SUCCESS;
 		goto EXIT;
 	} else if (node->type == DP_NODE_SCH) {
+		bool c_active, p_active;
 		t->sch_id = node->id.sch_id;
 		qos_sch_stat = &priv->qos_sch_stat[t->sch_id];
 		t->dp_port = qos_sch_stat->dp_port;
@@ -1848,7 +1853,8 @@ int dp_node_free_31(struct dp_node_alloc *node, int flag)
 
 		if (is_sch_parent_free(priv, t->sch_id))
 			goto EXIT;
-
+		c_active = (qos_sch_stat->c_flag & PP_NODE_ACTIVE) ? true:false;
+		p_active = (qos_sch_stat->p_flag & PP_NODE_ACTIVE) ? true:false;
 		t->parent_id = priv->qos_sch_stat[t->sch_id].parent.node_id;
 		t->p_type = get_node_type_by_node_id(node->inst,
 						     t->parent_id, flag);
@@ -1859,13 +1865,18 @@ int dp_node_free_31(struct dp_node_alloc *node, int flag)
 				goto EXIT;
 			}
 		}
-		if (node_stat_update(node->inst, t->sch_id,
+		if (!p_active && !c_active) {
+			res = DP_SUCCESS;
+			goto EXIT;
+		}
+		if (p_active & node_stat_update(node->inst, t->sch_id,
 				     DP_NODE_DEC | P_FLAG)) {
 			pr_err("node_stat_update failed\n");
 			goto EXIT;
 		}
 		/* call node_stat_update to update parent status */
-		if (node_stat_update(node->inst, t->parent_id,
+		if (c_active &
+		    node_stat_update(node->inst, t->parent_id,
 				     DP_NODE_DEC | C_FLAG)) {
 			pr_err("stat update fail Sch:[%d]'s parent:%d\n",
 			       node->id.sch_id, t->parent_id);
@@ -2758,7 +2769,7 @@ int dp_node_unlink_31(struct dp_node_link *info, int flag)
 
 		if (dp_qos_sched_get_queues(priv->qdev, info->node_id.sch_id,
 					    queue_buf, queue_size, &queue_num))
-			return DP_SUCCESS;
+			return DP_FAILURE;
 
 		for (i = 0; i < queue_num; i++) {
 			if (!(priv->qos_queue_stat[queue_buf[i]].flag &
