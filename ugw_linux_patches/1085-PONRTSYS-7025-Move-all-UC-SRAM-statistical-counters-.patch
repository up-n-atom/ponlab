From d1aa2131943cd7f76682431c1f8820d6c2f4d3bf Mon Sep 17 00:00:00 2001
From: Ricardo Martinez <ricardo.martinez@intel.com>
Date: Thu, 20 Feb 2020 14:44:36 -0700
Subject: [PATCH] PONRTSYS-7025: Move all UC SRAM statistical counters to the
 SR counters

---
 drivers/net/ppv4/pp-api/pp-misc/pp_misc.c          |  51 ++++---
 drivers/net/ppv4/pp-api/pp-misc/pp_misc.h          |   7 +-
 .../ppv4/pp-api/pp-session-mgr/pp_session_mgr.c    |  75 ----------
 .../ppv4/pp-api/pp-session-mgr/pp_session_mgr.h    |  63 +-------
 .../pp-api/pp-session-mgr/pp_session_mgr_debugfs.c |  44 +++---
 .../pp-session-mgr/pp_session_mgr_internal.h       |  18 +--
 .../pp-api/pp-session-mgr/pp_session_mgr_mcast.c   |  36 -----
 drivers/net/ppv4/pp-hal/micro-controller/uc.c      | 164 +++++++++++++++++++--
 drivers/net/ppv4/pp-hal/micro-controller/uc.h      |  65 +++++++-
 .../net/ppv4/pp-hal/micro-controller/uc_common.h   | 119 +++++++--------
 drivers/net/ppv4/pp-hal/micro-controller/uc_regs.h |  13 ++
 11 files changed, 336 insertions(+), 319 deletions(-)

diff --git a/drivers/net/ppv4/pp-api/pp-misc/pp_misc.c b/drivers/net/ppv4/pp-api/pp-misc/pp_misc.c
index cc603ac108c2..34f96c5f4197 100644
--- a/drivers/net/ppv4/pp-api/pp-misc/pp_misc.c
+++ b/drivers/net/ppv4/pp-api/pp-misc/pp_misc.c
@@ -485,6 +485,7 @@ void pp_global_stats_reset(void)
 	qdev = pp_qos_dev_open(PP_QOS_INSTANCE_ID);
 	pp_qos_stats_reset(qdev);
 	smgr_sq_dbg_stats_get(NULL, true);
+	uc_stats_reset();
 }
 
 void pp_driver_stats_reset(void)
@@ -574,21 +575,21 @@ s32 pp_global_stats_get(void *stats, u32 num_stats, void *data)
 	if (unlikely(ret))
 		pr_err("pp_qos_stats_get failed\n");
 
-	ret = pp_smgr_mcast_stats_get(&__stats->mcast_stats);
+	ret = uc_mcast_stats_get(&__stats->mcast_stats);
 	if (unlikely(ret))
-		pr_err("pp_smgr_mcast_stats_get failed\n");
+		pr_err("uc_mcast_stats_get failed\n");
 
-	ret = pp_smgr_frag_stats_get(&__stats->frag_stats);
+	ret = uc_frag_stats_get(&__stats->frag_stats);
 	if (unlikely(ret))
-		pr_err("pp_smgr_frag_stats_get failed\n");
+		pr_err("uc_frag_stats_get failed\n");
 
 	ret = smgr_sq_dbg_stats_get(&__stats->syncq_stats, false);
 	if (unlikely(ret))
 		pr_err("smgr_sq_dbg_stats_get failed\n");
 
-	ret = pp_smgr_reassembly_stats_get(&__stats->reass_stats);
+	ret = uc_reass_stats_get(&__stats->reass_stats);
 	if (unlikely(ret))
-		pr_err("pp_smgr_reassembly_stats_get failed\n");
+		pr_err("uc_reassembly_stats_get failed\n");
 
 	return 0;
 }
@@ -930,6 +931,12 @@ s32 pp_driver_stats_show(char *buf, size_t sz, size_t *n, void *stats,
 	return 0;
 }
 
+#define UC_REASS_STATS_ERRORS(stats) ((stats)->cntx_overflow + \
+				      (stats)->duplicates + \
+				      (stats)->unsupported + \
+				      (stats)->invalid_len + \
+				      (stats)->timedout)
+
 s32 pp_hal_global_stats_show(char *buf, size_t sz, size_t *n, void *stats,
 			     u32 num_stats, void *data)
 {
@@ -942,9 +949,9 @@ s32 pp_hal_global_stats_show(char *buf, size_t sz, size_t *n, void *stats,
 	struct mod_stats            *mod;
 	struct rx_dma_stats         *rx_dma;
 	struct pp_qos_stats         *qos;
-	struct smgr_mcast_pkt_stats *mcast;
-	struct smgr_reass_stats     *reass;
-	struct smgr_frag_stats      *frag;
+	struct mcast_stats          *mcast;
+	struct reassembly_stats     *reass;
+	struct frag_stats           *frag;
 
 	if (unlikely(ptr_is_null(buf) || ptr_is_null(n) || ptr_is_null(stats)))
 		return -EINVAL;
@@ -1022,28 +1029,28 @@ s32 pp_hal_global_stats_show(char *buf, size_t sz, size_t *n, void *stats,
 		   "+---------------------------+-------------------------+-------------------------+\n");
 	pr_buf_cat(buf, sz, *n,
 		   "| Rx            %10llu  | Rx          %10llu  | Rx          %10llu  |\n",
-		   mcast->rx, reass->rx_pkts, frag->rx_pkt);
+		   mcast->rx_pkt, reass->rx_pkts, frag->rx_pkt);
 	pr_buf_cat(buf, sz, *n,
 		   "| Tx            %10llu  | Tx          %10llu  | Tx          %10llu  |\n",
-		   mcast->tx, reass->tx_pkts, frag->tx_pkt);
+		   mcast->tx_pkt, reass->tx_pkts, frag->tx_pkt);
 	pr_buf_cat(buf, sz, *n,
 		   "| Drop          %10llu  | Drop        %10llu  | Drop        %10llu  |\n",
-		   mcast->drop, reass->dropped_pkts, frag->total_drops);
+		   mcast->drop_pkt, reass->dropped, frag->total_drops);
 	pr_buf_cat(buf, sz, *n,
 		   "|                           | Reassembled %10llu  | bmgr drops  %10llu  |\n",
-		   reass->reassembled_pkts, frag->bmgr_drops);
+		   reass->reassembled, frag->bmgr_drops);
 	pr_buf_cat(buf, sz, *n,
 		   "|                           | Accelerated %10llu  | df drops    %10llu  |\n",
-		   reass->accelerated_pkts, frag->df_drops);
+		   reass->accelerated, frag->df_drops);
 	pr_buf_cat(buf, sz, *n,
 		   "|                           | Diverted    %10llu  | max frags dr%10llu  |\n",
-		   reass->diverted_pkts, frag->max_frags_drops);
+		   reass->diverted, frag->max_frags_drops);
 	pr_buf_cat(buf, sz, *n,
 		   "|                           | Starvation  %10llu  |                         |\n",
-		   reass->starvation_pkts);
+		   reass->frags_starv);
 	pr_buf_cat(buf, sz, *n,
 		   "|                           | Errors      %10llu  |                         |\n",
-		   reass->errors);
+		   UC_REASS_STATS_ERRORS(reass));
 	pr_buf_cat(buf, sz, *n,
 		   "+---------------------------+-------------------------+-------------------------+\n\n");
 
@@ -1062,9 +1069,9 @@ s32 pp_global_stats_show(char *buf, size_t sz, size_t *n, void *stats,
 	struct mod_stats            *mod;
 	struct rx_dma_stats         *rx_dma;
 	struct pp_qos_stats         *qos;
-	struct smgr_mcast_pkt_stats *mcast;
+	struct mcast_stats          *mcast;
 	struct smgr_sq_stats        *syncq;
-	struct smgr_frag_stats      *frag;
+	struct frag_stats           *frag;
 
 	if (unlikely(ptr_is_null(buf) || ptr_is_null(n) || ptr_is_null(stats)))
 		return -EINVAL;
@@ -1115,11 +1122,11 @@ s32 pp_global_stats_show(char *buf, size_t sz, size_t *n, void *stats,
 		   chk->pkts_rcvd_from_cls - chk->accelerated_pkts,
 		   "TX   Syncq Packets", syncq->packets_accepted);
 	pr_buf_cat(buf, sz, *n, "| %-25s | %-20llu | %-25s | %-20u |\n",
-		   "RX Multicast Packets", mcast->rx,
+		   "RX Multicast Packets", mcast->rx_pkt,
 		   "Drop Syncq Packets", syncq->packets_dropped);
 	pr_buf_cat(buf, sz, *n, "| %-25s | %-20llu | %-25s | %-20llu |\n",
-		   "TX Multicast Packets", mcast->tx,
-		   "Drop Multicast Packets", mcast->drop);
+		   "TX Multicast Packets", mcast->tx_pkt,
+		   "Drop Multicast Packets", mcast->drop_pkt);
 	pr_buf_cat(buf, sz, *n,
 		   "+---------------------------+----------------------+---------------------------+----------------------+\n");
 	pr_buf_cat(buf, sz, *n, "| %-99s |\n", "          Drop Reasons");
diff --git a/drivers/net/ppv4/pp-api/pp-misc/pp_misc.h b/drivers/net/ppv4/pp-api/pp-misc/pp_misc.h
index 8837487e3018..ff34b28c41e4 100644
--- a/drivers/net/ppv4/pp-api/pp-misc/pp_misc.h
+++ b/drivers/net/ppv4/pp-api/pp-misc/pp_misc.h
@@ -23,6 +23,7 @@
 #include "pp_port_mgr.h"
 #include "pp_buffer_mgr.h"
 #include "pp_qos_utils.h"
+#include "uc.h"
 
 /**
  * @brief Misc module initial configuration parameters
@@ -73,10 +74,10 @@ struct pp_global_stats {
 	struct mod_stats            mod_stats;
 	struct rx_dma_stats         rx_dma_stats;
 	struct pp_qos_stats         qos_stats;
-	struct smgr_mcast_pkt_stats mcast_stats;
+	struct mcast_stats          mcast_stats;
 	struct smgr_sq_stats        syncq_stats;
-	struct smgr_reass_stats     reass_stats;
-	struct smgr_frag_stats      frag_stats;
+	struct reassembly_stats     reass_stats;
+	struct frag_stats           frag_stats;
 };
 
 /**
diff --git a/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c b/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c
index 606cc889ba48..830130e222aa 100644
--- a/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c
+++ b/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c
@@ -1738,81 +1738,6 @@ enum smgr_state smgr_state_get(void)
 	return db->state;
 }
 
-s32 pp_smgr_reassembly_stats_get(struct smgr_reass_stats *stats)
-{
-	struct reassembly_stats cpu_stats;
-	s32 ret;
-	u32 cid;
-
-	for (cid = 0; cid < UC_CPUS_MAX; cid++) {
-		if (!uc_is_cpu_active(UC_IS_EGR, cid))
-			continue;
-
-		ret = uc_reass_stats_get(cid, &cpu_stats);
-		if (unlikely(ret)) {
-			pr_err("failed to get reassembly uc cpu %u counters\n",
-			       cid);
-			return ret;
-		}
-		stats->rx_pkts          += cpu_stats.rx_pkts;
-		stats->tx_pkts          += cpu_stats.tx_pkts;
-		stats->reassembled_pkts += cpu_stats.reassembled;
-		stats->accelerated_pkts += cpu_stats.accelerated;
-		stats->diverted_pkts    += cpu_stats.diverted;
-		stats->starvation_pkts  += cpu_stats.cntxs_starv;
-		stats->starvation_pkts  += cpu_stats.frags_starv;
-		stats->dropped_pkts     += cpu_stats.dropped;
-		stats->errors           += cpu_stats.cntx_overflow;
-		stats->errors           += cpu_stats.duplicates;
-		stats->errors           += cpu_stats.unsupported;
-		stats->errors           += cpu_stats.invalid_len;
-		stats->errors           += cpu_stats.timedout;
-	}
-
-	return 0;
-}
-
-s32 smgr_frag_uc_cpu_stats_get(u32 cid, struct frag_stats *stats)
-{
-	if (unlikely(ptr_is_null(stats)))
-		return -EINVAL;
-
-	if (unlikely(!uc_is_cpu_active(UC_IS_EGR, cid)))
-		return -EPERM;
-
-	/* send command */
-	return uc_egr_mbox_cmd_send(UC_CMD_FRAG_STATS, cid, NULL, 0, stats,
-				    sizeof(*stats));
-}
-
-s32 pp_smgr_frag_stats_get(struct smgr_frag_stats *stats)
-{
-	struct frag_stats cpu_stats;
-	s32 ret;
-	u32 i;
-
-	for (i = 0; i < UC_CPUS_MAX; i++) {
-		if (!uc_is_cpu_active(UC_IS_EGR, i))
-			continue;
-
-		ret = smgr_frag_uc_cpu_stats_get(i, &cpu_stats);
-		if (unlikely(ret)) {
-			pr_err("failed to get frag uc cpu %u counters\n", i);
-			return ret;
-		}
-		stats->rx_pkt            += cpu_stats.rx_pkt;
-		stats->tx_pkt            += cpu_stats.tx_pkt;
-		stats->total_drops       += cpu_stats.total_drops;
-		stats->bmgr_drops        += cpu_stats.bmgr_drops;
-		stats->df_drops          += cpu_stats.df_drops;
-		stats->max_frags_drops   += cpu_stats.max_frags_drops;
-		stats->reserved1         += cpu_stats.reserved1;
-		stats->reserved2         += cpu_stats.reserved2;
-	}
-
-	return 0;
-}
-
