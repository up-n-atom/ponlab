From 4247f9ae4ba0f6cca568e34e7562ab1f14f5d07b Mon Sep 17 00:00:00 2001
From: arathinx <ayyappanx.rathinam@intel.com>
Date: Tue, 16 Jun 2020 16:08:02 +0800
Subject: [PATCH] DRVLIB_SW-3672: Resolve warning in spi driver

Operands of different size in bitwise operation warning
---
 drivers/spi/spi-cadence-qspi-apb.c | 2 +-
 drivers/spi/spi-grx500.c           | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/drivers/spi/spi-cadence-qspi-apb.c b/drivers/spi/spi-cadence-qspi-apb.c
index 524b7961dc20..f46eb43aeb07 100644
--- a/drivers/spi/spi-cadence-qspi-apb.c
+++ b/drivers/spi/spi-cadence-qspi-apb.c
@@ -88,7 +88,7 @@ static unsigned int cadence_qspi_apb_cmd2addr(const unsigned char *addr_buf,
 
 	for (i = 0; i < addr_width; i++) {
 		addr = addr << 8;
-		addr |= addr_buf[i];
+		addr |= (unsigned int)addr_buf[i];
 	}
 
 	return addr;
diff --git a/drivers/spi/spi-grx500.c b/drivers/spi/spi-grx500.c
index cd65e3809957..47d723b920c5 100644
--- a/drivers/spi/spi-grx500.c
+++ b/drivers/spi/spi-grx500.c
@@ -341,7 +341,7 @@ static u32 ltq_spi_tx_word(struct ltq_spi *hw, u32 num_of_bytes)
 
 	for (i = start; i < num_of_bytes && i >= 0; i += step) {
 		data = data << 8;
-		data |= tx[i];
+		data |= (u32)tx[i];
 	}
 
 	hw->tx_cnt += num_of_bytes;
