Date: Wed, 23 Sep 2020 18:21:56 +0800
Subject: [PATCH] DRV_DPM_SW-388 - subif lookup fail for pmapper dev during
 deregister

---
 drivers/net/datapath/dpm/datapath_api.c | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/drivers/net/datapath/dpm/datapath_api.c b/drivers/net/datapath/dpm/datapath_api.c
index 9f5e2c232408..0287727e25a7 100644
--- a/drivers/net/datapath/dpm/datapath_api.c
+++ b/drivers/net/datapath/dpm/datapath_api.c
@@ -1834,8 +1834,10 @@ int32_t dp_get_netif_subifid_priv(int inst, struct net_device *netif,
 				}
 			}
 		}
-		if (match)
+		if (match) {
+			res = 0;
 			break;
+		}
 	}
 	if (flags & DP_F_DEREGISTER)
 		goto EXIT;
