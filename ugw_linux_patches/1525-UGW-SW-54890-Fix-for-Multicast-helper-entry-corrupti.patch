From 75d0f252fbf5f9abee8c6668b9dff9ffeafe6d1d Mon Sep 17 00:00:00 2001
From: gsupriya <supriya1.g@intel.com>
Date: Tue, 24 Nov 2020 16:40:56 +0530
Subject: [PATCH] UGW_SW-54890:Fix for Multicast helper entry corruption in
 br_forward- Lan Server multicast hook

---
 net/bridge/br_forward.c | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/net/bridge/br_forward.c b/net/bridge/br_forward.c
index 5274eb40c24b..894040d8ec87 100644
--- a/net/bridge/br_forward.c
+++ b/net/bridge/br_forward.c
@@ -22,6 +22,9 @@
 #include "br_private.h"
 
 #if IS_ENABLED(CONFIG_MCAST_HELPER)
+#include <net/ip.h>
+#include <linux/mroute6.h>
+
 void (*five_tuple_br_info_ptr)(struct sk_buff *skb) = NULL;
 void (*five_tuple_br_info_hook)(struct sk_buff *skb) = NULL;
 EXPORT_SYMBOL(five_tuple_br_info_ptr);
@@ -131,6 +134,7 @@ static int deliver_clone(const struct net_bridge_port *prev,
 	struct net_device *dev = BR_INPUT_SKB_CB(skb)->brdev;
 #if IS_ENABLED(CONFIG_MCAST_HELPER)
 	const unsigned char *dest = eth_hdr(skb)->h_dest;
+	struct dst_entry *dst = skb_dst(skb);
 #endif
 
 	skb = skb_clone(skb, GFP_ATOMIC);
@@ -152,9 +156,11 @@ static int deliver_clone(const struct net_bridge_port *prev,
 	/* hook the UDP multicast to mcast helper */
 	if (bridge_lanserver_hook == 1) {
 		if (!is_broadcast_ether_addr(dest) && is_multicast_ether_addr(dest) && ((ip_hdr(skb)->protocol == IPPROTO_UDP) || (ipv6_hdr(skb)->nexthdr == IPPROTO_UDP))) {
-			if (five_tuple_br_info_hook != NULL) {
-					five_tuple_br_info_hook(skb);
+			if (!((dst != NULL) && (((uint32_t)(dst->input) == (uint32_t)ip_mr_input) || ((uint32_t)(dst->input) == (uint32_t)ip6_mr_input)))) {
+				if (five_tuple_br_info_hook != NULL) {
+						five_tuple_br_info_hook(skb);
 				}
+			}
 		}
 	}
 #endif
