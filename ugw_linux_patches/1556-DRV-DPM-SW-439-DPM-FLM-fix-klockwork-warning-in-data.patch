From d795a65ffdd041414e2e6ab524f8a7f2857962d4 Mon Sep 17 00:00:00 2001
From: Jack Ping CHNG <jack.ping.chng@linux.intel.com>
Date: Mon, 21 Dec 2020 17:18:50 +0800
Subject: [PATCH] DRV_DPM_SW-439 - DPM FLM fix klockwork warning in datapath
 gswip

---
 drivers/net/datapath/dpm/gswip31/datapath_gswip.c | 15 ++++++++++++---
 1 file changed, 12 insertions(+), 3 deletions(-)

diff --git a/drivers/net/datapath/dpm/gswip31/datapath_gswip.c b/drivers/net/datapath/dpm/gswip31/datapath_gswip.c
index 00f5c5f780dc..cf307d8e3558 100644
--- a/drivers/net/datapath/dpm/gswip31/datapath_gswip.c
+++ b/drivers/net/datapath/dpm/gswip31/datapath_gswip.c
@@ -58,7 +58,7 @@ enum {
 #define CTP_ASSIGN_MASK GENMASK(17, 0)
 
 static const struct ctp_assign ctp_assign_info[3][CTP_MAX] = {
-	{ 0 },
+	{{ 0 }},
 	/* GSWIP 31 */
 	{
 	[CTP_DEFAULT]
@@ -607,8 +607,11 @@ struct gsw_itf *dp_gsw_assign_ctp(int inst, u8 ep, int bp_def, u32 flags,
 	}
 
 	ctp_assign = dp_gsw_get_ctp_assign(inst, port_info->alloc_flags);
-	if (!ctp_assign)
+	if (!ctp_assign) {
 		ctp_assign = dp_gsw_get_ctp_assign(inst, CTP_DEFAULT);
+		if (!ctp_assign)
+			return NULL;
+	}
 
 	if (data && data->max_ctp)
 		ctp.nNumberOfCtpPort  = data->max_ctp;
@@ -667,8 +670,12 @@ int dp_gsw_set_port_lu_md(int inst, u8 ep, u32 flags)
 	const struct ctp_assign *ctp_assign;
 
 	ctp_assign = dp_gsw_get_ctp_assign(inst, port_info->alloc_flags);
-	if (!ctp_assign)
+	if (!ctp_assign) {
 		ctp_assign = dp_gsw_get_ctp_assign(inst, CTP_DEFAULT);
+		if (!ctp_assign)
+			return DP_FAILURE;
+	}
+
 	port_info->cqe_lu_mode = ctp_assign->cqe_lu_md;
 	port_info->gsw_mode = ctp_assign->emode;
 
@@ -1746,6 +1753,8 @@ int gpid_port_assign(int inst, u8 ep, u32 flags)
 	}
 
 	ctp_assign = dp_gsw_get_ctp_assign(inst, port->alloc_flags);
+	if (!ctp_assign)
+		return DP_FAILURE;
 
 	gpid_num = ctp_assign->max_gpid;
 	gpid_base = alloc_gpid(inst, DP_DYN_GPID, gpid_num, ep);
