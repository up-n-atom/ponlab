From 7ac375ea249c542792c15b9521b2c799517f2169 Mon Sep 17 00:00:00 2001
From: Elad Fernandes <elad.fernandes@intel.com>
Date: Sun, 19 Apr 2020 14:54:20 +0300
Subject: [PATCH] PONRTSYS-7747: Support ip length modification for esp bypass
 sessions

---
 .../ppv4/pp-api/pp-session-mgr/pp_session_mgr.c    | 164 +++++++----
 .../pp-session-mgr/pp_session_mgr_internal.h       |  34 ++-
 drivers/net/ppv4/pp-hal/modifier/modifier.h        |  12 +-
 .../net/ppv4/pp-hal/modifier/modifier_recipes.c    | 302 ++++++++++++++-------
 4 files changed, 333 insertions(+), 179 deletions(-)

diff --git a/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c b/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c
index 119319929d04..d633447745fd 100644
--- a/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c
+++ b/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c
@@ -466,7 +466,8 @@ static inline bool __smgr_is_iptun_decp_sess(struct sess_info *s)
 static inline bool __smgr_is_iptun_encp_sess(struct sess_info *s)
 {
 	return (!PKTPRS_IS_MULTI_IP(SESS_RX_PKT(s)) &&
-		PKTPRS_IS_MULTI_IP(SESS_TX_PKT(s)));
+		PKTPRS_IS_MULTI_IP(SESS_TX_PKT(s)) &&
+		!SESS_TX_IS_OUTER_ESP(s));
 }
 
 static inline bool __smgr_is_first_frag_bypass(struct sess_info *s, u8 lvl)
@@ -631,6 +632,46 @@ static inline bool __smgr_is_frag_supported(struct sess_info *s)
 	return false;
 }
 
+/**
+ * for ESP sessions the support is for two cases:
+ * 1. esp encapsulation:
+ * rx - mac-vlan(opt)-ipv4-udp/tcp
+ * tx - mac-vlan(opt)-ipv4-esp-IV(opt)-ipv4-udp/tcp (clear text)
+ * @note NAT is not supported
+ * 2. esp bypass:
+ * rx - mac-vlan(opt)-pppoe(opt)-ipv4-esp
+ * tx - mac-vlan(opt)-pppoe(opt)-ipv4-esp
+ * @param s the session to test
+ * @return bool true if it is, false otherwise
+ */
+static inline bool __smgr_is_esp_supported(struct sess_info *s)
+{
+	/* for both cases tx must include esp and outer ipv4 */
+	if (!(SESS_TX_IS_OUTER_ESP(s) && SESS_TX_IS_OUTER_V4(s)))
+		return false;
+
+	/* encapsulation */
+	if (!SESS_RX_IS_OUTER_ESP(s) &&
+	    !PKTPRS_IS_PPPOE(SESS_TX_PKT(s), HDR_OUTER) &&
+	    (SESS_TX_OUTER_V4_NEXT(s) == PKTPRS_PROTO_ESP) &&
+	    (SESS_TX_ESP_NEXT(s) == PKTPRS_PROTO_IPV4) &&
+	    (pktprs_ipv4_hdr(SESS_RX_PKT(s), HDR_OUTER)->saddr ==
+	     pktprs_ipv4_hdr(SESS_TX_PKT(s), HDR_INNER)->saddr)) {
+		SESS_MOD_FLAG_SET(s, MOD_ESP_V4_TUNNL_ENCP_BIT);
+		return true;
+	}
+
+	/* bypass */
+	if (SESS_RX_IS_OUTER_ESP(s) &&
+	    (SESS_TX_OUTER_V4_NEXT(s) == PKTPRS_PROTO_ESP) &&
+	    (SESS_RX_PKT(s)->buf_sz == SESS_TX_PKT(s)->buf_sz)) {
+		SESS_MOD_FLAG_SET(s, MOD_ESP_V4_TUNNL_BPAS_BIT);
+		return true;
+	}
+
+	return false;
+}
+
 /**
  * @brief Test whether a changes in the ipv6 extension headers are supported
  * @param s the session to test
@@ -680,9 +721,9 @@ static inline bool __smgr_is_eogre_term_sess(struct sess_info *s)
 	    !SESS_RX_IS_L2_GRE(s)  &&
 	    SESS_TX_IS_INNER_IP(s) &&
 	    SESS_TX_IS_INNER_L4(s)) {
-		if (SESS_TX_IS_OUTER_IPV4(s))
+		if (SESS_TX_IS_OUTER_V4(s))
 			SESS_MOD_FLAG_SET(s, MOD_EOGRE_V4_ENCP_BIT);
-		else if (SESS_TX_IS_OUTER_IPV6(s))
+		else if (SESS_TX_IS_OUTER_V6(s))
 			SESS_MOD_FLAG_SET(s, MOD_EOGRE_V6_ENCP_BIT);
 		return true;
 	}
@@ -711,9 +752,9 @@ static inline bool __smgr_is_ipogre_term_sess(struct sess_info *s)
 	if (SESS_TX_IS_IP_GRE(s)  &&
 	    !SESS_RX_IS_IP_GRE(s) &&
 	    SESS_TX_IS_INNER_L4(s)) {
-		if (SESS_TX_IS_OUTER_IPV4(s))
+		if (SESS_TX_IS_OUTER_V4(s))
 			SESS_MOD_FLAG_SET(s, MOD_IPOGRE_V4_ENCP_BIT);
-		else if (SESS_TX_IS_OUTER_IPV6(s))
+		else if (SESS_TX_IS_OUTER_V6(s))
 			SESS_MOD_FLAG_SET(s, MOD_IPOGRE_V6_ENCP_BIT);
 		return true;
 	}
@@ -808,9 +849,9 @@ static inline bool __smgr_is_l2tpudp_term_sess(struct sess_info *s)
 	    !PKTPRS_IS_MULTI_LEVEL(SESS_RX_PKT(s)) &&
 	    SESS_TX_IS_INNER_IP(s)                 &&
 	    SESS_TX_IS_INNER_L4(s)) {
-		if (SESS_TX_IS_OUTER_IPV4(s))
+		if (SESS_TX_IS_OUTER_V4(s))
 			SESS_MOD_FLAG_SET(s, MOD_L2TPUDP_IPV4_ENCP_BIT);
-		else if (SESS_TX_IS_OUTER_IPV6(s))
+		else if (SESS_TX_IS_OUTER_V6(s))
 			SESS_MOD_FLAG_SET(s, MOD_L2TPUDP_IPV6_ENCP_BIT);
 		return true;
 	}
@@ -849,9 +890,9 @@ static inline bool __smgr_is_l2tpip_term_sess(struct sess_info *s)
 	    !PKTPRS_IS_L2TP_OIP(SESS_RX_PKT(s), HDR_OUTER) &&
 	    SESS_TX_IS_INNER_IP(s)                 &&
 	    SESS_TX_IS_INNER_L4(s)) {
-		if (SESS_TX_IS_OUTER_IPV4(s))
+		if (SESS_TX_IS_OUTER_V4(s))
 			SESS_MOD_FLAG_SET(s, MOD_L2TPIP_IPV4_ENCP_BIT);
-		else if (SESS_TX_IS_OUTER_IPV6(s))
+		else if (SESS_TX_IS_OUTER_V6(s))
 			SESS_MOD_FLAG_SET(s, MOD_L2TPIP_IPV6_ENCP_BIT);
 		return true;
 	}
@@ -859,6 +900,16 @@ static inline bool __smgr_is_l2tpip_term_sess(struct sess_info *s)
 	return false;
 }
 
+/**
+ * @brief Check whether a session is ESP
+ * @param s the session to test
+ * @return bool true if it is, false otherwise
+ */
+static inline bool __smgr_is_esp_sess(struct sess_info *s)
+{
+	return SESS_RX_IS_OUTER_ESP(s) || SESS_TX_IS_OUTER_ESP(s);
+}
+
 /**
  * @brief Check whether a session is ESP encapsulation
  * @param s the session to test
@@ -866,8 +917,7 @@ static inline bool __smgr_is_l2tpip_term_sess(struct sess_info *s)
  */
 static inline bool __smgr_is_esp_encp_sess(struct sess_info *s)
 {
-	return !PKTPRS_IS_ESP(SESS_RX_PKT(s), HDR_OUTER) &&
-	       PKTPRS_IS_ESP(SESS_TX_PKT(s), HDR_OUTER);
+	return !SESS_RX_IS_OUTER_ESP(s) && SESS_TX_IS_OUTER_ESP(s);
 }
 
 /**
@@ -2018,6 +2068,14 @@ static bool __smgr_is_sess_supported(struct sess_info *s)
 		goto not_supported;
 	}
 
+	/* ESP */
+	if (__smgr_is_esp_sess(s)) {
+		if (__smgr_is_esp_supported(s))
+			return true;
+		pr_debug("unsupported esp session\n");
+		goto not_supported;
+	}
+
 	/* tunnel bypass? supported */
 	if (__smgr_is_tunn_bypass_sess(s)) {
 		pr_debug("tunnel bypass session\n");
@@ -2336,11 +2394,11 @@ static s32 __smgr_si_ipv6_nat_set(struct sess_info *s)
 static s32 __smgr_si_nat_set(struct sess_info *s)
 {
 	/* if the session is bridged and not tunnel termination,
-	 * or if the session is esp encapsulation (TBD: adding esp NAT support)
+	 * or if the session is esp (TBD: adding esp NAT support)
 	 * no nat/napt is needed
 	 */
 	if ((__smgr_is_sess_bridged(s) && !__smgr_is_tunn_term_sess(s)) ||
-	    __smgr_is_esp_encp_sess(s))
+	    SESS_TX_IS_OUTER_ESP(s))
 		return 0;
 
 	if (__smgr_is_sess_bridged(s) &&
@@ -2393,60 +2451,50 @@ static void __smgr_si_newhdr_set(struct sess_info *s)
 	struct pp_si_bce *bce = &s->si.bce;
 	struct pp_si_dpu *dpu = &s->si.dpu;
 	struct pp_si_sce *sce = &s->si.sce;
-	u8 inner_ip, outer_ip;
-
-	if (PKTPRS_IS_IPV4(SESS_TX_PKT(s), HDR_OUTER))
-		outer_ip = PKTPRS_PROTO_IPV4;
-	else
-		outer_ip = PKTPRS_PROTO_IPV6;
-	if (PKTPRS_IS_IPV4(SESS_TX_PKT(s), HDR_INNER))
-		inner_ip = PKTPRS_PROTO_IPV4;
-	else
-		inner_ip = PKTPRS_PROTO_IPV6;
+	u8 tx_ip, tx_inner_ip;
 
-	dpu->nhdr_l3_off = pktprs_hdr_off(SESS_TX_PKT(s), outer_ip, HDR_OUTER);
+	tx_ip = SESS_TX_IS_OUTER_V4(s) ? PKTPRS_PROTO_IPV4 : PKTPRS_PROTO_IPV6;
+	dpu->nhdr_l3_off = pktprs_hdr_off(SESS_TX_PKT(s), tx_ip, HDR_OUTER);
+	s->si.pkt_len_diff = SESS_TX_PKT(s)->buf_sz - SESS_RX_PKT(s)->buf_sz;
+	sce->tot_len_diff = 0;
 
 	if (__smgr_is_iptun_encp_sess(s)) {
-		dpu->nhdr_sz = pktprs_hdr_off(SESS_TX_PKT(s), inner_ip,
+		/* ip tunnel encapsulation session */
+		tx_inner_ip = SESS_RX_IS_INNER_V4(s) ?
+			      PKTPRS_PROTO_IPV4 : PKTPRS_PROTO_IPV6;
+		/* nhdr size is the tx header up to the inner ip offset */
+		dpu->nhdr_sz = pktprs_hdr_off(SESS_TX_PKT(s), tx_inner_ip,
 					      HDR_INNER);
 		sce->tot_len_diff = dpu->nhdr_sz - dpu->nhdr_l3_off;
-		if (outer_ip == PKTPRS_PROTO_IPV6 &&
-		    inner_ip == PKTPRS_PROTO_IPV4)
+		if (tx_ip == PKTPRS_PROTO_IPV6 &&
+		    tx_inner_ip == PKTPRS_PROTO_IPV4)
 			sce->tot_len_diff -= sizeof(struct ipv6hdr);
-		s->si.pkt_len_diff =
-			dpu->nhdr_sz -
-			pktprs_hdr_off(SESS_RX_PKT(s), outer_ip, HDR_OUTER);
-	} else if (__smgr_is_esp_encp_sess(s)) {
-		/* new header size should include the ESP header w/o the IV */
-		dpu->nhdr_sz = pktprs_hdr_off(SESS_TX_PKT(s),
-					      PKTPRS_PROTO_ESP,
-					      HDR_OUTER) + 8;
-		/* total len should include the ESP header + IV */
-		sce->tot_len_diff =
-			pktprs_hdr_sz(SESS_TX_PKT(s),
-				      PKTPRS_PROTO_ESP, HDR_OUTER) -
-			pktprs_hdr_off(SESS_RX_PKT(s), outer_ip, HDR_OUTER);
-		s->si.pkt_len_diff =
-			dpu->nhdr_sz -
-			pktprs_hdr_off(SESS_RX_PKT(s), outer_ip, HDR_OUTER);
-		if (SESS_TX_IS_OUTER_IPV4(s)) {
-			SESS_MOD_FLAG_SET(s, MOD_ESP_V4_TUNNL_ENCP_BIT);
+	} else if (SESS_TX_IS_OUTER_ESP(s)) {
+		/* esp session */
+		if (!SESS_RX_IS_OUTER_ESP(s)) {
+			/* esp outbound encapsulation session */
+			dpu->nhdr_sz = pktprs_hdr_sz(SESS_TX_PKT(s),
+						     PKTPRS_PROTO_ESP,
+						     HDR_OUTER);
+			/* tot_len_diff = nhdr_sz - tx_ip_off */
+			sce->tot_len_diff = dpu->nhdr_sz - dpu->nhdr_l3_off;
 		} else {
-			SESS_MOD_FLAG_SET(s, MOD_ESP_V6_TUNNL_ENCP_BIT);
-			sce->tot_len_diff -= sizeof(struct ipv6hdr);
+			/* esp inbound/outbound tunnel session */
+			dpu->nhdr_sz      = dpu->nhdr_l3_off;
 		}
+		/* TBD - for ipv6 need to reduce the ip header size
+		 * sce->tot_len_diff -= sizeof(struct ipv6hdr);
+		 */
 	} else if (__smgr_is_outer_l2_changed(s)) {
-		dpu->nhdr_sz = pktprs_hdr_off(SESS_TX_PKT(s), outer_ip,
-					      HDR_OUTER);
-		s->si.pkt_len_diff =
-			dpu->nhdr_sz -
-			pktprs_hdr_off(SESS_RX_PKT(s), outer_ip, HDR_OUTER);
+		/* routing and tunnel decapsulation sessions */
+		dpu->nhdr_sz = dpu->nhdr_l3_off;
 	} else {
+		/* no modification session */
 		dpu->nhdr_sz = 0;
 		dpu->nhdr_l3_off = 0;
 	}
 
-	/* if no new header, done. */
+	/* if no new header, done */
 	if (!dpu->nhdr_sz)
 		return;
 
@@ -2456,7 +2504,7 @@ static void __smgr_si_newhdr_set(struct sess_info *s)
 	memcpy(bce->nhdr, SESS_TX_PKT(s)->buf, dpu->nhdr_sz);
 
 	/* if new header including ipv4, update the ip layer */
-	if (SESS_TX_IS_OUTER_IPV4(s) && (dpu->nhdr_sz > dpu->nhdr_l3_off))
+	if (SESS_TX_IS_OUTER_V4(s) && (dpu->nhdr_sz > dpu->nhdr_l3_off))
 		__smgr_newhdr_ipv4_update(s);
 }
 
@@ -2513,7 +2561,7 @@ static s32 __smgr_frag_si_ud_set(struct sess_info *s)
 	 */
 	if (frag_info.flags & FRAG_INFO_FLAG_FRAG_EXT) {
 		frag_info.l3_off = s->si.dpu.nhdr_l3_off;
-		if (SESS_TX_IS_OUTER_IPV4(s)) {
+		if (SESS_TX_IS_OUTER_V4(s)) {
 			frag_info.flags |= FRAG_INFO_FLAG_IPV4;
 			if (pktprs_ipv4_hdr(SESS_TX_PKT(s),
 					    HDR_OUTER)->frag_off &
@@ -2521,7 +2569,7 @@ static s32 __smgr_frag_si_ud_set(struct sess_info *s)
 				frag_info.flags |= FRAG_INFO_FLAG_EXT_DF;
 		}
 	} else {
-		if (SESS_TX_IS_INNER_IPV4(s)) {
+		if (SESS_TX_IS_INNER_V4(s)) {
 			frag_info.l3_off = pktprs_hdr_off(SESS_TX_PKT(s),
 							  PKTPRS_PROTO_IPV4,
 							  HDR_INNER);
@@ -2670,7 +2718,7 @@ static void __smgr_pppoe_mod_set(struct sess_info *s)
 			 * cause its length field doesn't include it
 			 */
 			if (__smgr_is_iptun_encp_sess(s) &&
-			    SESS_TX_IS_OUTER_IPV6(s))
+			    SESS_TX_IS_OUTER_V6(s))
 				sce->pppoe_diff += sizeof(struct ipv6hdr);
 			dpu->pppoe_off = pktprs_hdr_off(SESS_TX_PKT(s),
 							PKTPRS_PROTO_PPPOE,
@@ -2703,7 +2751,7 @@ static void __smgr_pppoe_mod_set(struct sess_info *s)
  */
 static void __smgr_si_l2_mod_set(struct sess_info *s)
 {
-	if (__smgr_is_outer_l2_changed(s))
+	if (__smgr_is_outer_l2_changed(s) || SESS_TX_IS_OUTER_ESP(s))
 		SESS_MOD_FLAG_SET(s, MOD_HDR_RPLC_BIT);
 
 	if (__smgr_is_pppoe_changed(s, HDR_INNER))
diff --git a/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr_internal.h b/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr_internal.h
index 825ba574e8b6..e837eaf815b9 100644
--- a/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr_internal.h
+++ b/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr_internal.h
@@ -114,27 +114,30 @@ enum smgr_sess_flags {
  * @brief Shortcuts for checking if session is ipv4
  * @param s session info pointer
  */
-#define SESS_RX_IS_OUTER_IPV4(s)       PKTPRS_IS_IPV4(SESS_RX_PKT(s), HDR_OUTER)
-#define SESS_TX_IS_OUTER_IPV4(s)       PKTPRS_IS_IPV4(SESS_TX_PKT(s), HDR_OUTER)
-#define SESS_RX_IS_INNER_IPV4(s)       PKTPRS_IS_IPV4(SESS_RX_PKT(s), HDR_INNER)
-#define SESS_TX_IS_INNER_IPV4(s)       PKTPRS_IS_IPV4(SESS_TX_PKT(s), HDR_INNER)
-#define SESS_RX_IS_OUTER_IPV6(s)       PKTPRS_IS_IPV6(SESS_RX_PKT(s), HDR_OUTER)
-#define SESS_TX_IS_OUTER_IPV6(s)       PKTPRS_IS_IPV6(SESS_TX_PKT(s), HDR_OUTER)
-#define SESS_RX_IS_INNER_IPV6(s)       PKTPRS_IS_IPV6(SESS_RX_PKT(s), HDR_INNER)
-#define SESS_TX_IS_INNER_IPV6(s)       PKTPRS_IS_IPV6(SESS_TX_PKT(s), HDR_INNER)
+#define SESS_RX_IS_OUTER_V4(s)         PKTPRS_IS_IPV4(SESS_RX_PKT(s), HDR_OUTER)
+#define SESS_TX_IS_OUTER_V4(s)         PKTPRS_IS_IPV4(SESS_TX_PKT(s), HDR_OUTER)
+#define SESS_RX_IS_INNER_V4(s)         PKTPRS_IS_IPV4(SESS_RX_PKT(s), HDR_INNER)
+#define SESS_TX_IS_INNER_V4(s)         PKTPRS_IS_IPV4(SESS_TX_PKT(s), HDR_INNER)
+#define SESS_RX_IS_OUTER_V6(s)         PKTPRS_IS_IPV6(SESS_RX_PKT(s), HDR_OUTER)
+#define SESS_TX_IS_OUTER_V6(s)         PKTPRS_IS_IPV6(SESS_TX_PKT(s), HDR_OUTER)
+#define SESS_RX_IS_INNER_V6(s)         PKTPRS_IS_IPV6(SESS_RX_PKT(s), HDR_INNER)
+#define SESS_TX_IS_INNER_V6(s)         PKTPRS_IS_IPV6(SESS_TX_PKT(s), HDR_INNER)
+
+#define SESS_TX_OUTER_V4_NEXT(s) \
+PKTPRS_PROTO_NEXT(SESS_TX_PKT(s), PKTPRS_PROTO_IPV4, HDR_OUTER)
 
 /**
  * @brief Shortcuts for checking if session is ip
  * @param s session info pointer
  */
 #define SESS_RX_IS_OUTER_IP(s) \
-(SESS_RX_IS_OUTER_IPV4(s) || SESS_RX_IS_OUTER_IPV6(s))
+(SESS_RX_IS_OUTER_V4(s) || SESS_RX_IS_OUTER_V6(s))
 #define SESS_TX_IS_OUTER_IP(s) \
-(SESS_TX_IS_OUTER_IPV4(s) || SESS_TX_IS_OUTER_IPV6(s))
+(SESS_TX_IS_OUTER_V4(s) || SESS_TX_IS_OUTER_V6(s))
 #define SESS_RX_IS_INNER_IP(s) \
-(SESS_RX_IS_INNER_IPV4(s) || SESS_RX_IS_INNER_IPV6(s))
+(SESS_RX_IS_INNER_V4(s) || SESS_RX_IS_INNER_V6(s))
 #define SESS_TX_IS_INNER_IP(s) \
-(SESS_TX_IS_INNER_IPV4(s) || SESS_TX_IS_INNER_IPV6(s))
+(SESS_TX_IS_INNER_V4(s) || SESS_TX_IS_INNER_V6(s))
 
 /**
  * @brief Shortcuts for checking if session is udp
@@ -159,9 +162,12 @@ enum smgr_sess_flags {
  * @param s session info pointer
  */
 #define SESS_RX_IS_OUTER_ESP(s)         PKTPRS_IS_ESP(SESS_RX_PKT(s), HDR_OUTER)
-#define SESS_TX_IS_OUTER_ESP(s)         PKTPRS_IS_ESP(SESS_RX_PKT(s), HDR_OUTER)
+#define SESS_TX_IS_OUTER_ESP(s)         PKTPRS_IS_ESP(SESS_TX_PKT(s), HDR_OUTER)
 #define SESS_RX_IS_INNER_ESP(s)         PKTPRS_IS_ESP(SESS_RX_PKT(s), HDR_INNER)
-#define SESS_TX_IS_INNER_ESP(s)         PKTPRS_IS_ESP(SESS_RX_PKT(s), HDR_INNER)
+#define SESS_TX_IS_INNER_ESP(s)         PKTPRS_IS_ESP(SESS_TX_PKT(s), HDR_INNER)
+
+#define SESS_TX_ESP_NEXT(s) \
+PKTPRS_PROTO_NEXT(SESS_TX_PKT(s), PKTPRS_PROTO_ESP, HDR_OUTER)
 
 /**
  * @brief Shortcuts for checking if session is supported L4
