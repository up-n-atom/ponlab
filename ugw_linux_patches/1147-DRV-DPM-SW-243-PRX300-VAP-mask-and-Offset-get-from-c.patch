From 9795cb885d5d01a29751724930291ac8f54d9e62 Mon Sep 17 00:00:00 2001
From: thampan <joby.thampan@intel.com>
Date: Wed, 29 Apr 2020 10:59:10 +0800
Subject: [PATCH] DRV_DPM_SW-243: PRX300 VAP mask and Offset get from
 capability structure directly

---
 drivers/net/datapath/dpm/gswip31/datapath_gswip.c | 29 +++++++++++------------
 1 file changed, 14 insertions(+), 15 deletions(-)

diff --git a/drivers/net/datapath/dpm/gswip31/datapath_gswip.c b/drivers/net/datapath/dpm/gswip31/datapath_gswip.c
index 0518ccd50b9c..6d6274d9e5b1 100644
--- a/drivers/net/datapath/dpm/gswip31/datapath_gswip.c
+++ b/drivers/net/datapath/dpm/gswip31/datapath_gswip.c
@@ -528,7 +528,7 @@ struct gsw_itf *ctp_port_assign(int inst, u8 ep, int bp_default,
 	struct core_ops *gsw_handle;
 	struct ctp_ops *gsw_ctp;
 	struct pmac_port_info *port_info = get_dp_port_info(inst, ep);
-	struct dp_cap cap;
+	struct dp_cap *cap;
 
 	memset(&ctp_assign, 0, sizeof(ctp_assign));
 	gsw_handle = dp_port_prop[inst].ops[GSWIP_L];
@@ -582,26 +582,25 @@ struct gsw_itf *ctp_port_assign(int inst, u8 ep, int bp_default,
 	port_info->subif_max = assign->num_subif;
 	port_info->ctp_max = ctp_assign.nNumberOfCtpPort;
 
-	cap.inst = inst;
-	dp_get_cap(&cap, 0);
+	cap = &get_dp_prop_info(inst)->cap;
 
 	/* HW capaility have only 3 modes 8-bit, 9-bit or Non-WLAN mode */
 	if (assign->emode == GSW_LOGICAL_PORT_8BIT_WLAN) {
-		port_info->vap_offset = 
-			cap.vap_offset[GSW_LOGICAL_PORT_8BIT_WLAN];
-		port_info->vap_mask = 
-			cap.vap_mask[GSW_LOGICAL_PORT_8BIT_WLAN];
+		port_info->vap_offset =
+			cap->vap_offset[GSW_LOGICAL_PORT_8BIT_WLAN];
+		port_info->vap_mask =
+			cap->vap_mask[GSW_LOGICAL_PORT_8BIT_WLAN];
 	} else if (assign->emode == GSW_LOGICAL_PORT_9BIT_WLAN) {
-		port_info->vap_offset = 
-			cap.vap_offset[GSW_LOGICAL_PORT_9BIT_WLAN];
-		port_info->vap_mask = 
-			cap.vap_mask[GSW_LOGICAL_PORT_9BIT_WLAN];
+		port_info->vap_offset =
+			cap->vap_offset[GSW_LOGICAL_PORT_9BIT_WLAN];
+		port_info->vap_mask =
+			cap->vap_mask[GSW_LOGICAL_PORT_9BIT_WLAN];
 	} else {
 		/* GPON, EPON, G.INT take this mode */
-		port_info->vap_offset = 
-		cap.vap_offset[GSW_LOGICAL_PORT_GPON];
-		port_info->vap_mask = 
-			cap.vap_mask[GSW_LOGICAL_PORT_GPON];
+		port_info->vap_offset =
+			cap->vap_offset[GSW_LOGICAL_PORT_GPON];
+		port_info->vap_mask =
+			cap->vap_mask[GSW_LOGICAL_PORT_GPON];
 	}
 
 #if IS_ENABLED(CONFIG_INTEL_DATAPATH_SWITCHDEV)
