From da85d708814ef2f18ecef30780870e5afa7d56df Mon Sep 17 00:00:00 2001
From: Oren Bakshe <oren.bakshe@intel.com>
Date: Mon, 25 Nov 2019 15:41:39 +0200
Subject: [PATCH] PONRTSYS-6246: RPB and rx_dma small debugfs fix

---
 drivers/net/ppv4/pp-hal/receive-packet-buffer/rpb_debugfs.c | 2 +-
 drivers/net/ppv4/pp-hal/rx-dma/rx_dma.c                     | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/drivers/net/ppv4/pp-hal/receive-packet-buffer/rpb_debugfs.c b/drivers/net/ppv4/pp-hal/receive-packet-buffer/rpb_debugfs.c
index 1cfbbfe1fad2..c01021954f69 100644
--- a/drivers/net/ppv4/pp-hal/receive-packet-buffer/rpb_debugfs.c
+++ b/drivers/net/ppv4/pp-hal/receive-packet-buffer/rpb_debugfs.c
@@ -919,7 +919,7 @@ static struct debugfs_file tcs_files[] = {
 	{ "dpool_high_threshold", &PP_DEBUGFS_FOPS(tc_dpool_high_thr) },
 	{ "dpool_low_threshold", &PP_DEBUGFS_FOPS(tc_dpool_low_thr) },
 	{ "spool_high_threshold", &PP_DEBUGFS_FOPS(tc_spool_high_thr) },
-	{ "spool_low_threshold", &PP_DEBUGFS_FOPS(tc_spool_high_thr) },
+	{ "spool_low_threshold", &PP_DEBUGFS_FOPS(tc_spool_low_thr) },
 };
 
 static s32 rpb_dbg_tc_init(u32 port, u32 tc, struct dentry *port_dbgfs)
diff --git a/drivers/net/ppv4/pp-hal/rx-dma/rx_dma.c b/drivers/net/ppv4/pp-hal/rx-dma/rx_dma.c
index caad372d1f04..10a5bdbbcfcf 100644
--- a/drivers/net/ppv4/pp-hal/rx-dma/rx_dma.c
+++ b/drivers/net/ppv4/pp-hal/rx-dma/rx_dma.c
@@ -333,7 +333,7 @@ s32 rx_dma_port_get(struct rx_dma_port_cfg *port_cfg)
 	reg_val = PP_REG_RD32(
 		PP_RX_DMA_EGRESS_PORT_CFG_REG_IDX(port_cfg->port_id));
 	port_cfg->pkt_only =
-		FIELD_GET(PP_RX_DMA_EGRESS_PORT_CFG_ERROR_BIT_MSK, reg_val);
+		FIELD_GET(PP_RX_DMA_EGRESS_PORT_CFG_PKT_ONLY_MSK, reg_val);
 	port_cfg->min_pkt_size =
 		FIELD_GET(PP_RX_DMA_EGRESS_PORT_CFG_MIN_PKT_SIZE_MSK, reg_val);
 	port_cfg->wr_desc =
