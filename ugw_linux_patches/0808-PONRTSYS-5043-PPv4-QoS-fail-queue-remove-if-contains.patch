From 009f044d2475e01762aa45fc4623aef473fe123d Mon Sep 17 00:00:00 2001
From: ofirbitt <ofir1.bitton@intel.com>
Date: Wed, 18 Sep 2019 15:30:44 +0300
Subject: [PATCH] PONRTSYS-5043: PPv4 QoS - fail queue remove if contains Occ

---
 drivers/net/ethernet/lantiq/ppv4/qos/pp_qos_main.c | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/drivers/net/ethernet/lantiq/ppv4/qos/pp_qos_main.c b/drivers/net/ethernet/lantiq/ppv4/qos/pp_qos_main.c
index a79059ee8116..14c0458fd712 100644
--- a/drivers/net/ethernet/lantiq/ppv4/qos/pp_qos_main.c
+++ b/drivers/net/ethernet/lantiq/ppv4/qos/pp_qos_main.c
@@ -1166,12 +1166,26 @@ int pp_qos_queue_conf_get(
 static int _pp_qos_queue_remove(struct pp_qos_dev *qdev, int id)
 {
 	struct qos_node *node;
+	struct pp_qos_queue_stat qstat;
 	int rc;
 
 	node = get_conform_node(qdev, id, node_queue);
 	if (!node)
 		return -EINVAL;
 
+	create_get_queue_stats_cmd(qdev, get_phy_from_id(qdev->mapping, id),
+				   node->data.queue.rlm,
+				   qdev->hwconf.fw_stat,
+				   &qstat);
+	update_cmd_id(&qdev->drvcmds);
+	transmit_cmds(qdev);
+
+	if (qstat.queue_packets_occupancy) {
+		QOS_LOG_ERR("Queue %u Occ %u, cannot remove queue\n",
+			    id, qstat.queue_packets_occupancy);
+		return -EBUSY;
+	}
+
 	// Can't delete a master aliased queue, which has active slave
 	if (node->data.queue.alias_slave_id != PP_QOS_INVALID_ID) {
 		QOS_LOG_ERR("Can't remove master aliased queue (slave is %d)\n",
