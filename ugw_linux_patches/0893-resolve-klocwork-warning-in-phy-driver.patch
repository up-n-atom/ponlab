From 49f0591509f80bfb2fa47a95500309b39085d496 Mon Sep 17 00:00:00 2001
From: Lishan Liu <lishan.liu@intel.com>
Date: Wed, 18 Dec 2019 11:32:05 +0800
Subject: [PATCH] resolve klocwork warning in phy driver

---
 drivers/phy/intel/phy-intel-combo.c | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/drivers/phy/intel/phy-intel-combo.c b/drivers/phy/intel/phy-intel-combo.c
index 240cf2c269d6..d48206ade51b 100644
--- a/drivers/phy/intel/phy-intel-combo.c
+++ b/drivers/phy/intel/phy-intel-combo.c
@@ -1040,9 +1040,9 @@ static int intel_combo_phy_create(struct intel_combo_phy *priv)
 					COMBO_PHY_ID(iphy), PHY_ID(iphy),
 					iphy->phy_clk_rate[iphy->phy_mode]);
 			} else {
-				dev_err(iphy->dev, "PHY(%u:%u) clock frequency set to %lu Success!\n",
-					COMBO_PHY_ID(iphy), PHY_ID(iphy),
-					iphy->phy_clk_rate[iphy->phy_mode]);
+				dev_info(iphy->dev, "PHY(%u:%u) clock frequency set to %lu Success!\n",
+					 COMBO_PHY_ID(iphy), PHY_ID(iphy),
+					 iphy->phy_clk_rate[iphy->phy_mode]);
 			}
 		}
 	}
