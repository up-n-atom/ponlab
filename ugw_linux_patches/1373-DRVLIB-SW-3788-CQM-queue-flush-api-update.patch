From db4f85f7fe9bba49b07dedaf0ae9777abf7790cd Mon Sep 17 00:00:00 2001
From: Lishan Liu <lishan.liu@intel.com>
Date: Mon, 17 Aug 2020 20:02:46 +0800
Subject: [PATCH] DRVLIB_SW-3788: CQM queue flush api update

---
 drivers/net/ethernet/lantiq/cqm/prx300/cqm.c | 39 ++++++++++++++--------------
 drivers/net/ethernet/lantiq/cqm/prx300/cqm.h |  1 +
 2 files changed, 20 insertions(+), 20 deletions(-)

diff --git a/drivers/net/ethernet/lantiq/cqm/prx300/cqm.c b/drivers/net/ethernet/lantiq/cqm/prx300/cqm.c
index 76b297bfeb15..5126ceae012a 100644
--- a/drivers/net/ethernet/lantiq/cqm/prx300/cqm.c
+++ b/drivers/net/ethernet/lantiq/cqm/prx300/cqm.c
@@ -64,6 +64,7 @@ static struct tasklet_struct cbm_debug_tasklet;
 #define FLAG_ACA (DP_F_FAST_WLAN | DP_F_FAST_DSL)
 #define FLAG_LSB_DONT_CARE 0x80000000
 #define FLAG_VUNI (DP_F_VUNI)
+#define Q_FLUSH_NO_PACKET_CNT 5
 
 struct cqm_egp_map epg_lookup_table[] = {
 	{0,	0,			0},
@@ -1916,6 +1917,11 @@ s32 cqm_cpu_port_get(struct cbm_cpu_port_data *data, u32 flags)
 	data->dq_tx_flush_info.tx_ring_offset = TXPUSH_CMD_RX_EGP_1;
 	data->dq_tx_flush_info.tx_pkt_credit =
 				dqm_port_info[DMA_PORT_FOR_FLUSH].dq_txpush_num;
+	if (!(dqm_port_info[DMA_PORT_FOR_FLUSH].ref_cnt)) {
+		cqm_dma_port_enable(DMA_PORT_FOR_FLUSH,
+				    CBM_PORT_F_DEQUEUE_PORT, 0);
+		dqm_port_info[DMA_PORT_FOR_FLUSH].ref_cnt = 1;
+	}
 
 	dev_dbg(cqm_ctrl->dev,
 		"%d %d %d 0x%x 0x%x %d\n",
@@ -2905,38 +2911,31 @@ s32 qos_q_flush(s32 cqm_inst, s32 cqm_drop_port, s32 qid)
 	void *dma_desc = cqm_ctrl->dmadesc;
 	int no_packet = 0;
 	u32 port = DMA_PORT_FOR_FLUSH;
-	u32 reg;
-	int i = 0;
-	u32 desc_num = dqm_port_info[DMA_PORT_FOR_FLUSH].deq_info.num_desc;
+	u32 reg, dqpc_reg;
+	u32 i = dqm_port_info[port].flush_index;
+	u32 desc_num = dqm_port_info[port].deq_info.num_desc;
 
-	/*Port Enable*/
-	cqm_dma_port_enable(port, CBM_PORT_F_DEQUEUE_PORT, 0);
-
-	while (no_packet < (3 * desc_num)) {
+	while (no_packet < Q_FLUSH_NO_PACKET_CNT) {
 		reg = cbm_r32(dma_desc +
-				CQM_DEQ_DMA_DESC(DMA_PORT_FOR_FLUSH, i) + 0xc);
-		/*read before write*/
-		rmb();
+				CQM_DEQ_DMA_DESC(port, i) + 0xc);
 		if (reg & OWN_BIT) {
 			cbm_w32(dma_desc +
-				CQM_DEQ_DMA_DESC(DMA_PORT_FOR_FLUSH, i) + 0xc,
+				CQM_DEQ_DMA_DESC(port, i) + 0xc,
 				(reg & ~OWN_BIT) | COMPLETE_BIT);
-			/*write before read*/
-			wmb();
+
+			i = (i + 1) % desc_num;
 			no_packet = 0;
 		} else {
 			no_packet++;
 			dev_dbg(cqm_ctrl->dev, "no_packet %d\n", no_packet);
 		}
-		i = (i + 1) % desc_num;
 	}
+	dqm_port_info[port].flush_index = i;
+
+	dqpc_reg = cbm_r32(cqm_ctrl->deq + DQ_DMA_PORT(port, dqpc));
+	dev_dbg(cqm_ctrl->dev, "%s: DQPC_EGP_%d =  %d\n",
+		__func__, port, dqpc_reg);
 
-	/*Reset*/
-	cqm_dma_port_enable(port, CBM_PORT_F_DEQUEUE_PORT |
-					    CBM_PORT_F_DISABLE, 0);
-	cbm_w32((cqm_ctrl->deq + DQ_DMA_PORT(DMA_PORT_FOR_FLUSH, dqpc)), 0);
-	set_val((cqm_ctrl->deq + DQ_DMA_PORT(DMA_PORT_FOR_FLUSH, dptr)), 0,
-		DPTR_DMA_EGP_25_DPTR_MASK, DPTR_DMA_EGP_25_DPTR_POS);
 	return CBM_SUCCESS;
 }
 
diff --git a/drivers/net/ethernet/lantiq/cqm/prx300/cqm.h b/drivers/net/ethernet/lantiq/cqm/prx300/cqm.h
index 66de2718a66a..05115e81d0bb 100644
--- a/drivers/net/ethernet/lantiq/cqm/prx300/cqm.h
+++ b/drivers/net/ethernet/lantiq/cqm/prx300/cqm.h
@@ -522,6 +522,7 @@ struct cqm_dqm_port_info {
 	u32 cpu_port_type;
 	u32 valid;
 	s32 ref_cnt;
+	u32 flush_index;
 };
 
 struct cqm_eqm_port_info {
