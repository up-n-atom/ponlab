+#define EGFLAG_BIT  12 /* egflag bit */
+
+int dp_get_lookup_qid_via_index(struct cbm_lookup *info)
+{
+	int qid;
+
+	if (!info)
+		return 0;
+	if (info->index & BIT(EGFLAG_BIT))
+		info->egflag = 1;
+	else
+		info->egflag = 0;
+	info->index &= BIT(EGFLAG_BIT) - 1;
+#if IS_ENABLED(CONFIG_INTEL_DATAPATH_HAL_GSWIP31)
+	qid = get_lookup_qid_via_index(info->index);
+#elif IS_ENABLED(CONFIG_INTEL_DATAPATH_HAL_GSWIP32)
+	qid = get_lookup_qid_via_index(info);
+#endif
+	DP_DEBUG(DP_DBG_FLAG_LOOKUP, "get egflag=%d index=0x%x qid=%d\n",
+		 info->egflag, info->index, qid);
+	return qid;
+}
+
+void dp_set_lookup_qid_via_index(struct cbm_lookup *info)
+{
+	if (!info)
+		return;
+	if (info->index & BIT(EGFLAG_BIT))
+		info->egflag = 1;
+	else
+		info->egflag = 0;
+	info->index &= BIT(EGFLAG_BIT) - 1;
+#if IS_ENABLED(CONFIG_INTEL_DATAPATH_HAL_GSWIP31)
+	set_lookup_qid_via_index(info->index, info->qid);
+#elif IS_ENABLED(CONFIG_INTEL_DATAPATH_HAL_GSWIP32)
+	set_lookup_qid_via_index(info);
+#endif
+	DP_DEBUG(DP_DBG_FLAG_LOOKUP, "set egflag=%d index=0x%x qid=%d\n",
+		 info->egflag, info->index, info->qid);
+}
+
+/** @brief map traffic from one specific subif to 1st cpu queue via egflag 0,
+ *         currently used for DOCSIS, MMM, and MPEG.
+ *         it maps to drop queue on deregistration.
+ *  @param inst   dp instance index
+ *  @param portid dp port id
+ *  @param subif  dp subif id
+ *  @param flags  dp flags from enum DP_F_FLAG
+ */
+static void queue_map_set_cpu(int inst, int portid, int subif, u32 flags)
+{
+	int cbm_inst = dp_port_prop[inst].cbm_inst;
+	cbm_queue_map_entry_t lookup = {0};
+	struct dp_subif_info *sif = get_dp_port_info(inst, 0)->subif_info;
+	s32 q_map_flags = CBM_QUEUE_MAP_F_TC_DONTCARE |
+			  CBM_QUEUE_MAP_F_COLOR_DONTCARE;
+	int qid = (flags & DP_F_DEREGISTER) ? HAL(inst)->ppv4_drop_q : sif->qid;
+
+	lookup.ep = portid;
+	lookup.egflag = 0;
+	lookup.sub_if_id = subif;
+	cbm_queue_map_set(cbm_inst, qid, &lookup, q_map_flags);
+}
+
+static enum pp_min_tx_pkt_len get_min_pkt_len_cfg(u32 len)
+{
+	static u32 min_pkt_len[PP_NUM_TX_MIN_PKT_LENS] = {
+		PP_MIN_TX_PKT_LEN_VAL_NONE,
+		PP_MIN_TX_PKT_LEN_VAL_60B,
+		PP_MIN_TX_PKT_LEN_VAL_64B,
+		PP_MIN_TX_PKT_LEN_VAL_128B,
+	};
+	int i;
+
+	for (i = 0; i < PP_NUM_TX_MIN_PKT_LENS; i++) {
+		if (len <= min_pkt_len[i])
+			break;
+	}
+	return i;
+}
