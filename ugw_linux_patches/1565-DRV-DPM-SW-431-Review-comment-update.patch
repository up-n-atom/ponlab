-/** @brief map traffic from one specific subif to 1st cpu queue via egflag 0,
- *         currently used for DOCSIS, MMM, and MPEG.
- *         it maps to drop queue on deregistration.
- *  @param inst   dp instance index
- *  @param portid dp port id
- *  @param subif  dp subif id
- *  @param flags  dp flags from enum DP_F_FLAG
- */
-static void queue_map_set_cpu(int inst, int portid, int subif, u32 flags)
-{
-	int cbm_inst = dp_port_prop[inst].cbm_inst;
-	cbm_queue_map_entry_t lookup = {0};
-	struct dp_subif_info *sif = get_dp_port_info(inst, 0)->subif_info;
-	s32 q_map_flags = CBM_QUEUE_MAP_F_TC_DONTCARE |
-			  CBM_QUEUE_MAP_F_COLOR_DONTCARE;
-	int qid = (flags & DP_F_DEREGISTER) ? HAL(inst)->ppv4_drop_q : sif->qid;
-
-	lookup.ep = portid;
-	lookup.egflag = 0;
-	lookup.sub_if_id = subif;
-	cbm_queue_map_set(cbm_inst, qid, &lookup, q_map_flags);
-}
