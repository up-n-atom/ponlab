diff --git a/net/bridge/Kconfig b/net/bridge/Kconfig
index aa0d3b2f1bb7..c2417cf267e9 100644
--- a/net/bridge/Kconfig
+++ b/net/bridge/Kconfig
@@ -60,3 +60,16 @@ config BRIDGE_VLAN_FILTERING
 	  Say N to exclude this support and reduce the binary size.
 
 	  If unsure, say Y.
+
+config MCAST_PROXY
+	tristate "MCAST Proxy support"
+	depends on m
+	default n
+	help
+	  Lantiq Multicast Proxy support
+
+config MCAST_SNOOPING
+	bool "MCAST Snooping support"
+	default n
+	help
+	  Lantiq Multicast Snooping support
