From: kavitha3 <k.subramanian@intel.com>
Date: Wed, 21 Jul 2021 17:25:23 +0800
Subject: [PATCH] PONRTSYS-9256: override incorrect DMA Ready hw reset value

---
 drivers/net/ethernet/lantiq/cqm/prx300/cqm.c | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/drivers/net/ethernet/lantiq/cqm/prx300/cqm.c b/drivers/net/ethernet/lantiq/cqm/prx300/cqm.c
index 67b76a90057b..df0b35b0490c 100644
--- a/drivers/net/ethernet/lantiq/cqm/prx300/cqm.c
+++ b/drivers/net/ethernet/lantiq/cqm/prx300/cqm.c
@@ -5091,6 +5091,9 @@ static int cqm_prx300_probe(struct platform_device *pdev)
 	/* Enable all the LS interrupts */
 	ls_intr_ctrl(0xFF0000, cqm_ctrl->ls);
 
+	/*Override the HW reset values*/
+	cbm_w32(cqm_ctrl->enq + DMA_RDY_EN, 0xfff);
+
 	/*setup the DMA channels*/
 	for (i = 0; i < CQM_ENQ_PORT_MAX; i++) {
 		if (!eqm_port_info[i].valid)
