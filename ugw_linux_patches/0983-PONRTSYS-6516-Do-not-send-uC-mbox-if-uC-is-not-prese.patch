From 0c04ca1459324e8abb1045bb8dd96e41365d66be Mon Sep 17 00:00:00 2001
From: ofirbitt <ofir1.bitton@intel.com>
Date: Tue, 7 Jan 2020 10:43:27 +0200
Subject: [PATCH] PONRTSYS-6516: Do not send uC mbox if uC is not present

---
 drivers/net/ppv4/pp-hal/micro-controller/uc_egr_mbox.c | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/drivers/net/ppv4/pp-hal/micro-controller/uc_egr_mbox.c b/drivers/net/ppv4/pp-hal/micro-controller/uc_egr_mbox.c
index b3796266a5c1..1ecc33e37c0e 100644
--- a/drivers/net/ppv4/pp-hal/micro-controller/uc_egr_mbox.c
+++ b/drivers/net/ppv4/pp-hal/micro-controller/uc_egr_mbox.c
@@ -198,6 +198,9 @@ s32 uc_egr_mbox_cmd_send_buff(enum uc_mbox_cmd_type type, const u32 *buff,
 
 	pr_debug("uc mbox cmd %u, buff %ps, len %hu\n", (u32)type, buff, len);
 
+	if (unlikely(!uc_is_cluster_valid(UC_IS_EGR)))
+		return -EPERM;
+
 	if (unlikely(!__cmd_is_valid(type)))
 		return -EINVAL;
 
@@ -227,6 +230,9 @@ s32 uc_egr_mbox_cmd_send(enum uc_mbox_cmd_type type, u32 param, void *response,
 	pr_debug("uc mbox cmd %u, param %u, response buff len %hu\n",
 		 (u32)type, param, response_len);
 
+	if (unlikely(!uc_is_cluster_valid(UC_IS_EGR)))
+		return -EPERM;
+
 	if (unlikely(!__cmd_is_valid(type)))
 		return -EINVAL;
 
