From 2e5a768f0cdb50fb5dc807555f17108d4e752bd6 Mon Sep 17 00:00:00 2001
From: "Roy, UjjaL" <uroy@maxlinear.com>
Date: Fri, 29 Jan 2021 11:49:41 +0530
Subject: [PATCH] UGW_SW-57154: Mcast helper BUG on sleeping function called
 from invalid context

Signed-off-by: Roy, UjjaL <uroy@maxlinear.com>
---
 net/mcast_helper/mcast_helper.c     | 6 +++---
 net/mcast_helper/mcast_helper_reg.c | 9 +++++----
 2 files changed, 8 insertions(+), 7 deletions(-)

diff --git a/net/mcast_helper/mcast_helper.c b/net/mcast_helper/mcast_helper.c
index bf68d14c22c4..c940d3f0668d 100644
--- a/net/mcast_helper/mcast_helper.c
+++ b/net/mcast_helper/mcast_helper.c
@@ -837,7 +837,7 @@ static MCAST_GIMC_t *mcast_helper_add_gimc_record(struct net_device *netdev,
 	if (grpidx == -1)
 		return NULL;
 
-	gimc_rec = kmalloc(sizeof(MCAST_GIMC_t), GFP_KERNEL);
+	gimc_rec = kmalloc(sizeof(MCAST_GIMC_t), GFP_ATOMIC);
 	if (gimc_rec == NULL)
 		return NULL;
 
@@ -927,7 +927,7 @@ static MCAST_MAC_t *mcast_helper_update_macaddr_record(MCAST_MEMBER_t *gitxmc_re
 	if (gitxmc_rec == NULL || macaddr == NULL)
 		return NULL;
 
-	mac = kmalloc(sizeof(MCAST_MAC_t), GFP_KERNEL);
+	mac = kmalloc(sizeof(MCAST_MAC_t), GFP_ATOMIC);
 	if (mac == NULL)
 		return NULL;
 
@@ -959,7 +959,7 @@ static MCAST_MEMBER_t *mcast_helper_add_gitxmc_record(unsigned int grpidx,
 		gimc_rec = list_entry(liter, MCAST_GIMC_t, list);
 		if (gimc_rec != NULL || liter != NULL) {
 			if (gimc_rec->grpIdx == grpidx) {
-				gitxmc_rec = kmalloc(sizeof(MCAST_MEMBER_t), GFP_KERNEL);
+				gitxmc_rec = kmalloc(sizeof(MCAST_MEMBER_t), GFP_ATOMIC);
 				if (gitxmc_rec == NULL)
 					return NULL;
 				gitxmc_rec->memDev = netdev;
diff --git a/net/mcast_helper/mcast_helper_reg.c b/net/mcast_helper/mcast_helper_reg.c
index 81fcbdd04c0a..c33114f87502 100644
--- a/net/mcast_helper/mcast_helper_reg.c
+++ b/net/mcast_helper/mcast_helper_reg.c
@@ -85,7 +85,7 @@ static int  mcast_helper_send_netlink_msg_user(struct net_device *netdev ,int ty
 		/* compare the  process name with each of the task struct process name*/
 		if (strstr(task->comm,MCAST_PROCESS_NAME) != NULL) {
 			pid = task->pid;
-			skb = nlmsg_new(TOTAL_SIZE, GFP_KERNEL);
+			skb = nlmsg_new(TOTAL_SIZE, GFP_ATOMIC);
 			if (!skb) {
 				//printk(KERN_INFO "Allocation failure.\n");
 				return FAILURE;
@@ -112,10 +112,11 @@ static int  mcast_helper_send_netlink_msg_user(struct net_device *netdev ,int ty
 				skb_v6 = skb_clone(skb, GFP_ATOMIC);
 				if (!skb_v6) {
 					pr_info("Allocation failure.\n");
+					kfree_skb(skb);
 					return FAILURE;
 				}
-				res = nlmsg_multicast(net->rtnl, skb, 0, RTNLGRP_LINK | RTNLGRP_IPV4_IFADDR, GFP_KERNEL);
-				res_v6 = nlmsg_multicast(net->rtnl, skb_v6, 0, RTNLGRP_LINK | RTNLGRP_IPV6_IFADDR, GFP_KERNEL);
+				res = nlmsg_multicast(net->rtnl, skb, 0, RTNLGRP_LINK | RTNLGRP_IPV4_IFADDR, GFP_ATOMIC);
+				res_v6 = nlmsg_multicast(net->rtnl, skb_v6, 0, RTNLGRP_LINK | RTNLGRP_IPV6_IFADDR, GFP_ATOMIC);
 				if (res < 0 || res_v6 < 0)
 					return FAILURE;
 				else
@@ -138,7 +139,7 @@ static int mcast_helper_reg_callback(struct net_device *netdev,
 	if (netdev == NULL)
 		return FAILURE;
 
-	mc_callback_rec = kmalloc(sizeof(MCAST_CALLBACK_t), GFP_KERNEL);
+	mc_callback_rec = kmalloc(sizeof(MCAST_CALLBACK_t), GFP_ATOMIC);
 	if (mc_callback_rec == NULL)
 		return FAILURE;
 
