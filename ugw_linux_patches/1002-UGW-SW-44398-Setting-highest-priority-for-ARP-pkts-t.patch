From c307ba5d82047c6a4e7bd8ec937deeb776459310 Mon Sep 17 00:00:00 2001
From: Deepansh Rastogi <deepansh.rastogi@intel.com>
Date: Fri, 7 Feb 2020 16:20:17 +0530
Subject: [PATCH] UGW_SW-44398: Setting highest priority for ARP pkts to
 prioritize ARP during congestion on egress interface

---
 net/ipv4/arp.c | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/net/ipv4/arp.c b/net/ipv4/arp.c
index 8cae791a7ace..282f3f412770 100644
--- a/net/ipv4/arp.c
+++ b/net/ipv4/arp.c
@@ -317,6 +317,11 @@ static void arp_send_dst(int type, int ptype, __be32 dest_ip,
 	if (!skb)
 		return;
 
+#ifdef CONFIG_INTEL_IPQOS
+	/* For ARP Prioritization */
+	skb->priority = 7;
+#endif /* CONFIG_INTEL_IPQOS */
+
 	skb_dst_set(skb, dst_clone(dst));
 	arp_xmit(skb);
 }
