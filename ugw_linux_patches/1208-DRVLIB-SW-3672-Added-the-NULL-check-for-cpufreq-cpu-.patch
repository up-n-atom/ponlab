From b022cd83c9bc29af08173fcd0a3e79e988af134c Mon Sep 17 00:00:00 2001
From: arathinx <ayyappanx.rathinam@intel.com>
Date: Sat, 6 Jun 2020 17:27:10 +0800
Subject: [PATCH] DRVLIB_SW-3672: Added the NULL check for cpufreq_cpu_get()
 API and the cpu decrement count cpufreq_cpu_put()

---
 drivers/cpufreq/xrx500-cpufreq.c | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/drivers/cpufreq/xrx500-cpufreq.c b/drivers/cpufreq/xrx500-cpufreq.c
index 127f9f4e4dd7..8e4f94faddb6 100644
--- a/drivers/cpufreq/xrx500-cpufreq.c
+++ b/drivers/cpufreq/xrx500-cpufreq.c
@@ -246,10 +246,17 @@ static int xrx500_cpufreq_driver_init(void)
 		 * write.param: bit(31:28) -> freq8
 		 */
 		policy = cpufreq_cpu_get(0);
+		if (!policy) {
+			pr_err("failed to get policy\n");
+			return -ENOMEM;
+		}
+
 		pos = policy->freq_table;
 		table = policy->freq_table;
-		if (!table)
+		if (!table) {
+			cpufreq_cpu_put(policy);
 			return -ENODEV;
+		}
 		i = 0;
 		memset(&w, 0, sizeof(icc_msg_t));
 		cpufreq_for_each_valid_entry(pos, table) {
@@ -312,6 +319,8 @@ static int xrx500_cpufreq_driver_init(void)
 		w.dst_client_id = REGMAP_CGU;
 		w.msg_id = REGMAP_CF_MSGID;
 		ret = icc_write(REGMAP_CGU, &w);
+
+		cpufreq_cpu_put(policy);
 	}
 	return ret;
 }
