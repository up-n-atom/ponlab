+			       node_id, priv->qos_sch_stat[node_id].p_flag);
+			return DP_FAILURE;
+		}
 		pid = get_parent_node(inst, node_id, flag);
 		if (pid == DP_FAILURE) {
 			pr_err("get_parent_node failed for sched:%d\n",
@@ -727,11 +753,6 @@ static int node_sched_dec(int inst, int node_id, int flag)
 			 "%s: parent:%d of SCH:[%d] child idx:%d\n",
 			 __func__, pid, node_id, idx);
 
