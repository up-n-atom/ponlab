-			pr_err("Wrong Sch[%d] Stat(%d):Expect ACTIVE\n",
-			       node_id, priv->qos_sch_stat[node_id].p_flag);
-			return DP_FAILURE;
-		}
 		if (!priv->qos_sch_stat[node_id].parent.flag) {
 			pr_err("Wrong SCH[%d] Parent Stat(%d):Expect ACTIV\n",
