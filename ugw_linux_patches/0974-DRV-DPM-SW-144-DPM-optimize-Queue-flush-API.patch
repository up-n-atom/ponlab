From b0c9776230c0f9e4ee53aa5ac81b4f145fbbcfd0 Mon Sep 17 00:00:00 2001
From: thampan <joby.thampan@intel.com>
Date: Fri, 31 Jan 2020 11:54:34 +0800
Subject: [PATCH] DRV_DPM_SW-144: DPM optimize Queue flush API

    - QoS Queue Movement based on DPM_FLUSH_RESTORE_QOS Bit
    - Removing some PPv4 HW get calls to optimize performance
---
 drivers/net/datapath/dpm/gswip31/datapath_ppv4.h   |   3 +
 .../net/datapath/dpm/gswip31/datapath_ppv4_api.c   | 507 +++++++--------------
 2 files changed, 176 insertions(+), 334 deletions(-)

diff --git a/drivers/net/datapath/dpm/gswip31/datapath_ppv4.h b/drivers/net/datapath/dpm/gswip31/datapath_ppv4.h
index 64587f6d526d..42aaec4e8d2a 100644
--- a/drivers/net/datapath/dpm/gswip31/datapath_ppv4.h
+++ b/drivers/net/datapath/dpm/gswip31/datapath_ppv4.h
@@ -109,6 +109,7 @@ struct pp_queue_stat {
 	u16 node_id;  /* queue node id */
 	u16 resv_idx; /* index of reserve table */
 	u16 dp_port; /* datapath port id */
+	u32 blocked; /* Q blocked state */
 };
 
 struct pp_sch_stat {
@@ -124,6 +125,7 @@ struct pp_sch_stat {
 		   */
 	struct pp_node parent; /* valid for node type queue/sch */
 	u16 dp_port; /* datapath port id */
+	int prio_wfq; /* Q priority */
 };
 
 struct cqm_deq_stat {
@@ -131,6 +133,7 @@ struct cqm_deq_stat {
 	u16 deq_id; /* qos dequeue port physical id. Maybe no need */
 	u16 node_id; /* qos dequeue port's node id */
 	u16 child_num; /* Number of child */
+	u32 disabled; /* Port disabled state */
 };
 
 struct limit_map {
diff --git a/drivers/net/datapath/dpm/gswip31/datapath_ppv4_api.c b/drivers/net/datapath/dpm/gswip31/datapath_ppv4_api.c
