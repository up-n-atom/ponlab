 			 qid, priv->ppv4_drop_p);
 
-		cqm_queue_flush_31(dp_port_prop[inst].cbm_inst,
-				   priv->cqm_drop_p, qid);
+		cqm_queue_flush_31(cbm_inst, priv->cqm_drop_p, qid);
 	} else {
 		DP_DEBUG(DP_DBG_FLAG_QOS,
 			 "Queue movement before flush");
