 		pr_err("get_parent_node failed for Q:%d\n", phy_id);
@@ -541,16 +572,6 @@ static int node_queue_dec(int inst, int node_id, int flag)
 		 "%s: parent:%d of Q:[%d/%d] child idx:%d\n",
