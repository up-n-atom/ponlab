-		/* move back the queue to original parent
-		 * with orignal variable queue_cfg
-		 */
-		if (dp_qos_queue_set_spl_31(priv->qdev, node_id, qid,
-					    &queue_cfg)) {
-			pr_err("qos_queue_conf_get fail: q[%d/%d]\n",
-			       qid, node_id);
-			res = DP_FAILURE;
-			goto EXIT;
+		if (flag & FLUSH_RESTORE_QOS_PORT) {
+			/* move back the queue to original parent
+			 * with orignal variable queue_cfg
+			 */
+			if (dp_qos_queue_set_spl_31(inst, priv->qdev, node_id,
+						    qid, &queue_cfg)) {
+				pr_err("qos_queue_conf_get fail: q[%d/%d]\n",
+				       qid, node_id);
+				res = DP_FAILURE;
+				goto EXIT;
+			}
+			DP_DEBUG(DP_DBG_FLAG_QOS,
+				 "Flush:Move Q[%d] back to port[/%d]\n",
+				 qid, queue_cfg.queue_child_prop.parent);
 		}
-		DP_DEBUG(DP_DBG_FLAG_QOS,
-			 "Flush:Move Q[%d] back to port[/%d]\n",
-			 qid, queue_cfg.queue_child_prop.parent);
 	}
 #endif /* end of DP_FLUSH_VIA_AUTO */
 
@@ -525,6 +545,17 @@ static int node_queue_dec(int inst, int node_id, int flag)
 		return DP_FAILURE;
 	}
 
+	if (!(priv->qos_queue_stat[phy_id].flag & PP_NODE_ACTIVE)) {
+		pr_err("Wrong Q[%d] Stat(%d):Expect ACTIVE\n", phy_id,
