From 6f70cfdce2be216278d44e7aa53de0bea5eac12a Mon Sep 17 00:00:00 2001
From: "Vishnu Swaroop Kumar Sarma, Duddu" <duddu.swaroop@intel.com>
Date: Thu, 9 Apr 2020 00:32:46 +0530
Subject: [PATCH] UGW_SW-49162 fix f24s write and add gphy reset call back

---
 .../net/ethernet/lantiq/switch-api/gsw_flow_core.c | 32 ++++++++++++++++++----
 drivers/net/ethernet/lantiq/switch-api/gsw_init.c  | 17 ++++++++----
 drivers/net/ethernet/lantiq/xrx500_phy_fw.c        | 19 +++++++++++++
 drivers/net/ethernet/lantiq/xrx500_phy_fw.h        |  1 +
 4 files changed, 59 insertions(+), 10 deletions(-)

diff --git a/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c b/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c
index 364d0455b175..0084f097a39d 100644
--- a/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c
+++ b/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c
@@ -39,6 +39,8 @@ u8 MICRO_CODE_VERSION_NUMBER[] = "0x"MICRO_CODE_VERSION;
 static u8 prdflag;
 static void get_gsw_hw_cap(void *cdev);
 static GSW_return_t gsw_init_fn_ptrs(struct core_ops *ops);
+void (*xrx500_gphy_reset_cb)(u32 phy_id);
+EXPORT_SYMBOL(xrx500_gphy_reset_cb);
 
 static const u32 gsw_pce_tbl_reg_key[] = {
 	PCE_TBL_KEY_0_KEY0_OFFSET, PCE_TBL_KEY_1_KEY1_OFFSET,
@@ -12283,6 +12285,7 @@ GSW_return_t GSW_CfgSet(void *cdev, GSW_cfg_t *parm)
 #define IFMUX_CFG	0x120
 #define P6_SEL		BIT(20)
 #define PORT_NUM	6
+#define PHY_ID		4
 
 static inline void grx550_misc_config(ethsw_api_dev_t *gswdev) {
 	u32 val = 0;
@@ -12294,9 +12297,19 @@ static inline void grx550_misc_config(ethsw_api_dev_t *gswdev) {
 	regmap_write(gswdev->chiptop_base, IFMUX_CFG, val);
 
 	ops = gsw_get_swcore_ops(LTQ_FLOW_DEV_INT_R);
-	/* assign port 1 address in gswip-r as port 6 */
+	/* assign port 1 address in gswip-r as port 6  and rest as auto */
 	gsw_w32(ops, (GSWT_PHY_ADDR_1_ADDR_OFFSET + GSW30_TOP_OFFSET),
 		GSWT_PHY_ADDR_1_ADDR_SHIFT,GSWT_PHY_ADDR_1_ADDR_SIZE, PORT_NUM);
+	gsw_w32(ops, (GSWT_PHY_ADDR_1_FCONRX_OFFSET + GSW30_TOP_OFFSET),
+		GSWT_PHY_ADDR_1_FCONRX_SHIFT,GSWT_PHY_ADDR_1_FCONRX_SIZE, 0);
+	gsw_w32(ops, (GSWT_PHY_ADDR_1_FCONTX_OFFSET + GSW30_TOP_OFFSET),
+		GSWT_PHY_ADDR_1_FCONTX_SHIFT,GSWT_PHY_ADDR_1_FCONTX_SIZE, 0);
+	gsw_w32(ops, (GSWT_PHY_ADDR_1_FDUP_OFFSET + GSW30_TOP_OFFSET),
+		GSWT_PHY_ADDR_1_FDUP_SHIFT,GSWT_PHY_ADDR_1_FDUP_SIZE, 0);
+	gsw_w32(ops, (GSWT_PHY_ADDR_1_SPEED_OFFSET + GSW30_TOP_OFFSET),
+		GSWT_PHY_ADDR_1_SPEED_SHIFT,GSWT_PHY_ADDR_1_SPEED_SIZE, 0x3);
+	gsw_w32(ops, (GSWT_PHY_ADDR_1_LNKST_OFFSET + GSW30_TOP_OFFSET),
+		GSWT_PHY_ADDR_1_LNKST_SHIFT,GSWT_PHY_ADDR_1_LNKST_SIZE, 0);
 
 	ops = gsw_get_swcore_ops(LTQ_FLOW_DEV_INT);
 	/* enable port 6 MDC GSWIP-L */
@@ -12310,6 +12323,12 @@ static inline void grx550_misc_config(ethsw_api_dev_t *gswdev) {
 	regmap_read(gswdev->chiptop_base, IFMUX_CFG, &val);
 	val |= P6_SEL;
 	regmap_write(gswdev->chiptop_base, IFMUX_CFG, val);
+
+	/* reset phy in GSWIP required to negotiate again
+	 * else the link will not be up
+	 */
+	if(xrx500_gphy_reset_cb != NULL)
+		xrx500_gphy_reset_cb(PHY_ID);
 }
 
 GSW_return_t GSW_HW_Init(void *cdev, GSW_HW_Init_t *parm)
@@ -12323,15 +12342,18 @@ GSW_return_t GSW_HW_Init(void *cdev, GSW_HW_Init_t *parm)
 		return GSW_statusErr;
 	}
 
-#ifdef __KERNEL__
-	spin_lock_bh(&gswdev->lock_pce);
-#endif
-
+	/* out of spinlock as reset control in misc config can sleep */
 	if (gswdev->gsw_dev == LTQ_FLOW_DEV_EXT_AX3000_F24S) {
 		/* if chiptop present, do some special config */
 		if (!IS_ERR_OR_NULL(gswdev->chiptop_base))
 			grx550_misc_config(gswdev);
+	}
+
+#ifdef __KERNEL__
+	spin_lock_bh(&gswdev->lock_pce);
+#endif
 
+	if (gswdev->gsw_dev == LTQ_FLOW_DEV_EXT_AX3000_F24S) {
 		get_gsw_hw_cap(cdev);
 		/* Software Table Init */
 		ltq_ethsw_port_cfg_init(cdev);
diff --git a/drivers/net/ethernet/lantiq/switch-api/gsw_init.c b/drivers/net/ethernet/lantiq/switch-api/gsw_init.c
index a20af36cdc50..ff43a32916cc 100644
--- a/drivers/net/ethernet/lantiq/switch-api/gsw_init.c
+++ b/drivers/net/ethernet/lantiq/switch-api/gsw_init.c
@@ -501,7 +501,7 @@ int GSW_SMDIO_DataWrite(void *cdev, GSW_MDIO_data_t *pPar)
 /** read the External gswitch register */
 void gsw_ext_r32(void *cdev, short offset, short shift, short size, u32 *value)
 {
-	u32 rvalue, mask, reg = 0x00;
+	u32 rvalue, mask;
 	u16 addr;
 	ethsw_api_dev_t *pethdev = GSW_PDATA_GET(cdev);
 
@@ -519,7 +519,7 @@ void gsw_ext_r32(void *cdev, short offset, short shift, short size, u32 *value)
 	pethdev->master_mii_bus->write(pethdev->master_mii_bus,
 				       pethdev->ext_phyid, pethdev->ext_phyid, addr);
 	rvalue = pethdev->master_mii_bus->read(pethdev->master_mii_bus,
-					       pethdev->ext_phyid, reg);
+					       pethdev->ext_phyid, 0);
 
 	mask = (1 << size) - 1;
 	rvalue = (rvalue >> shift);
@@ -530,7 +530,8 @@ void gsw_ext_r32(void *cdev, short offset, short shift, short size, u32 *value)
 /** read and update the External GSWIP register */
 void gsw_ext_w32(void *cdev, short offset, short shift, short size, u32 value)
 {
-	u32 data, reg = 0x0;
+	u16 data;
+	u32 rvalue, mask;
 	ethsw_api_dev_t *pethdev = GSW_PDATA_GET(cdev);
 
 	if (pethdev == NULL) {
@@ -538,6 +539,13 @@ void gsw_ext_w32(void *cdev, short offset, short shift, short size, u32 value)
 		return;
 	}
 
+	gsw_ext_r32(cdev, offset, 0, 16, &rvalue);
+
+	mask = (1 << size) - 1;
+	mask = (mask << shift);
+	value = ((value << shift) & mask);
+	value = ((rvalue & ~mask) | value);
+
 	if ((offset & pethdev->gswex_sgmiibase) == 0xD000)
 		data = (offset);
 	else
@@ -547,7 +555,7 @@ void gsw_ext_w32(void *cdev, short offset, short shift, short size, u32 value)
 	pethdev->master_mii_bus->write(pethdev->master_mii_bus,
 				       pethdev->ext_phyid, pethdev->ext_phyid, data);
 	pethdev->master_mii_bus->write(pethdev->master_mii_bus,
-				       pethdev->ext_phyid, reg, value);
+				       pethdev->ext_phyid, 0, value);
 }
 
 #endif
@@ -1068,7 +1076,6 @@ int ltq_gsw_api_register(struct platform_device *pdev)
 	    && pEDevExt)
 		ioctl_wrapper_dev_add(pioctlctl, &pEDevExt->ops,
 				      LTQ_FLOW_DEV_EXT_AX3000_F24S);
-
 	return 0;
 }
 #endif /* CONFIG_SOC_GRX500 */
diff --git a/drivers/net/ethernet/lantiq/xrx500_phy_fw.c b/drivers/net/ethernet/lantiq/xrx500_phy_fw.c
index 982ecf9866df..d45f6853d5a3 100644
--- a/drivers/net/ethernet/lantiq/xrx500_phy_fw.c
+++ b/drivers/net/ethernet/lantiq/xrx500_phy_fw.c
@@ -16,6 +16,7 @@
 #include <linux/regmap.h>
 #include <linux/mfd/syscon.h>
 #include <lantiq.h>
+#include "xrx500_phy_fw.h"
 
 #define FIRMWARE_P11G_XRX500 "ltq_fw_PHY11G_IP_xRx5xx_A21.bin"
 #define FIRMWARE_P31G_PRX300_A "ltq_fw_PHY31G_IP_prx3xx_A11.bin"
@@ -65,6 +66,7 @@ static struct regmap_config gphy_regmap_cfg = {
 
 /* GPHY related */
 static int g_xway_gphy_fw_loaded;
+static struct xrx500_reset_control xrx500_rst;
 
 /* xRX500 gphy (GSW-L) registers */
 #define GPHY2_LBADR_XRX500     0x0228
@@ -206,10 +208,25 @@ static int xrx500_dt_parse(struct xway_gphy_data *priv)
 	}
 
 	priv->fw_name = FIRMWARE_P11G_XRX500;
+	memcpy(&xrx500_rst, rst, sizeof(struct xrx500_reset_control));
 
 	return 0;
 }
 
+/* xrx500 gphy reset for a particular phy ID */
+static void xrx500_gphy_reset(u32 phy_id)
+{
+	struct xrx500_reset_control *rst = &xrx500_rst;
+
+	if (phy_id >= XRX500_GPHY_NUM && !rst->phy[phy_id])
+		return;
+
+	reset_control_assert(rst->phy[phy_id]);
+	udelay(1);
+	reset_control_deassert(rst->phy[phy_id]);
+	pr_info("Reset GPHY%u for GRX500\n", phy_id);
+}
+
 /* prx300 rcal/rc_count value calculation.
  * Calculation routines are very much hardware specific,
  * and derived from verification team recommendation.
@@ -583,6 +600,7 @@ static int xway_phy_fw_probe(struct platform_device *pdev)
 	int ret = 0;
 	struct xway_gphy_data *priv;
 
+	xrx500_gphy_reset_cb = NULL;
 	priv = devm_kzalloc(&pdev->dev, sizeof(*priv), GFP_KERNEL);
 	if (!priv) {
 		dev_err(&pdev->dev, "can't allocate private data\n");
@@ -611,6 +629,7 @@ static int xway_phy_fw_probe(struct platform_device *pdev)
 		msleep(100);
 
 	g_xway_gphy_fw_loaded = 1;
+	xrx500_gphy_reset_cb = xrx500_gphy_reset;
 	return ret;
 }
 
diff --git a/drivers/net/ethernet/lantiq/xrx500_phy_fw.h b/drivers/net/ethernet/lantiq/xrx500_phy_fw.h
index dcf2aaeae589..9f25151e0406 100644
--- a/drivers/net/ethernet/lantiq/xrx500_phy_fw.h
+++ b/drivers/net/ethernet/lantiq/xrx500_phy_fw.h
@@ -10,5 +10,6 @@
 #define _XRX500_PHY_FW_
 
 bool is_xway_gphy_fw_loaded(void);
+extern void (*xrx500_gphy_reset_cb)(u32 phy_id);
 
 #endif
