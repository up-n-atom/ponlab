From 0ccefa752c4cc86f1c3af2ee9b33cff1c2116787 Mon Sep 17 00:00:00 2001
From: thampan <joby.thampan@intel.com>
Date: Wed, 20 Jan 2021 17:45:46 +0800
Subject: [PATCH] DRV_DPM_SW-339 - Removing PTP Macro's from datapath_rx

---
 drivers/net/datapath/dpm/gswip31/datapath_rx.c | 14 ++++----------
 1 file changed, 4 insertions(+), 10 deletions(-)

diff --git a/drivers/net/datapath/dpm/gswip31/datapath_rx.c b/drivers/net/datapath/dpm/gswip31/datapath_rx.c
index 0fd94eb20647..a6a631c6517b 100644
--- a/drivers/net/datapath/dpm/gswip31/datapath_rx.c
+++ b/drivers/net/datapath/dpm/gswip31/datapath_rx.c
@@ -152,9 +152,7 @@ int32_t dp_rx_31(struct sk_buff *skb, u32 flags)
 	char decryp = 0;
 	u8 inst = 0;
 	struct pmac_port_info *dp_port;
-#if IS_ENABLED(CONFIG_INTEL_DATAPATH_PTP1588)
 	struct mac_ops *ops;
-#endif
 	struct dp_subif_info *sif;
 	struct dev_mib *mib;
 
@@ -216,22 +214,18 @@ int32_t dp_rx_31(struct sk_buff *skb, u32 flags)
 	dp_port = get_dp_port_info(inst, port_id);
 	sif = get_dp_port_subif(dp_port, vap);
 	mib = get_dp_port_subif_mib(sif);
-#if IS_ENABLED(CONFIG_INTEL_DATAPATH_PTP1588)
+
 	if (dp_port->f_ptp) {
 		ops = dp_port_prop[inst].mac_ops[port_id];
 		if (ops)
 			ops->do_rx_hwts(ops, skb);
 	}
-#endif
-	/*PON traffic always have timestamp attached,removing Timestamp */
+
+	/* PON traffic always have timestamp attached,removing Timestamp */
 	if (is_xpon(dp_port->alloc_flags)) {
-		/* Stripping of last 10 bytes timestamp */
-#if IS_ENABLED(CONFIG_INTEL_DATAPATH_PTP1588)
+		/* Stripping of last 10 bytes timestamp if PTP isnot enabled */
 		if (!dp_port->f_ptp)
 			__pskb_trim(skb, skb->len - DP_TS_HDRLEN);
-#else
-		__pskb_trim(skb, skb->len - DP_TS_HDRLEN);
-#endif
 	}
 
 	rx_fn = dp_port->cb.rx_fn;
