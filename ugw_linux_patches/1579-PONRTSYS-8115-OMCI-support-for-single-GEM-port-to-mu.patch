From 80102ae2de4706d997b37aea8f4b26d53a5ae286 Mon Sep 17 00:00:00 2001
From: Jan Dominiak <janx.dominiak@intel.com>
Date: Thu, 14 Jan 2021 12:39:41 +0100
Subject: [PATCH] PONRTSYS-8115: OMCI support for single GEM port to multiple
 queue selection

---
 drivers/net/datapath/pon_qos/pon_qos_tc_qmap.c | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/drivers/net/datapath/pon_qos/pon_qos_tc_qmap.c b/drivers/net/datapath/pon_qos/pon_qos_tc_qmap.c
index 6747c3ad00a8..53f675b9023b 100644
--- a/drivers/net/datapath/pon_qos/pon_qos_tc_qmap.c
+++ b/drivers/net/datapath/pon_qos/pon_qos_tc_qmap.c
@@ -18,6 +18,7 @@ struct flower_cls_map {
 	__be16 proto;
 	u32 pref;
 	u32 classid;
+	u32 tc_cookie;
 	bool ingress;
 	struct flow_dissector_key_vlan key;
 	struct flow_dissector_key_vlan mask;
@@ -158,6 +159,7 @@ int pon_qos_tc_map(struct net_device *dev, struct tc_cls_flower_offload *f)
 		goto err;
 	}
 
+	map->tc_cookie = tc_cookie;
 	ret = pon_qos_tc_flower_storage_add(dev, f->cookie,
 					    TC_TYPE_QUEUE,
 					    (void *)map, NULL);
@@ -190,6 +192,7 @@ int pon_qos_tc_unmap(struct net_device *dev, void *list_node)
 	qmap.indev = map->indev;
 	qmap.subif = map->key.vlan_priority;
 	qmap.handle = map->classid;
+	qmap.tc_cookie = map->tc_cookie;
 	ret = pon_qos_update_qmap(dev, &qmap, 0);
 	if (ret < 0) {
 		netdev_err(dev, "%s: queue unmap fail\n", __func__);
