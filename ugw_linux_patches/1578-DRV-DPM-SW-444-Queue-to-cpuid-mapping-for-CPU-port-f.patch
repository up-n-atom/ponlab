From 471251f7757046e456298b2e11624ce4ecd2d201 Mon Sep 17 00:00:00 2001
From: Rekha Eswaran <rekha.eswaran@intel.com>
Date: Fri, 15 Jan 2021 16:16:39 +0800
Subject: [PATCH] DRV_DPM_SW-444 - Queue to cpuid mapping for CPU port from
 dp_deq_port_res_get()

---
 drivers/net/datapath/dpm/gswip31/datapath_misc.c     | 10 +++++-----
 drivers/net/datapath/dpm/gswip31/datapath_ppv4_api.c |  6 ++++++
 include/net/datapath_api.h                           |  2 +-
 include/net/datapath_api_qos.h                       |  1 +
 4 files changed, 13 insertions(+), 6 deletions(-)

diff --git a/drivers/net/datapath/dpm/gswip31/datapath_misc.c b/drivers/net/datapath/dpm/gswip31/datapath_misc.c
index e077769f45c9..0fda89273823 100644
--- a/drivers/net/datapath/dpm/gswip31/datapath_misc.c
+++ b/drivers/net/datapath/dpm/gswip31/datapath_misc.c
@@ -1026,7 +1026,7 @@ int alloc_cpu_q(int inst, struct cbm_cpu_port_data *cpu_data,
 		return DP_FAILURE;
 	}
 
-	return DP_SUCCESS;;
+	return DP_SUCCESS;
 }
 
 /* Alloc and Enable of Re-Insertion Port is done in CQM by default */
@@ -1255,10 +1255,10 @@ int dp_platform_queue_set(int inst, u32 flag)
 	dp_cpu_init_ok = 1;
 	cap = &get_dp_prop_info(inst)->cap;
 
-	/* For Prx Max CPU Port 4 and max_port_per_cpu is 1
-	 * For LGM Max CPU Port 4 and max_port_per_cpu is 2
+	/* For Prx Max CPU 4 and max_port_per_cpu is 1
+	 * For LGM Max CPU 4 and max_port_per_cpu is 2
 	 */
-	for (cpu_id = 0; cpu_id < cap->max_cpu_ports; cpu_id++) {
+	for (cpu_id = 0; cpu_id < cap->max_cpu; cpu_id++) {
 		for (cpu_port_num = 0; cpu_port_num < cap->max_port_per_cpu;
 		     cpu_port_num++) {
 
@@ -2756,7 +2756,7 @@ int register_dp_capability(int flag)
 	cap.info.cap.max_num_scheds = MAX_SCHD;
 	cap.info.cap.max_num_qos_ports = MAX_PPV4_PORT;
 	cap.info.cap.max_num_subif_per_port = MAX_SUBIF_PER_PORT;
-	cap.info.cap.max_cpu_ports = CQM_MAX_CPU;
+	cap.info.cap.max_cpu = CQM_MAX_CPU;
 	cap.info.dp_tc_vlan_set = tc_vlan_set;
 
 #if IS_ENABLED(CONFIG_INTEL_DATAPATH_HAL_GSWIP32)
diff --git a/drivers/net/datapath/dpm/gswip31/datapath_ppv4_api.c b/drivers/net/datapath/dpm/gswip31/datapath_ppv4_api.c
index 2862abae1b15..9313bac9e970 100644
--- a/drivers/net/datapath/dpm/gswip31/datapath_ppv4_api.c
+++ b/drivers/net/datapath/dpm/gswip31/datapath_ppv4_api.c
@@ -2246,6 +2246,7 @@ int _dp_deq_port_res_get(struct dp_dequeue_res *res, int flag)
 	u16 qids[MAX_Q_PER_PORT];
 	u32 q_num;
 	struct local *l;
+	struct dp_cap *cap;
 
 	p_info = get_dp_port_info(res->inst, res->dp_port);
 	if (!p_info->deq_port_num) {
@@ -2276,6 +2277,7 @@ int _dp_deq_port_res_get(struct dp_dequeue_res *res, int flag)
 	if (!l)
 		return DP_FAILURE;
 
+	cap = &get_dp_prop_info(res->inst)->cap;
 	res->num_q = 0;
 	for (k = res->cqm_deq_port; k < (res->cqm_deq_port + port_num); k++) {
 		p_stat = &priv->deq_port_stat[k];
@@ -2311,6 +2313,10 @@ int _dp_deq_port_res_get(struct dp_dequeue_res *res, int flag)
 			res->q_res[idx].sch_lvl = j;
 			res->q_res[idx].q_node = qids[i];
 			res->q_res[idx].q_id = l->q_info.physical_id;
+			if (res->dp_port == CPU_PORT) {
+				res->q_res[idx].cpu_id =
+					(k / cap->max_port_per_cpu);
+			}
 			DP_DEBUG(DP_DBG_FLAG_QOS_DETAIL, "Q[%d/%d]\n",
 				 l->q_info.physical_id, qids[i]);
 
diff --git a/include/net/datapath_api.h b/include/net/datapath_api.h
index 44c492bd5d87..1c4b4ac55bee 100644
--- a/include/net/datapath_api.h
+++ b/include/net/datapath_api.h
@@ -1718,7 +1718,7 @@ struct dp_cap {
 	u32 hw_tso: 1; /*!< output: HW TSO offload support for TX path */
 	u32 hw_gso: 1; /*!< output: HW GSO offload support for TX path */
 	u32 hw_ptp: 1; /*!< HW PTP support */
-	u32 max_cpu_ports: 8;		/*!< Maximum number of CPU ports */
+	u32 max_cpu: 8;			/*!< Maximum number of CPU */
 	u32 max_port_per_cpu: 8;	/*!< Maximum number of ports per CPU */
 	char qos_eng_name[DP_MAX_NAME]; /*!< QOS engine name in string */
 	char pkt_eng_name[DP_MAX_NAME]; /*!< Packet Engine Name String */
diff --git a/include/net/datapath_api_qos.h b/include/net/datapath_api_qos.h
index 525ba514a351..c35f4dd4e686 100644
--- a/include/net/datapath_api_qos.h
+++ b/include/net/datapath_api_qos.h
@@ -889,6 +889,7 @@ struct dp_queue_res {
 	u32 cqm_deq_port_type; /*!< output: Valid only in case of CPU DQ port
 				* with MPE
 				*/
+	u32 cpu_id; /*!< valid only for CPU port */
 };
 
 #define DEQ_PORT_OFFSET_ALL -1 /*!< @brief Port offset all */
