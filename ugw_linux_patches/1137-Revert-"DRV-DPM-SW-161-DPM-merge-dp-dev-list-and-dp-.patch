 				DP_DEBUG(DP_DBG_FLAG_REG,
@@ -1082,17 +1092,12 @@ int32_t dp_update_subif_info(struct dp_subif_upd_info *info)
 		if (res)
 			goto exit;
 	}
-
-	dp_dev = dp_dev_lookup(&dp_dev_list[idx],
-				info->new_dev, NULL, 0);
-	if (!dp_dev)
-		goto exit;
-
-	bp_info = &dp_dev->bp_info;
+	bp_info = get_dp_bp_info(info->inst, sif->bp);
 	if (old_ctp_dev) {
 		if (old_ctp_dev != info->new_ctp_dev) {
 			bp_info->ref_cnt--;
 			if (!bp_info->ref_cnt) {
+				bp_info->dev = NULL;
 				bp_info->flag = 0;
 			}
 			DP_DEBUG(DP_DBG_FLAG_REG,
@@ -1109,7 +1114,7 @@ int32_t dp_update_subif_info(struct dp_subif_upd_info *info)
 		old_data.ctp_dev = old_ctp_dev;
 	}
