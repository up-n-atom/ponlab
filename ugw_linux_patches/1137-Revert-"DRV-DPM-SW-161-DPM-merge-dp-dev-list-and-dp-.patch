-			DP_DEBUG(DP_DBG_FLAG_REG,
-					 "master dev with new bp(%d)\n", bp);
-			dp_dev->bp_info.flag = 1;
-		}
-
 		if (subif_name) {
 			strncpy(dp_dev->subif_name, subif_name,
 				sizeof(dp_dev->subif_name) - 1);
@@ -292,8 +294,8 @@ int dp_inst_add_dev(struct net_device *dev, struct net_device *ctp_dev,
 				return DP_FAILURE;
 		}
 #endif
