-	dp_dev = dp_dev_lookup(&dp_dev_list[idx],
-				       dev, NULL, 0);
-	if (!dp_dev)
-		goto EXIT;
-
-	bp_info = &dp_dev->bp_info;
+	bp_info = get_dp_bp_info(inst, bport);
 
 	/* update local table for pmapper */
 	bp_info->def_ctp = map->def_ctp;
@@ -2650,29 +2646,26 @@ int dp_set_bp_attr(struct dp_bp_attr *conf, u32 flag)
 }
 EXPORT_SYMBOL(dp_set_bp_attr);
 
-/*Return the bridge port index based on dev:
+/*Return the table entry index based on dev:
  *success: >=0
  *fail: DP_FAILURE
  */
 int bp_pmapper_dev_get(int inst, struct net_device *dev)
 {
-	u32 idx;
-	struct dp_dev *dp_dev;
+	int i;
+	struct bp_pmapper_dev *bp_info;
 
 	if (!dev)
 		return -1;
-
-	idx = dp_dev_hash(dev, NULL);
-	dp_dev = dp_dev_lookup(&dp_dev_list[idx],
-				       dev, NULL, 0);
-
-	if (dp_dev && dp_dev->bp_info.flag &&
-		dp_dev->dev == dev) {
-		DP_DEBUG(DP_DBG_FLAG_PAE, "matched %s\n",
-			dp_dev->dev->name);
-		return dp_dev->bp;
+	for (i = 0; i < ARRAY_SIZE(dp_bp_dev_tbl[inst]); i++) {
+		bp_info = get_dp_bp_info(inst, i);
+		if (!bp_info->flag)
+			continue;
+		if (bp_info->dev == dev) {
+			DP_DEBUG(DP_DBG_FLAG_PAE, "matched %s\n", dev->name);
+			return i;
+		}
 	}
-
 	return -1;
 }
 
diff --git a/drivers/net/datapath/dpm/datapath_instance.c b/drivers/net/datapath/dpm/datapath_instance.c
