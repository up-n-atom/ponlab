 			bp = dp_dev->bp;
 			fid = dp_dev->fid;
-			bp_info = &dp_dev->bp_info;
+			bp_info = get_dp_bp_info(info->inst, bp);
+			if (!bp_info->flag) {
+				pr_err("why bp_info->flag:%d(%s)?\n",
+				       bp_info->flag, "expect 1");
+				goto exit;
+			}
 			if (info->new_ctp_dev) {
-				if (!bp_info->flag) {
-					pr_err("why bp_info->flag:%d(%s)?\n",
-					       bp_info->flag, "expect 1");
-					goto exit;
-				}
