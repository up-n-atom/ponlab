 	port_info = get_dp_port_info(inst, port_id);
@@ -855,6 +864,7 @@ int32_t dp_deregister_subif_private(int inst, struct module *owner,
 	/* reset mib, flag, and others */
 	memset(&sif->mib, 0, sizeof(sif->mib));
 	sif->flags = 0;
+	sif->netif = NULL;
 	port_info->num_subif--;
 
 	/* subif_hw_reset */
@@ -863,8 +873,6 @@ int32_t dp_deregister_subif_private(int inst, struct module *owner,
 		pr_err("subif_platform_set fail\n");
 		/*return res;*/
 	}
