 /* q_tbl[] is mainly for the queue created/used during dp_register_subif_ext
  */
 struct q_info dp_q_tbl[DP_MAX_INST][DP_MAX_QUEUE_NUM];
@@ -766,7 +773,10 @@ int32_t dp_register_subif_private(int inst, struct module *owner,
 
 	if (i < end) {
 		res = DP_SUCCESS;
-		dp_inst_add_dev(dev, data->ctp_dev, subif_name,
+
