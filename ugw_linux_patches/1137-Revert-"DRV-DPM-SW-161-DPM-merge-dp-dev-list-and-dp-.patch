 			 "del old master dev(%s) from dp_dev list\n",
 			 old_dev->name);
@@ -1919,7 +1924,6 @@ int dp_get_port_subitf_via_dev_private(struct net_device *dev,
 			return DP_SUCCESS;
 		}
 	}
-
 	return DP_FAILURE;
 }
 
@@ -2260,8 +2264,6 @@ int dp_set_pmapper(struct net_device *dev, struct dp_pmapper *mapper, u32 flag)
 	int res = DP_FAILURE;
 	struct bp_pmapper_dev *bp_info;
 	struct inst_info *dp_info;
-	struct dp_dev *dp_dev;
-	u32 idx;
 
