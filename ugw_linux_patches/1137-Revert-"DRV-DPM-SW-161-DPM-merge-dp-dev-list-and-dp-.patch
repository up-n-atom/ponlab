 		sif = get_dp_port_subif(port_info, vap);
 #if IS_ENABLED(CONFIG_INTEL_DATAPATH_SWITCHDEV)
 		if ((!(flag & DP_F_SUBIF_LOGICAL)) &&
@@ -304,19 +306,18 @@ int dp_inst_add_dev(struct net_device *dev, struct net_device *ctp_dev,
 		dp_register_ptp_ioctl(dp_dev, dev, inst);
 #endif
 	}
