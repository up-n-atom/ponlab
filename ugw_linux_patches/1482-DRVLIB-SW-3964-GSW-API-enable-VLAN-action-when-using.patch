From 4b13fe1bfab4dad561b7e33555b6c797e26689f3 Mon Sep 17 00:00:00 2001
From: Xu Liang <liang.xu@intel.com>
Date: Fri, 6 Nov 2020 16:50:34 +0800
Subject: [PATCH] DRVLIB_SW-3964: GSW API - enable VLAN action when using
 alternative FID

---
 drivers/net/ethernet/lantiq/switch-api/gsw_flow_pce.c | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/drivers/net/ethernet/lantiq/switch-api/gsw_flow_pce.c b/drivers/net/ethernet/lantiq/switch-api/gsw_flow_pce.c
index 87097edb0f67..16805f9f45a4 100644
--- a/drivers/net/ethernet/lantiq/switch-api/gsw_flow_pce.c
+++ b/drivers/net/ethernet/lantiq/switch-api/gsw_flow_pce.c
@@ -2465,7 +2465,7 @@ int pce_rule_read(void *cdev, ltq_pce_table_t *pthandle, GSW_PCE_rule_t *parm)
 		}
 
 		/* FID action control */
-		if ((ptbl.val[5] >> 3) & 0x1) {
+		if ((ptbl.val[0] & BIT(1)) && (ptbl.val[5] & BIT(3))) {
 			parm->action.bFidEnable = 1;
 			parm->action.nFId = (ptbl.val[2] >> 8) & 0x3F;
 		}
@@ -4766,6 +4766,7 @@ int pce_rule_write(void *cdev, ltq_pce_table_t *pthandle, GSW_PCE_rule_t *parm)
 
 		/* FID action */
 		if (paction->bFidEnable == 1) {
+			ptbl.val[0] |= BIT(1);
 			ptbl.val[5] |= (1 << 3);
 			ptbl.val[2] |= ((paction->nFId) & 0x3F) << 8;
 		}
