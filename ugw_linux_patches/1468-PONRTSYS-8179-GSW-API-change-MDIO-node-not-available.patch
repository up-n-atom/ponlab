From 21ff99a15cc4654ed9ab8857c7c0d0e2ff41c435 Mon Sep 17 00:00:00 2001
From: Xu Liang <liang.xu@intel.com>
Date: Tue, 27 Oct 2020 21:04:46 +0800
Subject: [PATCH] PONRTSYS-8179: GSW API - change MDIO node not available
 message to debug message

---
 drivers/net/ethernet/lantiq/switch-api/gsw_mdio.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/net/ethernet/lantiq/switch-api/gsw_mdio.c b/drivers/net/ethernet/lantiq/switch-api/gsw_mdio.c
index f9c9a585bf7c..6e2babb58e42 100644
--- a/drivers/net/ethernet/lantiq/switch-api/gsw_mdio.c
+++ b/drivers/net/ethernet/lantiq/switch-api/gsw_mdio.c
@@ -84,7 +84,7 @@ int gsw_mdio_alloc(struct platform_device *pdev)
 
 	mdio = of_get_child_by_name(pdev->dev.of_node, "gsw_mdio");
 	if (!mdio) {
-		dev_err(&pdev->dev, "GSWIP %d: gsw_mdio node not found\n",
+		dev_dbg(&pdev->dev, "GSWIP %d: gsw_mdio node not found\n",
 			pdev->dev.parent->id);
 		return -ENOLINK;
 	}
