From 00be82d25a64364c21aae2cdd7b5a5f6ec1c16cf Mon Sep 17 00:00:00 2001
From: Rekha Eswaran <rekha.eswaran@intel.com>
Date: Mon, 13 Jul 2020 19:17:16 +0800
Subject: [PATCH] PONRTSYS-7764 Fix missing kmem_cache_free to solve kernel
 crashes

---
 drivers/net/datapath/dpm/datapath_misc.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/net/datapath/dpm/datapath_misc.c b/drivers/net/datapath/dpm/datapath_misc.c
index ecf37690fe25..3d1d9d05d6d7 100644
--- a/drivers/net/datapath/dpm/datapath_misc.c
+++ b/drivers/net/datapath/dpm/datapath_misc.c
@@ -876,7 +876,7 @@ void dp_subif_reclaim(struct rcu_head *rp)
 	struct dp_subif_cache *dp_subif =
 		container_of(rp, struct dp_subif_cache, rcu);
 
-	devm_kfree(&g_dp_dev->dev, dp_subif);
+	kmem_cache_free(cache_subif_list, dp_subif);
 }
 
 u32 dp_subif_hash(struct net_device *dev)
