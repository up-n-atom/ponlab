From 2bca3e316f214f682d14819e18c003dfe021ff1b Mon Sep 17 00:00:00 2001
From: Lishan Liu <lishan.liu@intel.com>
Date: Thu, 25 Jun 2020 09:59:59 +0800
Subject: [PATCH] DRVLIB_SW-3688: CQM drv support two radio dp port

to enable please add below entry to DTS to indicate
Number of radio dev: intel,radio-32-vap
example: intel,radio-32-vap = <1>;
---
 drivers/net/ethernet/lantiq/cqm/cqm_dev.c    |   5 +
 drivers/net/ethernet/lantiq/cqm/cqm_dev.h    |   1 +
 drivers/net/ethernet/lantiq/cqm/prx300/cqm.c | 316 +++++++++++++++++++--------
 drivers/net/ethernet/lantiq/cqm/prx300/cqm.h |   2 +
 include/net/lantiq_cbm_api.h                 |   2 +
 5 files changed, 236 insertions(+), 90 deletions(-)

diff --git a/drivers/net/ethernet/lantiq/cqm/cqm_dev.c b/drivers/net/ethernet/lantiq/cqm/cqm_dev.c
index 0ae399f73083..83332d6cc0e1 100755
--- a/drivers/net/ethernet/lantiq/cqm/cqm_dev.c
+++ b/drivers/net/ethernet/lantiq/cqm/cqm_dev.c
@@ -86,6 +86,11 @@ struct device_node *parse_dts(int j, void **pdata, struct resource **res,
 		pr_err("No syscon phandle specified for wan mux\n");
 		cqm_pdata->syscfg = NULL;
 	}
+
+	of_property_read_u32(node, "intel,radio-32-vap",
+			     &cqm_pdata->radio_dev_num);
+	pr_debug("num of radio dev : %d\n", cqm_pdata->radio_dev_num);
+
 	cqm_pdata->force_xpcs = of_property_read_bool(node, "intel,force-xpcs");
 	of_property_for_each_u32(node, "intel,bm-buff-num", prop, p, buf_num) {
 		cqm_pdata->pool_ptrs[cqm_pdata->num_pools++] = buf_num;
diff --git a/drivers/net/ethernet/lantiq/cqm/cqm_dev.h b/drivers/net/ethernet/lantiq/cqm/cqm_dev.h
index 4ed8f34fcd1c..53934955d441 100644
--- a/drivers/net/ethernet/lantiq/cqm/cqm_dev.h
+++ b/drivers/net/ethernet/lantiq/cqm/cqm_dev.h
@@ -51,6 +51,7 @@ struct cqm_data {
 	int gint_mode;
 	int highprio_lan;
 	int re_insertion;
+	int radio_dev_num;
 };
 
 void cqm_rst(struct cqm_data *lpp);
diff --git a/drivers/net/ethernet/lantiq/cqm/prx300/cqm.c b/drivers/net/ethernet/lantiq/cqm/prx300/cqm.c
index 5163ccfd43e9..1d2f73ba4bc6 100644
