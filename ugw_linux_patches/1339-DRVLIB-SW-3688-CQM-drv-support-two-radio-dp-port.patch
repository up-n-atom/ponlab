 	if (!owner)
 		return CBM_FAILURE;
 	dev_dbg(cqm_ctrl->dev, "flags 0x%x\n", flags);
 	/*to allocate port*/
+
+	if (cqm_ctrl->radio_num) {
+		port_resv_st = PMAC_ALLOC_START_ID % 2 + PMAC_ALLOC_START_ID;
+		port_resv_end = port_resv_st + 2 * cqm_ctrl->radio_num - 1;
+		if (port_resv_end > PMAC_ALLOC_END_ID)
+			return DP_FAILURE;
+	}
+
 	if (flags & FLAG_LAN) {
