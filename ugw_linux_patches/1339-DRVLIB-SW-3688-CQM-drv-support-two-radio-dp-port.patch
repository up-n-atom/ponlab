 		}
+
+		if ((flags & DP_F_SHARE_RES) && (cqm_ctrl->radio_num)) {
+			shared_port = port_id ^ 1;
+			if (is_dp_allocated(shared_port, flags))
+				shared_port_exist = 1;
+			else
+				shared_port_exist = 0;
+		}
 		param_pmac = port_id;
 		pmac_present = 1;
