From 213984caa0e08fc49b068bb672ec7930f8ef0bd5 Mon Sep 17 00:00:00 2001
From: Lishan Liu <lishan.liu@intel.com>
Date: Mon, 11 Jan 2021 18:19:29 +0800
Subject: [PATCH] DRVLIB_SW-4046: CQM invalid metatdata at shutdown

---
 drivers/net/ethernet/lantiq/cqm/prx300/cqm.c | 14 ++++++++++----
 1 file changed, 10 insertions(+), 4 deletions(-)

diff --git a/drivers/net/ethernet/lantiq/cqm/prx300/cqm.c b/drivers/net/ethernet/lantiq/cqm/prx300/cqm.c
index 93ea5edcf7a8..3eb223f391a4 100644
--- a/drivers/net/ethernet/lantiq/cqm/prx300/cqm.c
+++ b/drivers/net/ethernet/lantiq/cqm/prx300/cqm.c
@@ -1611,7 +1611,6 @@ static int cqm_buffer_free_by_policy_prx300(struct cqm_bm_free *free_info)
 
 		if ((pool != CQM_FSQM_POOL) &&
 		    (policy != CQM_FSQM_POLICY)) {
-			get_metadata((u8 *)buf, &pool, &policy);
 			memset((u8 *)buf, 0, CQM_PRX300_POOL_POL_HDR_SIZE);
 			buf = dma_map_single(cqm_ctrl->dev, (void *)buf,
 					     size, DMA_FROM_DEVICE);
@@ -2177,10 +2176,14 @@ static s32 cqm_dp_port_dealloc(struct module *owner, u32 dev_port,
 
 	/* Free ACA port */
 	if ((flags & FLAG_ACA) && (p_info->deq_info.pkt_base)) {
+		struct cqm_bm_free free_info;
+
+		free_info.policy_base = 0;
 		for (idx = 0; idx < p_info->deq_info.prefill_pkt_num; idx++) {
 			if (p_info->deq_info.pkt_base[idx]) {
 				buf = (void *)p_info->deq_info.pkt_base[idx];
-				cqm_buffer_free(cpu, buf, 1);
+				free_info.buf = buf;
+				cqm_buffer_free_by_policy_prx300(&free_info);
 			} else {
 				break;
 			}
@@ -2692,7 +2695,8 @@ static void cqm_deq_pon_port_disable(u32 port, u32 alloc_flags)
 		       PIB_PON_IP_CMD_PORT_ID_POS) | 0x28000;
 		cbm_w32(cqm_ctrl->pib + PIB_PON_IP_CMD, val);
 		dev_dbg(cqm_ctrl->dev, "%s: write CQEM_PIB_PIB_PON_IP_CMD %lx , val %x\n",
-			__func__, (unsigned long) cqm_ctrl->pib + PIB_PON_IP_CMD, val);
+			__func__,
+			(unsigned long)cqm_ctrl->pib + PIB_PON_IP_CMD, val);
 		pib_status_get(&stat);
 		dev_dbg(cqm_ctrl->dev, "%s waiting for fifo_emtpy %d\n",
 			__func__, stat.fifo_empty);
@@ -2809,7 +2813,9 @@ static s32 dp_enable(struct module *owner, u32 port_id,
 			cbm_w32(cqm_ctrl->pib + PIB_PON_IP_CMD, val);
 			dev_dbg(cqm_ctrl->dev,
 				"%s: write CQEM_PIB_PIB_PON_IP_CMD %lx , val %x\n",
-				__func__, (unsigned long) cqm_ctrl->pib + PIB_PON_IP_CMD, val);
+				__func__,
+				(unsigned long)cqm_ctrl->pib + PIB_PON_IP_CMD,
+				val);
 		}
 
 		if (!(flags & CBM_PORT_F_DISABLE)) {
