From fbc650a5e34d3c1dd65a06bb5e4fd7e2e6a340e3 Mon Sep 17 00:00:00 2001
From: gsupriya <supriya1.g@intel.com>
Date: Thu, 10 Sep 2020 18:41:23 +0530
Subject: [PATCH] UGW_SW-52478:Change in mcast_helper to allow 239.x.x.x
 multicast data packets to be added to acceleration

---
 net/mcast_helper/mcast_helper.c | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/net/mcast_helper/mcast_helper.c b/net/mcast_helper/mcast_helper.c
index 58b0e3292ac7..bf68d14c22c4 100644
--- a/net/mcast_helper/mcast_helper.c
+++ b/net/mcast_helper/mcast_helper.c
@@ -589,7 +589,8 @@ static void mcast_helper_five_tuple_br_hook(struct sk_buff *skb)
 		uint8_t src_mac[ETH_ALEN] = { 0 };
 		struct iphdr *iph = ip_hdr(skb);
 		struct udphdr *udph = (struct udphdr *)((u8 *)iph +(iph->ihl << 2));
-		if (((ntohl(iph->daddr) & 0xffffff00U) == 0xe0000000U) || ((ntohl(iph->daddr) & 0xff000000U) == 0xef000000U))
+		/* Ignore Multicast control packets(224.0.0.x) & UPnP packets(239.255.255.250) */
+		if (((ntohl(iph->daddr) & 0xffffff00U) == 0xe0000000U) || ((ntohl(iph->daddr) & 0xffffffffU) == 0xeffffffaU))
 			return;
 		mcast_helper_init_ipaddr(&saddr, IPV4, &iph->saddr);
 		mcast_helper_init_ipaddr(&daddr, IPV4, &iph->daddr);
@@ -1563,7 +1564,8 @@ static int mcast_helper_add_entry(struct net_device *netdev, struct net_device *
 	int ret=0;
 	unsigned int flag = 0;
 
-	if (((ntohl(mc_rec->groupIP.ipA.ipAddr.s_addr) & 0xffffff00U) == 0xe0000000U) || ((ntohl(mc_rec->groupIP.ipA.ipAddr.s_addr) & 0xff000000U) == 0xef000000U)) {
+	/* Ignore Multicast control packets(224.0.0.x) & UPnP packets(239.255.255.250) */
+	if (((ntohl(mc_rec->groupIP.ipA.ipAddr.s_addr) & 0xffffff00U) == 0xe0000000U) || ((ntohl(mc_rec->groupIP.ipA.ipAddr.s_addr) & 0xffffffffU) == 0xeffffffaU)) {
 		return FAILURE;
 	}
 	gimc_rec = mcast_helper_search_gimc_record(&(mc_rec->groupIP),&(mc_rec->srcIP),gimc_list);
