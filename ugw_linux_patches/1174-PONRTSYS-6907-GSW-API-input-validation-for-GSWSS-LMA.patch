From 1d06bf5f9164892a39e43642ab1381d6beb1485d Mon Sep 17 00:00:00 2001
From: Xu Liang <liang.xu@intel.com>
Date: Tue, 19 May 2020 22:39:15 +0800
Subject: [PATCH] PONRTSYS-6907: GSW API - input validation for GSWSS, LMAC,
 XGMAC debug function

---
 .../net/ethernet/lantiq/switch-api/gswip_dev/gsw_dev.c   |  2 +-
 .../net/ethernet/lantiq/switch-api/mac/gswss_mac_api.c   | 16 ++++++++++++----
 drivers/net/ethernet/lantiq/switch-api/mac/lmac_api.c    |  8 ++++++++
 drivers/net/ethernet/lantiq/switch-api/mac/mac_cli.c     | 14 +++++++++-----
 drivers/net/ethernet/lantiq/switch-api/mac/xgmac_main.c  |  8 ++++++++
 5 files changed, 38 insertions(+), 10 deletions(-)

diff --git a/drivers/net/ethernet/lantiq/switch-api/gswip_dev/gsw_dev.c b/drivers/net/ethernet/lantiq/switch-api/gswip_dev/gsw_dev.c
index bba0acd3e965..8901a8d6e7e5 100644
--- a/drivers/net/ethernet/lantiq/switch-api/gswip_dev/gsw_dev.c
+++ b/drivers/net/ethernet/lantiq/switch-api/gswip_dev/gsw_dev.c
@@ -738,7 +738,7 @@ struct mac_ops *gsw_get_mac_ops(u32 devid, u32 mac_idx)
 {
 	u32 macid = mac_idx - MAC_2;
 
-	if (macid > gsw_dev[devid].mac_subdevs_cnt)
+	if (macid >= gsw_dev[devid].mac_subdevs_cnt)
 		return NULL;
 
 	if (gsw_dev[devid].mac_dev[macid])
diff --git a/drivers/net/ethernet/lantiq/switch-api/mac/gswss_mac_api.c b/drivers/net/ethernet/lantiq/switch-api/mac/gswss_mac_api.c
index 1f33d165b5fb..b48779c0a9b4 100644
--- a/drivers/net/ethernet/lantiq/switch-api/mac/gswss_mac_api.c
+++ b/drivers/net/ethernet/lantiq/switch-api/mac/gswss_mac_api.c
@@ -20,6 +20,10 @@ int gswss_wr_reg(void *pdev, u32 reg_off, u32 reg_val)
 {
 	struct mac_prv_data *pdata = GET_MAC_PDATA(pdev);
 
+	if (reg_off >= 0x2000)
+		return -EFAULT;
+
+	reg_off &= 0x1FFC;
 	GSWSS_MAC_RGWR(pdata, reg_off, reg_val);
 
 	return 0;
@@ -30,6 +34,10 @@ int gswss_rd_reg(void *pdev, u32 reg_off)
 	struct mac_prv_data *pdata = GET_MAC_PDATA(pdev);
 	GSW_MAC_Cli_t *param = pdata->mac_cli;
 
+	if (reg_off >= 0x2000)
+		return -EFAULT;
+
+	reg_off &= 0x1FFC;
 	param->val[0] = GSWSS_MAC_RGRD(pdata, reg_off);
 
 	return param->val[0];
@@ -42,7 +50,7 @@ int gswss_xgmac_reset(void *pdev, u32 reset)
 
 	mac_if_cfg = GSWSS_MAC_RGRD(pdata, MAC_IF_CFG(pdata->mac_idx));
 
-	MAC_SET_VAL(mac_if_cfg, MAC_IF_CFG, XGMAC_RES, reset);
+	MAC_SET_VAL(mac_if_cfg, MAC_IF_CFG, XGMAC_RES, reset ? 1 : 0);
 
 	mac_dbg("GSWSS: Resetting XGMAC %d Module\n", pdata->mac_idx);
 
@@ -58,7 +66,7 @@ int gswss_lmac_reset(void *pdev, u32 reset)
 
 	mac_if_cfg = GSWSS_MAC_RGRD(pdata, MAC_IF_CFG(pdata->mac_idx));
 
-	MAC_SET_VAL(mac_if_cfg, MAC_IF_CFG, LMAC_RES, reset);
+	MAC_SET_VAL(mac_if_cfg, MAC_IF_CFG, LMAC_RES, reset ? 1 : 0);
 
 	mac_dbg("GSWSS: Resetting LMAC %d Module\n", pdata->mac_idx);
 
@@ -74,7 +82,7 @@ int gswss_adap_reset(void *pdev, u32 reset)
 
 	mac_if_cfg = GSWSS_MAC_RGRD(pdata, MAC_IF_CFG(pdata->mac_idx));
 
-	MAC_SET_VAL(mac_if_cfg, MAC_IF_CFG, ADAP_RES, reset);
+	MAC_SET_VAL(mac_if_cfg, MAC_IF_CFG, ADAP_RES, reset ? 1 : 0);
 
 	mac_dbg("GSWSS: Resetting ADAP %d Module\n", pdata->mac_idx);
 
@@ -90,7 +98,7 @@ int gswss_mac_enable(void *pdev, u32 enable)
 
 	mac_if_cfg = GSWSS_MAC_RGRD(pdata, MAC_IF_CFG(pdata->mac_idx));
 
-	MAC_SET_VAL(mac_if_cfg, MAC_IF_CFG, MAC_EN, enable);
+	MAC_SET_VAL(mac_if_cfg, MAC_IF_CFG, MAC_EN, enable ? 1 : 0);
 
 	mac_dbg("GSWSS: MAC %d: %s\n", pdata->mac_idx,
 		enable ? "ENABLED" : "DISABLED");
diff --git a/drivers/net/ethernet/lantiq/switch-api/mac/lmac_api.c b/drivers/net/ethernet/lantiq/switch-api/mac/lmac_api.c
index 4d69982d9f63..db6dfd010379 100644
--- a/drivers/net/ethernet/lantiq/switch-api/mac/lmac_api.c
+++ b/drivers/net/ethernet/lantiq/switch-api/mac/lmac_api.c
@@ -18,6 +18,10 @@ int lmac_wr_reg(void *pdev, u32 reg_off, u32 reg_val)
 {
 	struct mac_prv_data *pdata = GET_MAC_PDATA(pdev);
 
+	if (reg_off >= 0x1000)
+		return -EFAULT;
+
+	reg_off &= 0x0FFC;
 	LMAC_RGWR(pdata, reg_off, reg_val);
 
 	return 0;
@@ -28,6 +32,10 @@ int lmac_rd_reg(void *pdev, u32 reg_off)
 	struct mac_prv_data *pdata = GET_MAC_PDATA(pdev);
 	GSW_MAC_Cli_t *param = pdata->mac_cli;
 
+	if (reg_off >= 0x1000)
+		return -EFAULT;
+
+	reg_off &= 0x0FFC;
 	param->val[0] = LMAC_RGRD(pdata, reg_off);
 
 	return param->val[0];
diff --git a/drivers/net/ethernet/lantiq/switch-api/mac/mac_cli.c b/drivers/net/ethernet/lantiq/switch-api/mac/mac_cli.c
index e408e43cba86..c72396110789 100644
--- a/drivers/net/ethernet/lantiq/switch-api/mac/mac_cli.c
+++ b/drivers/net/ethernet/lantiq/switch-api/mac/mac_cli.c
@@ -250,8 +250,8 @@ static const struct mac_api_cfg xgmac_cfg[] = {
 
 int xgmac_cfg_main(GSW_MAC_Cli_t *params)
 {
-	struct mac_ops *ops = gsw_get_mac_ops(0, MAC_2);
-	struct mac_prv_data *pdata = GET_MAC_PDATA(ops);
+	struct mac_ops *ops;
+	struct mac_prv_data *pdata;
 	int i = 0, ret = 0;
 	int num_of_elem = ARRAY_SIZE(xgmac_cfg);
 
@@ -261,9 +261,11 @@ int xgmac_cfg_main(GSW_MAC_Cli_t *params)
 		}
 	}
 	if (i >= num_of_elem)
-		return -1;
+		return -EINVAL;
 
 	ops = gsw_get_mac_ops(0, params->mac_idx);
+	if (!ops)
+		return -EINVAL;
 	pdata = GET_MAC_PDATA(ops);
 	pdata->set_all = 0;
 
@@ -497,7 +499,7 @@ int gswss_cfg_main(GSW_MAC_Cli_t *params)
 		}
 	}
 	if (i >= num_of_elem)
-		return -1;
+		return -EINVAL;
 
 	if (params->cmdType < GSWSS_MAX_MAC) {
 
@@ -603,9 +605,11 @@ int lmac_cfg_main(GSW_MAC_Cli_t *params)
 		}
 	}
 	if (i >= num_of_elem)
-		return -1;
+		return -EINVAL;
 
 	mac_ops = gsw_get_mac_ops(0, params->mac_idx);
+	if (!mac_ops)
+		return -EINVAL;
 	mac_pdata = GET_MAC_PDATA(mac_ops);
 
 	mac_pdata->mac_cli = params;
diff --git a/drivers/net/ethernet/lantiq/switch-api/mac/xgmac_main.c b/drivers/net/ethernet/lantiq/switch-api/mac/xgmac_main.c
index cceb639adbbf..b5fca045fe0a 100644
--- a/drivers/net/ethernet/lantiq/switch-api/mac/xgmac_main.c
+++ b/drivers/net/ethernet/lantiq/switch-api/mac/xgmac_main.c
@@ -88,6 +88,10 @@ int xgmac_wr_reg(void *pdev, u32 reg_off, u32 reg_val)
 {
 	struct mac_prv_data *pdata = GET_MAC_PDATA(pdev);
 
+	if (reg_off >= 0x4000)
+		return -EFAULT;
+
+	reg_off &= 0x3FFC;
 	XGMAC_RGWR(pdata, reg_off, reg_val);
 
 	return 0;
@@ -97,6 +101,10 @@ int xgmac_rd_reg(void *pdev, u32 reg_off)
 {
 	struct mac_prv_data *pdata = GET_MAC_PDATA(pdev);
 
+	if (reg_off >= 0x4000)
+		return -EFAULT;
+
+	reg_off &= 0x3FFC;
 	pdata->mac_cli->val[0] = XGMAC_RGRD(pdata, reg_off);
 
 	return pdata->mac_cli->val[0];
