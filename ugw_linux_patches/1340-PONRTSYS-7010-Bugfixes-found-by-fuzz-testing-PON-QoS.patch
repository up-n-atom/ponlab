From 92661077ac85275ec989aca9c48579f6d516190c Mon Sep 17 00:00:00 2001
From: Cardoso Tiago <tiago.cardoso.abrahao@intel.com>
Date: Thu, 16 Jul 2020 10:30:48 +0200
Subject: [PATCH] PONRTSYS-7010 - Bugfixes found by fuzz testing PON QoS driver
 - Add option for KCOV enabling for PON QoS

---
 drivers/net/datapath/pon_qos/Kconfig           |  7 +++++++
 drivers/net/datapath/pon_qos/Makefile          |  2 ++
 drivers/net/datapath/pon_qos/pon_qos_tc_qmap.c | 16 +++++++++-------
 net/sched/act_api.c                            |  2 ++
 4 files changed, 20 insertions(+), 7 deletions(-)

diff --git a/drivers/net/datapath/pon_qos/Kconfig b/drivers/net/datapath/pon_qos/Kconfig
index 18318c6f8385..f139fe533cdf 100644
--- a/drivers/net/datapath/pon_qos/Kconfig
+++ b/drivers/net/datapath/pon_qos/Kconfig
@@ -11,3 +11,10 @@ config PON_QOS
 	  resources as schedulers, queues etc. The interface is based on linux
 	  tc offload interface. The Intel datapath driver is used to do the
 	  actual hardware configuration.
+
+config PON_QOS_KCOV
+	default n if KCOV_INSTRUMENT_ALL
+	bool "PON QoS KCOV"
+	depends on KCOV
+	help
+	  Enable coverage on PON QoS driver for fuzzing.
diff --git a/drivers/net/datapath/pon_qos/Makefile b/drivers/net/datapath/pon_qos/Makefile
index 8964c86d222f..cc2073622504 100644
--- a/drivers/net/datapath/pon_qos/Makefile
+++ b/drivers/net/datapath/pon_qos/Makefile
@@ -1,3 +1,5 @@
+KCOV_INSTRUMENT:=$(CONFIG_PON_QOS_KCOV)
+
 obj-$(CONFIG_PON_QOS) = pon_qos.o
 
 pon_qos-objs := \
diff --git a/drivers/net/datapath/pon_qos/pon_qos_tc_qmap.c b/drivers/net/datapath/pon_qos/pon_qos_tc_qmap.c
index 616649ef68ca..10919a06c0c7 100644
--- a/drivers/net/datapath/pon_qos/pon_qos_tc_qmap.c
+++ b/drivers/net/datapath/pon_qos/pon_qos_tc_qmap.c
@@ -115,19 +115,21 @@ int pon_qos_tc_map(struct net_device *dev, struct tc_cls_flower_offload *f)
 
 	if (ifi) {
 		indev = dev_get_by_index(dev_net(dev), ifi);
-		if (!indev) {
-			ret = -1;
-			goto err;
-		}
+		if (!indev)
+			return -1;
 	}
 
 	ret = pon_qos_tc_flower_action_valid(f->exts);
 	if (ret < 0)
-		goto err;
+		return ret;
 
 	ret = pon_qos_parse_tc_flower(f, &map);
-	if (ret < 0)
-		goto err;
+	if (ret < 0) {
+		if (map)
+			goto err;
+		else
+			return ret;
+	}
 
 	map->dev = dev;
 	map->indev = indev;
diff --git a/net/sched/act_api.c b/net/sched/act_api.c
index eaa3a20fd47d..14ebba769574 100644
--- a/net/sched/act_api.c
+++ b/net/sched/act_api.c
@@ -487,6 +487,8 @@ tcf_action_dump_1(struct sk_buff *skb, struct tc_action *a, int bind, int ref)
 	unsigned char *b = skb_tail_pointer(skb);
 	struct nlattr *nest;
 
+	if (!a || !a->ops || !a->ops->kind)
+		goto nla_put_failure;
 	if (nla_put_string(skb, TCA_KIND, a->ops->kind))
 		goto nla_put_failure;
 	if (tcf_action_copy_stats(skb, a, 0))
