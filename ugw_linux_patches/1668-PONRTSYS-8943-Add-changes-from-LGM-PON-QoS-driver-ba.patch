diff --git a/drivers/net/datapath/pon_qos/pon_qos_tc_drr.c b/drivers/net/datapath/pon_qos/pon_qos_tc_drr.c
index 6dd8335870fb..74560fc4cea4 100644
--- a/drivers/net/datapath/pon_qos/pon_qos_tc_drr.c
+++ b/drivers/net/datapath/pon_qos/pon_qos_tc_drr.c
@@ -8,6 +8,7 @@
 #include <net/pkt_cls.h>
 #include <net/datapath_api.h>
 #include <net/datapath_api_qos.h>
+#include <linux/version.h>
 #include "pon_qos_tc_qos.h"
 #include "pon_qos_trace.h"
 
@@ -112,7 +113,6 @@ static int pon_qos_drr_queue_update(struct net_device *dev,
 }
 
 static int pon_qos_tc_drr_replace(struct net_device *dev,
-				  u32 handle,
 				  struct tc_drr_qopt_offload *opt,
 				  int port_id,
 				  int deq_idx)
@@ -132,7 +132,7 @@ static int pon_qos_tc_drr_replace(struct net_device *dev,
 		newp = true;
 	}
 
-	if (!TC_H_MIN(handle)) {
+	if (!TC_H_MIN(opt->handle)) {
 		netdev_dbg(dev, "%s: Config drr sched\n", __func__);
 		port->root_qdisc.port = port_id;
 		port->root_qdisc.deq_idx = deq_idx;
@@ -152,9 +152,9 @@ static int pon_qos_tc_drr_replace(struct net_device *dev,
 	/* This is a drr class so queue has to be configured on
 	 * an existing port.
 	 */
-	if (TC_H_MIN(handle) && !newp) {
+	if (TC_H_MIN(opt->handle) && !newp) {
 		netdev_dbg(dev, "%s: Config queue\n", __func__);
-		qdisc = pon_qos_qdisc_find(port, handle);
+		qdisc = pon_qos_qdisc_find(port, opt->handle);
 		if (!qdisc) {
 			netdev_err(dev, "%s: radix tree broken\n", __func__);
 			return -ENODEV;
@@ -246,7 +246,6 @@ static int pon_qos_tc_drr_qdisc_del(struct pon_qos_port *port,
 }
 
 static int pon_qos_tc_drr_destroy(struct net_device *dev,
-				  u32 handle,
 				  struct tc_drr_qopt_offload *opt)
 {
 	struct pon_qos_port *port = NULL;
@@ -265,7 +264,7 @@ static int pon_qos_tc_drr_destroy(struct net_device *dev,
 		return 0;
 	}
 
-	ret = pon_qos_tc_drr_queue_del(sch, handle);
+	ret = pon_qos_tc_drr_queue_del(sch, opt->handle);
 	if (ret < 0)
 		return ret;
 
@@ -286,13 +285,18 @@ static int pon_qos_tc_drr_destroy(struct net_device *dev,
 }
 
 int pon_qos_tc_drr_offload(struct net_device *dev,
-			   u32 handle,
-			   struct tc_to_netdev *tc,
+			   void *type_data,
 			   int port_id,
 			   int deq_idx)
 {
 	int err = 0;
-	struct tc_drr_qopt_offload *opt = tc->sch_drr;
+#if (KERNEL_VERSION(4, 14, 0) > LINUX_VERSION_CODE)
+	struct tc_drr_qopt_offload *opt =
+		((struct tc_to_netdev *)type_data)->sch_drr;
+#else
+	struct tc_drr_qopt_offload *opt =
+		(struct tc_drr_qopt_offload *)type_data;
+#endif
 
 	ASSERT_RTNL();
 	netdev_dbg(dev, "DRR: offload starting\n");
@@ -302,7 +306,7 @@ int pon_qos_tc_drr_offload(struct net_device *dev,
 	case TC_DRR_REPLACE:
 		netdev_dbg(dev, "pid: %#x class/handle: %#x quantum: %#x\n",
 			   opt->parent, opt->handle, opt->set_params.quantum);
-		err = pon_qos_tc_drr_replace(dev, handle, opt,
+		err = pon_qos_tc_drr_replace(dev, opt,
 					     port_id, deq_idx);
 		if (err < 0) {
 			netdev_err(dev, "tc-drr replace failed\n");
@@ -313,7 +317,7 @@ int pon_qos_tc_drr_offload(struct net_device *dev,
 		netdev_dbg(dev,
 			   "destroy pid: %#x class/handle: %#x quantum: %#x\n",
 			   opt->parent, opt->handle, opt->set_params.quantum);
-		err = pon_qos_tc_drr_destroy(dev, handle, opt);
+		err = pon_qos_tc_drr_destroy(dev, opt);
 		if (err < 0) {
 			netdev_err(dev, "tc-drr destroy failed\n");
 			return err;
