+
+static inline int toe_tso_port_ready(int port, int waitThreshold)
+{
+	unsigned long OwnReg;
+
+	do {
+		OwnReg = ltq_toe_r32(PORT_REQ_CMD_REG5(port));
+		--waitThreshold;
+	} while ( waitThreshold && !test_bit(31, &OwnReg) );
+
+	return test_bit(31, &OwnReg);
+}
