From 3849a98eb38662090af876591ce9d3c8c7b34532 Mon Sep 17 00:00:00 2001
From: Ayyappan Rathinam <ayyappanx.rathinam@intel.com>
Date: Tue, 12 May 2020 16:49:42 +0200
Subject: [PATCH] PONRTSYS-7139: New LAN/WAN serdes configuration

---
 drivers/net/ethernet/lantiq/xpcs/xpcs.c | 57 ++++++++++++++++-----------------
 drivers/net/ethernet/lantiq/xpcs/xpcs.h |  3 +-
 2 files changed, 29 insertions(+), 31 deletions(-)

diff --git a/drivers/net/ethernet/lantiq/xpcs/xpcs.c b/drivers/net/ethernet/lantiq/xpcs/xpcs.c
index dcfa4f2bfd78..9e120d79181f 100644
--- a/drivers/net/ethernet/lantiq/xpcs/xpcs.c
+++ b/drivers/net/ethernet/lantiq/xpcs/xpcs.c
@@ -24,28 +24,27 @@
 #include "xpcs.h"
 #include <linux/netdevice.h>
 
-#define MAX_BUSY_RETRY	2000
-#define XPCS_IRQ_NAME "xpcs_irq"
-#define XPCS_RES_NAME "xpcs_reg"
-#define XPCS_MOD_NAME "xpcs-name"
-#define XPCS_CONN_TYPE "xpcs-conn"
-#define XPCS_MODE_NAME "xpcs-mode"
-#define XPCS_RESET_NAME "xpcs_reset"
-#define POWER_SAVE_MODE "power-save"
-#define XPCS_MAC_IDX	"mac_idx"
-#define XPCS_SERDES_CFG	"serdes_cfg"
-#define XPCS_NO_PHY_CALI	"xpcs-no-phy-callibration"
-#define XPCS_RX_RATE	"xpcs-rx-rate"
-#define XPCS_AFE_EN		"xpcs-afe_en"
-#define XPCS_DFE_EN		"xpcs-dfe_en"
-#define XPCS_ADAPT_EN		"xpcs-cont_adapt_en"
-#define XPCS_RX_ATTN_LVL	"xpcs-rx_attn_lvl"
-#define XPCS_CTLE_BOOTS		"xpcs-rx_ctle_boost"
-#define XPCS_CTLE_POLE		"xpcs-rx_ctle_pole"
-#define XPCS_VGA2_GAIN		"xpcs-rx_vga2_gain"
-#define XPCS_VGA1_GAIN		"xpcs-rx_vga1_gain"
-#define LINK_POLL_TIME	"link_poll_interval"
-#define LINK_MODE_CFG	"xpcs_mode_cfg_seq"
+#define MAX_BUSY_RETRY			2000
+#define XPCS_IRQ_NAME			"xpcs_irq"
+#define XPCS_RES_NAME			"xpcs_reg"
+#define XPCS_MOD_NAME			"xpcs-name"
+#define XPCS_CONN_TYPE			"xpcs-conn"
+#define XPCS_MODE_NAME			"xpcs-mode"
+#define XPCS_RESET_NAME			"xpcs_reset"
+#define POWER_SAVE_MODE			"power-save"
+#define XPCS_MAC_IDX			"mac_idx"
+#define XPCS_SERDES_CFG			"serdes_cfg"
+#define XPCS_NO_PHY_RX_AUTO_ADAPT	"xpcs-no-phy-rx-auto-adapt"
+#define XPCS_AFE_EN			"xpcs-afe_en"
+#define XPCS_DFE_EN			"xpcs-dfe_en"
+#define XPCS_ADAPT_EN			"xpcs-cont_adapt_en"
+#define XPCS_RX_ATTN_LVL		"xpcs-rx_attn_lvl"
+#define XPCS_CTLE_BOOTS			"xpcs-rx_ctle_boost"
+#define XPCS_CTLE_POLE			"xpcs-rx_ctle_pole"
+#define XPCS_VGA2_GAIN			"xpcs-rx_vga2_gain"
+#define XPCS_VGA1_GAIN			"xpcs-rx_vga1_gain"
+#define LINK_POLL_TIME			"link_poll_interval"
+#define LINK_MODE_CFG			"xpcs_mode_cfg_seq"
 
 #define PHY_BOOST(BOOST, POLE, VGA2, VGA1) \
 		((BOOST << 0) | (POLE << 5) | (VGA2 << 8) | (VGA1 << 12))
@@ -955,7 +954,6 @@ static int xpcs_init(struct xpcs_prv_data *pdata)
 		pdata->mode_cfg->afe_en = pdata->serdes_cfg->afe_en;
 		pdata->mode_cfg->dfe_en = pdata->serdes_cfg->dfe_en;
 		pdata->mode_cfg->cont_adapt0 = pdata->serdes_cfg->cont_adapt0;
-		pdata->mode_cfg->rx_rate[0] = pdata->serdes_cfg->rx_rate;
 		pdata->mode_cfg->phy_boost_gain_val =
 					pdata->serdes_cfg->phy_boost_gain_val;
 	}
@@ -1055,8 +1053,8 @@ static int xpcs_parse_dts(struct platform_device *pdev,
 	/* Retrieve XPCS SERDES configs */
 	serdes = of_get_child_by_name(serdes, XPCS_SERDES_CFG);
 	if (serdes) {
-		(*pdata)->serdes_cfg->xpcs_no_phy_cali =
-				of_property_read_bool(serdes, XPCS_NO_PHY_CALI);
+		(*pdata)->serdes_cfg->no_phy_rx_auto_adapt =
+		       of_property_read_bool(serdes, XPCS_NO_PHY_RX_AUTO_ADAPT);
 		rx = of_get_child_by_name(serdes, "rx_enq");
 		if (rx) {
 			(*pdata)->serdes_cfg->f_serdes = RX_ENQ;
@@ -1076,8 +1074,6 @@ static int xpcs_parse_dts(struct platform_device *pdev,
 				(*pdata)->serdes_cfg->rx_vga2_gain = prop;
 			if (!of_property_read_u32(rx, XPCS_VGA1_GAIN, &prop))
 				(*pdata)->serdes_cfg->rx_vga1_gain = prop;
-			if (!of_property_read_u32(rx, XPCS_RX_RATE, &prop))
-				(*pdata)->serdes_cfg->rx_rate = prop;
 
 			prop = PHY_BOOST((*pdata)->serdes_cfg->rx_ctle_boost,
 					 (*pdata)->serdes_cfg->rx_ctle_pole,
@@ -1090,6 +1086,9 @@ static int xpcs_parse_dts(struct platform_device *pdev,
 	xpcs_cfg = xpcs_get_cfg(ONEG_XAUI_MODE);
 	xpcs_update_cfg(dev, xpcs_cfg, "serdes_1g_cfg");
 
+	xpcs_cfg = xpcs_get_cfg(TWOP5G_SGMII_MODE);
+	xpcs_update_cfg(dev, xpcs_cfg, "serdes_1g_cfg");
+
 	xpcs_cfg = xpcs_get_cfg(TENG_KR_MODE);
 	xpcs_update_cfg(dev, xpcs_cfg, "serdes_10g_cfg");
 
@@ -1210,7 +1209,7 @@ static int xpcs_power_on(struct device *dev)
 
 	pdata->state = 1;
 
-	if (!pdata->serdes_cfg->xpcs_no_phy_cali)
+	if (!pdata->serdes_cfg->no_phy_rx_auto_adapt)
 		ret = phy_calibrate(phy);
 
 	return ret;
@@ -1446,7 +1445,7 @@ static int xpcs_probe(struct platform_device *pdev)
 	}
 
 	/* Phy calibrate for RX Signal Adaption */
-	if (!pdata->serdes_cfg->xpcs_no_phy_cali)
+	if (!pdata->serdes_cfg->no_phy_rx_auto_adapt)
 		ret = phy_calibrate(pdata->phy);
 
 	/* Schedule the link poll task if link is dynmically configurable*/
diff --git a/drivers/net/ethernet/lantiq/xpcs/xpcs.h b/drivers/net/ethernet/lantiq/xpcs/xpcs.h
index fe874f3fb1f4..96ef7c742f04 100644
--- a/drivers/net/ethernet/lantiq/xpcs/xpcs.h
+++ b/drivers/net/ethernet/lantiq/xpcs/xpcs.h
@@ -672,8 +672,7 @@ struct xpcs_mode_cfg {
 /* Port specific XPCS SERDES cfg */
 struct xpcs_serdes_cfg {
 	u32 f_serdes;
-	u32 xpcs_no_phy_cali;
-	u32 rx_rate;
+	u32 no_phy_rx_auto_adapt;
 	u32 afe_en;
 	u32 dfe_en;
 	u32 cont_adapt0;
