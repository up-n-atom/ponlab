From 4f849d820f5705c79cf93c6c2decdaf9c075d6ce Mon Sep 17 00:00:00 2001
From: Rekha Eswaran <rekha.eswaran@intel.com>
Date: Wed, 10 Mar 2021 19:27:54 +0800
Subject: [PATCH] DRV_DPM_SW-478 - Fix dp_deq_port_res_get fail in qos dump
 when dp port range exceeds

---
 drivers/net/datapath/dpm/datapath_proc_qos.c | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/drivers/net/datapath/dpm/datapath_proc_qos.c b/drivers/net/datapath/dpm/datapath_proc_qos.c
index ce6f9959343a..6f57f1670229 100644
--- a/drivers/net/datapath/dpm/datapath_proc_qos.c
+++ b/drivers/net/datapath/dpm/datapath_proc_qos.c
@@ -942,6 +942,8 @@ int proc_qos_dump(struct seq_file *s, int pos)
 {
 	int cnt;
 	int i;
+	int inst = qos_layout_inst;
+	struct inst_info *dp_info = get_dp_prop_info(inst);
 
 	if (!capable(CAP_NET_ADMIN))
 		return -EPERM;
@@ -981,7 +983,7 @@ int proc_qos_dump(struct seq_file *s, int pos)
 		}
 	}
 #endif
-	return ++pos >= 16 ? -1 : pos;
+	return ++pos >=  dp_info->cap.max_num_dp_ports ? -1 : pos;
 }
 
 int proc_qos_init(void)
