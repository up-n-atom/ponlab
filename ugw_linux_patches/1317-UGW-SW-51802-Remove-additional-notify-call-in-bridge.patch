From 7b8e1c36a8ba0841bc8713694ec2b604eb4cb3ee Mon Sep 17 00:00:00 2001
From: gsupriya <supriya1.g@intel.com>
Date: Thu, 9 Jul 2020 13:07:23 +0530
Subject: [PATCH] UGW_SW-51802: Remove additional notify call in bridge add/del
 scenario under MCAST_SNOOPING

---
 net/bridge/br_if.c | 6 ------
 1 file changed, 6 deletions(-)

diff --git a/net/bridge/br_if.c b/net/bridge/br_if.c
index 5021bba8e8f4..fe09bcc2da55 100644
--- a/net/bridge/br_if.c
+++ b/net/bridge/br_if.c
@@ -604,9 +604,6 @@ int br_add_if(struct net_bridge *br, struct net_device *dev)
 
 	kobject_uevent(&p->kobj, KOBJ_ADD);
 
-#ifdef CONFIG_MCAST_SNOOPING
-	br_ifinfo_notify(RTM_NEWLINK, p);
-#endif
 
 	return 0;
 
@@ -659,9 +656,6 @@ int br_del_if(struct net_bridge *br, struct net_device *dev)
 
 	netdev_update_features(br->dev);
 
-#ifdef CONFIG_MCAST_SNOOPING
-	br_ifinfo_notify(RTM_DELLINK, p);
-#endif
 
 	return 0;
 }
