-                                 rw_struct.data[1]) < 0)
+                                 rw_struct.data[1]) != 0)
             	{
                	TRACE (MPS2, DBG_LEVEL_HIGH,
                 	      (KERN_ERR "[%s %s %d]: copy_to_user error\r\n", __FILE__,
@@ -479,7 +479,7 @@ long mps_ioctl (struct file *file_p,
                back! */
             memcpy(rw_struct.data,UserBuf,16);
             if (copy_to_user((void *) arg, &rw_struct,
