+                                 sizeof(mps_message)) != 0)
             {
                TRACE (MPS2, DBG_LEVEL_HIGH,
                       (KERN_ERR "[%s %s %d]: copy_to_user error\r\n", __FILE__,
@@ -497,7 +497,7 @@ long mps_ioctl (struct file *file_p,
          {
             uint32_t UserBuf[16]={0};
             if (copy_from_user(&rw_struct, (void *)arg,
-                                   sizeof(mps_message)) < 0)
+                                   sizeof(mps_message)) != 0)
             {
                TRACE (MPS2, DBG_LEVEL_HIGH,
                       (KERN_ERR "[%s %s %d]: copy_from_user error\r\n",
@@ -525,7 +525,7 @@ long mps_ioctl (struct file *file_p,
             /* copy data to kernelmode buffer and write to mailbox FIFO */
             if (copy_from_user((uint8_t *)rw_struct.data[0],
 				(uint8_t *)UserBuf[0],
-                                rw_struct.data[1]) < 0)
+                                rw_struct.data[1]) != 0)
             {
                TRACE (MPS2, DBG_LEVEL_HIGH,
                       (KERN_ERR "[%s %s %d]: copy_from_user error\r\n",
@@ -539,7 +539,7 @@ long mps_ioctl (struct file *file_p,
                back! */
             memcpy(rw_struct.data,UserBuf,16);
             if (copy_to_user((void *)arg, &rw_struct,
-                                 sizeof(mps_message)) < 0)
+                                 sizeof(mps_message)) != 0)
             {
                TRACE (MPS2, DBG_LEVEL_HIGH,
                       (KERN_ERR "[%s %s %d]: copy_to_user error\r\n", __FILE__,
@@ -556,7 +556,7 @@ long mps_ioctl (struct file *file_p,
          else
          {
             if (copy_to_user((void *) arg, mps_device_version,
-                                 strlen(mps_device_version)) < 0)
+                                 strlen(mps_device_version)) != 0)
             {
                TRACE (MPS2, DBG_LEVEL_HIGH,
                       (KERN_ERR "[%s %s %d]: copy_to_user error\r\n", __FILE__,
