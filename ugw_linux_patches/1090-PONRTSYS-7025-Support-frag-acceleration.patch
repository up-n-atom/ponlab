From 1e4917c1d833ab2be4e26157f144db5e97330779 Mon Sep 17 00:00:00 2001
From: Oren Bakshe <oren.bakshe@intel.com>
Date: Mon, 23 Mar 2020 09:35:06 +0200
Subject: [PATCH] PONRTSYS-7025: Support frag acceleration

---
 drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c      | 12 ++++++------
 .../net/ppv4/pp-api/pp-session-mgr/pp_session_mgr_debugfs.c  |  5 ++---
 2 files changed, 8 insertions(+), 9 deletions(-)

diff --git a/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c b/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c
index 807079a190cf..3eecf67d161c 100644
--- a/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c
+++ b/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c
@@ -595,6 +595,12 @@ static inline bool __smgr_is_frag_supported(struct sess_info *s)
 		return pp_misc_is_nf_en(PP_NF_REASSEMBLY);
 	}
 
+	/* frag acceleration */
+	if (__smgr_is_frag_accl_sess(s)) {
+		/* supported only if reassembly NF is enabled */
+		return pp_misc_is_nf_en(PP_NF_REASSEMBLY);
+	}
+
 	/* outer fragmentation with tunnel encapsulation */
 	if (!pktprs_first_frag(SESS_RX_PKT(s), HDR_OUTER) &&
 	    pktprs_first_frag(SESS_TX_PKT(s), HDR_OUTER)) {
@@ -2715,12 +2721,6 @@ static s32 __smgr_si_mod_info_set(struct sess_info *s)
 		return -EPROTONOSUPPORT;
 	}
 
-	/* @todo remove to enable fragments acceleration */
-	if (__smgr_is_sess_bridged(s) && __smgr_is_frag_accl_sess(s)) {
-		pr_debug("Fragments acceleration isn't implemented yet\n");
-		return -EPROTONOSUPPORT;
-	}
-
 	__smgr_si_l2_mod_set(s);
 	ret = __smgr_si_nat_set(s);
 	if (unlikely(ret))
diff --git a/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr_debugfs.c b/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr_debugfs.c
index cd980b5cc55e..e4fcebfc09da 100644
--- a/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr_debugfs.c
+++ b/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr_debugfs.c
@@ -2282,7 +2282,6 @@ s32 __smgr_reass_stats_show(char *buf, size_t sz, size_t *n, void *s, u32 num,
 		"unsupported",
 		"invalid_len",
 		"dropped",
-		"res",
 	};
 
 	pr_buf(buf, sz, *n, "\n");
@@ -2305,8 +2304,8 @@ s32 __smgr_reass_stats_show(char *buf, size_t sz, size_t *n, void *s, u32 num,
 	for_each_arr_entry(str, cntrs_str, ARRAY_SIZE(cntrs_str), cid++) {
 		pr_buf_cat(buf, sz, *n, "| %-15s ", *str);
 		for_each_arr_entry(it, stats, num) {
-			pr_buf_cat(buf, sz, *n, "| %10u ",
-				   *(((u32 *)it) + cid));
+			pr_buf_cat(buf, sz, *n, "| %10llu ",
+				   *(((u64 *)it) + cid));
 		}
 		pr_buf_cat(buf, sz, *n, "|\n");
 	}
