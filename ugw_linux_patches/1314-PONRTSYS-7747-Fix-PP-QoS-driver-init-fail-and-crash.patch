From 5a0232a9943d1bf6656ed326ddcd3e8b139893b9 Mon Sep 17 00:00:00 2001
From: Emergi Idan <idan.emergi@intel.com>
Date: Mon, 13 Jul 2020 21:52:09 +0300
Subject: [PATCH] PONRTSYS-7747: Fix PP QoS driver init fail and crash

Fix WRED registers base address definition

Signed-off-by: Emergi Idan <idan.emergi@intel.com>
---
 drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_main.c  |  2 --
 drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.c | 40 +++++++++++------------
 drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.h |  6 ++--
 3 files changed, 23 insertions(+), 25 deletions(-)

diff --git a/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_main.c b/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_main.c
index 2898473475d8..44fc371176b7 100644
--- a/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_main.c
+++ b/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_main.c
@@ -22,7 +22,6 @@
 
 static struct pp_qos_dev *qos_devs[PP_QOS_MAX_INSTANCES];
 static spinlock_t drv_lock;
-u64 qos_base_addr;
 u64 qos_wred_base_addr;
 
 /* CREDIT_MAX  = BW Limit Credit max value is (2^21) 2097152 */
@@ -4201,7 +4200,6 @@ s32 qos_dev_init(struct pp_qos_dev *qdev,
 	s32 rc;
 	u32 num_reserved_ports = 0;
 
-	qos_base_addr = conf->qos_uc_base;
 	qos_wred_base_addr = conf->qos_wred_base;
 
 	rc = qos_dev_init_db(qdev, conf->max_ports, conf->max_queues,
diff --git a/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.c b/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.c
index fa8960fca339..3684cfad44ea 100644
--- a/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.c
+++ b/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.c
@@ -393,9 +393,11 @@ static struct pp_syncq *syncq_init(u32 num_syncqs)
 
 static void syncq_clean(struct pp_syncq *syncq)
 {
-	kfree(syncq->phy);
-	kfree(syncq->id);
-	kfree(syncq);
+	if (syncq) {
+		kfree(syncq->phy);
+		kfree(syncq->id);
+		kfree(syncq);
+	}
 }
 
 /******************************************************************************/
@@ -4573,27 +4575,25 @@ void qos_descriptor_pop(struct pp_qos_dev *qdev, u32 queue_id, u32 *descriptor)
 
 static void qos_init_wred_ports_flm(struct pp_qos_dev *qdev)
 {
-	u64 base = qos_base_addr;
 	u32 p;
 
 	for (p = 0; p < qdev->init_params.max_ports; p++) {
-		PP_REG_WR32(base + WRED_PORT_YELLOW_BYTES_COUNTER(p), 0);
-		PP_REG_WR32(base + WRED_PORT_GREEN_BYTES_COUNTER(p), 0);
-		PP_REG_WR32(base + WRED_PORT_YELLOW_THRESHOLD(p), 0);
-		PP_REG_WR32(base + WRED_PORT_GREEN_THRESHOLD(p), 0);
+		PP_REG_WR32(WRED_PORT_YELLOW_BYTES_COUNTER(p), 0);
+		PP_REG_WR32(WRED_PORT_GREEN_BYTES_COUNTER(p), 0);
+		PP_REG_WR32(WRED_PORT_YELLOW_THRESHOLD(p), 0);
+		PP_REG_WR32(WRED_PORT_GREEN_THRESHOLD(p), 0);
 	}
 }
 
 static void qos_init_wred_ports_lgm(struct pp_qos_dev *qdev)
 {
-	u64 base = qos_base_addr;
 	u32 p;
 
 	for (p = 0; p < qdev->init_params.max_ports; p++) {
-		PP_REG_WR32(base + WRED_PORT_YELLOW_BYTES_COUNTER_LGM(p), 0);
-		PP_REG_WR32(base + WRED_PORT_GREEN_BYTES_COUNTER_LGM(p), 0);
-		PP_REG_WR32(base + WRED_PORT_YELLOW_THRESHOLD_LGM(p), 0);
-		PP_REG_WR32(base + WRED_PORT_GREEN_THRESHOLD_LGM(p), 0);
+		PP_REG_WR32(WRED_PORT_YELLOW_BYTES_COUNTER_LGM(p), 0);
+		PP_REG_WR32(WRED_PORT_GREEN_BYTES_COUNTER_LGM(p), 0);
+		PP_REG_WR32(WRED_PORT_YELLOW_THRESHOLD_LGM(p), 0);
+		PP_REG_WR32(WRED_PORT_GREEN_THRESHOLD_LGM(p), 0);
 	}
 }
 
@@ -4608,19 +4608,17 @@ static void qos_init_wred_ports(struct pp_qos_dev *qdev)
 
 static int qos_init_wred_queues(struct pp_qos_dev *qdev)
 {
-	u64 base = qos_base_addr;
 	u32 q;
 
 	pr_info("Init QoS %u queues\n", qdev->init_params.max_queues);
 
 	for (q = 0; q < qdev->init_params.max_queues; q++) {
 		if (IS_ENABLED(CONFIG_PPV4_LGM)) {
-			PP_REG_WR32(base + WRED_QUEUE_TO_PORT_LOOKUP_LGM(q), 0);
-			PP_REG_WR32(base + WRED_Q_SIZE_BYTES_DIRECT_READ_LGM(q),
-				    0);
+			PP_REG_WR32(WRED_QUEUE_TO_PORT_LOOKUP_LGM(q), 0);
+			PP_REG_WR32(WRED_Q_SIZE_BYTES_DIRECT_READ_LGM(q), 0);
 		} else {
-			PP_REG_WR32(base + WRED_QUEUE_TO_PORT_LOOKUP(q), 0);
-			PP_REG_WR32(base + WRED_Q_SIZE_BYTES_DIRECT_READ(q), 0);
+			PP_REG_WR32(WRED_QUEUE_TO_PORT_LOOKUP(q), 0);
+			PP_REG_WR32(WRED_Q_SIZE_BYTES_DIRECT_READ(q), 0);
 		}
 
 		if (IS_ENABLED(CONFIG_PPV4_LGM) &&
@@ -4648,10 +4646,10 @@ static int qos_init_wred_queues(struct pp_qos_dev *qdev)
 	if (IS_ENABLED(CONFIG_PPV4_LGM) &&
 	    pp_silicon_step_get() == PP_SSTEP_B) {
 		/* Initializes all queues (Remove all queues) */
-		PP_REG_WR32(base + WRED_INIT_REG, 1);
+		PP_REG_WR32(WRED_INIT_REG, 1);
 
 		// Wait for init done
-		if (pp_reg_poll(base + WRED_INIT_REG, BIT(31), 1)) {
+		if (pp_reg_poll(WRED_INIT_REG, BIT(31), 1)) {
 			pr_err("WRED init fails\n");
 			return -EIO;
 		}
diff --git a/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.h b/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.h
index db797a5d1aff..66e71b13e270 100644
--- a/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.h
+++ b/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.h
@@ -14,10 +14,12 @@
 #include "pp_qos_uc_defs.h"
 #include "pp_qos_common.h"
 
-extern u64 qos_base_addr;
 extern u64 qos_wred_base_addr;
-#define QOS_BASE_ADDR qos_base_addr
 #define QOS_WRED_BASE_ADDR qos_wred_base_addr
+#ifdef WRED_REG_BASE
+#undef WRED_REG_BASE
+#define WRED_REG_BASE qos_wred_base_addr
+#endif
 
 /******************************************************************************/
 /*                              CONF                                          */
