From 046a15acc212c61931cc50f43425d6c2616983cb Mon Sep 17 00:00:00 2001
From: arathinx <ayyappanx.rathinam@intel.com>
Date: Fri, 23 Oct 2020 19:03:51 +0800
Subject: [PATCH] PONRTSYS-8177: Do not print clk: ljpll5 div is ZERO! as error

---
 drivers/clk/intel/clk-cgu-pll.c | 5 ++---
 1 file changed, 2 insertions(+), 3 deletions(-)

diff --git a/drivers/clk/intel/clk-cgu-pll.c b/drivers/clk/intel/clk-cgu-pll.c
index 9a63d035877d..14217d2e4bf6 100644
--- a/drivers/clk/intel/clk-cgu-pll.c
+++ b/drivers/clk/intel/clk-cgu-pll.c
@@ -276,10 +276,9 @@ prx300_pll_recalc_rate(struct clk_hw *hw, unsigned long prate)
 	unsigned int div, mult, frac;
 
 	prx300_pll_get_params(pll, &mult, &div, &frac);
-	if (!div) {
-		pr_err("clk: %s div is ZERO!\n", clk_hw_get_name(hw));
+	if (!div)
 		div = 1; /* div by zero Error workaround */
-	}
+
 	if (pll->type == TYPE_LJPLL)
 		div *= 4;
 
