From d1ecdb0ce137f13e302c1553080a6e93352d44f5 Mon Sep 17 00:00:00 2001
From: Elad Fernandes <elad.fernandes@intel.com>
Date: Wed, 25 Nov 2020 15:26:51 +0200
Subject: [PATCH] LMTSYS-4320: [PPV4 LGM] enable the ppv4 fsqm init
 configuration by default

---
 drivers/net/ppv4/pp-api/pp-port-mgr/pp_port_mgr.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/drivers/net/ppv4/pp-api/pp-port-mgr/pp_port_mgr.c b/drivers/net/ppv4/pp-api/pp-port-mgr/pp_port_mgr.c
index 67b12dc9ee8b..a67eb4291f5e 100644
--- a/drivers/net/ppv4/pp-api/pp-port-mgr/pp_port_mgr.c
+++ b/drivers/net/ppv4/pp-api/pp-port-mgr/pp_port_mgr.c
@@ -1173,8 +1173,8 @@ static s32 __pmgr_port_tx_cfg_set(u16 pid, struct pp_port_tx_info *tx)
 		return -EINVAL;
 	}
 
-	/* Enable FSQM upon the first port that allows segmentation */
-	if (tx->seg_en && !fsqm_config.enable) {
+	/* Enable FSQM upon the first port */
+	if (!fsqm_config.enable) {
 		fsqm_config.enable = 1;
 		fsqm_config.segmentation_size = RX_DMA_FSQM_DFLT_SEG_SIZE;
 		ret = rx_dma_fsqm_config_set(&fsqm_config);
