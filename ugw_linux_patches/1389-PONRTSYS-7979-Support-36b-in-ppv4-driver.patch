From 98eafc223754ebccf7126942111e426c9d60b3b3 Mon Sep 17 00:00:00 2001
From: Oren Bakshe <oren.bakshe@intel.com>
Date: Tue, 28 Jul 2020 19:02:22 +0300
Subject: [PATCH] PONRTSYS-7979: Support 36b in ppv4 driver

---
 drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c |  4 ++--
 drivers/net/ppv4/pp-hal/checker/checker.c               |  8 ++++----
 drivers/net/ppv4/pp-hal/classifier/classifier.c         | 12 ++++++------
 3 files changed, 12 insertions(+), 12 deletions(-)

diff --git a/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c b/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c
index 526edd328b08..34d4091a0161 100644
--- a/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c
+++ b/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c
@@ -4374,8 +4374,8 @@ static s32 __smgr_db_init(struct pp_smgr_init_param *init_param)
 		return -ENOMEM;
 	}
 
-	pr_debug("inact_map_phys %#x, inact_map_sz %zu\n",
-		 (u32)db->inact_bmap_phys, db->inact_bmap_sz);
+	pr_debug("inact_map_phys %pad, inact_map_sz %zu\n",
+			 &db->inact_bmap_phys, db->inact_bmap_sz);
 
 	/* init all database bitmaps */
 	ret = __smgr_db_maps_init(dev);
diff --git a/drivers/net/ppv4/pp-hal/checker/checker.c b/drivers/net/ppv4/pp-hal/checker/checker.c
index be437f196658..0af8cda827f0 100644
--- a/drivers/net/ppv4/pp-hal/checker/checker.c
+++ b/drivers/net/ppv4/pp-hal/checker/checker.c
@@ -464,8 +464,8 @@ s32 chk_scan_time_get(u32 *n_sessions, u32 *time)
  */
 static inline void __chk_cache_bypass_win_set(dma_addr_t base, size_t sz)
 {
-	pr_debug("base %#x, sz = %zu, (base + sz) = %#x\n", (u32)base, sz,
-		 (u32)base + (u32)sz);
+	pr_debug("base %pad, sz = %zu, (base + sz) = %#llx\n", &base, sz,
+			 (u64)base + (u64)sz);
 	PP_REG_WR32(PP_CNTR_CACHE_BYPASS_WIN_LOW_REG, base >> 4);
 	PP_REG_WR32(PP_CNTR_CACHE_BYPASS_WIN_HIGH_REG, (base + sz) >> 4);
 	PP_REG_WR32(PP_CNTR_CACHE_BYPASS_WIN_VALID_REG, 1);
@@ -481,8 +481,8 @@ s32 chk_crawler_start(u32 base_id, u32 n_sessions, dma_addr_t phy_map,
 
 	it_sz = __chk_roundup_iteration_sz(n_sessions);
 	it_sz = __chk_iteration_sz_to_hw(it_sz);
-	pr_debug("base_id %u, n_sessions %u, db->n_sessions %u, it_sz %u, phy_map %#x, sz %zu\n",
-		 base_id, n_sessions, db->n_sessions, it_sz, (u32)phy_map, sz);
+	pr_debug("base_id %u, n_sessions %u, db->n_sessions %u, it_sz %u, phy_map %pad, sz %zu\n",
+		 base_id, n_sessions, db->n_sessions, it_sz, &phy_map, sz);
 
 	/* prepare the command */
 	cmd = CHK_MBOX_CMD_CRAWLER;
diff --git a/drivers/net/ppv4/pp-hal/classifier/classifier.c b/drivers/net/ppv4/pp-hal/classifier/classifier.c
index f8813eac09db..cf3706f60c2f 100644
--- a/drivers/net/ppv4/pp-hal/classifier/classifier.c
+++ b/drivers/net/ppv4/pp-hal/classifier/classifier.c
@@ -216,23 +216,23 @@ s32 cls_fv_endian_swap_get(bool *in_swap, bool *eg_swap)
 
 void cls_hash1_base_addr_set(u64 ht1_base_addr)
 {
-	pr_debug("set hash1 base address=%u\n",   (u32)ht1_base_addr);
+	pr_debug("set hash1 base address=%#llx\n", ht1_base_addr);
 
-	PP_REG_WR32(PP_CLS_HASH_TABLE_1_BASE_REG, (u32)ht1_base_addr >> 4);
+	PP_REG_WR32(PP_CLS_HASH_TABLE_1_BASE_REG, (u32)(ht1_base_addr >> 4));
 }
 
 void cls_hash2_base_addr_set(u64 ht2_base_addr)
 {
-	pr_debug("set hash2 base address=%u\n",   (u32)ht2_base_addr);
+	pr_debug("set hash2 base address=%#llx\n", ht2_base_addr);
 
-	PP_REG_WR32(PP_CLS_HASH_TABLE_2_BASE_REG, (u32)ht2_base_addr >> 4);
+	PP_REG_WR32(PP_CLS_HASH_TABLE_2_BASE_REG, (u32)(ht2_base_addr >> 4));
 }
 
 void cls_si_base_addr_set(u64 si_base_addr)
 {
-	pr_debug("set si base address=%u\n", (u32)si_base_addr);
+	pr_debug("set si base address=%#llx\n", si_base_addr);
 
-	PP_REG_WR32(PP_CLS_SI_DDR_BASE_REG,  (u32)si_base_addr >> 4);
+	PP_REG_WR32(PP_CLS_SI_DDR_BASE_REG,  (u32)(si_base_addr >> 4));
 }
 
 void cls_sig_cache_long_trans_cntr_thr_set(u64 thr)
