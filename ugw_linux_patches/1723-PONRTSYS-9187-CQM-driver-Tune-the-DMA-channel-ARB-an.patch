From afa674c3355c4e3a680956a218c2233ec5441572 Mon Sep 17 00:00:00 2001
From: kavitha3 <k.subramanian@intel.com>
Date: Tue, 27 Jul 2021 15:56:14 +0800
Subject: [PATCH] PONRTSYS-9187: CQM driver: Tune the DMA channel ARB and non
 ARB polling counters to improve the DS performance

---
 drivers/net/ethernet/lantiq/cqm/prx300/cqm.c | 8 ++------
 1 file changed, 2 insertions(+), 6 deletions(-)

diff --git a/drivers/net/ethernet/lantiq/cqm/prx300/cqm.c b/drivers/net/ethernet/lantiq/cqm/prx300/cqm.c
index df0b35b0490c..44d43f53fb95 100644
--- a/drivers/net/ethernet/lantiq/cqm/prx300/cqm.c
+++ b/drivers/net/ethernet/lantiq/cqm/prx300/cqm.c
@@ -2545,7 +2545,7 @@ static int fill_rx_ring_data(struct cbm_dp_alloc_complete_data *dp_data)
 					__func__);
 				break;
 			}
-			ltq_dma_chan_polling_cfg(p_info->dma_ch, 10, 10);
+			ltq_dma_chan_polling_cfg(p_info->dma_ch, 6, 6);
 
 			p_info->deq_info.desc_phy_base =
 				(void *)ltq_dma_chan_get_desc_phys_base(p_info->
@@ -4273,8 +4273,6 @@ static void init_cqm_enq_cpu_port(int idx)
 static s32 setup_DMA_channel(int chan, int cqm_port, dma_addr_t desc_base,
 			     int buf_type, int desc_num, char *dev_id)
 {
-	int ctrl;
-
 	if (ltq_request_dma(chan, dev_id) < 0) {
 		dev_err(cqm_ctrl->dev, "%s failed to open chan for chan%d\r\n",
 			__func__, chan);
@@ -4291,9 +4289,7 @@ static s32 setup_DMA_channel(int chan, int cqm_port, dma_addr_t desc_base,
 			__func__, chan);
 		return CBM_FAILURE;
 	}
-	ctrl = _DMA_CONTROLLER(chan);
-	if (ctrl == DMA1TX)
-		ltq_dma_chan_polling_cfg(chan, 10, 10);
+	ltq_dma_chan_polling_cfg(chan, 6, 6);
 	/* Channel on */
 	if (ltq_dma_chan_on(chan) < 0) {
 		dev_err(cqm_ctrl->dev, " %s failed to ON chan%d\r\n",
