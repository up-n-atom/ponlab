From 2e7fde5eb4490b23095739eeb7bbbb689fcca5d1 Mon Sep 17 00:00:00 2001
From: Oren Bakshe <oren.bakshe@intel.com>
Date: Thu, 26 Mar 2020 15:50:00 +0200
Subject: [PATCH] PONRTSYS-7025: Fix BP indication

---
 .../net/ppv4/pp-api/pp-qos-mgr/pp_qos_debugfs.c    | 19 ++++++++++++++++
 drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_fw.c     | 25 ++++++++++++++++++++++
 .../net/ppv4/pp-api/pp-qos-mgr/pp_qos_uc_defs.h    | 14 ++++++++++--
 3 files changed, 56 insertions(+), 2 deletions(-)

diff --git a/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_debugfs.c b/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_debugfs.c
index 9771770baac3..1e5e21775f88 100644
--- a/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_debugfs.c
+++ b/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_debugfs.c
@@ -2263,6 +2263,25 @@ void pp_qos_dbg_system_stats_show(struct seq_file *s)
 			   sys_stats.wred_last_pop_info_pkt_size);
 	}
 #endif
+
+	seq_printf(s, "txmgr_bp_status_ports_0_31: %#x\n",
+		   sys_stats.txmgr_bp_status_ports_0_31);
+	seq_printf(s, "txmgr_bp_status_ports_32_63: %#x\n",
+		   sys_stats.txmgr_bp_status_ports_32_63);
+	seq_printf(s, "txmgr_bp_status_ports_64_95: %#x\n",
+		   sys_stats.txmgr_bp_status_ports_64_95);
+	seq_printf(s, "txmgr_bp_status_ports_96_127: %#x\n",
+		   sys_stats.txmgr_bp_status_ports_96_127);
+#if IS_ENABLED(CONFIG_PPV4_LGM)
+	seq_printf(s, "txmgr_bp_status_ports_128_159: %#x\n",
+		   sys_stats.txmgr_bp_status_ports_128_159);
+	seq_printf(s, "txmgr_bp_status_ports_160_191: %#x\n",
+		   sys_stats.txmgr_bp_status_ports_160_191);
+	seq_printf(s, "txmgr_bp_status_ports_192_223: %#x\n",
+		   sys_stats.txmgr_bp_status_ports_192_223);
+	seq_printf(s, "txmgr_bp_status_ports_224_255: %#x\n",
+		   sys_stats.txmgr_bp_status_ports_224_255);
+#endif
 }
 
 PP_DEFINE_DEBUGFS(system_stats, pp_qos_dbg_system_stats_show, NULL);
diff --git a/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_fw.c b/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_fw.c
index 5c11918a8997..727445be0166 100644
--- a/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_fw.c
+++ b/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_fw.c
@@ -2993,6 +2993,31 @@ static s32 post_process_external(struct pp_qos_dev *qdev,
 
 		sys_stats->wred_last_pop_info_pkt_size =
 		sys_stats_ptr->wred_last_pop_info_pkt_size;
+#endif
+		sys_stats->txmgr_bp_status_ports_0_31 =
+		sys_stats_ptr->txmgr_bp_status_ports_0_31;
+
+		sys_stats->txmgr_bp_status_ports_32_63 =
+		sys_stats_ptr->txmgr_bp_status_ports_32_63;
+
+		sys_stats->txmgr_bp_status_ports_64_95 =
+		sys_stats_ptr->txmgr_bp_status_ports_64_95;
+
+		sys_stats->txmgr_bp_status_ports_96_127 =
+		sys_stats_ptr->txmgr_bp_status_ports_96_127;
+
+#if IS_ENABLED(CONFIG_PPV4_LGM)
+		sys_stats->txmgr_bp_status_ports_128_159 =
+		sys_stats_ptr->txmgr_bp_status_ports_128_159;
+
+		sys_stats->txmgr_bp_status_ports_160_191 =
+		sys_stats_ptr->txmgr_bp_status_ports_160_191;
+
+		sys_stats->txmgr_bp_status_ports_192_223 =
+		sys_stats_ptr->txmgr_bp_status_ports_192_223;
+
+		sys_stats->txmgr_bp_status_ports_224_255 =
+		sys_stats_ptr->txmgr_bp_status_ports_224_255;
 #endif
 		break;
 
diff --git a/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_uc_defs.h b/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_uc_defs.h
index a519c573bd27..b134da395378 100644
--- a/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_uc_defs.h
+++ b/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_uc_defs.h
@@ -11,8 +11,8 @@
 
 /* UC version */
 #define UC_VERSION_MAJOR (1)
-#define UC_VERSION_MINOR (11)
-#define UC_VERSION_BUILD (2)
+#define UC_VERSION_MINOR (12)
+#define UC_VERSION_BUILD (0)
 
 #define QOS_MAX_PREDECESSORS        (6)
 #define QOS_AQM_CONTEXT_MAX_QUEUES  (8)
@@ -574,6 +574,16 @@ struct system_stats_s {
 
 	/* WRED last pop info packet size - LGM B step */
 	u32 wred_last_pop_info_pkt_size;
+
+	/* TX Manager BP status per port words 0-7 */
+	u32 txmgr_bp_status_ports_0_31;
+	u32 txmgr_bp_status_ports_32_63;
+	u32 txmgr_bp_status_ports_64_95;
+	u32 txmgr_bp_status_ports_96_127;
+	u32 txmgr_bp_status_ports_128_159; /* LGM only */
+	u32 txmgr_bp_status_ports_160_191; /* LGM only */
+	u32 txmgr_bp_status_ports_192_223; /* LGM only */
+	u32 txmgr_bp_status_ports_224_255; /* LGM only */
 } __attribute__((packed));
 
 /**************************************************************************
