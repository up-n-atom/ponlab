From bec90d0d8fd25e10ce01897ee9fc9b78faf0ab99 Mon Sep 17 00:00:00 2001
From: Robert Dabrowski <rdabrowski@maxlinear.com>
Date: Wed, 19 May 2021 09:55:25 +0200
Subject: [PATCH] PONRTSYS-8931: Add error code to indicate multicast
 forwarding table entry not found

---
 drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c | 8 ++++++--
 drivers/net/ethernet/lantiq/switch-api/gsw_swmcast.c   | 2 +-
 include/net/switch_api/lantiq_gsw.h                    | 2 ++
 3 files changed, 9 insertions(+), 3 deletions(-)

diff --git a/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c b/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c
index c298af46507b..f7bf49060c48 100644
--- a/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c
+++ b/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c
@@ -11976,8 +11976,12 @@ GSW_return_t GSW_MulticastTableEntryRemove(void *cdev,
 			ret = gsw_remove_hashtable_entry(cdev, parm);
 
 			if (ret < 0) {
-				pr_debug("%s:%s Entry Cannot remove :%d %d\n", __FILE__, __func__, __LINE__, ret);
-				ret = GSW_statusErr;
+				pr_debug("%s:%s Entry Cannot remove :%d %d\n",
+					 __FILE__, __func__, __LINE__, ret);
+				if (ret == ENTRY_CANNOT_REMOVE)
+					ret = GSW_statusEntryNotFound;
+				else
+					ret = GSW_statusErr;
 				goto UNLOCK_AND_RETURN;
 			}
 		} else
diff --git a/drivers/net/ethernet/lantiq/switch-api/gsw_swmcast.c b/drivers/net/ethernet/lantiq/switch-api/gsw_swmcast.c
index 6495ea897070..5c9d5248fcf6 100644
--- a/drivers/net/ethernet/lantiq/switch-api/gsw_swmcast.c
+++ b/drivers/net/ethernet/lantiq/switch-api/gsw_swmcast.c
@@ -720,7 +720,7 @@ int gsw_remove_hashtable_entry(void *cdev, GSW_multicastTable_t *parm)
 
 	if (gswdev == NULL) {
 		pr_err("%s:%s:%d", __FILE__, __func__, __LINE__);
-		return GSW_statusErr;
+		return FAIL;
 	}
 
 	if (parm->nPortId > gswdev->num_of_bridge_port) {
diff --git a/include/net/switch_api/lantiq_gsw.h b/include/net/switch_api/lantiq_gsw.h
index 0cb3a8ef6cd0..b96e0fa17b2d 100644
--- a/include/net/switch_api/lantiq_gsw.h
+++ b/include/net/switch_api/lantiq_gsw.h
@@ -2547,6 +2547,8 @@ typedef enum {
 	GSW_statusMAC_TableFull	= -11,
 	/** Locking failed - SWAPI is busy */
 	GSW_statusLock_Failed	=  -12,
+	/** Multicast Forwarding table entry not found */
+	GSW_statusEntryNotFound = -13,
 	/** Generic or unknown error occurred */
 	GSW_statusErr	= -1
 } GSW_return_t;
