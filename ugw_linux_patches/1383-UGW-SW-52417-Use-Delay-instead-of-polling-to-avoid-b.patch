From 5fa94c01934b3d1fa7289991bbbd9c92afbb763a Mon Sep 17 00:00:00 2001
From: radhak4x <radha.ravipatix.krishna@intel.com>
Date: Wed, 9 Sep 2020 14:42:25 +0530
Subject: [PATCH] UGW_SW-52417: Use Delay instead of polling to avoid bus error
 in case of dma reset

---
 drivers/dma/intel/hdma.c | 12 ++----------
 1 file changed, 2 insertions(+), 10 deletions(-)

diff --git a/drivers/dma/intel/hdma.c b/drivers/dma/intel/hdma.c
index 044a4a8c52d7..7bf3a29d7814 100755
--- a/drivers/dma/intel/hdma.c
+++ b/drivers/dma/intel/hdma.c
@@ -411,16 +411,8 @@ static void dma_ctrl_reset(struct dma_ctrl *pctrl)
 	ltq_dma_w32_mask(pctrl, 0, DMA_CTRL_RST, DMA_CTRL);
 	spin_unlock_irqrestore(&pctrl->ctrl_lock, flags);
 
-	/*
-	 * Delay maximum 10ms after reset to allow DMA logic to quiesce.
-	 * Do a polled read up to 1ms and 10ms maximum.
-	 */
-	ret = readl_poll_timeout(pctrl->membase + DMA_CTRL, val,
-				!(val & DMA_CTRL_RST), 1000, 10000);
-
-	if (ret)
-		dev_err(pctrl->dev, "%s controller reset timeout!\n",
-			pctrl->name);
+	/* delay 1ms to 2 ms */
+	usleep_range(1000, 2000);
 }
 
 /* DMA controller related configuration */
