+static void dump_rx_pmac(struct pmac_rx_hdr *pmac)
+{
+	int i, l;
+	unsigned char *p = (char *)pmac;
+	unsigned char buf[100];
+
+	if (!pmac) {
+		pr_err("%s: pmac NULL ??\n", __func__);
+		return;
+	}
+
+	l = sprintf(buf, "PMAC at 0x%px: ", p);
+	for (i = 0; i < 8; i++)
+		l += sprintf(buf + l, "0x%02x ", p[i]);
+	l += sprintf(buf + l, "\n");
+	pr_info("%s", buf);
+
+	/*byte 0 */
+	pr_info("  byte 0:%s=%d %s=%d\n",
+		"ver_done", pmac->ver_done,
+		"ip_offset", pmac->ip_offset);
+	/*byte 1 */
+	pr_info("  byte 1:%s=%d %s=%d\n",
+		"tcp_h_offset", pmac->tcp_h_offset,
+		"tcp_type", pmac->tcp_type);
+	/*byte 2 */
+	pr_info("  byte 2:%s=%d %s=%d %s=%d\n",
+		"class", pmac->class,
+		"res", pmac->res2,
+		"src_dst_subif_id_14_12", pmac->src_dst_subif_id_14_12);
+	/*byte 3 */
+	pr_info("  byte 3:%s=%d %s=%d %s=%d %s=%d %s=%d %s=%d\n",
+		"pkt_type", pmac->pkt_type,
+		"ext", pmac->ext,
+		"ins", pmac->ins,
+		"pre_12", pmac->pre_l2,
+		"oam", pmac->oam,
+		"res32", pmac->res32);
+	/*byte 4 */
+	pr_info("  byte 4:%s=%d %s=%d %s=%d %s=%d\n",
+		"fcs", pmac->fcs,
+		"ptp", pmac->ptp,
+		"one_step", pmac->one_step,
+		"src_dst_subif_id_msb", pmac->src_dst_subif_id_msb);
+	/*byte 5 */
+	pr_info("  byte 5:src_sub_inf_id2=%d\n", pmac->src_dst_subif_id_lsb);
+	/*byte 6 */
+	pr_info("  byte 6:record_id_msb=%d\n", pmac->record_id_msb);
+	/*byte 7 */
+	pr_info("  byte 7:record_id_lsb=%d igp_egp=%d\n",
+		pmac->record_id_lsb, pmac->igp_egp);
+}
