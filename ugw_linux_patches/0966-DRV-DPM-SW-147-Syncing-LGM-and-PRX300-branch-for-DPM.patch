+static inline int is_invalid_port(u32 port_id)
+{
+	if (port_id >= MAX_DP_PORTS || port_id < 0) {
+		pr_err("port_id(%d) should be with 0 - %d\n", port_id,
+		       MAX_DP_PORTS);
+		return -1;
+	} else {
+		return 0;
+	}
+}
+
+static inline int is_invalid_inst(u32 inst)
+{
+	if (inst < 0 || inst >= DP_MAX_INST) {
+		pr_err("inst(%d) should be with 0 - %d\n", inst,
+		       DP_MAX_INST);
+		return -1;
+	} else {
+		return 0;
+	}
+}
+
+static inline bool is_stream_port(int flags)
+{
+	return !!(flags & (DP_F_FAST_ETH_LAN | DP_F_FAST_ETH_WAN | DP_F_GINT |
+			   DP_F_GPON | DP_F_EPON));
+}
