-			break;	/* '\0' was seen by inet_pton4(). */
-		}
-		return 0;
-	}
-	if (saw_xdigit) {
-		if (tp + NS_INT16SZ > endp)
-			return 0;
-		*tp++ = (u_char)(val >> 8) & 0xff;
-		*tp++ = (u_char)val & 0xff;
