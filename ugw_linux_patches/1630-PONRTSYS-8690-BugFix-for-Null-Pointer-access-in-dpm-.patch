From 0d2f91154d082f1c4e0152b485643279761ded72 Mon Sep 17 00:00:00 2001
From: thampan <joby.thampan@intel.com>
Date: Thu, 18 Mar 2021 15:09:01 +0800
Subject: [PATCH] PONRTSYS-8690: BugFix for Null Pointer access in dpm proc for
 struct module

---
 drivers/net/datapath/dpm/datapath_proc.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/net/datapath/dpm/datapath_proc.c b/drivers/net/datapath/dpm/datapath_proc.c
index 253fd6bcff84..744fcb33b937 100644
--- a/drivers/net/datapath/dpm/datapath_proc.c
+++ b/drivers/net/datapath/dpm/datapath_proc.c
@@ -669,7 +669,7 @@ int proc_port_dump(struct seq_file *s, int pos)
 
 	seq_printf(s, "%02d:%s=0x%0lx(%s:%8s) %s=%02d %s=%02d %s=%d(%s) %s=%d\n",
 		   pos, "module", (uintptr_t)port->owner,
-		   "name", port->owner->name,
+		   "name", module_name(port->owner),
 		   "dev_port", port->dev_port,
 		   "dp_port", port->port_id,
 		   "itf_base", start,
