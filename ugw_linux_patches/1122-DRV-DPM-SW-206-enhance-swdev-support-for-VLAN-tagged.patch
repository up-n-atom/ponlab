+/* this API handles de-registration of vlan device created during add_if */
+static int dp_del_swdev_reg_vlan(struct bridge_id_entry_item *br_item,
+				 struct net_device *dev, u8 *addr)
+{
+	struct net_device *base;
+	dp_subif_t subif = {0};
+	struct pmac_port_info *p_info;
+
+	if (br_item) {
+		swdev_lock();
+		dp_swdev_clr_gswip_cfg(br_item, addr);
+		/* De-Register Logical Dev i.e. VLAN DEV
+		 * if it is registered
+		 */
+		if (!(br_item->flags & LOGIC_DEV_REGISTER)) {
+			swdev_unlock();
+			return 0;
+		}
+		base = get_base_dev(dev, -1);
+		DP_DEBUG(DP_DBG_FLAG_SWDEV, "base dev name:%s\n",
+			 base ? base->name : "NULL");
+		if (!base)
+			base = dev;
+		dp_swdev_cfg_vlan(br_item, dev);
+		swdev_unlock();
+		if (dp_get_netif_subifid(base, NULL, NULL,
+					NULL, &subif, 0)) {
+			pr_err("dp_get_netif_subifid fail:%s(%s)\n",
+			       base->name, __func__);
+			/*Cannot Return -EOPNOTSUPP
+			 * in swdev commit stage
+			 */
+			return 0;
+		}
+		p_info = get_dp_port_info(subif.inst, subif.port_id);
+		if (dp_register_subif(p_info->owner, dev, dev->name,
+				      &subif, DP_F_DEREGISTER)) {
+			pr_err("dp_register_subif fail: %s(%s)\n",
+			       dev->name, __func__);
+			/* Cannot Return -EOPNOTSUPP
+			 * in swdev commit stage
+			 */
+			return 0;
+		}
+	}
+	return 0;
+}
