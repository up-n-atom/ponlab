From ae22dca23b60cc47ab1a9570095e95215447413d Mon Sep 17 00:00:00 2001
From: ofirbitt <ofir1.bitton@intel.com>
Date: Mon, 23 Mar 2020 14:56:51 +0200
Subject: [PATCH] PONRTSYS-6779: PPv4 QoS spinlock to bh

---
 drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_common.h | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_common.h b/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_common.h
index ec8763785706..5c176d9c00e1 100644
--- a/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_common.h
+++ b/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_common.h
@@ -46,8 +46,8 @@
 /* Locking */
 #define LOCK spinlock_t
 #define QOS_LOCK_INIT(qdev)      spin_lock_init(&qdev->lock)
-#define QOS_LOCK(qdev)           spin_lock(&qdev->lock)
-#define QOS_UNLOCK(qdev)         spin_unlock(&qdev->lock)
+#define QOS_LOCK(qdev)           spin_lock_bh(&qdev->lock)
+#define QOS_UNLOCK(qdev)         spin_unlock_bh(&qdev->lock)
 #define QOS_SPIN_IS_LOCKED(qdev) spin_is_locked(&qdev->lock)
 
 #define PPV4_QOS_CMD_BUF_OFFSET        (0x4000U)
