From 909af80c9bcdf5f573ad6f700f2ff422e88daaff Mon Sep 17 00:00:00 2001
From: Rekha Eswaran <rekha.eswaran@intel.com>
Date: Wed, 11 Nov 2020 11:30:22 +0800
Subject: [PATCH] DRV_DPM_SW-407 - DP Fix to solve more add notifier than
 remove using dp_update_subif_info(PONRTSYS-8221)

---
 drivers/net/datapath/dpm/datapath.h      |  2 +-
 drivers/net/datapath/dpm/datapath_api.c  | 14 +++++---
 drivers/net/datapath/dpm/datapath_misc.c | 60 +++++++++++++++++++++-----------
 3 files changed, 51 insertions(+), 25 deletions(-)

diff --git a/drivers/net/datapath/dpm/datapath.h b/drivers/net/datapath/dpm/datapath.h
index 5a12d8957093..dceca3c58b6b 100644
--- a/drivers/net/datapath/dpm/datapath.h
+++ b/drivers/net/datapath/dpm/datapath.h
@@ -1008,7 +1008,7 @@ int32_t dp_sync_subifid(struct net_device *dev, char *subif_name,
 int32_t dp_sync_subifid_priv(struct net_device *dev, char *subif_name,
 			     dp_subif_t *subif_id, struct dp_subif_data *data,
 			     u32 flags, dp_get_netif_subifid_fn_t subifid_fn,
-			     int *f_subif_up);
+			     int *f_subif_up, int f_notif);
 int32_t	dp_update_subif(struct net_device *netif, void *data, dp_subif_t *subif,
 			char *subif_name, u32 flags,
 			dp_get_netif_subifid_fn_t subifid_fn);
diff --git a/drivers/net/datapath/dpm/datapath_api.c b/drivers/net/datapath/dpm/datapath_api.c
index 26ac81c47900..48a3043af7f5 100644
--- a/drivers/net/datapath/dpm/datapath_api.c
+++ b/drivers/net/datapath/dpm/datapath_api.c
@@ -1018,6 +1018,7 @@ int32_t dp_update_subif_info(struct dp_subif_upd_info *info)
 	struct dp_dev *dp_dev;
 	int vap, bp = 0, fid = 0, res = DP_FAILURE;
 	int f_new_subif = -1, f_old_subif = -1, f_rem_old_dev = 0;
+	int f_rem_old_ctp_dev = 0, f_notif = 1;
 	struct net_device *old_dev, *old_ctp_dev;
 	struct bp_pmapper *bp_info;
 	dp_subif_t *new_subif_id_sync, *old_subif_id_sync;
@@ -1050,7 +1051,7 @@ int32_t dp_update_subif_info(struct dp_subif_upd_info *info)
 	old_ctp_dev = sif->ctp_dev;
 	DP_DEBUG(DP_DBG_FLAG_REG, "%s:%s%s %s%s %s=0x%x(%d)\n",
 		 "update_subif", "new_dev=", info->new_dev->name,
-		 "net_ctp_dev=", info->new_ctp_dev->name, "subif",
+		 "new_ctp_dev=", info->new_ctp_dev->name, "subif",
 		 info->subif, vap);
 
 	DP_LIB_LOCK(&dp_lock);
@@ -1124,9 +1125,12 @@ int32_t dp_update_subif_info(struct dp_subif_upd_info *info)
 			dp_notifier_invoke(info->inst,
 					   old_ctp_dev, info->dp_port, info->subif,
 					   DP_EVENT_DE_REGISTER_SUBIF);
+			f_rem_old_ctp_dev = 1;
 		}
 		old_data.ctp_dev = old_ctp_dev;
 	}
+	if ((!f_rem_old_dev) && (!f_rem_old_ctp_dev))
+		f_notif = 0;
 	/* remove old dev */
 	if ((!bp_info->ref_cnt) && (f_rem_old_dev)) {
 		DP_DEBUG(DP_DBG_FLAG_REG,
@@ -1204,7 +1208,8 @@ int32_t dp_update_subif_info(struct dp_subif_upd_info *info)
 
 	/* remove old rcu info based on collected subif info */
 	res = dp_sync_subifid_priv(old_dev, NULL, old_subif_id_sync, &old_data,
-				   DP_F_DEREGISTER, subifid_fn, &f_old_subif);
+				   DP_F_DEREGISTER, subifid_fn, &f_old_subif,
+				   f_notif);
 	if (res) {
 		pr_err("remove old dev from rcu fail(%s)\n",
 		       old_dev->name ? old_dev->name : "NULL");
@@ -1214,7 +1219,8 @@ int32_t dp_update_subif_info(struct dp_subif_upd_info *info)
 	}
 	/* update rcu info based on new subif info */
 	res = dp_sync_subifid_priv(info->new_dev, NULL, new_subif_id_sync,
-				   &new_data, 0, subifid_fn, &f_new_subif);
+				   &new_data, 0, subifid_fn, &f_new_subif,
+				   f_notif);
 	if (res) {
 		pr_err("update new dev into rcu fail(%s)\n",
 		       info->new_dev->name ? info->new_dev->name : "NULL");
@@ -1599,7 +1605,7 @@ int32_t dp_register_subif_ext(int inst, struct module *owner,
 	DP_LIB_UNLOCK(&dp_lock);
 	if (!res)
 		res = dp_sync_subifid_priv(dev, subif_name, subif_id_sync, data,
-					   flags, subifid_fn, &f_subif);
+					   flags, subifid_fn, &f_subif, 1);
 	devm_kfree(&g_dp_dev->dev, subif_id_sync);
 EXIT:
 	if (unlikely(res)) {
diff --git a/drivers/net/datapath/dpm/datapath_misc.c b/drivers/net/datapath/dpm/datapath_misc.c
index 8cf4d4f6b8d6..107e2c307141 100644
--- a/drivers/net/datapath/dpm/datapath_misc.c
+++ b/drivers/net/datapath/dpm/datapath_misc.c
@@ -933,13 +933,16 @@ int32_t dp_del_subif(struct net_device *netif, void *data, dp_subif_t *subif,
 	idx = dp_subif_hash(netif);
 	dp_subif = dp_subif_lookup_safe(&dp_subif_list[idx], netif, data);
 	if (!dp_subif) {
-		pr_err("Failed dp_subif_lookup: %s\n",
+		pr_err("%s:Failed dp_subif_lookup: %s\n", __func__,
 		       netif ? netif->name : "NULL");
 		return -1;
 	}
 	hlist_del_rcu(&dp_subif->hlist);
 	call_rcu_bh(&dp_subif->rcu, dp_subif_reclaim);
-	return 1;
+	DP_DEBUG(DP_DBG_FLAG_REG,
+		 "%s:deleted dev %s from rcu subif\n", __func__,
+		 netif ? netif->name : "NULL");
+	return 0;
 }
 
 int32_t dp_update_subif(struct net_device *netif, void *data,
@@ -963,6 +966,9 @@ int32_t dp_update_subif(struct net_device *netif, void *data,
 				sizeof(dp_subif->name) - 1);
 		dp_subif->subif_fn = subifid_fn_t;
 		hlist_add_head_rcu(&dp_subif->hlist, &dp_subif_list[idx]);
+		DP_DEBUG(DP_DBG_FLAG_REG,
+			 "%s:added dev %s to rcu subif\n", __func__,
+			 netif ? netif->name : "NULL");
 	} else {
 		dp_subif_new = kmem_cache_zalloc(cache_subif_list, GFP_ATOMIC);
 		if (!dp_subif_new)
@@ -977,6 +983,9 @@ int32_t dp_update_subif(struct net_device *netif, void *data,
 		hlist_replace_rcu(&dp_subif->hlist,
 				  &dp_subif_new->hlist);
 		call_rcu_bh(&dp_subif->rcu, dp_subif_reclaim);
+		DP_DEBUG(DP_DBG_FLAG_REG,
+			 "%s:updated dev %s to rcu subif\n", __func__,
+			 netif ? netif->name : "NULL");
 	}
 	return 0;
 }
@@ -1014,8 +1023,8 @@ int32_t dp_sync_subifid(struct net_device *dev, char *subif_name,
 					      subif_data, NULL,
 					      &subif_id[0], 0);
 		if (res) {
-			pr_err("dp_get_netif_subif_priv fail (%s)(err:%d)\n",
-			       dev->name ? dev->name : "NULL", res);
+			pr_err("%s:dp_get_netif_subif_priv fail (%s)(err:%d)\n",
+			       __func__, dev->name ? dev->name : "NULL", res);
 			return res;
 		}
 		if (data && data->ctp_dev) {
@@ -1039,7 +1048,7 @@ int32_t dp_sync_subifid(struct net_device *dev, char *subif_name,
 int32_t dp_sync_subifid_priv(struct net_device *dev, char *subif_name,
 			     dp_subif_t *subif_id, struct dp_subif_data *data,
 			     u32 flags, dp_get_netif_subifid_fn_t subifid_fn,
-			     int *f_subif_up)
+			     int *f_subif_up, int f_notif)
 {
 	void *subif_data = NULL;
 	struct pmac_port_info *port;
@@ -1057,35 +1066,46 @@ int32_t dp_sync_subifid_priv(struct net_device *dev, char *subif_name,
 	/*check flag for register / deregister to update/del */
 	if (flags & DP_F_DEREGISTER) {
 		if (data && data->ctp_dev)
-			dp_del_subif(data->ctp_dev, subif_data, &subif_id[1],
-				     NULL, flags);
+			if (dp_del_subif(data->ctp_dev, subif_data,
+					 &subif_id[1], NULL, flags))
+				return DP_FAILURE;
 
-		if (*f_subif_up == 0)
-			dp_del_subif(dev, subif_data, &subif_id[0], subif_name,
-				     flags);
-		else if (*f_subif_up == 1)
-			dp_update_subif(dev, subif_data, &subif_id[0],
-					subif_name, flags, subifid_fn);
+		if (*f_subif_up == 1) {
+			if (dp_update_subif(dev, subif_data, &subif_id[0],
+					    subif_name, flags, subifid_fn))
+				return DP_FAILURE;
+		} else {
+			if (dp_del_subif(dev, subif_data, &subif_id[0],
+					 subif_name, flags))
+				return DP_FAILURE;
+		}
 	} else {
 		if (*f_subif_up == 1) {
 			dp_update_subif(dev, subif_data, &subif_id[0],
 					subif_name, flags, subifid_fn);
 
-			if (get_dp_bp_info(0, subif_id->bport)->ref_cnt <= 1)
-				dp_notifier_invoke(0, dev, subif_id->port_id, subif_id->subif,
+			if ((get_dp_bp_info(0, subif_id->bport)->ref_cnt <= 1)
+				&& (f_notif))
+				dp_notifier_invoke(0, dev, subif_id->port_id,
+						   subif_id->subif,
 						   DP_EVENT_REGISTER_SUBIF);
 
 			if (data && data->ctp_dev) {
-				dp_update_subif(data->ctp_dev, subif_data,
-						&subif_id[1], NULL, flags,
-						subifid_fn);
+				if (dp_update_subif(data->ctp_dev, subif_data,
+						    &subif_id[1], NULL, flags,
+						    subifid_fn))
+					return DP_FAILURE;
+				if (!f_notif)
+					goto exit;
 				dp_notifier_invoke(0, data->ctp_dev,
-						   subif_id->port_id, subif_id->subif,
+						   subif_id->port_id,
+						   subif_id[1].subif,
 						   DP_EVENT_REGISTER_SUBIF);
 			}
 		}
 	}
-	return 0;
+exit:
+	return DP_SUCCESS;
 }
 
 #if IS_ENABLED(CONFIG_INTEL_DATAPATH_CPUFREQ)
