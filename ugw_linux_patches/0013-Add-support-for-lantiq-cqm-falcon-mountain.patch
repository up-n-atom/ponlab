+	for (i = 0; i < 8; i++) {
+		tmp4 = i * 16;
+		PRINTK("Name: DESC0_%d_PON_EGP_%02d\n", i, j);
+		PRINTK("Addr: 0x%8p\n",
+		       deq_base + desc0 + (tmp4) + tmp2);
+		PRINTK("Val:  0x%08x\n",
+		       cbm_r32(deq_base + desc0 + (tmp4) + tmp2));
+		PRINTK("Name: DESC1_%d_PON_EGP_%02d\n", i, j);
