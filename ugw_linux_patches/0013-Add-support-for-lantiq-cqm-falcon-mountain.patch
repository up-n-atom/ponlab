+	qidt_elm.flowidh = entry->flowid >> 1;
+	qidt_elm.sub_if_id = entry->sub_if_id;
+
+	if (flags & CBM_QUEUE_MAP_F_FLOWID_L_DONTCARE)
+		qidt_mask.flowid_lmask = 1;
+	if (flags & CBM_QUEUE_MAP_F_FLOWID_H_DONTCARE)
