+		print_reg("IGP_IRNEN\n", c_base + CQM_INT_LINE(i, igp_irnen));
+		print_reg("EGP_IRNCR\n", c_base + CQM_INT_LINE(i, egp_irncr));
+		print_reg("EGP_IRNEN\n", c_base + CQM_INT_LINE(i, egp_irnen));
