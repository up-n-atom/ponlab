+static inline void add_metadata(u8 *v_buf_addr, u32 pool,
+				u32 policy)
+{
+	(v_buf_addr)[0] = 0xde;
+	(v_buf_addr)[1] = pool;
+	(v_buf_addr)[2] = policy;
