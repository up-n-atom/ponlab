+static int get_metadata(u8 *v_buf_addr, int *pool, int *policy)
+{
+	if (((v_buf_addr)[0] == 0xde) &&
+	    ((v_buf_addr)[3] == 0xad)) {
+		*pool = (v_buf_addr)[1];
+		*policy = (v_buf_addr)[2];
+		return CBM_SUCCESS;
+	}
+	dev_err(cqm_ctrl->dev, "Invalid METADATA\n");
+	return CBM_FAILURE;
+}
