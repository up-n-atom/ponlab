 				(node->data.queue.alias_master_id == PP_QOS_INVALID_ID)
 				? 0 : 1;
@@ -1102,14 +1100,13 @@ void create_set_queue_cmd(
 		struct pp_qos_dev *qdev,
 		const struct pp_qos_queue_conf *conf,
 		unsigned int phy,
