+#define create_set_queue_cmd(qdev, conf, phy, node, modified)\
 	QOS_LOG_DEBUG("SET QUEUE: %u\n", phy)
 #define create_remove_node_cmd(qdev, type, phy, data)\
 	QOS_LOG_DEBUG("REMOVE: %u(%u)\n", phy, type)
@@ -146,8 +147,8 @@ void create_get_sys_info_cmd(struct pp_qos_dev *qdev,
 #else
 #define create_move_cmd(qdev, dst, src, dst_port)
 #define create_set_port_cmd(qdev, conf, phy, modified)
-#define create_set_sched_cmd(qdev, conf, phy, parent, modified)
-#define create_set_queue_cmd(qdev, conf, phy, parent, rlm, modified)
+#define create_set_sched_cmd(qdev, conf, phy, node, modified)
+#define create_set_queue_cmd(qdev, conf, phy, node, modified)
 #define create_remove_node_cmd(qdev, type, phy, data)
 #define create_parent_change_cmd(qdev, phy)
 #define create_update_preds_cmd(qdev, phy, queue_port_changed)
diff --git a/drivers/net/ethernet/lantiq/ppv4/qos/pp_qos_main.c b/drivers/net/ethernet/lantiq/ppv4/qos/pp_qos_main.c
index 14c0458fd712..63a8897bd2c8 100644
--- a/drivers/net/ethernet/lantiq/ppv4/qos/pp_qos_main.c
+++ b/drivers/net/ethernet/lantiq/ppv4/qos/pp_qos_main.c
@@ -1066,6 +1066,7 @@ void pp_qos_queue_conf_set_default(struct pp_qos_queue_conf *conf)
 	conf->common_prop.bandwidth_limit = QOS_NO_BANDWIDTH_LIMIT;
 	conf->common_prop.shared_bandwidth_group =
 		QOS_NO_SHARED_BANDWIDTH_GROUP;
+	conf->queue_child_prop.wrr_weight = 1;
 }
 
 int pp_qos_queue_allocate(struct pp_qos_dev *qdev, unsigned int *id)
@@ -1416,11 +1417,11 @@ static int _pp_qos_queue_set(
 				qdev,
 				conf,
 				phy,
-				nodep->child_prop.parent_phy,
-				nodep->data.queue.rlm,
+				nodep,
 				modified);
 
-	if (parent_changed && nodep->child_prop.virt_bw_share)
+	if (QOS_BITS_IS_SET(modified, QOS_MODIFIED_PARENT) ||
+	    QOS_BITS_IS_SET(modified, QOS_MODIFIED_BW_WEIGHT))
 		update_internal_bandwidth(qdev, parent);
 
 out:
@@ -1835,6 +1836,7 @@ void pp_qos_sched_conf_set_default(struct pp_qos_sched_conf *conf)
 	conf->common_prop.shared_bandwidth_group =
 		QOS_NO_SHARED_BANDWIDTH_GROUP;
 	conf->sched_parent_prop.arbitration = PP_QOS_ARBITRATION_WRR;
+	conf->sched_child_prop.wrr_weight = 1;
 }
 
 int pp_qos_sched_allocate(struct pp_qos_dev *qdev, unsigned int *id)
@@ -1926,9 +1928,12 @@ static int _pp_qos_sched_set(
 		dst_port = get_port(qdev->nodes, parent_phy);
 
 		if (src_port != dst_port) {
-			get_num_nonblocked_queues(qdev, phy, &num_nonblocked_queues);
+			get_num_nonblocked_queues(qdev, phy,
+						  &num_nonblocked_queues);
 			if (num_nonblocked_queues) {
-				QOS_LOG_ERR("All Sched's %u queues must be blocked during sched move(%u => %u)\n",
+				QOS_LOG_ERR("All Sched's %u queues must be "
+					    "blocked during sched move"
+					    "(%u => %u)\n",
 					    id, src_port, dst_port);
 				return -EINVAL;
 			}
@@ -2016,13 +2021,25 @@ static int _pp_qos_sched_set(
 				qdev,
 				conf,
 				phy,
-				nodep->child_prop.parent_phy,
+				nodep,
 				modified);
 
-	if (QOS_BITS_IS_SET(modified, QOS_MODIFIED_PARENT) &&
-	    nodep->child_prop.virt_bw_share)
+	if (QOS_BITS_IS_SET(modified, QOS_MODIFIED_PARENT) ||
+	    QOS_BITS_IS_SET(modified, QOS_MODIFIED_BW_WEIGHT))
 		update_internal_bandwidth(qdev, parent);
 
+	/* Update sub tree only if scheduler is not new */
+	if (QOS_BITS_IS_SET(modified, QOS_MODIFIED_ARBITRATION) &&
+	    !QOS_BITS_IS_SET(modified, QOS_MODIFIED_NODE_TYPE)) {
+		if (nodep->parent_prop.arbitration == PP_QOS_ARBITRATION_WSP) {
+			/* Update children as WSP */
+			set_children_wsp_weight(qdev, nodep);
+		} else {
+			/* Re-calculate weights upon arbitration change */
+			update_internal_bandwidth(qdev, nodep);
+		}
+	}
+
 	return 0;
 }
 
