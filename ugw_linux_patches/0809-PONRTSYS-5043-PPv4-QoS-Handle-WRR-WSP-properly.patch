 .../net/ethernet/lantiq/ppv4/qos/pp_qos_utils.h    |  10 ++
 include/net/pp_qos_drv.h                           |   5 +-
 6 files changed, 198 insertions(+), 107 deletions(-)

diff --git a/drivers/net/ethernet/lantiq/ppv4/qos/pp_qos_fw.c b/drivers/net/ethernet/lantiq/ppv4/qos/pp_qos_fw.c
index 4f4b73507bcc..aa0d6cb1e578 100644
--- a/drivers/net/ethernet/lantiq/ppv4/qos/pp_qos_fw.c
+++ b/drivers/net/ethernet/lantiq/ppv4/qos/pp_qos_fw.c
@@ -461,6 +461,7 @@ struct cmd_set_sched {
 	unsigned int parent;
 	struct sched_properties prop;
 	struct parent_node_properties parent_node_prop;
+	struct child_node_properties child_node_prop;
 	uint32_t modified;
 };
 
@@ -512,6 +513,7 @@ struct cmd_parent_change {
 	unsigned int phy;
 	int type;
 	struct parent_node_properties parent_node_prop;
+	struct child_node_properties child_node_prop;
 };
 
 struct cmd_get_queue_stats {
@@ -916,18 +918,20 @@ void create_set_port_cmd(
 
 static void set_cmd_sched_properties(
 		struct sched_properties *prop,
-		const struct pp_qos_sched_conf *conf)
+		const struct pp_qos_sched_conf *conf,
+		struct qos_node *node)
 {
 	prop->common = conf->common_prop;
 	prop->parent = conf->sched_parent_prop;
 	prop->child = conf->sched_child_prop;
+	prop->child.wrr_weight = node->child_prop.bw_weight;
 }
 
 static void create_add_sched_cmd(
 		struct pp_qos_dev *qdev,
 		const struct pp_qos_sched_conf *conf,
 		unsigned int phy,
-		unsigned int parent)
+		struct qos_node *node)
 {
 	struct cmd_add_sched cmd;
 
@@ -937,9 +941,9 @@ static void create_add_sched_cmd(
 	memset(&cmd, 0, sizeof(cmd));
 	cmd_init(qdev, &(cmd.base), CMD_TYPE_ADD_SCHED, sizeof(cmd), 0);
 	cmd.phy = phy;
-	cmd.parent = parent;
+	cmd.parent = node->child_prop.parent_phy;
 	fill_preds(qdev->nodes, phy, cmd.preds, 6);
-	set_cmd_sched_properties(&cmd.prop, conf);
+	set_cmd_sched_properties(&cmd.prop, conf, node);
 
