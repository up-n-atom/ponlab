+}
+
+int pp_qos_get_node_info(struct pp_qos_dev *qdev,
+			 unsigned int id,
+			 struct pp_qos_node_info *info)
+{
+	int rc;
+
+	QOS_LOCK(qdev);
+	PP_QOS_ENTER_FUNC();
