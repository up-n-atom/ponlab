From 3b08a9cbd8375bd06cbaa152f44c471f49de6938 Mon Sep 17 00:00:00 2001
From: Moh Aarif <mohammed.aarif@intel.com>
Date: Thu, 2 Jan 2020 13:26:16 +0530
Subject: [PATCH] UGW_SW-45757: Added qos manager hooks, when ppa is disabled

---
 drivers/net/datapath/dpm/datapath_instance.c       |  8 +--
 drivers/net/ethernet/lantiq/Kconfig                |  1 +
 drivers/net/ethernet/lantiq/Makefile               |  3 +
 drivers/net/ethernet/lantiq/qos_mgr/Kconfig        |  9 +++
 drivers/net/ethernet/lantiq/qos_mgr/Makefile       |  1 +
 drivers/net/ethernet/lantiq/qos_mgr/qos_mgr_hook.c | 67 ++++++++++++++++++++++
 6 files changed, 85 insertions(+), 4 deletions(-)

diff --git a/drivers/net/datapath/dpm/datapath_instance.c b/drivers/net/datapath/dpm/datapath_instance.c
index 98f0db6e36d8..05b85417ee0a 100644
--- a/drivers/net/datapath/dpm/datapath_instance.c
+++ b/drivers/net/datapath/dpm/datapath_instance.c
@@ -193,12 +193,12 @@ struct dp_dev *dp_dev_lookup(struct hlist_head *head,
 	return NULL;
 }
 
-#if IS_ENABLED(CONFIG_PPA)
+#if IS_ENABLED(CONFIG_PPA) || IS_ENABLED(CONFIG_QOS_MGR)
 #if LINUX_VERSION_CODE < KERNEL_VERSION(4, 13, 0)
 static int dp_ndo_setup_tc(struct net_device *dev, u32 handle,
 			   __be16 protocol, struct tc_to_netdev *tc)
 {
-#if IS_ENABLED(CONFIG_PPA)
+#if IS_ENABLED(CONFIG_PPA) || IS_ENABLED(CONFIG_QOS_MGR)
 	if (qos_mgr_hook_setup_tc)
 		return qos_mgr_hook_setup_tc(dev, handle, protocol, tc);
 #endif
@@ -232,7 +232,7 @@ int dp_inst_add_dev(struct net_device *dev, char *subif_name, int inst,
 	u32 vap;
 	struct subif_basic *subif;
 	struct dp_subif_info *sif;
-#if IS_ENABLED(CONFIG_PPA)
+#if IS_ENABLED(CONFIG_PPA) || IS_ENABLED(CONFIG_QOS_MGR)
 	int err = DP_SUCCESS;
 #endif
 	struct pmac_port_info *port_info = get_dp_port_info(inst, ep);
@@ -284,7 +284,7 @@ int dp_inst_add_dev(struct net_device *dev, char *subif_name, int inst,
 				sizeof(dp_dev->subif_name) - 1);
 		}
 		hlist_add_head(&dp_dev->hlist, &dp_dev_list[idx]);
-#if IS_ENABLED(CONFIG_PPA)
+#if IS_ENABLED(CONFIG_PPA) || IS_ENABLED(CONFIG_QOS_MGR)
 		/*backup ops*/
 		if (dev) {
 			dev->features |= NETIF_F_HW_TC;
diff --git a/drivers/net/ethernet/lantiq/Kconfig b/drivers/net/ethernet/lantiq/Kconfig
index 69ed78e82e59..c6cc7a4ad15c 100644
--- a/drivers/net/ethernet/lantiq/Kconfig
+++ b/drivers/net/ethernet/lantiq/Kconfig
@@ -107,5 +107,6 @@ source "drivers/net/ethernet/lantiq/switch-api/Kconfig"
 source "drivers/net/ethernet/lantiq/cqm/Kconfig"
 source "drivers/net/ethernet/lantiq/tmu/Kconfig"
 source "drivers/net/ethernet/lantiq/ppa/Kconfig"
+source "drivers/net/ethernet/lantiq/qos_mgr/Kconfig"
 source "drivers/net/ethernet/lantiq/directconnect_dp/Kconfig"
 endif # NET_VENDOR_LANTIQ
diff --git a/drivers/net/ethernet/lantiq/Makefile b/drivers/net/ethernet/lantiq/Makefile
index bd4c82110647..1afa60c37b54 100644
--- a/drivers/net/ethernet/lantiq/Makefile
+++ b/drivers/net/ethernet/lantiq/Makefile
@@ -14,6 +14,9 @@ obj-$(CONFIG_INTEL_PON_HGU_VUNI) += intel_pon_hgu_vuni.o
 obj-$(CONFIG_INTEL_GINT_ETH) += intel_gint_eth_drv.o
 obj-$(CONFIG_XRX500_PHY_FW) += xrx500_phy_fw.o
 obj-$(CONFIG_PPA) += ppa/
+ifneq ($(CONFIG_PPA),y)
+obj-$(CONFIG_QOS_MGR) += qos_mgr/
+endif
 #obj-$(CONFIG_INTEL_UMT_CQEM_MODE) += umt/umt.o
 obj-$(CONFIG_LTQ_TOE_DRIVER) += ltq_toe_drv.o
 obj-$(CONFIG_INTEL_MIB_COUNTERS) += ../../datapath/mib_counters/
diff --git a/drivers/net/ethernet/lantiq/qos_mgr/Kconfig b/drivers/net/ethernet/lantiq/qos_mgr/Kconfig
new file mode 100644
index 000000000000..863feb8dd171
--- /dev/null
+++ b/drivers/net/ethernet/lantiq/qos_mgr/Kconfig
@@ -0,0 +1,9 @@
+menu "QOS_MGR"
+
+config QOS_MGR
+        bool "QoS Manager"
+        depends on LANTIQ
+        default n
+        ---help---
+        QoS Manager
+endmenu
diff --git a/drivers/net/ethernet/lantiq/qos_mgr/Makefile b/drivers/net/ethernet/lantiq/qos_mgr/Makefile
new file mode 100644
index 000000000000..53eea65f2ddb
--- /dev/null
+++ b/drivers/net/ethernet/lantiq/qos_mgr/Makefile
@@ -0,0 +1 @@
+obj-y += qos_mgr_hook.o
diff --git a/drivers/net/ethernet/lantiq/qos_mgr/qos_mgr_hook.c b/drivers/net/ethernet/lantiq/qos_mgr/qos_mgr_hook.c
new file mode 100644
index 000000000000..ba79efbb4721
--- /dev/null
+++ b/drivers/net/ethernet/lantiq/qos_mgr/qos_mgr_hook.c
@@ -0,0 +1,67 @@
+/******************************************************************************
+ **
+ ** FILE NAME   : qos_mgr_hook.c
+ ** PROJECT   : UGW
+ ** MODULES   : QoS Manager Hooks
+ **
+ ** DATE   : 2 Jan 2020
+ ** AUTHOR   : Mohammed Aarif
+ ** DESCRIPTION : QoS Manager Hook Pointers
+ ** COPYRIGHT  : Copyright (c) 2019 - 2020 Intel Corporation
+ **
+ **   For licensing information, see the file 'LICENSE' in the root folder of
+ **   this software module.
+ **
+ ** HISTORY
+ ** $Date $Author $Comment
+ ******************************************************************************/
+
+/*
+ * Common Head File
+ */
+#include <linux/version.h>
+#include <generated/autoconf.h>
+#include <asm/atomic.h>
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/version.h>
+#include <linux/types.h>
+#include <linux/init.h>
+#include <linux/slab.h>
+#include <linux/netdevice.h>
+#include <linux/atmdev.h>
+#include <net/sock.h>
+#include <net/ip.h>
+#include <net/ipv6.h>
+#include <net/protocol.h>
+#include <net/xfrm.h>
+#include <linux/once.h>
+#include <linux/jhash.h>
+#include <linux/skbuff.h>
+#include <net/netns/hash.h>
+#include <linux/netfilter.h>
+#include <linux/netfilter_ipv4.h>
+#include <linux/netfilter_ipv6.h>
+#include <linux/netfilter_bridge.h>
+#include <linux/netfilter/nfnetlink.h>
+#include <linux/netfilter/nfnetlink_conntrack.h>
+#include <net/netfilter/nf_conntrack.h>
+#include <net/netfilter/nf_conntrack_core.h>
+#include <net/netfilter/nf_conntrack_ecache.h>
+#include <net/netfilter/nf_conntrack_tuple.h>
+#include <net/netfilter/nf_conntrack_acct.h>
+/*
+ * Chip Specific Head File
+ */
+#include <net/ppa/ppa_api.h>
+#include <net/ppa/ppa_stack_al.h>
+#include <net/ppa/ppa_api_directpath.h>
+
+int32_t (*qos_mgr_hook_setup_tc)(struct net_device *dev, u32 handle,
+		__be16 protocol, struct tc_to_netdev *tc) = NULL;
+EXPORT_SYMBOL(qos_mgr_hook_setup_tc);
+
+int32_t (*qos_mgr_hook_setup_tc_ext)(struct net_device *dev, u32 handle,
+		__be16 protocol, struct tc_to_netdev *tc, int32_t deq_idx,
+		int32_t port_id) = NULL;
+EXPORT_SYMBOL(qos_mgr_hook_setup_tc_ext);
