+static
+void set_desc_pmac_bits(struct dma_tx_desc_0 *dw0,
+			struct dma_tx_desc_1 *dw1, struct pmac_tx_hdr *pmac,
+			u32 flags, int val)
+{
+	int i = 0;
+	unsigned long *bits = (unsigned long *)&flags;
+
+	for_each_set_bit(i, bits, __bf_shf(DESC_PMAC_FLAG_END)) {
+		if (BIT(i) == MPE1)
+			dw1->field.mpe1 = val;
+		if (BIT(i) == MPE2)
+			dw1->field.mpe2 = val;
+		if (BIT(i) == ENC)
+			dw1->field.enc = val;
+		if (BIT(i) == DEC)
+			dw1->field.dec = val;
+		if (BIT(i) == IGP)
+			dw1->field.ip = val;
+		if (BIT(i) == EGP)
+			dw1->field.ep = val;
+		if (BIT(i) == COLR)
+			dw1->field.color = val;
+		if (BIT(i) == CLASSID)
+			dw1->field.classid = val;
+		if (BIT(i) == DW0_ALL)
+			dw0->all = val;
+		if (BIT(i) == DW1_ALL)
+			dw1->all = val;
+		if (BIT(i) == REDIR)
+			dw0->field.redir = val;
+		if (BIT(i) == P_INS)
+			pmac->ins = val;
+		if (BIT(i) == P_IGP_EGP)
+			pmac->igp_egp = val;
+		if (BIT(i) == P_IGP_MSB)
+			pmac->igp_msb = val;
+		if (BIT(i) == P_CLS_EN)
+			pmac->class_en = val;
+		if (BIT(i) == P_TCP_CSUM)
+			pmac->tcp_chksum = val;
+		if (BIT(i) == P_PTP)
+			pmac->ptp = val;
+	}
+}
+
+static
+void dma_pmac_templ(struct pmac_port_info *dp_info, int templ, u32 flags,
+		    int val)
+{
+	struct dma_tx_desc_0 *dw0 =
+		(struct dma_tx_desc_0 *)&dp_info->desc_dw_templ[0][templ];
+	struct dma_tx_desc_1 *dw1 =
+		(struct dma_tx_desc_1 *)&dp_info->desc_dw_templ[1][templ];
+	struct pmac_tx_hdr *pmac = &dp_info->pmac_template[templ];
+
+	if (!dw0 || !dw1 || !pmac) {
+		pr_err("%s: Dma Template cannot get templ %d\n", __func__,
+		       templ);
+		return;
+	}
+
+	set_desc_pmac_bits(dw0, dw1, pmac, flags, val);
+}
+
+static
+void dma_mask_templ(struct pmac_port_info *dp_info, int templ, u32 flags,
+		    int val)
+{
+	struct dma_tx_desc_0 *dw0 =
+		(struct dma_rx_desc_0 *)&dp_info->desc_dw_mask[0][templ];
+	struct dma_tx_desc_1 *dw1 =
+		(struct dma_rx_desc_1 *)&dp_info->desc_dw_mask[1][templ];
+
+	if (!dw0 || !dw1) {
+		pr_err("%s: Dma Template cannot get templ %d\n", __func__,
+		       templ);
+		return;
+	}
+	set_desc_pmac_bits(dw0, dw1, NULL, flags, val);
+}
