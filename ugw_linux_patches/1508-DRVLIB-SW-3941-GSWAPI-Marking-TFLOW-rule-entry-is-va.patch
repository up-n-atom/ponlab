 .../net/ethernet/lantiq/switch-api/gsw_ll_func.h   |  3 +
 .../net/ethernet/lantiq/switch-api/gsw_tbl_rw.c    | 50 +++++++++++++++
 include/net/switch_api/gsw_flow_ops.h              |  6 +-
 include/net/switch_api/gsw_tbl_rw.h                |  1 +
 include/net/switch_api/lantiq_gsw_flow.h           | 26 ++++++++
 6 files changed, 159 insertions(+), 1 deletion(-)

diff --git a/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c b/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c
index a29dac8df592..251aa0621678 100644
--- a/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c
+++ b/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c
@@ -27880,6 +27880,78 @@ GSW_return_t GSW_PceRuleFree(void *cdev, GSW_PCE_rule_alloc_t *parm)
 	return ret;
 }
 
+/**
+ * GSW_PceRuleEnable()- Enable PCE Rule
+ * @cdev: a pointer to the target &ethsw_api_dev_t
+ * @GSW_PCE_rule_t: a pointer to PCE Rule target &GSW_PCE_rule_t
+ *
+ * Parse the valid bit,Table Address and Enable PCE Rule.
+ */
+GSW_return_t GSW_PceRuleEnable(void *cdev,
+			       GSW_PCE_rule_t *parm)
+{
+	ethsw_api_dev_t *gswdev = GSW_PDATA_GET(cdev);
+	pctbl_prog_t pcetable;
+	int ret;
+
+	BUG_ON(!cdev || !gswdev);
+
+	if (GSW_statusOk != gsw_pcerulemanage(cdev, parm))
+		return GSW_statusErr;
+
+	memset(&pcetable, 0, sizeof(pctbl_prog_t));
+	pcetable.table = PCE_TFLOW_INDEX;
+	pcetable.pcindex = parm->pattern.nIndex;
+	gsw_pce_table_read(cdev, &pcetable);
+	memset(&pcetable, 0, sizeof(pctbl_prog_t));
+	pcetable.pcindex = parm->pattern.nIndex;
+	pcetable.valid = true;
+	pcetable.table = PCE_TFLOW_INDEX;
+	ret = gsw_pce_rule_set(cdev, &pcetable);
+	if (ret) {
+		pr_err("%s:%s:%d", __FILE__, __func__, __LINE__);
+		return GSW_statusErr;
+	}
+
+	return GSW_statusOk;
+}
+
+/**
+ * GSW_PceRuleDisable()- Disable PCE Rule
+ * @cdev: a pointer to the target &ethsw_api_dev_t
+ * @GSW_PCE_rule_t: a pointer to PCE Rule target &GSW_PCE_rule_t
+ *
+ * Parse the valid bit,Table Address and Disable PCE Rule.
+ */
+GSW_return_t GSW_PceRuleDisable(void *cdev,
+				GSW_PCE_rule_t *parm)
+{
+	ethsw_api_dev_t *gswdev = GSW_PDATA_GET(cdev);
+	pctbl_prog_t pcetable;
+	int ret;
+
+	BUG_ON(!cdev || !gswdev);
+
+	if (GSW_statusOk != gsw_pcerulemanage(cdev, parm))
+		return GSW_statusErr;
+
+	memset(&pcetable, 0, sizeof(pctbl_prog_t));
+	pcetable.table = PCE_TFLOW_INDEX;
+	pcetable.pcindex = parm->pattern.nIndex;
+	gsw_pce_table_read(cdev, &pcetable);
+	memset(&pcetable, 0, sizeof(pctbl_prog_t));
+	pcetable.pcindex = parm->pattern.nIndex;
+	pcetable.valid = false;
+	pcetable.table = PCE_TFLOW_INDEX;
+	ret = gsw_pce_rule_set(cdev, &pcetable);
+	if (ret) {
+		pr_err("%s:%s:%d", __FILE__, __func__, __LINE__);
+		return GSW_statusErr;
+	}
+
+	return GSW_statusOk;
+}
+
