From e31053ac811f2893f307b31063953b1a74fa5964 Mon Sep 17 00:00:00 2001
From: Elad Fernandes <elad.fernandes@intel.com>
Date: Thu, 12 Nov 2020 15:15:16 +0200
Subject: [PATCH] LMTSYS-4250: [PPV4 LGM] Set the LGM PPv4 reassembly memort
 port flag as the ingress port type

---
 drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c b/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c
index e37370188094..15d6bf07e055 100644
--- a/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c
+++ b/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c
@@ -2742,7 +2742,7 @@ static s32 __smgr_si_ud_set(struct sess_info *s)
 
 		ret = pp_port_get(s->args->eg_port, &cfg);
 		if (unlikely(ret)) {
-			pr_err("pp_port_get err %d\n", ret);
+			pr_err("pp_port_get eg_port err %d\n", ret);
 			return ret;
 		}
 
@@ -2753,6 +2753,13 @@ static s32 __smgr_si_ud_set(struct sess_info *s)
 			reass_info.flags |= REASS_INFO_FLAG_WR_DESC;
 		if (cfg.tx.prel2_en)
 			reass_info.flags |= REASS_INFO_FLAG_PREL2_EN;
+
+		ret = pp_port_get(s->args->in_port, &cfg);
+		if (unlikely(ret)) {
+			pr_err("pp_port_get in_port err %d\n", ret);
+			return ret;
+		}
+		/* Memory port is reffering the ingress port */
 		if (cfg.rx.mem_port_en)
 			reass_info.flags |= REASS_INFO_FLAG_MEMORY_PORT;
 
