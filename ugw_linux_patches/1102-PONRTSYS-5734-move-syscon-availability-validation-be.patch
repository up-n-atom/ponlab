From cec75fd0cfdebc6589dc4a8354baeb6f196fb8e5 Mon Sep 17 00:00:00 2001
From: "Vishnu Swaroop Kumar Sarma, Duddu" <duddu.swaroop@intel.com>
Date: Wed, 1 Apr 2020 11:28:06 +0530
Subject: [PATCH] PONRTSYS-5734 move syscon availability validation before
 using it

---
 drivers/cpufreq/xrx500-cpufreq.c | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/drivers/cpufreq/xrx500-cpufreq.c b/drivers/cpufreq/xrx500-cpufreq.c
index 82e8ae23cc1b..127f9f4e4dd7 100644
--- a/drivers/cpufreq/xrx500-cpufreq.c
+++ b/drivers/cpufreq/xrx500-cpufreq.c
@@ -223,14 +223,14 @@ static int xrx500_cpufreq_driver_init(void)
 		/* get CGU regmap */
 		cgu_pllcfg = syscon_regmap_lookup_by_phandle(cpu_dev->of_node,
 							"intel,cgu-syscon");
-		regmap_read(cgu_pllcfg, CGU_PLL0A_CFG2, &val);
-		f_vco_clk = 40000 * (val & FBDIV) / ((val & REFDIV) >> 18);
-
 		if (IS_ERR(cgu_pllcfg)) {
 			dev_err(cpu_dev, "No phandle for intel,cgu-syscon\n");
 			return PTR_ERR(cgu_pllcfg);
 		}
 
+		regmap_read(cgu_pllcfg, CGU_PLL0A_CFG2, &val);
+		f_vco_clk = 40000 * (val & FBDIV) / ((val & REFDIV) >> 18);
+
 		/* expose scaling frequencies to TEP for policy check
 		 * max scaling frequencies supported are MAX_SCALING_FREQ.
 		 * We expose directly the valid clk divider value used in
