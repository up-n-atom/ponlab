From 5c05e3b896901e92e9836f52dc1fe0c272344daa Mon Sep 17 00:00:00 2001
From: Rekha Eswaran <rekha.eswaran@intel.com>
Date: Mon, 16 Mar 2020 16:41:48 +0800
Subject: [PATCH] DRV_DPM_SW-186 - subif register event trigger early

---
 drivers/net/datapath/dpm/datapath_misc.c     | 14 +++-----------
 drivers/net/datapath/dpm/datapath_notifier.c |  3 +--
 2 files changed, 4 insertions(+), 13 deletions(-)

diff --git a/drivers/net/datapath/dpm/datapath_misc.c b/drivers/net/datapath/dpm/datapath_misc.c
index c4f6f3d99a5a..1bdbe8820d5a 100644
--- a/drivers/net/datapath/dpm/datapath_misc.c
+++ b/drivers/net/datapath/dpm/datapath_misc.c
@@ -982,14 +982,11 @@ int32_t dp_sync_subifid_priv(struct net_device *dev, char *subif_name,
 {
 	void *subif_data = NULL;
 	struct pmac_port_info *port;
-	struct dp_subif_info *sif;
-	u16 vap = 0;
 
-	/* Note: workaround to set dummy subif_data via subif_name for DSL case.
+	/* Note: to set dummy subif_data via subif_name for
+	 * DSL case when dev is NULL
 	 *       During dp_get_netif_subifID, subif_data is used to get its PVC
 	 *       information.
-	 * Later VRX518/618 need to provide valid subif_data in order to support
-	 * multiple DSL instances during dp_register_subif_ext
 	 */
 	port = get_dp_port_info(0, subif_id->port_id);
 	if (!port)
@@ -1013,12 +1010,7 @@ int32_t dp_sync_subifid_priv(struct net_device *dev, char *subif_name,
 			dp_update_subif(dev, subif_data, &subif_id[0],
 					subif_name, flags, subifid_fn);
 
-			vap = GET_VAP(subif_id->subif, port->vap_offset,
-				      port->vap_mask);
-			
-			sif = get_dp_port_subif(port, vap);
-
-			if (get_dp_bp_info(0, sif->bp)->ref_cnt <= 1)
+			if (get_dp_bp_info(0, subif_id->bport)->ref_cnt <= 1)
 				dp_notifier_invoke(0, dev, subif_id->port_id,
 						   DP_EVENT_REGISTER_SUBIF);
 
diff --git a/drivers/net/datapath/dpm/datapath_notifier.c b/drivers/net/datapath/dpm/datapath_notifier.c
index 05baa0ac8760..5bee83e3feb3 100644
--- a/drivers/net/datapath/dpm/datapath_notifier.c
+++ b/drivers/net/datapath/dpm/datapath_notifier.c
@@ -44,7 +44,7 @@ int dp_notifier_invoke(int inst, struct net_device *dev,
 	notif_data.dev = dev;
 	notif_data.dev_port = port_info->dev_port;
 	notif_data.mod = port_info->owner;
-	notif_data.dpid = port_info->port_id;
+	notif_data.dpid = port_id;
 
 	switch (type) {
 	case DP_EVENT_ALLOC_PORT:
@@ -58,7 +58,6 @@ int dp_notifier_invoke(int inst, struct net_device *dev,
 	case DP_EVENT_REGISTER_SUBIF:
 	case DP_EVENT_DE_REGISTER_SUBIF:
 		dp_get_port_subitf_via_dev_private(dev, &subif);
-		notif_data.dpid = subif.port_id;
 		notif_data.subif = subif.subif;
 		break;
 	default:
