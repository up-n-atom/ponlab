+++ b/drivers/net/datapath/umt/umt.c
@@ -425,11 +425,6 @@ static int umt_set_rxmux(struct umt_priv *priv, struct umt_port *umt_p)
 		} else {
 			umt_reg_update_bit(priv, UMT_MODE, P0_CNT_MODE_OFF, 1);
 			for (i = 0; i < res->dma_ch_num; i++) {
