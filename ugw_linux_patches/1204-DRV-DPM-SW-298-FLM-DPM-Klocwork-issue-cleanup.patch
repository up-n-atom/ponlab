From 29caa65189f2112a621db5d126602d2aeca20876 Mon Sep 17 00:00:00 2001
From: Gu Chao <gux.chao@intel.com>
Date: Fri, 5 Jun 2020 18:01:42 +0800
Subject: [PATCH] DRV_DPM_SW-298: FLM DPM Klocwork issue cleanup

- Fix assignment in condition issue due to copy_from_user() inside if statement
- Fix various code is unreachable issues
---
 drivers/net/datapath/dpm/datapath_api.c            | 27 ++++++++++++--------
 .../datapath/dpm/gswip30/datapath_lookup_proc.c    | 20 +++------------
 .../datapath/dpm/gswip31/datapath_lookup_proc.c    | 29 ++++++++--------------
 drivers/net/datapath/umt/umt.c                     |  5 ----
 4 files changed, 31 insertions(+), 50 deletions(-)

diff --git a/drivers/net/datapath/dpm/datapath_api.c b/drivers/net/datapath/dpm/datapath_api.c
index 8d9c7c5a04cf..7b5e172a4a47 100644
--- a/drivers/net/datapath/dpm/datapath_api.c
+++ b/drivers/net/datapath/dpm/datapath_api.c
@@ -269,18 +269,25 @@ struct pmac_port_info *get_port_info_via_dp_port(int inst, int dp_port)
 
 int8_t parser_size(int8_t v)
 {
-	if (v == DP_PARSER_F_DISABLE)
-		return 0;
-
-	if (v == DP_PARSER_F_HDR_ENABLE)
-		return PASAR_OFFSETS_NUM;
+	int ret;
 
-	if (v == DP_PARSER_F_HDR_OFFSETS_ENABLE)
-		return PASAR_OFFSETS_NUM + PASAR_FLAGS_NUM;
+	switch (v) {
+	case DP_PARSER_F_DISABLE:
+		ret = 0;
+		break;
+	case DP_PARSER_F_HDR_ENABLE:
+		ret = PASAR_OFFSETS_NUM;
+		break;
+	case DP_PARSER_F_HDR_OFFSETS_ENABLE:
+		ret = PASAR_OFFSETS_NUM + PASAR_FLAGS_NUM;
+		break;
+	default:
+		pr_err("Wrong parser setting: %d\n", v);
+		ret = -1;
+		break;
+	}
 
-	pr_err("Wrong parser setting: %d\n", v);
-	/*error */
-	return -1;
+	return ret;
 }
 
 /*Only for SOC side, not for peripheral device side */
diff --git a/drivers/net/datapath/dpm/gswip30/datapath_lookup_proc.c b/drivers/net/datapath/dpm/gswip30/datapath_lookup_proc.c
index 1068bf3be188..22b41f578776 100644
--- a/drivers/net/datapath/dpm/gswip30/datapath_lookup_proc.c
+++ b/drivers/net/datapath/dpm/gswip30/datapath_lookup_proc.c
@@ -386,10 +386,10 @@ int lookup_dump30(struct seq_file *s, int pos)
 	return pos;
 }
 
-ssize_t proc_get_qid_via_index30(struct file *file, const char *buf,
+ssize_t proc_get_qid_via_index30(struct file *file, const char __user *buf,
 				 size_t count, loff_t *ppos)
 {
-	int err = 0, len = 0;
+	size_t len;
 	char data[100];
 	unsigned int lookup_index;
 	unsigned int qid = 0;
@@ -400,20 +400,8 @@ ssize_t proc_get_qid_via_index30(struct file *file, const char *buf,
 		return -EPERM;
 	len = (count >= sizeof(data)) ? (sizeof(data) - 1) : count;
 	DP_DEBUG(DP_DBG_FLAG_LOOKUP, "len=%d\n", len);
-
-	if (len <= 0) {
-		err = -EFAULT;
-		pr_err("Wrong len value (%d)\n", len);
-		return count;
-	}
-
-	if (copy_from_user(data, buf, len)) {
-		err = -EFAULT;
-		pr_err("copy_from_user fail");
-		return count;
-	}
-
-	data[len - 1] = 0;	/* Make string */
+	len -= copy_from_user(data, buf, len);
+	data[len] = 0; /* Make string */
 	num = dp_split_buffer(data, param_list, ARRAY_SIZE(param_list));
 
 	if (num <= 1)
diff --git a/drivers/net/datapath/dpm/gswip31/datapath_lookup_proc.c b/drivers/net/datapath/dpm/gswip31/datapath_lookup_proc.c
