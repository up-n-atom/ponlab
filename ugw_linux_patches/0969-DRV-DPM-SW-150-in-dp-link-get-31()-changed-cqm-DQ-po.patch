From d91c26e1faed60e9559ba20bfa11b3639b2d45f1 Mon Sep 17 00:00:00 2001
From: Rekha Eswaran <rekha.eswaran@intel.com>
Date: Wed, 29 Jan 2020 17:45:47 +0800
Subject: [PATCH] DRV_DPM_SW-150 - in dp_link_get_31() changed cqm DQ port from
 logical nodeid to physical port id [PONRTSYS-6469]

---
 drivers/net/datapath/dpm/gswip31/datapath_ppv4_api.c | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/drivers/net/datapath/dpm/gswip31/datapath_ppv4_api.c b/drivers/net/datapath/dpm/gswip31/datapath_ppv4_api.c
index db9a04db416a..ec555ee026be 100644
--- a/drivers/net/datapath/dpm/gswip31/datapath_ppv4_api.c
+++ b/drivers/net/datapath/dpm/gswip31/datapath_ppv4_api.c
@@ -3570,6 +3570,10 @@ int dp_link_get_31(struct dp_qos_link *cfg, int flag)
 
 	if (priv->qos_sch_stat[node_id].parent.type == DP_NODE_PORT) {
 		cfg->cqm_deq_port = priv->qos_sch_stat[node_id].parent.node_id;
+		cfg->cqm_deq_port =
+			get_cqm_deq_port_by_node(cfg->inst,
+						 cfg->cqm_deq_port,
+						 0);
 		return DP_SUCCESS;
 	} else if (priv->qos_sch_stat[node_id].parent.type == DP_NODE_SCH) {
 		for (i = 0; i < DP_MAX_SCH_LVL - 1; i++) {
