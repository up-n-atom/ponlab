-static int dp_queue_alloc_conf(int inst, int *logical_id, int *qid)
+static int dp_q_reserve_contiguous(int inst, int ep, struct dp_dev_data *data)
 {
-	u32 id = 0;
 	struct hal_priv *priv = HAL(inst);
-	struct pp_qos_queue_info info;
-	int res = DP_SUCCESS;
+	struct resv_info *r = &priv->resv[ep];
+	size_t len;
+	int i, res;
+	u32 *ids, *phy_ids;
+
+	len = sizeof(*ids) * data->num_resv_q * 2;
+	ids = devm_kzalloc(&g_dp_dev->dev, len, GFP_ATOMIC);
+	if (!ids)
+		return DP_FAILURE;
 
-	if (dp_qos_queue_allocate_id_phy(priv->qdev, &id, &info.physical_id)) {
-		pr_err("qos_queue_allocate failed\n");
+	phy_ids = ids + data->num_resv_q;
+	res = pp_qos_contiguous_queue_allocate(priv->qdev, ids, phy_ids,
+					       data->num_resv_q);
+	if (res) {
+		pr_err("%s: pp qos contiguous q alloc failed with %d\n",
+		       __func__, res);
+		devm_kfree(&g_dp_dev->dev, ids);
 		return DP_FAILURE;
 	}
-
-	*qid = info.physical_id;
-	*logical_id = id;
-	return res;
+	for (i = 0; i < data->num_resv_q; i++) {
+		r->resv_q[i].id = ids[i];
+		r->resv_q[i].physical_id = phy_ids[i];
+		DP_DEBUG(DP_DBG_FLAG_QOS, "%s: reseve q[%d/%d] for ep %d\n",
+			 __func__, ids[i], phy_ids[i], ep);
+	}
+	r->num_resv_q = data->num_resv_q;
+	r->flag_ops |= DP_F_DEV_CONTINUOUS_Q;
+	data->qos_resv_q_base =	phy_ids[0];
+	devm_kfree(&g_dp_dev->dev, ids);
+	return DP_SUCCESS;
 }
 
