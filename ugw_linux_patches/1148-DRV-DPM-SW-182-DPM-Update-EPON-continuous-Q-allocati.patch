+static int dp_sched_remove(int inst, int ep)
+{
+	struct hal_priv *priv = HAL(inst);
+	struct resv_info *r = &priv->resv[ep];
+	int i, res;
+
+	if (!r->resv_sched)
+		return DP_SUCCESS;
+
+	while (r->num_resv_sched > 0) {
+		i = r->num_resv_sched - 1;
+		res = dp_qos_sched_remove(priv->qdev, r->resv_sched[i].id);
+		if (res) {
+			pr_err("%s: pp qos sched remove failed with %d for sched id %u\n",
+			       __func__, res, r->resv_sched[i].id);
+			return DP_FAILURE;
 		}
+		r->num_resv_sched--;
 	}
-	return res;
+	devm_kfree(&g_dp_dev->dev, r->resv_sched);
+	r->resv_sched = NULL;
+	return DP_SUCCESS;
+}
