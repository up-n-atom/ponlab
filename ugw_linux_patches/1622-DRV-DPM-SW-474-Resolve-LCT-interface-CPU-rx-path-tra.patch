From facafcf80b37c29dc4dcf9a44a66d1522b697c16 Mon Sep 17 00:00:00 2001
From: Rekha Eswaran <rekha.eswaran@intel.com>
Date: Mon, 8 Mar 2021 14:57:01 +0800
Subject: [PATCH] DRV_DPM_SW-474 - Resolve LCT interface CPU rx path traffic
 broken

---
 drivers/net/datapath/dpm/gswip31/datapath_rx.c | 12 +++++++++++-
 1 file changed, 11 insertions(+), 1 deletion(-)

diff --git a/drivers/net/datapath/dpm/gswip31/datapath_rx.c b/drivers/net/datapath/dpm/gswip31/datapath_rx.c
index 1f569ae669bf..e861012420e3 100644
--- a/drivers/net/datapath/dpm/gswip31/datapath_rx.c
+++ b/drivers/net/datapath/dpm/gswip31/datapath_rx.c
@@ -355,7 +355,7 @@ int _dp_rx(struct sk_buff *skb, u32 flags)
 	mib = get_dp_port_subif_mib(sif);
 	rx_fn = dp_port->cb.rx_fn;
 
-	if (STATS_GET(sif->rx_flag) <= 0) {
+	if ((STATS_GET(sif->rx_flag) <= 0) && !(dp_port->lct_idx)) {
 		rx_info(dpid, gpid, vap, "pkt drop, rx disabled\n");
 		UP_STATS(mib->rx_fn_dropped);
 		goto RX_DROP;
@@ -478,10 +478,20 @@ int _dp_rx(struct sk_buff *skb, u32 flags)
 			if (!dp_handle_lct(dp_port, skb, rx_fn))
 				return DP_SUCCESS;
 		}
+		if (STATS_GET(sif->rx_flag) <= 0) {
+			rx_info(dpid, gpid, vap, "pkt drop, rx disabled\n");
+			UP_STATS(mib->rx_fn_dropped);
+			goto RX_DROP;
+		}
 		rx_fn(dev, NULL, skb, skb->len);
 		UP_STATS(mib->rx_fn_rxif_pkt);
 		MIB_G_STATS_INC(rx_rxif_pkts);
 	} else {
+		if (STATS_GET(sif->rx_flag) <= 0) {
+			rx_info(dpid, gpid, vap, "pkt drop, rx disabled\n");
+			UP_STATS(mib->rx_fn_dropped);
+			goto RX_DROP;
+		}
 		rx_fn(NULL, dev, skb, skb->len);
 		UP_STATS(mib->rx_fn_txif_pkt);
 		MIB_G_STATS_INC(rx_txif_pkts);
