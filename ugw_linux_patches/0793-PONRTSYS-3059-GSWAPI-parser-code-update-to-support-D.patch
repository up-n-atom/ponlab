From 446934d8d2f76b85468d8dd228e5fdadcf0dc785 Mon Sep 17 00:00:00 2001
From: Dinesh Sudham <dineshx.sudham@intel.com>
Date: Wed, 11 Sep 2019 14:53:52 +0800
Subject: [PATCH] PONRTSYS-3059: GSWAPI: parser code update to support
 DHCPV4&DHCPV6 Ethertypes

---
 .../net/ethernet/lantiq/switch-api/gsw_flow_core.c |  14 +++
 .../net/ethernet/lantiq/switch-api/gsw_flow_core.h |   6 +-
 .../net/ethernet/lantiq/switch-api/gsw_flow_pce.c  | 135 ++++++++++-----------
 include/net/switch_api/lantiq_gsw.h                |   6 +-
 4 files changed, 89 insertions(+), 72 deletions(-)

diff --git a/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c b/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c
index 2716ea696b7b..e1af30c1e9bb 100644
--- a/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c
+++ b/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c
@@ -19683,6 +19683,14 @@ GSW_return_t GSW_ExtendedVlanSet(void *cdev, GSW_EXTENDEDVLAN_config_t *parm)
 		tbl_prog.key[2] |= 5;
 		break;
 
+	/** DHCPV4 (UDP DESTINATION PORT 67&68). */
+	case GSW_EXTENDEDVLAN_FILTER_ETHERTYPE_DHCPV4 :
+		tbl_prog.key[2] |= 16;
+		break;
+	/** DHCPV6 (UDP DESTINATION PORT 67&68). */
+	case GSW_EXTENDEDVLAN_FILTER_ETHERTYPE_DHCPV6 :
+		tbl_prog.key[2] |= 17;
+		break;
 	}
 
 
@@ -20370,6 +20378,12 @@ GSW_return_t GSW_ExtendedVlanGet(void *cdev, GSW_EXTENDEDVLAN_config_t *parm)
 	case 5:
 		parm->sFilter.eEtherType = GSW_EXTENDEDVLAN_FILTER_ETHERTYPE_EAPOL;
 		break;
+	case 16:
+		parm->sFilter.eEtherType = GSW_EXTENDEDVLAN_FILTER_ETHERTYPE_DHCPV4;
+		break;
+	case 17:
+		parm->sFilter.eEtherType = GSW_EXTENDEDVLAN_FILTER_ETHERTYPE_DHCPV6;
+		break;
 	}
 
 	/**Treatment Get**/
