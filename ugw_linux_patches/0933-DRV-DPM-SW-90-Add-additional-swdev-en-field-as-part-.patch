 		else
 			STATS_SET(sif->rx_flag, 1);
+#if IS_ENABLED(CONFIG_INTEL_DATAPATH_SWITCHDEV)
+		if (data->flag_ops & DP_SUBIF_SWDEV)
+			sif->swdev_en = data->swdev_en_flag;
+		else
+			sif->swdev_en = port_info->swdev_en;
