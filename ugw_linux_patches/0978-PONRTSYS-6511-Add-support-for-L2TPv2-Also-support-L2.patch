-		 * len exluded any inner headers
+		 * len excluded any inner headers
 		 */
 		sess->si.pkt_len_diff = SESS_EGRS_HDR_LEN(sess) -
 					SESS_INGRS_OUTER_OFFSETS(sess).l3;
