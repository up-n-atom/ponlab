 		seq_printf(f, " %-20s = %u[%#x]\n", "Session ID",
 			   tunn->l2tpoudp.session_id,
 			   tunn->l2tpoudp.session_id);
@@ -801,11 +801,10 @@ static void __smgr_pr_learn_tunn(struct seq_file *f, union fv_tunnel *tunn,
 			   tunn->l2tpoudp.tunnel_id,
 			   tunn->l2tpoudp.tunnel_id);
