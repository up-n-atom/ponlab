From f86fcabe60c89daf64fb2905a8dcfb470568269d Mon Sep 17 00:00:00 2001
From: Rekha Eswaran <rekha.eswaran@intel.com>
Date: Thu, 30 Jul 2020 12:10:34 +0800
Subject: [PATCH] DRV_DPM_SW-352 - FLM DP debug enhancement for detailed error
 readability

---
 drivers/net/datapath/dpm/datapath.h      |  10 +++
 drivers/net/datapath/dpm/datapath_api.c  | 126 +++++++++++++++++++++++++------
 drivers/net/datapath/dpm/datapath_misc.c |  25 ++++--
 3 files changed, 131 insertions(+), 30 deletions(-)

diff --git a/drivers/net/datapath/dpm/datapath.h b/drivers/net/datapath/dpm/datapath.h
index 1a4aa8871c41..10bb88e88027 100644
--- a/drivers/net/datapath/dpm/datapath.h
+++ b/drivers/net/datapath/dpm/datapath.h
@@ -241,6 +241,15 @@ enum PARSER_FLAGS {
 	PASER_FLAGS_MAX
 };
 
+enum dp_message_errors {
+	DP_ERR_INIT_FAIL = -6,
+	DP_ERR_INVALID_PORT_ID = -5,
+	DP_ERR_MEM = -4,
+	DP_ERR_NULL_DATA = -3,
+	DP_ERR_INVALID_SUBIF = -2,
+	DP_ERR_DEFAULT = -1,
+};
+
 /*! PMAC port flag */
 enum PORT_FLAG {
 	PORT_FREE = 0,		/*! The port is free */
@@ -1052,6 +1061,7 @@ static inline bool is_dsl(struct pmac_port_info *port)
 	return (port->alloc_flags & DP_F_FAST_DSL);
 }
 
+void dp_print_err_info(int res);
 int dp_notifier_invoke(int inst,
 		       struct net_device *dev, u32 port_id, u32 subif_id,
 		       enum DP_EVENT_TYPE type);
diff --git a/drivers/net/datapath/dpm/datapath_api.c b/drivers/net/datapath/dpm/datapath_api.c
index d7332c4dfe40..c76a5c716754 100644
--- a/drivers/net/datapath/dpm/datapath_api.c
+++ b/drivers/net/datapath/dpm/datapath_api.c
@@ -239,6 +239,33 @@ int parser_enabled(int ep, struct dma_rx_desc_1 *desc_1)
 	return 0;
 }
 
+void dp_print_err_info(int res)
+{
+	switch (res) {
+	case DP_ERR_INIT_FAIL:
+		pr_err("DPM init not donei\n");
+		break;
+	case DP_ERR_INVALID_PORT_ID:
+		pr_err("DPM invalid port id\n");
+		break;
+	case DP_ERR_MEM:
+		pr_err("DPM memory allocation failure\n");
+		break;
+	case DP_ERR_NULL_DATA:
+		pr_err("DPM exp data info is NULL\n");
+		break;
+	case DP_ERR_INVALID_SUBIF:
+		pr_err("DPM invalid subif\n");
+		break;
+	case DP_ERR_DEFAULT:
+		pr_err("DPM other generic error\n");
+		break;
+	default:
+		pr_err("DPM why come to here??(%s)\n", __func__);
+		break;
+	}
+}
+
 u32 *get_port_flag(int inst, int index)
 {
 	if (unlikely(!dp_init_ok)) {
@@ -676,8 +703,8 @@ int32_t dp_register_subif_private(int inst, struct module *owner,
 			break;
 	}
 	if (i >= end) {
-		DP_DEBUG(DP_DBG_FLAG_REG,
-			 "register subif failed for no matched vap\n");
+		pr_err("register subif failed for no matched vap(%s)\n",
+		       dev->name ? dev->name : "NULL");
 		return DP_FAILURE;
 	}
 	if (data->num_deq_port == 0)
@@ -729,7 +756,7 @@ int32_t dp_register_subif_private(int inst, struct module *owner,
 			 " tx_dma_chan ref=", dma_ch_ref, dma_ch_ref_curr);
 		if (cbm_dp_enable(owner, port_id, &cbm_data, 0,
 				  port_info->alloc_flags)) {
-			DP_DEBUG(DP_DBG_FLAG_REG, "cbm_dp_enable fail\n");
+			pr_err("cbm_dp_enable fail\n");
 			return DP_FAILURE;
 		}
 	}
@@ -1113,12 +1140,18 @@ int32_t dp_update_subif_info(struct dp_subif_upd_info *info)
 	old_subif_id_sync = devm_kzalloc(&g_dp_dev->dev,
 					 sizeof(*old_subif_id_sync) * 2,
 					 GFP_ATOMIC);
-	if (!old_subif_id_sync)
+	if (!old_subif_id_sync) {
+		res = DP_ERR_MEM;
 		goto exit;
+	}
 	old_subif_id_sync->port_id = info->dp_port;
 	old_subif_id_sync->inst = info->inst;
-	dp_sync_subifid(old_dev, NULL, old_subif_id_sync, &old_data,
-			DP_F_DEREGISTER, &f_old_subif);
+	res = dp_sync_subifid(old_dev, NULL, old_subif_id_sync, &old_data,
+			      DP_F_DEREGISTER, &f_old_subif);
+	if (res) {
+		devm_kfree(&g_dp_dev->dev, old_subif_id_sync);
+		goto exit;
+	}
 	/* no need any DQ port modification if prev & new tcont are same */
 	if (sif->cqm_port_idx == info->new_cqm_deq_idx) {
 		DP_DEBUG(DP_DBG_FLAG_REG,
@@ -1147,24 +1180,46 @@ int32_t dp_update_subif_info(struct dp_subif_upd_info *info)
 					 GFP_ATOMIC);
 	if (!new_subif_id_sync) {
 		devm_kfree(&g_dp_dev->dev, old_subif_id_sync);
+		res = DP_ERR_MEM;
 		goto exit;
 	}
 	new_subif_id_sync->port_id = info->dp_port;
 	new_subif_id_sync->inst = info->inst;
-	dp_sync_subifid(sif->netif, NULL, new_subif_id_sync, &new_data, 0,
-			&f_new_subif);
+	res = dp_sync_subifid(sif->netif, NULL, new_subif_id_sync, &new_data, 0,
+			      &f_new_subif);
+	if (res) {
+		devm_kfree(&g_dp_dev->dev, old_subif_id_sync);
+		devm_kfree(&g_dp_dev->dev, new_subif_id_sync);
+		goto exit;
+	}
 	DP_LIB_UNLOCK(&dp_lock);
 
 	/* remove old rcu info based on collected subif info */
-	dp_sync_subifid_priv(old_dev, NULL, old_subif_id_sync, &old_data,
-			     DP_F_DEREGISTER, subifid_fn, &f_old_subif);
+	res = dp_sync_subifid_priv(old_dev, NULL, old_subif_id_sync, &old_data,
+				   DP_F_DEREGISTER, subifid_fn, &f_old_subif);
+	if (res) {
+		pr_err("remove old dev from rcu fail(%s)\n",
+		       old_dev->name ? old_dev->name : "NULL");
+		devm_kfree(&g_dp_dev->dev, old_subif_id_sync);
+		devm_kfree(&g_dp_dev->dev, new_subif_id_sync);
+		return DP_FAILURE;
+	}
 	/* update rcu info based on new subif info */
-	dp_sync_subifid_priv(info->new_dev, NULL, new_subif_id_sync, &new_data,
-			     0, subifid_fn, &f_new_subif);
+	res = dp_sync_subifid_priv(info->new_dev, NULL, new_subif_id_sync,
+				   &new_data, 0, subifid_fn, &f_new_subif);
+	if (res) {
+		pr_err("update new dev into rcu fail(%s)\n",
+		       info->new_dev->name ? info->new_dev->name : "NULL");
+		devm_kfree(&g_dp_dev->dev, old_subif_id_sync);
+		devm_kfree(&g_dp_dev->dev, new_subif_id_sync);
+		return DP_FAILURE;
+	}
 	devm_kfree(&g_dp_dev->dev, new_subif_id_sync);
 	devm_kfree(&g_dp_dev->dev, old_subif_id_sync);
 	return DP_SUCCESS;
 exit:
+	if (unlikely(res))
+		dp_print_err_info(res);
 	res = DP_FAILURE;
 	DP_LIB_UNLOCK(&dp_lock);
 	return res;
@@ -1453,13 +1508,15 @@ int32_t dp_register_subif_ext(int inst, struct module *owner,
 	if (unlikely(!dp_init_ok)) {
 		DP_DEBUG(DP_DBG_FLAG_REG,
 			 "dp_register_subif fail for datapath not init yet\n");
-		return DP_FAILURE;
+		res = DP_ERR_INIT_FAIL;
+		goto EXIT;
 	}
 
 	if (!subif_id || !owner) {
 		DP_DEBUG(DP_DBG_FLAG_REG, "%s Failed subif_id %px owner %px\n",
 			 __func__, subif_id, owner);
-		return DP_FAILURE;
+		res = DP_ERR_INVALID_SUBIF;
+		goto EXIT;
 	}
 
 	DP_DEBUG(DP_DBG_FLAG_REG,
@@ -1477,8 +1534,10 @@ int32_t dp_register_subif_ext(int inst, struct module *owner,
 		 (flags & DP_F_ALLOC_EXPLICIT_SUBIFID) ?
 		 "Explicit" : "Non-Explicit");
 
-	if (is_invalid_port(subif_id->port_id) || is_invalid_inst(inst))
-		return DP_FAILURE;
+	if (is_invalid_port(subif_id->port_id) || is_invalid_inst(inst)) {
+		res = DP_ERR_INVALID_PORT_ID;
+		goto EXIT;
+	}
 
 	port_id = subif_id->port_id;
 	port_info = get_dp_port_info(inst, port_id);
@@ -1506,6 +1565,10 @@ int32_t dp_register_subif_ext(int inst, struct module *owner,
 	else /*register */
 		res = dp_register_subif_private(inst, owner, dev, subif_name,
 						subif_id, data, flags);
+	if (res) {
+		DP_LIB_UNLOCK(&dp_lock);
+		goto EXIT;
+	}
 	if (!(flags & DP_F_SUBIF_LOGICAL))
 		subifid_fn = port_info->cb.get_subifid_fn;
 
@@ -1513,16 +1576,28 @@ int32_t dp_register_subif_ext(int inst, struct module *owner,
 				     sizeof(*subif_id_sync) * 2, GFP_ATOMIC);
 	if (!subif_id_sync) {
 		DP_LIB_UNLOCK(&dp_lock);
-		return DP_FAILURE;
+		res = DP_ERR_MEM;
+		goto EXIT;
 	}
 	subif_id_sync->port_id = port_id;
 	subif_id_sync->inst = inst;
-	dp_sync_subifid(dev, subif_name, subif_id_sync, data, flags, &f_subif);
+	res = dp_sync_subifid(dev, subif_name, subif_id_sync, data, flags,
+			      &f_subif);
+	if (res) {
+		DP_LIB_UNLOCK(&dp_lock);
+		devm_kfree(&g_dp_dev->dev, subif_id_sync);
+		goto EXIT;
+	}
 	DP_LIB_UNLOCK(&dp_lock);
 	if (!res)
-		dp_sync_subifid_priv(dev, subif_name, subif_id_sync, data,
-				     flags, subifid_fn, &f_subif);
+		res = dp_sync_subifid_priv(dev, subif_name, subif_id_sync, data,
+					   flags, subifid_fn, &f_subif);
 	devm_kfree(&g_dp_dev->dev, subif_id_sync);
+EXIT:
+	if (unlikely(res)) {
+		dp_print_err_info(res);
+		res = DP_FAILURE;
+	}
 	return res;
 }
 EXPORT_SYMBOL(dp_register_subif_ext);
@@ -1632,12 +1707,15 @@ int32_t dp_get_netif_subifid_priv(int inst, struct net_device *netif,
 	subifs = devm_kzalloc(&g_dp_dev->dev,
 			      sizeof(*subifs) * DP_MAX_CTP_PER_DEV,
 			      GFP_ATOMIC);
-	if (!subifs)
+	if (!subifs) {
+		res = DP_ERR_MEM;
 		return res;
+	}
 	subif_flag = devm_kzalloc(&g_dp_dev->dev,
 				  sizeof(*subif_flag) * DP_MAX_CTP_PER_DEV,
 				  GFP_ATOMIC);
 	if (!subif_flag) {
+		res = DP_ERR_MEM;
 		devm_kfree(&g_dp_dev->dev, subifs);
 		return res;
 	}
@@ -1645,11 +1723,13 @@ int32_t dp_get_netif_subifid_priv(int inst, struct net_device *netif,
 		DP_DEBUG(DP_DBG_FLAG_REG,
 			 "%s failed: netif=%px subif_data=%px\n", __func__,
 			 netif, subif_data);
+		res = DP_ERR_NULL_DATA;
 		goto EXIT;
 	}
 	if (!subif) {
 		DP_DEBUG(DP_DBG_FLAG_REG,
 			 "%s failed:subif=%px\n", __func__, subif);
+		res = DP_ERR_NULL_DATA;
 		goto EXIT;
 	}
 	start = 0;
@@ -1760,7 +1840,7 @@ int32_t dp_get_netif_subifid_priv(int inst, struct net_device *netif,
 		else /*netif must should be valid */
 			DP_DEBUG(DP_DBG_FLAG_DBG,
 				 "%s failed: %s\n", __func__, netif->name);
-
+		res = DP_ERR_INVALID_PORT_ID;
 		goto EXIT;
 	}
 	subif->inst = inst;
@@ -1776,6 +1856,8 @@ int32_t dp_get_netif_subifid_priv(int inst, struct net_device *netif,
 EXIT:
 	devm_kfree(&g_dp_dev->dev, subifs);
 	devm_kfree(&g_dp_dev->dev, subif_flag);
+	if (unlikely(res))
+		dp_print_err_info(res);
 	return res;
 }
 
diff --git a/drivers/net/datapath/dpm/datapath_misc.c b/drivers/net/datapath/dpm/datapath_misc.c
index ec350c2906ce..f9595cd82469 100644
--- a/drivers/net/datapath/dpm/datapath_misc.c
+++ b/drivers/net/datapath/dpm/datapath_misc.c
@@ -987,6 +987,7 @@ int32_t dp_sync_subifid(struct net_device *dev, char *subif_name,
 {
 	void *subif_data = NULL;
 	struct pmac_port_info *port;
+	int res = DP_FAILURE;
 
 	port = get_dp_port_info(subif_id->inst, subif_id->port_id);
 
@@ -1008,22 +1009,30 @@ int32_t dp_sync_subifid(struct net_device *dev, char *subif_name,
 		else
 			*f_subif_up = 1;
 	} else {
-		if (dp_get_netif_subifid_priv(subif_id->inst, dev, NULL,
+		res = dp_get_netif_subifid_priv(subif_id->inst, dev, NULL,
 					      subif_data, NULL,
-					      &subif_id[0], 0)) {
-			pr_err("DP subif synchronization fail\n");
-			return DP_FAILURE;
+					      &subif_id[0], 0);
+		if (res) {
+			pr_err("dp_get_netif_subif_priv fail (%s)(err:%d)\n",
+			       dev->name ? dev->name : "NULL", res);
+			return res;
 		}
 		if (data && data->ctp_dev) {
-			if (dp_get_netif_subifid_priv(subif_id->inst,
+			res = dp_get_netif_subifid_priv(subif_id->inst,
 						      data->ctp_dev, NULL,
 						      subif_data, NULL,
-						      &subif_id[1], 0))
-				return DP_FAILURE;
+						      &subif_id[1], 0);
+			if (res) {
+				pr_err("get_netif_subif_priv fail(%s)err:%d\n",
+				       data->ctp_dev->name ? data->ctp_dev->name : "NULL",
+				       res);
+				return res;
+			}
 		}
 		*f_subif_up = 1;
 	}
-	return 0;
+	res = DP_SUCCESS;
+	return res;
 }
 
 int32_t dp_sync_subifid_priv(struct net_device *dev, char *subif_name,
