From b177d0167a0fb9f913110f2b8fe1a9609f2fc90a Mon Sep 17 00:00:00 2001
From: avishalo <avi1.shalom@intel.com>
Date: Sun, 6 Sep 2020 11:59:20 +0300
Subject: [PATCH] PONRTSYS-7979 : fix debug fs prints for OOB params

Signed-off-by: avishalo <avi1.shalom@intel.com>
---
 drivers/net/ppv4/pp-api/pp-port-mgr/pp_port_mgr_debugfs.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/drivers/net/ppv4/pp-api/pp-port-mgr/pp_port_mgr_debugfs.c b/drivers/net/ppv4/pp-api/pp-port-mgr/pp_port_mgr_debugfs.c
index 71e47dabb569..e5e73b8c22c8 100644
--- a/drivers/net/ppv4/pp-api/pp-port-mgr/pp_port_mgr_debugfs.c
+++ b/drivers/net/ppv4/pp-api/pp-port-mgr/pp_port_mgr_debugfs.c
@@ -274,11 +274,11 @@ void __pmgr_dbg_port_cfg_show(struct seq_file *f)
 
 	for (i = 0; i < cfg.rx.cls.n_flds; i++) {
 		scnprintf(buf, sizeof(buf), "fld[%u] Cls stw offset", i);
-		seq_printf(f, "|%-32s|%-12hhu|\n",
+		seq_printf(f, "| %-30s | %-10hhu |\n",
 			   buf, cfg.rx.cls.cp[i].stw_off);
 		seq_puts(f, "+--------------------------------+------------+\n");
 		scnprintf(buf, sizeof(buf), "fld[%u] Cls field size", i);
-		seq_printf(f, "|%-32s|%-12hhu|\n",
+		seq_printf(f, "| %-30s | %-10hhu |\n",
 			   buf, cfg.rx.cls.cp[i].copy_size);
 		seq_puts(f, "+--------------------------------+------------+\n");
 	}
