 drivers/net/datapath/dpm/datapath_swdev.h    |  24 +-
 include/net/datapath_api.h                   |   9 +-
 5 files changed, 461 insertions(+), 429 deletions(-)

diff --git a/drivers/net/datapath/dpm/datapath_misc.c b/drivers/net/datapath/dpm/datapath_misc.c
index 88c9deb8e713..eb9e3f12e1a3 100644
--- a/drivers/net/datapath/dpm/datapath_misc.c
+++ b/drivers/net/datapath/dpm/datapath_misc.c
@@ -799,7 +799,7 @@ int dp_meter_add(struct net_device *dev, struct dp_meter_cfg *meter, int flag)
 		}
 		mtr_subif.inst =  mtr_subif.subif.inst;
 	} else if (flag & DP_METER_ATTACH_BRIDGE) {
-		mtr_subif.fid = dp_get_fid_by_brname(dev, &mtr_subif.inst);
+		mtr_subif.fid = dp_get_fid_by_dev(dev, &mtr_subif.inst);
 		if (mtr_subif.fid < 0) {
 			pr_err("fid less then 0\n");
 			return DP_FAILURE;
@@ -844,7 +844,7 @@ int dp_meter_del(struct net_device *dev, struct dp_meter_cfg *meter, int flag)
 		}
 		mtr_subif.inst = mtr_subif.subif.inst;
 	} else if (flag & DP_METER_ATTACH_BRIDGE) {
-		mtr_subif.fid = dp_get_fid_by_brname(dev, &mtr_subif.inst);
+		mtr_subif.fid = dp_get_fid_by_dev(dev, &mtr_subif.inst);
 		if (mtr_subif.fid < 0) {
 			pr_err("fid less then 0\n");
 			return DP_FAILURE;
@@ -862,7 +862,7 @@ int dp_meter_del(struct net_device *dev, struct dp_meter_cfg *meter, int flag)
 EXPORT_SYMBOL(dp_meter_del);
 
