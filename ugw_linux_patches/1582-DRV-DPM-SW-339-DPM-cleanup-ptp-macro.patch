 		if (!(flag & DP_F_SUBIF_LOGICAL))
 			dp_register_switchdev_ops(dp_dev, 0);
 #endif
-#if IS_ENABLED(CONFIG_INTEL_DATAPATH_PTP1588)
+#if IS_ENABLED(CONFIG_PTP_1588_CLOCK)
 		dp_register_ptp_ioctl(dp_dev, 0);
 #endif
 		dp_dev->owner |= DP_OPS_OWNER_DPM;
@@ -427,7 +427,7 @@ int dp_inst_del_dev(struct net_device *dev, int inst,
 #if IS_ENABLED(CONFIG_INTEL_DATAPATH_SWITCHDEV)
 			dp_register_switchdev_ops(dp_dev, 1);
 #endif
-#if IS_ENABLED(CONFIG_INTEL_DATAPATH_PTP1588)
+#if IS_ENABLED(CONFIG_PTP_1588_CLOCK)
 			dp_register_ptp_ioctl(dp_dev, 1);
 #endif
 			/* Since all the ops are enable by CONFIG,
diff --git a/drivers/net/datapath/dpm/datapath_ioctl.c b/drivers/net/datapath/dpm/datapath_ioctl.c
