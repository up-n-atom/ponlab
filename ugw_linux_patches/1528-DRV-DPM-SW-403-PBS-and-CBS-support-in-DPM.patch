From bf12a11fb93091864adabab064bcaa4794bf1e78 Mon Sep 17 00:00:00 2001
From: thampan <joby.thampan@intel.com>
Date: Fri, 27 Nov 2020 11:11:13 +0800
Subject: [PATCH] DRV_DPM_SW-403: PBS and CBS support in DPM

---
 .../net/datapath/dpm/gswip31/datapath_ppv4_api.c   | 54 +++++++++++++++++++++-
 include/net/datapath_api_qos.h                     | 16 ++++++-
 2 files changed, 66 insertions(+), 4 deletions(-)

diff --git a/drivers/net/datapath/dpm/gswip31/datapath_ppv4_api.c b/drivers/net/datapath/dpm/gswip31/datapath_ppv4_api.c
index ce747befb3c0..4596f3424294 100644
--- a/drivers/net/datapath/dpm/gswip31/datapath_ppv4_api.c
+++ b/drivers/net/datapath/dpm/gswip31/datapath_ppv4_api.c
@@ -3532,6 +3532,10 @@ int dp_link_add_31(struct dp_qos_link *cfg, int flag)
 	return DP_FAILURE;
 }
 
+
+#define BYTES_TO_BURST_SIZE(quanta, bytes)   ilog2(bytes/(1024*quanta))
+#define BURST_SIZE_TO_BYTES(quanta, burst)   ((1 << burst)*quanta)*1024
+
 /* dp_shaper_conf_set_31 API
  * DP_NO_SHAPER_LIMIT no limit for shaper
  * DP_MAX_SHAPER_LIMIT max limit for shaper
@@ -3546,6 +3550,7 @@ int dp_shaper_conf_set_31(struct dp_shaper_conf *cfg, int flag)
 	struct hal_priv *priv;
 	int node_id, res;
 	u32 bw_limit;
+	u32 quanta;
 
 	if (!cfg) {
 		pr_err("cfg cannot be NULL\n");
@@ -3558,6 +3563,19 @@ int dp_shaper_conf_set_31(struct dp_shaper_conf *cfg, int flag)
 		return DP_FAILURE;
 	}
 
+	/* Quanta is normally 4 in PPv4 */
+	if (pp_qos_get_quanta(priv->qdev, &quanta)) {
+		pr_err("%s: pp_qos_get_quanta fail: %d\n",
+		       __func__, cfg->id.q_id);
+		return DP_FAILURE;
+	}
+
+	/* 2 unit is HW will take as 1 << 2 = 4 Quanta,
+	 * 1 Quanta is 4KB, so 16KB
+	 */
+	if (!cfg->cbs)
+		cfg->cbs = QOS_DEAFULT_MAX_BURST;
+
 	if (cfg->type == DP_NODE_QUEUE) {
 
 		if (!is_qid_valid(cfg->id.q_id) ||
@@ -3582,6 +3600,17 @@ int dp_shaper_conf_set_31(struct dp_shaper_conf *cfg, int flag)
 			}
 			queue_cfg.common_prop.bandwidth_limit = bw_limit;
 			queue_cfg.eir = cfg->pir > cfg->cir ? cfg->pir - cfg->cir : 0;
+
+			if (cfg->pbs < cfg->cbs)
+				cfg->pbs = cfg->cbs;
+
+			/* if need 16 KB of burst size then EBS should be 2 */
+			queue_cfg.ebs =
+				BYTES_TO_BURST_SIZE(quanta,
+						    (cfg->pbs - cfg->cbs));
+			queue_cfg.common_prop.max_burst =
+				BYTES_TO_BURST_SIZE(quanta, cfg->cbs);
+
 			break;
 		case DP_SHAPER_CMD_REMOVE:
 		case DP_SHAPER_CMD_DISABLE:
@@ -3619,6 +3648,9 @@ int dp_shaper_conf_set_31(struct dp_shaper_conf *cfg, int flag)
 				return DP_FAILURE;
 			}
 			sched_cfg.common_prop.bandwidth_limit = bw_limit;
+
+			sched_cfg.common_prop.max_burst =
+				BYTES_TO_BURST_SIZE(quanta, cfg->cbs);
 			break;
 		case DP_SHAPER_CMD_REMOVE:
 		case DP_SHAPER_CMD_DISABLE:
@@ -3658,6 +3690,9 @@ int dp_shaper_conf_set_31(struct dp_shaper_conf *cfg, int flag)
 				return DP_FAILURE;
 			}
 			port_cfg.common_prop.bandwidth_limit = bw_limit;
+
+			port_cfg.common_prop.max_burst =
+				BYTES_TO_BURST_SIZE(quanta, cfg->cbs);
 			break;
 		case DP_SHAPER_CMD_REMOVE:
 		case DP_SHAPER_CMD_DISABLE:
@@ -3692,6 +3727,7 @@ int dp_shaper_conf_get_31(struct dp_shaper_conf *cfg, int flag)
 	struct hal_priv *priv;
 	int node_id, res;
 	u32 bw_limit, pir = 0;
+	u32 quanta;
 
 	if (!cfg) {
 		pr_err("cfg cannot be NULL\n");
@@ -3704,6 +3740,13 @@ int dp_shaper_conf_get_31(struct dp_shaper_conf *cfg, int flag)
 		return DP_FAILURE;
 	}
 
+	/* Quanta is normally 4 in PPv4 */
+	if (pp_qos_get_quanta(priv->qdev, &quanta)) {
+		pr_err("%s: pp_qos_get_quanta fail: %d\n",
+		       __func__, cfg->id.q_id);
+		return DP_FAILURE;
+	}
+
 	if (cfg->type == DP_NODE_QUEUE) {
 
 		if (!is_qid_valid(cfg->id.q_id) ||
@@ -3726,6 +3769,11 @@ int dp_shaper_conf_get_31(struct dp_shaper_conf *cfg, int flag)
 		}
 
 		pir = queue_cfg.common_prop.bandwidth_limit + queue_cfg.eir;
+
+		cfg->cbs = BURST_SIZE_TO_BYTES(quanta,
+					       queue_cfg.common_prop.max_burst);
+		cfg->pbs = BURST_SIZE_TO_BYTES(quanta, queue_cfg.ebs) +
+			   cfg->cbs;
 	} else if (cfg->type == DP_NODE_SCH) {
 
 		if (!is_sch_valid(cfg->id.sch_id) ||
@@ -3746,6 +3794,8 @@ int dp_shaper_conf_get_31(struct dp_shaper_conf *cfg, int flag)
 			       sched_cfg.common_prop.bandwidth_limit);
 			return DP_FAILURE;
 		}
+		cfg->cbs = BURST_SIZE_TO_BYTES(quanta,
+					       sched_cfg.common_prop.max_burst);
 	} else if (cfg->type == DP_NODE_PORT) {
 
 		if (!is_deqport_valid(cfg->id.cqm_deq_port) ||
@@ -3766,6 +3816,8 @@ int dp_shaper_conf_get_31(struct dp_shaper_conf *cfg, int flag)
 			       port_cfg.common_prop.bandwidth_limit);
 			return DP_FAILURE;
 		}
+		cfg->cbs = BURST_SIZE_TO_BYTES(quanta,
+					       port_cfg.common_prop.max_burst);
 	} else {
 		pr_err("Unkonwn type provided:0x%x\n", cfg->type);
 		return DP_FAILURE;
@@ -3773,8 +3825,6 @@ int dp_shaper_conf_get_31(struct dp_shaper_conf *cfg, int flag)
 
 	cfg->cir = bw_limit;
 	cfg->pir = pir;
-	cfg->cbs = 0;
-	cfg->pbs = 0;
 	return DP_SUCCESS;
 }
 
diff --git a/include/net/datapath_api_qos.h b/include/net/datapath_api_qos.h
index ca8f365f7027..525ba514a351 100644
--- a/include/net/datapath_api_qos.h
+++ b/include/net/datapath_api_qos.h
@@ -792,8 +792,20 @@ struct dp_shaper_conf {
 	union dp_node_id id;  /*!< node id for queue/scheduler/port*/
 	u32 cir;  /*!< bandwidth in kbps */
 	u32 pir; /*!< bandwidth in kbps. PPV4 support ?? */
-	u32 cbs;  /*!< cbs. PPV4 support ?? */
-	u32 pbs;  /*!< pbs. PPV4 support ?? */
+	u32 cbs;  /*!< cbs. Shoud be in Bytes, if need 16K burst,
+		   * then need to give 16*1024,
+		   * value should be multiplication of Quanta
+		   * Quanta currenty in PPv4 is 4
+		   * if other values there will be rounding and result
+		   * not accurate
+		   */
+	u32 pbs;  /*!< pbs. Should be in Bytes if need 16K burst,
+		   * then need to give 16*1024,
+		   * value should be multiplication of Quanta
+		   * Quanta currenty in PPv4 is 4
+		   * if other values there will be rounding and result
+		   * not accurate
+		   */
 };
 
 /*! \addtogroup APIs_dp_shaper_conf_set
