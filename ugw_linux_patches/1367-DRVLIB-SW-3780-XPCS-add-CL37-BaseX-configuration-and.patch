+#define SR_MII_AN_ADV_RF_WIDTH			2
+#define SR_MII_AN_ADV_NP_POS			15
+#define SR_MII_AN_ADV_NP_WIDTH			1
 
 #define VR_MII_AN_CTRL_PCS_MODE_POS		1
