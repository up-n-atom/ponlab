 enum {
 	CONN_TYPE_ANEG_DIS = 0,
 	CONN_TYPE_ANEG_MAC = 1,
 	CONN_TYPE_ANEG_PHY = 2,
+	CONN_TYPE_ANEG_BX = 3,
 	CONN_TYPE_MAX,
 };
 
@@ -810,10 +814,17 @@ struct xpcs_prv_data {
 
 	/* ANEG mode
 	 * 0 - disable
