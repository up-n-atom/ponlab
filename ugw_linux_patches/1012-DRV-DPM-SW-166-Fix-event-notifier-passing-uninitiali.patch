From 8e9bf9c715cc984aa9cf9a1aec5fc57d762dce18 Mon Sep 17 00:00:00 2001
From: Shahed Shaikh <shahedx.shaikh@intel.com>
Date: Wed, 12 Feb 2020 11:16:26 +0800
Subject: [PATCH] DRV_DPM_SW-166: Fix event notifier passing uninitialized data
 to dp_event_cb

---
 include/net/datapath_api.h | 16 ++++++++--------
 1 file changed, 8 insertions(+), 8 deletions(-)

diff --git a/include/net/datapath_api.h b/include/net/datapath_api.h
index 0f505dd70faa..a7fcf63ec93d 100644
--- a/include/net/datapath_api.h
+++ b/include/net/datapath_api.h
@@ -1809,25 +1809,25 @@ enum DP_DATA_PORT_TYPE {
 /*! @brief enum DP_EVENT_TYPE to define the different kind of event type
  */
 enum DP_EVENT_TYPE {
-	DP_EVENT_INIT = 0, /*!< event callback for initiazation when first
+	DP_EVENT_INIT = BIT(0), /*!< event callback for initiazation when first
 				 *   network driver register to dp via calling
 				 *   API dp_alloc_port_ext
 				 *   DP will call event callback before
 				 *   allocate port for this request
 				 */
-	DP_EVENT_ALLOC_PORT, /*!< event callback for alloc port */
-	DP_EVENT_DE_ALLOC_PORT, /*!< event callback for de_alloc port
+	DP_EVENT_ALLOC_PORT = BIT(1), /*!< event callback for alloc port */
+	DP_EVENT_DE_ALLOC_PORT = BIT(2), /*!< event callback for de_alloc port
 					  */
-	DP_EVENT_REGISTER_DEV, /*!< event callback for register dev */
-	DP_EVENT_DE_REGISTER_DEV, /*!< event callback for de_register
+	DP_EVENT_REGISTER_DEV = BIT(3), /*!< event callback for register dev */
+	DP_EVENT_DE_REGISTER_DEV = BIT(4), /*!< event callback for de_register
 					    *   dev
 					    */
-	DP_EVENT_REGISTER_SUBIF, /*!< event callback for register subif
+	DP_EVENT_REGISTER_SUBIF = BIT(5), /*!< event callback for register subif
 					  */
-	DP_EVENT_DE_REGISTER_SUBIF, /*!< event callback for de_register
+	DP_EVENT_DE_REGISTER_SUBIF = BIT(6), /*!< event callback for de_register
 					     *   subif
 					     */
-	DP_EVENT_OWNER_SWITCH  /*!< event callback when data port owner
+	DP_EVENT_OWNER_SWITCH = BIT(7) /*!< event callback when data port owner
 					 *   switching between linux and
 					 *   DPDK
 					 */
