From 25352e3e747caabcea0186af99115e8ba1679d6a Mon Sep 17 00:00:00 2001
From: Rekha Eswaran <rekha.eswaran@intel.com>
Date: Tue, 21 Jan 2020 13:35:56 +0800
Subject: [PATCH] DRV_DPM_SW-117 - dp_link_set API enhance for queue
 arbitration setting

---
 drivers/net/datapath/dpm/gswip31/datapath_ppv4_api.c | 18 +++++++++++++++++-
 1 file changed, 17 insertions(+), 1 deletion(-)

diff --git a/drivers/net/datapath/dpm/gswip31/datapath_ppv4_api.c b/drivers/net/datapath/dpm/gswip31/datapath_ppv4_api.c
index 52d89b96b8f6..ef267e24d6e7 100644
--- a/drivers/net/datapath/dpm/gswip31/datapath_ppv4_api.c
+++ b/drivers/net/datapath/dpm/gswip31/datapath_ppv4_api.c
@@ -15,6 +15,8 @@
 
 #define FLUSH_RESTORE_LOOKUP BIT(0)
 
+static int set_parent_arbi(int inst, int node_id, int arbi, int flag);
+
 static struct limit_map limit_maps[] = {
 	{QOS_NO_BANDWIDTH_LIMIT, DP_NO_SHAPER_LIMIT},
 	{QOS_MAX_BANDWIDTH_LIMIT, DP_MAX_SHAPER_LIMIT}
@@ -2368,10 +2370,20 @@ static int dp_link_set(struct dp_node_link *info, int parent_node, int flag)
 	DP_DEBUG(DP_DBG_FLAG_QOS,
 		 "node_stat_update after dp_link_set end\n");
 	dp_map_qid_to_cqmdeq(info, flag);
+	/* Set parent arbitration for Q node */
+	if (info->node_type == DP_NODE_QUEUE) {
+		if (set_parent_arbi(info->inst, node_id, info->arbi, flag)) {
+			pr_err("fail to set arbi:%d in Parent of Q:%d\n",
+			       info->arbi, node_id);
+			return DP_FAILURE;
+		}
+		DP_DEBUG(DP_DBG_FLAG_QOS_DETAIL,
+			 "%s:Q=%d arbi=%d prio=%d\n", __func__,
+			 info->node_id.q_id, info->arbi, info->prio_wfq);
+	}
 ERROR_EXIT:
 
 	devm_kfree(&g_dp_dev->dev, queue_cfg);
-
 	devm_kfree(&g_dp_dev->dev, sched_cfg);
 	return res;
 }
@@ -2416,6 +2428,10 @@ static int set_parent_arbi(int inst, int node_id, int arbi, int flag)
 			pr_err("fail to get port config\n");
 			return DP_FAILURE;
 		}
+		/* QoS port arbitr is WSP mode always except for drop port */
+		if ((arbi == PP_QOS_ARBITRATION_WRR) &&
+				(pid != priv->ppv4_drop_p))
+			return DP_SUCCESS;
 		port_cfg.port_parent_prop.arbitration = arbi;
 		if (qos_port_set(priv->qdev, pid, &port_cfg)) {
 			pr_err("fail to set arbi port:%d parent of node:%d\n",
