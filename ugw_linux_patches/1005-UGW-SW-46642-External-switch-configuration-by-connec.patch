From f67796f123ee2861a2c2678be0efdcc96f1cb6db Mon Sep 17 00:00:00 2001
From: Prashu Pratik <prashu.pratik@intel.com>
Date: Thu, 6 Feb 2020 14:52:09 +0530
Subject: [PATCH] UGW_SW-46642-External switch configuration by connecting
 port6 of GSWIP-L to GSWIP-R

---
 .../net/ethernet/lantiq/switch-api/gsw_flow_core.c |  3 +--
 .../net/ethernet/lantiq/switch-api/gsw_flow_core.h |  2 ++
 drivers/net/ethernet/lantiq/switch-api/gsw_init.c  | 26 ++++++++++++++++++++++
 drivers/net/ethernet/lantiq/switch-api/gsw_init.h  |  3 +++
 4 files changed, 32 insertions(+), 2 deletions(-)

diff --git a/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c b/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c
index 911b137eceb8..7d2ab0bc2235 100644
--- a/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c
+++ b/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c
@@ -3314,8 +3314,7 @@ void *ethsw_api_core_init(ethsw_core_init_t *ethcinit)
 	PrvData->gsw_base = ethcinit->gsw_base_addr;
 
 	/** Get Switch Hardware capablity */
-	if (!PrvData->ext_switch)
-		get_gsw_hw_cap(cdev);
+	get_gsw_hw_cap(cdev);
 
 	/** Initialize Switch Core Function Pointer */
 	ret = gsw_init_fn_ptrs(cdev);
diff --git a/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.h b/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.h
index 670ddc99e275..cc37685c128c 100644
--- a/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.h
+++ b/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.h
@@ -1026,6 +1026,8 @@ typedef struct {
 	struct device_node *master_mii_node; /* MDIO node for Master MDIO */
 	struct mii_bus *master_mii_bus;	/* MII bus for Mater MDIO */
 	struct device *dev;
+	struct regmap *chiptop_base;
+	struct device_node *np;
 #endif
 
 	u16 num_of_pce_tbl;
diff --git a/drivers/net/ethernet/lantiq/switch-api/gsw_init.c b/drivers/net/ethernet/lantiq/switch-api/gsw_init.c
index 921dda9300a7..2150d44a4705 100644
--- a/drivers/net/ethernet/lantiq/switch-api/gsw_init.c
+++ b/drivers/net/ethernet/lantiq/switch-api/gsw_init.c
@@ -54,6 +54,11 @@ extern int DWC_ETH_QOS_mdio_write_direct(int bus_number, bool c45, int phyaddr,
 #define gsw1_w32(x, y)	ltq_w32((x), ((y)))
 #define gsw1_r32(x)			ltq_r32((x))
 
+/* For GRX550 platform only;
+For other platforms, the register might have a different structure*/
+
+#define IFMUX_CFG	0x120
+#define P6_SEL		BIT(20)
 
 void __iomem		*addr_gswl;
 void __iomem		*addr_gswr;
@@ -649,6 +654,23 @@ void gsw_w32(void *cdev, short offset, short shift, short size, u32 value)
 	}
 }
 
+/* Connect port6 of GSWIP-L to GSWIP-R in GRX550 */
+static inline int grx550_mii_port_cfg( ethsw_api_dev_t *prvdata) {
+	unsigned int val = 0;
+
+	/* get chiptop regmap */
+	prvdata->chiptop_base = syscon_regmap_lookup_by_phandle
+				(prvdata->np, "intel,syscon");
+	if (IS_ERR_OR_NULL(prvdata->chiptop_base)) {
+		pr_err("%s: No syscon phandle for chiptop!\n", __func__);
+		return -EINVAL;
+	}
+	regmap_read(prvdata->chiptop_base, IFMUX_CFG, &val);
+	val |= P6_SEL;
+	/* MII Port is connecting to GSWIP-R */
+	regmap_write(prvdata->chiptop_base, IFMUX_CFG, val);
+	return 0;
+}
 
 #ifdef CONFIG_X86_INTEL_CE2700
 void inline gsw_p7_netss_write(void *base, unsigned int off, unsigned int val)
@@ -894,6 +916,7 @@ int ltq_gsw_api_register(struct platform_device *pdev)
 	struct device_node *mdio_node, *node = dev->of_node;
 	struct core_ops *ops = platform_get_drvdata(pdev);
 	ethsw_api_dev_t *prvdata = container_of(ops, ethsw_api_dev_t, ops);
+	prvdata->np = node;
 	/** Clear core_init */
 	memset(&core_init, 0, sizeof(ethsw_core_init_t));
 
@@ -1013,6 +1036,9 @@ int ltq_gsw_api_register(struct platform_device *pdev)
 		}
 		get_device(&prvdata->master_mii_bus->dev);
 		prvdata->master_mii_node = mdio_node;
+		if (of_machine_is_compatible("lantiq,xrx500")) {
+			grx550_mii_port_cfg(prvdata);
+		}
 	}
 
 	if (device_id == LTQ_FLOW_DEV_EXT_AX3000_F24S) {
diff --git a/drivers/net/ethernet/lantiq/switch-api/gsw_init.h b/drivers/net/ethernet/lantiq/switch-api/gsw_init.h
index b683f45fe6c4..c10c8c8cfcc1 100644
--- a/drivers/net/ethernet/lantiq/switch-api/gsw_init.h
+++ b/drivers/net/ethernet/lantiq/switch-api/gsw_init.h
@@ -60,6 +60,9 @@
 #include <linux/delay.h>
 #include <linux/slab.h>
 #include <linux/of_mdio.h>
+#include <linux/regmap.h>
+#include <linux/mfd/syscon.h>
+#include <linux/of.h>
 
 #ifndef CONFIG_X86_INTEL_CE2700
 #include <net/switch_api/lantiq_gsw_api.h>
