From e0a1ea4bacc077297f1278dd08bbe4dcc674fe07 Mon Sep 17 00:00:00 2001
From: arathinx <ayyappanx.rathinam@intel.com>
Date: Thu, 30 Apr 2020 17:37:52 +0800
Subject: [PATCH] PONRTSYS-7139: Wrong LAN serdes configuration

---
 drivers/net/ethernet/lantiq/xpcs/xpcs.c | 92 ++++++++++++++++++++++++++++++---
 drivers/net/ethernet/lantiq/xpcs/xpcs.h | 24 +++++++++
 2 files changed, 110 insertions(+), 6 deletions(-)

diff --git a/drivers/net/ethernet/lantiq/xpcs/xpcs.c b/drivers/net/ethernet/lantiq/xpcs/xpcs.c
index 5af73a8d2ee5..7aad858c7dc6 100644
--- a/drivers/net/ethernet/lantiq/xpcs/xpcs.c
+++ b/drivers/net/ethernet/lantiq/xpcs/xpcs.c
@@ -33,7 +33,20 @@
 #define XPCS_RESET_NAME "xpcs_reset"
 #define POWER_SAVE_MODE "power-save"
 #define XPCS_MAC_IDX	"mac_idx"
-
+#define XPCS_SERDES_CFG	"serdes_cfg"
+#define XPCS_NO_PHY_CALI	"xpcs-no-phy-callibration"
+#define XPCS_RX_RATE	"xpcs-rx-rate"
+#define XPCS_AFE_EN		"xpcs-afe_en"
+#define XPCS_DFE_EN		"xpcs-dfe_en"
+#define XPCS_ADAPT_EN		"xpcs-cont_adapt_en"
+#define XPCS_RX_ATTN_LVL	"xpcs-rx_attn_lvl"
+#define XPCS_CTLE_BOOTS		"xpcs-rx_ctle_boost"
+#define XPCS_CTLE_POLE		"xpcs-rx_ctle_pole"
+#define XPCS_VGA2_GAIN		"xpcs-rx_vga2_gain"
+#define XPCS_VGA1_GAIN		"xpcs-rx_vga1_gain"
+
+#define PHY_BOOST(BOOST, POLE, VGA2, VGA1) \
+		((BOOST << 0) | (POLE << 5) | (VGA2 << 8) | (VGA1 << 12))
 static void xpcs_cl37_an(struct xpcs_prv_data *pdata);
 static void xpcs_cl73_an(struct xpcs_prv_data *pdata);
 static void xpcs_cl72_startup(struct xpcs_prv_data *pdata);
@@ -582,6 +595,9 @@ static int xpcs_teng_xaui_mode(struct xpcs_prv_data *pdata)
 	/* PHY LOS threshold register */
 	XPCS_RGWR(pdata, PMA_RX_GENCTRL3, pdata->mode_cfg->los_thr);
 
+	/* PHY RX attenuation */
+	XPCS_RGWR(pdata, PMA_RX_ATTN_CTRL, pdata->serdes_cfg->rx_attn_lvl);
+
 	/* PHY ctle_pole and boost and gain register */
 	XPCS_RGWR(pdata, PMA_RX_EQ_CTRL0, pdata->mode_cfg->phy_boost_gain_val);
 
@@ -630,6 +646,9 @@ static int xpcs_teng_kr_mode(struct xpcs_prv_data *pdata)
 	/* PHY LOS threshold register */
 	XPCS_RGWR(pdata, PMA_RX_GENCTRL3, pdata->mode_cfg->los_thr);
 
+	/* PHY RX attenuation level register */
+	XPCS_RGWR(pdata, PMA_RX_ATTN_CTRL, pdata->serdes_cfg->rx_attn_lvl);
+
 	/* PHY ctle_pole and boost and gain register */
 	XPCS_RGWR(pdata, PMA_RX_EQ_CTRL0, pdata->mode_cfg->phy_boost_gain_val);
 
@@ -698,6 +717,9 @@ static int xpcs_oneg_xaui_mode(struct xpcs_prv_data *pdata)
 	/* PHY LOS threshold register */
 	XPCS_RGWR(pdata, PMA_RX_GENCTRL3, pdata->mode_cfg->los_thr);
 
+	/* PHY RX attenuation level register */
+	XPCS_RGWR(pdata, PMA_RX_ATTN_CTRL, pdata->serdes_cfg->rx_attn_lvl);
+
 	/* PHY ctle_pole and boost and gain register */
 	XPCS_RGWR(pdata, PMA_RX_EQ_CTRL0, pdata->mode_cfg->phy_boost_gain_val);
 
@@ -780,7 +802,6 @@ static int xpcs_2p5g_sgmii_mode(struct xpcs_prv_data *pdata)
 	XPCS_RGWR_VAL(pdata, PMA_MISC_C0, RX_VREF_CTRL,
 		      pdata->mode_cfg->rx_vref_ctrl);
 
-
 	/* Select CR Para Port This bit select the interface for accessing
 	 * PHY registers: * 0 -JTAG * 1 -CR parallel port This bit should be
 	 * changed only after disabling 'jtag_tck'to PHY.
@@ -901,6 +922,7 @@ static struct xpcs_mode_cfg *xpcs_get_cfg(u32 mode)
 static int xpcs_init(struct xpcs_prv_data *pdata)
 {
 	int ret = XPCS_SUCCESS;
+	struct xpcs_prv_data data_t = {0};
 
 	pdata->pcs_mode = BACKPL_ETH_PCS;
 
@@ -909,7 +931,19 @@ static int xpcs_init(struct xpcs_prv_data *pdata)
 		dev_err(pdata->dev, "XPCS Init: Invalid Mode!\n");
 		return -EINVAL;
 	}
-	ret = pdata->mode_cfg->set_mode(pdata);
+
+	memcpy(&data_t, pdata, sizeof(struct xpcs_prv_data));
+
+	if (data_t.serdes_cfg->f_serdes & RX_ENQ) {
+		pdata->mode_cfg->afe_en = pdata->serdes_cfg->afe_en;
+		pdata->mode_cfg->dfe_en = pdata->serdes_cfg->dfe_en;
+		pdata->mode_cfg->cont_adapt0 = pdata->serdes_cfg->cont_adapt0;
+		pdata->mode_cfg->rx_rate[0] = pdata->serdes_cfg->rx_rate;
+		pdata->mode_cfg->phy_boost_gain_val =
+					pdata->serdes_cfg->phy_boost_gain_val;
+	}
+
+	ret = pdata->mode_cfg->set_mode(&data_t);
 
 	if (ret != XPCS_SUCCESS)
 		dev_info(pdata->dev, "%s: %d :: Failed ::\n",
@@ -940,15 +974,24 @@ static int xpcs_update_cfg(struct device *dev, struct xpcs_mode_cfg *xpcs_cfg,
 static int xpcs_parse_dts(struct platform_device *pdev,
 			  struct xpcs_prv_data **pdata)
 {
+	struct device_node *serdes = pdev->dev.of_node;
+	struct device_node *rx;
 	struct device *dev = &pdev->dev;
 	struct xpcs_mode_cfg *xpcs_cfg = NULL;
 	u32 prop = 0;
 
-	(*pdata) = devm_kzalloc(dev, sizeof(pdata), GFP_KERNEL);
+	(*pdata) = devm_kzalloc(dev, sizeof(**pdata), GFP_KERNEL);
 
 	if (!(*pdata))
 		return -ENOMEM;
 
+	(*pdata)->serdes_cfg = devm_kzalloc(dev,
+					    sizeof(struct xpcs_serdes_cfg),
+					    GFP_KERNEL);
+
+	if (!(*pdata)->serdes_cfg)
+		return -ENOMEM;
+
 	/* Retrieve the xpcs name */
 	if (device_property_read_string(dev, XPCS_MOD_NAME, &(*pdata)->name)) {
 		dev_err(dev, "Xpcs name: cannot get property\n");
@@ -990,6 +1033,41 @@ static int xpcs_parse_dts(struct platform_device *pdev,
 		return -EINVAL;
 	}
 
+	/* Retrieve XPCS SERDES configs */
+	serdes = of_get_child_by_name(serdes, XPCS_SERDES_CFG);
+	if (serdes) {
+		(*pdata)->serdes_cfg->xpcs_no_phy_cali =
+				of_property_read_bool(serdes, XPCS_NO_PHY_CALI);
+		rx = of_get_child_by_name(serdes, "rx_enq");
+		if (rx) {
+			(*pdata)->serdes_cfg->f_serdes = RX_ENQ;
+			if (!of_property_read_u32(rx, XPCS_AFE_EN, &prop))
+				(*pdata)->serdes_cfg->afe_en = prop;
+			if (!of_property_read_u32(rx, XPCS_DFE_EN, &prop))
+				(*pdata)->serdes_cfg->dfe_en = prop;
+			if (!of_property_read_u32(rx, XPCS_ADAPT_EN, &prop))
+				(*pdata)->serdes_cfg->cont_adapt0 = prop;
+			if (!of_property_read_u32(rx, XPCS_RX_ATTN_LVL, &prop))
+				(*pdata)->serdes_cfg->rx_attn_lvl = prop;
+			if (!of_property_read_u32(rx, XPCS_CTLE_BOOTS, &prop))
+				(*pdata)->serdes_cfg->rx_ctle_boost = prop;
+			if (!of_property_read_u32(rx, XPCS_CTLE_POLE, &prop))
+				(*pdata)->serdes_cfg->rx_ctle_pole = prop;
+			if (!of_property_read_u32(rx, XPCS_VGA2_GAIN, &prop))
+				(*pdata)->serdes_cfg->rx_vga2_gain = prop;
+			if (!of_property_read_u32(rx, XPCS_VGA1_GAIN, &prop))
+				(*pdata)->serdes_cfg->rx_vga1_gain = prop;
+			if (!of_property_read_u32(rx, XPCS_RX_RATE, &prop))
+				(*pdata)->serdes_cfg->rx_rate = prop;
+
+			prop = PHY_BOOST((*pdata)->serdes_cfg->rx_ctle_boost,
+					 (*pdata)->serdes_cfg->rx_ctle_pole,
+					 (*pdata)->serdes_cfg->rx_vga2_gain,
+					 (*pdata)->serdes_cfg->rx_vga1_gain);
+			(*pdata)->serdes_cfg->phy_boost_gain_val = prop;
+		}
+	}
+
 	xpcs_cfg = xpcs_get_cfg(ONEG_XAUI_MODE);
 	xpcs_update_cfg(dev, xpcs_cfg, "serdes_1g_cfg");
 
@@ -1094,7 +1172,8 @@ static int xpcs_power_on(struct device *dev)
 
 	pdata->state = 1;
 
-	ret = phy_calibrate(phy);
+	if (!pdata->serdes_cfg->xpcs_no_phy_cali)
+		ret = phy_calibrate(phy);
 
 	return ret;
 }
@@ -1273,7 +1352,8 @@ static int xpcs_probe(struct platform_device *pdev)
 	}
 
 	/* Phy calibrate for RX Signal Adaption */
-	ret = phy_calibrate(pdata->phy);
+	if (!pdata->serdes_cfg->xpcs_no_phy_cali)
+		ret = phy_calibrate(pdata->phy);
 
 	return XPCS_SUCCESS;
 }
diff --git a/drivers/net/ethernet/lantiq/xpcs/xpcs.h b/drivers/net/ethernet/lantiq/xpcs/xpcs.h
index a43cd1368e24..63ae6e726ef3 100644
--- a/drivers/net/ethernet/lantiq/xpcs/xpcs.h
+++ b/drivers/net/ethernet/lantiq/xpcs/xpcs.h
@@ -612,6 +612,11 @@ enum {
 	PCS_TYPE_RESERVED,
 };
 
+enum {
+	RX_ENQ = 1,
+	TX_ENQ
+};
+
 struct xpcs_prv_data;
 
 /* 10G XAUI Mode Switching */
@@ -658,6 +663,22 @@ struct xpcs_mode_cfg {
 	int (*set_mode)(struct xpcs_prv_data *);
 };
 
+/* Port specific XPCS SERDES cfg */
+struct xpcs_serdes_cfg {
+	u32 f_serdes;
+	u32 xpcs_no_phy_cali;
+	u32 rx_rate;
+	u32 afe_en;
+	u32 dfe_en;
+	u32 cont_adapt0;
+	u32 rx_attn_lvl;
+	u32 rx_ctle_boost;
+	u32 rx_ctle_pole;
+	u32 rx_vga2_gain;
+	u32 rx_vga1_gain;
+	u32 phy_boost_gain_val;
+};
+
 struct xpcs_ops {
 	int (*ethtool_ksettings_get)(struct device *dev,
 				     struct ethtool_link_ksettings *cmd);
@@ -711,6 +732,9 @@ struct xpcs_prv_data {
 
 	/* XPCS Mode Switching */
 	struct xpcs_mode_cfg *mode_cfg;
+
+	/* XPCS SERDES cfg */
+	struct xpcs_serdes_cfg *serdes_cfg;
 };
 
 #define xpcs_r32(reg)		readl(reg)
