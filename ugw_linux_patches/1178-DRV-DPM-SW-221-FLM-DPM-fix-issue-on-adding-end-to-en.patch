 .../net/datapath/dpm/gswip31/datapath_ppv4_api.c   | 193 +++++----------------
 2 files changed, 150 insertions(+), 148 deletions(-)

diff --git a/drivers/net/datapath/dpm/datapath_proc_qos.c b/drivers/net/datapath/dpm/datapath_proc_qos.c
index 4c72dc5aa79e..5667c8184b30 100644
