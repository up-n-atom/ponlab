From 91135f8529c7b6d174250d520cc9ac14def663eb Mon Sep 17 00:00:00 2001
From: Dinesh Sudham <dineshx.sudham@intel.com>
Date: Wed, 3 Jun 2020 12:00:50 +0800
Subject: [PATCH] DRVLIB_SW-3656-GSWAPI: klocwork fixes in switch and xpcs
 driver

Signed-off-by: Dinesh Sudham <dineshx.sudham@intel.com>
---
 drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c | 11 +++++++----
 drivers/net/ethernet/lantiq/xpcs/xpcs.c                |  9 +++++++--
 include/net/switch_api/lantiq_gsw.h                    |  4 +++-
 3 files changed, 17 insertions(+), 7 deletions(-)

diff --git a/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c b/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c
index 6332faac353e..75fab6fba0db 100644
--- a/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c
+++ b/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c
@@ -1352,8 +1352,7 @@ static int gsw3x_msw_table_rm(void *cdev, GSW_multicastTable_t *parm)
 		return GSW_statusErr;
 	}
 
-	if ((parm->eModeMember < GSW_IGMP_MEMBER_INCLUDE) ||
-	    (parm->eModeMember > GSW_IGMP_MEMBER_DONT_CARE)) {
+	if (parm->eModeMember >= GSW_IGMP_MEMBER_INVALID) {
 		pr_err("%s:%s:%d (!!!)\n", __FILE__, __func__, __LINE__);
 		return GSW_statusErr;
 	}
@@ -1695,8 +1694,7 @@ static int gsw2x_msw_table_rm(void *cdev, GSW_multicastTable_t *parm)
 		return GSW_statusErr;
 	}
 
-	if ((parm->eModeMember < GSW_IGMP_MEMBER_INCLUDE) ||
-	    (parm->eModeMember > GSW_IGMP_MEMBER_DONT_CARE)) {
+	if (parm->eModeMember >= GSW_IGMP_MEMBER_INVALID) {
 		pr_err("%s:%s:%d (!!!)\n", __FILE__, __func__, __LINE__);
 		return GSW_statusErr;
 	}
@@ -2714,6 +2712,11 @@ u32 gsw_aging_get(void *cdev)
 
 	BUG_ON(!cdev);
 
+	if (!gswdev) {
+		pr_err("%s:%s:%d", __FILE__, __func__, __LINE__);
+		return GSW_statusErr;
+	}
+
 	gsw_r32(cdev, PCE_AGE_1_MANT_OFFSET, PCE_AGE_1_MANT_SHIFT,
 		PCE_AGE_1_MANT_SIZE, &mant);
 	gsw_r32(cdev, PCE_AGE_0_EXP_OFFSET, PCE_AGE_0_EXP_SHIFT,
diff --git a/drivers/net/ethernet/lantiq/xpcs/xpcs.c b/drivers/net/ethernet/lantiq/xpcs/xpcs.c
index 8c8064fd57f3..db8edb786d67 100644
--- a/drivers/net/ethernet/lantiq/xpcs/xpcs.c
+++ b/drivers/net/ethernet/lantiq/xpcs/xpcs.c
@@ -1373,11 +1373,16 @@ static int xpcs_parse_dts(struct platform_device *pdev,
 
 static int xpcs_reset(struct device *dev)
 {
+	int err;
 	struct xpcs_prv_data *pdata = dev_get_drvdata(dev);
 
-	reset_control_assert(pdata->xpcs_rst);
+	err = reset_control_assert(pdata->xpcs_rst);
+	if (err)
+		return err;
 	udelay(1);
-	reset_control_deassert(pdata->xpcs_rst);
+	err = reset_control_deassert(pdata->xpcs_rst);
+	if (err)
+		return err;
 
 	return 0;
 }
diff --git a/include/net/switch_api/lantiq_gsw.h b/include/net/switch_api/lantiq_gsw.h
index 7b3cefcd5fa1..9893cd16e8b0 100644
--- a/include/net/switch_api/lantiq_gsw.h
+++ b/include/net/switch_api/lantiq_gsw.h
@@ -1629,7 +1629,9 @@ typedef enum {
 	/** Group source IP address is 'don't care'. This means all source IP
 	    addresses (*) are included for the multicast group membership.
 	    This is the default mode for IGMPv1 and IGMPv2. */
-	GSW_IGMP_MEMBER_DONT_CARE	= 2
+	GSW_IGMP_MEMBER_DONT_CARE	= 2,
+
+	GSW_IGMP_MEMBER_INVALID,
 } GSW_IGMP_MemberMode_t;
 
 /** \brief Add a host as a member to a multicast group.
