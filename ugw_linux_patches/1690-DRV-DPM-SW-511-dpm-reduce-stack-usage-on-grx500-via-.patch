-			p[len] = ' ';
-		}
-	}
-
-	for (i = box->l.y1 + 1; i < box->l.y2 - 1; i++) {
-		p = &buf[cols * i];
-		p[box->l.x1] = '|';
-	}
-	for (i = box->l.y1 + 1; i < box->l.y2 - 1; i++) {
-		p = &buf[cols * i];
