-
-	if (switchdev_trans_ph_prepare(trans)) {
-		br_item = kmem_cache_zalloc(cache_br_entry_list, GFP_ATOMIC);
-		if (!br_item)
-			/* TODO need to check dequeue if no memory */
-			return -ENOMEM;
-
-		rcu_read_lock();
-
-		br_info = dp_swdev_bridge_entry_lookup_rcu(br_dev);
-		if (br_info) {
-			br_item->flags = BRIDGE_NO_ACTION;
-			br_item->dp_port = subif.port_id;
