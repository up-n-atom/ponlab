diff --git a/drivers/net/datapath/dpm/datapath_api.c b/drivers/net/datapath/dpm/datapath_api.c
index 4b1e886ea25f..5decf28047cb 100644
--- a/drivers/net/datapath/dpm/datapath_api.c
+++ b/drivers/net/datapath/dpm/datapath_api.c
@@ -1955,108 +1955,6 @@ static int dp_build_cqm_data(int inst, u32 port_id,
 static int dp_register_dc(int inst, u32 port_id,
 			  struct dp_dev_data *data, u32 flags)
 {
-	struct pmac_port_info *port = get_dp_port_info(inst, port_id);
-#if !IS_ENABLED(CONFIG_INTEL_DATAPATH_HAL_GSWIP30)
-	struct cqm_port_info *deq;
-	struct umt_port_res *res;
-	struct umt_ops *ops = dp_get_umt_ops(inst);
-#endif
-	int i, ret = DP_SUCCESS;
-
-	if (!data->num_rx_ring)
-		return DP_SUCCESS;
-
-	/* Fill in the output data to the the DCDP driver for the RX rings
-	 * and Save Info for debugging
-	 */
-	for (i = 0; i < data->num_rx_ring; i++)
-		port->rx_ring[i] = data->rx_ring[i];
-
-	for (i = 0; i < data->num_tx_ring; i++)
-		port->tx_ring[i] = data->tx_ring[i];
-
-	/* Save info for debugging */
-	port->num_rx_ring = data->num_rx_ring;
-	port->num_tx_ring = data->num_tx_ring;
-	port->rx_policy_base = data->rx_ring[0].rx_policy_base;
-	port->rx_policy_num = data->rx_ring[0].policy_num;
-	if (!port->rx_policy_num)
-		port->rx_policy_num = 1;
-
-	if (data->num_tx_ring) {
-		port->tx_policy_base = data->tx_ring[0].txout_policy_base;
-		port->tx_policy_num = data->tx_ring[0].policy_num;
-	} else {
-		port->tx_policy_base = port->rx_policy_base;
-		port->tx_policy_num = port->rx_policy_num;
-	}
-
-	/* UMT Interface is not supported for old products */
-	if (get_dp_port_prop(inst)->info.type == GSWIP30_TYPE)
-		return DP_SUCCESS;
-
-	port->num_umt_port = min(data->num_umt_port, data->num_rx_ring);
-
-#if !IS_ENABLED(CONFIG_INTEL_DATAPATH_HAL_GSWIP30)
-	if (!ops) {
-		pr_err("No UMT driver registered\n");
-		return -ENODEV;
-	}
-
-	for (i = 0; i < port->num_umt_port; i++) {
-		res = &data->umt[i].res;
-		res->cqm_dq_pid = port->deq_port_base + i;
-
-		/* For PRX300, RXOUT is to DMA Channel,
-		 * For LGM, RXOUT is to CQEM Deq port
-		 */
-		if (is_soc_prx(inst)) {
-			res->rx_src = UMT_RX_SRC_DMA;
-			res->dma_id = data->rx_ring[0].out_dma_ch_to_gswip;
-		}
-
-		res->cqm_enq_pid = data->rx_ring[i].out_enq_port_id;
-		res->dma_ch_num = data->rx_ring[i].num_out_tx_dma_ch;
-
-		deq = get_dp_deqport_info(inst, res->cqm_dq_pid);
-		if (deq->ref_cnt_umt++) {
-			port->umt[i] = data->umt[i];
-			continue;
-		}
-
-		if (is_soc_lgm(inst)) {
-			ret = ops->umt_alloc(ops->umt_dev, &data->umt[i]);
-			if (ret < 0) {
-				pr_err("%s: umt %d alloc failed with %d\n",
-				       __func__, i, ret);
-				return DP_FAILURE;
-			}
-		}
-
-		ret = ops->umt_request(ops->umt_dev, &data->umt[i]);
-		port->umt[i] = data->umt[i];
-		if (ret) {
-			pr_err("%s: umt %d request failed with %d\n",
-			       __func__, i, ret);
-			return DP_FAILURE;
-		}
-
-		if (data->flag_ops & DP_F_DEV_NO_BM_DUMMY_READ)
-			continue;
-
-#if IS_ENABLED(CONFIG_INTEL_DATAPATH_HAL_GSWIP32)
-		/* do a dummy read of buffers to trigger the UMT */
-		if (cqm_dc_buffer_dummy_request(res->cqm_enq_pid,
-						res->cqm_dq_pid)) {
-			pr_err("%s: dc enq dummy buf req failed on port %d\n",
-			       __func__, res->cqm_enq_pid);
-			return DP_FAILURE;
-		}
-		pr_info("dc enq dummy buffer req succeeded on port %d\n",
-			res->cqm_enq_pid);
-#endif
-	}
-#endif
 	return DP_SUCCESS;
 }
 
