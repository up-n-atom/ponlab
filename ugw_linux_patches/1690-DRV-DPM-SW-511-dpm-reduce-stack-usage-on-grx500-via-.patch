-#endif
-
-	p = buf;
-	for (i = 0; i < rows; i++)
-		buf[((i + 1) * cols) - 1] = 0;
-
-	/* print port box */
-	virtual_print_box(&q_info->port_box, NULL, buf, rows, cols);
