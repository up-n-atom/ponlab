-#define PRINT_QOS_DETAIL  0
-void print_all(struct seq_file *s, struct q_print_info *q_info)
-{
-	int cols = q_info->port_box.l.x2 + PORT_BOX_SUFFIX;
-	int rows = q_info->port_box.l.y2 + 1;
-	int i;
-	char *buf;
-	char *p;
-
-	if (cols <= 0)
-		return;
