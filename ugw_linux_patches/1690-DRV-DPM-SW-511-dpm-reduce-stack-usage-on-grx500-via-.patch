-static int get_prio(int inst, int id, enum dp_node_type type, int *p)
-{
-	struct dp_node_prio prio = {0};
-
-	if (id == DP_NODE_AUTO_ID)
-		return DP_SUCCESS;
-	prio.inst = inst;
-	prio.type = type;
-	prio.id.sch_id = id;
-	if (dp_qos_link_prio_get(&prio, 0)) {
-		pr_err("%s: fail to get priority of node %d\n", __func__, id);
-		return DP_FAILURE;
-	}
-	if (p)
-		*p = prio.prio_wfq;
-	return DP_SUCCESS;
-}
