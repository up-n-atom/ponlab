-			} else { /* sched box */
-				len = snprintf(p, BOX_WIDTH - 3,
-					       "sched[/%d]",  box->node);
-				stat = get_node_stat(box->node, DP_NODE_SCH);
-				info = get_node_pri(box->node, DP_NODE_SCH);
-				shaper.id.sch_id = box->node;
