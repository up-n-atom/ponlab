+ * @param [in] flag unsigned int flag
+ * @return [out] integer value: return DP_SUCCESS if succeed,
+ *                              otherwise, return DP_FAILURE
+ */
+int dp_queue_map_get(struct dp_queue_map_get *cfg, int flag);
