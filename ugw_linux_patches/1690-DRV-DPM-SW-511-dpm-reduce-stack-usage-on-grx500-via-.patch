+int dp_shaper_conf_set(struct dp_shaper_conf *cfg, int flag);
+/*!
+ *  @brief function to get shaper configuration based on its node
+ */
+int dp_shaper_conf_get(struct dp_shaper_conf *cfg, int flag);
+/*! @} */
+
+/*! @brief dp_node_alloc */
+struct dp_node_alloc {
