-	DP_DEBUG(DP_DBG_FLAG_OPS, "switchdev_ops %s for %s\n",
-		 reset ? "reset" : "update", dev->name);
-	dp_dev = dp_dev_lookup(dev);
-	if (!dp_dev)
-		return DP_FAILURE;
-	inst_info = get_dp_prop_info(dp_dev->inst);
