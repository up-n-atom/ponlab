+/*! @brief dp_qos_level */
+struct dp_qos_level {
+	int inst; /* input: dp instance. For SOC side, it is always zero */
+	int max_sch_lvl; /* output: max scheduler level */
+};
+
+/*! \ingroup dp_qos_level_get
+ * @brief function dp_qos_level_get
