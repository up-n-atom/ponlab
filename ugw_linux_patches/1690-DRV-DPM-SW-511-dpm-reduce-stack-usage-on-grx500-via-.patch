+ */
+int dp_ingress_ctp_tc_map_set(struct dp_tc_cfg *tc, int flag);
+
+/*!
+ * @struct dp_qos_cfg_info
+ *
+ * Structure defining the global QoS config info
+ *
+ */
+struct dp_qos_cfg_info {
+	int inst; /*!< input: dp instance. For SOC side, it is always zero */
