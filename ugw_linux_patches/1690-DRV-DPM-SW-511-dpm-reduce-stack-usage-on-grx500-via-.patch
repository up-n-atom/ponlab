-	for (i = 0; i < cnt; i++) {
-		/* get qos resource and store into tmp_res */
-		if (!print_qos_entry(s, pos, i))
-			break;
-		if (seq_has_overflowed(s))
-			return pos;
-	}
-#if IS_ENABLED(CONFIG_INTEL_DATAPATH_HAL_GSWIP32)
-	/* CPU special path */
-	if (pos == 0) {
