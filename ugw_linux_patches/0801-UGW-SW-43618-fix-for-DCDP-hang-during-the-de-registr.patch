From 3a912dc2ac11947711f0e5882cb022a8bdb8cc07 Mon Sep 17 00:00:00 2001
From: sureshna <suresh.nagaraj@intel.com>
Date: Wed, 25 Sep 2019 19:24:41 +0530
Subject: [PATCH] UGW_SW-43618: fix for DCDP hang during the de-registration
 after showtime drop

---
 net/bridge/br_fdb.c | 12 ++++++++----
 1 file changed, 8 insertions(+), 4 deletions(-)

diff --git a/net/bridge/br_fdb.c b/net/bridge/br_fdb.c
index 26ab0a17bb0b..6c0cd4ca6896 100644
--- a/net/bridge/br_fdb.c
+++ b/net/bridge/br_fdb.c
@@ -1083,10 +1083,14 @@ int dc_dp_br_fdb_delete(struct net_device *dev, const unsigned char *addr)
 	if (!dev)
 		return -EINVAL;
 
-	p = br_port_get_rcu(dev);
-	if (!p) {
-		pr_info("bridge: %s not a bridge port\n",
-			dev->name);
+	if (br_port_exists(dev)) {
+		p = br_port_get_rcu(dev);
+		if (!p) {
+			pr_debug("bridge: %s not a bridge port\n",
+				dev->name);
+			return -EINVAL;
+		}
+	} else {
 		return -EINVAL;
 	}
 
