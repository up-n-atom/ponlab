From a6bfa3cd196aa097e5e446483f8c2baf60966af8 Mon Sep 17 00:00:00 2001
From: Rekha Eswaran <rekha.eswaran@intel.com>
Date: Wed, 5 Aug 2020 13:38:11 +0800
Subject: [PATCH] DRV_DPM_SW-354 - DPM tx rx debug data dump in wireshark
 format

---
 drivers/net/datapath/dpm/datapath_misc.c | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/drivers/net/datapath/dpm/datapath_misc.c b/drivers/net/datapath/dpm/datapath_misc.c
index f9595cd82469..fbba54c8b63a 100644
--- a/drivers/net/datapath/dpm/datapath_misc.c
+++ b/drivers/net/datapath/dpm/datapath_misc.c
@@ -172,7 +172,7 @@ void dp_dump_raw_data(const void *buf, int len, char *prefix_str)
 		pr_err("dp_dump_raw_data: p NULL ?\n");
 		return;
 	}
-	s = devm_kzalloc(&g_dp_dev->dev, bytes, GFP_ATOMIC);
+	s = kzalloc(bytes, GFP_ATOMIC);
 	if (!s)
 		return;
 	sprintf(s, "%s in hex at 0x%px\n",
@@ -180,13 +180,13 @@ void dp_dump_raw_data(const void *buf, int len, char *prefix_str)
 	pr_info("%s", s);
 
 	for (i = 0; i < len; i += line_num) {
-		l = sprintf(s, " %06d: ", i);
+		l = sprintf(s, " %06x ", i);
 		for (j = 0; (j < line_num) && (i + j < len); j++)
 			l += sprintf(s + l, "%02x ", p[i + j]);
 		sprintf(s + l, "\n");
 		pr_info("%s", s);
 	}
-	devm_kfree(&g_dp_dev->dev, s);
+	kfree(s);
 }
 EXPORT_SYMBOL(dp_dump_raw_data);
 
