From 221a760636fffef3b2f9e13cd7223fe95b5140be Mon Sep 17 00:00:00 2001
From: Lishan Liu <lishan.liu@intel.com>
Date: Mon, 3 Aug 2020 14:06:23 +0800
Subject: [PATCH] DRVLIB_SW-3708: CQM impl cbm_dp_get_dc_config api

---
 drivers/net/ethernet/lantiq/cqm/cbm_wrapper.c |  5 ++++-
 drivers/net/ethernet/lantiq/cqm/cqm_common.h  |  1 +
 drivers/net/ethernet/lantiq/cqm/prx300/cqm.c  | 27 +++++++++++++++++++++++++++
 3 files changed, 32 insertions(+), 1 deletion(-)

diff --git a/drivers/net/ethernet/lantiq/cqm/cbm_wrapper.c b/drivers/net/ethernet/lantiq/cqm/cbm_wrapper.c
index ec8777d5316b..ebe83b8e948c 100644
--- a/drivers/net/ethernet/lantiq/cqm/cbm_wrapper.c
+++ b/drivers/net/ethernet/lantiq/cqm/cbm_wrapper.c
@@ -565,7 +565,10 @@ EXPORT_SYMBOL(pon_deq_cntr_get);
 
 int cbm_dp_get_dc_config(struct cbm_dc_res *res, int flag)
 {
-	return CBM_FAILURE;
+	if (g_cbm_ops && g_cbm_ops->cbm_dp_get_dc_config)
+		return g_cbm_ops->cbm_dp_get_dc_config(res, flag);
+	else
+		return CBM_FAILURE;
 }
 EXPORT_SYMBOL(cbm_dp_get_dc_config);
 
diff --git a/drivers/net/ethernet/lantiq/cqm/cqm_common.h b/drivers/net/ethernet/lantiq/cqm/cqm_common.h
index 5ebe8c740ae9..cc15489e24d5 100644
--- a/drivers/net/ethernet/lantiq/cqm/cqm_common.h
+++ b/drivers/net/ethernet/lantiq/cqm/cqm_common.h
@@ -203,6 +203,7 @@ struct cbm_ops {
 	int (*cbm_turn_on_DMA_p2p)(void);
 	s32 (*cbm_enable_backpressure)(s32 port_id, bool flag);
 	s32 (*cbm_get_mtu_size)(u32 *mtu_size);
+	int (*cbm_dp_get_dc_config)(struct cbm_dc_res *res, int flag);
 };
 
 static inline void set_val(void __iomem *reg, u32 val, u32 mask, u32 offset)
diff --git a/drivers/net/ethernet/lantiq/cqm/prx300/cqm.c b/drivers/net/ethernet/lantiq/cqm/prx300/cqm.c
index 6e99badf93c1..9a25a2617214 100644
--- a/drivers/net/ethernet/lantiq/cqm/prx300/cqm.c
+++ b/drivers/net/ethernet/lantiq/cqm/prx300/cqm.c
@@ -3526,6 +3526,32 @@ static int get_bufsize(int size)
 	return 0;
 }
 
+static int cqm_get_dc_config(struct cbm_dc_res *dc_res, int flag)
+{
+	struct cqm_pmac_port_map *ptr = NULL;
+	struct cqm_dqm_port_info *dqp_info = dqm_port_info;
+	struct cqm_res_t *res = NULL;
+	u32 num, cbm_port;
+
+	if (dc_res->alloc_flags & FLAG_ACA) {
+		if ((dp_port_resources_get(&dc_res->dp_port, &num, &res,
+					   0) != 0) && (!res)) {
+			dev_err(cqm_ctrl->dev,
+				"Error getting resources for port_id %d\n",
+				dc_res->dp_port);
+			return CBM_FAILURE;
+		}
+		cbm_port = res[0].cqm_deq_port;
+		dc_res->rx_res.rx_bufs = 0x40;
+		dc_res->tx_res.tx_bufs = 0x40;
+		dc_res->tx_res.in_deq_ring_size =
+			dqp_info[cbm_port].deq_info.num_desc;
+		dc_res->tx_res.out_free_ring_size =
+			dqp_info[cbm_port].deq_info.num_free_burst;
+	}
+	return CBM_SUCCESS;
+}
+
 static int pool_config(struct platform_device *pdev, int p, u32 buf_size,
 		       u32 buf_num)
 {
@@ -4256,6 +4282,7 @@ static const struct cbm_ops cqm_ops = {
 	.get_lookup_qid_via_index = get_lookup_qid_via_idx_prx300,
 	.cbm_enable_backpressure = enable_backpressure,
 	.cbm_get_mtu_size = cqm_get_mtu_size,
+	.cbm_dp_get_dc_config = cqm_get_dc_config,
 };
 
 static const struct of_device_id cqm_prx300_match[] = {
