From 2c6fca09214d94bfbb9af902adeed24eeb6dd62e Mon Sep 17 00:00:00 2001
From: Jack Ping CHNG <jack.ping.chng@linux.intel.com>
Date: Fri, 22 May 2020 14:26:51 +0800
Subject: [PATCH] DRV_DPM_SW-275: DPM Fix klockwork warning in dp_inst_del_dev

---
 drivers/net/datapath/dpm/datapath_instance.c | 15 +++++++--------
 1 file changed, 7 insertions(+), 8 deletions(-)

diff --git a/drivers/net/datapath/dpm/datapath_instance.c b/drivers/net/datapath/dpm/datapath_instance.c
index 62ed4b0764b5..082c1e7387b8 100644
--- a/drivers/net/datapath/dpm/datapath_instance.c
+++ b/drivers/net/datapath/dpm/datapath_instance.c
@@ -352,10 +352,12 @@ int dp_inst_del_dev(struct net_device *dev, char *subif_name, int inst,
 
 			if (!dp_dev->count) {
 #if IS_ENABLED(CONFIG_INTEL_DATAPATH_SWITCHDEV)
+				if (!dev)
+					goto REMOVE;
 				if (netif_is_bridge_port(dev)) {
 					struct net_device *br_dev;
 					struct inst_info *dp_info;
-					int inst, lock = 0;
+					int inst;
 					u8 *addr;
 
 					inst = dp_dev->inst;
@@ -363,18 +365,15 @@ int dp_inst_del_dev(struct net_device *dev, char *subif_name, int inst,
 					dp_info = get_dp_prop_info(inst);
 					dp_info->dp_mac_reset(0, dp_dev->fid,
 							      inst, addr);
-					if (!rtnl_is_locked()) {
-						rtnl_lock();
-						lock = 1;
-					}
+					rcu_read_lock();
 					br_dev =
-					      netdev_master_upper_dev_get(dev);
+					   netdev_master_upper_dev_get_rcu(dev);
 					if (br_dev)
 						dp_del_br_if(dev, br_dev, inst,
 							     dp_dev->bp);
-					if (lock)
-						rtnl_unlock();
+					rcu_read_unlock();
 				}
+REMOVE:
 #endif
 				hlist_del(&dp_dev->hlist);
 				if (dev)
