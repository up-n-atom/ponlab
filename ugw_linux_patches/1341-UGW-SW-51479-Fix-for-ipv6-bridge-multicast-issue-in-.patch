From b7e9308acee482212c1c856f9d6ea77f81118c83 Mon Sep 17 00:00:00 2001
From: gsupriya <supriya1.g@intel.com>
Date: Sun, 19 Jul 2020 21:25:13 +0530
Subject: [PATCH] UGW_SW-51479: Fix for ipv6 bridge multicast issue in
 mcast_helper

---
 net/mcast_helper/mcast_helper.c | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/net/mcast_helper/mcast_helper.c b/net/mcast_helper/mcast_helper.c
index bf1ad1e1feda..58b0e3292ac7 100644
--- a/net/mcast_helper/mcast_helper.c
+++ b/net/mcast_helper/mcast_helper.c
@@ -438,7 +438,8 @@ static void mcast_helper_five_tuple_info6(struct sk_buff *skb, char iface_name[I
 {
 	int index;
 	struct ipv6hdr *ip6h = ipv6_hdr(skb);
-	struct udphdr *udph = udp_hdr(skb);
+	/* IP packet received from ip6mr.c hook, cannot use udp_hdr() directly to get udp details*/
+	struct udphdr *udph = (struct udphdr *)((u8 *)ip6h + IP6_HDR_LEN);
 	const unsigned char *dest = eth_hdr(skb)->h_dest;
 
 	if (is_multicast_ether_addr(dest)) {
@@ -526,7 +527,8 @@ static void mcast_helper_five_tuple_br_info(struct sk_buff *skb)
 		}
 	} else if (skb->protocol == htons(ETH_P_IPV6)) {
 		struct ipv6hdr *iph6 = ipv6_hdr(skb);
-		struct udphdr *udph6 = udp_hdr(skb);
+		/*IP packet received from bridge hook, cannot use udp_hdr() directly to get udp details*/
+		struct udphdr *udph6 = (struct udphdr *)((u8 *)iph6 + IP6_HDR_LEN);
 		gimc_list = mcast_helper_list_p(IPV6) ;
 
 		mcast_helper_init_ipaddr(&saddr, IPV6, &iph6->saddr);
@@ -632,7 +634,8 @@ static void mcast_helper_five_tuple_br_hook(struct sk_buff *skb)
 	else if (skb->protocol == htons(ETH_P_IPV6)) {
 		uint8_t src_mac[ETH_ALEN] = { 0 };
 		struct ipv6hdr *iph6 = ipv6_hdr(skb);
-		struct udphdr *udph6 = udp_hdr(skb);
+		/*IP packet received from bridge hook, cannot use udp_hdr() directly to get udp details*/
+		struct udphdr *udph6 = (struct udphdr *)((u8 *)iph6 + IP6_HDR_LEN);
 		gimc_list = mcast_helper_session_p(IPV6);
 
 		mcast_helper_init_ipaddr(&saddr, IPV6, &iph6->saddr);
