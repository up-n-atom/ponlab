From 6fe9508aa5b432bdc9fa198b288d0c90a9359935 Mon Sep 17 00:00:00 2001
From: thampan <joby.thampan@intel.com>
Date: Fri, 13 Mar 2020 13:51:01 +0800
Subject: [PATCH] DRV_DPM_SW-201: bugfix in dp_sync_subifid_priv

---
 drivers/net/datapath/dpm/datapath_misc.c | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/drivers/net/datapath/dpm/datapath_misc.c b/drivers/net/datapath/dpm/datapath_misc.c
index 4af020c5c629..c4f6f3d99a5a 100644
--- a/drivers/net/datapath/dpm/datapath_misc.c
+++ b/drivers/net/datapath/dpm/datapath_misc.c
@@ -983,6 +983,7 @@ int32_t dp_sync_subifid_priv(struct net_device *dev, char *subif_name,
 	void *subif_data = NULL;
 	struct pmac_port_info *port;
 	struct dp_subif_info *sif;
+	u16 vap = 0;
 
 	/* Note: workaround to set dummy subif_data via subif_name for DSL case.
 	 *       During dp_get_netif_subifID, subif_data is used to get its PVC
@@ -1012,7 +1013,10 @@ int32_t dp_sync_subifid_priv(struct net_device *dev, char *subif_name,
 			dp_update_subif(dev, subif_data, &subif_id[0],
 					subif_name, flags, subifid_fn);
 
-			sif = get_dp_port_subif(port, subif_id->subif);
+			vap = GET_VAP(subif_id->subif, port->vap_offset,
+				      port->vap_mask);
+			
+			sif = get_dp_port_subif(port, vap);
 
 			if (get_dp_bp_info(0, sif->bp)->ref_cnt <= 1)
 				dp_notifier_invoke(0, dev, subif_id->port_id,
