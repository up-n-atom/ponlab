From 052cc9f13812a20b25c6a810f02885f730136274 Mon Sep 17 00:00:00 2001
From: Lishan Liu <lishan.liu@intel.com>
Date: Wed, 18 Dec 2019 10:51:07 +0800
Subject: [PATCH] resolve klocwork warning in clk driver

---
 drivers/clk/intel/clk-cgu-pll.c | 5 +++++
 drivers/clk/intel/clk-prx300.c  | 7 +++++--
 2 files changed, 10 insertions(+), 2 deletions(-)

diff --git a/drivers/clk/intel/clk-cgu-pll.c b/drivers/clk/intel/clk-cgu-pll.c
index 32338ecd7753..1309580ee13a 100644
--- a/drivers/clk/intel/clk-cgu-pll.c
+++ b/drivers/clk/intel/clk-cgu-pll.c
@@ -153,6 +153,7 @@ int intel_clk_register_early(struct intel_clk_provider *ctx,
 		} else {
 			pr_err("%s: platform not support: %u\n",
 			       __func__, list->platform);
+			kfree(early);
 			return -EINVAL;
 		}
 
@@ -268,6 +269,10 @@ prx300_pll_recalc_rate(struct clk_hw *hw, unsigned long prate)
 	unsigned int div, mult, frac;
 
 	prx300_pll_get_params(pll, &mult, &div, &frac);
+	if (!div) {
+		pr_err("clk: %s div is ZERO!\n", clk_hw_get_name(hw));
+		div = 1; /* div by zero Error workaround */
+	}
 	if (pll->type == TYPE_LJPLL)
 		div *= 4;
 
diff --git a/drivers/clk/intel/clk-prx300.c b/drivers/clk/intel/clk-prx300.c
index f64e84dc131a..03b37ee397ae 100644
--- a/drivers/clk/intel/clk-prx300.c
+++ b/drivers/clk/intel/clk-prx300.c
@@ -9,6 +9,7 @@
 #include <linux/of_address.h>
 #include <linux/platform_device.h>
 #include <linux/regmap.h>
+#include <linux/slab.h>
 #include <linux/spinlock.h>
 #include <dt-bindings/clock/intel,prx300-clk.h>
 
@@ -270,14 +271,16 @@ static void __init prx300_clk_init(struct device_node *np)
 	ctx = intel_clk_init(map, ARRAY_SIZE(prx300_early_clks));
 
 	if (IS_ERR(ctx)) {
-		pr_info("ERROR\n");
+		pr_err("%s: early clock alloc ctx failed!\n", __func__);
 		regmap_exit(map);
 		return;
 	}
 
 	if (intel_clk_register_early(ctx, prx300_early_clks,
-				     ARRAY_SIZE(prx300_early_clks)))
+				     ARRAY_SIZE(prx300_early_clks))) {
+		kfree(ctx);
 		return;
+	}
 	of_clk_add_hw_provider(np, of_clk_hw_onecell_get, &ctx->clk_data);
 }
 
