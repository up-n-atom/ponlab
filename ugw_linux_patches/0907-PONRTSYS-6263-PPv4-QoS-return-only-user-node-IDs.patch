From 21cb0541d1e06d06002b1608730920ee20b5eab0 Mon Sep 17 00:00:00 2001
From: ofirbitt <ofir1.bitton@intel.com>
Date: Sun, 29 Dec 2019 10:56:52 +0200
Subject: [PATCH] PONRTSYS-6263: PPv4 QoS - return only user node IDs

---
 drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_main.c | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_main.c b/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_main.c
index 793cc7097ca5..c64f3deb7578 100644
--- a/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_main.c
+++ b/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_main.c
@@ -144,8 +144,8 @@ static s32 is_node_configured(const struct pp_qos_dev *qdev,
 	} else if (QOS_PHY_VALID(phy)) {
 		*configured = true;
 		node = get_node_from_phy(qdev->nodes, phy);
-		if (node_rep(node)) {
-			QOS_LOG_ERR("id %u phy %u is replica node\n", id, phy);
+		if (node_rep(node) || node_internal(node)) {
+			QOS_LOG_ERR("id %u phy %u not valid\n", id, phy);
 			return -EINVAL;
 		}
 	} else {
@@ -1691,6 +1691,7 @@ static s32 qos_get_user_parent(struct pp_qos_dev *qdev,
 			return -EINVAL;
 		}
 
+		/* Scenario in which a priority 7 queue's parent is dr_sched */
 		if (parent_id != dr_sched_id) {
 			QOS_LOG_ERR("Parent(%u) rep is not dr_sched (%u)\n",
 				    parent_id, dr_sched_id);
@@ -2224,7 +2225,7 @@ s32 pp_qos_queue_set(struct pp_qos_dev *qdev, u32 id,
 		goto queue_set_cont;
 
 	node = get_node_from_phy(qdev->nodes, phy);
-	if (node_rep(node)) {
+	if (node_rep(node) || node_internal(node)) {
 		QOS_LOG_ERR("Parent %u is not valid\n",
 			    conf->queue_child_prop.parent);
 		rc = -EINVAL;
@@ -3354,7 +3355,7 @@ s32 pp_qos_sched_set(struct pp_qos_dev *qdev, u32 id,
 		goto sched_set_cont;
 
 	node = get_node_from_phy(qdev->nodes, phy);
-	if (node_rep(node)) {
+	if (node_rep(node) || node_internal(node)) {
 		QOS_LOG_ERR("Parent %u is not valid\n",
 			    conf->sched_child_prop.parent);
 		rc = -EINVAL;
