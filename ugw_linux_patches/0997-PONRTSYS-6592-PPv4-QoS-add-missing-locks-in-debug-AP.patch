From 17e8e024aa7e4c9236c75d7ca8f2b1942a9c520a Mon Sep 17 00:00:00 2001
From: ofirbitt <ofir1.bitton@intel.com>
Date: Mon, 3 Feb 2020 17:14:22 +0200
Subject: [PATCH] PONRTSYS-6592: PPv4 QoS add missing locks in debug APIs

---
 .../net/ppv4/pp-api/pp-qos-mgr/pp_qos_debugfs.c    |  4 +--
 drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_sysfs.c  |  2 +-
 drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.c  | 38 ++++++++++++++++++----
 drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.h  |  2 ++
 4 files changed, 37 insertions(+), 9 deletions(-)

diff --git a/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_debugfs.c b/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_debugfs.c
index 0588a198e9b2..515a89abb038 100644
--- a/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_debugfs.c
+++ b/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_debugfs.c
@@ -1142,7 +1142,7 @@ void pp_qos_dbg_tree_show(struct seq_file *s)
 		return;
 	}
 
-	qos_dbg_tree_show(qdev, true, s);
+	qos_dbg_tree_show_locked(qdev, true, s);
 }
 
 PP_DEFINE_DEBUGFS(tree, pp_qos_dbg_tree_show, NULL);
@@ -1166,7 +1166,7 @@ void pp_qos_dbg_full_tree_show(struct seq_file *s)
 		return;
 	}
 
-	qos_dbg_tree_show(qdev, false, s);
+	qos_dbg_tree_show_locked(qdev, false, s);
 }
 
 PP_DEFINE_DEBUGFS(full_tree, pp_qos_dbg_full_tree_show, NULL);
diff --git a/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_sysfs.c b/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_sysfs.c
index 3bfff54d0f45..fb1eb6f19b83 100644
--- a/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_sysfs.c
+++ b/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_sysfs.c
@@ -70,7 +70,7 @@ static ssize_t __tree_show(char *buf, size_t sz)
 
 	s.buf = buf;
 	s.size = sz;
-	qos_dbg_tree_show(qdev, true, &s);
+	qos_dbg_tree_show_locked(qdev, true, &s);
 
 	return s.count;
 }
diff --git a/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.c b/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.c
index 94fe70b4ba4f..e860a6fe35e3 100644
--- a/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.c
+++ b/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.c
@@ -3997,8 +3997,8 @@ static void qos_dbg_dump_subtree(struct pp_qos_dev *qdev, struct qos_node *node,
 	}
 }
 
-void qos_dbg_tree_show(struct pp_qos_dev *qdev, bool user_tree,
-		       struct seq_file *s)
+void __qos_dbg_tree_show(struct pp_qos_dev *qdev, bool user_tree,
+			 struct seq_file *s)
 {
 	struct qos_node *node;
 	u32 node_id, node_phy;
@@ -4028,6 +4028,20 @@ void qos_dbg_tree_show(struct pp_qos_dev *qdev, bool user_tree,
 	}
 }
 
+void qos_dbg_tree_show(struct pp_qos_dev *qdev, bool user_tree,
+		       struct seq_file *s)
+{
+	__qos_dbg_tree_show(qdev, user_tree, s);
+}
+
+void qos_dbg_tree_show_locked(struct pp_qos_dev *qdev, bool user_tree,
+			      struct seq_file *s)
+{
+	QOS_LOCK(qdev);
+	__qos_dbg_tree_show(qdev, user_tree, s);
+	QOS_UNLOCK(qdev);
+}
+
 s32 qos_dbg_qm_stat_show(struct pp_qos_dev *qdev, struct seq_file *s)
 {
 	struct queue_stat_info *cur_stat;
@@ -4049,6 +4063,8 @@ s32 qos_dbg_qm_stat_show(struct pp_qos_dev *qdev, struct seq_file *s)
 			 "\t\tRed dropped(p)\n");
 
 	num_rlms = qdev->init_params.max_queues;
+
+	QOS_LOCK(qdev);
 	for (rlm_idx = 0; rlm_idx < num_rlms; rlm_idx += NUM_Q_ON_QUERY) {
 		create_get_qm_stats_cmd(qdev,
 					rlm_idx,
@@ -4058,12 +4074,12 @@ s32 qos_dbg_qm_stat_show(struct pp_qos_dev *qdev, struct seq_file *s)
 		update_cmd_id(&qdev->drvcmds);
 		ret = transmit_cmds(qdev);
 		if (ret)
-			goto out;
+			goto unlock;
 
 		if (qminfo->num_queues > NUM_Q_ON_QUERY) {
 			QOS_LOG_ERR("Max Q on query is %u (received %u)\n",
 				    NUM_Q_ON_QUERY, qminfo->num_queues);
-			goto out;
+			goto unlock;
 		}
 
 		cur_stat = &qminfo->qstat[0];
@@ -4079,7 +4095,9 @@ s32 qos_dbg_qm_stat_show(struct pp_qos_dev *qdev, struct seq_file *s)
 		}
 	}
 
-out:
+unlock:
+	QOS_UNLOCK(qdev);
+
 	kfree(qminfo);
 	return 0;
 }
@@ -4127,11 +4145,13 @@ void qos_uc_mcdma_copy(struct pp_qos_dev *qdev, u32 src_phy, u32 dst_phy,
 	if (!qos_device_ready(qdev))
 		return;
 
+	QOS_LOCK(qdev);
 	create_mcdma_copy_cmd(qdev, src_phy, dst_phy, size);
 	update_cmd_id(&qdev->drvcmds);
 	ret = transmit_cmds(qdev);
 	if (unlikely(ret))
 		QOS_LOG_ERR("transmit_cmds failed (%d)\n", ret);
+	QOS_UNLOCK(qdev);
 }
 
 void qos_descriptor_push(struct pp_qos_dev *qdev, u32 queue_id, u32 size,
@@ -4142,11 +4162,12 @@ void qos_descriptor_push(struct pp_qos_dev *qdev, u32 queue_id, u32 size,
 	u32 phy;
 	s32 ret;
 
+	QOS_LOCK(qdev);
 	phy = get_phy_from_id(qdev->mapping, queue_id);
 	node = get_node_from_phy(qdev->nodes, phy);
 	if (!node) {
 		QOS_LOG_ERR("No node for id %u\n", queue_id);
-		return;
+		goto unlock;
 	}
 
 	create_push_desc_cmd(qdev, node->data.queue.rlm, size, pool, policy,
@@ -4156,6 +4177,9 @@ void qos_descriptor_push(struct pp_qos_dev *qdev, u32 queue_id, u32 size,
 	ret = transmit_cmds(qdev);
 	if (unlikely(ret))
 		QOS_LOG_ERR("transmit_cmds failed (%d)\n", ret);
+
+unlock:
+	QOS_UNLOCK(qdev);
 }
 
 void qos_descriptor_pop(struct pp_qos_dev *qdev, u32 queue_id, u32 *descriptor)
@@ -4173,6 +4197,7 @@ void qos_descriptor_pop(struct pp_qos_dev *qdev, u32 queue_id, u32 *descriptor)
 	if (!desc_addr)
 		return;
 
+	QOS_LOCK(qdev);
 	phy = get_phy_from_id(qdev->mapping, queue_id);
 	node = get_node_from_phy(qdev->nodes, phy);
 	if (!node) {
@@ -4194,5 +4219,6 @@ void qos_descriptor_pop(struct pp_qos_dev *qdev, u32 queue_id, u32 *descriptor)
 	*(descriptor + 3) = DDR_RD32((u32 *)desc_addr + 3);
 
 free_mem:
+	QOS_UNLOCK(qdev);
 	dma_free_coherent(NULL, sz, desc_addr, desc_addr_phys);
 }
diff --git a/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.h b/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.h
index 861b65c6ff8b..b1d4ada8c1ae 100644
--- a/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.h
+++ b/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.h
@@ -554,6 +554,8 @@ s32 pp_qos_config_get(struct pp_qos_dev *qos_dev,
 /* Dump the complete qos tree */
 void qos_dbg_tree_show(struct pp_qos_dev *qdev, bool user_tree,
 		       struct seq_file *s);
+void qos_dbg_tree_show_locked(struct pp_qos_dev *qdev, bool user_tree,
+			      struct seq_file *s);
 s32 qos_dbg_qm_stat_show(struct pp_qos_dev *qdev, struct seq_file *s);
 
 /* Phy octet mapping */
