From e5067f1f7b40a8d4ee6b728859dd4556f720abea Mon Sep 17 00:00:00 2001
From: "Martin, Claus" <claus.martin@intel.com>
Date: Fri, 21 Feb 2020 13:49:15 +0100
Subject: [PATCH] CURTSYS-3307: config update for ATM support

---
 drivers/net/ethernet/intel/Kconfig | 3 +--
 net/atm/Kconfig                    | 6 ++++++
 net/atm/br2684.c                   | 2 +-
 net/atm/common.c                   | 3 +--
 net/atm/common.h                   | 5 -----
 net/atm/mpc.c                      | 6 +++---
 net/atm/pppoatm.c                  | 2 +-
 7 files changed, 13 insertions(+), 14 deletions(-)

diff --git a/drivers/net/ethernet/intel/Kconfig b/drivers/net/ethernet/intel/Kconfig
index 8a6a34a99049..96976c71af63 100755
--- a/drivers/net/ethernet/intel/Kconfig
+++ b/drivers/net/ethernet/intel/Kconfig
@@ -288,7 +288,7 @@ config VRX518
 config VRX518_TC
 	tristate "Intel(R) VRX518 SmartPHY DSL PCIe Endpoint support"
 	depends on VRX518
-        default n
+        select ATM_MPOA_INTEL_DSL_PHY_SUPPORT
 	---help---
 	  This driver supports Intel(R) VRX518 TC functions. 
 
@@ -298,7 +298,6 @@ config VRX518_TC
 config VRX518_PCIE_SWITCH_BONDING
 	bool "Intel(R) VRX518 SmartPHY DSL bonding with PCIe Switch"
 	depends on VRX518
-	default n
 	---help---
 	Supported VRX518 SmartPHY PCIe DSL Bonding with PCIe switch
 
diff --git a/net/atm/Kconfig b/net/atm/Kconfig
index 120bb2ad5ff4..49e2d1d03bc1 100644
--- a/net/atm/Kconfig
+++ b/net/atm/Kconfig
@@ -85,3 +85,9 @@ config ATM_BR2684_MINI_JUMBO_FRAME_SUPPORT
 	default n
 	help
 	  Mini Jumbo Frame support
+
+config ATM_MPOA_INTEL_DSL_PHY_SUPPORT
+	bool "Intel DSL Phy MPOA support"
+	depends on ATM && NET
+	help
+	  Add support for Intel DSL Phy ATM MPOA
diff --git a/net/atm/br2684.c b/net/atm/br2684.c
index 90552d359550..59e7ca395b29 100644
--- a/net/atm/br2684.c
+++ b/net/atm/br2684.c
@@ -599,7 +599,7 @@ static int br2684_regvcc(struct atm_vcc *atmvcc, void __user * arg)
 	atmvcc->push = br2684_push;
 	atmvcc->pop = br2684_pop;
 	atmvcc->release_cb = br2684_release_cb;
-#if IS_ENABLED(CONFIG_VRX518_TC)
+#if IS_ENABLED(CONFIG_ATM_MPOA_INTEL_DSL_PHY_SUPPORT)
 	if (atm_hook_mpoa_setup) /* IPoA or EoA w/o FCS */
 		atm_hook_mpoa_setup(atmvcc, brdev->payload == p_routed ? 3 : 0,
 			brvcc->encaps == BR2684_ENCAPS_LLC ? 1 : 0, net_dev);
diff --git a/net/atm/common.c b/net/atm/common.c
index e6df47fe7535..a31fa5327db9 100644
--- a/net/atm/common.c
+++ b/net/atm/common.c
@@ -141,7 +141,7 @@ static struct proto vcc_proto = {
 	.release_cb = vcc_release_cb,
 };
 
-#if IS_ENABLED(CONFIG_VRX518_TC)
+#if IS_ENABLED(CONFIG_ATM_MPOA_INTEL_DSL_PHY_SUPPORT)
 void (*atm_hook_mpoa_setup)(struct atm_vcc *, int, int, struct net_device *) = NULL;
 EXPORT_SYMBOL(atm_hook_mpoa_setup);
 #endif
@@ -159,7 +159,6 @@ int push_oam(struct atm_vcc *atmvcc, void *cell)
 EXPORT_SYMBOL(push_oam);
 #endif
 
-
 int vcc_create(struct net *net, struct socket *sock, int protocol, int family, int kern)
 {
 	struct sock *sk;
diff --git a/net/atm/common.h b/net/atm/common.h
index ab02c094988c..7a09b3abc505 100644
--- a/net/atm/common.h
+++ b/net/atm/common.h
@@ -9,7 +9,6 @@
 #include <linux/net.h>
 #include <linux/poll.h> /* for poll_table */
 
-
 int vcc_create(struct net *net, struct socket *sock, int protocol, int family, int kern);
 int vcc_release(struct socket *sock);
 int vcc_connect(struct socket *sock, int itf, short vpi, int vci);
@@ -55,10 +54,6 @@ void atm_dev_release_vccs(struct atm_dev *dev);
 int push_oam(struct atm_vcc *atmvcc, void *cell);
 #endif
 
-#if IS_ENABLED(CONFIG_VRX318_DATAPATH) || IS_ENABLED(CONFIG_VRX518_TC) \
-	|| IS_ENABLED(CONFIG_LTQ_PPA_A1)
 extern void (*atm_hook_mpoa_setup)(struct atm_vcc *, int, int, struct net_device *);
-#endif
-
 
 #endif
diff --git a/net/atm/mpc.c b/net/atm/mpc.c
index e0512cb809cd..f197176f97d3 100644
--- a/net/atm/mpc.c
+++ b/net/atm/mpc.c
@@ -644,9 +644,9 @@ static int atm_mpoa_vcc_attach(struct atm_vcc *vcc, void __user *arg)
 
 	vcc->proto_data = mpc->dev;
 	vcc->push = mpc_push;
-#if IS_ENABLED(CONFIG_VRX518_TC)
-   if (atm_hook_mpoa_setup) /* IPoA, LLC */
-       atm_hook_mpoa_setup(vcc, 3, 1, mpc->dev);
+#if IS_ENABLED(CONFIG_ATM_MPOA_INTEL_DSL_PHY_SUPPORT)
+	if (atm_hook_mpoa_setup) /* IPoA, LLC */
+		atm_hook_mpoa_setup(vcc, 3, 1, mpc->dev);
 #endif
 	return 0;
 }
diff --git a/net/atm/pppoatm.c b/net/atm/pppoatm.c
index a71435088996..dd8baea87b63 100644
--- a/net/atm/pppoatm.c
+++ b/net/atm/pppoatm.c
@@ -464,7 +464,7 @@ static int pppoatm_assign_vcc(struct atm_vcc *atmvcc, void __user *arg)
 	atmvcc->user_back = pvcc;
 	atmvcc->push = pppoatm_push;
 	atmvcc->pop = pppoatm_pop;
-#if IS_ENABLED(CONFIG_VRX518_TC)
+#if IS_ENABLED(CONFIG_ATM_MPOA_INTEL_DSL_PHY_SUPPORT)
 	if (atm_hook_mpoa_setup) /* PPPoA */
 		atm_hook_mpoa_setup(atmvcc, 2,
 			pvcc->encaps == e_llc ? 1 : 0,
