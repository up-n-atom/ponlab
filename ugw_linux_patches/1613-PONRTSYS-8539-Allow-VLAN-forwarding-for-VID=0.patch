From c979a12fda26d29c2fceecbdc953b41328b4ec58 Mon Sep 17 00:00:00 2001
From: "Rywacki, Kamil" <kamil.rywacki@intel.com>
Date: Wed, 10 Feb 2021 01:30:04 +0100
Subject: [PATCH] PONRTSYS-8539: Allow VLAN forwarding for VID=0

---
 drivers/net/datapath/pon_qos/pon_qos_tc_mirred.c | 11 +++++------
 1 file changed, 5 insertions(+), 6 deletions(-)

diff --git a/drivers/net/datapath/pon_qos/pon_qos_tc_mirred.c b/drivers/net/datapath/pon_qos/pon_qos_tc_mirred.c
index 56ec421c2b34..4d1efedfc8f5 100644
--- a/drivers/net/datapath/pon_qos/pon_qos_tc_mirred.c
+++ b/drivers/net/datapath/pon_qos/pon_qos_tc_mirred.c
@@ -147,14 +147,13 @@ static int pon_qos_vlan_to_pce(struct net_device *dev,
 			       struct pon_qos_mirr_filter *flt,
 			       GSW_PCE_rule_t *rule)
 {
-	int ret = -1;
+	if (!flt->mask.vlan_id)
+		return pon_qos_vlan_to_pce_wildcard(dev, flt, rule);
 
-	if (!flt->key.vlan_id && !flt->mask.vlan_id)
-		ret = pon_qos_vlan_to_pce_wildcard(dev, flt, rule);
-	else if (flt->key.vlan_id && flt->mask.vlan_id == 0xfff)
-		ret = pon_qos_vlan_to_pce_single(dev, flt, rule);
+	if (flt->mask.vlan_id == 0xfff)
+		return pon_qos_vlan_to_pce_single(dev, flt, rule);
 
-	return ret;
+	return -EIO;
 }
 
 static int pon_qos_all_to_pce(struct net_device *dev,
