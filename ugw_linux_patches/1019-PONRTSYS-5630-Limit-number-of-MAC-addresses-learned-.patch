From 0834dd3e27465b939c1d986e452d119cc1ef9e5b Mon Sep 17 00:00:00 2001
From: JacekX Skowron <jacekx.skowron@intel.com>
Date: Wed, 19 Feb 2020 18:21:01 +0100
Subject: [PATCH] PONRTSYS-5630: Limit number of MAC addresses learned per port
 by default

- Optimize the code
---
 drivers/net/datapath/dpm/gswip31/datapath_misc.h      |  2 --
 drivers/net/datapath/dpm/gswip31/datapath_switchdev.c | 13 +++++++++----
 2 files changed, 9 insertions(+), 6 deletions(-)

diff --git a/drivers/net/datapath/dpm/gswip31/datapath_misc.h b/drivers/net/datapath/dpm/gswip31/datapath_misc.h
index 8e3e5bd5c91e..fb438a4082c9 100644
--- a/drivers/net/datapath/dpm/gswip31/datapath_misc.h
+++ b/drivers/net/datapath/dpm/gswip31/datapath_misc.h
@@ -41,8 +41,6 @@
 #define UNSET_BP_MAP(x, ix) (x[(ix) / 16] &= ~(1 << ((ix) % 16)))
 /* Max value for the limit of MAC addresses per bridge port. */
 #define GSWIP_LEARN_LIMIT_PORT_MAX		254
-/* Allow learning unlimited MAC addresses on port. */
-#define GSWIP_LEARN_LIMIT_PORT_UNLIMITED	254
 
 enum CQE_LOOKUP_MODE {
 	CQE_LU_MODE0 = 0,
diff --git a/drivers/net/datapath/dpm/gswip31/datapath_switchdev.c b/drivers/net/datapath/dpm/gswip31/datapath_switchdev.c
index 8de693f58454..0a50cd553fa8 100644
--- a/drivers/net/datapath/dpm/gswip31/datapath_switchdev.c
+++ b/drivers/net/datapath/dpm/gswip31/datapath_switchdev.c
@@ -372,14 +372,19 @@ int dp_swdev_port_learning_limit_set(int inst, int bport, int learning_limit)
 
 	bpcfg.eMask |= GSW_BRIDGE_PORT_CONFIG_MASK_MAC_LEARNING_LIMIT;
 	if (learning_limit == BRPORT_LEARNING_LIMIT_UNLIMITED) {
-		bpcfg.nMacLearningLimit = GSWIP_LEARN_LIMIT_PORT_UNLIMITED;
 		bpcfg.bMacLearningLimitEnable = 0;
+		/* Learning limit is not enabled thus the value of
+		 * nMacLearningLimit makes no difference; the switch
+		 * will set it to 0xff no matter what we set (here we set
+		 * 0xfe for example)
+		 */
+		bpcfg.nMacLearningLimit = 0xfe;
 	} else {
-		/* only possible to configure values between 0 and 255
-		 * 256 == unlimited in the HW.
+		/* The check below is rendundant. Values which are not allowed
+		 * are rejected already on higher level
 		 */
 		if (learning_limit > GSWIP_LEARN_LIMIT_PORT_MAX)
-			learning_limit = GSWIP_LEARN_LIMIT_PORT_UNLIMITED;
+			learning_limit = GSWIP_LEARN_LIMIT_PORT_MAX;
 		bpcfg.nMacLearningLimit = learning_limit;
 		bpcfg.bMacLearningLimitEnable = 1;
 	}
