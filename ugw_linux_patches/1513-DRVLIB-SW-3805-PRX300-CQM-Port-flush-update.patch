From 1d814b1843e0748408d30c9e82289a4ed89045ba Mon Sep 17 00:00:00 2001
From: Lishan Liu <lishan.liu@intel.com>
Date: Wed, 18 Nov 2020 09:55:57 +0800
Subject: [PATCH] DRVLIB_SW-3805: PRX300 CQM Port flush update

---
 drivers/net/ethernet/lantiq/cqm/prx300/cqm.c | 32 +++++++++++++---------------
 drivers/net/ethernet/lantiq/cqm/prx300/cqm.h |  1 -
 include/net/datapath_api_qos.h               |  3 +++
 3 files changed, 18 insertions(+), 18 deletions(-)

diff --git a/drivers/net/ethernet/lantiq/cqm/prx300/cqm.c b/drivers/net/ethernet/lantiq/cqm/prx300/cqm.c
index c9550032f06a..9624004fdd42 100644
--- a/drivers/net/ethernet/lantiq/cqm/prx300/cqm.c
+++ b/drivers/net/ethernet/lantiq/cqm/prx300/cqm.c
@@ -14,11 +14,6 @@
 #define OWN_BIT  BIT(31)
 #define COMPLETE_BIT  BIT(30)
 #define CQM_PON_IP_BASE_ADDR 0x181003FC
-/*CQM need to access this PPV4 reg directly
- *as using API through PP QOS FW will
- *slow down queue flush and is not stable
- */
-#define PPV4_QOS_WRED_Q_SIZE_ADDR 0x18820E00
 #define CQM_PON_IP_PKT_LEN_ADJ_BYTES 9
 #define CQEM_PON_IP_IF_PIB_OVERSHOOT_BYTES 9260
 #define PRX300_CQM_DROP_INIT ((PRX300_CQM_DROP_Q << 24) | \
@@ -3030,10 +3025,11 @@ s32 qos_q_flush(s32 cqm_inst, s32 cqm_drop_port, s32 qid, s32 nodeid)
 	u32 desc_num = dqm_port_info[port].deq_info.num_desc;
 	u32 total_flush = 0;
 	u32 qocc_q = 0;
+	struct dp_qos_queue_info qocc_info;
+
+	qocc_info.nodeid = nodeid;
+	qocc_info.inst = cqm_inst;
 
-	qocc_q = cbm_r32(cqm_ctrl->ppv4_qocc_base + qid * 4);
-	if (!qocc_q)
-		return CBM_SUCCESS;
 	while ((no_packet < Q_FLUSH_NO_PACKET_CNT) || (qocc_q)) {
 		reg = cbm_r32(dma_desc +
 				CQM_DEQ_DMA_DESC(port, i) + 0xc);
@@ -3049,12 +3045,16 @@ s32 qos_q_flush(s32 cqm_inst, s32 cqm_drop_port, s32 qid, s32 nodeid)
 			no_packet++;
 			dev_dbg(cqm_ctrl->dev, "no_packet %d\n", no_packet);
 			if (no_packet >= Q_FLUSH_NO_PACKET_CNT) {
-				qocc_q = cbm_r32(cqm_ctrl->ppv4_qocc_base
-					+ qid * 4);
-				dev_dbg(cqm_ctrl->dev, "%s qocc_%d addr:%lx, val: %lx\n",
-					__func__, qid,
-					cqm_ctrl->ppv4_qocc_base + qid * 4,
-					qocc_q);
+				if (dp_qos_get_q_qocc(&qocc_info, 0) == DP_SUCCESS) {
+					qocc_q = qocc_info.qocc;
+					if (qocc_q)
+						no_packet = 0;
+				} else {
+					qocc_q = 0;
+					dev_info(cqm_ctrl->dev, "qocc read error!\n");
+				}
+				dev_dbg(cqm_ctrl->dev, "%s qid:%d nodeid:%d qocc:%d\n",
+					__func__, qid, nodeid, qocc_q);
 			}
 		}
 	}
@@ -4750,9 +4750,7 @@ static int cqm_prx300_probe(struct platform_device *pdev)
 	cqm_ctrl->fsqm = devm_ioremap_resource(&pdev->dev, res[8]);
 	cqm_ctrl->pib = devm_ioremap_resource(&pdev->dev, res[9]);
 	cqm_ctrl->pon_dqm_cntr = devm_ioremap_resource(&pdev->dev, res[10]);
-	cqm_ctrl->ppv4_qocc_base = devm_ioremap(&pdev->dev,
-		(resource_size_t)PPV4_QOS_WRED_Q_SIZE_ADDR,
-		MAX_QOS_QUEUES * 4);
+
 	result = check_base_addr();
 	if (result) {
 		dev_err(cqm_ctrl->dev, "failed to request and remap io ranges\n");
diff --git a/drivers/net/ethernet/lantiq/cqm/prx300/cqm.h b/drivers/net/ethernet/lantiq/cqm/prx300/cqm.h
index 77602b49ce32..89a3cb10f8e5 100644
--- a/drivers/net/ethernet/lantiq/cqm/prx300/cqm.h
+++ b/drivers/net/ethernet/lantiq/cqm/prx300/cqm.h
@@ -621,7 +621,6 @@ struct cqm_ctrl {
 	void __iomem *fsqm;
 	void __iomem *pib;
 	void __iomem *pon_dqm_cntr;
-	void __iomem *ppv4_qocc_base;
 	u32 max_mem_alloc;
 	dma_addr_t dma_hndl_qos;
 	dma_addr_t dma_hndl_p[TOT_DMA_HNDL];
diff --git a/include/net/datapath_api_qos.h b/include/net/datapath_api_qos.h
index f23ebb9c0905..ca8f365f7027 100644
--- a/include/net/datapath_api_qos.h
+++ b/include/net/datapath_api_qos.h
@@ -1376,6 +1376,9 @@ struct dp_qos_queue_info {
 };
 
 /*!< API dp_qos_get_q_qocc: Helps to retrieve QoS queue occupancy  value
+ *
+ * This API is only for CQM driver to use during queue flush 
+ * There is no any DPM level lock used
  *
  * @param [in,out] qos queue info struct dp_qos_queue_info *info
  * @param [in] flag: reserved
