From 91e3b3523a7d502eae46c7db9d0a1449cc96095a Mon Sep 17 00:00:00 2001
From: Elad Fernandes <elad.fernandes@intel.com>
Date: Wed, 4 Nov 2020 12:35:23 +0200
Subject: [PATCH] LMTSYS-4235: Fixing the PPv4 QoS version mismatch error print

---
 drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_fw.c | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_fw.c b/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_fw.c
index 83dcca9ece83..1f1f8f068b80 100644
--- a/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_fw.c
+++ b/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_fw.c
@@ -317,7 +317,8 @@ s32 do_load_firmware(struct pp_qos_dev *qdev,
 		     qdev->fwver.major, qdev->fwver.minor,
 		     qdev->fwver.build, __fw_soc_rev_get());
 
-	if (memcmp(&host_fwver, &qdev->fwver, sizeof(host_fwver))) {
+	if ((host_fwver.major != qdev->fwver.major) ||
+	    (host_fwver.minor != qdev->fwver.minor)) {
 		QOS_LOG_ERR("Ver mismatch: FW [%u.%u.%u]. Host [%u.%u.%u]\n",
 			    qdev->fwver.major, qdev->fwver.minor,
 			    qdev->fwver.build, host_fwver.major,
