 }
 
 #ifndef DP_FLUSH_VIA_AUTO
-static int cqm_queue_flush_31(int cqm_inst, int cqm_drop_port, int qid)
+static int cqm_queue_flush_31(int cqm_inst, int cqm_drop_port, int qid,
+			      u32 nodeid)
 {
 	/* Before call this API, the queue is already unmapped in lookup table,
 	 * For the queue itself, it is blocked and resume.
 	 * Also attached to drop port
 	 */
 	/* need call low level CQM API */
-
-	cqm_qos_queue_flush(cqm_inst, cqm_drop_port, qid);
+	cqm_qos_queue_flush(cqm_inst, cqm_drop_port, qid, nodeid);
 
 	DP_DEBUG(DP_DBG_FLAG_QOS, "%s done\n", __func__);
 	return DP_SUCCESS;
@@ -381,7 +381,7 @@ static int queue_flush_31(int inst, int node_id, int flag)
 			 "Flush:Q[%d] already under drop port[/%d]\n",
 			 qid, priv->ppv4_drop_p);
 
-		cqm_queue_flush_31(cbm_inst, priv->cqm_drop_p, qid);
+		cqm_queue_flush_31(cbm_inst, priv->cqm_drop_p, qid, node_id);
 	} else {
 		DP_DEBUG(DP_DBG_FLAG_QOS,
 			 "Queue movement before flush");
@@ -401,7 +401,7 @@ static int queue_flush_31(int inst, int node_id, int flag)
 			 qid,
 			 tmp_q_cfg.queue_child_prop.parent);
 
-		cqm_queue_flush_31(cbm_inst, priv->cqm_drop_p, qid);
+		cqm_queue_flush_31(cbm_inst, priv->cqm_drop_p, qid, node_id);
 
 		if (flag & FLUSH_RESTORE_QOS_PORT) {
 			/* move back the queue to original parent
@@ -4413,3 +4413,30 @@ int dp_port_block_flush_31(struct dp_qos_blk_flush_port *cfg,
 
 	return DP_SUCCESS;
 }
+
+int dp_get_queue_qocc_31(struct dp_qos_queue_info *info, int flag) {
+
+	struct hal_priv *priv;
+	struct pp_qos_queue_stat qstat = {0};
+
+
+	if (!info) {
+		pr_err("info cannot be NULL\n");
+		return DP_FAILURE;
+	}
+	priv = HAL(info->inst);
+	if (!priv) {
+		pr_err("priv cannot be NULL\n");
+		return DP_FAILURE;
+	}
+	if (pp_qos_queue_stat_get(priv->qdev, info->nodeid, &qstat)) {
+		pr_err("pp_qos_queue_stat_get fail for qid:%d\n", info->nodeid);
+		return DP_FAILURE;
+	}
+	info->qocc = qstat.queue_packets_occupancy;
+	DP_DEBUG(DP_DBG_FLAG_QOS,
+		 "%s: logical_qid=%d, qocc=%d\n", __func__, info->nodeid,
+		 qstat.queue_packets_occupancy);
+
+	return DP_SUCCESS;
+}
