diff --git a/drivers/net/datapath/dpm/datapath_qos.c b/drivers/net/datapath/dpm/datapath_qos.c
index 83a08ec31789..4e8459b3e152 100644
--- a/drivers/net/datapath/dpm/datapath_qos.c
+++ b/drivers/net/datapath/dpm/datapath_qos.c
@@ -606,3 +606,27 @@ int dp_block_flush_queue(struct dp_qos_blk_flush_queue *cfg, int flag)
 	return ret;
 }
 EXPORT_SYMBOL(dp_block_flush_queue);
+
+int dp_qos_get_q_qocc(struct dp_qos_queue_info *info, int flag)
+{
+	struct inst_info *dp_info;
+	int ret = DP_FAILURE;
+
+	if (unlikely(!dp_init_ok)) {
+		pr_err("%s failed: datapath not initialized yet\n", __func__);
+		return DP_FAILURE;
+	}
+
+	if (!(info->nodeid) || is_invalid_inst(info->inst))
+		return DP_FAILURE;
+
+	dp_info = get_dp_prop_info(info->inst);
+
+	if (!dp_info || !dp_info->dp_get_queue_qocc)
+		return DP_FAILURE;
+
+	ret = dp_info->dp_get_queue_qocc(info, flag);
+
+	return ret;
+}
+EXPORT_SYMBOL(dp_qos_get_q_qocc);
