From 072121de5c38b37007a9d87c1ca314dcabb12692 Mon Sep 17 00:00:00 2001
From: "santosh.kumar.mamila" <santosh.kumarx.mamila@intel.com>
Date: Fri, 13 Mar 2020 17:23:09 +0800
Subject: [PATCH] DRVLIB_SW-3464 - Klockwork fixes for xpcs driver.

---
 drivers/net/ethernet/lantiq/ltq_eth_drv_xrx500.c | 35 ++++++++++++------------
 drivers/net/ethernet/lantiq/xpcs/xpcs.c          |  4 +--
 2 files changed, 19 insertions(+), 20 deletions(-)

diff --git a/drivers/net/ethernet/lantiq/ltq_eth_drv_xrx500.c b/drivers/net/ethernet/lantiq/ltq_eth_drv_xrx500.c
index 3f9ee49e0d63..ef8afb44f721 100644
--- a/drivers/net/ethernet/lantiq/ltq_eth_drv_xrx500.c
+++ b/drivers/net/ethernet/lantiq/ltq_eth_drv_xrx500.c
@@ -1966,7 +1966,7 @@ static int xrx500_of_iface(struct xrx500_hw *hw, struct device_node *iface,
 	struct dp_dev_data dev_data = {0};
 	struct device_node *port, *mac_np;
 	const __be32 *wan;
-	u32 dp_dev_port_param, dp_port_id_param, xgmac_id_param;
+	u32 dp_dev_port_param, dp_port_id_param;
 	u32 lct_en_param = 0, extra_subif_param = 0;
 	int net_start = 0, net_end = 0;
 	dp_cb_t cb = {0};
@@ -2016,26 +2016,25 @@ static int xrx500_of_iface(struct xrx500_hw *hw, struct device_node *iface,
 		return ret;
 	}
 
-	priv->xgmac_id = -1;
-
 	mac_np = of_parse_phandle(iface, "mac", 0);
-	if (mac_np) {
-		ret = of_property_read_u32(mac_np, "mac_idx", &xgmac_id_param);
-		if (ret < 0) {
-			pr_info("ERROR : Property mac_idx not read from DT for if %s\n",
-				name);
-			return ret;
-		}
 
-		priv->xgmac_id = xgmac_id_param;
+		if (!mac_np) {
+			pr_info("INFO : Property mac is not defined in DT\n");
+			priv->xgmac_id = -1;
+		} else {
+			ret = of_property_read_u32(mac_np, "mac_idx", &priv->xgmac_id);
+			if (ret < 0) {
+				pr_info("ERROR : Property mac_idx not read from DT for if %s\n",
+					name);
+				return ret;
+			}
 
-		priv->xpcs_node = of_parse_phandle(mac_np, "xpcs", 0);
-		if (!priv->xpcs_node) {
-			pr_info("Cannot get xpcs node\n");
-			return -EINVAL;
+			priv->xpcs_node = of_parse_phandle(mac_np, "xpcs", 0);
+			if (!priv->xpcs_node) {
+				pr_info("Cannot get xpcs node\n");
+				return -EINVAL;
+			}
 		}
-	}
-
 	ret = of_property_read_u32(iface, "intel,lct-en",
 				   &lct_en_param);
 	if (ret < 0) {
@@ -2148,7 +2147,7 @@ static int xrx500_of_iface(struct xrx500_hw *hw, struct device_node *iface,
 	if (extra_subif_param >= 1) {
 		net_start = priv->start;
 		net_end = priv->end;
-		ltq_eth_dev_reg(&xrx500_hw, xgmac_id_param, lct_en_param,
+		ltq_eth_dev_reg(&xrx500_hw, priv->xgmac_id, lct_en_param,
 				dp_port_id_param, net_start, net_end,
 				priv);
 	}
diff --git a/drivers/net/ethernet/lantiq/xpcs/xpcs.c b/drivers/net/ethernet/lantiq/xpcs/xpcs.c
index bcc94bab1b03..5af73a8d2ee5 100644
--- a/drivers/net/ethernet/lantiq/xpcs/xpcs.c
+++ b/drivers/net/ethernet/lantiq/xpcs/xpcs.c
@@ -214,9 +214,9 @@ static int xpcs_rxtx_stable(struct xpcs_prv_data *pdata)
 		}
 
 		usleep_range(10, 20);
-	} while (i <= MAX_BUSY_RETRY);
+	} while (i++ < MAX_BUSY_RETRY);
 
-	if (i > MAX_BUSY_RETRY) {
+	if (i >= MAX_BUSY_RETRY) {
 		dev_info(pdata->dev, "%s: TX/RX Stable TIMEOUT\n",
 			 pdata->name);
 		return -1;
