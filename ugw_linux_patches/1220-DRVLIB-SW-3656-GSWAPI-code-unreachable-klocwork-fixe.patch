From 63275d6ee3cb9a68692d96d00184a392b971e2ac Mon Sep 17 00:00:00 2001
From: Dinesh Sudham <dineshx.sudham@intel.com>
Date: Wed, 10 Jun 2020 12:30:34 +0800
Subject: [PATCH] DRVLIB_SW-3656: GSWAPI: code unreachable klocwork fixes in
 switch_api

Signed-off-by: Dinesh Sudham <dineshx.sudham@intel.com>
---
 .../net/ethernet/lantiq/switch-api/gsw_flow_core.c | 29 ++++++++--------------
 .../ethernet/lantiq/switch-api/gsw_ioctl_wrapper.c |  2 +-
 drivers/net/ethernet/lantiq/switch-api/gsw_pae.c   |  2 --
 .../net/ethernet/lantiq/switch-api/gsw_swmcast.c   |  4 +--
 .../ethernet/lantiq/switch-api/mac/gswss_mac_api.c | 12 +++------
 .../ethernet/lantiq/switch-api/mac/xgmac_debug.c   | 12 ++-------
 drivers/net/ethernet/lantiq/xpcs/xpcs.c            |  2 +-
 include/net/switch_api/lantiq_gsw.h                |  2 +-
 8 files changed, 20 insertions(+), 45 deletions(-)

diff --git a/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c b/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c
index c916241dbff2..7f8be442b8ad 100644
--- a/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c
+++ b/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c
@@ -38,7 +38,7 @@ u8 MICRO_CODE_VERSION_NUMBER[] = "0x"MICRO_CODE_VERSION;
 /* Port redirect flag */
 static u8 prdflag;
 static void get_gsw_hw_cap(void *cdev);
-static GSW_return_t gsw_init_fn_ptrs(struct core_ops *ops);
+static void gsw_init_fn_ptrs(struct core_ops *ops);
 void (*xrx500_gphy_reset_cb)(u32 phy_id);
 EXPORT_SYMBOL(xrx500_gphy_reset_cb);
 
@@ -3337,7 +3337,7 @@ void *ethsw_api_core_init(ethsw_core_init_t *ethcinit)
 	ethsw_api_dev_t *PrvData;
 	struct core_ops *ops;
 	void *cdev;
-	u32 ret = 0, i = 0, reg_val;
+	u32 i = 0, reg_val;
 
 #ifdef __KERNEL__
 
@@ -3407,13 +3407,7 @@ void *ethsw_api_core_init(ethsw_core_init_t *ethcinit)
 		get_gsw_hw_cap(cdev);
 
 	/** Initialize Switch Core Function Pointer */
-	ret = gsw_init_fn_ptrs(cdev);
-
-	if (ret != GSW_statusOk) {
-		pr_err("%s:%s:%d (Initialize Switch Core Function Pointer failed)\n",
-		       __FILE__, __func__, __LINE__);
-		return PrvData;
-	}
+	gsw_init_fn_ptrs(cdev);
 
 #if defined(CONFIG_LTQ_MULTICAST) && CONFIG_LTQ_MULTICAST
 
@@ -20376,7 +20370,7 @@ GSW_return_t GSW_ExtendedVlanSet(void *cdev, GSW_EXTENDEDVLAN_config_t *parm)
 				dscp2pcp_get.nIndex = idx;
 				ret = GSW_QOS_Dscp2PcpTableGet(cdev, &dscp2pcp_get);
 
-				if (ret != GSW_statusOk) {
+				if (ret) {
 					pr_err("ERROR:%s, GSW_QOS_Dscp2PcpTableGet failed\n",
 						__func__);
 					goto UNLOCK_AND_RETURN;
@@ -20421,7 +20415,7 @@ GSW_return_t GSW_ExtendedVlanSet(void *cdev, GSW_EXTENDEDVLAN_config_t *parm)
 				dscp2pcp_set.nIndex = dscp2pcp_pointer;
 				ret = GSW_QOS_Dscp2PcpTableSet(cdev, &dscp2pcp_set);
 
-				if (ret != GSW_statusOk) {
+				if (ret) {
 					pr_err("ERROR:%s, GSW_QOS_Dscp2PcpTableSet failed\n",
 						__func__);
 					goto UNLOCK_AND_RETURN;
@@ -20950,7 +20944,7 @@ GSW_return_t GSW_ExtendedVlanGet(void *cdev, GSW_EXTENDEDVLAN_config_t *parm)
 		dscp2pcp_get.nIndex = dscp2pcp_pointer;
 		ret = GSW_QOS_Dscp2PcpTableGet(cdev, &dscp2pcp_get);
 
-		if (ret != GSW_statusOk) {
+		if (ret) {
 			pr_err("ERROR:%s, GSW_QOS_Dscp2PcpTableGet failed\n",
 				__func__);
 			goto UNLOCK_AND_RETURN;
@@ -24463,7 +24457,7 @@ GSW_return_t GSW_BridgePortConfigGet(void *cdev, GSW_BRIDGE_portConfig_t *param)
 			param->sPmapper.nPmapperId = (tbl_prog_brdgeport_egress.val[4] & 0xFF);
 			ret = GSW_QOS_PmapperTableGet(cdev, &param->sPmapper);
 
-			if (ret != GSW_statusOk) {
+			if (ret) {
 				pr_err("ERROR :P-mapper Get return Error\n");
 				goto UNLOCK_AND_RETURN;
 			}
@@ -25685,7 +25679,7 @@ GSW_return_t GSW_CtpPortConfigGet(void *cdev, GSW_CTP_portConfig_t *param)
 	ctp_get.nLogicalPortId = param->nLogicalPortId;
 	ret = GSW_CTP_PortAssignmentGet(cdev, &ctp_get);
 
-	if (ret != GSW_statusOk)
+	if (ret)
 		goto UNLOCK_AND_RETURN;
 
 	/*IMPORTANT NOTE : :As per the CTP concept  nFirstCtpPortId + nSubIfIdGroup is the expected CTP port*/
@@ -25849,7 +25843,7 @@ GSW_return_t GSW_CtpPortConfigGet(void *cdev, GSW_CTP_portConfig_t *param)
 				param->sPmapper.nPmapperId = (tbl_prog_ctpport_ingress.val[4] & 0xFF);
 				ret = GSW_QOS_PmapperTableGet(cdev, &param->sPmapper);
 
-				if (ret != GSW_statusOk)
+				if (ret)
 					goto UNLOCK_AND_RETURN;
 
 				value = ((tbl_prog_ctpport_ingress.val[4] & 0x2000) >> 13);
@@ -26083,7 +26077,7 @@ GSW_return_t GSW_CtpPortConfigReset(void *cdev, GSW_CTP_portConfig_t *param)
 	ctp_get.nLogicalPortId = param->nLogicalPortId;
 	ret = GSW_CTP_PortAssignmentGet(cdev, &ctp_get);
 
-	if (ret != GSW_statusOk)
+	if (ret)
 		goto UNLOCK_AND_RETURN;
 
 	/*IMPORTANT NOTE : :As per the CTP concept  nFirstCtpPortId + nSubIfIdGroup is the expected CTP port*/
@@ -27586,7 +27580,7 @@ GSW_return_t gsw_vxlan_cfg_set(void *cdev,
 	return ret;
 }
 
-static GSW_return_t gsw_init_fn_ptrs(struct core_ops *ops)
+static void gsw_init_fn_ptrs(struct core_ops *ops)
 {
 
 	/*Switch Operations*/
@@ -27867,6 +27861,5 @@ static GSW_return_t gsw_init_fn_ptrs(struct core_ops *ops)
 	ops->gsw_irq_ops.IRQ_Enable						= GSW_Irq_enable;
 	ops->gsw_irq_ops.IRQ_Disable					= GSW_Irq_disable;
 
-	return GSW_statusOk;
 }
 
diff --git a/drivers/net/ethernet/lantiq/switch-api/gsw_ioctl_wrapper.c b/drivers/net/ethernet/lantiq/switch-api/gsw_ioctl_wrapper.c
index 2c3e9a86876f..44066ced920f 100644
--- a/drivers/net/ethernet/lantiq/switch-api/gsw_ioctl_wrapper.c
+++ b/drivers/net/ethernet/lantiq/switch-api/gsw_ioctl_wrapper.c
@@ -298,7 +298,7 @@ int gsw_api_drv_register(u32 major)
 	dev_num = MKDEV(major, 0);
 	result = register_chrdev_region(dev_num, MINORMASK, ETHSW_API_DEV_NAME);
 
-	if (result < 0) {
+	if (result) {
 		pr_err("SWAPI: Register Char Dev failed with %d !!!\n", result);
 		goto fail_register_chrdev_region;
 	}
diff --git a/drivers/net/ethernet/lantiq/switch-api/gsw_pae.c b/drivers/net/ethernet/lantiq/switch-api/gsw_pae.c
index 80b940896f5a..4697b8ed982f 100644
--- a/drivers/net/ethernet/lantiq/switch-api/gsw_pae.c
+++ b/drivers/net/ethernet/lantiq/switch-api/gsw_pae.c
@@ -1259,11 +1259,9 @@ int GSW_ROUTE_SessionEntryAdd(void *cdev, GSW_ROUTE_Entry_t *rpar)
 
 					rpar->nRtIndex = index;
 					retval = success;
-					goto UNLOCK_AND_RETURN;
 				}
 			}
 		}
-		retval = GSW_statusOk;
 		goto UNLOCK_AND_RETURN;
 
 errexit:
diff --git a/drivers/net/ethernet/lantiq/switch-api/gsw_swmcast.c b/drivers/net/ethernet/lantiq/switch-api/gsw_swmcast.c
index 2e881484f7dc..6495ea897070 100644
--- a/drivers/net/ethernet/lantiq/switch-api/gsw_swmcast.c
+++ b/drivers/net/ethernet/lantiq/switch-api/gsw_swmcast.c
@@ -766,10 +766,8 @@ int gsw_remove_hashtable_entry(void *cdev, GSW_multicastTable_t *parm)
 
 	if (ret == REMOVED_ENTRY)
 		pr_debug("REMOVED_ENTRY %s:%s:%d\n", __FILE__, __func__, __LINE__);
-	else if (ret == UPDATED_BR_PMAP)
-		pr_debug("UPDATED BR PMAP ENTRY %s:%s:%d\n", __FILE__, __func__, __LINE__);
 	else
-		pr_debug("ENTRY_CANNOT_REMOVE %s:%s:%d\n", __FILE__, __func__, __LINE__);
+		pr_debug("UPDATED BR PMAP ENTRY %s:%s:%d\n", __FILE__, __func__, __LINE__);
 
 	return ret;
 }
diff --git a/drivers/net/ethernet/lantiq/switch-api/mac/gswss_mac_api.c b/drivers/net/ethernet/lantiq/switch-api/mac/gswss_mac_api.c
index b48779c0a9b4..e45cf69b7cc9 100644
--- a/drivers/net/ethernet/lantiq/switch-api/mac/gswss_mac_api.c
+++ b/drivers/net/ethernet/lantiq/switch-api/mac/gswss_mac_api.c
@@ -143,11 +143,9 @@ u32 gswss_get_1g_intf(void *pdev)
 	if (macif == 0) {
 		mac_dbg("GSWSS: MACIF got for CFG1G is LMAC_GMII\n");
 		macif = LMAC_GMII;
-	} else if (macif == 1) {
+	} else {
 		mac_dbg("GSWSS: MACIF got for CFG1G is XGMAC_GMII\n");
 		macif = XGMAC_GMII;
-	} else {
-		mac_printf("GSWSS: MACIF got for CFG1G is Wrong Value\n");
 	}
 
 	return macif;
@@ -188,11 +186,9 @@ u32 gswss_get_fe_intf(void *pdev)
 	if (macif == 0) {
 		mac_printf("GSWSS: MACIF got for CFGFE is LMAC_MII\n");
 		macif = LMAC_MII;
-	} else if (macif == 1) {
+	} else {
 		mac_printf("GSWSS: MACIF got for CFGFE is XGMAC_GMII\n");
 		macif = XGMAC_GMII;
-	} else {
-		mac_printf("GSWSS: MACIF got for CFGFE is Wrong Value\n");
 	}
 
 	return macif;
@@ -233,11 +229,9 @@ u32 gswss_get_2G5_intf(void *pdev)
 	if (macif == 0) {
 		mac_printf("GSWSS: MACIF Got for 2.5G with XGMAC_GMII\n");
 		macif = XGMAC_GMII;
-	} else if (macif == 1) {
+	} else {
 		mac_printf("GSWSS: MACIF Got for 2.5G with XGMAC_XGMII\n");
 		macif = XGMAC_XGMII;
-	} else {
-		mac_printf("GSWSS: MACIF Got for 2.5G Wrong Value\n");
 	}
 
 	return macif;
diff --git a/drivers/net/ethernet/lantiq/switch-api/mac/xgmac_debug.c b/drivers/net/ethernet/lantiq/switch-api/mac/xgmac_debug.c
index 10f3f462e94f..8b8a308b1e33 100644
--- a/drivers/net/ethernet/lantiq/switch-api/mac/xgmac_debug.c
+++ b/drivers/net/ethernet/lantiq/switch-api/mac/xgmac_debug.c
@@ -153,13 +153,9 @@ int xgmac_get_mtl_tx(void *pdev)
 	if (tx_mode == 1)
 		mac_printf("\tXGMAC %d TX Q Mode: Store and Forward mode\n",
 			   pdata->mac_idx);
-	else if (tx_mode == 0)
-		mac_printf("\tXGMAC %d TX Q Mode: Thresh mode\n",
-			   pdata->mac_idx);
 	else
-		mac_printf("\tXGMAC %d TX Q Mode: unknown mode\n",
+		mac_printf("\tXGMAC %d TX Q Mode: Thresh mode\n",
 			   pdata->mac_idx);
-
 	xgmac_get_tx_threshold(pdev);
 	return 0;
 }
@@ -177,13 +173,9 @@ int xgmac_get_mtl_rx(void *pdev)
 	if (rx_mode == 1)
 		mac_printf("\tXGMAC %d RX Q Mode: Store and Forward mode\n",
 			   pdata->mac_idx);
-	else if (rx_mode == 0)
-		mac_printf("\tXGMAC %d RX Q Mode: Thresh mode\n",
-			   pdata->mac_idx);
 	else
-		mac_printf("\tXGMAC %d RX Q Mode: unknown mode\n",
+		mac_printf("\tXGMAC %d RX Q Mode: Thresh mode\n",
 			   pdata->mac_idx);
-
 	xgmac_get_rx_threshold(pdev);
 	return 0;
 }
diff --git a/drivers/net/ethernet/lantiq/xpcs/xpcs.c b/drivers/net/ethernet/lantiq/xpcs/xpcs.c
index 46adc0b1ae4d..f9c7e2364886 100644
--- a/drivers/net/ethernet/lantiq/xpcs/xpcs.c
+++ b/drivers/net/ethernet/lantiq/xpcs/xpcs.c
@@ -437,7 +437,7 @@ static int xpcs_synphy_reset_sts(struct xpcs_prv_data *pdata)
 	do {
 		reset = XPCS_RGRD_VAL(pdata, PCS_CTRL1, RST);
 
-		if ((reset & 0x8000) == 0)
+		if (reset == 0)
 			break;
 
 		idx++;
diff --git a/include/net/switch_api/lantiq_gsw.h b/include/net/switch_api/lantiq_gsw.h
index 9893cd16e8b0..92415593a2c5 100644
--- a/include/net/switch_api/lantiq_gsw.h
+++ b/include/net/switch_api/lantiq_gsw.h
@@ -2865,7 +2865,7 @@ typedef struct {
 	/** Interface Counter Index Number. (Range : 0-255)
 	    It has to be reserved for ports by the application before
 	    calling \ref GSW_RMON_IF_GET. */
-	u8	nIfId;
+	u16	nIfId;
 	/** Counters Mode - Global level current settings. */
 	GSW_RMON_CountMode_t  countMode;
 	/** Received Total Packets count. */
