From db91073301ecc252c576bc09921f911a7a0a2105 Mon Sep 17 00:00:00 2001
From: Rekha Eswaran <rekha.eswaran@intel.com>
Date: Thu, 17 Oct 2019 11:59:53 +0800
Subject: [PATCH] DRV_DPM_SW-65 - DP configure special bridge port for WLAN to
 add own bport into its bridge member port list

---
 drivers/net/datapath/dpm/datapath.h                   |  5 +++++
 drivers/net/datapath/dpm/datapath_swdev.c             | 16 ++++++++++------
 drivers/net/datapath/dpm/datapath_swdev.h             |  3 +++
 drivers/net/datapath/dpm/gswip31/datapath_misc.c      |  2 ++
 drivers/net/datapath/dpm/gswip31/datapath_switchdev.c | 13 ++++++++++++-
 drivers/net/datapath/dpm/gswip31/datapath_switchdev.h |  2 +-
 include/net/datapath_inst.h                           |  2 +-
 7 files changed, 34 insertions(+), 9 deletions(-)

diff --git a/drivers/net/datapath/dpm/datapath.h b/drivers/net/datapath/dpm/datapath.h
index f592e8ca85f8..7d77fb95b844 100644
--- a/drivers/net/datapath/dpm/datapath.h
+++ b/drivers/net/datapath/dpm/datapath.h
@@ -516,6 +516,11 @@ struct pmac_port_info {
 		       * into other bp's member port map
 		       * if source = dest dp port
 		       */
+	u16 bp_hairpin_cap; /*!< If set, then add BP's in this dev
+			     * into its own bridgeport member list
+			     * For PRX: Only WLAN/Wifi device need
+			     * hair pin capability
+			     */
 	/*only valid for 1st dp instanace which need dp_xmit/dp_rx*/
 	/*[0] for non-checksum case,
 	 *[1] for checksum offload
diff --git a/drivers/net/datapath/dpm/datapath_swdev.c b/drivers/net/datapath/dpm/datapath_swdev.c
index ba5b19f6c542..67c392815d68 100644
--- a/drivers/net/datapath/dpm/datapath_swdev.c
+++ b/drivers/net/datapath/dpm/datapath_swdev.c
@@ -11,7 +11,6 @@
