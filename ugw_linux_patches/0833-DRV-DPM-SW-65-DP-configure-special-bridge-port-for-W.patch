 #include <linux/delay.h>
@@ -23,7 +22,6 @@
 #include <linux/ip.h>
 #include <linux/if_vlan.h>
 #include <net/ip.h>
-#include <linux/ethtool.h>
 #include <net/rtnetlink.h>
 #include <generated/utsrelease.h>
 #include <net/datapath_api.h>
@@ -37,7 +35,7 @@ static void dp_swdev_remove_bridge_id_entry(struct br_info *);
 static int dp_swdev_add_bport_to_list(struct br_info *br_item,
 				      int bport);
 static int dp_swdev_del_bport_from_list(struct br_info *br_item,
-					int bport);
+					int bport, u16 *hairpin_port);
 
 struct hlist_head
 	g_bridge_id_entry_hash_table[DP_MAX_INST][BR_ID_ENTRY_HASH_TABLE_SIZE];
@@ -189,7 +187,7 @@ int dp_swdev_bridge_id_entry_init(void)
 }
 
 static int dp_swdev_del_bport_from_list(struct br_info *br_item,
-					int bport)
+					int bport, u16 *hairpin_bport)
 {
 	int found = 0;
 	struct bridge_member_port *temp_list = NULL;
@@ -197,6 +195,7 @@ static int dp_swdev_del_bport_from_list(struct br_info *br_item,
 	list_for_each_entry(temp_list, &br_item->bp_list, list) {
 		if (temp_list->portid == bport) {
 			found = 1;
+			*hairpin_bport = temp_list->hairpin;
 			break;
 		}
 	}
@@ -232,6 +231,7 @@ static int dp_swdev_add_bport_to_list(struct br_info *br_item,
 		bport_list->dev_reg_flag = br_item->flag;
 		bport_list->portid = bport;
 		bport_list->no_loop_flag = br_item->no_loop_flag;
+		bport_list->hairpin = br_item->hairpin;
 		bport_list->dev_priv_flag = br_item->bp_priv_flag;
 		bport_list->dp_port = br_item->dp_port;
 		DP_DEBUG(DP_DBG_FLAG_SWDEV,
@@ -249,6 +249,7 @@ static int dp_swdev_clr_gswip_cfg(struct bridge_id_entry_item *br_item,
 	struct br_info *br_info;
 	struct pmac_port_info *p_info;
 	struct inst_info *i_info;
+	u16 hairpin = 0;
 	int ret;
 
 	if (br_item->flags == BRIDGE_NO_ACTION) {
@@ -259,14 +260,14 @@ static int dp_swdev_clr_gswip_cfg(struct bridge_id_entry_item *br_item,
 	br_info = dp_swdev_bridge_entry_lookup(br_item->br_device_name);
 	if (!br_info)
 		return 0;
-	if (!dp_swdev_del_bport_from_list(br_info, br_item->portid))
+	if (!dp_swdev_del_bport_from_list(br_info, br_item->portid, &hairpin))
 		return 0;
 	p_info = get_dp_port_info(br_item->inst, br_item->dp_port);
 	if (p_info->swdev_en != 1)
 		return 0;
 	i_info = &dp_port_prop[br_item->inst].info;
 	ret = i_info->swdev_bridge_port_cfg_reset(br_info, br_item->inst,
-						  br_item->portid);
+						  br_item->portid, hairpin);
 	if (ret == DEL_BRENTRY) {
 		i_info->swdev_free_brcfg(br_item->inst, br_item->fid);
 		dp_swdev_remove_bridge_id_entry(br_info);
@@ -386,6 +387,7 @@ static int dp_swdev_cfg_gswip(struct bridge_id_entry_item *br_item,
 			br_info->fid = br_item->fid;
 			br_info->inst = br_item->inst;
 			br_info->no_loop_flag = br_item->no_loop_flag;
+			br_info->hairpin = br_item->hairpin;
 			br_info->bp_priv_flag = br_item->priv_flag;
 			br_info->dp_port = br_item->dp_port;
 
@@ -419,6 +421,7 @@ static int dp_swdev_cfg_gswip(struct bridge_id_entry_item *br_item,
 			return 0;
 		br_info->flag = 0;
 		br_info->no_loop_flag = br_item->no_loop_flag;
+		br_info->hairpin = br_item->hairpin;
 		br_info->bp_priv_flag = br_item->priv_flag;
 		br_info->dp_port = br_item->dp_port;
 
@@ -518,6 +521,7 @@ static int dp_swdev_add_if(struct net_device *dev,
 		p_info = get_dp_port_info(br_item->inst, br_item->dp_port);
 		i_info = &dp_port_prop[br_item->inst].info;
 		br_item->no_loop_flag = p_info->loop_dis;
+		br_item->hairpin = p_info->bp_hairpin_cap;
 		if (br_info) {
 			strcpy(br_item->br_device_name,
 			       br_info->br_device_name);
diff --git a/drivers/net/datapath/dpm/datapath_swdev.h b/drivers/net/datapath/dpm/datapath_swdev.h
index 526ae5980b46..42c9d70a545c 100644
--- a/drivers/net/datapath/dpm/datapath_swdev.h
+++ b/drivers/net/datapath/dpm/datapath_swdev.h
@@ -31,6 +31,7 @@ struct bridge_id_entry_item {
 	u32 inst;
 	u32 priv_flag;
 	u32 no_loop_flag; /* same as loop_dis flag during dp_alloc_port*/
+	u32 hairpin; /* to store if dev has special bridge member config */
 	struct switchdev_trans_item tritem;
 };
 
@@ -42,6 +43,7 @@ struct br_info {
 	u32 inst;
 	u32 bp_priv_flag; /* to store bp dev priv flags (like IFF_NO_QUEUE) */
 	u32 no_loop_flag; /* same as loop_dis flag during dp_alloc_port*/
+	u32 hairpin; /* to store if dev has special bridge member config */
 	u32 dp_port;
 	struct list_head bp_list;
 };
@@ -54,6 +56,7 @@ struct bridge_member_port {
 	u32 dev_priv_flag; /* to store bp dev priv flags (like IFF_NO_QUEUE) */
 	u32 dp_port;
 	u32 no_loop_flag; /* same as loop_dis flag during dp_alloc_port*/
+	u32 hairpin; /* if bridge port needs special bridge member config */
 };
 
 struct fdb_tbl {
