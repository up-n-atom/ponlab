From ff0a7f2113b5cda76aff81b292a17780d37ca9ad Mon Sep 17 00:00:00 2001
From: Xu Liang <liang.xu@intel.com>
Date: Mon, 2 Dec 2019 14:23:50 +0800
Subject: [PATCH] PONRTSYS-6088: GSW API - take care of return error code of
 PCE rule index computation

---
 drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c | 14 +++++++++++---
 1 file changed, 11 insertions(+), 3 deletions(-)

diff --git a/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c b/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c
index 22b09a0e100f..5a7120027717 100644
--- a/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c
+++ b/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c
@@ -18164,7 +18164,7 @@ GSW_return_t GSW_IrqStatusClear(void *cdev, GSW_irq_t *parm)
 	return GSW_statusOk;
 }
 
-static u32 gsw_get_global_baseindex(void *cdev, int index)
+static int gsw_get_global_baseindex(void *cdev, int index)
 {
 	u32 base;
 	ethsw_api_dev_t *gswdev = GSW_PDATA_GET(cdev);
@@ -18187,7 +18187,7 @@ static u32 gsw_get_global_baseindex(void *cdev, int index)
 	return base;
 }
 
-static u32 gsw_get_ctp_baseindex(void *cdev, GSW_PCE_RuleManage_t *parm)
+static int gsw_get_ctp_baseindex(void *cdev, GSW_PCE_RuleManage_t *parm)
 {
 	GSW_CTP_portAssignment_t ctpget;
 	u32 ctp_port, base, num;
@@ -18231,7 +18231,7 @@ static GSW_return_t gsw_pcerulemanage(void *cdev, GSW_PCE_rule_t *parm)
 {
 	int ret;
 	ethsw_api_dev_t *gswdev = GSW_PDATA_GET(cdev);
-	u32 idx, base, num;
+	int idx, base, num;
 	GSW_PCE_RuleManage_t pcerule;
 
 	if (!gswdev) {
@@ -18244,6 +18244,8 @@ static GSW_return_t gsw_pcerulemanage(void *cdev, GSW_PCE_rule_t *parm)
 	switch (parm->region) {
 	case GSW_PCE_RULE_COMMMON:
 		base = gsw_get_global_baseindex(cdev, parm->pattern.nIndex);
+		if (base < 0)
+			return base;
 		idx = base + parm->pattern.nIndex;
 		break;
 
@@ -18252,6 +18254,8 @@ static GSW_return_t gsw_pcerulemanage(void *cdev, GSW_PCE_rule_t *parm)
 		pcerule.subifidgroup = parm->subifidgroup;
 		pcerule.nIndex = parm->pattern.nIndex;
 		base = gsw_get_ctp_baseindex(cdev, &pcerule);
+		if (base < 0)
+			return base;
 		idx = base + parm->pattern.nIndex;
 		break;
 
@@ -18349,6 +18353,8 @@ GSW_return_t GSW_PceRuleDelete(void *cdev, GSW_PCE_ruleDelete_t *parm)
 	switch (parm->region) {
 	case GSW_PCE_RULE_COMMMON:
 		base = gsw_get_global_baseindex(cdev, parm->nIndex);
+		if (base < 0)
+			return base;
 		index = base + parm->nIndex;
 		break;
 
@@ -18357,6 +18363,8 @@ GSW_return_t GSW_PceRuleDelete(void *cdev, GSW_PCE_ruleDelete_t *parm)
 		pcerule.subifidgroup = parm->subifidgroup;
 		pcerule.nIndex = parm->nIndex;
 		base = gsw_get_ctp_baseindex(cdev, &pcerule);
+		if (base < 0)
+			return base;
 		index = base + parm->nIndex;
 		break;
 
