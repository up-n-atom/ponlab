From 67f59a949169b67beb176d44676aba48ec2a3bf7 Mon Sep 17 00:00:00 2001
From: Xu Liang <liang.xu@intel.com>
Date: Tue, 20 Oct 2020 15:09:23 +0800
Subject: [PATCH] DRVLIB_SW-3755: GSW API - add timestamp correction for
 ingress and egress packet

---
 drivers/net/ethernet/lantiq/switch-api/gswip_dev/gsw_dev.c |  6 ++++++
 drivers/net/ethernet/lantiq/switch-api/mac/xgmac.h         |  4 +++-
 drivers/net/ethernet/lantiq/switch-api/mac/xgmac_common.h  |  2 ++
 drivers/net/ethernet/lantiq/switch-api/mac/xgmac_mac_api.c | 13 +++++++++++++
 4 files changed, 24 insertions(+), 1 deletion(-)

diff --git a/drivers/net/ethernet/lantiq/switch-api/gswip_dev/gsw_dev.c b/drivers/net/ethernet/lantiq/switch-api/gswip_dev/gsw_dev.c
index a5d025897aa7..6c660316e2bf 100644
--- a/drivers/net/ethernet/lantiq/switch-api/gswip_dev/gsw_dev.c
+++ b/drivers/net/ethernet/lantiq/switch-api/gswip_dev/gsw_dev.c
@@ -262,6 +262,12 @@ static int gsw_add_macdev(struct gsw_cell *gsw_dev_cell, u32 devid)
 	if (val)
 		mac_pdata->ext_ref_time = true;
 
+	/* Retrieve ingress/egress time correction */
+	of_property_read_s32(gsw_dev_cell->of_node, "ts-ig-corr",
+			     &mac_pdata->ig_corr);
+	of_property_read_s32(gsw_dev_cell->of_node, "ts-eg-corr",
+			     &mac_pdata->eg_corr);
+
 	/* Retrieve the phymode */
 	ret = of_property_read_string(gsw_dev_cell->of_node, "phy-mode",
 				      &mac_pdata->phy_mode);
diff --git a/drivers/net/ethernet/lantiq/switch-api/mac/xgmac.h b/drivers/net/ethernet/lantiq/switch-api/mac/xgmac.h
index ce907b43929c..d439f5c196c6 100644
--- a/drivers/net/ethernet/lantiq/switch-api/mac/xgmac.h
+++ b/drivers/net/ethernet/lantiq/switch-api/mac/xgmac.h
@@ -113,13 +113,15 @@
 #define MAC_TSTAMP_ADDNDR		0x0d18
 #define MAC_SYS_TIME_HWS		0x0d1c
 #define MAC_TSTAMP_STSR			0x0d20
+#define MAC_RX_PCH_CRC_CNT		0x0d2c
 #define MAC_TXTSTAMP_NSECR		0x0d30
 #define MAC_TXTSTAMP_SECR		0x0d34
 #define MAC_TXTSTAMP_STS		0x0d38
 #define MAC_AUX_CTRL			0x0d40
 #define MAC_AUX_NSEC			0x0d48
 #define MAC_AUX_SEC			0x0d4c
-#define MAC_RX_PCH_CRC_CNT		0x0d2c
+#define MAC_TSTAMP_IG_CORR_NS		0x0d58
+#define MAC_TSTAMP_EG_CORR_NS		0x0d60
 
 /* MTL register offsets */
 #define MTL_OMR				0x1000
diff --git a/drivers/net/ethernet/lantiq/switch-api/mac/xgmac_common.h b/drivers/net/ethernet/lantiq/switch-api/mac/xgmac_common.h
index 8ee830615df7..bc6bfed4ffad 100644
--- a/drivers/net/ethernet/lantiq/switch-api/mac/xgmac_common.h
+++ b/drivers/net/ethernet/lantiq/switch-api/mac/xgmac_common.h
@@ -410,6 +410,8 @@ struct mac_prv_data {
 	bool systime_initialized;
 	struct mac_fifo_entry ts_fifo[MAX_FIFO_ENTRY];
 	bool ext_ref_time;
+	s32 ig_corr;
+	s32 eg_corr;
 
 #ifdef __KERNEL__
 	/* will be pointing to skb which is
diff --git a/drivers/net/ethernet/lantiq/switch-api/mac/xgmac_mac_api.c b/drivers/net/ethernet/lantiq/switch-api/mac/xgmac_mac_api.c
index e3174754ada8..d59af3d08a29 100644
--- a/drivers/net/ethernet/lantiq/switch-api/mac/xgmac_mac_api.c
+++ b/drivers/net/ethernet/lantiq/switch-api/mac/xgmac_mac_api.c
@@ -1662,6 +1662,19 @@ int xgmac_set_hwtstamp_settings(void *pdev,
 
 	if (pdata->ptp_flgs.ptp_rx_en & PTP_RX_EN_ALL &&
 	    pdata->ptp_flgs.ptp_tx_en) {
+		u32 val;
+
+		if (pdata->ig_corr >= 0)
+			val = (u32)pdata->ig_corr;
+		else
+			val = (1000000000 + pdata->ig_corr) | 0x80000000;
+		XGMAC_RGWR(pdata, MAC_TSTAMP_IG_CORR_NS, val);
+
+		if (pdata->eg_corr >= 0)
+			val = (u32)pdata->eg_corr;
+		else
+			val = (1000000000 + pdata->eg_corr) | 0x80000000;
+		XGMAC_RGWR(pdata, MAC_TSTAMP_EG_CORR_NS, val);
 		mac_enable_ts(pdev);
 	} else {
 		mac_disable_ts(pdev);
