From 230055a66f1636dbe4c23223955be19a34feeebd Mon Sep 17 00:00:00 2001
From: Elad Fernandes <elad.fernandes@intel.com>
Date: Mon, 19 Oct 2020 17:56:16 +0300
Subject: [PATCH] LMTSYS-4142: Update the LGM PPv4 B-step driver dma allocation
 for using NIOC memory

---
 .../net/ppv4/pp-api/pp-buffer-mgr/pp_buffer_mgr.c  | 12 ++---
 drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_fw.c     |  8 +++-
 drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_main.c   | 55 ++++++++++-----------
 drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.c  |  4 +-
 .../ppv4/pp-api/pp-session-mgr/pp_session_mgr.c    | 10 ++--
 drivers/net/ppv4/pp-dev/pp_dev.c                   | 11 +++++
 drivers/net/ppv4/pp-dev/pp_regs.c                  | 56 +++++++++++++++++-----
 drivers/net/ppv4/pp-hal/checker/checker.c          | 31 +++++-------
 drivers/net/ppv4/pp-hal/classifier/classifier.c    | 39 ++++++---------
 drivers/net/ppv4/pp-hal/micro-controller/uc.c      |  9 ++--
 .../net/ppv4/pp-hal/receive-packet-buffer/rpb.c    |  4 +-
 drivers/net/ppv4/pp-headers/pp_common.h            |  9 +++-
 .../ppv4/pp-tools/unit-test/tests/pp_qos_tests.c   |  5 +-
 13 files changed, 144 insertions(+), 109 deletions(-)

diff --git a/drivers/net/ppv4/pp-api/pp-buffer-mgr/pp_buffer_mgr.c b/drivers/net/ppv4/pp-api/pp-buffer-mgr/pp_buffer_mgr.c
index 5b7e496c8ea2..92b73724254a 100644
--- a/drivers/net/ppv4/pp-api/pp-buffer-mgr/pp_buffer_mgr.c
+++ b/drivers/net/ppv4/pp-api/pp-buffer-mgr/pp_buffer_mgr.c
@@ -1195,7 +1195,7 @@ __bmgr_pool_configure(const struct pp_bmgr_pool_params * const pool_params,
 		pool->sz =
 			pool_params->num_buffers * pool_params->size_of_buffer;
 		pool->sz = PAGE_ALIGN(pool->sz);
-		pool->virt = pp_dma_alloc(pool->sz, GFP_ATOMIC, &pool->phys);
+		pool->virt = pp_dma_alloc(pool->sz, GFP_ATOMIC, &pool->phys, true);
 
 		if (!pool->virt) {
 			pr_err("Could not allocate %u buffers of %u size\n",
@@ -1222,7 +1222,7 @@ __bmgr_pool_configure(const struct pp_bmgr_pool_params * const pool_params,
 					    pool_params->num_buffers);
 	pool->internal_ptrs_virt = pp_dma_alloc(pool->internal_ptrs_sz,
 						GFP_ATOMIC,
-						&pool->internal_ptrs_phys);
+						&pool->internal_ptrs_phys, true);
 
 	if (!pool->internal_ptrs_virt) {
 		pr_err("Could not allocate %u bytes for pool %u pointers\n",
@@ -1283,11 +1283,11 @@ __bmgr_pool_configure(const struct pp_bmgr_pool_params * const pool_params,
 	if (pool->internal_ptrs_virt) {
 		pp_dma_free(pool->internal_ptrs_sz,
 			    (void *)pool->internal_ptrs_virt,
-			    &pool->internal_ptrs_phys);
+			    &pool->internal_ptrs_phys, true);
 		pool->internal_ptrs_sz = 0;
 	}
 	if (pool->virt) {
-		pp_dma_free(pool->sz, pool->virt, &pool->phys);
+		pp_dma_free(pool->sz, pool->virt, &pool->phys, true);
 		pool->virt = 0;
 	}
 	free_pool(*pool_id);
@@ -1428,12 +1428,12 @@ static s32 __bmgr_pool_remove(u8 pool_id, bool lock, bool validate)
 	/* free pointers_table */
 	pp_dma_free(pool->internal_ptrs_sz,
 		    pool->internal_ptrs_virt,
-		    &pool->internal_ptrs_phys);
+		    &pool->internal_ptrs_phys, true);
 
 	/* free the pool memory */
 	if (pool->virt) {
 		pr_info("free pool buffers @ %#llx\n", (u64)pool->phys);
-		pp_dma_free(pool->sz, pool->virt, &pool->phys);
+		pp_dma_free(pool->sz, pool->virt, &pool->phys, true);
 		pool->virt = 0;
 	}
 
diff --git a/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_fw.c b/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_fw.c
index dc0a2f1bb817..83dcca9ece83 100644
--- a/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_fw.c
+++ b/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_fw.c
@@ -249,7 +249,7 @@ s32 do_load_firmware(struct pp_qos_dev *qdev,
 			     ALIGN(stack_sz, align);
 	}
 
-	virt_txt = pp_dma_alloc(alloc_size, GFP_KERNEL, &phys_txt);
+	virt_txt = pp_dma_alloc(alloc_size, GFP_KERNEL, &phys_txt, true);
 	if (!virt_txt) {
 		pr_err("Could not allocate %u bytes for fw\n", alloc_size);
 		kfree(secs);
@@ -1164,7 +1164,11 @@ void create_init_qos_cmd(struct pp_qos_dev *qdev)
 	cmd_init(qdev, &cmd.base, CMD_TYPE_INIT_QOS,
 		 sizeof(cmd), 0, NULL, 0, 0);
 	cmd.fw.base.type = UC_QOS_CMD_INIT_QOS;
-	cmd.fw.qm_ddr_start = qdev->hwconf.qm_ddr_phys;
+
+	if (IS_ENABLED(CONFIG_PPV4_LGM))
+		cmd.fw.qm_ddr_start = qdev->hwconf.qm_ddr_phys >> 4;
+	else
+		cmd.fw.qm_ddr_start = qdev->hwconf.qm_ddr_phys;
 	cmd.fw.qm_num_pages = qdev->hwconf.qm_num_pages;
 	cmd.fw.wred_total_avail_resources =
 		qdev->init_params.wred_total_avail_resources;
diff --git a/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_main.c b/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_main.c
index 0a5674c4ea10..3cd06cc048d8 100644
--- a/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_main.c
+++ b/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_main.c
@@ -3905,25 +3905,20 @@ EXPORT_SYMBOL(pp_qos_shared_limit_group_get_members);
 
 s32 __qos_ddr_allocate(struct pp_qos_dev *qdev)
 {
-	dma_addr_t dma;
 	struct hw_conf *cfg = &qdev->hwconf;
 
 	/* Allocate queue manager descriptor buffer */
 	cfg->qm_sz = PAGE_ALIGN(qdev->init_params.wred_total_avail_resources *
 				PPV4_QOS_DESC_SIZE);
 
-	cfg->qm_ddr_virt = pp_dma_alloc(cfg->qm_sz, GFP_KERNEL, &dma);
+	cfg->qm_ddr_virt =
+		pp_dma_alloc(cfg->qm_sz, GFP_KERNEL, &cfg->qm_ddr_phys, false);
 	if (unlikely(!cfg->qm_ddr_virt)) {
 		pr_err("Could not allocate %u bytes for queue manager\n",
 		       (u32)cfg->qm_sz);
 		goto qm_alloc_err;
 	}
 
-	if (IS_ENABLED(CONFIG_PPV4_LGM))
-		cfg->qm_ddr_phys = dma >> 4;
-	else
-		cfg->qm_ddr_phys = (u32)(dma);
-
 	cfg->qm_num_pages =
 		qdev->init_params.wred_total_avail_resources /
 		PPV4_QOS_DESC_IN_PAGE;
@@ -3931,7 +3926,7 @@ s32 __qos_ddr_allocate(struct pp_qos_dev *qdev)
 	/* Allocate FW Logger buffer */
 	cfg->fw_logger_sz = PAGE_ALIGN(PPV4_QOS_LOGGER_BUF_SIZE);
 	cfg->fw_logger_ddr_virt = pp_dma_alloc(cfg->fw_logger_sz, GFP_KERNEL,
-					       &cfg->fw_logger_ddr_phys);
+					       &cfg->fw_logger_ddr_phys, true);
 	if (unlikely(!cfg->fw_logger_ddr_virt)) {
 		pr_err("Could not allocate %u bytes for logger\n",
 		       (u32)cfg->fw_logger_sz);
@@ -3941,7 +3936,7 @@ s32 __qos_ddr_allocate(struct pp_qos_dev *qdev)
 	/* Allocate FW Statistics buffer */
 	cfg->fw_stats_sz = PAGE_ALIGN(PPV4_QOS_STAT_SIZE);
 	cfg->fw_stats_ddr_virt = pp_dma_alloc(cfg->fw_stats_sz, GFP_KERNEL,
-					      &cfg->fw_stats_ddr_phys);
+					      &cfg->fw_stats_ddr_phys, true);
 	if (unlikely(!cfg->fw_stats_ddr_virt)) {
 		pr_err("Could not allocate %u bytes for stats buffer\n",
 		       (u32)cfg->fw_stats_sz);
@@ -3952,7 +3947,7 @@ s32 __qos_ddr_allocate(struct pp_qos_dev *qdev)
 	cfg->max_allow_sz =
 		PAGE_ALIGN(qdev->init_params.max_queues * sizeof(u32));
 	cfg->max_allow_ddr_virt = pp_dma_alloc(cfg->max_allow_sz, GFP_KERNEL,
-					       &cfg->max_allow_ddr_phys);
+					       &cfg->max_allow_ddr_phys, true);
 	if (unlikely(!cfg->max_allow_ddr_virt)) {
 		pr_err("Could not allocate %u bytes for max allowed buffer\n",
 		       (u32)cfg->max_allow_sz);
@@ -3963,7 +3958,8 @@ s32 __qos_ddr_allocate(struct pp_qos_dev *qdev)
 	cfg->wsp_queues_sz = PAGE_ALIGN((QOS_ENHANCED_WSP_MAX_QUEUES *
 					sizeof(struct wsp_queue_t)) + 4);
 	cfg->wsp_queues_ddr_virt = pp_dma_alloc(cfg->wsp_queues_sz, GFP_KERNEL,
-						&cfg->wsp_queues_ddr_phys);
+						&cfg->wsp_queues_ddr_phys,
+						true);
 	if (unlikely(!cfg->wsp_queues_ddr_virt)) {
 		pr_err("Could not allocate %u bytes for wsp list buffer\n",
 		       (u32)cfg->wsp_queues_sz);
@@ -3990,7 +3986,7 @@ s32 __qos_ddr_allocate(struct pp_qos_dev *qdev)
 	 */
 	cfg->bwl_sz = PAGE_ALIGN(2 * NUM_OF_NODES * sizeof(u32));
 	cfg->bwl_ddr_virt = pp_dma_alloc(cfg->bwl_sz, GFP_KERNEL,
-					 &cfg->bwl_ddr_phys);
+					 &cfg->bwl_ddr_phys, true);
 	if (unlikely(!cfg->bwl_ddr_virt)) {
 		pr_err("Could not allocate %u bytes for bwl buffer\n",
 		       (u32)cfg->bwl_sz);
@@ -4000,7 +3996,7 @@ s32 __qos_ddr_allocate(struct pp_qos_dev *qdev)
 	/* Allocate SBWL allowed buffer */
 	cfg->sbwl_sz = PAGE_ALIGN(NUM_OF_NODES * sizeof(u32));
 	cfg->sbwl_ddr_virt = pp_dma_alloc(cfg->sbwl_sz, GFP_KERNEL,
-					  &cfg->sbwl_ddr_phys);
+					  &cfg->sbwl_ddr_phys, true);
 	if (unlikely(!cfg->sbwl_ddr_virt)) {
 		pr_err("Could not allocate %u bytes for sbwl buffer\n",
 		       (u32)cfg->sbwl_sz);
@@ -4010,7 +4006,7 @@ s32 __qos_ddr_allocate(struct pp_qos_dev *qdev)
 	/* Allocate buffer for dma usage */
 	cfg->dma_buff_sz = PAGE_ALIGN(PPV4_QOS_DMA_BUFF_SIZE);
 	cfg->dma_buff_virt = pp_dma_alloc(cfg->dma_buff_sz, GFP_KERNEL,
-					  &cfg->dma_buff_phys);
+					  &cfg->dma_buff_phys, true);
 	if (unlikely(!cfg->dma_buff_virt)) {
 		pr_err("Could not allocate %u bytes for dma buffer\n",
 		       (u32)cfg->dma_buff_sz);
@@ -4020,10 +4016,11 @@ s32 __qos_ddr_allocate(struct pp_qos_dev *qdev)
 	return 0;
 
 dma_buff_err:
-	pp_dma_free(cfg->sbwl_sz, cfg->sbwl_ddr_virt, &cfg->sbwl_ddr_phys);
+	pp_dma_free(cfg->sbwl_sz, cfg->sbwl_ddr_virt, &cfg->sbwl_ddr_phys,
+		    true);
 
 sbwl_alloc_err:
-	pp_dma_free(cfg->bwl_sz, cfg->bwl_ddr_virt, &cfg->bwl_ddr_phys);
+	pp_dma_free(cfg->bwl_sz, cfg->bwl_ddr_virt, &cfg->bwl_ddr_phys, true);
 
 bwl_alloc_err:
 	kfree(qdev->hwconf.rlms_container);
@@ -4035,30 +4032,30 @@ s32 __qos_ddr_allocate(struct pp_qos_dev *qdev)
 	/* Free wsp queue list buffer */
 	pp_dma_free(cfg->wsp_queues_sz,
 		    cfg->wsp_queues_ddr_virt,
-		    &cfg->wsp_queues_ddr_phys);
+		    &cfg->wsp_queues_ddr_phys, true);
 
 wsp_alloc_err:
 	/* Free max allowed buffer */
 	pp_dma_free(cfg->max_allow_sz,
 		    cfg->max_allow_ddr_virt,
-		    &cfg->max_allow_ddr_phys);
+		    &cfg->max_allow_ddr_phys, true);
 
 max_allowed_alloc_err:
 	/* Free stats buffer */
 	pp_dma_free(cfg->fw_stats_sz,
 		    cfg->fw_stats_ddr_virt,
-		    &cfg->fw_stats_ddr_phys);
+		    &cfg->fw_stats_ddr_phys, true);
 
 stats_alloc_err:
 	/* Free Logger */
 	pp_dma_free(cfg->fw_logger_sz,
 		    cfg->fw_logger_ddr_virt,
-		    &cfg->fw_logger_ddr_phys);
+		    &cfg->fw_logger_ddr_phys, true);
 logger_alloc_err:
 	/* Free QM */
 	pp_dma_free(cfg->qm_sz,
 		    cfg->qm_ddr_virt,
-		    &cfg->qm_ddr_phys);
+		    &cfg->qm_ddr_phys, false);
 qm_alloc_err:
 	return -ENOMEM;
 }
@@ -4069,55 +4066,55 @@ void __qos_ddr_free(struct pp_qos_dev *qdev)
 	if (qdev->hwconf.qm_ddr_virt) {
 		pp_dma_free(qdev->hwconf.qm_sz,
 			    qdev->hwconf.qm_ddr_virt,
-			    &qdev->hwconf.qm_ddr_phys);
+			    &qdev->hwconf.qm_ddr_phys, false);
 	}
 
 	/* Free FW Logger buffer */
 	if (qdev->hwconf.fw_logger_ddr_virt) {
 		pp_dma_free(qdev->hwconf.fw_logger_sz,
 			    qdev->hwconf.fw_logger_ddr_virt,
-			    &qdev->hwconf.fw_logger_ddr_phys);
+			    &qdev->hwconf.fw_logger_ddr_phys, true);
 	}
 
 	/* Free FW Statistics buffer */
 	if (qdev->hwconf.fw_stats_ddr_virt) {
 		pp_dma_free(qdev->hwconf.fw_stats_sz,
 			    qdev->hwconf.fw_stats_ddr_virt,
-			    &qdev->hwconf.fw_stats_ddr_phys);
+			    &qdev->hwconf.fw_stats_ddr_phys, true);
 	}
 
 	/* Free wsp queue list buffer */
 	if (qdev->hwconf.wsp_queues_ddr_virt) {
 		pp_dma_free(qdev->hwconf.wsp_queues_sz,
 			    qdev->hwconf.wsp_queues_ddr_virt,
-			    &qdev->hwconf.wsp_queues_ddr_phys);
+			    &qdev->hwconf.wsp_queues_ddr_phys, true);
 	}
 
 	/* Free max allow buffer */
 	if (qdev->hwconf.max_allow_ddr_virt) {
 		pp_dma_free(qdev->hwconf.max_allow_sz,
 			    qdev->hwconf.max_allow_ddr_virt,
-			    &qdev->hwconf.max_allow_ddr_phys);
+			    &qdev->hwconf.max_allow_ddr_phys, true);
 	}
 
 	/* Free BWL buffer */
 	if (qdev->hwconf.bwl_ddr_virt) {
 		pp_dma_free(qdev->hwconf.bwl_sz,
 			    qdev->hwconf.bwl_ddr_virt,
-			    &qdev->hwconf.bwl_ddr_phys);
+			    &qdev->hwconf.bwl_ddr_phys, true);
 	}
 
 	/* Free SBWL buffer */
 	if (qdev->hwconf.sbwl_ddr_virt) {
 		pp_dma_free(qdev->hwconf.sbwl_sz,
 			    qdev->hwconf.sbwl_ddr_virt,
-			    &qdev->hwconf.sbwl_ddr_phys);
+			    &qdev->hwconf.sbwl_ddr_phys, true);
 	}
 
 	if (qdev->hwconf.dma_buff_virt) {
 		pp_dma_free(qdev->hwconf.dma_buff_sz,
 			    qdev->hwconf.dma_buff_virt,
-			    &qdev->hwconf.dma_buff_phys);
+			    &qdev->hwconf.dma_buff_phys, true);
 	}
 
 	/* Free API string buffer */
diff --git a/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.c b/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.c
index 734d8fa52625..bb8b34d5d662 100644
--- a/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.c
+++ b/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.c
@@ -4545,7 +4545,7 @@ void qos_descriptor_pop(struct pp_qos_dev *qdev, u32 queue_id, u32 *descriptor)
 
 	memset(descriptor, 0, 16);
 	sz = PAGE_ALIGN(QOS_DESC_WORDS_CNT * sizeof(u32));
-	desc_addr = pp_dma_alloc(sz, GFP_KERNEL, &desc_addr_phys);
+	desc_addr = pp_dma_alloc(sz, GFP_KERNEL, &desc_addr_phys, true);
 	if (!desc_addr)
 		return;
 
@@ -4570,7 +4570,7 @@ void qos_descriptor_pop(struct pp_qos_dev *qdev, u32 queue_id, u32 *descriptor)
 
 free_mem:
 	QOS_UNLOCK(qdev);
-	pp_dma_free(sz, desc_addr, &desc_addr_phys);
+	pp_dma_free(sz, desc_addr, &desc_addr_phys, true);
 }
 
 static void qos_init_wred_ports_flm(struct pp_qos_dev *qdev)
diff --git a/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c b/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c
index 8e28e843a230..b9fa5dc8a028 100644
--- a/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c
+++ b/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c
@@ -4395,9 +4395,8 @@ static s32 __smgr_db_init(struct pp_smgr_init_param *init_param)
 		BITS_TO_LONGS(db->inact_bmap_sz) * sizeof(ulong);
 
 	db->inact_bmap_sz = PAGE_ALIGN(db->inact_bmap_sz);
-	db->inact_bmap    = dma_zalloc_coherent(dev, db->inact_bmap_sz,
-						&db->inact_bmap_phys,
-						GFP_KERNEL);
+	db->inact_bmap    = pp_dma_alloc(db->inact_bmap_sz, GFP_KERNEL,
+					 &db->inact_bmap_phys, false);
 	if (!db->inact_bmap) {
 		pr_err("Failed to allocate %zu bytes for inactive sessions map\n",
 		       db->inact_bmap_sz);
@@ -4464,8 +4463,9 @@ static void __smgr_db_destroy(void)
 		devm_kfree(dev, db->udp_bmap);
 
 	kmem_cache_destroy(db->work_args_cache);
-	dma_free_coherent(dev, db->inact_bmap_sz,
-			  db->inact_bmap, db->inact_bmap_phys);
+	pp_dma_free(db->inact_bmap_sz, db->inact_bmap, &db->inact_bmap_phys,
+		    false);
+
 	devm_kfree(dev, db);
 	db = NULL;
 }
diff --git a/drivers/net/ppv4/pp-dev/pp_dev.c b/drivers/net/ppv4/pp-dev/pp_dev.c
index bd6475b72d08..45ebdab66179 100644
--- a/drivers/net/ppv4/pp-dev/pp_dev.c
+++ b/drivers/net/ppv4/pp-dev/pp_dev.c
@@ -537,6 +537,17 @@ static int __pp_dev_probe(struct platform_device *pdev)
 		return probe_ret;
 	}
 
+#ifdef CONFIG_PPV4_LGM
+	if (pp_silicon_step_get() == PP_SSTEP_B) {
+		probe_ret = dma_set_mask_and_coherent(&pp_pdev->dev,
+						      DMA_BIT_MASK(64));
+		if (probe_ret) {
+			pr_err("Set dma bitmask to 64 failed!\n");
+			return probe_ret;
+		}
+	}
+#endif
+
 	/* init unit tests */
 	if (IS_ENABLED(CONFIG_PPV4_UT) && IS_ENABLED(CONFIG_DEBUG_FS)) {
 		probe_ret = pput_init(pp_dbgfs_dir);
diff --git a/drivers/net/ppv4/pp-dev/pp_regs.c b/drivers/net/ppv4/pp-dev/pp_regs.c
index 82e00c7b67c6..b9eb17bcbb26 100644
--- a/drivers/net/ppv4/pp-dev/pp_regs.c
+++ b/drivers/net/ppv4/pp-dev/pp_regs.c
@@ -6,11 +6,13 @@
  * Copyright (C) 2018-2020 Intel Corporation
  */
 #include <linux/kernel.h>
+#include <linux/dma-mapping.h>
 #include <linux/types.h>
 #include <linux/init.h>
 #include <linux/bitops.h>
 #include <linux/bitmap.h>
 #include "pp_regs.h"
+#include "infra.h" /* For checking the Silicon step */
 
 /**
  * @brief Add function name and line number for all pr_* prints
@@ -250,17 +252,32 @@ inline void pp_memcpy(void *dst, void *src, u32 cnt)
 	}
 }
 
-void *pp_dma_alloc(size_t size, gfp_t flag, dma_addr_t *dma_handle)
+void *pp_dma_alloc(size_t size, gfp_t flag, dma_addr_t *dma_handle, bool ioc)
 {
 	void *addr;
 #ifndef CONFIG_PPV4_LGM
 	struct pp_io_region region;
 #endif
-	addr = dma_zalloc_coherent(pp_dev_get(), size, dma_handle, flag);
+
+	/* For A-step and FLM (DMA mask 32) the default is none IOC memory
+	 * For B-step (DMA mask 64) the default is IOC so we remap later
+	 */
+	addr = dmam_alloc_coherent(pp_dev_get(), size, dma_handle,
+				   flag | __GFP_ZERO);
 	if (!addr)
 		return NULL;
 
-#ifndef CONFIG_PPV4_LGM
+#ifdef CONFIG_PPV4_LGM
+	/* Mapping is done for B-step */
+	if (!ioc && pp_silicon_step_get() == PP_SSTEP_B) {
+		if (*dma_handle & BIT_ULL(34)) {
+			*dma_handle &= ~BIT_ULL(34);
+			*dma_handle |= BIT_ULL(32) | BIT_ULL(33) | BIT_ULL(35);
+		} else {
+			*dma_handle |= BIT_ULL(34) | BIT_ULL(35);
+		}
+	}
+#else
 	/* For FLM make sure to store original virtual address */
 	region.virt = addr;
 	region.phys = *dma_handle;
@@ -275,17 +292,34 @@ void *pp_dma_alloc(size_t size, gfp_t flag, dma_addr_t *dma_handle)
 	return addr;
 }
 
-void pp_dma_free(size_t size, void *address, dma_addr_t *dma_handle)
+void pp_dma_free(size_t size, void *address, dma_addr_t *dma_handle, bool ioc)
 {
 	void *virt_addr;
 
-	/* In FLM use stored virtual address rather than the user's address */
-	if (!IS_ENABLED(CONFIG_PPV4_LGM))
-		virt_addr = pp_phys_to_virt(*dma_handle);
-	else
