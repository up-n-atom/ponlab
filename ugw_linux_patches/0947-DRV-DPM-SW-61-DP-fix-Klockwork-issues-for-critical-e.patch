 /*!
-*@brief get network device's MTU
-*@param[in] dev: network device pointer
-*@param[out] mtu_size: return the MTU value in the specified memory if valid.
-*@Returns DP_SUCCESS on succeed and DP_FAILURE on failure
-*/
+ *@brief get network device's MTU
+ *@param[in] dev: network device pointer
+ *@param[out] mtu_size: return the MTU value in the specified memory if valid.
+ *@Returns DP_SUCCESS on succeed and DP_FAILURE on failure
+ */
 /* This API will be enhanced later based on netdevice */
 int dp_get_mtu_size(struct net_device *dev, u32 *mtu_size)
 {
diff --git a/drivers/net/datapath/dpm/datapath_dev.c b/drivers/net/datapath/dpm/datapath_dev.c
new file mode 100644
index 000000000000..d8120b85e0fd
--- /dev/null
+++ b/drivers/net/datapath/dpm/datapath_dev.c
@@ -0,0 +1,97 @@
+
+#include<linux/init.h>
+#include<linux/module.h>
+#include <linux/kernel.h>
+#include <linux/types.h>
+#include <linux/version.h>
+#include <linux/ethtool.h>
+#include <linux/proc_fs.h>
+#include <linux/delay.h>
+#include <linux/init.h>
+#include <linux/clk.h>
+#include <linux/if_ether.h>
+#include <net/datapath_api.h>
+#include "datapath.h"
+
+struct net_device *g_dp_dev;
+static int dp_device_set_mac_address(struct net_device *dev,
+				     void *p)
+{
+	struct sockaddr *addr = p;
+
+	if (netif_running(dev))
+		return -EBUSY;
+
+	if (!is_valid_ether_addr(addr->sa_data))
+		return -EINVAL;
+
+	memcpy(dev->dev_addr, addr->sa_data, dev->addr_len);
+
+	return 0;
+}
+
+static int dp_device_open(struct net_device *dev)
+{
+	netif_start_queue(dev);
+	return 0;
+}
+
+static int dp_device_close(struct net_device *dev)
+{
+	netif_stop_queue(dev);
+	return 0;
+}
+
+static int dp_device_xmit(struct sk_buff *skb, struct net_device *dev)
+{
+	dev_kfree_skb(skb);
+	return 0;
+}
+
+static int dp_device_ioctl(struct net_device *dev, struct ifreq *ifr, int cmd)
+{
+	return -EOPNOTSUPP;
+}
+
+static int dp_device_init(struct net_device *dev)
+{
+	return 0;
+}
+
+static const struct net_device_ops dp_device_ops = {
+	.ndo_init         = dp_device_init,
+	.ndo_open         = dp_device_open,
+	.ndo_stop         = dp_device_close,
+	.ndo_start_xmit   = dp_device_xmit,
+	.ndo_do_ioctl     = dp_device_ioctl,
+	.ndo_set_mac_address = dp_device_set_mac_address,
+};
+
+static void dp_device_setup(struct net_device *dev)
+{
+	ether_setup(dev);
+	dev->netdev_ops = &dp_device_ops;
+}
+
+int dp_create_device(void)
+{
+	char ifname[IFNAMSIZ];
+
+	snprintf(ifname, sizeof(ifname), "dp_dev");
+	g_dp_dev = alloc_netdev(0, ifname, NET_NAME_ENUM,
+				dp_device_setup);
+
+	if (register_netdev(g_dp_dev)) {
+		free_netdev(g_dp_dev);
+		pr_err("register datapath device fail:%s\n", ifname);
+		return -1;
+	}
+	return 0;
+}
+
+int dp_remove_device(void)
+{
+	unregister_netdev(g_dp_dev);
+	free_netdev(g_dp_dev);
+	return 0;
+}
