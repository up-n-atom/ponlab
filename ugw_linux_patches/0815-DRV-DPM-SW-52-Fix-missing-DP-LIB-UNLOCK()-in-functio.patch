From 879eb3f61a43f1cd190b7938ce16c5664495a496 Mon Sep 17 00:00:00 2001
From: Gu Chao <gux.chao@intel.com>
Date: Mon, 30 Sep 2019 16:35:59 +0800
Subject: [PATCH] DRV_DPM_SW-52: Fix missing DP_LIB_UNLOCK() in function
 dp_register_subif_ext()

---
 drivers/net/datapath/dpm/datapath_api.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/drivers/net/datapath/dpm/datapath_api.c b/drivers/net/datapath/dpm/datapath_api.c
index 7f866a4c516f..dda97335d2bd 100644
--- a/drivers/net/datapath/dpm/datapath_api.c
+++ b/drivers/net/datapath/dpm/datapath_api.c
@@ -1172,6 +1172,7 @@ int32_t dp_register_subif_ext(int inst, struct module *owner,
 	if (!subif_id_sync) {
 		pr_err("Failed to alloc %zu bytes\n",
 		       sizeof(*subif_id_sync) * 2);
+		DP_LIB_UNLOCK(&dp_lock);
 		return DP_FAILURE;
 	}
 	memcpy(&subif_id_sync[0], subif_id, sizeof(dp_subif_t));
