@@ -2482,6 +2482,7 @@ static void fill_tx_ring_data(struct cbm_dp_alloc_complete_data *dp_data)
 		dp_data->tx_ring[ring_idx]->policy_num = 1;
 		dp_data->tx_ring[ring_idx]->tx_pkt_size = 0;
 		dp_data->tx_ring[ring_idx]->tx_poolid = 0;
+		dp_data->tx_ring[ring_idx]->tx_deq_port = dp_data->deq_port;
 	}
 }
 
diff --git a/include/net/datapath_api.h b/include/net/datapath_api.h
index 5bdf1a1ff02d..948d9c9458a2 100644
