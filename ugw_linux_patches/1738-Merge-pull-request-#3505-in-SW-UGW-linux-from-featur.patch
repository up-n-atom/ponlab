+++ b/include/net/datapath_api.h
@@ -1339,6 +1339,7 @@ struct dp_tx_ring {
 				  * Note, this setting is not valid for
 				  *GRX500/FLM
 				  */
+	u32 tx_deq_port; /*!< [out] cqm deque port id for this txin ring */
 };
 
