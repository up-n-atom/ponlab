diff --git a/drivers/net/datapath/mcast_bridge_filter/Kconfig b/drivers/net/datapath/mcast_bridge_filter/Kconfig
new file mode 100644
index 000000000000..86617687c215
--- /dev/null
+++ b/drivers/net/datapath/mcast_bridge_filter/Kconfig
@@ -0,0 +1,11 @@
+if INTEL_DATAPATH
+
+config DP_MCAST_BRIDGE_FILTER
+	tristate "Datapath multicast packet bridge filter"
+
+	help
+	  This installs a netfilter hook which filters out all multicast
+	  packets on all bridges. These packages can then be handled in
+	  user space applications.
+
+endif
diff --git a/drivers/net/datapath/mcast_bridge_filter/Makefile b/drivers/net/datapath/mcast_bridge_filter/Makefile
new file mode 100644
index 000000000000..9890e5bbd813
--- /dev/null
+++ b/drivers/net/datapath/mcast_bridge_filter/Makefile
@@ -0,0 +1,2 @@
