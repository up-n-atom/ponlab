index 48e0dfeb3902..0bef26607a98 100644
--- a/drivers/net/datapath/Kconfig
+++ b/drivers/net/datapath/Kconfig
@@ -14,4 +14,5 @@ source "drivers/net/datapath/umt/Kconfig"
