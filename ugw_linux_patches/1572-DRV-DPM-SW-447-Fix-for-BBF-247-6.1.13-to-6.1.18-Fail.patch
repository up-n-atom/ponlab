From 2beadc8a21db18d9ff01dbadd7e1710046c35b36 Mon Sep 17 00:00:00 2001
From: thampan <joby.thampan@intel.com>
Date: Tue, 12 Jan 2021 01:30:32 +0800
Subject: [PATCH] DRV_DPM_SW-447: Fix for BBF 247 6.1.13 to 6.1.18 Fail

---
 drivers/net/datapath/dpm/gswip31/datapath_misc.c | 94 +++++++++++++++++-------
 1 file changed, 67 insertions(+), 27 deletions(-)

diff --git a/drivers/net/datapath/dpm/gswip31/datapath_misc.c b/drivers/net/datapath/dpm/gswip31/datapath_misc.c
index 2fb5c93ffbda..ec63c3bd2f57 100644
--- a/drivers/net/datapath/dpm/gswip31/datapath_misc.c
+++ b/drivers/net/datapath/dpm/gswip31/datapath_misc.c
@@ -503,17 +503,19 @@ static int dp_set_io_port(int inst, int dpid, int vap, int type)
  */
 static void init_dma_pmac_template(int portid, u32 flags)
 {
-	int i = 0;
+	int i = 0, j = 0;
 	struct pmac_port_info *dp_info = get_dp_port_info(0, portid);
 	unsigned long *bits = (unsigned long *)&flags;
 
 	for (i = 0; i < MAX_TEMPLATE; i++) {
+		for (j = 0; j < 4; j++) {
+			memset(&dp_info->desc_dw_templ[j][i], 0, sizeof(u32));
+			memset(&dp_info->desc_dw_mask[j][i], 0, sizeof(u32));
+		}
+		memset(&dp_info->pmac_template[i], 0, sizeof(u32));
+
 		dma_mask_templ(dp_info, i, DESC_DW0_ALL | DESC_DW1_ALL,
 			       0xFFFFFFFF);
-
-		/* Set Redirect=1 for all templates */
-		dma_pmac_templ(dp_info, i, DESC_REDIR | P_CLS_EN, 1);
-		dma_pmac_templ(dp_info, i, (P_IGP_MSB | P_IGP_EGP), portid);
 	}
 
 	for_each_set_bit(i, bits, __bf_shf(DP_F_DEV_END)) {
@@ -524,6 +526,11 @@ static void init_dma_pmac_template(int portid, u32 flags)
 		case __bf_shf(DP_F_EPON):
 		case __bf_shf(DP_F_GINT):
 
+			for (j = 0; j < MAX_TEMPLATE; j++) {
+				dma_pmac_templ(dp_info, j,
+					       DESC_REDIR | P_CLS_EN, 1);
+				dma_pmac_templ(dp_info, j, P_IGP_EGP, portid);
+			}
 			dma_pmac_templ(dp_info, TEMPL_PTP, P_PTP, 1);
 
 			/* To have a specific Q for Reinsertion lookup is like
@@ -531,29 +538,56 @@ static void init_dma_pmac_template(int portid, u32 flags)
 			 * EP is set as 0 to select Lookup Mode 0
 			 */
 			dma_mask_templ(dp_info, TEMPL_INSERT,
-				       (DESC_REDIR | DESC_DEC | DESC_MPE1 | DESC_MPE2 | DESC_EGP), 0);
-			dma_pmac_templ(dp_info, TEMPL_INSERT, P_INS | DESC_ENC, 1);
+				       (DESC_REDIR | DESC_DEC | DESC_MPE1 |
+					DESC_MPE2 | DESC_EGP), 0);
+			dma_pmac_templ(dp_info, TEMPL_INSERT, DESC_REDIR, 0);
+			dma_pmac_templ(dp_info, TEMPL_INSERT,
+				       P_INS | DESC_ENC, 1);
 			break;
 		case __bf_shf(DP_F_VUNI):
 
 			dma_mask_templ(dp_info, TEMPL_NORMAL, DESC_REDIR, 0);
+			dma_pmac_templ(dp_info, TEMPL_NORMAL, DESC_REDIR, 0);
 			dma_pmac_templ(dp_info, TEMPL_NORMAL, DESC_MPE2, 1);
 			dma_pmac_templ(dp_info, TEMPL_NORMAL,
 				       (DESC_EGP | DESC_IGP), portid);
+			dma_pmac_templ(dp_info, TEMPL_NORMAL,
+				       P_IGP_EGP | P_IGP_MSB, portid);
 			break;
 		case __bf_shf(DP_F_FAST_DSL):
 
-			/* Template checksum needed for DSL and Default case */
+			/* For normal single DSL upstream, there is no pmac
+			 * at all
+			 */
 			dma_mask_templ(dp_info, TEMPL_NORMAL, DESC_ENC, 0);
 			dma_pmac_templ(dp_info, TEMPL_NORMAL,
 				       (DESC_DEC | DESC_MPE2), 1);
+
+			/* DSL with checksum support */
+			dma_pmac_templ(dp_info, TEMPL_CHECKSUM, P_IGP_MSB,
+				       portid);
+			dma_pmac_templ(dp_info, TEMPL_CHECKSUM,
+				       (P_TCP_CSUM | DESC_DEC | DESC_ENC |
+					DESC_MPE2 | P_CLS_EN | DESC_REDIR), 1);
+
+			/* Bonding DSL  FCS Support via GSWIP */
+			dma_pmac_templ(dp_info, TEMPL_OTHERS,
+				       (P_TCP_CSUM | DESC_DEC | DESC_ENC |
+					DESC_MPE2 | P_CLS_EN | DESC_REDIR), 1);
 			dma_pmac_templ(dp_info, TEMPL_OTHERS,
-				       (DESC_DEC | DESC_ENC | DESC_MPE2), 1);
+				       P_IGP_EGP | P_IGP_MSB, portid);
+			break;
 		default:
 			dma_pmac_templ(dp_info, TEMPL_CHECKSUM, P_IGP_MSB,
 				       PMAC_CPU_ID);
+			dma_pmac_templ(dp_info, TEMPL_CHECKSUM, P_IGP_EGP,
+				       portid);
 			dma_pmac_templ(dp_info, TEMPL_CHECKSUM,
-				       (P_TCP_CSUM | DESC_DEC | DESC_ENC | DESC_MPE2), 1);
+				       (P_TCP_CSUM | DESC_DEC | DESC_ENC |
+					DESC_MPE2 | P_CLS_EN | DESC_REDIR), 1);
+			dma_pmac_templ(dp_info, TEMPL_NORMAL,
+				       P_IGP_MSB | P_IGP_EGP, portid);
+			dma_pmac_templ(dp_info, TEMPL_NORMAL, P_CLS_EN, 1);
 			break;
 		}
 	}
@@ -1411,7 +1445,7 @@ static int dp_platform_set(int inst, u32 flag)
 		}
 
 		if (dp_gsw_color_table_set(inst)) {
-			pr_err("%s: dp_platform_color_table_set Failed\n",
+			pr_err("%s: dp_gsw_color_table_set Failed\n",
 			       __func__);
 			return DP_FAILURE;
 		}
@@ -1447,7 +1481,7 @@ static int dp_platform_set(int inst, u32 flag)
 	priv = (struct hal_priv *)dp_prop->priv_hal;
 	if (priv->bp_def)
 		dp_gsw_free_bp(inst, priv->bp_def);
-	init_ppv4_qos(inst, flag); /*de-initialize qos */
+	init_ppv4_qos(inst, flag); /* de-initialize qos */
 	devm_kfree(&g_dp_dev->dev, priv);
 #if IS_ENABLED(CONFIG_INTEL_DATAPATH_HAL_GSWIP32)
 	free_gpid(inst, pi->gpid_base, pi->gpid_num, pi->gpid_spl);
@@ -1504,8 +1538,9 @@ static int pon_config(int inst, int ep, struct dp_port_data *data, u32 flags)
 			q_map.nPortId = ep;
 			q_map.nTrafficClassId = j;
 			if (gsw_qos->QoS_QueuePortGet(gsw_ops, &q_map)) {
-				pr_err("Fail in QoS_QueuePortGet\n");
-				return -1;
+				pr_err("%s: Fail in QoS_QueuePortGet\n",
+				       __func__);
+				return DP_FAILURE;
 			}
 
 			/* Currently QID is hardcoded, later when
@@ -1519,8 +1554,9 @@ static int pon_config(int inst, int ep, struct dp_port_data *data, u32 flags)
 			q_map.bEnableIngressPceBypass = 0;
 			q_map.nRedirectPortId = cfg->pmac;
 			if (gsw_qos->QoS_QueuePortSet(gsw_ops, &q_map)) {
-				pr_err("Fail in QoS_QueuePortSet\n");
-				return -1;
+				pr_err("%s: Fail in QoS_QueuePortSet\n",
+				       __func__);
+				return DP_FAILURE;
 			}
 		}
 	}
@@ -1587,15 +1623,15 @@ static int vuni_cfg(int inst, int ep, struct dp_port_data *data, u32 flags)
 		q_map.nPortId = ep;
 		q_map.nTrafficClassId = j;
 		if (gsw_qos->QoS_QueuePortGet(gsw_ops, &q_map)) {
-			pr_err("Fail in QoS_QueuePortGet\n");
-			return -1;
+			pr_err("%s: Fail in QoS_QueuePortGet\n", __func__);
+			return DP_FAILURE;
 		}
 
 		q_map.bEnableIngressPceBypass = ig_bypass;
 		q_map.nRedirectPortId = PMAC_2;
 		if (gsw_qos->QoS_QueuePortSet(gsw_ops, &q_map)) {
-			pr_err("Fail in QoS_QueuePortSet\n");
-			return -1;
+			pr_err("%s: Fail in QoS_QueuePortSet\n", __func__);
+			return DP_FAILURE;
 		}
 	}
 
@@ -2224,8 +2260,9 @@ static int subif_hw_set(int inst, int portid, int subif_ix,
 
 	if (data->subif_data->flag_ops & DP_SUBIF_DEQPORT_NUM &&
 	    data->subif_data->num_deq_port > DP_MAX_DEQ_PER_SUBIF) {
-		pr_err("deq_port(%d), cannot be more than max Q per subif %d\n",
-		       data->subif_data->num_deq_port, DP_MAX_DEQ_PER_SUBIF);
+		pr_err("%s: %s(%d), cannot be more than max Q per subif %d\n",
+		       __func__, "deq_port", data->subif_data->num_deq_port,
+		       DP_MAX_DEQ_PER_SUBIF);
 		return DP_FAILURE;
 	}
 
@@ -2382,9 +2419,12 @@ static int subif_hw_set(int inst, int portid, int subif_ix,
 			return DP_FAILURE;
 	}
 #if IS_ENABLED(CONFIG_INTEL_DATAPATH_HAL_GSWIP32)
-	if (dp_subif_pp_set(inst, portid, subif_ix, data->subif_data->flag_ops))
-		pr_err("dp_subif_pp_set fail for dpid/vap=%d/%d\n",
-		       portid, subif_ix);
+	if (dp_subif_pp_set(inst, portid, subif_ix,
+			    data->subif_data->flag_ops)) {
+		pr_err("%s: dp_subif_pp_set fail for dpid/vap=%d/%d\n",
+		       __func__, portid, subif_ix);
+		return DP_FAILURE;
+	}
 #endif
 	return DP_SUCCESS;
 }
@@ -2473,7 +2513,7 @@ static int subif_hw_reset(int inst, int portid, int subif_ix,
 #if IS_ENABLED(CONFIG_INTEL_DATAPATH_HAL_GSWIP32)
 		if (dp_subif_pp_reset(inst, portid, subif_ix,
 				      sif->data_flag_ops)) {
-			pr_err("dp_subif_pp_reset failed\n");
+			pr_err("%s: dp_subif_pp_reset failed\n", __func__);
 			return DP_FAILURE;
 		}
 #endif
@@ -2562,7 +2602,7 @@ static int dp_ctp_tc_map_set(struct dp_tc_cfg *tc, int flag,
 }
 
 int dp_get_reinsert_cnt(int inst, int dp_port, int vap, int flag,
-			   struct dp_reinsert_count *dp_reins_count)
+			struct dp_reinsert_count *dp_reins_count)
 {
 	struct pmac_port_info *port_info = get_dp_port_info(inst, dp_port);
 	struct dp_subif_info *sif = get_dp_port_subif(port_info, vap);
