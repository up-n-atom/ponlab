 			DP_CB(inst, dev_platform_set)(inst, port_id, data,
 						      flags);
@@ -1088,6 +1163,10 @@ int32_t dp_register_dev_ext(int inst, struct module *owner, uint32_t port_id,
 	port_info->status = PORT_DEV_REGISTERED;
 	if (dp_cb)
 		port_info->cb = *dp_cb;
