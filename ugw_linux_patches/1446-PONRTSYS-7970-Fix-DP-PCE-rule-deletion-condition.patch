From 3c0203048c8dea24695c32537ae1eaf9805bf70f Mon Sep 17 00:00:00 2001
From: "Rywacki, Kamil" <kamil.rywacki@intel.com>
Date: Tue, 13 Oct 2020 12:00:36 +0200
Subject: [PATCH] PONRTSYS-7970: Fix DP PCE rule deletion condition

---
 drivers/net/datapath/dpm/datapath_pce.c | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/drivers/net/datapath/dpm/datapath_pce.c b/drivers/net/datapath/dpm/datapath_pce.c
index 504d87e5980a..6bed007f8620 100644
--- a/drivers/net/datapath/dpm/datapath_pce.c
+++ b/drivers/net/datapath/dpm/datapath_pce.c
@@ -528,11 +528,13 @@ static int pce_rule_del(GSW_PCE_ruleDelete_t *pce,
 			struct dp_subblk_entry *subblk_entry)
 {
 	struct core_ops *ops = gsw_get_swcore_ops(0);
+	int subblk_curr;
 
 	if (!ops)
 		return -1;
 
-	if (pce->nIndex > subblk_entry->subblk_rules_max) {
+	subblk_curr = pce->nIndex - subblk_entry->subblk_firstindex;
+	if (subblk_curr < 0 || subblk_curr > subblk_entry->subblk_rules_max) {
 		pr_err("%s: PCE Index for Block %d should be within 0 to %d\n",
 		       __func__, subblk_entry->subblk_id,
 		       subblk_entry->subblk_rules_max);
