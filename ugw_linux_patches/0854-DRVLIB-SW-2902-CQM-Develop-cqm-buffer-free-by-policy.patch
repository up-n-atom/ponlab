From 5220719c00fbd9f55f25f5c6561596d7018b95d8 Mon Sep 17 00:00:00 2001
From: arathinx <ayyappanx.rathinam@intel.com>
Date: Mon, 23 Sep 2019 14:57:07 +0800
Subject: [PATCH] DRVLIB_SW-2902: CQM: Develop cqm_buffer_free_by_policy API

---
 drivers/net/ethernet/lantiq/cqm/cbm_wrapper.c |  5 +++-
 drivers/net/ethernet/lantiq/cqm/cqm_common.h  |  1 +
 drivers/net/ethernet/lantiq/cqm/prx300/cqm.c  | 37 +++++++++++++++++++++++++++
 3 files changed, 42 insertions(+), 1 deletion(-)

diff --git a/drivers/net/ethernet/lantiq/cqm/cbm_wrapper.c b/drivers/net/ethernet/lantiq/cqm/cbm_wrapper.c
index ea26f57b0e92..1fd2e0db34ce 100644
--- a/drivers/net/ethernet/lantiq/cqm/cbm_wrapper.c
+++ b/drivers/net/ethernet/lantiq/cqm/cbm_wrapper.c
@@ -152,7 +152,10 @@ EXPORT_SYMBOL(cqm_buffer_alloc_by_policy);
 
 int cqm_buffer_free_by_policy(struct cqm_bm_free *free_info)
 {
-	return CBM_FAILURE;
+	if (g_cbm_ops->cqm_buffer_free_by_policy)
+		return g_cbm_ops->cqm_buffer_free_by_policy(free_info);
+	else
+		return CBM_FAILURE;
 }
 EXPORT_SYMBOL(cqm_buffer_free_by_policy);
 
diff --git a/drivers/net/ethernet/lantiq/cqm/cqm_common.h b/drivers/net/ethernet/lantiq/cqm/cqm_common.h
index 498251abe869..75dafc882318 100644
--- a/drivers/net/ethernet/lantiq/cqm/cqm_common.h
+++ b/drivers/net/ethernet/lantiq/cqm/cqm_common.h
@@ -124,6 +124,7 @@ struct cbm_ops {
 				  void *data_pointer,  int flags);
 	void *(*cbm_buffer_alloc)(u32 pid, u32 flag, u32 size);
 	void *(*cqm_buffer_alloc_by_policy)(u32 pid, u32 flag, u32 policy);
+	int (*cqm_buffer_free_by_policy)(struct cqm_bm_free *free_info);
 	struct sk_buff *(*cbm_copy_skb)(const struct sk_buff *skb,
 					gfp_t gfp_mask);
 	struct sk_buff *(*cbm_alloc_skb)(unsigned int size, gfp_t priority);
diff --git a/drivers/net/ethernet/lantiq/cqm/prx300/cqm.c b/drivers/net/ethernet/lantiq/cqm/prx300/cqm.c
index 46f51c28115a..8477f6bac080 100644
--- a/drivers/net/ethernet/lantiq/cqm/prx300/cqm.c
+++ b/drivers/net/ethernet/lantiq/cqm/prx300/cqm.c
@@ -1528,6 +1528,42 @@ static void *cqm_buff_alloc_by_policy_prx300(u32 pid, u32 flag, u32 policy)
 	return (void *)buff_base + CQM_POOL_METADATA;
 }
 
+static int cqm_buffer_free_by_policy_prx300(struct cqm_bm_free *free_info)
+{
+	u32 buf, size, pool, policy, pid = smp_processor_id();
+	unsigned long sys_flag;
+	int ret, idx;
+
+	ret = get_buffer_base_index((u32)__va(free_info->buf),
+				    &buf, &size, &idx);
+	if (!ret) {
+		pool = bm_pool_conf[idx].pool;
+		policy = free_info->policy_base + pool;
+
+		if ((pool != CQM_FSQM_POOL) &&
+		    (policy != CQM_FSQM_POLICY)) {
+			get_metadata((u8 *)buf, &pool, &policy);
+			memset((u8 *)buf, 0, CQM_PRX300_POOL_POL_HDR_SIZE);
+			buf = dma_map_single(cqm_ctrl->dev, (void *)buf,
+					     size, DMA_FROM_DEVICE);
+			if (dma_mapping_error(cqm_ctrl->dev, buf)) {
+				dev_err(cqm_ctrl->dev, "%s DMA map failed\n",
+					__func__);
+				return CBM_FAILURE;
+			}
+		}
+
+		local_irq_save(sys_flag);
+		cbm_w32(cqm_ctrl->deq + DQ_CPU_PORT(pid, ptr_rtn_dw2), buf);
+		cbm_w32(cqm_ctrl->deq + DQ_CPU_PORT(pid, ptr_rtn_dw3),
+			(pool << PTR_RTN_CPU_DW3_EGP_0_POOL_POS)
+			| (policy << PTR_RTN_CPU_DW3_EGP_0_POLICY_POS));
+		local_irq_restore(sys_flag);
+	}
+
+	return ret;
+}
+
 static void *cqm_buffer_alloc(u32 pid, u32 flag, u32 size, u32 *buf_size)
 {
 	u32 buf_addr = 0;
@@ -3967,6 +4003,7 @@ static const struct cbm_ops cqm_ops = {
 	.cbm_igp_delay_get = cqm_igp_delay_get,
 	.cbm_buffer_alloc = cqm_buffer_alloc_by_size,
 	.cqm_buffer_alloc_by_policy = cqm_buff_alloc_by_policy_prx300,
+	.cqm_buffer_free_by_policy = cqm_buffer_free_by_policy_prx300,
 	.cbm_buffer_free = cqm_buffer_free,
 	.cbm_cpu_pkt_tx = cqm_cpu_pkt_tx,
 	.check_ptr_validation = check_ptr_validation_prx300,
