From 8eeeeb30b1c61924e181d48008104b68d416c277 Mon Sep 17 00:00:00 2001
From: Oren Bakshe <oren.bakshe@intel.com>
Date: Thu, 13 Aug 2020 12:03:20 +0300
Subject: [PATCH] PONRTSYS-7979: disable the dynamic clock gating for tx
 manager

---
 drivers/net/ppv4/pp-hal/infra/infra.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/drivers/net/ppv4/pp-hal/infra/infra.c b/drivers/net/ppv4/pp-hal/infra/infra.c
index 24f2ff2957b4..5a69e07423a5 100644
--- a/drivers/net/ppv4/pp-hal/infra/infra.c
+++ b/drivers/net/ppv4/pp-hal/infra/infra.c
@@ -446,6 +446,7 @@ void infra_dynamic_clk_init(void)
 		case DCLK_MOD_QOS_WRED:
 		case DCLK_MOD_QOS_TSCD:
 		case DCLK_MOD_QOS_UC:
+		case DCLK_MOD_QOS_TX_MGR:
 			continue;
 		default:
 			break;
