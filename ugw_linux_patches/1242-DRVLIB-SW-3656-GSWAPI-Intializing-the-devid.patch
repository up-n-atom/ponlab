From f02617f48250415b0fb8a4a852e018583b69d93c Mon Sep 17 00:00:00 2001
From: Dinesh Sudham <dineshx.sudham@intel.com>
Date: Thu, 18 Jun 2020 16:29:47 +0800
Subject: [PATCH] DRVLIB_SW-3656:GSWAPI: Intializing the devid

Need to intialize the devid for dereferencing the array
index for each switch_core prvdata.

Signed-off-by: Dinesh Sudham <dineshx.sudham@intel.com>
---
 drivers/net/ethernet/lantiq/switch-api/gsw_init.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/drivers/net/ethernet/lantiq/switch-api/gsw_init.c b/drivers/net/ethernet/lantiq/switch-api/gsw_init.c
index fcc2882cc72e..3a9cc1f7d65f 100644
--- a/drivers/net/ethernet/lantiq/switch-api/gsw_init.c
+++ b/drivers/net/ethernet/lantiq/switch-api/gsw_init.c
@@ -1034,6 +1034,7 @@ int ltq_gsw_api_register(struct platform_device *pdev)
 
 	if (device_id == LTQ_FLOW_DEV_INT_R && prvdata->ext_switch) {
 		core_init.gsw_base_addr = NULL;
+		core_init.sdev = LTQ_FLOW_DEV_INT_R;
 		core_init.pdev = (void *)pdev;
 		pEDev1 = ethsw_api_core_init(&core_init);
 
