From c52f63592dac51f9a6270534a0d286f5e35e44b3 Mon Sep 17 00:00:00 2001
From: Rekha Eswaran <rekha.eswaran@intel.com>
Date: Mon, 8 Mar 2021 20:05:28 +0800
Subject: [PATCH] DRV_DPM_SW-473 - Resolve rx_info suppress message

---
 drivers/net/datapath/dpm/gswip31/datapath_rx.c | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/drivers/net/datapath/dpm/gswip31/datapath_rx.c b/drivers/net/datapath/dpm/gswip31/datapath_rx.c
index 5afc4b5b5647..1f569ae669bf 100644
--- a/drivers/net/datapath/dpm/gswip31/datapath_rx.c
+++ b/drivers/net/datapath/dpm/gswip31/datapath_rx.c
@@ -19,6 +19,9 @@
 
 static void rx_info(int dpid, int gpid, int vap, char *str)
 {
+	if (!(dp_dbg_flag & DP_DBG_FLAG_DUMP_RX))
+		return;
+
 	if (!printk_ratelimit())
 		return;
 
@@ -62,6 +65,9 @@ static void rx_dbg(struct sk_buff *skb, struct dma_rx_desc_0 *desc0,
 	offset = desc2->field.byte_offset;
 #endif
 
+	if (!(dp_dbg_flag & DP_DBG_FLAG_DUMP_RX))
+		return;
+
 	if (!printk_ratelimit())
 		return;
 
