From f8abaf0dce133387d5c42e775dbad3138f39aa52 Mon Sep 17 00:00:00 2001
From: Dinesh Sudham <dineshx.sudham@intel.com>
Date: Fri, 15 Nov 2019 17:41:50 +0800
Subject: [PATCH] PONRTSYS-6015: GSWAPI: support for deleting per ctp tflow pce
 rules

---
 .../net/ethernet/lantiq/switch-api/gsw_flow_core.c | 122 ++++++++++++++++-----
 .../net/ethernet/lantiq/switch-api/gsw_flow_core.h |  13 +++
 include/net/switch_api/lantiq_gsw_flow.h           |   8 ++
 3 files changed, 115 insertions(+), 28 deletions(-)

diff --git a/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c b/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c
index 2b4007babda4..faf2040d3f4c 100644
--- a/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c
+++ b/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c
@@ -18163,6 +18163,63 @@ GSW_return_t GSW_IrqStatusClear(void *cdev, GSW_irq_t *parm)
 	return GSW_statusOk;
 }
 
+static u32 gsw_get_global_baseindex(void *cdev, int index)
+{
+	u32 base;
+	ethsw_api_dev_t *gswdev = GSW_PDATA_GET(cdev);
+
+	if (!gswdev) {
+		pr_err("%s:%s:%d", __FILE__, __func__, __LINE__);
+		return GSW_statusErr;
+	}
+
+	gsw_r32(cdev, PCE_TFCR_ID_INDEX_OFFSET, PCE_TFCR_ID_INDEX_SHIFT,
+		PCE_TFCR_ID_INDEX_SIZE, &base);
+
+	if (index >= gswdev->num_of_global_rules) {
+		pr_err("\n\tERROR: Index %u is greater than common region (%u entries) start at %u\n",
+		       index,
+		       gswdev->num_of_global_rules, base);
+		return GSW_statusErr;
+	}
+
+	return base;
+}
+
+static u32 gsw_get_ctp_baseindex(void *cdev, GSW_PCE_RuleManage_t *parm)
+{
+	GSW_CTP_portAssignment_t ctpget;
+	u32 ctp_port, base, num;
+	int ret;
+	ethsw_api_dev_t *gswdev = GSW_PDATA_GET(cdev);
+
+	if (!gswdev) {
+		pr_err("%s:%s:%d", __FILE__, __func__, __LINE__);
+		return GSW_statusErr;
+	}
+
+	ctpget.nLogicalPortId = parm->logicalportid;
+	ret = GSW_CTP_PortAssignmentGet(cdev, &ctpget);
+
+	if (ret != GSW_statusOk)
+		return ret;
+
+	ctp_port = ctpget.nFirstCtpPortId + parm->subifidgroup;
+
+	if (!gswdev->ctpportconfig_idx[ctp_port].IngressTflowAssigned)
+		return GSW_statusErr;
+
+	base = gswdev->ctpportconfig_idx[ctp_port].IngressTflowFirstIdx;
+	num = gswdev->ctpportconfig_idx[ctp_port].IngressTflowNumberOfEntrys;
+
+	if (parm->nIndex >= num) {
+		pr_err("\n\tERROR: Index %u is not in CTP region (%u entries) start at %u\n",
+		       parm->nIndex, num, base);
+		return GSW_statusErr;
+	}
+
+	return base;
+}
 /**
  * GSW_PceRuleManage - To Manage the TFLOW Table Rule
  * @cdev: device pointer
@@ -18174,43 +18231,26 @@ static GSW_return_t gsw_pcerulemanage(void *cdev, GSW_PCE_rule_t *parm)
 	int ret;
 	ethsw_api_dev_t *gswdev = GSW_PDATA_GET(cdev);
 	u32 idx, base, num;
-	u32 ctp_port;
-	GSW_CTP_portAssignment_t ctpget;
+	GSW_PCE_RuleManage_t pcerule;
 
 	if (!gswdev) {
 		pr_err("%s:%s:%d", __FILE__, __func__, __LINE__);
 		return GSW_statusErr;
 	}
 
+	memset(&pcerule, 0, sizeof(pcerule));
+
 	switch (parm->region) {
 	case GSW_PCE_RULE_COMMMON:
-		gsw_r32(cdev, PCE_TFCR_ID_INDEX_OFFSET, PCE_TFCR_ID_INDEX_SHIFT,
-			PCE_TFCR_ID_INDEX_SIZE, &base);
-		if (parm->pattern.nIndex >= gswdev->num_of_global_rules) {
-			pr_err("\n\tERROR: Index %u is greater than common region (%u entries) start at %u\n",
-			       parm->pattern.nIndex,
-			       gswdev->num_of_global_rules, base);
-			return GSW_statusErr;
-		}
+		base = gsw_get_global_baseindex(cdev, parm->pattern.nIndex);
 		idx = base + parm->pattern.nIndex;
 		break;
 
 	case GSW_PCE_RULE_CTP:
-		ctpget.nLogicalPortId = parm->logicalportid;
-		ret = GSW_CTP_PortAssignmentGet(cdev, &ctpget);
-		if (ret != GSW_statusOk)
-			return ret;
-		ctp_port = ctpget.nFirstCtpPortId + parm->subifidgroup;
-		if (!gswdev->ctpportconfig_idx[ctp_port].IngressTflowAssigned)
-			return GSW_statusErr;
-		base = gswdev->ctpportconfig_idx[ctp_port].IngressTflowFirstIdx;
-		num = gswdev->ctpportconfig_idx[ctp_port].IngressTflowNumberOfEntrys;
-
-		if (parm->pattern.nIndex >= num) {
-			pr_err("\n\tERROR: Index %u is not in CTP region (%u entries) start at %u\n",
-			       parm->pattern.nIndex, num, base);
-			return GSW_statusErr;
-		}
+		pcerule.logicalportid = parm->logicalportid;
+		pcerule.subifidgroup = parm->subifidgroup;
+		pcerule.nIndex = parm->pattern.nIndex;
+		base = gsw_get_ctp_baseindex(cdev, &pcerule);
 		idx = base + parm->pattern.nIndex;
 		break;
 
@@ -18240,6 +18280,7 @@ GSW_return_t GSW_PceRuleRead(void *cdev, GSW_PCE_rule_t *parm)
 
 	if (GSW_statusOk != gsw_pcerulemanage(cdev, parm))
 		return GSW_statusErr;
+
 #ifdef __KERNEL__
 	spin_lock_bh(&gswdev->lock_pce);
 #endif
@@ -18294,19 +18335,44 @@ GSW_return_t GSW_PceRuleDelete(void *cdev, GSW_PCE_ruleDelete_t *parm)
 {
 	ethsw_api_dev_t *gswdev = GSW_PDATA_GET(cdev);
 	u32 index; //Traffic-Flow table index.
-	u32 ret;
+	u32 ret, base;
+	GSW_PCE_RuleManage_t pcerule;
 
 	if (gswdev == NULL) {
 		pr_err("%s:%s:%d", __FILE__, __func__, __LINE__);
 		return GSW_statusErr;
 	}
 
+	memset(&pcerule, 0, sizeof(pcerule));
+
+	switch (parm->region) {
+	case GSW_PCE_RULE_COMMMON:
+		base = gsw_get_global_baseindex(cdev, parm->nIndex);
+		index = base + parm->nIndex;
+		break;
+
+	case GSW_PCE_RULE_CTP:
+		pcerule.logicalportid = parm->logicalportid;
+		pcerule.subifidgroup = parm->subifidgroup;
+		pcerule.nIndex = parm->nIndex;
+		base = gsw_get_ctp_baseindex(cdev, &pcerule);
+		index = base + parm->nIndex;
+		break;
+
+	case GSW_PCE_RULE_DEBUG:
+		index = parm->nIndex;
+		PCE_ASSERT(index >= (gswdev->tftblsize));
+		break;
+
+	default:
+		pr_err("\n\tERROR: TFLOW Table doesn't support This Region\n");
+		return GSW_statusErr;
+	}
+
 #ifdef __KERNEL__
 	spin_lock_bh(&gswdev->lock_pce);
 #endif
 
-	index = parm->nIndex;
-
 	if (0 != pce_pattern_delete(cdev, &gswdev->phandler, index)) {
 		ret = GSW_statusErr;
 		goto UNLOCK_AND_RETURN;
diff --git a/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.h b/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.h
index 7ca149375292..da40b7aa55a8 100644
--- a/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.h
+++ b/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.h
@@ -908,6 +908,19 @@ typedef struct {
 	u16 usedentry;
 } gsw_tflow_t;
 
+/** \brief Parameter to manage a rule from the packet classification engine.
+ */
+typedef struct {
+	/** Logical Port Id. The valid range is hardware dependent. */
+	u32 logicalportid;
+	/** Sub interface ID group,
+	 *The valid range is hardware/protocol dependent.
+	 */
+	u32 subifidgroup;
+	/** Rule Index in the PCE Table. */
+	u32	nIndex;
+} GSW_PCE_RuleManage_t;
+
 typedef struct {
 	gsw_devtype_t	sdev;
 	port_config_t pconfig[MAX_PORT_NUMBER];
diff --git a/include/net/switch_api/lantiq_gsw_flow.h b/include/net/switch_api/lantiq_gsw_flow.h
index c3b41fc46543..7d037f274c40 100644
--- a/include/net/switch_api/lantiq_gsw_flow.h
+++ b/include/net/switch_api/lantiq_gsw_flow.h
@@ -1108,6 +1108,14 @@ typedef struct {
 /** \brief Parameter to delete a rule from the packet classification engine.
     Used by \ref GSW_PCE_RULE_DELETE. */
 typedef struct {
+	/** Logical Port Id. The valid range is hardware dependent. */
+	u32 logicalportid;
+	/** Sub interface ID group,
+	 *The valid range is hardware/protocol dependent.
+	 */
+	u32 subifidgroup;
+	/** PCE TABLE Region */
+	GSW_PCE_RuleRegion_t	region;
 	/** Rule Index in the PCE Table. */
 	u32	nIndex;
 } GSW_PCE_ruleDelete_t;
