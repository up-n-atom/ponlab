From 9568b4629f14b1a31e9e139d888cfacc526bfce9 Mon Sep 17 00:00:00 2001
From: Emergi Idan <idan.emergi@intel.com>
Date: Mon, 2 Nov 2020 13:16:28 +0200
Subject: [PATCH] LMTSYS-4215: Fix session manager usage of the classifier hash
 calculation on LGM B-step PPv4

---
 drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c | 2 +-
 drivers/net/ppv4/pp-hal/classifier/classifier.c         | 6 ++++--
 2 files changed, 5 insertions(+), 3 deletions(-)

diff --git a/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c b/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c
index 929f948826b7..1ca346416945 100644
--- a/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c
+++ b/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c
@@ -2097,7 +2097,7 @@ static s32 __smgr_sess_lookup(struct sess_info *s)
 	 */
 	__buf_swap(&lu_fv, sizeof(lu_fv), &s->si.fv, s->si.fv_sz);
 
-	ret = hash_calc(s, &lu_fv, s->si.fv_sz, &args->hash);
+	ret = hash_calc(s, &s->si.fv, s->si.fv_sz, &args->hash);
 	if (unlikely(ret))
 		goto done;
 
diff --git a/drivers/net/ppv4/pp-hal/classifier/classifier.c b/drivers/net/ppv4/pp-hal/classifier/classifier.c
index fd1b3c9445e1..daec1b288f8c 100644
--- a/drivers/net/ppv4/pp-hal/classifier/classifier.c
+++ b/drivers/net/ppv4/pp-hal/classifier/classifier.c
@@ -1422,7 +1422,7 @@ s32 cls_hash_calc(void *fv, u32 fv_sz, struct pp_hash *hash)
 {
 	u8 idx;
 	u32 fv_full[CLS_DBG_FV_NUM_REGS] = {0};
-	u32 reg = 0;
+	u32 off, sz, reg = 0;
 
 	if (pp_silicon_step_get() == PP_SSTEP_A) {
 		pr_err("hash calc is not supported in A step\n");
@@ -1437,7 +1437,9 @@ s32 cls_hash_calc(void *fv, u32 fv_sz, struct pp_hash *hash)
 		return -EINVAL;
 	}
 
-	memcpy(fv_full, fv, fv_sz);
+	off = CLS_DBG_FV_NUM_REGS - (fv_sz / 4);
+	sz = sizeof(fv_full) - (off * 4);
+	__buf_swap(&fv_full[off], sizeof(fv_full), fv, fv_sz);
 
 	/* Write FV */
 	for (idx = 0; idx < CLS_DBG_FV_NUM_REGS; idx++)
