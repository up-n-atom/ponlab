From 34c29d56e9e6d44691898754ff2c618c25e33185 Mon Sep 17 00:00:00 2001
From: arathinx <ayyappanx.rathinam@intel.com>
Date: Mon, 4 Mar 2019 11:53:31 +0800
Subject: [PATCH] DRVLIB_SW-1553: Remove gpio-xrx500.c file and Update
 Kconfig/Makefile

---
 drivers/gpio/Kconfig       |   9 --
 drivers/gpio/Makefile      |   1 -
 drivers/gpio/gpio-xrx500.c | 353 ---------------------------------------------
 3 files changed, 363 deletions(-)

diff --git a/drivers/gpio/Kconfig b/drivers/gpio/Kconfig
index 6a56bbffffdb..a89af9aeed08 100755
--- a/drivers/gpio/Kconfig
+++ b/drivers/gpio/Kconfig
@@ -298,15 +298,6 @@ config GPIO_MOXART
 	  Select this option to enable GPIO driver for
 	  MOXA ART SoC devices.
 
-config GPIO_XRX500
-	bool "Lantiq GPIO driver for GRX500"
-	depends on MIPS && SOC_GRX500
-	select GPIO_GENERIC
-	select GPIOLIB_IRQCHIP
-        help
-	  This driver supports the GPIO for GRX500
-
-
 config GPIO_MPC5200
 	def_bool y
 	depends on PPC_MPC52xx
diff --git a/drivers/gpio/Makefile b/drivers/gpio/Makefile
index 3def9b60140b..a67498f36369 100755
--- a/drivers/gpio/Makefile
+++ b/drivers/gpio/Makefile
@@ -45,7 +45,6 @@ obj-$(CONFIG_GPIO_EM)		+= gpio-em.o
 obj-$(CONFIG_GPIO_EP93XX)	+= gpio-ep93xx.o
 obj-$(CONFIG_GPIO_ETRAXFS)	+= gpio-etraxfs.o
 obj-$(CONFIG_GPIO_F7188X)	+= gpio-f7188x.o
-obj-$(CONFIG_GPIO_XRX500)	+= gpio-xrx500.o
 obj-$(CONFIG_GPIO_GE_FPGA)	+= gpio-ge.o
 obj-$(CONFIG_GPIO_GPIO_MM)	+= gpio-gpio-mm.o
 obj-$(CONFIG_GPIO_GRGPIO)	+= gpio-grgpio.o
diff --git a/drivers/gpio/gpio-xrx500.c b/drivers/gpio/gpio-xrx500.c
deleted file mode 100755
index 0ee5be3c0f9f..000000000000
--- a/drivers/gpio/gpio-xrx500.c
+++ /dev/null
@@ -1,353 +0,0 @@
-/*
- *  This program is free software; you can redistribute it and/or modify it
- *  under the terms of the GNU General Public License version 2 as published
- *  by the Free Software Foundation.
- *
