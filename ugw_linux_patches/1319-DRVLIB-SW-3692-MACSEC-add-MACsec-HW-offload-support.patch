From: Xu Liang <liang.xu@intel.com>
Date: Fri, 17 Jul 2020 18:57:29 +0800
Subject: [PATCH] DRVLIB_SW-3692: MACSEC - add MACsec HW offload support

---
 drivers/net/Kconfig       |   6 +
 drivers/net/macsec.c      | 610 +++++++++++++++++++++++++---------------------
 include/linux/netdevice.h |   5 +
 include/linux/phy.h       |   6 +
 include/net/macsec.h      | 336 +++++++++++++++++++++++++
 5 files changed, 686 insertions(+), 277 deletions(-)

diff --git a/drivers/net/Kconfig b/drivers/net/Kconfig
index 3c0d30accb7e..33b16971cdf6 100644
--- a/drivers/net/Kconfig
+++ b/drivers/net/Kconfig
@@ -219,6 +219,12 @@ config MACSEC
 	---help---
 	   MACsec is an encryption standard for Ethernet.
 
+config MACSEC_HW_OFFLOAD
+        bool "MACSec HW Offload Support"
+	depends on MACSEC
+        ---help---
+           MACSec HW Offload Support.
+
 config NETCONSOLE
 	tristate "Network console logging support"
 	---help---
diff --git a/drivers/net/macsec.c b/drivers/net/macsec.c
index 774b9db0c811..e77cee262ab7 100644
--- a/drivers/net/macsec.c
+++ b/drivers/net/macsec.c
@@ -7,6 +7,9 @@
