From 7ac18082ed790ca7daddf197f685b2511b18c0ef Mon Sep 17 00:00:00 2001
From: Xu Liang <liang.xu@intel.com>
Date: Thu, 4 Jun 2020 21:04:13 +0800
Subject: [PATCH] PONRTSYS-7568: GSW API - verify Ingress Bridge Port config
 read

---
 .../net/ethernet/lantiq/switch-api/gsw_flow_core.c | 57 ++++++++++++++++++++++
 .../net/ethernet/lantiq/switch-api/gsw_tbl_rw.c    | 49 ++++++++++++++++---
 2 files changed, 98 insertions(+), 8 deletions(-)

diff --git a/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c b/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c
index 75fab6fba0db..c916241dbff2 100644
--- a/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c
+++ b/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c
@@ -2070,6 +2070,19 @@ static int gsw2x_msw_table_rm(void *cdev, GSW_multicastTable_t *parm)
 #endif /*CONFIG_LTQ_MULTICAST */
 #if	((defined(CONFIG_LTQ_STP) && CONFIG_LTQ_STP) ||  (defined(CONFIG_LTQ_8021X) && CONFIG_LTQ_8021X))
 
+static inline int gswip31_stp_chk(ethsw_api_dev_t *gswdev, pctbl_prog_t *ig,
+				  pctbl_prog_t *eg)
+{
+	u16 vig, veg;
+
+	if (!IS_VRSN_31(gswdev->gipver))
+		return 0;
+
+	vig = ig->val[0] & 7;
+	veg = eg->val[0] & 7;
+	return vig == veg ? 0 : 1;
+}
+
 /* Function: Internal function to program the registers */
 /* when 802.1x and STP API are called. */
 /* Description: Referene the matrix table to program the  */
@@ -2082,6 +2095,7 @@ static void set_port_state(void *cdev, u32 pid, u32 stpstate, u32 st8021)
 	u16 State;
 	ethsw_api_dev_t *gswdev = GSW_PDATA_GET(cdev);
 	u32 i;
+	int retry;
 
 	if (gswdev == NULL) {
 		pr_err("%s:%s:%d", __FILE__, __func__, __LINE__);
@@ -2137,6 +2151,17 @@ static void set_port_state(void *cdev, u32 pid, u32 stpstate, u32 st8021)
 				/*Address-based read for egress bridge port configuration*/
 				gsw_pce_table_read(cdev, &tbl_prog_brdgeport_egress);
 
+				for (retry = 0; retry < 5; retry++) {
+					if (gswip31_stp_chk(gswdev,
+							    &tbl_prog_brdgeport_ingress,
+							    &tbl_prog_brdgeport_egress))
+						gsw_pce_table_read(cdev, &tbl_prog_brdgeport_ingress);
+					else
+						break;
+				}
+				if (retry == 5)
+					pr_err("Failed in reading Ingress Bridge Port.\n");
+
 				/* Learning Limit */
 				if (pststate->lrnlim == 0) {
 					/*Disable learning and set learning limit to zero*/
@@ -22370,6 +22395,7 @@ GSW_return_t GSW_BridgePortConfigSet(void *cdev, GSW_BRIDGE_portConfig_t *param)
 	u32 idx = 0, FirstIdx, LastIdx, pmapper_idx, meterid;
 	u16 i, val_reg_idx, ret, IngressStpState, EgressStpState;
 	u32 BlkSize = 0;
+	int retry;
 
 	if (gswdev == NULL) {
 		pr_err("%s:%s:%d", __FILE__, __func__, __LINE__);
@@ -22423,6 +22449,14 @@ GSW_return_t GSW_BridgePortConfigSet(void *cdev, GSW_BRIDGE_portConfig_t *param)
 	*/
 	gsw_pce_table_read(cdev, &tbl_prog_brdgeport_egress);
 
+	for (retry = 0; retry < 5; retry++) {
+		if (gswip31_stp_chk(gswdev, &tbl_prog_brdgeport_ingress,
+				    &tbl_prog_brdgeport_egress))
+			gsw_pce_table_read(cdev, &tbl_prog_brdgeport_ingress);
+		else
+			break;
+	}
+
 	/**Default Bridge Port Configuration Settings**/
 	/*By Default STP State are GSW_STP_PORT_STATE_FORWARD.
 	  it can be changed using GSW_STP_PortCfgSet
@@ -22436,6 +22470,7 @@ GSW_return_t GSW_BridgePortConfigSet(void *cdev, GSW_BRIDGE_portConfig_t *param)
 	/*Both ingress/egress states must be same
 	 if not equal return error*/
 	if (IngressStpState != EgressStpState) {
+		pr_err("Failed in reading Ingress Bridge Port.\n");
 		ret = GSW_statusErr;
 		goto UNLOCK_AND_RETURN;
 	}
@@ -23829,6 +23864,7 @@ GSW_return_t GSW_BridgePortFree(void *cdev, GSW_BRIDGE_portAlloc_t *param)
 	ethsw_api_dev_t *gswdev = GSW_PDATA_GET(cdev);
 	u32 FirstIdx, count;
 	u32 ret;
+	int retry;
 
 	if (gswdev == NULL) {
 		pr_err("%s:%s:%d", __FILE__, __func__, __LINE__);
@@ -23884,6 +23920,16 @@ GSW_return_t GSW_BridgePortFree(void *cdev, GSW_BRIDGE_portAlloc_t *param)
 	/*Address-based read for egress bridge port configuration*/
 	gsw_pce_table_read(cdev, &tbl_prog_brdgeport_egress);
 
+	for (retry = 0; retry < 5; retry++) {
+		if (gswip31_stp_chk(gswdev, &tbl_prog_brdgeport_ingress,
+				    &tbl_prog_brdgeport_egress))
+			gsw_pce_table_read(cdev, &tbl_prog_brdgeport_ingress);
+		else
+			break;
+	}
+	if (retry == 5)
+		pr_err("Failed in reading Ingress Bridge Port.\n");
+
 	temp.nBridgeId = ((tbl_prog_brdgeport_ingress.val[4] & 0x3F00) >> 8);
 
 	if (gswdev->brdgeportconfig_idx[param->nBridgePortId].BrdgIdAssigned) {
@@ -24186,6 +24232,7 @@ GSW_return_t GSW_BridgePortConfigGet(void *cdev, GSW_BRIDGE_portConfig_t *param)
 	ethsw_api_dev_t *gswdev = GSW_PDATA_GET(cdev);
 	u32 value, FirstIdx, LastIdx, BlkSize;
 	u16 i, val_reg_idx, ret;
+	int retry;
 
 	if (gswdev == NULL) {
 		pr_err("%s:%s:%d", __FILE__, __func__, __LINE__);
@@ -24232,6 +24279,16 @@ GSW_return_t GSW_BridgePortConfigGet(void *cdev, GSW_BRIDGE_portConfig_t *param)
 	/*Address-based read for egress bridge port configuration*/
 	gsw_pce_table_read(cdev, &tbl_prog_brdgeport_egress);
 
+	for (retry = 0; retry < 5; retry++) {
+		if (gswip31_stp_chk(gswdev, &tbl_prog_brdgeport_ingress,
+				    &tbl_prog_brdgeport_egress))
+			gsw_pce_table_read(cdev, &tbl_prog_brdgeport_ingress);
+		else
+			break;
+	}
+	if (retry == 5)
+		pr_err("Failed in reading Ingress Bridge Port.\n");
+
 	if (param->eMask & GSW_BRIDGE_PORT_CONFIG_MASK_BRIDGE_ID)
 		param->nBridgeId = ((tbl_prog_brdgeport_ingress.val[4] & 0x3F00) >> 8);
 
diff --git a/drivers/net/ethernet/lantiq/switch-api/gsw_tbl_rw.c b/drivers/net/ethernet/lantiq/switch-api/gsw_tbl_rw.c
index 322dbef7be85..ccdec51920a4 100644
--- a/drivers/net/ethernet/lantiq/switch-api/gsw_tbl_rw.c
+++ b/drivers/net/ethernet/lantiq/switch-api/gsw_tbl_rw.c
@@ -566,16 +566,11 @@ int gsw_pce_table_write(void *cdev, pctbl_prog_t *ptdata)
 	return GSW_statusOk;
 }
 
-int gsw_pce_table_read(void *cdev, pctbl_prog_t *ptdata)
+static int __gsw_pce_table_read(void *cdev, ethsw_api_dev_t *gswdev,
+				pctbl_prog_t *ptdata)
 {
 	u32 ctrlval, value;
 	u16 i, j;
-	ethsw_api_dev_t *gswdev = GSW_PDATA_GET(cdev);
-
-	if (gswdev == NULL) {
-		pr_err("\n%s:%s:%d", __FILE__, __func__, __LINE__);
-		return GSW_statusErr;
-	}
 
 	do {
 		gsw_r32_raw(cdev, PCE_TBL_CTRL_BAS_OFFSET, &ctrlval);
@@ -646,6 +641,45 @@ int gsw_pce_table_read(void *cdev, pctbl_prog_t *ptdata)
 	return GSW_statusOk;
 }
 
+int gsw_pce_table_read(void *cdev, pctbl_prog_t *ptdata)
+{
+	int ret;
+	int retry;
+	ethsw_api_dev_t *gswdev = GSW_PDATA_GET(cdev);
+
+	if (gswdev == NULL) {
+		pr_err("\n%s:%s:%d", __FILE__, __func__, __LINE__);
+		return GSW_statusErr;
+	}
+
+	if (!IS_VRSN_31(gswdev->gipver)
+	    || ptdata->table != PCE_IGBGP_INDEX
+	    || !gswdev->brdgeportconfig_idx[ptdata->pcindex].IndexInUse)
+		return __gsw_pce_table_read(cdev, gswdev, ptdata);
+
+	retry = 5;
+	while (retry--) {
+		u16 val;
+		int i;
+
+		ret = __gsw_pce_table_read(cdev, gswdev, ptdata);
+		if (ret != GSW_statusOk)
+			continue;
+
+		/* Go through port state at val[0] and port map at val[10~18]
+		   to ensure at lease 1 valid non-zero value is available for
+		   reading and table entry load is completed.
+		 */
+		val = ptdata->val[0];
+		for (i = 10; i < 18; i++)
+			val |= ptdata->val[i];
+		if (val)
+			break;
+	}
+
+	return ret;
+}
+
 int gsw_pce_table_key_read(void *cdev, pctbl_prog_t *ptdata)
 {
 	u32 ctrlval, value;
@@ -870,4 +904,3 @@ GSW_return_t GSW_DumpTable(void *cdev, GSW_table_t *parm)
 }
 
 
-
