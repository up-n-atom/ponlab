From e28b185c7c43a2a9bc2f3006afae99b81b1891f8 Mon Sep 17 00:00:00 2001
From: Elad Fernandes <elad.fernandes@intel.com>
Date: Mon, 13 Jul 2020 16:44:27 +0300
Subject: [PATCH] PONRTSYS-7979: Support ESP bypass sessions with VLAN
 insertion and removal

---
 drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c | 7 ++++++-
 drivers/net/ppv4/pp-hal/modifier/modifier_recipes.c     | 3 +--
 2 files changed, 7 insertions(+), 3 deletions(-)

diff --git a/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c b/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c
index 9033f3f14aff..736f17c4388a 100644
--- a/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c
+++ b/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c
@@ -677,7 +677,12 @@ static inline bool __smgr_is_esp_supported(struct sess_info *s)
 	/* bypass */
 	if (SESS_RX_IS_OUTER_ESP(s) &&
 	    (SESS_TX_OUTER_V4_NEXT(s) == PKTPRS_PROTO_ESP) &&
-	    (SESS_RX_PKT(s)->buf_sz == SESS_TX_PKT(s)->buf_sz)) {
+	    ((SESS_RX_PKT(s)->proto_bmap[PKTPRS_HDR_LEVEL0] |
+	      BIT(PKTPRS_PROTO_VLAN0)) ==
+	     (SESS_TX_PKT(s)->proto_bmap[PKTPRS_HDR_LEVEL0] |
+	      BIT(PKTPRS_PROTO_VLAN0))) &&
+	    (SESS_RX_PKT(s)->proto_bmap[PKTPRS_HDR_LEVEL1] ==
+	     SESS_TX_PKT(s)->proto_bmap[PKTPRS_HDR_LEVEL1])) {
 		SESS_MOD_FLAG_SET(s, MOD_ESP_V4_TUNNL_BPAS_BIT);
 		return true;
 	}
diff --git a/drivers/net/ppv4/pp-hal/modifier/modifier_recipes.c b/drivers/net/ppv4/pp-hal/modifier/modifier_recipes.c
index a5c91dc5bcaf..3a59be9042ce 100644
--- a/drivers/net/ppv4/pp-hal/modifier/modifier_recipes.c
+++ b/drivers/net/ppv4/pp-hal/modifier/modifier_recipes.c
@@ -1005,8 +1005,7 @@ static s32 mod_rcp_esp_set(s32 rcp_idx, enum rcp_new_hdr_ip_type nhdr)
 	 */
 	if (nhdr == RCP_NEW_HDR_NO_IP) {
 		/* Synchronize ALU to last fetched info of STORE command */
-		ret |= mod_alu_synch(EU_ALU0, &rcp, STW_NEXT_LAYER(l3_off),
-				     sync_off, sync_sz);
+		ret |= mod_alu_synch(EU_ALU0, &rcp, l3_off, sync_off, sync_sz);
 	}
 	/*=======================================*/
 	/* stw_off_l3 = stw_pkt_len - stw_off_l3 */
