From ff0d8893253712c145d032b62071a99abed36488 Mon Sep 17 00:00:00 2001
From: Elad Fernandes <elad.fernandes@intel.com>
Date: Sun, 26 Jan 2020 14:54:00 +0200
Subject: [PATCH] PONRTSYS-6530: Change the syncq scheduler to be invisible to
 the user

---
 drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_main.c  | 5 +++++
 drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.c | 3 ++-
 drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.h | 9 +++++++++
 3 files changed, 16 insertions(+), 1 deletion(-)

diff --git a/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_main.c b/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_main.c
index e02e419b6d04..44e09bafd1af 100644
--- a/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_main.c
+++ b/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_main.c
@@ -1700,6 +1700,11 @@ static s32 qos_get_user_parent(struct pp_qos_dev *qdev,
 		*user_parent_id =
 		    get_id_from_phy(qdev->mapping,
 				    parent->child_prop.parent_phy);
+	} else if (node_sched_syncq(parent)){
+		/* Return the parent of syncq sched */
+		*user_parent_id =
+		    get_id_from_phy(qdev->mapping,
+				    parent->child_prop.parent_phy);
 	} else {
 		*user_parent_id = parent_id;
 	}
diff --git a/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.c b/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.c
index cdf837ca9a03..8a056e4fdfb0 100644
--- a/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.c
+++ b/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.c
@@ -3336,7 +3336,8 @@ s32 connect_sync_queue(struct pp_qos_dev *qdev, u32 syncq_phy, u32 dstq_phy)
 
 	/* configure the new scheduler node */
 	new_sched_node->flags = 0;
-	QOS_BITS_SET(new_sched_node->flags, NODE_FLAGS_USED);
+	QOS_BITS_SET(new_sched_node->flags,
+		     NODE_FLAGS_USED | NODE_FLAGS_SCHED_SYNCQ);
 	new_sched_node->type = TYPE_SCHED;
 	new_sched_node->parent_prop.arbitration = PP_QOS_ARBITRATION_WSP;
 	new_sched_node->parent_prop.num_of_children = 2;
diff --git a/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.h b/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.h
index 8e7bf8519c51..c0a6b78c8bee 100644
--- a/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.h
+++ b/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.h
@@ -321,6 +321,7 @@ struct qos_node {
 #define NODE_FLAGS_QUEUE_CONNECTED_SYNCQ         BIT(3)
 #define NODE_FLAGS_PARENT_BEST_EFFORT_EN         BIT(4)
 #define NODE_FLAGS_REPLICATION_NODE              BIT(5)
+#define NODE_FLAGS_SCHED_SYNCQ                   BIT(6)
 #define NODE_FLAGS_PORT_PACKET_CREDIT_EN         BIT(7)
 #define NODE_FLAGS_PORT_BYTE_CREDIT_EN           BIT(8)
 #define NODE_FLAGS_QUEUE_WRED_EN                 BIT(10)
@@ -659,6 +660,14 @@ static inline bool node_syncq(const void *_node)
 	return (node_new_syncq(node) || node_connected_syncq(node));
 }
 
+static inline bool node_sched_syncq(const void *_node)
+{
+	const struct qos_node *node = (const struct qos_node *)_node;
+
+	return (node_used(node) &&
+		QOS_BITS_IS_SET(node->flags, NODE_FLAGS_SCHED_SYNCQ));
+}
+
 /**
  * @brief Test whether a node depend on hw clock rate and needs
  *        to be updated upon clock change
