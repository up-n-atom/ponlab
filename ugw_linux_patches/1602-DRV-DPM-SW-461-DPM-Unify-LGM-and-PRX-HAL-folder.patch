+#ifndef DATAPATH_PPV4_SESSION_H_
+#define DATAPATH_PPV4_SESSION_H_
+#include <net/datapath_api.h>
+#include "../datapath.h"
+
+#define DP_CLaSS_OFFSET  28
+#define DP_CLASS_SIZE    4
+
+enum GPID_TYPE {
+	DP_RES_GPID = 0, /*   0 -  15, Dont Use, as it overlaps with LPID */
+	DP_DYN_GPID,     /*  16 - 239, Dynamically allocated by DP */
+	DP_SPL_GPID      /* 240 - 255, 16 Special GPID per DPID */
+};
+
+#define DP_RES_GPID_LPID_START	0
+#define DP_RES_GPID_LPID_END	15
+#define DP_DYN_GPID_START	16
+#define DP_DYN_GPID_END		239
+#define DP_SPL_GPID_START	240
+#define DP_SPL_GPID_END		255
+
+#define DP_NUM_HIF_PRIO		2
+
+#define IS_SPECIAL_GPID(gpid)	\
+	(((gpid >= DP_SPL_GPID_START) && (gpid <= DP_SPL_GPID_END)) ? 1 : 0)
+/* Get Special GPID via DPID with fixed algo:
+ * DPID    special_gpid
+ * 15      255
+ * 14      254
+ * 13      253
+ * ...
+ * 10 .... 250
+ */
+#define SPL_GPID_VIA_DPID(dpid)	\
+	(DP_SPL_GPID_END - (DP_DYN_GPID_START - 1 - dpid))
+struct dp_dflt_hostif {
+	int inst;
+	int qid;
+	int gpid;
+	int color;
+};
+
+struct dp_session {
+	int inst; /* reserved for future */
+	int in_port; /* ingress GPID: Special GPID for this DC LPID.*/
+	int eg_port; /* eg/dst GPID:  Actual GPID (DC LPID + subif) */
+	int qid; /* physical qid */
+	int class; /* traffic class */
+	int vap;  /* same as subif_grp */
+	u32 h1;  /* hash1 function result */
+	u32 h2;  /* hash2 function result */
+	u32 sig; /* signature */
+	u32 sess_id; /* created session id */
+};
+
+#define dp_min_tx_pkt_len pp_min_tx_pkt_len
+
+int alloc_gpid(int inst, enum GPID_TYPE type, int gpid_num, int dpid);
+int free_gpid(int inst, int base, int gpid_num, int gpid_spl);
+int get_dpid_from_gpid(int inst, int gpid);
+int dp_add_dflt_hostif(struct dp_dflt_hostif *hostif, int flag);
+int dp_add_pp_gpid(int inst, int dpid, int vap, int gpid, int spl_gpid);
+int dp_del_pp_gpid(int inst, int dpid, int vap);
+int dp_subif_pp_set(int inst, int portid, int vap, u32 flag);
+int dp_subif_pp_reset(int inst, int portid, int vap, u32 flag);
+int dp_subif_pp_change_mtu(int inst, int dpid, int vap, u32 mtu);
+int dp_del_default_egress_sess(struct dp_subif_info *p_subif,
+			       int flag);
+int dp_add_default_egress_sess(struct dp_session *sess, int flag);
+int dp_update_hostif(int inst, int dpid, int vap, int flag);
+int dp_get_q_logic(int inst, int qid);
+int dp_add_hostif(int inst, int dpid, int vap);
+int dp_del_hostif(int inst, int dpid, int vap);
+
+#endif
diff --git a/drivers/net/datapath/dpm/gswip31/datapath_spl_conn.c b/drivers/net/datapath/dpm/gswip31/datapath_spl_conn.c
new file mode 100644
index 000000000000..3e59cdbfeafd
--- /dev/null
+++ b/drivers/net/datapath/dpm/gswip31/datapath_spl_conn.c
@@ -0,0 +1,736 @@
+// SPDX-License-Identifier: GPL-2.0
+#include <linux/device.h>
+#include <net/datapath_api.h>
+#include <net/datapath_api_umt.h>
+#include <net/intel_cbm_api.h>
+#include "../datapath.h"
+#include "datapath_misc.h"
+#include "datapath_ppv4.h"
+#include "datapath_ppv4_session.h"
+
+#define CTP_OFFSET (CQM_MAX_CPU * 2)
+#define MAX_PP_NF_CNT    4
+
+static const char *const SPL_CONN_NAMES[DP_SPL_MAX] = {
+	"toe",
+	"voice",
+	"vpn adapter",
+	"app litepath",
+	"pp nf",
+};
+
+static void update_deq_dma_ch(int inst, int egp_id, int ch)
+{
+	struct cqm_port_info *deq = get_dp_deqport_info(inst, egp_id);
+
+	deq->dma_chan = ch;
+}
+
+static int egp_pre_update(int inst, const struct dp_spl_cfg *conn,
+			  const struct dp_spl_egp *egp)
+{
+	struct cqm_port_info *deq = get_dp_deqport_info(inst, egp->egp_id);
+
+	/* Perform update if ref_cnt is 0 */
+	if (!deq->ref_cnt) {
+		deq->tx_pkt_credit = egp->tx_pkt_credit;
+		deq->txpush_addr = egp->tx_push_paddr;
+		deq->txpush_addr_qos = egp->tx_push_paddr_qos;
+		deq->tx_ring_size = egp->pp_ring_size;
+		deq->dp_port = conn->dp_port;
+		deq->f_first_qid = 1;
+	}
+
+	return deq->ref_cnt++;
+}
+
+static void egp_post_update(int inst, struct dp_spl_egp *egp,
+			    const struct ppv4_q_sch_port *pp)
+{
+	struct cqm_port_info *deq = get_dp_deqport_info(inst, egp->egp_id);
+
+	egp->qid = pp->qid;
+	deq->qos_port = pp->port_node;
+	deq->first_qid = pp->qid;
+	deq->q_node = pp->q_node;
+	DP_DEBUG(DP_DBG_FLAG_QOS, "EGP:%d QID:%d QNODE:%d QOS:%d\n",
+		 egp->egp_id, egp->qid, deq->q_node, deq->qos_port);
+}
+
+static int get_dep_q_node(int inst, const struct dp_spl_egp *egp)
+{
+	struct cqm_port_info *deq = get_dp_deqport_info(inst, egp->egp_id);
+
+	return deq->q_node;
+}
+
+static int release_egp_port(int inst, struct dp_spl_cfg *conn,
+			    struct dp_spl_egp *egp)
+{
+	struct cqm_port_info *deq = get_dp_deqport_info(inst, egp->egp_id);
+	struct dp_node_alloc alloc = {
+		.inst = inst,
+		.dp_port = conn->dp_port,
+		.type = DP_NODE_QUEUE,
+		.id.q_id = egp->qid,
+	};
+
+	deq->ref_cnt--;
+	WARN_ON(deq->ref_cnt);
+	if (deq->ref_cnt)
+		return DP_SUCCESS;
+
+	return dp_node_free(&alloc, 0);
+}
+
+static int setup_egp_port(int inst, struct dp_spl_cfg *conn,
+			  struct dp_spl_egp *egp)
+{
+	struct ppv4_q_sch_port pp = {
+		.inst    = inst,
+		.dp_port = conn->dp_port,
+		.ctp     = conn->spl_id,
+		.cqe_deq = egp->egp_id,
+	};
+
+	if (!egp_pre_update(inst, conn, egp)) {
+		if (alloc_q_to_port(&pp, conn->flag) == DP_FAILURE)
+			return DP_FAILURE;
+		egp_post_update(inst, egp, &pp);
+	} else {
+		DP_DEBUG(DP_DBG_FLAG_DBG, "id:%d egp:%d already allocated",
+			 conn->spl_id, egp->egp_id);
+	}
+
+	return DP_SUCCESS;
+}
+
+static int remove_egp(int inst, struct dp_spl_cfg *conn)
+{
+	int ret = DP_SUCCESS;
+	int i;
+
+	for (i = 0; i < conn->num_egp; i++) {
+		if (release_egp_port(inst, conn, &conn->egp[i]))
+			ret = DP_FAILURE;
+	}
+	return ret;
+}
+
+static int add_egp(int inst, struct dp_spl_cfg *conn)
+{
+	int i;
+
+	for (i = 0; i < conn->num_egp; i++) {
+		int ret = setup_egp_port(inst, conn, &conn->egp[i]);
+
+		if (ret) {
+			pr_err("failed to setup egp%d(%d)\n",
+			       conn->egp[i].egp_id, i);
+			return ret;
+		}
+	}
+	return DP_SUCCESS;
+}
+
+static int add_igp(int inst, struct dp_spl_cfg *conn)
+{
+	int i;
+
+	for (i = 0; i < conn->num_igp; i++) {
+		struct dp_spl_igp *igp = &conn->igp[i];
+		cbm_queue_map_entry_t entry;
+		bool egflag;
+
+		if (!igp->egp)
+			continue;
+		update_deq_dma_ch(inst, igp->egp->egp_id,
+				  igp->igp_dma_ch_to_gswip);
+
+		switch (conn->type) {
+		case DP_SPL_TOE:
+			egflag = true;
+			break;
+		case DP_SPL_VPNA:
+			if (i == 1) /* Without QOS */
+				return 0;
+		case DP_SPL_PP_NF:
+		case DP_SPL_APP_LITEPATH:
+			egflag = false;
+			break;
+		case DP_SPL_VOICE: // TODO: TBC - LY
+		default:
+			continue;
+		}
+
+		memset(&entry, 0, sizeof(cbm_queue_map_entry_t));
+		entry.ep = conn->dp_port;
+		entry.sub_if_id = conn->subif;
+		entry.egflag = egflag;
+
+		if (cbm_queue_map_set(inst, igp->egp->qid, &entry,
+				      conn->flag)) {
+			pr_err("failed to setup igp%d(%d)\n",
+			       igp->igp_id, i);
+			return DP_FAILURE;
+		}
+	}
+	return DP_SUCCESS;
+}
+
+static int add_umt(int inst, struct dp_spl_cfg *conn,
+		   const struct pmac_port_info *port)
+{
+	struct umt_ops *ops = dp_get_umt_ops(inst);
+	struct umt_port_res *res = &conn->umt->res;
+
+	res->rx_src = UMT_RX_SRC_CQEM;
+	res->cqm_enq_pid = conn->igp[0].igp_id;
+	res->cqm_dq_pid = conn->egp[0].egp_id;
+
+	if (!ops) {
+		pr_err("No UMT driver registered\n");
+		return -ENODEV;
+	}
+
+	if (ops->umt_alloc(ops->umt_dev, conn->umt) < 0) {
+		pr_err("Failed to allocate umt\n");
+		return -ENODEV;
+	}
+
+	return ops->umt_request(ops->umt_dev, conn->umt);
+}
+
+static int remove_umt(int inst, const struct dp_spl_cfg *conn)
+{
+	struct umt_ops *ops = dp_get_umt_ops(inst);
+
+	if (!ops)
+		return -ENODEV;
+
+	/* Disable UMT port */
+	if (ops->umt_enable(ops->umt_dev, conn->umt->ctl.id, 0))
+		return DP_FAILURE;
+
+	return ops->umt_release(ops->umt_dev, conn->umt->ctl.id);
+}
+
+static int sync_sif(int inst, struct dp_spl_cfg *conn,
+		    const struct pmac_port_info *port, const char *dev_name)
+{
+	struct dp_subif *data = devm_kzalloc(&g_dp_dev->dev, sizeof(struct dp_subif), GFP_ATOMIC);
+	const struct ctp_assign *ca = dp_gsw_get_ctp_assign(inst, DP_F_CPU);
+	char *name = (char *)dev_name;
+	int ret;
+	int i;
+
+	if (!data)
+		return DP_FAILURE;
+
+	if (!ca)
+		return DP_FAILURE;
+
+	data->port_id = conn->dp_port;
+	data->inst = inst;
+	data->subif_num = 1;
+	data->subif = conn->subif;
+	data->gpid = conn->gpid;
+	data->lookup_mode = ca->cqe_lu_md;
+	data->alloc_flag = port->alloc_flags;
+
+	for (i = 0; i < conn->num_egp; i++)
+		data->def_qlist[data->num_q++] = conn->egp[i].qid;
+
+	ret = dp_sync_subifid(conn->dev, name, data, NULL, conn->flag, &i);
+	if (ret)
+		goto exit;
+	ret = dp_sync_subifid_priv(conn->dev, name, data, NULL, conn->flag,
+				   NULL, &i, 1);
+
+exit:
+	devm_kfree(&g_dp_dev->dev, data);
+	return ret;
+}
+
+static int remove_spl_conn(int inst, struct dp_spl_cfg *conn,
+			   const struct pmac_port_info *port)
+{
+	int ret = DP_SUCCESS;
+	struct dp_subif_info *sif = get_dp_port_subif(port, conn->spl_id);
+	int c;
+
+	WARN_ON(sif->flags & PORT_FREE);
+
+	if (conn->f_gpid && dp_del_pp_gpid(inst, CPU_PORT, conn->spl_id)) {
+		pr_err("failed to delete GPID:%d\n", conn->gpid);
+		ret = DP_FAILURE;
+	}
+
+	if (conn->f_hostif && dp_del_hostif(inst, CPU_PORT, conn->spl_id)) {
+		pr_err("failed to delete hostif for GPID:%d\n", conn->gpid);
+		return DP_FAILURE;
+	}
+
+	if (dp_del_default_egress_sess(sif, 0)) {
+		pr_err("Failed to delete def egress session\n");
+		return DP_FAILURE;
+	}
+
+	/* remove exported subif */
+	if (conn->dev)
+		sync_sif(inst, conn, port, sif->device_name);
+
+	/* remove internal subif */
+	sif->subif_flag = conn->flag;
+	sif->flags = PORT_FREE;
+
+	/* remove UMT */
+	if (conn->num_umt_port) {
+		if (remove_umt(inst, conn)) {
+			pr_err("failed to release umt for spl type:%d\n",
+			       conn->type);
+		}
+	}
+
+	/* remove PPv4 */
+	if (remove_egp(inst, conn)) {
+		pr_err("failed to release egp for spl type:%d\n", conn->type);
+		ret = DP_FAILURE;
+	}
+
+	/* Store spl conn info from DP subif to CQM */
+	for (c = 0; c < sif->num_igp; c++) {
+		conn->igp[c].igp_id = sif->spl_cfg->igp[c].igp_id;
+		conn->igp[c].igp_dma_ch_to_gswip =
+			sif->spl_cfg->igp[c].igp_dma_ch_to_gswip;
+		conn->igp[c].num_out_cqm_deq_port =
+			sif->spl_cfg->igp[c].num_out_cqm_deq_port;
+	}
+	for (c = 0; c < sif->num_egp; c++) {
+		conn->egp[c].type = sif->spl_cfg->egp[c].type;
+		conn->egp[c].egp_id = sif->spl_cfg->egp[c].egp_id;
+	}
+	/* remove CQM */
+	if (cbm_dp_spl_conn(inst, conn))
+		ret = DP_FAILURE;
+
+	memset(conn, 0, sizeof(struct dp_spl_cfg));
+	return ret;
+}
+
+static int spl_get_free_idx(int inst, struct dp_spl_cfg *conn)
+{
+	struct hal_priv *hal = HAL(inst);
+	int cnt = 0;
+	int i;
+
+	for (i = 0; i < MAX_SPL_CONN_CNT; i++) {
+		struct dp_spl_cfg *cfg = &hal->spl[i];
+
+		if (!cfg->spl_id || cfg->type != conn->type)
+			continue;
+		cnt++;
+	}
+	if (conn->type == DP_SPL_PP_NF) {
+		if (cnt == MAX_PP_NF_CNT) {
+			pr_err("reach maximum PPNF port count %d\n",
+			       MAX_PP_NF_CNT);
+			return MAX_SPL_CONN_CNT;
+		}
+	} else {
+		if (cnt) {
+			pr_err("%s CPU special path created already\n",
+			       SPL_CONN_NAMES[conn->type]);
+			return MAX_SPL_CONN_CNT;
+		}
+	}
+
+	for (i = 0; i < MAX_SPL_CONN_CNT; i++) {
+		struct dp_spl_cfg *cfg = &hal->spl[i];
+
+		if (!cfg->spl_id)
+			return i;
+	}
+	pr_err("No enough room to create CPU special path for %s\n",
+	       SPL_CONN_NAMES[conn->type]);
+	return MAX_SPL_CONN_CNT;
+}
+
+static int add_spl_conn(int inst, struct dp_spl_cfg *conn,
+			const struct pmac_port_info *port)
+{
+	const struct ctp_assign *ca = dp_gsw_get_ctp_assign(inst, DP_F_CPU);
+	struct dp_subif_info *sif;
+	const char *name;
+	int idx;
+
+	WARN(CTP_OFFSET != 8, "ctp offset is changed, please confirm\n");
+
+	if (!ca) {
+		pr_err("CPU port CTP assignment is not initialized\n");
+		return DP_FAILURE;
+	}
+
+	if (conn->type >= DP_SPL_MAX) {
+		pr_err("invalid spl conn type\n");
+		return DP_FAILURE;
+	}
+
+	name = SPL_CONN_NAMES[conn->type];
+	if (conn->dp_cb && conn->dp_cb->rx_fn && !conn->dev) {
+		pr_err("cannot attach rx_fn without dev for %s\n", name);
+		return DP_FAILURE;
+	}
+	if (conn->type == DP_SPL_TOE && (conn->f_subif || conn->f_gpid)) {
+		pr_err("invalid flag for %s\n", name);
+		return DP_FAILURE;
+	}
+	if (!conn->f_subif && conn->f_gpid) {
+		pr_err("f_subif must be set when f_gpid is set\n");
+		return DP_FAILURE;
+	}
+
+	if (conn->type != DP_SPL_VOICE)
+		WARN_ON(conn->f_policy);
+
+	conn->flag |= DP_F_CPU;
+	idx = spl_get_free_idx(inst, conn);
+	if (idx == MAX_SPL_CONN_CNT)
+		return DP_FAILURE;
+	conn->spl_id = CTP_OFFSET + idx;
+	sif = get_dp_port_subif(port, conn->spl_id);
+	if (sif->flags != PORT_FREE) {
+		pr_err("%s allocated already\n", name);
+		return DP_FAILURE;
+	}
+	conn->dp_port = port->port_id;
+	BUG_ON(port->port_id != CPU_PORT);
+	conn->gpid = port->gpid_base + conn->spl_id;
+	conn->subif = SET_VAP(conn->spl_id, port->vap_offset, port->vap_mask);
+	if (cbm_dp_spl_conn(inst, conn))
+		return DP_FAILURE;
+	if (add_egp(inst, conn))
+		return DP_FAILURE;
+	if (add_igp(inst, conn))
+		return DP_FAILURE;
+	if (conn->num_umt_port) {
+		if (add_umt(inst, conn, port)) {
+			pr_err("failed to setup umt for %s\n", name);
+			return DP_FAILURE;
+		}
+	}
+
+	sif = get_dp_port_subif(port, conn->spl_id);
+	sif->subif_flag = conn->flag;
+	sif->flags = PORT_SUBIF_REGISTERED;
+	sif->netif = conn->dev;
+	sif->subif = conn->subif;
+	sif->gpid = conn->gpid;
+	sif->netif = conn->dev;
+	sif->policy_base = conn->policy[0].tx_policy_base;
+	sif->policy_num = conn->policy[0].tx_policy_num;
+	sif->rx_policy_base = conn->policy[0].rx_policy_base;
+	sif->rx_policy_num = conn->policy[0].rx_policy_num;
+	sif->qid = conn->egp[0].qid;
+	sif->q_node[0] = get_dep_q_node(inst, conn->egp);
+	sif->num_igp = conn->num_igp;
+	sif->num_egp = conn->num_egp;
+	sif->prel2_len = conn->prel2_len;
+	sif->spl_conn_type = conn->type;
+
+	if (conn->dp_cb) {
+		atomic_set(&sif->rx_flag, 1);
+		sif->rx_fn = conn->dp_cb->rx_fn;
+	}
+	INIT_LIST_HEAD(&sif->logic_dev);
+
+	if (conn->dev) {
+		const char *dn = dev_name(&conn->dev->dev);
+
+		if (!dn)
+			dn = name;
+		strncpy(sif->device_name, dn, IFNAMSIZ);
+		if (sync_sif(inst, conn, port, sif->device_name)) {
+			pr_err("failed to sync subif for %s\n", dn);
+			return DP_FAILURE;
+		}
+	} else {
+		strncpy(sif->device_name, name, IFNAMSIZ);
+	}
+
+	if (conn->f_gpid) {
+		if (dp_add_pp_gpid(inst, CPU_PORT, conn->spl_id, conn->gpid, 0))
+			return DP_FAILURE;
+		if (conn->type == DP_SPL_VOICE) {
+			BUG_ON(!port->gpid_spl);
+			if (dp_add_pp_gpid(inst, CPU_PORT, 0, port->gpid_spl,
+					   1))
+				return DP_FAILURE;
+			conn->spl_gpid = port->gpid_spl;
+		}
+	}
+
+	if (conn->f_hostif)
+		dp_add_hostif(inst, CPU_PORT, conn->spl_id);
+
+	DP_DEBUG(DP_DBG_FLAG_DBG, "%s id:%d gpid:%d",
+		 sif->device_name, conn->spl_id, sif->gpid);
+	return DP_SUCCESS;
+}
+
+static void dump_parameters(int inst, struct dp_spl_cfg *conn)
+{
+	int i;
+
+	pr_info("%s type:%s spl_id:%d f_subif:%d f_gpid:%d f_policy:%d f_hostif:%d dp_cb:%pf dev:%px\n",
+		__func__, SPL_CONN_NAMES[conn->type], conn->spl_id,
+		conn->f_subif, conn->f_gpid, conn->f_policy, conn->f_hostif,
+		conn->dp_cb, conn->dev);
+	if (conn->flag) {
+		pr_info("flags: ");
+		for_each_set_bit(i, (unsigned long *)&conn->flag,
+				 get_dp_port_type_str_size())
+		pr_info("%s ", dp_port_type_str[i]);
+		pr_info("\n");
+	}
+	for (i = 0; i < conn->num_igp; i++) {
+		struct dp_spl_igp *igp = conn->igp + i;
+
+		pr_info("IGP%d igp_ring_size:%d out_msg_mode:%d out_qos_mode:%d\n",
+			i, igp->igp_ring_size, igp->out_msg_mode,
+			igp->out_qos_mode);
+	}
+	for (i = 0; i < conn->num_egp; i++) {
+		struct dp_spl_egp *egp = conn->egp + i;
+
+		pr_info("EGP%d pp_ring_size:%d tx_push_paddr:%px tx_push_paddr_qos:%px\n",
+			i, egp->pp_ring_size, egp->tx_push_paddr,
+			egp->tx_push_paddr_qos);
+	}
+
+	if (conn->num_umt_port) {
+		struct umt_port_ctl *c = &conn->umt->ctl;
+
+		pr_info("UMT id:%d daddr:%lld msg_interval:%d, msg_mode:%d, cnt_mode:%d, sw_msg:%d, rx_msg_mode:%d, enable:%d, fflag:%ld\n",
+			c->id, c->daddr, c->msg_interval, c->msg_mode,
+			c->cnt_mode, c->sw_msg, c->rx_msg_mode, c->enable,
+			c->fflag);
+	}
+
+	if (conn->f_policy)
+		pr_info("policy rx_pkt_size:%d\n", conn->policy->rx_pkt_size);
+}
+
+int _dp_spl_conn(int inst, struct dp_spl_cfg *conn)
+{
+	struct hal_priv *hal = HAL(inst);
+	struct pmac_port_info *port;
+	int ret = DP_FAILURE;
+
+	if (!dp_init_ok) {
+		pr_err("DP not initialized yet\n");
+		return DP_FAILURE;
+	}
+	port = get_dp_port_info(inst, CPU_PORT);
+	if (!port) {
+		pr_err("DP not initialized yet\n");
+		return DP_FAILURE;
+	}
+
+	if (IS_ENABLED(CONFIG_INTEL_DATAPATH_DBG) &&
+	    unlikely(dp_dbg_flag & DP_DBG_FLAG_REG))
+		dump_parameters(inst, conn);
+	DP_LIB_LOCK(&dp_lock);
+	if (!hal->spl) {
+		hal->spl = kcalloc(MAX_SPL_CONN_CNT, sizeof(*conn), GFP_ATOMIC);
+		if (!hal->spl) {
+			pr_err("No enough memory\n");
+			goto exit;
+		}
+	}
+
+	if ((conn->flag & DP_F_DEREGISTER)) {
+		int i;
+
+		for (i = 0; i < MAX_SPL_CONN_CNT; i++) {
+			struct dp_spl_cfg *cfg = &hal->spl[i];
+			struct dp_subif_info *sif;
+
+			if (cfg->spl_id != conn->spl_id)
+				continue;
+			cfg->flag = conn->flag;
+			ret = remove_spl_conn(inst, cfg, port);
+			sif = get_dp_port_subif(port, conn->spl_id);
+			sif->spl_cfg = NULL;
+			break;
+		}
+		if (i == MAX_SPL_CONN_CNT)
+			pr_err("invalid spl id %d\n", conn->spl_id);
+	} else {
+		WARN(port->status != PORT_SUBIF_REGISTERED,
+		     "port->status:%d\n", port->status);
+		ret = add_spl_conn(inst, conn, port);
+		if (ret == DP_SUCCESS) {
+			struct dp_spl_cfg *tmp_cfg;
+			struct dp_subif_info *sif;
+			int i;
+
+			tmp_cfg = &hal->spl[conn->spl_id - CTP_OFFSET];
+			sif = get_dp_port_subif(port, conn->spl_id);
+			memcpy(tmp_cfg, conn, sizeof(struct dp_spl_cfg));
+			/* update internal igp->egp pointers correctly */
+			for (i = 0; i < conn->num_igp; i++) {
+				if (conn->igp[i].egp) {
+					long offset = conn->igp[i].egp - conn->egp;
+
+					tmp_cfg->igp[i].egp = tmp_cfg->egp + offset;
+				}
+			}
+			/* Keep a reference of spl_cfg from hal_priv in subif */
+			sif->spl_cfg = tmp_cfg;
+		}
+	}
+exit:
+	DP_LIB_UNLOCK(&dp_lock);
+	return ret;
+}
+
+int spl_conn_get(int inst, enum DP_SPL_TYPE type,
+		    struct dp_spl_cfg *conns, u8 total)
+{
+	struct hal_priv *hal = HAL(inst);
+	u8 cnt = 0;
+	int i;
+
+	if (!dp_init_ok || !hal->spl) {
+		pr_err("DP not initialized yet\n");
+		return 0;
+	}
+	if (type >= DP_SPL_MAX) {
+		pr_err("wrong parameter\n");
+		return 0;
+	}
+
+	if (type != DP_SPL_PP_NF)
+		total = 1;
+	DP_DEBUG(DP_DBG_FLAG_REG, "%s type:%s cnt:%d", __func__,
+		 SPL_CONN_NAMES[type], total);
+	for (i = 0; i < MAX_SPL_CONN_CNT; i++) {
+		struct dp_spl_cfg *cfg = &hal->spl[i];
+
+		if (!cfg->spl_id || cfg->type != type)
+			continue;
+		memcpy(conns + cnt, cfg, sizeof(struct dp_spl_cfg));
+		if (++cnt >= total)
+			break;
+	}
+	return cnt;
+}
+
+int _dp_spl_conn_get(int inst, enum DP_SPL_TYPE type,
+		       struct dp_spl_cfg *conns, u8 total)
+{
+	int ret;
+
+	DP_LIB_LOCK(&dp_lock);
+	ret = spl_conn_get(inst, type, conns, total);
+	DP_LIB_UNLOCK(&dp_lock);
+	return ret;
+}
+
+int dp_spl_conn_map_toe_egp(int inst, u16 dpid, u32 subif, u32 flag)
+{
+	struct hal_priv *hal = HAL(inst);
+	cbm_queue_map_entry_t entry;
+	struct dp_spl_cfg *cfg;
+	int ret = DP_FAILURE;
+
+	if (!dp_init_ok || !hal->spl) {
+		pr_err("DP not initialized yet\n");
+		return ret;
+	}
+
+	cfg = devm_kzalloc(&g_dp_dev->dev, sizeof(*cfg), GFP_ATOMIC);
+	if (!cfg) {
+		pr_err("out of memory\n");
+		return ret;
+	}
+	if (!spl_conn_get(inst, DP_SPL_TOE, cfg, 1)) {
+		pr_err("TOE not registered yet, please change the order\n");
+		goto exit;
+	}
+
+	memset(&entry, 0, sizeof(entry));
+	entry.ep = dpid;
+	entry.sub_if_id = subif;
+	entry.egflag = 1;
+
+	if (cbm_queue_map_set(inst, cfg->igp->egp->qid, &entry, flag)) {
+		pr_err("failed to setup TOE mapping for port %d subif:%d\n",
+		       dpid, subif);
+		goto exit;
+	}
+	ret = DP_SUCCESS;
+exit:
+	devm_kfree(&g_dp_dev->dev, cfg);
+	return ret;
+}
+
+int dp_spl_conn_get_num_of_egps(int inst, int egps[16])
+{
+	struct hal_priv *hal = HAL(inst);
+	int cnt = 0;
+	int i;
+
+	if (!dp_init_ok || !hal->spl) {
+		pr_err("DP not initialized yet\n");
+		return 0;
+	}
+	DP_LIB_LOCK(&dp_lock);
+	for (i = 0; i < MAX_SPL_CONN_CNT; i++) {
+		struct dp_spl_cfg *cfg = &hal->spl[i];
+		int c;
+
+		if (!cfg->spl_id)
+			continue;
+		for (c = 0; c < cfg->num_egp; c++)
+			egps[cnt++] = cfg->egp[c].egp_id;
+	}
+	DP_LIB_UNLOCK(&dp_lock);
+	return cnt;
+}
+
+static const char *get_dev_name(int inst, const struct dp_spl_cfg *c)
+{
+	return get_dp_port_subif(get_dp_port_info(inst, CPU_PORT),
+				 c->spl_id)->device_name;
+}
+
+const char *dp_spl_conn_get_name_from_egp(int inst, int egp_id)
+{
+	struct hal_priv *hal = HAL(inst);
+	const char *dev_name = NULL;
+	int i;
+
+	if (!dp_init_ok || !hal->spl) {
+		pr_err("DP not initialized yet\n");
+		return NULL;
+	}
+	DP_LIB_LOCK(&dp_lock);
+	for (i = 0; i < MAX_SPL_CONN_CNT; i++) {
+		struct dp_spl_cfg *cfg = &hal->spl[i];
+		int c;
+
+		if (!cfg->spl_id)
+			continue;
+		for (c = 0; c < cfg->num_egp; c++) {
+			if (cfg->egp[c].egp_id == egp_id) {
+				dev_name = get_dev_name(inst, cfg);
+				goto exit;
+			}
+		}
+	}
+exit:
+	DP_LIB_UNLOCK(&dp_lock);
+	return dev_name;
+}
