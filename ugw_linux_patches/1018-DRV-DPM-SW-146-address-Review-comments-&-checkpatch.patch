+	q_info->ref_cnt--;
+	if (q_info->flag && !q_info->ref_cnt && q_info->need_free) {
+		DP_DEBUG(DP_DBG_FLAG_REG, "Free qid %d\n", qid);
+		node.id.q_id = qid;
+		/*if no subif using this queue, need to delete it*/
+		node.inst = inst;
+		node.dp_port = dp_port;
