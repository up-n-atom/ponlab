-	GSW_PCE_rule_t pcecfg;
-#endif
 	/*
 	 * Alloc the chrdev region for mcast helper
 	 */
@@ -2815,28 +2851,7 @@ static int __init mcast_helper_init_module(void)
 		g_mcast_grpindex[index] = 0 ;
 	}
 
-#if IS_ENABLED(CONFIG_INTEL_DATAPATH_HAL_GSWIP30)
