 }
 
@@ -594,6 +587,8 @@ static void mcast_helper_five_tuple_br_hook(struct sk_buff *skb)
 		uint8_t src_mac[ETH_ALEN] = { 0 };
 		struct iphdr *iph = ip_hdr(skb);
 		struct udphdr *udph = (struct udphdr *)((u8 *)iph +(iph->ihl << 2));
+		if (((ntohl(iph->daddr) & 0xffffff00U) == 0xe0000000U) || ((ntohl(iph->daddr) & 0xff000000U) == 0xef000000U))
+			return;
 		mcast_helper_init_ipaddr(&saddr, IPV4, &iph->saddr);
 		mcast_helper_init_ipaddr(&daddr, IPV4, &iph->daddr);
 		mcast_helper_get_pkt_rx_src_mac_addr(skb, src_mac);
@@ -1565,6 +1560,9 @@ static int mcast_helper_add_entry(struct net_device *netdev, struct net_device *
 	int ret=0;
 	unsigned int flag = 0;
 
+	if (((ntohl(mc_rec->groupIP.ipA.ipAddr.s_addr) & 0xffffff00U) == 0xe0000000U) || ((ntohl(mc_rec->groupIP.ipA.ipAddr.s_addr) & 0xff000000U) == 0xef000000U)) {
+		return FAILURE;
+	}
 	gimc_rec = mcast_helper_search_gimc_record(&(mc_rec->groupIP),&(mc_rec->srcIP),gimc_list);
 	if (gimc_rec == NULL) {
 		gimc_rec = mcast_helper_add_gimc_record(rxnetdev, &(mc_rec->groupIP), &(mc_rec->srcIP), mc_rec->proto, mc_rec->sPort, mc_rec->dPort, src_mac, gimc_list);
@@ -1587,6 +1585,7 @@ static int mcast_helper_add_entry(struct net_device *netdev, struct net_device *
 		if (upper_dev && (upper_dev->priv_flags & IFF_EBRIDGE)) {
 			flag = mcast_helper_update_mac_list(gitxmc_rec, gimc_rec, mc_rec->macaddr, MC_F_ADD);
 			mch_br_capture_pkt = 1;
+			join_grp_cnt++;
 		} else {
 
 			if (mch_acl_enabled) {
@@ -1831,7 +1830,7 @@ static long mcast_helper_ioctl(struct file *f, unsigned int cmd, unsigned long a
 				return -EACCES;
 
 			} else {
-				memcpy(mcast_mem.rxIntrfName, gimc_rec->mc_stream.rxDev->name, strlen(gimc_rec->mc_stream.rxDev->name));
+				memcpy(mcast_mem.rxIntrfName, gimc_rec->mc_stream.rxDev->name, IFNAMSIZ);
 			}
 
 			if (copy_to_user((MCAST_REC_t *)arg, &mcast_mem, sizeof(MCAST_REC_t))) {
@@ -2767,6 +2766,47 @@ static struct file_operations mcast_helper_fops = {
 	.unlocked_ioctl = mcast_helper_ioctl
 };
 
+/* Lanserver entry deletion for netdev down/unregister events */
+static int mc_netdevice_event(struct notifier_block *nb, unsigned long action, void *ptr)
+{
+	struct list_head *vliter = NULL;
+	struct list_head *vtliter = NULL;
+	MCAST_GIMC_t *lanserver_gimc_rec = NULL;
+
+	MCH_NETIF *netif = netdev_notifier_info_to_dev((struct netdev_notifier_info *)ptr);
+	struct list_head *gimc_lanserver_list_v4 = mcast_helper_session_p(IPV4);
+	struct list_head *gimc_lanserver_list_v6 = mcast_helper_session_p(IPV6);
+
+	switch (action) {
+	case NETDEV_UNREGISTER:
+	case NETDEV_DOWN:
+		list_for_each_safe(vliter, vtliter, gimc_lanserver_list_v4) {
+			lanserver_gimc_rec = list_entry(vliter, MCAST_GIMC_t, list);
+			if (lanserver_gimc_rec->mc_stream.rxDev == netif)
+			{
+				mcast_helper_delete_gimc_record(lanserver_gimc_rec);
+				break;
+			}
+		}
+		list_for_each_safe(vliter, vtliter, gimc_lanserver_list_v6) {
+			lanserver_gimc_rec = list_entry(vliter, MCAST_GIMC_t, list);
+			if (lanserver_gimc_rec->mc_stream.rxDev == netif)
+			{
+				mcast_helper_delete_gimc_record(lanserver_gimc_rec);
+				break;
+			}
+		}
+		break;
+
+	}
+	return 0;
+
+}
+
+struct notifier_block mc_netdevice_notifier = {
+	.notifier_call = mc_netdevice_event
+};
+
 /*=============================================================================
  *function name: mcast_helper_init_module
  *description  : Multucast helper module initilization
