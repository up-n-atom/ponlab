From 1882401300dc55c555d88a595b5b52c083bde717 Mon Sep 17 00:00:00 2001
From: Emergi Idan <idan.emergi@intel.com>
Date: Thu, 26 Mar 2020 15:09:04 +0200
Subject: [PATCH] PONRTSYS-6084: Fix eWSP unit-test

Signed-off-by: Emergi Idan <idan.emergi@intel.com>
---
 .../ppv4/pp-tools/unit-test/tests/pp_qos_tests.c   | 154 ++++++++++++---------
 1 file changed, 87 insertions(+), 67 deletions(-)

diff --git a/drivers/net/ppv4/pp-tools/unit-test/tests/pp_qos_tests.c b/drivers/net/ppv4/pp-tools/unit-test/tests/pp_qos_tests.c
index 4b5136a0616b..f05c3d6d199c 100644
--- a/drivers/net/ppv4/pp-tools/unit-test/tests/pp_qos_tests.c
+++ b/drivers/net/ppv4/pp-tools/unit-test/tests/pp_qos_tests.c
@@ -3971,12 +3971,15 @@ static int arbitration_test(void *data)
 	return test_ret;
 }
 
+#define EWSP_PORT_NUM   3
+#define EWSP_QUEUES_NUM 8
 static int enhanced_wsp_test(void *data)
 {
 	struct pp_qos_dev *qdev;
 	struct pp_qos_port_conf confp;
 	struct pp_qos_queue_conf confq;
-	u32 port_idx, queue_id, queue_idx, port[3], queue[24];
+	u32 port, queue, ports[EWSP_PORT_NUM],
+		queues[EWSP_PORT_NUM][EWSP_QUEUES_NUM];
 	u32 test_ret = PP_UT_FAIL;
 
 	qdev = qos_restart(PP_QOS_INSTANCE_ID);
@@ -3995,93 +3998,110 @@ static int enhanced_wsp_test(void *data)
 	confq.wred_max_allowed = 0x400;
 
 	/* add 3 ports, each has 8 queues */
-	for (port_idx = 0; port_idx < 3; port_idx++) {
-		pp_qos_port_allocate(qdev, ALLOC_PORT_ID, &port[port_idx]);
-		confp.ring_address = ring_addr_phys[port_idx];
-		pp_qos_port_set(qdev, port[port_idx], &confp);
-
-		confq.queue_child_prop.parent = port[port_idx];
-		for (queue_idx = 0; queue_idx < 8; queue_idx++) {
-			queue_id = (port_idx * 8) + queue_idx;
-			pp_qos_queue_allocate(qdev, &queue[queue_id]);
-			confq.queue_child_prop.priority = queue_idx;
-			pp_qos_queue_set(qdev, queue[queue_id], &confq);
+	for (port = 0; port < ARRAY_SIZE(ports); port++) {
+		pp_qos_port_allocate(qdev, ALLOC_PORT_ID, &ports[port]);
+		confp.ring_address = ring_addr_phys[port];
+		pp_qos_port_set(qdev, ports[port], &confp);
+
+		confq.queue_child_prop.parent = ports[port];
+		for (queue = 0; queue < EWSP_QUEUES_NUM; queue++) {
+			pp_qos_queue_allocate(qdev, &queues[port][queue]);
+			confq.queue_child_prop.priority = queue;
+			pp_qos_queue_set(qdev, queues[port][queue], &confq);
 		}
 	}
 
-	/* Make sure only 12 ewsp queues are allocated */
-	PPUT_FAIL_RETURN(qdev->ewsp_cfg.num_queues == 12,
-			 "expected 12 ewsp queues, found %u\n",
-			 qdev->ewsp_cfg.num_queues);
+	/* Make sure only maximum ewsp queues are allocated */
+	PPUT_FAIL_RETURN(
+		qdev->ewsp_cfg.num_queues == QOS_ENHANCED_WSP_MAX_QUEUES,
+		"expected %u ewsp queues, found %u\n",
+		QOS_ENHANCED_WSP_MAX_QUEUES, qdev->ewsp_cfg.num_queues);
 
 	/* Make sure only first 2 ports are assigned with 6 ewsp queues each */
-	for (queue_idx = 0; queue_idx < 24; queue_idx++) {
-		if ((queue_idx >= 0 && queue_idx <= 5) ||
-		    (queue_idx >= 8 && queue_idx <= 13)) {
-			PPUT_FAIL_RETURN(is_q_ewsp(qdev, queue[queue_idx]),
-					"Queue %u should be ewsp\n",
-					queue[queue_idx]);
-		} else {
-			PPUT_FAIL_RETURN(!is_q_ewsp(qdev, queue[queue_idx]),
-					"Queue %u should not be ewsp\n",
-					queue[queue_idx]);
+	for (port = 0; port < ARRAY_SIZE(ports); port++) {
+		for (queue = 0; queue < EWSP_QUEUES_NUM; queue++) {
+			if ((port == 0 && (queue >= 0 && queue <= 5)) ||
+			    (port == 1 && (queue >= 0 && queue <= 5))) {
+				PPUT_FAIL_RETURN(is_q_ewsp(qdev,
+							   queues[port][queue]),
+						 "P%u.Q%u should be ewsp\n",
+						 port, queue);
+			} else {
+				PPUT_FAIL_RETURN(
+					!is_q_ewsp(qdev, queues[port][queue]),
+					"P%u.Q%u should not be ewsp\n", port,
+					queue);
+			}
 		}
 	}
 
-	/* Remove first queue, verify 3rd port is assigned with 1 ewsp queue */
-	pp_qos_queue_remove(qdev, queue[0]);
-	for (queue_idx = 1; queue_idx < 24; queue_idx++) {
-		if ((queue_idx >= 1 && queue_idx <= 5) ||
-		    (queue_idx >= 8 && queue_idx <= 13) ||
-		    (queue_idx == 16)) {
-			PPUT_FAIL_RETURN(is_q_ewsp(qdev, queue[queue_idx]),
-					"Queue %u should be ewsp\n",
-					queue[queue_idx]);
-		} else {
-			PPUT_FAIL_RETURN(!is_q_ewsp(qdev, queue[queue_idx]),
-					"Queue %u should not be ewsp\n",
-					queue[queue_idx]);
+	/* Remove port0 queue0, verify port2 is assigned with 1 ewsp queue */
+	pp_qos_queue_remove(qdev, queues[0][0]);
+	for (port = 0; port < ARRAY_SIZE(ports); port++) {
+		for (queue = 0; queue < EWSP_QUEUES_NUM; queue++) {
+			if (port == 0 && queue == 0)
+				continue;
+			if ((port == 0 && (queue >= 1 && queue <= 5)) ||
+			    (port == 1 && (queue >= 0 && queue <= 5)) ||
+			    (port == 2 && queue == 0)) {
+				PPUT_FAIL_RETURN(is_q_ewsp(qdev,
+							   queues[port][queue]),
+						 "P%u.Q%u should be ewsp\n",
+						 port, queue);
+			} else {
+				PPUT_FAIL_RETURN(
+					!is_q_ewsp(qdev, queues[port][queue]),
+					"P%u.Q%u should not be ewsp\n", port,
+					queue);
+			}
 		}
 	}
 
-	/* Remove 8th queue, verify 3rd port is assigned with 2 ewsp queue */
-	pp_qos_queue_remove(qdev, queue[7]);
-	for (queue_idx = 16; queue_idx < 24; queue_idx++) {
-		if (queue_idx >= 16 && queue_idx <= 17) {
-			PPUT_FAIL_RETURN(is_q_ewsp(qdev, queue[queue_idx]),
-					"Queue %u should be ewsp\n",
-					queue[queue_idx]);
+	/* Remove port0 queue7, verify port2 is assigned with 2 ewsp queue */
+	pp_qos_queue_remove(qdev, queues[0][7]);
+	port = 2;
+	for (queue = 0; queue < EWSP_QUEUES_NUM; queue++) {
+		if (queue >= 0 && queue <= 1) {
+			PPUT_FAIL_RETURN(is_q_ewsp(qdev, queues[port][queue]),
+					 "P%u.Q%u should be ewsp\n", port,
+					 queue);
 		} else {
-			PPUT_FAIL_RETURN(!is_q_ewsp(qdev, queue[queue_idx]),
-					"Queue %u should not be ewsp\n",
-					queue[queue_idx]);
+			PPUT_FAIL_RETURN(!is_q_ewsp(qdev, queues[port][queue]),
+					 "P%u.Q%u should not be ewsp\n", port,
+					 queue);
 		}
 	}
 
-	/* Move priority 7 queue from 3rd port to 1st port */
-	pp_qos_queue_conf_get(qdev, queue[23], &confq);
+	/* Move port2 queue7 to port1 */
+	pp_qos_queue_conf_get(qdev, queues[2][7], &confq);
 	confq.blocked = 1;
-	confq.queue_child_prop.parent = port[0];
-	queue[16] = queue[23];
-	pp_qos_queue_set(qdev, queue[23], &confq);
-	for (queue_idx = 1; queue_idx < 23; queue_idx++) {
-		if ((queue_idx >= 1 && queue_idx <= 5) ||
-		    (queue_idx >= 8 && queue_idx <= 13) ||
-		    (queue_idx == 16)) {
-			PPUT_FAIL_RETURN(is_q_ewsp(qdev, queue[queue_idx]),
-					"Queue %u should be ewsp\n",
-					queue[queue_idx]);
-		} else {
-			PPUT_FAIL_RETURN(!is_q_ewsp(qdev, queue[queue_idx]),
-					"Queue %u should not be ewsp\n",
-					queue[queue_idx]);
+	confq.queue_child_prop.parent = ports[0];
+	queues[0][7] = queues[2][7];
+	pp_qos_queue_set(qdev, queues[0][7], &confq);
+	for (port = 0; port < ARRAY_SIZE(ports); port++) {
+		for (queue = 0; queue < EWSP_QUEUES_NUM; queue++) {
+			if (port == 0 && queue == 0)
+				continue;
+			if ((port == 0 && (queue >= 1 && queue <= 5)) ||
+			    (port == 1 && (queue >= 0 && queue <= 5)) ||
+			    (port == 2 && queue == 0)) {
+				PPUT_FAIL_RETURN(is_q_ewsp(qdev,
+							   queues[port][queue]),
+						 "P%u.Q%u should be ewsp\n",
+						 port, queue);
+			} else {
+				PPUT_FAIL_RETURN(
+					!is_q_ewsp(qdev, queues[port][queue]),
+					"P%u.Q%u should not be ewsp\n", port,
+					queue);
+			}
 		}
 	}
 	test_ret = PP_UT_PASS;
 
 	DUMP_QOS_TREE(qdev);
-	for (port_idx = 0; port_idx < 3; port_idx++)
-		pp_qos_port_remove(qdev, port[port_idx]);
+	for (port = 0; port < 3; port++)
+		pp_qos_port_remove(qdev, ports[port]);
 
 #ifdef FW_CHECK_SYNC
 	if (check_sync_with_fw(qdev, true)) {
