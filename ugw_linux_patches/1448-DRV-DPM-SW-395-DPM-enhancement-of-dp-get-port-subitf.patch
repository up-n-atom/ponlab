From a490e1fbea32d41f2fbfc4b0a10bd15bca790d49 Mon Sep 17 00:00:00 2001
From: Rekha Eswaran <rekha.eswaran@intel.com>
Date: Wed, 14 Oct 2020 11:30:33 +0800
Subject: [PATCH] DRV_DPM_SW-395 - DPM enhancement of
 dp_get_port_subitf_via_dev

---
 drivers/net/datapath/dpm/datapath_api.c         | 50 +------------------------
 drivers/net/datapath/dpm/datapath_logical_dev.c | 13 +++----
 drivers/net/datapath/dpm/datapath_swdev.c       | 11 ++++--
 3 files changed, 14 insertions(+), 60 deletions(-)

diff --git a/drivers/net/datapath/dpm/datapath_api.c b/drivers/net/datapath/dpm/datapath_api.c
index 0287727e25a7..727f30d707d2 100644
--- a/drivers/net/datapath/dpm/datapath_api.c
+++ b/drivers/net/datapath/dpm/datapath_api.c
@@ -1967,50 +1967,6 @@ static int dp_register_dc(int inst, u32 port_id,
 	return ret;
 }
 
-/* return DP_SUCCESS -- found
- * return DP_FAILURE -- not found
- */
-int dp_get_port_subitf_via_dev_private(struct net_device *dev,
-				       dp_subif_t *subif)
-{
-	int i, j;
-	int inst;
-
-	if (!dev) {
-		pr_err("%s: dev is NULL\n", __func__);
-		return DP_FAILURE;
-	}
-	if (!subif) {
-		pr_err("%s: subif is NULL\n", __func__);
-		return DP_FAILURE;
-	}
-
-	inst = dp_get_inst_via_dev(dev, NULL, 0);
-	for (i = 0; i < get_dp_prop_info(inst)->cap.max_num_dp_ports; i++) {
-		struct pmac_port_info *port = get_dp_port_info(inst, i);
-
-		for (j = 0; j < port->subif_max; j++) {
-			struct dp_subif_info *sif = get_dp_port_subif(port, j);
-
-			if (!sif->flags)
-				continue;
-			if (sif->netif != dev && sif->ctp_dev != dev)
-				continue;
-			subif->port_id = i;
-			subif->subif = SET_VAP(j, port->vap_offset,
-					       port->vap_mask);
-			subif->inst = inst;
-			subif->bport = sif->bp;
-			return DP_SUCCESS;
-		}
-	}
-
-	pr_err("%s: subif not found for inst %d dev %s\n",
-	       __func__, inst, dev->name);
-
-	return DP_FAILURE;
-}
-
 int dp_get_port_subitf_via_dev(struct net_device *dev, dp_subif_t *subif)
 {
 	int res;
@@ -2020,9 +1976,7 @@ int dp_get_port_subitf_via_dev(struct net_device *dev, dp_subif_t *subif)
 		return DP_FAILURE;
 	}
 
-	DP_LIB_LOCK(&dp_lock);
-	res = dp_get_port_subitf_via_dev_private(dev, subif);
-	DP_LIB_UNLOCK(&dp_lock);
+	res = dp_get_netif_subifid(dev, NULL, NULL, NULL, subif, 0);
 	return res;
 }
 EXPORT_SYMBOL(dp_get_port_subitf_via_dev);
@@ -2096,7 +2050,7 @@ int32_t dp_check_if_netif_fastpath_fn(struct net_device *netif,
 		tmp_subif = *subif;
 		tmp_subif.inst = 0;
 	} else if (netif) {
-		dp_get_port_subitf_via_dev_private(netif, &tmp_subif);
+		dp_get_netif_subifid(netif, NULL, NULL, NULL, &tmp_subif, 0);
 	} else if (ifname) {
 		dp_get_port_subitf_via_ifname_private(ifname, &tmp_subif);
 	}
diff --git a/drivers/net/datapath/dpm/datapath_logical_dev.c b/drivers/net/datapath/dpm/datapath_logical_dev.c
index b883329b638a..75a5bf49fa1a 100644
--- a/drivers/net/datapath/dpm/datapath_logical_dev.c
+++ b/drivers/net/datapath/dpm/datapath_logical_dev.c
@@ -102,7 +102,7 @@ int add_logic_dev(int inst, int port_id, struct net_device *dev,
 {
 	struct logic_dev *logic_dev_tmp;
 	struct net_device *base_dev;
-	dp_subif_t subif;
+	dp_subif_t subif = {0};
 	int masked_subif;
 	struct pmac_port_info *port_info;
 	struct dp_subif_info *sif;
@@ -114,15 +114,13 @@ int add_logic_dev(int inst, int port_id, struct net_device *dev,
 	}
 	base_dev = get_base_dev(dev, -1);
 	if (!base_dev) {
-		DP_DEBUG(DP_DBG_FLAG_LOGIC,
-			 "Not found base dev of %s\n", dev->name);
+		pr_err("Not found base dev of %s\n", dev->name);
 		return -1;
 	}
 	DP_DEBUG(DP_DBG_FLAG_LOGIC,
 		 "base_dev=%s for logic dev %s\n", base_dev->name, dev->name);
-	if (dp_get_port_subitf_via_dev_private(base_dev, &subif)) {
-		DP_DEBUG(DP_DBG_FLAG_LOGIC,
-			 "Not registered base dev %s in DP\n", dev->name);
+	if (dp_get_netif_subifid(base_dev, NULL, NULL, NULL, &subif, 0)) {
+		pr_err("Not registered base dev %s in DP\n", dev->name);
 		return -1;
 	}
 	port_info = get_dp_port_info(inst, port_id);
@@ -133,8 +131,7 @@ int add_logic_dev(int inst, int port_id, struct net_device *dev,
 	sif = get_dp_port_subif(port_info, masked_subif);
 	logic_dev_tmp = logic_list_lookup(&sif->logic_dev, dev);
 	if (logic_dev_tmp) {
-		DP_DEBUG(DP_DBG_FLAG_LOGIC, "Device already exist: %s\n",
-			 dev->name);
+		pr_err("Device already exist: %s\n", dev->name);
 		return -1;
 	}
 	logic_dev_tmp = devm_kzalloc(&g_dp_dev->dev,
diff --git a/drivers/net/datapath/dpm/datapath_swdev.c b/drivers/net/datapath/dpm/datapath_swdev.c
index bbb698ffa13a..bef83bc5b110 100644
--- a/drivers/net/datapath/dpm/datapath_swdev.c
+++ b/drivers/net/datapath/dpm/datapath_swdev.c
@@ -386,7 +386,7 @@ static int dp_swdev_filter_vlan(struct net_device *dev,
 
 	if (switchdev_trans_ph_prepare(trans)) {
 		if (dp_get_netif_subifid(dev, NULL, NULL, NULL, &subif, 0)) {
-			pr_err("%s get subif fail for %s\n",
+			pr_err("%s get subif fail, dev (%s) not registered\n",
 			       __func__, dev->name);
 			return ret;
 		}
@@ -592,7 +592,7 @@ static int dp_swdev_add_if(struct net_device *dev,
 
 	if (dp_get_netif_subifid(dev, NULL, NULL, NULL, &subif, 0)) {
 		DP_DEBUG(DP_DBG_FLAG_SWDEV,
-				 "Get subifid failed for %s, check if vlan dev\n",
+			 "Get subifid failed for %s, check if vlan dev\n",
 			 dev->name);
 
 		/* Check bridge port exists otherwise register
@@ -733,7 +733,10 @@ static int dp_swdev_del_if(struct net_device *dev,
 	/* Get current BR_PORT ID from DP */
 	if (dp_get_netif_subifid(dev, NULL, NULL, NULL, &subif, 0)) {
 		pr_err("%s get subif failed for %s\n", __func__, dev->name);
-		return DP_FAILURE;
+		/* cannot return DP_FAILURE since for VLAN case device
+		 * registration is done after this
+		 */
+		return -EOPNOTSUPP;
 	}
 
 	if (switchdev_trans_ph_prepare(trans)) {
@@ -902,7 +905,7 @@ static int dp_swdev_port_attr_learning_limit_set(struct net_device *dev,
 		DP_DEBUG(DP_DBG_FLAG_SWDEV,
 			 "Get subif failed for %s\n",
 			 dev->name);
-			return -EINVAL;
+		return -EINVAL;
 	}
 
 	i_info = &dp_port_prop[subif.inst].info;
