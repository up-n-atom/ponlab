+			pr_err("%s: dc enq dummy buf req failed on port %d\n",
+			       __func__, res->cqm_enq_pid);
+			return DP_FAILURE;
+		}
+		pr_info("dc enq dummy buffer req succeeded on port %d\n",
+			res->cqm_enq_pid);
 #endif
-	return ret;
+	}
+#endif
+	return DP_SUCCESS;
