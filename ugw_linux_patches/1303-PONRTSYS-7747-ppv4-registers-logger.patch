diff --git a/drivers/net/ppv4/Kconfig b/drivers/net/ppv4/Kconfig
index 9487ba1b7d90..5827c0f68372 100644
--- a/drivers/net/ppv4/Kconfig
+++ b/drivers/net/ppv4/Kconfig
@@ -3,7 +3,6 @@
 #
 config PPV4
 	tristate "Packet Processor V4"
-
 	---help---
 	  Packet Processor V4 Driver
 
@@ -18,3 +17,16 @@ config PPV4_UT
 	depends on PPV4
 	---help---
 	  Packet Processor V4 Driver Unit Test
+
+config PPV4_HW_MOD_REGS_LOGS
+	bool "Enable logs prints when modifying hw modules registers"
+	depends on PPV4
+	---help---
+	  Set to true if you want to see logs print when modifying hw
+	  registers, e.g. QoS, BM, etc...
+
+config PPV4_HW_MOD_REGS_LOGS_EN
+	hex "Bitmap specifying which hw modules should be enabled"
+	depends on PPV4_HW_MOD_REGS_LOGS
+	---help---
+	  Set the desired module bit to 1
\ No newline at end of file
diff --git a/drivers/net/ppv4/pp-api/pp-misc/pp_misc_debugfs.c b/drivers/net/ppv4/pp-api/pp-misc/pp_misc_debugfs.c
index 8e352d80d6c5..845eb438fd28 100644
--- a/drivers/net/ppv4/pp-api/pp-misc/pp_misc_debugfs.c
+++ b/drivers/net/ppv4/pp-api/pp-misc/pp_misc_debugfs.c
@@ -555,18 +555,52 @@ static void __dbg_nf_get(struct seq_file *f)
 
 PP_DEFINE_DEBUGFS(nf, __dbg_nf_get, __dbg_nf_set);
 
-#endif
+#ifdef CONFIG_PPV4_HW_MOD_REGS_LOGS
+/**
+ * @brief Set PP registers write logs on/off
+ */
+static s32 mod_reg_log_en_set(void *data, u64 val)
+{
+	ulong bmap = (ulong)val;
+
+	return pp_regs_mod_log_en_set(&bmap, HW_MOD_CNT);
+}
+
+/**
+ * @brief Get PP registers write logs status
+ */
+static s32 mod_reg_log_en_get(void *data, u64 *val)
+{
+	ulong bmap = (ulong)*val;
+	s32 ret;
+
+	ret  = pp_regs_mod_log_en_get(&bmap, HW_MOD_CNT);
+	*val = (u64)bmap;
+	return ret;
+}
+
+PP_DEFINE_DBGFS_ATT_FMT(mod_reg_log_en, mod_reg_log_en_get, mod_reg_log_en_set,
+			"%llx\n");
+
+#endif /* CONFIG_PPV4_HW_MOD_REGS_LOGS */
+
+#endif /* CONFIG_PPV4_LGM */
 
 #if IS_ENABLED(CONFIG_PPV4_LGM)
