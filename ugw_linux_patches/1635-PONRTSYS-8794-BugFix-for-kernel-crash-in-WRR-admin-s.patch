From 8a432c8b63c3dc328c7120fb067bc5be663d4c1f Mon Sep 17 00:00:00 2001
From: thampan <joby.thampan@intel.com>
Date: Tue, 6 Apr 2021 21:48:30 +0800
Subject: [PATCH] PONRTSYS-8794: BugFix for kernel crash in WRR admin state
 up/down

---
 drivers/net/ethernet/lantiq/cqm/prx300/cqm.c | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/drivers/net/ethernet/lantiq/cqm/prx300/cqm.c b/drivers/net/ethernet/lantiq/cqm/prx300/cqm.c
index 79bd7d3ae6e0..0cf2dc3b2232 100644
--- a/drivers/net/ethernet/lantiq/cqm/prx300/cqm.c
+++ b/drivers/net/ethernet/lantiq/cqm/prx300/cqm.c
@@ -778,12 +778,15 @@ static void map_to_drop_q(struct cbm_lookup_entry *lu_entry)
 	u8 value = 0;
 	u8 *ptr;
 	int i = 0;
+	u32 offset, shift;
+	void *qidt = cqm_ctrl->qidt;
 
 	spin_lock_irqsave(&cqm_qidt_lock, sys_flag);
 
 	for (i = 0; i < MAX_LOOKUP_TBL_SIZE; i++) {
-		ptr = (u8 *)&g_cbm_qidt_mirror[i / 4].qidt_shadow;
-		value = ptr[i % 4];
+		offset = (i / 4) * 4;
+		shift = (i % 4) * 8;
+		value = ((cbm_r32(qidt + offset)) >> shift) & PRX300_CQM_Q_MASK;
 
 		/* if match, set the index to drop q */
 		if (lu_entry->qid == value) {
