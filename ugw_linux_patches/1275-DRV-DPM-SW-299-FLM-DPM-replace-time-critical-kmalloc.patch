-				       GFP_ATOMIC);
+		br_item = kmem_cache_zalloc(cache_br_entry_list, GFP_ATOMIC);
 		if (!br_item)
 			/* TODO need to check dequeue if no memory */
 			return -ENOMEM;
@@ -744,7 +773,7 @@ static int dp_swdev_del_if(struct net_device *dev,
 		rcu_read_unlock();
 
 		/*check return value & enqueue*/
-		switchdev_trans_item_enqueue(trans, br_item, dp_kfree,
