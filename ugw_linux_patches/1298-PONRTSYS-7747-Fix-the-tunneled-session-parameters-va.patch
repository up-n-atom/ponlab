From 3dd487dd2e08ed4350ffa2d8223504e508004f51 Mon Sep 17 00:00:00 2001
From: Elad Fernandes <elad.fernandes@intel.com>
Date: Thu, 30 Apr 2020 11:29:07 +0300
Subject: [PATCH] PONRTSYS-7747: Fix the tunneled session parameters validation

---
 drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c          | 6 +++---
 drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr_internal.h | 8 ++++----
 2 files changed, 7 insertions(+), 7 deletions(-)

diff --git a/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c b/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c
index d633447745fd..019ea4bcc3dc 100644
--- a/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c
+++ b/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c
@@ -782,7 +782,7 @@ static inline bool __smgr_is_dslite_term_sess(struct sess_info *s)
 	/* encapsulation */
 	if (SESS_TX_IS_DSLITE(s)  &&
 	    !SESS_RX_IS_DSLITE(s) &&
-	    SESS_RX_IS_INNER_L4(s)) {
+	    SESS_TX_IS_INNER_L4(s)) {
 		SESS_MOD_FLAG_SET(s, MOD_DSLITE_ENCP_BIT);
 		return true;
 	}
@@ -810,7 +810,7 @@ static inline bool __smgr_is_6rd_term_sess(struct sess_info *s)
 	/* encapsulation */
 	if (SESS_TX_IS_SIXRD(s)  &&
 	    !SESS_RX_IS_SIXRD(s) &&
-	    SESS_RX_IS_INNER_L4(s)) {
+	    SESS_TX_IS_INNER_L4(s)) {
 		SESS_MOD_FLAG_SET(s, MOD_6RD_ENCP_BIT);
 		return true;
 	}
@@ -2460,7 +2460,7 @@ static void __smgr_si_newhdr_set(struct sess_info *s)
 
 	if (__smgr_is_iptun_encp_sess(s)) {
 		/* ip tunnel encapsulation session */
-		tx_inner_ip = SESS_RX_IS_INNER_V4(s) ?
+		tx_inner_ip = SESS_TX_IS_INNER_V4(s) ?
 			      PKTPRS_PROTO_IPV4 : PKTPRS_PROTO_IPV6;
 		/* nhdr size is the tx header up to the inner ip offset */
 		dpu->nhdr_sz = pktprs_hdr_off(SESS_TX_PKT(s), tx_inner_ip,
diff --git a/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr_internal.h b/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr_internal.h
index e837eaf815b9..75aa334eeaf7 100644
--- a/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr_internal.h
+++ b/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr_internal.h
@@ -144,18 +144,18 @@ PKTPRS_PROTO_NEXT(SESS_TX_PKT(s), PKTPRS_PROTO_IPV4, HDR_OUTER)
  * @param s session info pointer
  */
 #define SESS_RX_IS_OUTER_UDP(s)         PKTPRS_IS_UDP(SESS_RX_PKT(s), HDR_OUTER)
-#define SESS_TX_IS_OUTER_UDP(s)         PKTPRS_IS_UDP(SESS_RX_PKT(s), HDR_OUTER)
+#define SESS_TX_IS_OUTER_UDP(s)         PKTPRS_IS_UDP(SESS_TX_PKT(s), HDR_OUTER)
 #define SESS_RX_IS_INNER_UDP(s)         PKTPRS_IS_UDP(SESS_RX_PKT(s), HDR_INNER)
-#define SESS_TX_IS_INNER_UDP(s)         PKTPRS_IS_UDP(SESS_RX_PKT(s), HDR_INNER)
+#define SESS_TX_IS_INNER_UDP(s)         PKTPRS_IS_UDP(SESS_TX_PKT(s), HDR_INNER)
 
 /**
  * @brief Shortcuts for checking if session is tcp
  * @param s session info pointer
  */
 #define SESS_RX_IS_OUTER_TCP(s)         PKTPRS_IS_TCP(SESS_RX_PKT(s), HDR_OUTER)
-#define SESS_TX_IS_OUTER_TCP(s)         PKTPRS_IS_TCP(SESS_RX_PKT(s), HDR_OUTER)
+#define SESS_TX_IS_OUTER_TCP(s)         PKTPRS_IS_TCP(SESS_TX_PKT(s), HDR_OUTER)
 #define SESS_RX_IS_INNER_TCP(s)         PKTPRS_IS_TCP(SESS_RX_PKT(s), HDR_INNER)
-#define SESS_TX_IS_INNER_TCP(s)         PKTPRS_IS_TCP(SESS_RX_PKT(s), HDR_INNER)
+#define SESS_TX_IS_INNER_TCP(s)         PKTPRS_IS_TCP(SESS_TX_PKT(s), HDR_INNER)
 
 /**
  * @brief Shortcuts for checking if session is esp
