From bb3ee37e36213f1ea19d76f5321753b83905c0f7 Mon Sep 17 00:00:00 2001
From: Elad Fernandes <elad.fernandes@intel.com>
Date: Wed, 22 Jul 2020 13:39:54 +0300
Subject: [PATCH] PONRTSYS-7979: Update the modifier recipe ALU sync offsets

---
 .../net/ppv4/pp-hal/modifier/modifier_recipes.c    | 37 ++++++++++++++--------
 1 file changed, 23 insertions(+), 14 deletions(-)

diff --git a/drivers/net/ppv4/pp-hal/modifier/modifier_recipes.c b/drivers/net/ppv4/pp-hal/modifier/modifier_recipes.c
index 3a59be9042ce..f444bd3858b9 100644
--- a/drivers/net/ppv4/pp-hal/modifier/modifier_recipes.c
+++ b/drivers/net/ppv4/pp-hal/modifier/modifier_recipes.c
@@ -438,7 +438,6 @@ static s32 mod_rcp_ipv4_routed_set(s32 rcp_idx, enum mod_eu_stw_mux_sel l3_off,
 {
 	struct mod_recipe rcp;
 	s32 ret = 0;
-	u32 sync_off, sync_sz;
 
 	/* ================= */
 	/* Map dpu registers */
@@ -518,8 +517,6 @@ static s32 mod_rcp_ipv4_routed_set(s32 rcp_idx, enum mod_eu_stw_mux_sel l3_off,
 				  FIELD_SIZEOF(struct iphdr, ttl) +
 				  FIELD_SIZEOF(struct iphdr, protocol) +
 				  FIELD_SIZEOF(struct iphdr, check));
-	sync_off = offsetof(struct iphdr, check);
-	sync_sz  = FIELD_SIZEOF(struct iphdr, check);
 
 	/* store L4 checksum */
 	if (l4_napt) {
@@ -527,8 +524,6 @@ static s32 mod_rcp_ipv4_routed_set(s32 rcp_idx, enum mod_eu_stw_mux_sel l3_off,
 					  STW_NEXT_LAYER(l3_off),
 					  MOD_SI_PKT_OFF,
 					  FIELD_SIZEOF(struct udphdr, check));
-		sync_off = MOD_SI_PKT_OFF;
-		sync_sz  = FIELD_SIZEOF(struct udphdr, check);
 	}
 
 	/*=========================*/
@@ -547,10 +542,26 @@ static s32 mod_rcp_ipv4_routed_set(s32 rcp_idx, enum mod_eu_stw_mux_sel l3_off,
 	 *  |------------------------|------------------------------------|
 	 */
 	/* Synchronize ALU0 to latest fetched information of STORE command */
-	ret |= mod_alu_synch(EU_ALU0, &rcp, STW_NEXT_LAYER(l3_off), sync_off,
-			     sync_sz);
-	ret |= mod_alu_synch(EU_ALU1, &rcp, STW_NEXT_LAYER(l3_off), sync_off,
-			     sync_sz);
+	ret |= mod_alu_synch(EU_ALU0, &rcp, l3_off,
+			     offsetof(struct iphdr, check),
+			     FIELD_SIZEOF(struct iphdr, check));
+	if (l4_napt) {
+		/* Here we need to sync up to the L4 checksum field,
+		 * according to flow limitation we need to sync few bytes
+		 * before as we dont want to sync on the last bytes of the
+		 * header which can delayed the alu operation and anyway
+		 * we have at least 8 cycles from store engine to alu1 engine
+		 * so for UDP and TCP we synched on the L4 dest port field
+		 * (byte 4 from the L4 offset)
+		 */
+		ret |= mod_alu_synch(EU_ALU1, &rcp, STW_NEXT_LAYER(l3_off),
+				     offsetof(struct udphdr, dest),
+				     FIELD_SIZEOF(struct udphdr, dest));
+	} else {
+		ret |= mod_alu_synch(EU_ALU1, &rcp, l3_off,
+				     offsetof(struct iphdr, check),
+				     FIELD_SIZEOF(struct iphdr, check));
+	}
 
 	/* decrement TTL */
 	ret |= mod_alu_sub(EU_ALU0, &rcp, pkt_l3_ttl, si_l3_ttl_diff,
@@ -926,7 +937,6 @@ static s32 mod_rcp_esp_set(s32 rcp_idx, enum rcp_new_hdr_ip_type nhdr)
 {
 	struct mod_recipe rcp;
 	s32 ret = 0;
-	u32 sync_off, sync_sz;
 	enum mod_eu_stw_mux_sel l3_off = EU_STW_SEL_L3_OFF0;
 
 	/* ================= */
@@ -984,9 +994,6 @@ static s32 mod_rcp_esp_set(s32 rcp_idx, enum rcp_new_hdr_ip_type nhdr)
 		ret |= mod_pkt_to_reg_cpy(&rcp, pkt_l3_csum, l3_off,
 					  offsetof(struct iphdr, check),
 					  FIELD_SIZEOF(struct iphdr, check));
-
-		sync_off = offsetof(struct iphdr, check);
-		sync_sz  = FIELD_SIZEOF(struct iphdr, check);
 	}
 
 	/*=========================*/
@@ -1005,7 +1012,9 @@ static s32 mod_rcp_esp_set(s32 rcp_idx, enum rcp_new_hdr_ip_type nhdr)
 	 */
 	if (nhdr == RCP_NEW_HDR_NO_IP) {
 		/* Synchronize ALU to last fetched info of STORE command */
-		ret |= mod_alu_synch(EU_ALU0, &rcp, l3_off, sync_off, sync_sz);
+		ret |= mod_alu_synch(EU_ALU0, &rcp, l3_off,
+				     offsetof(struct iphdr, check),
+				     FIELD_SIZEOF(struct iphdr, check));
 	}
 	/*=======================================*/
 	/* stw_off_l3 = stw_pkt_len - stw_off_l3 */
