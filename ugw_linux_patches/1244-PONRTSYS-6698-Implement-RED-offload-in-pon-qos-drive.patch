From 28d7392828affc0fa99459a35a4d2472eeb35fa0 Mon Sep 17 00:00:00 2001
From: "Rywacki, Kamil" <kamil.rywacki@intel.com>
Date: Tue, 16 Jun 2020 15:11:46 +0200
Subject: [PATCH] PONRTSYS-6698: Implement RED offload in pon qos driver

- Fix QID discovery for scheduler grandchildren and following
generations

Signed-off-by: Rywacki, Kamil <kamil.rywacki@intel.com>
---
 drivers/net/datapath/pon_qos/pon_qos_tc_qos.c | 22 +++++++++++++++
 drivers/net/datapath/pon_qos/pon_qos_tc_qos.h |  4 +++
 drivers/net/datapath/pon_qos/pon_qos_tc_red.c | 39 ++++++++++++++++-----------
 3 files changed, 50 insertions(+), 15 deletions(-)

diff --git a/drivers/net/datapath/pon_qos/pon_qos_tc_qos.c b/drivers/net/datapath/pon_qos/pon_qos_tc_qos.c
index 72a71071a4f8..41d93e8110c8 100644
--- a/drivers/net/datapath/pon_qos/pon_qos_tc_qos.c
+++ b/drivers/net/datapath/pon_qos/pon_qos_tc_qos.c
@@ -991,12 +991,34 @@ int pon_qos_qdata_add(struct net_device *dev, struct pon_qos_q_data *qid,
 	params->parent = parent;
 	params->type = type;
 	params->destroy = destroy;
+	params->qid = qid;
 
 	list_add(&params->list, &qid->params);
 
 	return 0;
 }
 
+struct pon_qos_q_data *pon_qos_qdata_qid_get(struct net_device *dev,
+					     struct pon_qos_qdisc *qdisc,
+					     u32 parent)
+{
+	struct pon_qos_q_data *qid;
+	struct pon_qos_qdata_params *p;
+	int idx;
+
+	for (idx = 0; idx < PON_QOS_TC_MAX_Q; idx++) {
+		qid = &qdisc->qids[idx];
+		if (!(qid->qid))
+			continue;
+		list_for_each_entry(p, &qid->params, list) {
+			if (TC_H_MAJ(p->handle) == TC_H_MAJ(parent))
+				return qid;
+		}
+	}
+
+	return NULL;
+}
+
 static int __pon_qos_qdata_remove(struct net_device *dev,
 				  struct pon_qos_q_data *qid,
 				  struct pon_qos_qdata_params *p);
diff --git a/drivers/net/datapath/pon_qos/pon_qos_tc_qos.h b/drivers/net/datapath/pon_qos/pon_qos_tc_qos.h
index ef600a365229..80cc0175ce0a 100644
--- a/drivers/net/datapath/pon_qos/pon_qos_tc_qos.h
+++ b/drivers/net/datapath/pon_qos/pon_qos_tc_qos.h
@@ -41,6 +41,7 @@ struct pon_qos_qdata_params {
 	u32 handle;
 	u32 parent;
 	enum pon_qos_qdata_type type;
+	struct pon_qos_q_data *qid;
 	int (*destroy)(struct net_device *dev, u32 handle, u32 parent);
 	struct list_head list;
 };
@@ -165,6 +166,9 @@ int pon_qos_qdata_get_by_type(struct net_device *dev,
 			      struct pon_qos_q_data *qid,
 			      enum pon_qos_qdata_type type,
 			      u32 *handle, u32 *parent);
+struct pon_qos_q_data *pon_qos_qdata_qid_get(struct net_device *dev,
+					     struct pon_qos_qdisc *qdisc,
+					     u32 parent);
 int pon_qos_qdata_add(struct net_device *dev, struct pon_qos_q_data *qid,
 		      u32 handle, u32 parent, enum pon_qos_qdata_type type,
 		      int (*destroy)(struct net_device *dev, u32 handle,
diff --git a/drivers/net/datapath/pon_qos/pon_qos_tc_red.c b/drivers/net/datapath/pon_qos/pon_qos_tc_red.c
index 6bc47fcb9c3b..f311af0be8b0 100644
--- a/drivers/net/datapath/pon_qos/pon_qos_tc_red.c
+++ b/drivers/net/datapath/pon_qos/pon_qos_tc_red.c
@@ -107,11 +107,14 @@ static int __wred_destroy(struct net_device *dev, u32 handle, u32 parent,
 		return 0;
 	}
 
-	ret = pon_qos_get_queue_by_handle(dev, parent, &qid);
-	if (ret < 0 || !qid) {
-		netdev_err(dev, "%s: handle not found err %d\n",
-			   __func__, ret);
-		return -1;
+	qid = pon_qos_qdata_qid_get(dev, qdisc, parent);
+	if (!qid) {
+		ret = pon_qos_get_queue_by_handle(dev, parent, &qid);
+		if (ret < 0 || !qid) {
+			netdev_err(dev, "%s: handle not found err %d\n",
+				   __func__, ret);
+			return -1;
+		}
 	}
 
 	ret = wred_params_set(qdisc, qid, type, true, NULL);
@@ -157,11 +160,14 @@ static int pon_qos_tc_red_replace(struct net_device *dev,
 		return -1;
 	}
 
-	ret = pon_qos_get_queue_by_handle(dev, opt->parent, &qid);
-	if (ret < 0 || !qid) {
-		netdev_err(dev, "%s: handle not found err %d\n",
-			   __func__, ret);
-		return -1;
+	qid = pon_qos_qdata_qid_get(dev, qdisc, opt->parent);
+	if (!qid) {
+		ret = pon_qos_get_queue_by_handle(dev, opt->parent, &qid);
+		if (ret < 0 || !qid) {
+			netdev_err(dev, "%s: handle not found err %d\n",
+				   __func__, ret);
+			return -1;
+		}
 	}
 
 	/* Set GREEN for first RED, YELLOW for second */
@@ -217,11 +223,14 @@ static int pon_qos_tc_red_destroy(struct net_device *dev,
 		return 0;
 	}
 
-	ret = pon_qos_get_queue_by_handle(dev, opt->parent, &qid);
-	if (ret < 0 || !qid) {
-		netdev_err(dev, "%s: handle not found err %d\n",
-			   __func__, ret);
-		return -1;
+	qid = pon_qos_qdata_qid_get(dev, qdisc, opt->parent);
+	if (!qid) {
+		ret = pon_qos_get_queue_by_handle(dev, opt->parent, &qid);
+		if (ret < 0 || !qid) {
+			netdev_err(dev, "%s: handle not found err %d\n",
+				   __func__, ret);
+			return -1;
+		}
 	}
 
 	return pon_qos_qdata_remove(dev, qid, handle, opt->parent);
