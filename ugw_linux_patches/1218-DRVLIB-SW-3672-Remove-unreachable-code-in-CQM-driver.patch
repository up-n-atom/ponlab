From 82df43366e84c35919f5638d650df38f440f4380 Mon Sep 17 00:00:00 2001
From: arathinx <ayyappanx.rathinam@intel.com>
Date: Wed, 10 Jun 2020 18:37:17 +0800
Subject: [PATCH] DRVLIB_SW-3672: Remove unreachable code in CQM driver

---
 drivers/net/ethernet/lantiq/cqm/prx300/cqm.c       | 29 +++++-----------------
 .../net/ethernet/lantiq/cqm/prx300/cqm_config.c    |  4 +--
 .../net/ethernet/lantiq/cqm/prx300/cqm_config.h    | 12 ++++++++-
 3 files changed, 19 insertions(+), 26 deletions(-)

diff --git a/drivers/net/ethernet/lantiq/cqm/prx300/cqm.c b/drivers/net/ethernet/lantiq/cqm/prx300/cqm.c
index 38c17047fe6f..2c95d7887177 100644
--- a/drivers/net/ethernet/lantiq/cqm/prx300/cqm.c
+++ b/drivers/net/ethernet/lantiq/cqm/prx300/cqm.c
@@ -1825,7 +1825,7 @@ static int setup_desc(struct cbm_desc *desc, u32 data_ptr, u32 data_len,
 static s32 cqm_cpu_pkt_tx(struct sk_buff *skb, struct cbm_tx_data *data,
 			  u32 flags)
 {
-	struct cbm_desc desc;
+	struct cbm_desc desc = {0};
 	u32 tmp_data_ptr;
 	struct dma_tx_desc_2 *desc_2 = (struct dma_tx_desc_2 *)&skb->DW2;
 	u32 new_buf = 0;
@@ -1856,15 +1856,10 @@ static s32 cqm_cpu_pkt_tx(struct sk_buff *skb, struct cbm_tx_data *data,
 				dev_err(cqm_ctrl->dev, "Error getting pool policy\n");
 				goto ERR_CASE_1;
 			}
-			if (cbm_linearise_buf(skb, data, buf_size,
-					      (new_buf)
-					      )) {
-				pr_err("linearize failed\n");
-				goto ERR_CASE_1;
-			}
 			tmp_data_ptr = new_buf;
 			dev_dbg(cqm_ctrl->dev, "tmp_data_ptr 0x%x\n",
 				tmp_data_ptr);
+			cbm_linearise_buf(skb, data, buf_size, new_buf);
 		}
 	} else {
 		/*Insert PMAC header if present*/
@@ -1883,20 +1878,11 @@ static s32 cqm_cpu_pkt_tx(struct sk_buff *skb, struct cbm_tx_data *data,
 		/* Detach the skb */
 		skb->head = NULL;
 	}
-	if (setup_desc((struct cbm_desc *)&desc, tmp_data_ptr,
-		       tot_len,
-		       skb->DW1, skb->DW0, skb->DW3, pool, policy)) {
-		dev_err(cqm_ctrl->dev, "cbm setup desc failed..\n");
-		cqm_buffer_free(smp_processor_id(), (void *)tmp_data_ptr, 1);
-		goto ERR_CASE_2;
-	}
+	setup_desc((struct cbm_desc *)&desc, tmp_data_ptr, tot_len, skb->DW1,
+		   skb->DW0, skb->DW3, pool, policy);
 	dev_kfree_skb_any(skb);
 
-	if (cqm_cpu_enqueue(smp_processor_id(), &desc)) {
-		dev_err(cqm_ctrl->dev, "cpu enqueue failed..\n");
-		cqm_buffer_free(smp_processor_id(), (void *)tmp_data_ptr, 1);
-		return CBM_FAILURE;
-	}
+	cqm_cpu_enqueue(smp_processor_id(), &desc);
 	UP_STATS(cqm_dbg_cntrs[policy][pool].tx_cnt);
 		return CBM_SUCCESS;
 ERR_CASE_1:
@@ -2254,10 +2240,7 @@ dp_port_alloc(struct module *owner, struct net_device *dev, u32 dev_port,
 ALLOC_OK:
 	result = get_matching_pmac(pmac, flags, cbm_port, param_pmac,
 				   pmac_present);
-	if (result == CBM_FAILURE) {
-		dev_err(cqm_ctrl->dev, "get_matching pmac error\n");
-		return DP_FAILURE;
-	} else if (result == CBM_NOTFOUND) {
+	if (result == CBM_NOTFOUND) {
 		/*Physical port allocation failure,
 		 *means this is just virtual pmac required
 		 */
diff --git a/drivers/net/ethernet/lantiq/cqm/prx300/cqm_config.c b/drivers/net/ethernet/lantiq/cqm/prx300/cqm_config.c
index 199d6ee05a29..248507bfa933 100644
--- a/drivers/net/ethernet/lantiq/cqm/prx300/cqm_config.c
+++ b/drivers/net/ethernet/lantiq/cqm/prx300/cqm_config.c
@@ -38,8 +38,8 @@ struct cqm_bm_pool_config bm_pool_conf[CQM_PRX300_NUM_POOLS] = {
 	{
 	.buf_frm_size = CQM_SRAM_FRM_SIZE,
 	.buf_type = REQ_FSQM_BUF,
-	.segment_mask = (CQM_SRAM_FRM_SIZE == 2048) ? 0xfffff800 : 0xffffff80,
-	.offset_mask = (CQM_SRAM_FRM_SIZE == 2048) ? 0x7ff : 0x7f,
+	.segment_mask = CQM_SEGMENT_MASK_SIZE,
+	.offset_mask = CQM_OFFSET_MASK_SIZE,
 	.pool = 7,
 	.policy = 7,
 	.pool_start_low = (unsigned int)(CQM_SRAM_BASE),
diff --git a/drivers/net/ethernet/lantiq/cqm/prx300/cqm_config.h b/drivers/net/ethernet/lantiq/cqm/prx300/cqm_config.h
index 63d3d69bd15a..2c235495c47c 100644
--- a/drivers/net/ethernet/lantiq/cqm/prx300/cqm_config.h
+++ b/drivers/net/ethernet/lantiq/cqm/prx300/cqm_config.h
@@ -10,7 +10,6 @@
 #define CQM_QID2EP_DW_NUM	0x100
 #define CQM_SRAM_SIZE	0xC0000
 #define CQM_SRAM_FRM_SIZE 128
-#define CQM_SRAM_FRM_SIZE_BIT ((CQM_SRAM_FRM_SIZE == 128) ? 0 : 1)
 #define CQM_CPU_POOL_BUF_ALW_NUM	128
 #define CQM_SRAM_BASE	0x18D00000
 #define CQM_CPU_POOL 0
@@ -33,6 +32,17 @@
 #define PRX300_MPE1_POS 8
 #define PRX300_EP_POS 4
 #define PRX300_SEL3TO0_POS 0
+
+#if CQM_SRAM_FRM_SIZE == 128
+#define CQM_SEGMENT_MASK_SIZE 0xfffff800
+#define CQM_OFFSET_MASK_SIZE 0x7ff
+#define CQM_SRAM_FRM_SIZE_BIT 0
+#else
+#define CQM_SEGMENT_MASK_SIZE 0xffffff80
+#define CQM_OFFSET_MASK_SIZE 0x7f
+#define CQM_SRAM_FRM_SIZE_BIT 1
+#endif
+
 enum {
 	REQ_FSQM_BUF = 0,
 	REQ_SIZE0_BUF = 1,
