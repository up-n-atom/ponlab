From 03833e4f710b0bd753c4b8110eb648b898f70b91 Mon Sep 17 00:00:00 2001
From: "Vishnu Swaroop Kumar Sarma, Duddu" <duddu.swaroop@intel.com>
Date: Fri, 14 Aug 2020 14:03:05 +0530
Subject: [PATCH] UGW_SW-52907 initialize f24s for axepoint during bootup

---
 .../net/ethernet/lantiq/switch-api/gsw_flow_core.c | 191 +++++++++++----------
 .../net/ethernet/lantiq/switch-api/gsw_flow_core.h |   2 -
 drivers/net/ethernet/lantiq/switch-api/gsw_init.c  |   1 +
 drivers/net/ethernet/lantiq/switch-api/gsw_init.h  |   2 +
 4 files changed, 105 insertions(+), 91 deletions(-)

diff --git a/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c b/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c
index 088c0d7e2269..8c5f8ff1e958 100644
--- a/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c
+++ b/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c
@@ -3010,6 +3010,7 @@ static GSW_return_t legacy_switch_core_init(void *cdev)
 {
 	ethsw_api_dev_t *gswdev = GSW_PDATA_GET(cdev);
 	u32 j = 0;
+	short offset;
 
 	if (gswdev == NULL) {
 		pr_err("%s:%s:%d", __FILE__, __func__, __LINE__);
@@ -3059,13 +3060,15 @@ static GSW_return_t legacy_switch_core_init(void *cdev)
 	} else {
 		/* Switch Core 2.2 and lower*/
 		mdio_init_gswip2_2(cdev);
+		offset = ANEG_EEE_0_CLK_STOP_CAPABLE_OFFSET;
 
+		if (gswdev->sdev == LTQ_FLOW_DEV_EXT_AX3000_F24S)
+			offset += 1;
 		/* EEE auto negotiation overides:  */
 		/*clock disable (ANEG_EEE_0.CLK_STOP_CAPABLE)  */
 		for (j = 0; j < gswdev->pnum - 1; j++) {
 			gsw_w32(cdev,
-				((ANEG_EEE_0_CLK_STOP_CAPABLE_OFFSET + j)
-				 + GSW_TREG_OFFSET),
+				((offset + j) + GSW_TREG_OFFSET),
 				ANEG_EEE_0_CLK_STOP_CAPABLE_SHIFT,
 				ANEG_EEE_0_CLK_STOP_CAPABLE_SIZE, 0x3);
 		}
@@ -3484,10 +3487,7 @@ void *ethsw_api_core_init(ethsw_core_init_t *ethcinit)
 	PrvData->gsw_base = ethcinit->gsw_base_addr;
 
 	/** Get Switch Hardware capablity */
-
-	/* TODO: Need to adapt for XRX500 F24S */
-	if (!(ethcinit->sdev == LTQ_FLOW_DEV_EXT_AX3000_F24S))
-		get_gsw_hw_cap(cdev);
+	get_gsw_hw_cap(cdev);
 
 	/** Initialize Switch Core Function Pointer */
 	gsw_init_fn_ptrs(cdev);
@@ -3549,9 +3549,10 @@ void *ethsw_api_core_init(ethsw_core_init_t *ethcinit)
 	gsw_w32(cdev, PCE_GCTRL_0_MC_VALID_OFFSET,
 		PCE_GCTRL_0_MC_VALID_SHIFT, PCE_GCTRL_0_MC_VALID_SIZE, 0x1);
 #else
-	/* TODO: Need to adapt for XRX500 F24S */
 	if (!(ethcinit->sdev == LTQ_FLOW_DEV_EXT_AX3000_F24S))
 		gsw_pmicro_code_init(cdev);
+	else
+		gsw_pmicro_code_init_f24s(cdev);
 #endif
 
 		if (IS_VRSN_31(PrvData->gipver))
@@ -3563,6 +3564,7 @@ void *ethsw_api_core_init(ethsw_core_init_t *ethcinit)
 	cport_sgmii_config(cdev);
 	GSW_Enable(cdev);
 #endif /*CONFIG_X86_INTEL_CE2700*/
+	PrvData->hwinit = 1;
 	return PrvData;
 }
 
@@ -12406,7 +12408,7 @@ GSW_return_t GSW_CfgSet(void *cdev, GSW_cfg_t *parm)
 #define PORT_NUM	6
 #define PHY_ID		4
 
-static inline void grx550_misc_config(ethsw_api_dev_t *gswdev) {
+void grx550_misc_config(ethsw_api_dev_t *gswdev) {
 	u32 val = 0;
 	struct core_ops *ops;
 
@@ -12416,19 +12418,22 @@ static inline void grx550_misc_config(ethsw_api_dev_t *gswdev) {
 	regmap_write(gswdev->chiptop_base, IFMUX_CFG, val);
 
 	ops = gsw_get_swcore_ops(LTQ_FLOW_DEV_INT_R);
-	/* assign port 1 address in gswip-r as port 6  and rest as auto */
+	/* assign port 1 address in gswip-r as port 6  and force link */
 	gsw_w32(ops, (GSWT_PHY_ADDR_1_ADDR_OFFSET + GSW30_TOP_OFFSET),
 		GSWT_PHY_ADDR_1_ADDR_SHIFT,GSWT_PHY_ADDR_1_ADDR_SIZE, PORT_NUM);
 	gsw_w32(ops, (GSWT_PHY_ADDR_1_FCONRX_OFFSET + GSW30_TOP_OFFSET),
-		GSWT_PHY_ADDR_1_FCONRX_SHIFT,GSWT_PHY_ADDR_1_FCONRX_SIZE, 0);
+		GSWT_PHY_ADDR_1_FCONRX_SHIFT,GSWT_PHY_ADDR_1_FCONRX_SIZE, 0x1);
 	gsw_w32(ops, (GSWT_PHY_ADDR_1_FCONTX_OFFSET + GSW30_TOP_OFFSET),
-		GSWT_PHY_ADDR_1_FCONTX_SHIFT,GSWT_PHY_ADDR_1_FCONTX_SIZE, 0);
+		GSWT_PHY_ADDR_1_FCONTX_SHIFT,GSWT_PHY_ADDR_1_FCONTX_SIZE, 0x3);
 	gsw_w32(ops, (GSWT_PHY_ADDR_1_FDUP_OFFSET + GSW30_TOP_OFFSET),
-		GSWT_PHY_ADDR_1_FDUP_SHIFT,GSWT_PHY_ADDR_1_FDUP_SIZE, 0);
+		GSWT_PHY_ADDR_1_FDUP_SHIFT,GSWT_PHY_ADDR_1_FDUP_SIZE, 0x1);
 	gsw_w32(ops, (GSWT_PHY_ADDR_1_SPEED_OFFSET + GSW30_TOP_OFFSET),
-		GSWT_PHY_ADDR_1_SPEED_SHIFT,GSWT_PHY_ADDR_1_SPEED_SIZE, 0x3);
+		GSWT_PHY_ADDR_1_SPEED_SHIFT,GSWT_PHY_ADDR_1_SPEED_SIZE, 0x2);
 	gsw_w32(ops, (GSWT_PHY_ADDR_1_LNKST_OFFSET + GSW30_TOP_OFFSET),
-		GSWT_PHY_ADDR_1_LNKST_SHIFT,GSWT_PHY_ADDR_1_LNKST_SIZE, 0);
+		GSWT_PHY_ADDR_1_LNKST_SHIFT,GSWT_PHY_ADDR_1_LNKST_SIZE, 0x1);
+	/* disable auto polling */
+	gsw_w32(ops, (GSWT_MDCCFG_0_PEN_1_OFFSET + GSW30_TOP_OFFSET),
+		GSWT_MDCCFG_0_PEN_1_SHIFT,GSWT_MDCCFG_0_PEN_1_SIZE, 0x0);
 
 	ops = gsw_get_swcore_ops(LTQ_FLOW_DEV_INT);
 	/* enable port 6 MDC GSWIP-L */
@@ -12456,7 +12461,7 @@ GSW_return_t GSW_HW_Init(void *cdev, GSW_HW_Init_t *parm)
 	u32 j = 0;
 	u32 ret = 0;
 
-	if (gswdev == NULL) {
+	if (gswdev == NULL || gswdev->hwinit == 1) {
 		pr_err("%s:%s:%d", __FILE__, __func__, __LINE__);
 		return GSW_statusErr;
 	}
@@ -12471,107 +12476,115 @@ GSW_return_t GSW_HW_Init(void *cdev, GSW_HW_Init_t *parm)
 #ifdef __KERNEL__
 	spin_lock_bh(&gswdev->lock_pce);
 #endif
-
 	if (gswdev->gsw_dev == LTQ_FLOW_DEV_EXT_AX3000_F24S) {
 		get_gsw_hw_cap(cdev);
 		/* Software Table Init */
 		ltq_ethsw_port_cfg_init(cdev);
 		/* HW Init */
 		gsw_pmicro_code_init_f24s(cdev);
-		/*hardcoded setting for LTQ_FLOW_DEV_EXT_AX3000_F24S*/
-		ret = GSW_statusOk;
-	} else {
-
-		/* Reset the Switch via Switch IP register*/
-		j = 1;
-		gsw_w32(cdev, ETHSW_SWRES_R0_OFFSET,
-			ETHSW_SWRES_R0_SHIFT, ETHSW_SWRES_R0_SIZE, j);
+#ifdef __KERNEL__
+		spin_unlock_bh(&gswdev->lock_pce);
+#endif
+		/* Switch Core 2.2 and lower*/
+		mdio_init_gswip2_2(cdev);
 
-		do {
-//		udelay(100);
-			gsw_r32(cdev, ETHSW_SWRES_R0_OFFSET,
-				ETHSW_SWRES_R0_SHIFT, ETHSW_SWRES_R0_SIZE, &j);
-		} while (j);
+		/* EEE auto negotiation overides:  */
+		/*clock disable (ANEG_EEE_0.CLK_STOP_CAPABLE)  */
+		for (j = 0; j < gswdev->pnum - 1; j++) {
+			gsw_w32(cdev,
+				((ANEG_EEE_0_CLK_STOP_CAPABLE_OFFSET + j + 1)
+				 + GSW_TREG_OFFSET),
+				ANEG_EEE_0_CLK_STOP_CAPABLE_SHIFT,
+				ANEG_EEE_0_CLK_STOP_CAPABLE_SIZE, 0x3);
+		}
+		gswdev->hwinit = 1;
+		/*hardcoded setting for LTQ_FLOW_DEV_EXT_AX3000_F24S*/
+		return GSW_statusOk;
+	}
+	/* Reset the Switch via Switch IP register*/
+	j = 1;
+	gsw_w32(cdev, ETHSW_SWRES_R0_OFFSET,
+		ETHSW_SWRES_R0_SHIFT, ETHSW_SWRES_R0_SIZE, j);
+	do {
+		gsw_r32(cdev, ETHSW_SWRES_R0_OFFSET,
+			ETHSW_SWRES_R0_SHIFT, ETHSW_SWRES_R0_SIZE, &j);
+	} while (j);
 
 #if defined(CONFIG_USE_EMULATOR) && CONFIG_USE_EMULATOR
-
-		if (gswdev->gipver == LTQ_GSWIP_3_0) {
-			/* Set Auto-Polling of connected PHYs - For all ports */
-			gsw_w32(cdev, (GSWT_MDCCFG_0_PEN_1_OFFSET
-				       + GSW30_TOP_OFFSET),
-				GSWT_MDCCFG_0_PEN_1_SHIFT, 6, 0x0);
-		} else {
-			/* Set Auto-Polling of connected PHYs - For all ports */
-			gsw_w32(cdev, (MDC_CFG_0_PEN_0_OFFSET
-				       + GSW_TREG_OFFSET),
-				MDC_CFG_0_PEN_0_SHIFT, 6, 0x0);
-		}
+	if (gswdev->gipver == LTQ_GSWIP_3_0) {
+		/* Set Auto-Polling of connected PHYs - For all ports */
+		gsw_w32(cdev, (GSWT_MDCCFG_0_PEN_1_OFFSET
+			       + GSW30_TOP_OFFSET),
+			GSWT_MDCCFG_0_PEN_1_SHIFT, 6, 0x0);
+	} else {
+		/* Set Auto-Polling of connected PHYs - For all ports */
+		gsw_w32(cdev, (MDC_CFG_0_PEN_0_OFFSET
+			       + GSW_TREG_OFFSET),
+			MDC_CFG_0_PEN_0_SHIFT, 6, 0x0);
+	}
 
 #else
 
-		if (gswdev->gipver == LTQ_GSWIP_3_0) {
-			if (gswdev->sdev == LTQ_FLOW_DEV_INT_R) {
+	if (gswdev->gipver == LTQ_GSWIP_3_0) {
+		if (gswdev->sdev == LTQ_FLOW_DEV_INT_R) {
 #ifdef __KERNEL__
-				gsw_r_init();
+			gsw_r_init();
 #endif
-				gsw_w32(cdev, (GSWT_MDCCFG_0_PEN_1_OFFSET + GSW30_TOP_OFFSET),
-					GSWT_MDCCFG_0_PEN_1_SHIFT, 6, 0x1);
-			} else {
-				gsw_w32(cdev, (GSWT_MDCCFG_0_PEN_1_OFFSET + GSW30_TOP_OFFSET),
-					GSWT_MDCCFG_0_PEN_1_SHIFT, 6, 0x1e);
-			}
+			gsw_w32(cdev, (GSWT_MDCCFG_0_PEN_1_OFFSET + GSW30_TOP_OFFSET),
+				GSWT_MDCCFG_0_PEN_1_SHIFT, 6, 0x1);
+		} else {
+			gsw_w32(cdev, (GSWT_MDCCFG_0_PEN_1_OFFSET + GSW30_TOP_OFFSET),
+				GSWT_MDCCFG_0_PEN_1_SHIFT, 6, 0x1e);
 		}
+	}
 
 #endif  /* CONFIG_USE_EMULATOR */
-		/*	platform_device_init(cdev); */
-		gswdev->hwinit = 1;
-		/*	get_gsw_hw_cap (cdev); */
-		/* Software Table Init */
+	/*	platform_device_init(cdev); */
+	gswdev->hwinit = 1;
+	/*	get_gsw_hw_cap (cdev); */
+	/* Software Table Init */
 #if defined(CONFIG_LTQ_VLAN) && CONFIG_LTQ_VLAN
-		reset_vlan_sw_table(cdev);
+	reset_vlan_sw_table(cdev);
 #endif /*CONFIG_LTQ_VLAN */
-		ltq_ethsw_port_cfg_init(cdev);
+	ltq_ethsw_port_cfg_init(cdev);
 #if defined(CONFIG_LTQ_MULTICAST) && CONFIG_LTQ_MULTICAST
-		reset_multicast_sw_table(cdev);
+	reset_multicast_sw_table(cdev);
 #endif /*CONFIG_LTQ_MULTICAST*/
-		pce_table_init(&gswdev->phandler);
-		/* HW Init */
-		gsw_pmicro_code_init(cdev);
+	pce_table_init(&gswdev->phandler);
+	/* HW Init */
+	gsw_pmicro_code_init(cdev);
 
-		if (gswdev->gipver == LTQ_GSWIP_3_0) {
-			if (gswdev->sdev == LTQ_FLOW_DEV_INT_R) {
-				/*suresh*/
-				//			rt_table_init();
-				gsw_w32(cdev, PCE_TFCR_NUM_NUM_OFFSET, PCE_TFCR_NUM_NUM_SHIFT,
-					PCE_TFCR_NUM_NUM_SIZE, 0x80);
-			}
-
-			/* EEE auto negotiation overides:*/
-			/*  clock disable (ANEG_EEE_0.CLK_STOP_CAPABLE)  */
-			for (j = 0; j < gswdev->pnum - 1; j++) {
-				gsw_w32(cdev,
-					((GSWT_ANEG_EEE_1_CLK_STOP_CAPABLE_OFFSET
-					  + (4 * j)) + GSW30_TOP_OFFSET),
-					GSWT_ANEG_EEE_1_CLK_STOP_CAPABLE_SHIFT,
-					GSWT_ANEG_EEE_1_CLK_STOP_CAPABLE_SIZE, 0x3);
-			}
-		} else {
-			/* Configure the MDIO Clock 97.6 Khz */
-			gsw_w32(cdev, (MDC_CFG_1_FREQ_OFFSET + GSW_TREG_OFFSET),
-				MDC_CFG_1_FREQ_SHIFT,
-				MDC_CFG_1_FREQ_SIZE, 0xFF);
+	if (gswdev->gipver == LTQ_GSWIP_3_0) {
+		if (gswdev->sdev == LTQ_FLOW_DEV_INT_R) {
+			gsw_w32(cdev, PCE_TFCR_NUM_NUM_OFFSET, PCE_TFCR_NUM_NUM_SHIFT,
+				PCE_TFCR_NUM_NUM_SIZE, 0x80);
+		}
 
-			for (j = 0; j < gswdev->pnum - 1; j++) {
-				gsw_w32(cdev, ((ANEG_EEE_0_CLK_STOP_CAPABLE_OFFSET + j)
-					       + GSW_TREG_OFFSET),
-					ANEG_EEE_0_CLK_STOP_CAPABLE_SHIFT,
-					ANEG_EEE_0_CLK_STOP_CAPABLE_SIZE, 0x3);
-			}
+		/* EEE auto negotiation overides:*/
+		/*  clock disable (ANEG_EEE_0.CLK_STOP_CAPABLE)  */
+		for (j = 0; j < gswdev->pnum - 1; j++) {
+			gsw_w32(cdev,
+				((GSWT_ANEG_EEE_1_CLK_STOP_CAPABLE_OFFSET
+				  + (4 * j)) + GSW30_TOP_OFFSET),
+				GSWT_ANEG_EEE_1_CLK_STOP_CAPABLE_SHIFT,
+				GSWT_ANEG_EEE_1_CLK_STOP_CAPABLE_SIZE, 0x3);
 		}
+	} else {
+		/* Configure the MDIO Clock 97.6 Khz */
+		gsw_w32(cdev, (MDC_CFG_1_FREQ_OFFSET + GSW_TREG_OFFSET),
+			MDC_CFG_1_FREQ_SHIFT,
+			MDC_CFG_1_FREQ_SIZE, 0xFF);
 
-		ret = GSW_statusOk;
+		for (j = 0; j < gswdev->pnum - 1; j++) {
+			gsw_w32(cdev, ((ANEG_EEE_0_CLK_STOP_CAPABLE_OFFSET + j)
+				       + GSW_TREG_OFFSET),
+				ANEG_EEE_0_CLK_STOP_CAPABLE_SHIFT,
+				ANEG_EEE_0_CLK_STOP_CAPABLE_SIZE, 0x3);
+		}
 	}
 
+	ret = GSW_statusOk;
+
 #ifdef __KERNEL__
 	spin_unlock_bh(&gswdev->lock_pce);
 #endif
diff --git a/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.h b/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.h
index 4966d2a46495..2619a6a47fc9 100644
--- a/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.h
+++ b/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.h
@@ -1044,8 +1044,6 @@ typedef struct {
 
 
 
-int gsw_pmicro_code_init_f24s(void *cdev);
-
 u8 find_active_vlan_index(void *cdev, u16 vid);
 int find_msb_tbl_entry(pcetbl_prog_t *ptbl,
 		       pce_dasa_msb_t *parm);
diff --git a/drivers/net/ethernet/lantiq/switch-api/gsw_init.c b/drivers/net/ethernet/lantiq/switch-api/gsw_init.c
index 3a9cc1f7d65f..58609bdbfa03 100644
--- a/drivers/net/ethernet/lantiq/switch-api/gsw_init.c
+++ b/drivers/net/ethernet/lantiq/switch-api/gsw_init.c
@@ -1050,6 +1050,7 @@ int ltq_gsw_api_register(struct platform_device *pdev)
 		prvdata->cport = GSW_2X_SOC_CPU_PORT;
 		prvdata->gsw_dev = LTQ_FLOW_DEV_EXT_AX3000_F24S;
 		prvdata->parent_devid = LTQ_FLOW_DEV_INT_R;
+		grx550_misc_config(prvdata);
 
 		/* Init External Switch Core Layer */
 		core_init.sdev = LTQ_FLOW_DEV_EXT_AX3000_F24S;
diff --git a/drivers/net/ethernet/lantiq/switch-api/gsw_init.h b/drivers/net/ethernet/lantiq/switch-api/gsw_init.h
index b683f45fe6c4..f2b96d64775c 100644
--- a/drivers/net/ethernet/lantiq/switch-api/gsw_init.h
+++ b/drivers/net/ethernet/lantiq/switch-api/gsw_init.h
@@ -176,6 +176,7 @@ void gsw_w32(void *cdev, short offset, short shift, short size, u32 value);
 void *ethsw_api_core_init(ethsw_core_init_t *pinit);
 void gsw_corecleanup(void);
 int	gsw_pmicro_code_init(void *cdev);
+int	gsw_pmicro_code_init_f24s(void *cdev);
 int gsw_swapi_init(void);
 
 #if defined(WIN_PC_MODE) && WIN_PC_MODE
@@ -196,6 +197,7 @@ void gsw_w32_raw(void *cdev, short offset, u32 value);
 void gsw_ext_r32(void *cdev, short offset, short shift, short size, u32 *value);
 void gsw_ext_w32(void *cdev, short offset, short shift, short size, u32 value);
 int gsw_mdio_alloc(struct platform_device *pdev);
+void grx550_misc_config(ethsw_api_dev_t *gswdev);
 #endif
 
 static inline u32 gsw_field_r32(u32 rval, short shift, short size)
