From 8725cd743ed4f99f489ae16c9878ffb205ef6238 Mon Sep 17 00:00:00 2001
From: "Langer, Thomas" <thomas.langer@intel.com>
Date: Fri, 10 Jan 2020 19:45:27 +0100
Subject: [PATCH] PONRTSYS-6161: Add option LTQ_EVA_LOAD_ADDR

to cleanup the code in arch/mips/lantiq/platform and
make it possible to change it via config file.
---
 arch/mips/Kconfig         | 10 ++++++++++
 arch/mips/lantiq/Platform | 31 ++++++++++---------------------
 2 files changed, 20 insertions(+), 21 deletions(-)

diff --git a/arch/mips/Kconfig b/arch/mips/Kconfig
index 11ba3523ec6f..c287b55bf1ca 100755
--- a/arch/mips/Kconfig
+++ b/arch/mips/Kconfig
@@ -1780,6 +1780,16 @@ config LTQ_EVA_LEGACY
 	help
 	  Choose this for EVA legacy(512MB) support
 
+config LTQ_EVA_LOAD_ADDR
+	hex "EVA load address"
+	depends on CPU_MIPS32_3_5_EVA
+	depends on SOC_GRX500
+	default 0xffffffff20020000 if LTQ_EVA_2GB
+	default 0xffffffff60020000 if LTQ_EVA_1GB
+	default 0xffffffff80020000
+	help
+	  Define the kernel load address for LTQ EVA modes.
+
 config CPU_MIPS32_R5_FEATURES
 	bool "MIPS32 Release 5 Features"
 	depends on SYS_HAS_CPU_MIPS32_R5
diff --git a/arch/mips/lantiq/Platform b/arch/mips/lantiq/Platform
index f4c09e967d5c..63848bbbc38e 100755
--- a/arch/mips/lantiq/Platform
+++ b/arch/mips/lantiq/Platform
@@ -4,27 +4,16 @@
 
 platform-$(CONFIG_LANTIQ)	+= lantiq/
 cflags-$(CONFIG_LANTIQ)		+= -I$(srctree)/arch/mips/include/asm/mach-lantiq
-ifdef CONFIG_EVA
-	ifdef CONFIG_LTQ_EVA_2GB
-	load-$(CONFIG_LANTIQ)		= 0xffffffff20020000
-	endif
-	ifdef CONFIG_LTQ_EVA_1GB
-	load-$(CONFIG_LANTIQ)		= 0xffffffff60020000
-	endif
-	ifdef CONFIG_LTQ_EVA_LEGACY
-	load-$(CONFIG_LANTIQ)   = 0xffffffff80020000
-	endif
-else
-	ifdef CONFIG_SOC_TYPE_GRX500_TEP
-		ifdef CONFIG_BOOTCORE_LOAD_ADDR
-			load-$(CONFIG_LANTIQ)           = $(CONFIG_BOOTCORE_LOAD_ADDR)
-		else
-			load-$(CONFIG_LANTIQ)           = 0xffffffff88000000
-		endif
-	else
-		load-$(CONFIG_LANTIQ)   = 0xffffffff80020000
-	endif
-endif
+
+# default load address
+load-$(CONFIG_LANTIQ)			= 0xffffffff80020000
+
+# if specific settings are enabled, they will overwrite the default setting:
+# load addresses for EVA mode
+load-$(CONFIG_EVA)			= $(CONFIG_LTQ_EVA_LOAD_ADDR)
+# load address for bootcore
+load-$(CONFIG_SOC_TYPE_GRX500_TEP)	= $(CONFIG_BOOTCORE_LOAD_ADDR)
+
 cflags-$(CONFIG_SOC_TYPE_XWAY)	+= -I$(srctree)/arch/mips/include/asm/mach-lantiq/xway
 cflags-$(CONFIG_SOC_FALCON)	+= -I$(srctree)/arch/mips/include/asm/mach-lantiq/falcon
 cflags-$(CONFIG_SOC_GRX500)     += -I$(srctree)/arch/mips/include/asm/mach-lantiq/grx500
