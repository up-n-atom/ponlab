From e24c0b8190e8ce0baf969b84993f6e000ef35f73 Mon Sep 17 00:00:00 2001
From: Dinesh Sudham <dineshx.sudham@intel.com>
Date: Wed, 8 Jan 2020 15:40:56 +0800
Subject: [PATCH] DRVLIB_SW-3310: XPCS: Fix for dereference pointer klockwork
 warnings

---
 drivers/net/ethernet/lantiq/xpcs/xpcs.c | 47 ++++++++++++++++++---------------
 1 file changed, 26 insertions(+), 21 deletions(-)

diff --git a/drivers/net/ethernet/lantiq/xpcs/xpcs.c b/drivers/net/ethernet/lantiq/xpcs/xpcs.c
index efcf4f1fe23d..bcc94bab1b03 100644
--- a/drivers/net/ethernet/lantiq/xpcs/xpcs.c
+++ b/drivers/net/ethernet/lantiq/xpcs/xpcs.c
@@ -905,7 +905,10 @@ static int xpcs_init(struct xpcs_prv_data *pdata)
 	pdata->pcs_mode = BACKPL_ETH_PCS;
 
 	pdata->mode_cfg = xpcs_get_cfg(pdata->mode);
-
+	if (!pdata->mode_cfg) {
+		dev_err(pdata->dev, "XPCS Init: Invalid Mode!\n");
+		return -EINVAL;
+	}
 	ret = pdata->mode_cfg->set_mode(pdata);
 
 	if (ret != XPCS_SUCCESS)
@@ -1020,16 +1023,18 @@ static int xpcs_reset(struct device *dev)
 
 static int xpcs_power_off(struct device *dev)
 {
-	struct xpcs_prv_data *pdata = dev_get_drvdata(dev);
-	struct phy *phy = pdata->phy;
-
-	dev_dbg(dev, "%s: %s\n", __func__, pdata->name);
+	struct xpcs_prv_data *pdata;
+	struct phy *phy;
 
-	if (!dev || !phy) {
-		dev_err(dev, "XPCS Power Off: Cannot get phy or dev\n");
+	if (!dev)
+		return -ENODEV;
+	dev_dbg(dev, "%s\n", __func__);
+	pdata = dev_get_drvdata(dev);
+	phy = pdata->phy;
+	if (!phy) {
+		dev_err(dev, "XPCS Power Off: Cannot get phy!\n");
 		return -EINVAL;
 	}
-
 	if (!pdata->state)
 		return 0;
 
@@ -1049,17 +1054,19 @@ static int xpcs_power_off(struct device *dev)
 
 static int xpcs_power_on(struct device *dev)
 {
-	struct xpcs_prv_data *pdata = dev_get_drvdata(dev);
-	struct phy *phy = pdata->phy;
+	struct xpcs_prv_data *pdata;
+	struct phy *phy;
 	int ret = 0;
 
-	dev_dbg(dev, "%s: %s\n", __func__, pdata->name);
-
-	if (!dev || !phy) {
-		dev_err(dev, "XPCS Power On: Cannot get phy or dev\n");
+	if (!dev)
+		return -ENODEV;
+	dev_dbg(dev, "%s\n", __func__);
+	pdata = dev_get_drvdata(dev);
+	phy = pdata->phy;
+	if (!phy) {
+		dev_err(dev, "XPCS Power On: Cannot get phy!\n");
 		return -EINVAL;
 	}
-
 	if (pdata->state)
 		return 0;
 
@@ -1094,14 +1101,12 @@ static int xpcs_power_on(struct device *dev)
 
 static int xpcs_reinit(struct device *dev, u32 mode)
 {
-	struct xpcs_prv_data *pdata = dev_get_drvdata(dev);
+	struct xpcs_prv_data *pdata;
 	int ret;
 
-	if (!dev) {
-		dev_err(dev, "XPCS Reinit: Cannot get phy or dev\n");
-		return -EINVAL;
-	}
-
+	if (!dev)
+		return -ENODEV;
+	pdata = dev_get_drvdata(dev);
 	ret = xpcs_power_off(dev);
 	if (ret)
 		return ret;
