From 384252774f8bd24c8a78e6a5791e8ba5a62c256c Mon Sep 17 00:00:00 2001
From: kavitha3 <k.subramanian@intel.com>
Date: Fri, 3 Jan 2020 17:59:20 +0800
Subject: [PATCH] DRVLIB_SW-3149: Configure per channel polling interval for
 DMA1TX

---
 drivers/net/ethernet/lantiq/cqm/prx300/cqm.c | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/drivers/net/ethernet/lantiq/cqm/prx300/cqm.c b/drivers/net/ethernet/lantiq/cqm/prx300/cqm.c
index f0177e8e6ea4..fbe87281b1f8 100644
--- a/drivers/net/ethernet/lantiq/cqm/prx300/cqm.c
+++ b/drivers/net/ethernet/lantiq/cqm/prx300/cqm.c
@@ -2323,7 +2323,7 @@ static int fill_rx_ring_data(struct cbm_dp_alloc_complete_data *dp_data)
 				__func__);
 			break;
 		}
-
+		ltq_dma_chan_polling_cfg(p_info->dma_ch, 10, 10);
 		p_info->dma_ch_in_use = true;
 		dp_data->rx_ring[ring_idx].out_dma_ch_to_gswip = p_info->dma_ch;
 		dp_data->rx_ring[ring_idx].num_out_tx_dma_ch =
@@ -3655,6 +3655,8 @@ static void init_cqm_enq_cpu_port(int idx)
 static s32 setup_DMA_channel(int chan, int cqm_port, dma_addr_t desc_base,
 			     int buf_type, int desc_num, char *dev_id)
 {
+	int ctrl;
+
 	if (ltq_request_dma(chan, dev_id) < 0) {
 		dev_err(cqm_ctrl->dev, "%s failed to open chan for chan%d\r\n",
 			__func__, chan);
@@ -3671,6 +3673,9 @@ static s32 setup_DMA_channel(int chan, int cqm_port, dma_addr_t desc_base,
 			__func__, chan);
 		return CBM_FAILURE;
 	}
+	ctrl = _DMA_CONTROLLER(chan);
+	if (ctrl == DMA1TX)
+		ltq_dma_chan_polling_cfg(chan, 10, 10);
 	/* Channel on */
 	if (ltq_dma_chan_on(chan) < 0) {
 		dev_err(cqm_ctrl->dev, " %s failed to ON chan%d\r\n",
