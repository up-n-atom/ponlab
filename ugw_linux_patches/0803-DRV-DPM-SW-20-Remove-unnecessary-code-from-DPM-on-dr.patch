From f59af798c549a11fbc2fc012188ef26b8e813848 Mon Sep 17 00:00:00 2001
From: Gu Chao <gux.chao@intel.com>
Date: Fri, 30 Aug 2019 18:08:04 +0800
Subject: [PATCH] DRV_DPM_SW-20: Remove unnecessary code from DPM on driver
 registration and device tree support

---
 drivers/net/datapath/dpm/Makefile                  |  2 +-
 drivers/net/datapath/dpm/datapath_api.c            | 27 +++++++---
 drivers/net/datapath/dpm/datapath_platform_dev.c   | 63 ----------------------
 .../net/datapath/dpm/gswip31/datapath_ppv4_api.c   |  4 +-
 4 files changed, 22 insertions(+), 74 deletions(-)

diff --git a/drivers/net/datapath/dpm/Makefile b/drivers/net/datapath/dpm/Makefile
index 9ade1af5f09c..309120d105dd 100644
--- a/drivers/net/datapath/dpm/Makefile
+++ b/drivers/net/datapath/dpm/Makefile
@@ -1,4 +1,4 @@
-obj-$(CONFIG_INTEL_DATAPATH) = datapath_api.o datapath_proc_api.o datapath_proc.o  datapath_misc.o datapath_notifier.o datapath_logical_dev.o datapath_instance.o datapath_platform_dev.o datapath_soc.o datapath_qos.o datapath_proc_qos.o datapath_tx.o
+obj-$(CONFIG_INTEL_DATAPATH) = datapath_api.o datapath_proc_api.o datapath_proc.o  datapath_misc.o datapath_notifier.o datapath_logical_dev.o datapath_instance.o datapath_soc.o datapath_qos.o datapath_proc_qos.o datapath_tx.o
 
 ifneq ($(CONFIG_INTEL_DATAPATH_HAL_GSWIP32),)
 obj-$(CONFIG_INTEL_DATAPATH) += gswip32/
diff --git a/drivers/net/datapath/dpm/datapath_api.c b/drivers/net/datapath/dpm/datapath_api.c
index f9a2b6822953..3e2bb5f70ee7 100644
--- a/drivers/net/datapath/dpm/datapath_api.c
+++ b/drivers/net/datapath/dpm/datapath_api.c
@@ -623,12 +623,10 @@ int32_t dp_register_subif_private(int inst, struct module *owner,
 		sif->deq_port_idx = data->deq_port_idx;
 
 		if (subif_id->subif < 0) /*dynamic:shift bits as HW defined*/
-			sif->subif =
-				SET_VAP(i, port_info->vap_offset,
-					port_info->vap_mask);
+			sif->subif = SET_VAP(i, port_info->vap_offset,
+					     port_info->vap_mask);
 		else /*provided by caller since it is alerady shifted properly*/
-			sif->subif =
-			    subif_id->subif;
+			sif->subif = subif_id->subif;
 		strncpy(sif->device_name,
 			subif_name, sizeof(sif->device_name) - 1);
 		sif->subif_flag = flags;
@@ -727,7 +725,7 @@ int32_t dp_deregister_subif_private(int inst, struct module *owner,
 				    uint32_t flags)
 {
 	int res = DP_FAILURE;
-	int i, j, port_id, cqm_port, bp;
+	int i, j, port_id, cqm_port = 0, bp;
 	u8 find = 0;
 	struct pmac_port_info *port_info;
 	struct cbm_dp_en_data cbm_data = {0};
@@ -883,7 +881,7 @@ int32_t dp_alloc_port_ext(int inst, struct module *owner,
 		DP_LIB_LOCK(&dp_lock);
 		if (!try_walkaround) {
 			try_walkaround = 1;
-			dp_probe(NULL); /*workaround to re-init */
+			dp_init_module();
 		}
 		DP_LIB_UNLOCK(&dp_lock);
 		if (!dp_init_ok) {
@@ -2462,7 +2460,15 @@ int dp_get_mtu_size(struct net_device *dev, u32 *mtu_size)
 }
 EXPORT_SYMBOL(dp_get_mtu_size);
 
-MODULE_LICENSE("GPL");
+static int __init dp_init(void)
+{
+	return dp_basic_proc();
+}
+
+static void __exit dp_exit(void)
+{
+	dp_cleanup_module();
+}
 
 static int __init dp_dbg_lvl_set(char *str)
 {
@@ -2474,3 +2480,8 @@ static int __init dp_dbg_lvl_set(char *str)
 
 early_param("dp_dbg", dp_dbg_lvl_set);
 
+module_init(dp_init);
+module_exit(dp_exit);
+
+MODULE_LICENSE("GPL");
+
diff --git a/drivers/net/datapath/dpm/datapath_platform_dev.c b/drivers/net/datapath/dpm/datapath_platform_dev.c
deleted file mode 100644
index 6c053b9daab8..000000000000
--- a/drivers/net/datapath/dpm/datapath_platform_dev.c
+++ /dev/null
@@ -1,63 +0,0 @@
-/*
- * Copyright (C) Intel Corporation
- * Author: Shao Guohua <guohua.shao@intel.com>
- *
- * This program is free software; you can redistribute it and/or modify it
- * under the terms of the GNU General Public License version 2 as published
- * by the Free Software Foundation.
- */
-
-#include<linux/init.h>
-#include<linux/module.h>
-#include <linux/platform_device.h>
-#include <linux/of_address.h>
-#include <net/datapath_api.h>
-#include "datapath.h"
-
-int dp_probe(struct platform_device *pdev)
-{
-	if (pdev) {
-		/*Note: if pdev NULL, it means no device tree support and
-		 *datapath lib use non-standard way to call it.
-		 *Datapath Device tree example:
-		 * datapath {
-		 *			 compatible = "lantiq,datapath-lib";
-		 *			 a-cell-property = <1 2 3 4>;
-		 *		 };
-		 *struct device_node *node = pdev->dev.of_node;
-		 *platform_get_resource(pdev, IORESOURCE_MEM, i)
-		 *of_irq_to_resource_table(node, irqres, CBM_NUM_INTERRUPTS);
-		 */
-	}
-	return dp_init_module();
-}
-
-static int dp_release(struct platform_device *pdev)
-{
-	dp_cleanup_module();
-	return 0;
-}
-
-static const struct of_device_id dp_match[] = {
-	{.compatible = "lantiq,datapath-lib", },
-	{},
-};
-
-struct platform_driver dp_driver = {
-	.probe = dp_probe,
-	.remove = dp_release,
-	.driver = {
-			.name = "dp-lib",
-			.owner = THIS_MODULE,
-			.of_match_table = dp_match,
-		},
-};
-
-int __init dp_init(void)
-{
-	dp_basic_proc();
-	return platform_driver_register(&dp_driver);
-}
-
-module_init(dp_init);
-
diff --git a/drivers/net/datapath/dpm/gswip31/datapath_ppv4_api.c b/drivers/net/datapath/dpm/gswip31/datapath_ppv4_api.c
index e852c9cd584c..a74eb4516ba0 100644
--- a/drivers/net/datapath/dpm/gswip31/datapath_ppv4_api.c
+++ b/drivers/net/datapath/dpm/gswip31/datapath_ppv4_api.c
@@ -4542,7 +4542,7 @@ int dp_q_reserve_continuous(int inst, int ep, struct dp_dev_data *data,
 	int i;
 	unsigned int id = 0, qid = 0;
 	int len, curr_num = 0, curr_off = 0;
-	struct resv_q *resv_q, *tmp_resv_q;
+	struct resv_q *resv_q = NULL, *tmp_resv_q;
 	struct hal_priv *priv = HAL(inst);
 	int res = DP_SUCCESS;
 
@@ -4634,7 +4634,7 @@ int dp_node_reserve(int inst, int ep, struct dp_dev_data *data, int flags)
 	unsigned int id;
 	struct pp_qos_queue_info info;
 	int len;
-	struct resv_q *resv_q;
+	struct resv_q *resv_q = NULL;
 #ifdef WORKAROUND_DROP_PORT
 	struct pp_qos_queue_conf q_conf;
 #endif
