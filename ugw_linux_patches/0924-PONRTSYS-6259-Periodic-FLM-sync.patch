From 6e3a31deac312020abc6975d7501d5024e0926b4 Mon Sep 17 00:00:00 2001
From: ofirbitt <ofir1.bitton@intel.com>
Date: Sun, 15 Dec 2019 14:48:50 +0200
Subject: [PATCH] PONRTSYS-6259: Periodic FLM sync

---
 drivers/net/ppv4/pp-dev/pp_dev.c        |  4 ++++
 drivers/net/ppv4/pp-dev/pp_dts.c        | 14 +++++++-------
 drivers/net/ppv4/pp-headers/pp_common.h |  9 +++++----
 3 files changed, 16 insertions(+), 11 deletions(-)

diff --git a/drivers/net/ppv4/pp-dev/pp_dev.c b/drivers/net/ppv4/pp-dev/pp_dev.c
index 2bf046635ab9..6986afa749c2 100644
--- a/drivers/net/ppv4/pp-dev/pp_dev.c
+++ b/drivers/net/ppv4/pp-dev/pp_dev.c
@@ -690,5 +690,9 @@ MODULE_AUTHOR("Intel Corporation");
 MODULE_DESCRIPTION(DRV_NAME);
 MODULE_LICENSE("GPL");
 MODULE_VERSION(DRV_VERSION);
+#ifdef CONFIG_PHY_INTEL_COMBO_LGM
 device_initcall(__pp_dev_init);
+#else
+arch_initcall(__pp_dev_init);
+#endif
 module_exit(__pp_dev_exit);
diff --git a/drivers/net/ppv4/pp-dev/pp_dts.c b/drivers/net/ppv4/pp-dev/pp_dts.c
index b8bf933f4738..b948ec69663d 100644
--- a/drivers/net/ppv4/pp-dev/pp_dts.c
+++ b/drivers/net/ppv4/pp-dev/pp_dts.c
@@ -927,6 +927,13 @@ s32 pp_dts_cfg_get(struct platform_device *pdev, struct pp_dts_cfg *cfg)
 		cfg->qos_params.num_syncqs  = val;
 	}
 
+	/* Fetch fragmentation mode */
+	ret = __dts_u32_param_get(pdev, pdev->dev.of_node, "frag-mode", &val);
+	if (ret)
+		cfg->smgr_params.frag_mode = SMGR_FRAG_MODE_CHECK_MTU_IN_UC;
+	else
+		cfg->smgr_params.frag_mode = (enum smgr_frag_mode)val;
+
 	/* Fetch hw clock frequency */
 	ret = __dts_u32_param_get(pdev, pdev->dev.of_node,
 				  "clock-frequency-mhz", &val);
@@ -937,13 +944,6 @@ s32 pp_dts_cfg_get(struct platform_device *pdev, struct pp_dts_cfg *cfg)
 	cfg->chk_param.hw_clk   = val;
 	cfg->misc_params.hw_clk = val;
 
-	/* Fetch fragmentation mode */
-	ret = __dts_u32_param_get(pdev, pdev->dev.of_node, "frag-mode", &val);
-	if (unlikely(ret))
-		return ret;
-	dev_dbg(&pdev->dev, "frag-mode = %d\n", val);
-	cfg->smgr_params.frag_mode = (enum smgr_frag_mode)val;
-
 	/* Fetch PPv4 base address ranges */
 	ret = of_property_read_u32_array(pdev->dev.of_node,
 					 "ranges", ranges,
diff --git a/drivers/net/ppv4/pp-headers/pp_common.h b/drivers/net/ppv4/pp-headers/pp_common.h
index 8ef31ec54360..f075f09970da 100644
--- a/drivers/net/ppv4/pp-headers/pp_common.h
+++ b/drivers/net/ppv4/pp-headers/pp_common.h
@@ -18,7 +18,8 @@
 #include <linux/errno.h>
 #include <linux/jiffies.h>
 #include <linux/delay.h>
-#ifdef CONFIG_PPV4_FPGA
+#include <linux/version.h>
+#if KERNEL_VERSION(4, 12, 0) > LINUX_VERSION_CODE
 #include <linux/vmalloc.h>
 #endif
 #include <linux/pp_api.h>
@@ -1060,7 +1061,7 @@ static inline void pp_devm_kvmalloc_release(struct device *dev, void *res)
 {
 	void *ptr = (void *)*((ulong *)res);
 
-#ifdef CONFIG_PPV4_FPGA
+#if KERNEL_VERSION(4, 12, 0) > LINUX_VERSION_CODE
 	vfree(ptr);
 #else
 	kvfree(ptr);
@@ -1106,7 +1107,7 @@ static inline void *pp_devm_kvmalloc(struct device *dev, size_t sz, gfp_t flags)
 	if (!res)
 		return NULL;
 
-#ifdef CONFIG_PPV4_FPGA
+#if KERNEL_VERSION(4, 12, 0) > LINUX_VERSION_CODE
 	if (flags & __GFP_ZERO)
 		ptr = vzalloc(sz);
 	else
@@ -1134,7 +1135,7 @@ static inline void *pp_devm_kvcalloc(struct device *dev, size_t n, size_t sz,
 {
 	size_t size;
 
-#ifdef CONFIG_PPV4_FPGA
+#if KERNEL_VERSION(4, 18, 0) > LINUX_VERSION_CODE
 	size = sz * n;
 #else
 	if (unlikely(check_mul_overflow(n, sz, &size)))
