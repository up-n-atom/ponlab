From d7e067df640d9391ecf21ec4e803000f23eff001 Mon Sep 17 00:00:00 2001
From: Rekha Eswaran <rekha.eswaran@intel.com>
Date: Wed, 16 Sep 2020 12:05:30 +0800
Subject: [PATCH] DRV_DPM_SW-381 - DPM handle DP_F_DATA_NO_LOOP for
 re-insertion feature

---
 drivers/net/datapath/dpm/gswip31/datapath_gswip.c | 3 ++-
 drivers/net/datapath/dpm/gswip31/datapath_misc.c  | 4 ++--
 2 files changed, 4 insertions(+), 3 deletions(-)

diff --git a/drivers/net/datapath/dpm/gswip31/datapath_gswip.c b/drivers/net/datapath/dpm/gswip31/datapath_gswip.c
index 02aaba3cd5e7..15ef5542a6f6 100644
--- a/drivers/net/datapath/dpm/gswip31/datapath_gswip.c
+++ b/drivers/net/datapath/dpm/gswip31/datapath_gswip.c
@@ -579,7 +579,8 @@ struct gsw_itf *ctp_port_assign(int inst, u8 ep, int bp_default,
 	itf_assign[ep].end = ctp_assign.nFirstCtpPortId +
 			     ctp_assign.nNumberOfCtpPort - 1;
 	itf_assign[ep].ep = ep;
-	port_info->subif_max = assign->num_subif;
+	port_info->subif_max =
+			assign->num_subif >= num ? assign->num_subif : num;
 	port_info->ctp_max = ctp_assign.nNumberOfCtpPort;
 
 	cap = &get_dp_prop_info(inst)->cap;
diff --git a/drivers/net/datapath/dpm/gswip31/datapath_misc.c b/drivers/net/datapath/dpm/gswip31/datapath_misc.c
index eac3601188ce..e04ae45ebf77 100644
--- a/drivers/net/datapath/dpm/gswip31/datapath_misc.c
+++ b/drivers/net/datapath/dpm/gswip31/datapath_misc.c
@@ -1404,8 +1404,8 @@ static int port_platform_set(int inst, u8 ep, struct dp_port_data *data,
 		 priv ? priv->qdev : NULL);
 	idx = port_info->deq_port_base;
 
-	/* Later enhance below with  DP_F_DATA_NO_LOOP flag */
-	if (flags & (DP_F_GPON | DP_F_EPON))
+	if ((flags & (DP_F_GPON | DP_F_EPON)) ||
+		(data->flag_ops & DP_F_DATA_NO_LOOP))
 		port_info->loop_dis = 1;
 	if (flags & DP_F_FAST_WLAN)
 		port_info->bp_hairpin_cap = 1;
