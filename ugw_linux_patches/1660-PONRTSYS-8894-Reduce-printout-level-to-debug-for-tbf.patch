From d11a93c0d6a4dcf427722d0f87d3e50f4dd71827 Mon Sep 17 00:00:00 2001
From: Cardoso Tiago <tiago.cardoso.abrahao@intel.com>
Date: Thu, 6 May 2021 18:07:14 +0200
Subject: [PATCH] PONRTSYS-8894 Reduce printout level to debug for tbf removal
 failures

Also remove some outdated comments on pon_qos
---
 drivers/net/datapath/pon_qos/pon_qos_tc_qos.c | 3 +--
 drivers/net/datapath/pon_qos/pon_qos_tc_tbf.c | 8 ++++++--
 2 files changed, 7 insertions(+), 4 deletions(-)

diff --git a/drivers/net/datapath/pon_qos/pon_qos_tc_qos.c b/drivers/net/datapath/pon_qos/pon_qos_tc_qos.c
index cd88e40744e4..c20f46170e05 100644
--- a/drivers/net/datapath/pon_qos/pon_qos_tc_qos.c
+++ b/drivers/net/datapath/pon_qos/pon_qos_tc_qos.c
@@ -238,7 +238,6 @@ int pon_qos_get_queue_by_handle(struct net_device *dev,
 	return 0;
 }
 
-/* TODO: proper error handling */
 int pon_qos_add_sched(struct pon_qos_qdisc *sch, int prio)
 {
 	struct dp_node_link node = {0};
@@ -674,7 +673,7 @@ int pon_qos_queue_del(struct pon_qos_qdisc *sch, int idx)
 
 	anode.type = DP_NODE_QUEUE;
 	anode.id.q_id = sch->qids[idx].qid;
-	if (!anode.id.q_id /*|| atomic_read(&sch->qids[idx].ref_cnt)*/)
+	if (!anode.id.q_id)
 		return -EINVAL;
 
 	ret = dp_node_free(&anode, DP_NODE_AUTO_FREE_RES);
diff --git a/drivers/net/datapath/pon_qos/pon_qos_tc_tbf.c b/drivers/net/datapath/pon_qos/pon_qos_tc_tbf.c
index fdaafdf3e152..7ae2bd5c5b8e 100644
--- a/drivers/net/datapath/pon_qos/pon_qos_tc_tbf.c
+++ b/drivers/net/datapath/pon_qos/pon_qos_tc_tbf.c
@@ -105,7 +105,10 @@ static int pon_qos_tc_tbf_destroy(struct net_device *dev,
 
 	port = pon_qos_port_get(dev);
 	if (!port) {
-		netdev_err(dev, "tc-tbf port get failed\n");
+		/* Linux deletes some qdiscs from root to the leaf node
+		 * which may cause that the tbf offload is already removed
+		 * by its parent i.e. deleted by pon_qos_qdisc_tree_del */
+		netdev_dbg(dev, "tc-tbf port get failed\n");
 		return -ENODEV;
 	}
 
@@ -146,7 +149,8 @@ int pon_qos_tc_tbf_offload(struct net_device *dev,
 	case TC_TBF_DESTROY:
 		err = pon_qos_tc_tbf_destroy(dev, opt);
 		if (err < 0) {
-			netdev_err(dev, "tc-tbf destroy failed\n");
+			/* Expected to fail if root was previously removed */
+			netdev_dbg(dev, "tc-tbf destroy failed\n");
 			return err;
 		}
 		break;
