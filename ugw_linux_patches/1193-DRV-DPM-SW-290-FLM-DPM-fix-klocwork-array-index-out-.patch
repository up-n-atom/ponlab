From 20cb3d973fd2c9dd7469c8718ed0d89aca767efd Mon Sep 17 00:00:00 2001
From: Gu Chao <gux.chao@intel.com>
Date: Wed, 3 Jun 2020 16:32:21 +0800
Subject: [PATCH] DRV_DPM_SW-290: FLM DPM fix klocwork array index out of
 bounds issue

---
 drivers/net/datapath/dpm/datapath_proc_qos.c | 48 +++++++++++-----------------
 1 file changed, 18 insertions(+), 30 deletions(-)

diff --git a/drivers/net/datapath/dpm/datapath_proc_qos.c b/drivers/net/datapath/dpm/datapath_proc_qos.c
index 95b441a0250a..baa009ce88b3 100644
--- a/drivers/net/datapath/dpm/datapath_proc_qos.c
+++ b/drivers/net/datapath/dpm/datapath_proc_qos.c
@@ -1039,15 +1039,13 @@ static int add_qos_link(struct dp_qos_link *cfg, int flag)
 	return dp_link_add(cfg, flag);
 }
 
-ssize_t proc_qos_write(struct file *file, const char *buf, size_t count,
-		       loff_t *ppos)
+ssize_t proc_qos_write(struct file *file, const char __user *buf,
+		       size_t count, loff_t *ppos)
 {
-	int len, res;
 	char str[100];
-	char *param_list[16] = { 0 };
-	char *temp_list[3] = { 0 };
-	int i, idx = 2; /* index for sched_list */
-	u32 level = 0, num = 0;
+	char *param_list[16];
+	int num;
+	size_t len;
 
 	if (!capable(CAP_NET_ADMIN))
 		return -EPERM;
@@ -1055,51 +1053,40 @@ ssize_t proc_qos_write(struct file *file, const char *buf, size_t count,
 	len -= copy_from_user(str, buf, len);
 	str[len] = 0;
 
-	if (!len)
-		return count;
-
 	num = dp_split_buffer(str, param_list, ARRAY_SIZE(param_list));
-	level = num - 3;
 
-	if (num <= 1 || num > ARRAY_SIZE(param_list) ||
-	    (dp_strncmpi(param_list[0], "help", strlen("help")) == 0))
+	if (num <= 1 || (dp_strncmpi(param_list[0], "help",
+				     strlen("help")) == 0)) {
 		qos_create_qos_help();
-	else if (dp_strncmpi(param_list[0], "add_q", strlen("add_q")) == 0) {
-		struct dp_qos_link cfg = {0};
+	} else if (dp_strncmpi(param_list[0], "add_q", strlen("add_q")) == 0) {
+		struct dp_qos_link cfg;
+		char *temp_list[2];
+		int i;
 
-		if (num < 3) {
+		if (num < 3 || num - 3 > DP_MAX_SCH_LVL) {
 			pr_info("Wrong Parameter(try help):echo help > %s\n",
 				"/sys/kernel/debug/dp/qos");
 			return count;
 		}
 
 		cfg.q_id = dp_atoi(param_list[1]);
-
 		cfg.cqm_deq_port = dp_atoi(param_list[num - 1]);
-
 		cfg.q_leaf = 0;
 		cfg.q_arbi = ARBITRATION_WSP; /* default WSP */
 		cfg.q_prio_wfq = 0;
-		cfg.n_sch_lvl = level;
-
-		if (!level)
-			pr_info("QID %d->", cfg.q_id);
+		cfg.n_sch_lvl = num - 3;
 
-		for (i = 0; (i < (num - 3) && i < DP_MAX_SCH_LVL); i++) {
-			dp_replace_ch(param_list[i + idx],
-				      strlen(param_list[i + idx]), ':', ' ');
-			dp_split_buffer(param_list[i + idx], temp_list,
+		for (i = 0; i < cfg.n_sch_lvl; i++) {
+			dp_replace_ch(param_list[i + 2],
+				      strlen(param_list[i + 2]), ':', ' ');
+			dp_split_buffer(param_list[i + 2], temp_list,
 					ARRAY_SIZE(temp_list));
 			cfg.sch[i].id = dp_atoi(temp_list[0]);
 			cfg.sch[i].leaf = dp_atoi(temp_list[1]);
 			/* Later get child arbi & update accordingly */
 			cfg.sch[i].arbi = ARBITRATION_WSP;
 			cfg.sch[i].prio_wfq = 0;
-			pr_info("SCH %d:LEAF %d->", cfg.sch[i].id,
-				cfg.sch[i].leaf);
 		}
-
-		pr_info("PORT %d\n", cfg.cqm_deq_port);
 		if (add_qos_link(&cfg, 0)) {
 			pr_err("fail to add qos link\n");
 			return count;
@@ -1131,6 +1118,7 @@ ssize_t proc_qos_write(struct file *file, const char *buf, size_t count,
 			       strlen("del_sch")) == 0) {
 		struct dp_node_link node_link = {0};
 		struct dp_node_alloc node = {0};
+		int res;
 
 		node_link.node_id.sch_id = dp_atoi(param_list[1]);
 		node_link.node_type = DP_NODE_SCH;
