From 93120a722ef2de922214939e50730f9e53fb5fad Mon Sep 17 00:00:00 2001
From: Rekha Eswaran <rekha.eswaran@intel.com>
Date: Wed, 9 Sep 2020 11:09:14 +0800
Subject: [PATCH] DRV_DPM_SW-376 - include GSWIP Qos_MeterFree() for
 de-registration in dp_meter_alloc_31()

---
 drivers/net/datapath/dpm/gswip31/datapath_gswip.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/net/datapath/dpm/gswip31/datapath_gswip.c b/drivers/net/datapath/dpm/gswip31/datapath_gswip.c
index 15ef5542a6f6..3bcb0e3c6d88 100644
--- a/drivers/net/datapath/dpm/gswip31/datapath_gswip.c
+++ b/drivers/net/datapath/dpm/gswip31/datapath_gswip.c
@@ -1000,7 +1000,7 @@ int dp_meter_alloc_31(int inst, int *meterid, int flag)
 	gsw_qos = &gsw_handle->gsw_qos_ops;
 	if (flag == DP_F_DEREGISTER && *meterid >= 0) {
 		meter_cfg.nMeterId = *meterid;
-		ret = gsw_qos->QOS_MeterAlloc(gsw_handle, &meter_cfg);
+		ret = gsw_qos->QOS_MeterFree(gsw_handle, &meter_cfg);
 		if (ret != GSW_statusOk) {
 			pr_err("Meter dealloc failed: %d\n", ret);
 			return -1;
