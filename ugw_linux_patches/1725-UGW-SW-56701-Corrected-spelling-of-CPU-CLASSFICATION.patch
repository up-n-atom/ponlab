From 0e96e8810b77202cd26e2b31341d7512bc992a1a Mon Sep 17 00:00:00 2001
From: Amit K Sharma <asharma@maxlinear.com>
Date: Thu, 29 Jul 2021 18:09:21 +0530
Subject: [PATCH] UGW_SW-56701: Corrected spelling of CPU_CLASSFICATION_MASK to
 CPU_CLASSIFICATION_MASK

---
 drivers/net/ethernet/lantiq/ppa/ppa_hook.c | 2 +-
 include/linux/extmark.h                    | 2 +-
 include/net/ppa/ppa_api.h                  | 2 +-
 3 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/drivers/net/ethernet/lantiq/ppa/ppa_hook.c b/drivers/net/ethernet/lantiq/ppa/ppa_hook.c
index cc315de875c7..26ddfcaed19f 100644
--- a/drivers/net/ethernet/lantiq/ppa/ppa_hook.c
+++ b/drivers/net/ethernet/lantiq/ppa/ppa_hook.c
@@ -1020,7 +1020,7 @@ static unsigned int ppa_qos_br_prert_hook_fn(void *priv,
 			 * packets. since this prioirty is coming from pcp-qos
 			 * mapping so clearing it.
 			 */
-			skb->extmark |= CPU_CLASSFICATION_MASK;
+			skb->extmark |= CPU_CLASSIFICATION_MASK;
 		}
 	} else {
 		/* In case of PCE classification skb priority is set
diff --git a/include/linux/extmark.h b/include/linux/extmark.h
index 6b2b6d6217d7..b8b952734594 100644
--- a/include/linux/extmark.h
+++ b/include/linux/extmark.h
@@ -11,7 +11,7 @@
  */
 #define CPU_CLASSIFICATION_START_BIT_POS 5
 #define CPU_CLASSIFICATION_NO_OF_BITS 1
-#define CPU_CLASSFICATION_MASK 0x10
+#define CPU_CLASSIFICATION_MASK 0x10
 
 #define QUEPRIO_START_BIT_POS 5
 #define QUEPRIO_NO_OF_BITS 5
diff --git a/include/net/ppa/ppa_api.h b/include/net/ppa/ppa_api.h
index 64b685e7bd19..c7aaab834f1c 100644
--- a/include/net/ppa/ppa_api.h
+++ b/include/net/ppa/ppa_api.h
@@ -115,7 +115,7 @@
 #endif /* CONFIG_INTEL_IPQOS_MPE_DS_ACCEL */
 #ifndef CONFIG_NETWORK_EXTMARK
 /* This bit indicates whether packet is classified by PAE */
-#define CPU_CLASSIFICATION_MASK     0X10
+#define CPU_CLASSIFICATION_MASK     0x10
 #endif
 #if IS_ENABLED(WMM_QOS_CONFIG)
 typedef int (*PPA_QOS_CLASS2PRIO_CB)(int32_t , PPA_NETIF *, uint8_t *);
