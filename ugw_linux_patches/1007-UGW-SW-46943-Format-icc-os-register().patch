From 63f97847b543c847b3c0fbf797c11ad7e25fb2fb Mon Sep 17 00:00:00 2001
From: Hauke Mehrtens <hauke.mehrtens@intel.com>
Date: Thu, 16 Jan 2020 13:19:59 +0100
Subject: [PATCH] UGW_SW-46943: Format icc_os_register()

This way I am able to read the code.
---
 drivers/char/ltq_icc/drv_icc.c | 27 ++++++++++++++-------------
 1 file changed, 14 insertions(+), 13 deletions(-)

diff --git a/drivers/char/ltq_icc/drv_icc.c b/drivers/char/ltq_icc/drv_icc.c
index 719d2da8e194..c923c4ff2e24 100644
--- a/drivers/char/ltq_icc/drv_icc.c
+++ b/drivers/char/ltq_icc/drv_icc.c
@@ -91,7 +91,7 @@ typedef struct{
 }mmap_addr_t;
 
 static short icc_major_id = 0;
-char icc_dev_name[]="ltq_icc";
+char icc_dev_name[] = "ltq_icc";
 /*Variable used*/
 #ifdef KTHREAD
 unsigned int g_num;
@@ -569,19 +569,20 @@ unsigned int icc_poll(struct file *file_p, poll_table *wait){
 }
 
 /*register the char region with the linux*/
-int icc_os_register (void){
-	 int ret=0;
-		ret=register_chrdev(icc_major_id, icc_dev_name, &icc_fops);
-   if (ret < 0)
-   {
-			TRACE(ICC, DBG_LEVEL_HIGH, ("Not able to register chrdev\n"));
-      return ret;
-   }else if(icc_major_id==0){
-			icc_major_id=ret;
-	 }
-		TRACE(ICC, DBG_LEVEL_HIGH, ("Major Id is %d\n",icc_major_id));
+int icc_os_register(void)
+{
+	int ret = 0;
+
+	ret = register_chrdev(icc_major_id, icc_dev_name, &icc_fops);
+	if (ret < 0) {
+		TRACE(ICC, DBG_LEVEL_HIGH, ("Not able to register chrdev\n"));
+		return ret;
+	} else if (icc_major_id == 0) {
+		icc_major_id = ret;
+	}
+	TRACE(ICC, DBG_LEVEL_HIGH, ("Major Id is %d\n", icc_major_id));
    	TRACE(ICC, DBG_LEVEL_HIGH, ("ICC driver registered\n"));
-   return ret;
+	return ret;
 }
 
 /**
