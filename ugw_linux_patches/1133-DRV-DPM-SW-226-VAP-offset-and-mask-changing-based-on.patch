+++ b/drivers/net/datapath/dpm/gswip31/datapath_gswip.c
@@ -25,23 +25,18 @@
 
 static const struct ctp_assign ctp_assign_info[] = {
 	/*note: multiple flags must put first */
-	{DP_F_CPU, GSW_LOGICAL_PORT_8BIT_WLAN, 16, 16, 8, 0xF, CQE_LU_MODE0, 0},
-	{DP_F_GPON, GSW_LOGICAL_PORT_GPON, 256, 256, 0, 0xFF, CQE_LU_MODE1, 1},
-	{DP_F_EPON, GSW_LOGICAL_PORT_EPON, 64, 64, 0, 0xFF, CQE_LU_MODE1, 1},
-	{DP_F_GINT, GSW_LOGICAL_PORT_GINT, 16, 16, 0, 0xFF, CQE_LU_MODE1, 1},
-	{DP_F_FAST_ETH_WAN, GSW_LOGICAL_PORT_8BIT_WLAN, 8, 8, 8, 0xF,
-		CQE_LU_MODE2, 1},
+	{DP_F_CPU, GSW_LOGICAL_PORT_8BIT_WLAN, 16, 16, CQE_LU_MODE0, 0},
+	{DP_F_GPON, GSW_LOGICAL_PORT_GPON, 256, 256, CQE_LU_MODE1, 1},
+	{DP_F_EPON, GSW_LOGICAL_PORT_EPON, 64, 64, CQE_LU_MODE1, 1},
+	{DP_F_GINT, GSW_LOGICAL_PORT_GINT, 16, 16, CQE_LU_MODE1, 1},
+	{DP_F_FAST_ETH_WAN, GSW_LOGICAL_PORT_8BIT_WLAN, 8, 8, CQE_LU_MODE2, 1},
 	{DP_F_FAST_ETH_LAN | DP_F_ALLOC_EXPLICIT_SUBIFID,
-		GSW_LOGICAL_PORT_8BIT_WLAN, 8, 8, 8, 0xF, CQE_LU_MODE2, 1},
-	{DP_F_FAST_ETH_LAN, GSW_LOGICAL_PORT_8BIT_WLAN, 4, 4, 8, 0xF,
-		CQE_LU_MODE2, 1},
-	{DP_F_VUNI, GSW_LOGICAL_PORT_8BIT_WLAN, 2, 2, 8, 0xF, CQE_LU_MODE2, 1},
-	{DP_F_FAST_WLAN, GSW_LOGICAL_PORT_8BIT_WLAN, 16, 16, 8, 0xF,
-		CQE_LU_MODE2, 1},
-	{DP_F_FAST_DSL, GSW_LOGICAL_PORT_8BIT_WLAN, 1, 16, 8, 0xF,
-		CQE_LU_MODE0, 1},
-	{DP_F_FAST_WLAN_EXT, GSW_LOGICAL_PORT_9BIT_WLAN, 8, 8, 9, 0x7,
-		CQE_LU_MODE2, 1}
+		GSW_LOGICAL_PORT_8BIT_WLAN, 8, 8, CQE_LU_MODE2, 1},
+	{DP_F_FAST_ETH_LAN, GSW_LOGICAL_PORT_8BIT_WLAN, 4, 4, CQE_LU_MODE2, 1},
+	{DP_F_VUNI, GSW_LOGICAL_PORT_8BIT_WLAN, 2, 2, CQE_LU_MODE2, 1},
+	{DP_F_FAST_WLAN, GSW_LOGICAL_PORT_8BIT_WLAN, 16, 16, CQE_LU_MODE2, 1},
+	{DP_F_FAST_DSL, GSW_LOGICAL_PORT_8BIT_WLAN, 1, 16, CQE_LU_MODE0, 1},
+	{DP_F_FAST_WLAN_EXT, GSW_LOGICAL_PORT_9BIT_WLAN, 8, 8, CQE_LU_MODE2, 1}
 };
 
 static const struct ctp_assign ctp_assign_def = {
@@ -533,6 +528,7 @@ struct gsw_itf *ctp_port_assign(int inst, u8 ep, int bp_default,
 	struct core_ops *gsw_handle;
 	struct ctp_ops *gsw_ctp;
 	struct pmac_port_info *port_info = get_dp_port_info(inst, ep);
+	struct dp_cap cap;
 
 	memset(&ctp_assign, 0, sizeof(ctp_assign));
 	gsw_handle = dp_port_prop[inst].ops[GSWIP_L];
@@ -585,8 +581,29 @@ struct gsw_itf *ctp_port_assign(int inst, u8 ep, int bp_default,
 	itf_assign[ep].ep = ep;
 	port_info->subif_max = assign->num_subif;
 	port_info->ctp_max = ctp_assign.nNumberOfCtpPort;
-	port_info->vap_offset = assign->vap_offset;
-	port_info->vap_mask = assign->vap_mask;
+
+	cap.inst = inst;
+	dp_get_cap(&cap, 0);
+
+	/* HW capaility have only 3 modes 8-bit, 9-bit or Non-WLAN mode */
+	if (assign->emode == GSW_LOGICAL_PORT_8BIT_WLAN) {
+		port_info->vap_offset = 
+			cap.vap_offset[GSW_LOGICAL_PORT_8BIT_WLAN];
+		port_info->vap_mask = 
+			cap.vap_mask[GSW_LOGICAL_PORT_8BIT_WLAN];
+	} else if (assign->emode == GSW_LOGICAL_PORT_9BIT_WLAN) {
+		port_info->vap_offset = 
+			cap.vap_offset[GSW_LOGICAL_PORT_9BIT_WLAN];
+		port_info->vap_mask = 
+			cap.vap_mask[GSW_LOGICAL_PORT_9BIT_WLAN];
+	} else {
+		/* GPON, EPON, G.INT take this mode */
+		port_info->vap_offset = 
+		cap.vap_offset[GSW_LOGICAL_PORT_GPON];
+		port_info->vap_mask = 
+			cap.vap_mask[GSW_LOGICAL_PORT_GPON];
+	}
+
 #if IS_ENABLED(CONFIG_INTEL_DATAPATH_SWITCHDEV)
 	port_info->swdev_en = assign->swdev_enable;
 #endif
diff --git a/drivers/net/datapath/dpm/gswip31/datapath_misc.c b/drivers/net/datapath/dpm/gswip31/datapath_misc.c
index 4b47068597c5..3b9a200eddb5 100644
--- a/drivers/net/datapath/dpm/gswip31/datapath_misc.c
+++ b/drivers/net/datapath/dpm/gswip31/datapath_misc.c
@@ -2259,6 +2259,78 @@ static int get_itf_start_end(struct gsw_itf *itf_info, u16 *start, u16 *end)
 	return 0;
 }
 
+static void dp_get_gswip_cap(struct dp_hw_cap *cap, int flag)
+{
+	struct core_ops *gsw_ops;
+	GSW_cap_t parm;
+
+	gsw_ops = gsw_get_swcore_ops(0);
+
+	/* Max number of CTP */
+	parm.nCapType = GSW_CAP_TYPE_CTP;
+	gsw_ops->gsw_common_ops.CapGet(gsw_ops, &parm);
+	cap->info.cap.max_num_subif = parm.nCap;
+
+	/* Max number of Bridge Port */
+	parm.nCapType = GSW_CAP_TYPE_BRIDGE_PORT;
+	gsw_ops->gsw_common_ops.CapGet(gsw_ops, &parm);
+	cap->info.cap.max_num_bridge_port = parm.nCap;
+
+	/* Max number of Physical Ethernet Port */
+	parm.nCapType = GSW_CAP_TYPE_PORT;
+	gsw_ops->gsw_common_ops.CapGet(gsw_ops, &parm);
+	cap->info.cap.max_eth_port = parm.nCap;
+
+	/* Max number of Virtual Ethernet Port */
+	parm.nCapType = GSW_CAP_TYPE_VIRTUAL_PORT;
+	gsw_ops->gsw_common_ops.CapGet(gsw_ops, &parm);
+	cap->info.cap.max_virt_eth_port = parm.nCap;
+
+	/* Total number of DP ports */
+	cap->info.cap.max_num_dp_ports = cap->info.cap.max_eth_port +
+					 cap->info.cap.max_virt_eth_port;
+
+	/* For WLAN 8 bit Mode VAP=11:8
+	 * For WLAN 9 bit Mode VAP=11:9
+	 * For Non-WLAN Mode VAP=0:7
+	 */
+	cap->info.cap.vap_offset[GSW_LOGICAL_PORT_8BIT_WLAN] = VAP_8BIT_OFFSET;
+	cap->info.cap.vap_mask[GSW_LOGICAL_PORT_8BIT_WLAN] = VAP_8BIT_MASK;
+	cap->info.cap.vap_offset[GSW_LOGICAL_PORT_9BIT_WLAN] = VAP_9BIT_OFFSET;
+	cap->info.cap.vap_mask[GSW_LOGICAL_PORT_9BIT_WLAN] = VAP_9BIT_OFFSET;
+	cap->info.cap.vap_offset[GSW_LOGICAL_PORT_GPON] = VAP_NONWLAN_OFFSET;
+	cap->info.cap.vap_mask[GSW_LOGICAL_PORT_GPON] = VAP_NONWLAN_MASK;
+
+	cap->info.cap.max_num_learn_limit_port = GSWIP_LEARN_LIMIT_PORT_MAX;
+
+	cap->info.cap.tx_hw_chksum = 0;
+	cap->info.cap.rx_hw_chksum = 0;
+	cap->info.cap.hw_ptp = 1;
+
+	DP_DEBUG(DP_DBG_FLAG_REG, "max_num_subif            = %d\n"
+	       "max_num_bridge_port      = %d\n"
+	       "max_eth_port             = %d\n"
+	       "max_virt_eth_port        = %d\n"
+	       "max_num_dp_ports         = %d\n"
+	       "vap_offset 8-bit Mode    = %d\n"
+	       "vap_mask 8-bit Mode      = %d\n"
+	       "vap_offset 9-bit Mode    = %d\n"
+	       "vap_mask 9-bit Mode      = %d\n"
+	       "vap_offset Non-WLAN mode = %d\n"
+	       "vap_mask Non-WLAN mode   = %d\n",
+	       cap->info.cap.max_num_subif,
+	       cap->info.cap.max_num_bridge_port,
+	       cap->info.cap.max_eth_port,
+	       cap->info.cap.max_virt_eth_port,
+	       cap->info.cap.max_num_dp_ports,
+	       cap->info.cap.vap_offset[GSW_LOGICAL_PORT_8BIT_WLAN],
+	       cap->info.cap.vap_mask[GSW_LOGICAL_PORT_8BIT_WLAN],
+	       cap->info.cap.vap_offset[GSW_LOGICAL_PORT_9BIT_WLAN],
+	       cap->info.cap.vap_mask[GSW_LOGICAL_PORT_9BIT_WLAN],
+	       cap->info.cap.vap_offset[GSW_LOGICAL_PORT_GPON],
+	       cap->info.cap.vap_mask[GSW_LOGICAL_PORT_GPON]);
+}
+
 int register_dp_cap_gswip31(int flag)
 {
 	struct dp_hw_cap cap;
@@ -2344,11 +2416,8 @@ int register_dp_cap_gswip31(int flag)
 	cap.info.dp_cfg_vlan = dp_gswip_ext_vlan; /*for symmetric VLAN */
 	cap.info.dp_tc_vlan_set = tc_vlan_set_31;
 #endif
-	cap.info.cap.tx_hw_chksum = 0;
-	cap.info.cap.rx_hw_chksum = 0;
 	cap.info.cap.hw_tso = 0;
 	cap.info.cap.hw_gso = 0;
-	cap.info.cap.hw_ptp = 1;
 	strncpy(cap.info.cap.qos_eng_name, "ppv4",
 		sizeof(cap.info.cap.qos_eng_name));
 	strncpy(cap.info.cap.pkt_eng_name, "mpe",
@@ -2357,11 +2426,9 @@ int register_dp_cap_gswip31(int flag)
 	cap.info.cap.max_num_scheds = MAX_SCHD;
 	cap.info.cap.max_num_deq_ports = MAX_CQM_DEQ;
 	cap.info.cap.max_num_qos_ports = MAX_PPV4_PORT;
-	cap.info.cap.max_num_dp_ports = PMAC_MAX_NUM;
 	cap.info.cap.max_num_subif_per_port = MAX_SUBIF_PER_PORT;
-	cap.info.cap.max_num_subif = 288;
-	cap.info.cap.max_num_bridge_port = 128;
-	cap.info.cap.max_num_learn_limit_port = GSWIP_LEARN_LIMIT_PORT_MAX;
+
+	dp_get_gswip_cap(&cap, flag);
 
 	if (register_dp_hw_cap(&cap, flag)) {
 		pr_err("Why register_dp_hw_cap fail\n");
diff --git a/drivers/net/datapath/dpm/gswip31/datapath_misc.h b/drivers/net/datapath/dpm/gswip31/datapath_misc.h
index 220ffa0638a3..608798a950c9 100644
--- a/drivers/net/datapath/dpm/gswip31/datapath_misc.h
+++ b/drivers/net/datapath/dpm/gswip31/datapath_misc.h
@@ -14,14 +14,23 @@
 
 #define PMAC_MAX_NUM  16
 #define PAMC_LAN_MAX_NUM 7
-#define VAP_OFFSET 8
-#define VAP_MASK  0xF
 #define VAP_DSL_OFFSET 3
 #define NEW_CBM_API 1
 #define PMAPPER_DISC_CTP 255
 #define MAX_PPV4_PORTS 38
 #define PPV4_PORT_BASE 90
 
+/* For WLAN 8 bit Mode VAP=11:8
+ * For WLAN 9 bit Mode VAP=11:9
+ * For Non-WLAN Mode VAP=7:0
+ */
+#define VAP_8BIT_OFFSET 8
+#define VAP_8BIT_MASK   0xF
+#define VAP_9BIT_OFFSET 9
+#define VAP_9BIT_MASK   0x7
+#define VAP_NONWLAN_OFFSET 0
+#define VAP_NONWLAN_MASK 0xFF
+
 #define GSWIP_O_DEV_NAME 1
 #define GSWIP_L GSWIP_O_DEV_NAME
 #define GSWIP_R GSWIP_O_DEV_NAME
@@ -179,8 +188,6 @@ struct ctp_assign {
 	GSW_LogicalPortMode_t emode; /*mapped GSWIP CTP flag */
 	u16 num; /*Max CTP allowed for that GSWIP logical port*/
 	u16 num_subif; /*Max allowed number of subif for that logical port*/
-	u32 vap_offset; /*VAP offset */
-	u32 vap_mask;  /*VAP Mask after shift vap_offset bits */
 	u32 lookup_mode; /*CQE lookup mode  */
 	u16 swdev_enable; /* To enable or disable switchdev feature */
 };
