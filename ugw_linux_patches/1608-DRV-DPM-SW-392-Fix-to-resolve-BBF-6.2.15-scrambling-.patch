From 531498a80bc12b33e500dc199758709b223e812f Mon Sep 17 00:00:00 2001
From: Rekha Eswaran <rekha.eswaran@intel.com>
Date: Fri, 12 Feb 2021 10:13:01 +0800
Subject: [PATCH] DRV_DPM_SW-392 - Fix to resolve  BBF 6.2.15 scrambling,
 SP+WRR traffic test failure (PONRTSYS-8561, PONRTSYS-8554)

---
 drivers/net/datapath/dpm/datapath_api.c  | 10 +++++-----
 drivers/net/datapath/dpm/datapath_misc.c |  7 +++----
 2 files changed, 8 insertions(+), 9 deletions(-)

diff --git a/drivers/net/datapath/dpm/datapath_api.c b/drivers/net/datapath/dpm/datapath_api.c
index 42ef26732bf0..6f8733ce8f47 100644
--- a/drivers/net/datapath/dpm/datapath_api.c
+++ b/drivers/net/datapath/dpm/datapath_api.c
@@ -1792,7 +1792,7 @@ int32_t dp_get_subifid_for_update(int inst, struct net_device *netif,
 		struct dp_subif_info *sif = get_dp_port_subif(p_info, i);
 
 		/* FOR DSL ATM case when netif is NULL, no need subif info */
-		if (is_dsl(p_info))
+		if (is_dsl(p_info) && (!netif))
 			break;
 
 		if (!sif->flags)
@@ -1842,14 +1842,14 @@ int32_t dp_get_subifid_for_update(int inst, struct net_device *netif,
 		/*continue search non-explicate logical device */
 		list_for_each_entry(tmp, &sif->logic_dev, list) {
 			if (tmp->dev == netif) {
+				memcpy(&subif->subif_common,
+				       &sif->subif_common,
+				       sizeof(struct dp_subif_common));
 				subif->subif_num = 1;
 				subif->inst = inst;
+				subif->subif_list[0] = tmp->ctp;
 				subif->bport = tmp->bp;
 				subif->port_id = port_id;
-				subif->subif_list[0] = tmp->ctp;
-				memcpy(&subif->subif_common,
-				       &sif->subif_common,
-				       sizeof(struct dp_subif_common));
 				subif_flag[num] = sif->subif_flag;
 				res = DP_SUCCESS;
 				/*note: logical device no callback */
diff --git a/drivers/net/datapath/dpm/datapath_misc.c b/drivers/net/datapath/dpm/datapath_misc.c
index b5fac08334b0..9105386684b4 100644
--- a/drivers/net/datapath/dpm/datapath_misc.c
+++ b/drivers/net/datapath/dpm/datapath_misc.c
@@ -916,10 +916,8 @@ struct dp_subif_cache *dp_subif_lookup_safe(struct hlist_head *head,
 	struct hlist_node *n;
 
 	hlist_for_each_entry_safe(item, n, head, hlist) {
-		if (dev) {
-			if (item->dev == dev)
-				return item;
-		}
+		if (item->dev == dev)
+			return item;
 	}
 	return NULL;
 }
@@ -1017,6 +1015,7 @@ int32_t dp_sync_subifid(struct net_device *dev, char *subif_name,
 			return res;
 		}
 		if (data && data->ctp_dev) {
+			subif_id[1].port_id = subif_id[0].port_id;
 			res = dp_get_subifid_for_update(subif_id->inst,
 							data->ctp_dev,
 							&subif_id[1], 0);
