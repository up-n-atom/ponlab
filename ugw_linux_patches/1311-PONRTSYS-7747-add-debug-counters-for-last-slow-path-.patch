From 89aaa6a254135a9a95bde20899a5cd643c46c01b Mon Sep 17 00:00:00 2001
From: avishalo <avi1.shalom@intel.com>
Date: Tue, 23 Jun 2020 15:14:03 +0300
Subject: [PATCH] PONRTSYS-7747: add debug counters for last slow path packets

Signed-off-by: avishalo <avi1.shalom@intel.com>
---
 drivers/net/ppv4/pp-api/pp-misc/pp_misc.c | 10 +++++++++-
 drivers/net/ppv4/pp-api/pp-misc/pp_misc.h |  3 +++
 2 files changed, 12 insertions(+), 1 deletion(-)

diff --git a/drivers/net/ppv4/pp-api/pp-misc/pp_misc.c b/drivers/net/ppv4/pp-api/pp-misc/pp_misc.c
index 9ee7965fc658..e0dc243d825c 100644
--- a/drivers/net/ppv4/pp-api/pp-misc/pp_misc.c
+++ b/drivers/net/ppv4/pp-api/pp-misc/pp_misc.c
@@ -341,6 +341,10 @@ void pp_rx_pkt_hook(struct sk_buff *skb)
 		return;
 	}
 
+	/* Count last slow path packets received for debug */
+	if (desc->lsp_pkt)
+		atomic_inc(&db->stats.rx_hook_lspp_pkt_cnt);
+
 	/* attach PP descriptor cookie to the SKB pointer */
 	if (skb_cookie_attach(skb, db->pp_cookie_hnd, (skb_cookie)desc,
 			      __desc_free)) {
@@ -914,10 +918,14 @@ s32 pp_driver_stats_show(char *buf, size_t sz, size_t *n, void *stats,
 		   "RX Hook SKBs", atomic_read(&misc->rx_hook_skb_cnt),
 		   "TX Hook SKBs", atomic_read(&misc->tx_hook_skb_cnt));
 
+	pr_buf_cat(buf, sz, *n, " | %-28s | %-10u | %-28s | %-10s |\n",
+		   "RX Hook SKBs with LSPP Mark",
+		   atomic_read(&misc->rx_hook_lspp_pkt_cnt), "", "");
+
 	pr_buf_cat(buf, sz, *n,
 		   " +------------------------------+------------+------------------------------+------------+\n");
 	pr_buf_cat(buf, sz, *n,
-		   " |                          Errors                                                       |\n");
+		   " |                                         Errors                                        |\n");
 	pr_buf_cat(buf, sz, *n,
 		   " +------------------------------+------------+------------------------------+------------+\n");
 	pr_buf_cat(buf, sz, *n, " | %-28s | %-10u | %-28s | %-10u |\n",
diff --git a/drivers/net/ppv4/pp-api/pp-misc/pp_misc.h b/drivers/net/ppv4/pp-api/pp-misc/pp_misc.h
index 31df7ee7082b..d4b2e7870a67 100644
--- a/drivers/net/ppv4/pp-api/pp-misc/pp_misc.h
+++ b/drivers/net/ppv4/pp-api/pp-misc/pp_misc.h
@@ -42,6 +42,9 @@ struct pp_misc_init_param {
  * @brief Misc stats
  */
 struct misc_stats {
+	/*! number of skb passed through RX hook with last slow path pkt mark */
+	atomic_t rx_hook_lspp_pkt_cnt;
+	
 	/*! number of skb passed through RX hook */
 	atomic_t rx_hook_skb_cnt;
 
