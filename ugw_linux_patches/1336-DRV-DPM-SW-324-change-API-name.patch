From 3a5010ae3688dd3fe4ae2f4d81a2ac87a538576d Mon Sep 17 00:00:00 2001
From: Rekha Eswaran <rekha.eswaran@intel.com>
Date: Mon, 20 Jul 2020 11:34:00 +0800
Subject: [PATCH] DRV_DPM_SW-324 - change API name

---
 drivers/net/datapath/dpm/datapath_swdev.c | 19 +++++++++++--------
 drivers/net/datapath/dpm/datapath_swdev.h |  3 ++-
 2 files changed, 13 insertions(+), 9 deletions(-)

diff --git a/drivers/net/datapath/dpm/datapath_swdev.c b/drivers/net/datapath/dpm/datapath_swdev.c
index bc88cf7bb134..9a437b55b2e9 100644
--- a/drivers/net/datapath/dpm/datapath_swdev.c
+++ b/drivers/net/datapath/dpm/datapath_swdev.c
@@ -17,7 +17,8 @@
 static void dp_swdev_insert_bridge_id_entry(struct br_info *);
 static void dp_swdev_remove_bridge_id_entry(struct br_info *);
 static int dp_swdev_add_bport_to_list(struct br_info *br_item,
-				      struct bridge_id_entry_item *brid_item);
+				      struct bridge_id_entry_item *brid_item,
+				      struct net_device *dev);
 static int dp_swdev_del_bport_from_list(struct br_info *br_item, int bport);
 
 struct hlist_head g_bridge_id_entry_hash_table[BR_ID_ENTRY_HASH_TABLE_SIZE];
@@ -242,7 +243,8 @@ static int dp_swdev_del_bport_from_list(struct br_info *br_item,
 }
 
 static int dp_swdev_add_bport_to_list(struct br_info *br_item,
-				      struct bridge_id_entry_item *brid_item)
+				      struct bridge_id_entry_item *brid_item,
+				      struct net_device *dev)
 {
 	struct bridge_member_port *bmp;
 	int found = 0;
@@ -265,6 +267,7 @@ static int dp_swdev_add_bport_to_list(struct br_info *br_item,
 		bmp->dev_reg_flag = br_item->flag;
 		bmp->bportid = brid_item->bportid;
 		bmp->dp_port = br_item->dp_port;
+		bmp->dev = dev;
 		DP_DEBUG(DP_DBG_FLAG_SWDEV,
 			 "bport:%d reg_flag:%d priv_flag:0x%x\n",
 			 bmp->bportid, bmp->dev_reg_flag, bmp->dev_priv_flag);
@@ -479,7 +482,7 @@ static int dp_swdev_cfg_gswip(struct bridge_id_entry_item *br_item,
 			i_info->dp_reg_bport_vlan(br_info, dev,
 						  br_item->bportid, 0);
 
-			dp_swdev_add_bport_to_list(br_info, br_item);
+			dp_swdev_add_bport_to_list(br_info, br_item, dev);
 
 			i_info->swdev_bridge_port_cfg_set(br_info,
 							  br_item->inst,
@@ -507,7 +510,7 @@ static int dp_swdev_cfg_gswip(struct bridge_id_entry_item *br_item,
 		/* dev is the bridge port device */
 		i_info->dp_reg_bport_vlan(br_info, dev, br_item->bportid, 0);
 
-		dp_swdev_add_bport_to_list(br_info, br_item);
+		dp_swdev_add_bport_to_list(br_info, br_item, dev);
 		i_info->swdev_bridge_port_cfg_set(br_info, br_item->inst,
 						  br_item->bportid);
 		DP_DEBUG(DP_DBG_FLAG_SWDEV, "added bport(%d)\n",
@@ -522,9 +525,8 @@ static int dp_swdev_cfg_gswip(struct bridge_id_entry_item *br_item,
 	return DP_SUCCESS;
 }
 
-/* Handles de-registration of vlan device created during add_if */
-static int dp_del_swdev_reg_vlan(struct bridge_id_entry_item *br_item,
-				 struct net_device *dev, u8 *addr)
+static int dp_del_swdev_info(struct bridge_id_entry_item *br_item,
+			     struct net_device *dev, u8 *addr)
 {
 	struct pmac_port_info *p_info;
 	struct net_device *base;
@@ -546,6 +548,7 @@ static int dp_del_swdev_reg_vlan(struct bridge_id_entry_item *br_item,
 
 		dp_swdev_cfg_vlan(br_item, dev);
 
+		/* Handles de-registration of vlan dev created during add_if */
 		if (dp_get_netif_subifid(base, NULL, NULL, NULL, &subif, 0)) {
 			pr_err("%s get subif fail for %s\n",
 			       __func__, base->name);
@@ -794,7 +797,7 @@ static int dp_swdev_del_if(struct net_device *dev,
 		br_item = switchdev_trans_item_dequeue(trans);
 
 	if (sif->swdev_en)
-		dp_del_swdev_reg_vlan(br_item, dev, addr);
+		dp_del_swdev_info(br_item, dev, addr);
 
 	if (flags != DP_SWDEV_BRIDGE_ITEM)
 		kmem_cache_free(cache_br_entry_list, br_item);
diff --git a/drivers/net/datapath/dpm/datapath_swdev.h b/drivers/net/datapath/dpm/datapath_swdev.h
index a97c8ae1b544..e665835e1d2c 100644
--- a/drivers/net/datapath/dpm/datapath_swdev.h
+++ b/drivers/net/datapath/dpm/datapath_swdev.h
@@ -36,7 +36,7 @@ struct bridge_id_entry_item {
 
 struct br_info {
 	struct hlist_node br_hlist;
-	struct net_device *dev;
+	struct net_device *dev; /* bridge dev */
 	u16 fid;
 	u32 flag;
 	u32 inst;
@@ -52,6 +52,7 @@ struct br_info {
 struct bridge_member_port {
 	struct list_head list;
 	u32 bportid; /* bridge port */
+	struct net_device *dev; /* bridge port dev for debug */
 	u32 dev_reg_flag;
 	u16 bport[8];
 	u32 dev_priv_flag; /* to store bp dev priv flags (like IFF_NO_QUEUE) */
