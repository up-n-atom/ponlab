@@ -1774,6 +1774,14 @@ static int node_bw_limited_wrapper(const struct pp_qos_dev *qdev,
 		(node->bandwidth_limit || node->shared_bandwidth_group);
 }
 
+static int queue_node_nonblocked_wrapper(const struct pp_qos_dev *qdev,
+					 const struct qos_node *node,
+					 void *data)
+{
+	return node_queue(node) &&
+		!QOS_BITS_IS_SET(node->flags, QOS_NODE_FLAGS_QUEUE_BLOCKED);
+}
+
 void update_bwl_buffer(struct pp_qos_dev *qdev, unsigned int phy)
 {
 	post_order_travers_tree(qdev, phy,
@@ -1807,6 +1815,14 @@ void get_active_port_rlms(struct pp_qos_dev *qdev, u32 phy,
 					      update_rlm_container, &data);
 }
 
+void get_num_nonblocked_queues(struct pp_qos_dev *qdev,
+			       unsigned int phy,
+			       unsigned int *queues_num)
+{
+	*queues_num = post_order_travers_tree(qdev, phy,
+					      queue_node_nonblocked_wrapper,
+					      NULL, NULL, NULL);
+}
 static int node_in_grp(const struct pp_qos_dev *qdev,
 		const struct qos_node *node, void *data)
 {
diff --git a/drivers/net/ethernet/lantiq/ppv4/qos/pp_qos_utils.h b/drivers/net/ethernet/lantiq/ppv4/qos/pp_qos_utils.h
