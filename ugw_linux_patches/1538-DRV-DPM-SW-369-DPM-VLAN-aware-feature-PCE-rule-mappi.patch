+int ctp_dev_list_add(struct list_head *head, struct net_device *dev, int bp,
+		     int vap)
+{
+	struct ctp_dev *ctp_dev_list;
+
+	ctp_dev_list = ctp_dev_list_lookup(head, dev);
+	if (!ctp_dev_list) {
+		ctp_dev_list = kzalloc(sizeof(*ctp_dev_list), GFP_ATOMIC);
+		if (!ctp_dev_list) {
+			DP_DEBUG(DP_DBG_FLAG_DBG, "kmalloc fail %zd bytes\n",
+				 sizeof(*ctp_dev_list));
+			return -1;
+		}
+		ctp_dev_list->dev = dev;
+		ctp_dev_list->bp = bp;
+		ctp_dev_list->ctp = vap;
+		DP_DEBUG(DP_DBG_FLAG_DBG, "add ctp dev list\n");
+		list_add(&ctp_dev_list->list, head);
+	} else {
+		DP_DEBUG(DP_DBG_FLAG_DBG, "Device already exist: %s\n",
+			 ctp_dev_list->dev->name);
+	}
+	return 0;
+}
+
+int ctp_dev_list_del(struct list_head *head, struct net_device *dev)
+{
+	struct ctp_dev *ctp_dev_list;
+
+	ctp_dev_list = ctp_dev_list_lookup(head, dev);
+	if (!ctp_dev_list) {
+		DP_DEBUG(DP_DBG_FLAG_DBG, "Device not found: %s\n",
+			 ctp_dev_list->dev->name);
+		return -1;
+	}
+	DP_DEBUG(DP_DBG_FLAG_DBG, "del ctp dev list\n");
+	list_del(&ctp_dev_list->list);
+	kfree(ctp_dev_list);
+	return 0;
+}
