-		return DP_FAILURE;
-	}
-
-	for (i = 0; i < MAX_TC; i++) {
-		egcfg.nBslTrafficClass = i;
-		switch (glbcfg.eProcFlagsEgCfg) {
-		/* Use reduced traffic class (saturated to 3)
-		 * and flags (MPE1, MPE2)
-		 */
-		case GSW_PMAC_PROC_FLAGS_MIX:
-			egcfg.bProcFlagsSelect = 1;
-			egcfg.nTrafficClass = FIELD_PREP(GSW_REDUCED_TC, i);
