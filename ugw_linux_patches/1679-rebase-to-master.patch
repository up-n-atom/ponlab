-	struct pmac_port_info *port_info;
-	u32 q_num, cqm_deq_port, i;
-	u16 qids[MAX_Q_PER_PORT];
-
-	port_info = get_dp_port_info(cfg->inst, cfg->dp_port);
-	if (!port_info->deq_port_num)
-		return DP_FAILURE;
-
-	if (cfg->deq_port_idx == DEQ_PORT_OFFSET_ALL)
-		cqm_deq_port = port_info->deq_port_base;
-	else
-		cqm_deq_port = port_info->deq_port_base + cfg->deq_port_idx;
-
-	if (!is_deqport_valid(cqm_deq_port) ||
-	    is_port_node_free(priv, cqm_deq_port))
-		return DP_FAILURE;
-
-	if (dp_qos_port_get_queues(priv->qdev,
-				   priv->deq_port_stat[cqm_deq_port].node_id,
-				   qids, ARRAY_SIZE(qids), &q_num)) {
