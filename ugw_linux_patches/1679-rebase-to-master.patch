-	/* QUEUE_CFG if needed */
-	q_port.cqe_deq = port_info->deq_port_base + deq_port_idx;
-
-	DP_DEBUG(DP_DBG_FLAG_QOS, "%s: %s=%d %s=%p %s=%p %s=%p %s=%d\n",
-		 __func__,
-		 "cqe_deq", q_port.cqe_deq,
-		 "priv", priv,
