-	}
-	resv.dp_inst = inst;
-	resv.cbm_inst = dp_port_prop[inst].cbm_inst;
-	resv.alloc_flags = port->alloc_flags;
-	resv.dp_port = spl_gpid ? CPU_PORT : dpid;
