-		       priv->deq_port_stat[cqm_deq_port].node_id);
-		return DP_FAILURE;
-	}
-
-	q_cfg.inst = cfg->inst;
-
-	/* Even if fail, continue to block and flush other queues */
-	for (i = 0; i < q_num; i++) {
-		q_cfg.q_id = get_qid_by_node(cfg->inst, qids[i]);
-		dp_queue_block_flush(&q_cfg, flag);
-	}
-
-	return DP_SUCCESS;
-}
