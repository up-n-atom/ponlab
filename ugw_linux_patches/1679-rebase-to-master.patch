-		node.dp_port = dp_port;
-		node.type = DP_NODE_QUEUE;
-		dp_node_free(&node, 0);
-
-		/*update dp_q_tbl*/
-		q_info->flag = 0;
-		q_info->need_free = 0;
-	} else {
-		DP_DEBUG(DP_DBG_FLAG_QOS, "q_id[%d] dont need to be freed\n",
-			 qid);
-		return DP_FAILURE;
