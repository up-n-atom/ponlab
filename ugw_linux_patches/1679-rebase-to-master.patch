-	if (port_info->cqe_lu_mode == CQE_LU_MODE0) {
-		/* Eg Lpid[3:0] Sub_If_Id[13:8] Class[1:0] */
-		lookup = ((desc_0->field.dest_sub_if_id >> 8) << 2) |
-			 ((desc_1->field.classid & 0x3)) |
-			 ((dp_port & 0x0F) << 8) |
-			 ((desc_1->field.redir) << 12);
-	} else if (port_info->cqe_lu_mode == CQE_LU_MODE1) {
