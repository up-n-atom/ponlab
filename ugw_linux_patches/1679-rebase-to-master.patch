-static int dp_q_remove(int inst, int ep)
-{
-	struct hal_priv *priv = HAL(inst);
-	struct resv_info *r = &priv->resv[ep];
-	int i, res;
-
-	if (!r->resv_q)
-		return DP_SUCCESS;
-
-	if (r->num_resv_q <= 0)
-		goto exit;
-
-	if (r->flag_ops & DP_F_DEV_CONTINUOUS_Q) {
-		res = pp_qos_contiguous_queue_remove(priv->qdev,
-						     r->resv_q[0].id,
-						     r->num_resv_q);
-		if (res) {
-			pr_err("%s pp_qos_contiguous_queue_remove fail %d\n",
-			       __func__, res);
-			return DP_FAILURE;
-		}
-		r->num_resv_q = 0;
-		r->flag_ops &= ~DP_F_DEV_CONTINUOUS_Q;
-		goto exit;
-	}
-
-	while (r->num_resv_q) {
-		i = r->num_resv_q - 1;
-		res = dp_qos_queue_remove(priv->qdev, r->resv_q[i].id);
-		if (res) {
-			pr_err("%s: dp_qos_queue_remove fail %d for qid %d\n",
-			       __func__, res, r->resv_q[i].id);
-			return DP_FAILURE;
-		}
-		r->num_resv_q--;
-	}
-
-exit:
-	devm_kfree(&g_dp_dev->dev, r->resv_q);
-	r->resv_q = NULL;
-
-	return DP_SUCCESS;
-}
