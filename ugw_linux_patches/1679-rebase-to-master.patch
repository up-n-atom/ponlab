-	/* Disable Ingress PCE Bypass for vUNI TC 0 .. 3
-	 * EP=12 remapped to Q 12 .. Q 15 and redirect to Pmac 2 and to PPv4
-	 */
-	memset(&q_map, 0, sizeof(GSW_QoS_queuePort_t));
