-		/* Use flags (MPE1, MPE2, DEC, ENC) */
-		case GSW_PMAC_PROC_FLAGS_FLAG:
-			egcfg.bProcFlagsSelect = 1;
-			egcfg.bDecFlag = FIELD_PREP(GSW_DEC, i);
-			egcfg.bEncFlag = FIELD_PREP(GSW_ENC, i);
-			egcfg.bMpe2Flag = FIELD_PREP(GSW_MPE2, i);
-			egcfg.bMpe1Flag = FIELD_PREP(GSW_MPE1, i);
-			break;
-		/* Use traffic class as full 4 bits */
-		default:
-			egcfg.nTrafficClass = i;
-			break;
-		}
-
-		for (j = 0; j < MAX_FLOW; j++) {
-			egcfg.nFlowIDMsb = j;
-
-			gsw_ops->gsw_pmac_ops.Pmac_Eg_CfgGet(gsw_ops, &egcfg);
-
-			if (flags & EG_PMAC_F_FCS)
-				egcfg.bFcsEna = eg_pmac.fcs;
-
-			if (flags & EG_PMAC_F_L2HDR_RM) {
-				egcfg.bRemL2Hdr = eg_pmac.rm_l2hdr;
-				egcfg.numBytesRem = eg_pmac.num_l2hdr_bytes_rm;
-			}
-
-			if (flags & EG_PMAC_F_PMAC)
-				egcfg.bPmacEna = eg_pmac.pmac;
-
-			if (flags & EG_PMAC_F_RXID)
-				egcfg.nRxDmaChanId = eg_pmac.rx_dma_chan;
-
-			if (flags & EG_PMAC_F_REDIREN)
-				egcfg.bRedirEnable = eg_pmac.redir;
-
-			if (flags & EG_PMAC_F_BSLSEG)
-				egcfg.bBslSegmentDisable = eg_pmac.bsl_seg;
-
-			if (flags & EG_PMAC_F_RESDW1EN)
-				egcfg.bResDW1Enable = eg_pmac.res_endw1;
-
-			if (flags & EG_PMAC_F_RESDW1)
-				egcfg.nResDW1 = eg_pmac.res_dw1;
-
-			if (flags & EG_PMAC_F_RES1DW0EN)
-				egcfg.bRes1DW0Enable = eg_pmac.res1_endw0;
-
-			if (flags & EG_PMAC_F_RES1DW0)
-				egcfg.nRes1DW0 = eg_pmac.res1_dw0;
-
-			if (flags & EG_PMAC_F_RES2DW0EN)
-				egcfg.bRes2DW0Enable = eg_pmac.res2_endw0;
-
-			if (flags & EG_PMAC_F_RES2DW0)
-				egcfg.nRes2DW0 = eg_pmac.res2_dw0;
-
-			if (flags & EG_PMAC_F_DECFLG)
-				egcfg.bDecFlag = eg_pmac.dec_flag;
-
-			if (flags & EG_PMAC_F_ENCFLG)
-				egcfg.bEncFlag = eg_pmac.enc_flag;
-
-			if (flags & EG_PMAC_F_MPE1FLG)
-				egcfg.bMpe1Flag = eg_pmac.mpe1_flag;
-
-			if (flags & EG_PMAC_F_MPE2FLG)
-				egcfg.bMpe2Flag = eg_pmac.mpe2_flag;
-
-			gsw_ops->gsw_pmac_ops.Pmac_Eg_CfgSet(gsw_ops, &egcfg);
-
-#if defined(CONFIG_INTEL_DATAPATH_DBG)
-			dump_pmac_egcfg(ep, &egcfg);
-#endif
-		}
-	}
-
-	return DP_SUCCESS;
