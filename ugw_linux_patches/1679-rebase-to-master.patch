-
-	bp_info = get_dp_bp_info(inst, bp);
-
-	if (flags & DP_F_DEREGISTER) {
-		dp_ctp_dev_list_del(&bp_info->ctp_dev, sif->ctp_dev);
-		sif->ctp_dev = NULL;
-		bp_info->ref_cnt--;
-		if (!bp_info->ref_cnt) {
-			bp_info->dev = NULL;
