-/* Free one GSWIP bridge port
- * First read out its port member
- * according to this port memeber, from this deleing bridge port
- * from its member's member Free this bridge port
- */
-int dp_gsw_free_bp(int inst, int bp)
-{
-	struct core_ops *gsw_ops = dp_port_prop[inst].ops[0];
-	GSW_BRIDGE_portConfig_t *bp_cfg, *tmp2 = NULL;
-	GSW_BRIDGE_portAlloc_t bp_alloc = {0};
-	struct device *devm = &g_dp_dev->dev;
-	struct brdgport_ops *gsw_bp;
-	int i, j;
-
-	if (bp == CPU_BP)
-		return DP_SUCCESS;
-
-	gsw_bp = &gsw_ops->gsw_brdgport_ops;
-
-	bp_cfg = devm_kzalloc(devm, sizeof(*bp_cfg), GFP_ATOMIC);
-	if (!bp_cfg)
-		goto exit;
-
-	tmp2 = devm_kzalloc(devm, sizeof(*tmp2), GFP_ATOMIC);
-	if (!tmp2)
-		goto exit;
-
-	/* Read out this delting bridge port's member */
-	bp_cfg->nBridgePortId = bp;
-	bp_cfg->eMask = GSW_BRIDGE_PORT_CONFIG_MASK_BRIDGE_PORT_MAP;
-	if (gsw_bp->BridgePort_ConfigGet(gsw_ops, bp_cfg)) {
-		pr_err("%s GSW_BRIDGE_PORT_CONFIG_GET: %d\n",
-		       __func__, bp);
-		goto err;
-	}
-
-	/* Remove this delting bridgeport from other bridge port's member*/
-	for (i = 0; i < ARRAY_SIZE(bp_cfg->nBridgePortMap); i++) {
-		for (j = 0; j < 16; j++) {
-			if (!(bp_cfg->nBridgePortMap[i] & BIT(j)))
-				continue; /*not member bit set */
-			memset(tmp2->nBridgePortMap, 0,
-			       sizeof(tmp2->nBridgePortMap));
-			tmp2->eMask =
-				GSW_BRIDGE_PORT_CONFIG_MASK_BRIDGE_PORT_MAP;
-			tmp2->nBridgePortId = i * 16 + j;
-			if (gsw_bp->BridgePort_ConfigGet(gsw_ops, tmp2)) {
-				pr_err("%s GSW_BRIDGE_PORT_CONFIG_GET fail\n",
-				       __func__);
-				goto exit;
-			}
-
-			UNSET_BP_MAP(tmp2->nBridgePortMap, bp);
-			if (gsw_bp->BridgePort_ConfigSet(gsw_ops, tmp2)) {
-				pr_err("%s GSW_BRIDGE_PORT_CONFIG_SET fail\n",
-				       __func__);
-				goto exit;
-			}
-		}
-	}
-err:
-	bp_alloc.nBridgePortId = bp;
-	if (gsw_bp->BridgePort_Free(gsw_ops, &bp_alloc))
-		pr_err("%s GSW_BRIDGE_PORT_FREE: %d\n", __func__, bp);
-exit:
-	devm_kfree(devm, bp_cfg);
-	devm_kfree(devm, tmp2);
-
-	return DP_SUCCESS;
-}
