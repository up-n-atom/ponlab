-		cfg->cqm_deq_port =
-			get_cqm_deq_port_by_node(cfg->inst, node_id);
-	} else if (S_NODE(sch_stat->parent.type)) {
-		for (i = 0; i < DP_MAX_SCH_LVL - 1; i++) {
-			node_id = sch_stat->parent.node_id;
