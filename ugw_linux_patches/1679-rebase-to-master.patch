-int dp_get_lct_cnt(int inst, int dp_port, int flag,
-		   u32 *lct_idx, struct dp_lct_rx_cnt *dp_lct_rx_count)
-{
-	struct pmac_port_info *port_info = get_dp_port_info(inst, dp_port);
-	struct dp_lct_rx_cnt *stats;
