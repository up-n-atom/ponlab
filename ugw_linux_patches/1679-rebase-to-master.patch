-		       __func__, inst, qid);
-		return DP_FAILURE;
-	}
-
-	q_info->ref_cnt--;
-	if (q_info->flag && !q_info->ref_cnt) {
-		DP_DEBUG(DP_DBG_FLAG_REG, "Free qid %d\n", qid);
-		node.id.q_id = qid;
-		/*if no subif using this queue, need to delete it*/
