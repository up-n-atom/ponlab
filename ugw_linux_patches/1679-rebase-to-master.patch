-/* API to enable GSWIP PCE processing */
-static int dp_gsw_pce_enable(int inst, int ep, u32 flags)
-{
-	struct qos_ops *gsw_qos;
-	GSW_QoS_queuePort_t q_map = {0};
-	int i = 0;
-	struct core_ops *gsw_ops = dp_port_prop[inst].ops[0];
-
-	gsw_qos = &gsw_ops->gsw_qos_ops;
-
-	/* Disable Ingress PCE Bypass for Port (PON/Eth) TC 0 .. 3 */
-	for (i = 0; i <= 3; i++) {
-		q_map.nPortId = ep;
-		q_map.nTrafficClassId = i;
-		if (gsw_qos->QoS_QueuePortGet(gsw_ops, &q_map)) {
-			pr_err("%s: Fail in QoS_QueuePortGet\n", __func__);
-			return DP_FAILURE;
-		}
-		q_map.bEnableIngressPceBypass = 0;
-		if (gsw_qos->QoS_QueuePortSet(gsw_ops, &q_map)) {
-			pr_err("%s: Fail in QoS_QueuePortSet\n", __func__);
-			return DP_FAILURE;
-		}
-	}
-
-	return DP_SUCCESS;
