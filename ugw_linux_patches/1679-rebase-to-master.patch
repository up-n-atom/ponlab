-		pr_err("cqm_get_dflt_resv failed\n");
-		return DP_FAILURE;
-	}
-	p->tx.headroom_size = resv.headroom;
-	p->tx.tailroom_size = resv.tailroom;
-EXIT:
-	if (!spl_gpid) {
