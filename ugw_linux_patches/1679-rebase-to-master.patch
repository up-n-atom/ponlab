-		pce.action.bRtDstIpMaskCmp_Action = 1;
-		pce.action.bRtSrcIpMaskCmp_Action = 1;
-		pce.action.bRtDstPortMaskCmp_Action = 1;
-		pce.action.bRtSrcPortMaskCmp_Action = 1;
-
-		pce.action.bRMON_Action = 1;
