-
-		node_id = sch_stat->parent.node_id;
-		cfg->cqm_deq_port =
-				get_cqm_deq_port_by_node(cfg->inst, node_id);
-	} else {
-		pr_err("%s invalid parent type\n", __func__);
-		return DP_FAILURE;
-	}
-
-	return DP_SUCCESS;
