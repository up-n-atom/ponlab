 {
-	int inst = dp_get_inst_via_module(owner, port_id, 0);
+	int inst;
+
+	if (unlikely(!dp_init_ok)) {
+		pr_err("%s failed: datapath not initialized yet\n", __func__);
+		return DP_FAILURE;
+	}
+
+	if (!owner || is_invalid_port(port_id))
+		return DP_FAILURE;
+
