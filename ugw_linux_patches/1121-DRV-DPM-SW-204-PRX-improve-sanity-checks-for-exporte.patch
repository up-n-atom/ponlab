+		return DP_FAILURE;
+	}
+
 	if (!info || is_invalid_inst(info->inst) ||
 	    is_invalid_port(info->dp_port)) {
 		pr_err("dp_update_subif failed, info not valid\n");
@@ -1254,7 +1286,17 @@ EXPORT_SYMBOL(dp_alloc_port_ext);
