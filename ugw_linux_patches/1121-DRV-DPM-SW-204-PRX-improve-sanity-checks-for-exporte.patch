From bff74736f0170d366fd10c0278cb55534355eec3 Mon Sep 17 00:00:00 2001
From: Shahed Shaikh <shahedx.shaikh@intel.com>
Date: Thu, 19 Mar 2020 14:16:47 +0800
Subject: [PATCH] DRV_DPM_SW-204: PRX improve sanity checks for exported APIs

- Add sanity check in exported APIs to check if DPM is initialized.
- Add new globle variable to mark CPU init is done.
- Check for valid inst and other arguments.

Signed-off-by: Shahed Shaikh <shahedx.shaikh@intel.com>
---
 drivers/net/datapath/dpm/datapath.h              |   1 +
 drivers/net/datapath/dpm/datapath_api.c          | 130 +++++++++++++++--
 drivers/net/datapath/dpm/datapath_misc.c         |  42 +++++-
 drivers/net/datapath/dpm/datapath_qos.c          | 178 ++++++++++++++++++++---
 drivers/net/datapath/dpm/datapath_swdev.c        |  10 ++
 drivers/net/datapath/dpm/datapath_tx.c           |   5 +
 drivers/net/datapath/dpm/gswip31/datapath_misc.c |   2 +
 7 files changed, 329 insertions(+), 39 deletions(-)

diff --git a/drivers/net/datapath/dpm/datapath.h b/drivers/net/datapath/dpm/datapath.h
index 1f7196ef094e..8f254310fa90 100644
--- a/drivers/net/datapath/dpm/datapath.h
+++ b/drivers/net/datapath/dpm/datapath.h
@@ -987,6 +987,7 @@ int dp_request_inst(struct dp_inst_info *info, u32 flag);
 int register_dp_cap(u32 flag);
 int bp_pmapper_dev_get(int inst, struct net_device *dev);
 extern int dp_init_ok;
+extern int dp_cpu_init_ok;
 void set_chksum(struct pmac_tx_hdr *pmac, u32 tcp_type,
 		u32 ip_offset, int ip_off_hw_adjust, u32 tcp_h_offset);
 
