From 0320925e227ba712ea2c2991d26ff5e895c2d2cd Mon Sep 17 00:00:00 2001
From: Elad Fernandes <elad.fernandes@intel.com>
Date: Wed, 4 Nov 2020 15:49:37 +0200
Subject: [PATCH] LMTSYS-3744: cloning the skb extension in case of IP
 fragmentation in LGM

---
 drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c b/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c
index 1ca346416945..5748f51cc60f 100644
--- a/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c
+++ b/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c
@@ -2162,8 +2162,10 @@ static bool __smgr_is_sess_supported(struct sess_info *s)
 		goto not_supported;
 	}
 
-	if (!__smgr_is_frag_supported(s))
+	if (!__smgr_is_frag_supported(s)) {
+		pr_debug("unsupported IP frag\n");
 		goto not_supported;
+	}
 
 	if (!__smgr_is_ipv6_ext_supported(s)) {
 		pr_debug("unsupported modifications in the ipv6 extension header\n");
