From c3f1eec6c0584180cb9cb65cda853a96b19ee175 Mon Sep 17 00:00:00 2001
From: Elad Fernandes <elad.fernandes@intel.com>
Date: Wed, 25 Nov 2020 15:31:15 +0200
Subject: [PATCH] LMTSYS-4321: [PPV4 LGM] fixing the ppv4 recipe pppoe diff
 value for ipv6 headers

---
 .../ppv4/pp-api/pp-session-mgr/pp_session_mgr.c    | 25 +++++++++-------------
 1 file changed, 10 insertions(+), 15 deletions(-)

diff --git a/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c b/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c
index 15d6bf07e055..c6802b87de68 100644
--- a/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c
+++ b/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c
@@ -2561,8 +2561,7 @@ static void __smgr_si_newhdr_set(struct sess_info *s)
 		dpu->nhdr_sz = pktprs_hdr_off(SESS_TX_PKT(s), tx_inner_ip,
 					      HDR_INNER);
 		sce->tot_len_diff = dpu->nhdr_sz - dpu->nhdr_l3_off;
-		if (tx_ip == PKTPRS_PROTO_IPV6 &&
-		    tx_inner_ip == PKTPRS_PROTO_IPV4)
+		if (tx_ip == PKTPRS_PROTO_IPV6)
 			sce->tot_len_diff -= sizeof(struct ipv6hdr);
 	} else if (SESS_TX_IS_OUTER_ESP(s)) {
 		/* esp session */
@@ -2849,9 +2848,9 @@ static void __smgr_pppoe_mod_set(struct sess_info *s)
 	if (__smgr_is_pppoe_outer_encap(s) ||
 	    (__smgr_is_pppoe_bypass(s) && __smgr_is_outer_l2_changed(s))) {
 		/* pppoe encapsulation, set the sce parameters so that
-		* the recipe will calculate the pppoe header length and
-		* will update the new header accordingly
-		*/
+		 * the recipe will calculate the pppoe header length and
+		 * will update the new header accordingly
+		 */
 		sce->pppoe_diff = 2; /* for the eth last protocol */
 		sce->l2_org_val = 0;
 		/* in case we have ipv6 we must add
@@ -2859,12 +2858,14 @@ static void __smgr_pppoe_mod_set(struct sess_info *s)
 		 * cause its length field doesn't include it
 		 */
 		if (SESS_TX_IS_OUTER_V6(s)) {
-			sce->pppoe_diff += sizeof(struct ipv6hdr);
+			if (__smgr_is_iptun_encp_sess(s))
+				sce->pppoe_diff += sizeof(struct ipv6hdr);
 			dpu->lyr_fld_off =
 				offsetof(struct ipv6hdr, payload_len);
 		} else {
 			dpu->lyr_fld_off = offsetof(struct iphdr, tot_len);
 		}
+		/* set the pppoe header offset */
 		dpu->pppoe_off = pktprs_hdr_off(SESS_TX_PKT(s),
 						PKTPRS_PROTO_PPPOE,
 						HDR_OUTER);
@@ -2873,17 +2874,11 @@ static void __smgr_pppoe_mod_set(struct sess_info *s)
 
 	if (__smgr_is_pppoe_inner_encap(s)) {
 		/* pppoe encapsulation, set the sce parameters so that
-		* the recipe will calculate the pppoe header length and
-		* will update the new header accordingly
-		*/
+		 * the recipe will calculate the pppoe header length and
+		 * will update the new header accordingly
+		 */
 		sce->pppoe_diff = 2; /* for the eth last protocol */
 		sce->l2_org_val = 0;
-		/* in case we have ipv6 we must add
-		 * the ipv6 header length also to the pppoe_diff
-		 * cause its length field doesn't include it
-		 */
-		if (SESS_TX_IS_INNER_V6(s))
-			sce->pppoe_diff += sizeof(struct ipv6hdr);
 		dpu->pppoe_off = pktprs_hdr_off(SESS_TX_PKT(s),
 						PKTPRS_PROTO_PPPOE,
 						HDR_INNER);
