-/**
- * @brief configure init sequence to PPV4 FPGA
- *
- * @param data pointer private data
- * @param val returned value
- *
- * @return 0 on success, non-zero value otherwise
- */
-static s32 dbg_init_show(void *data, u64 *val)
-{
-	if (unlikely(!val))
-		return -EPERM;
-
-	if (!capable(CAP_SYS_PACCT))
-		return -EPERM;
-
-	pr_info("0. init_all\n");
-	pr_info("1. init_bm\n");
-	pr_info("2. init_qos\n");
-	pr_info("3. init_port_mgr\n");
-	pr_info("4. init_misc\n");
-
-	*val = 0;
-
-	return 0;
-}
-
-static s32 dbg_init_set(void *data, u64 val)
-{
-	if (!capable(CAP_SYS_PACCT))
-		return -EPERM;
-
-	switch (val) {
-	case 0:
-		__bm_init();
-		__qos_init();
-		__port_mng_init();
-		__misc_init();
-		break;
-	case 1:
-		__bm_init();
-		break;
-	case 2:
-		__qos_init();
-		break;
-	case 3:
-		__port_mng_init();
-		break;
-	case 4:
-		__misc_init();
-		break;
-	default:
-		pr_info("Invalid command\n");
-		break;
-	}
-
-	return 0;
-}
-
