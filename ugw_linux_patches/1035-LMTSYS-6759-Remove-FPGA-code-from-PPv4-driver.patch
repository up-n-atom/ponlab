-s32 fpga_ppv4_dbg_init(struct dentry *parent)
-{
-	struct dentry *dent;
-
-	if (unlikely(!debugfs_initialized())) {
-		pr_err("Debugfs not initialized yet\n");
-		return -EPERM;
-	}
-
-	/* init debugfs dir */
-	dir = debugfs_create_dir("init", parent);
-	if (unlikely(!dir)) {
-		pr_err("Failed to create debugfs dir\n");
-		return -ENOMEM;
-	}
-
-	dent = debugfs_create_file_unsafe("init", 0600,
-					  dir, NULL,
-					  &init_fops);
-
-	if (unlikely(IS_ERR_OR_NULL(dent)))
-		goto err;
-
-	return 0;
-err:
-	pr_err("debugfs file error\n");
-	return ((s32)PTR_ERR(dent));
-}
