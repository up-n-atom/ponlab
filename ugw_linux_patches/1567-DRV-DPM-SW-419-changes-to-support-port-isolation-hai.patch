-int dp_swdev_bridge_port_flags_set(int inst, int bport, unsigned long flags)
+/* API to set bridge port hairpin mode */
+static int dp_swdev_bp_hairpin_set(int bport, GSW_BRIDGE_portConfig_t *bpcfg,
+				   struct br_info *br_item, bool hairpin)
+{
+	struct bridge_member_port *bport_list = NULL;
+
+	/* add current BP into its own bridge port map to receive its
+	 * own traffic back
+	 */
+	bpcfg->eMask |= GSW_BRIDGE_PORT_CONFIG_MASK_BRIDGE_PORT_MAP;
+	list_for_each_entry(bport_list, &br_item->bp_list, list) {
+		if (bport_list->bportid != bport)
+			continue;
+		if (hairpin) {
+			DP_DEBUG(DP_DBG_FLAG_SWDEV, "%s:set hairpin BP=%d\n",
+				 __func__, bport);
+			SET_BP_MAP(bpcfg->nBridgePortMap, bport);
+		} else {
+			DP_DEBUG(DP_DBG_FLAG_SWDEV, "%s:unset hairpin BP=%d\n",
+				 __func__, bport);
+			UNSET_BP_MAP(bpcfg->nBridgePortMap, bport);
+		}
+	}
+	return 0;
+}
+
+/* API to configure bridge port isolation */
+static int dp_swdev_bp_isolate_set(int inst, int bport, struct br_info *br_item,
+				   bool isolate)
+{
+	GSW_return_t ret;
+	struct bridge_member_port *bport_list = NULL;
+	struct core_ops *gsw_handle;
+	struct brdgport_ops *gsw_bp;
+	GSW_BRIDGE_portConfig_t bpcfg = {0};
+
+	gsw_handle = dp_port_prop[inst].ops[0];
+	gsw_bp = &gsw_handle->gsw_brdgport_ops;
+
+	DP_DEBUG(DP_DBG_FLAG_SWDEV, "%s: config isolation for BP=%d\n",
+		 __func__, bport);
+	/* Remove current bp from all other bridge port's port map
+	 * to isolate them from bridging
+	 */
+	list_for_each_entry(bport_list, &br_item->bp_list, list) {
+		if (bport_list->bportid == bport)
+			continue;
+		bpcfg.nBridgePortId = bport_list->bportid;
+		bpcfg.eMask = GSW_BRIDGE_PORT_CONFIG_MASK_BRIDGE_PORT_MAP;
+		ret = gsw_bp->BridgePort_ConfigGet(gsw_handle, &bpcfg);
+		if (ret != GSW_statusOk) {
+			pr_err("%s: bridge port config get failed\n", __func__);
+			return -1;
+		}
+		if (isolate) {
+			DP_DEBUG(DP_DBG_FLAG_SWDEV,
+				 "%s:set isolation for BP:%d\n",
+				 __func__, bport_list->bportid);
+			UNSET_BP_MAP(bpcfg.nBridgePortMap, bport);
+		} else {
+			DP_DEBUG(DP_DBG_FLAG_SWDEV,
+				 "%s:reset isolation for BP:%d\n",
+				 __func__, bport_list->bportid);
+			SET_BP_MAP(bpcfg.nBridgePortMap, bport);
+		}
+		ret = gsw_bp->BridgePort_ConfigSet(gsw_handle, &bpcfg);
+		if (ret != GSW_statusOk) {
+			pr_err("%s: config bridge port set failed\n", __func__);
+			return -1;
+		}
+	}
+	return 0;
+}
+
+int dp_swdev_bridge_port_flags_set(struct br_info *br_item, int inst, int bport,
+				   unsigned long flags)
 {
 	GSW_return_t ret;
 	GSW_BRIDGE_portConfig_t bpcfg = {0};
@@ -311,10 +386,23 @@ int dp_swdev_bridge_port_flags_set(int inst, int bport, unsigned long flags)
 	gsw_bp = &gsw_handle->gsw_brdgport_ops;
 
 	bpcfg.nBridgePortId = bport;
-	bpcfg.eMask |= GSW_BRIDGE_PORT_CONFIG_MASK_MC_SRC_MAC_LEARNING;
+	bpcfg.eMask |= GSW_BRIDGE_PORT_CONFIG_MASK_MC_SRC_MAC_LEARNING |
+			GSW_BRIDGE_PORT_CONFIG_MASK_BRIDGE_PORT_MAP;
 	ret = gsw_bp->BridgePort_ConfigGet(gsw_handle, &bpcfg);
 	if (ret != GSW_statusOk) {
-		pr_err("%s: bridge port configi get failed\r\n", __func__);
+		pr_err("%s: bridge port config get failed\r\n", __func__);
+		return -1;
+	}
+
+	if (dp_swdev_bp_hairpin_set(bport, &bpcfg, br_item,
+				    (flags & BR_HAIRPIN_MODE))) {
+		pr_err("%s: bridge port hairpin cfg fail\n", __func__);
+		return -1;
+	}
+
+	if (dp_swdev_bp_isolate_set(inst, bport, br_item,
+				    (flags & BR_ISOLATED))) {
+		pr_err("%s: bridge port isolation cfg fail\n", __func__);
 		return -1;
 	}
 
@@ -323,14 +411,13 @@ int dp_swdev_bridge_port_flags_set(int inst, int bport, unsigned long flags)
 		bpcfg.bSrcMacLearningDisable = !bpcfg.bSrcMacLearningDisable;
 		bpcfg.eMask |= GSW_BRIDGE_PORT_CONFIG_MASK_MC_SRC_MAC_LEARNING;
 	}
-
 	ret = gsw_bp->BridgePort_ConfigSet(gsw_handle, &bpcfg);
 	if (ret != GSW_statusOk) {
 		pr_err("%s: config bridge port failed\r\n", __func__);
 		return -1;
 	}
 
-	return ret;
+	return 0;
 }
 
 int dp_swdev_bridge_port_flags_get(int inst, int bport, unsigned long *flags)
@@ -347,7 +434,7 @@ int dp_swdev_bridge_port_flags_get(int inst, int bport, unsigned long *flags)
 	bpcfg.eMask |= GSW_BRIDGE_PORT_CONFIG_MASK_MC_SRC_MAC_LEARNING;
 	ret = gsw_bp->BridgePort_ConfigGet(gsw_handle, &bpcfg);
 	if (ret != GSW_statusOk) {
-		pr_err("%s: bridge port configi get failed\r\n", __func__);
+		pr_err("%s: bridge port config get failed\r\n", __func__);
 		return -1;
 	}
 
