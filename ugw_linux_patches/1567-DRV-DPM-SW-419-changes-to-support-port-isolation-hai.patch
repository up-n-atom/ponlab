+				*flags |= bmp->isolate ? BR_ISOLATED : 0;
+				break;
+			}
+		}
+	}
+	rcu_read_unlock();
+
 	i_info = &dp_port_prop[subif.inst].info;
 	if (i_info->swdev_bridge_port_flags_get)
 		return i_info->swdev_bridge_port_flags_get(subif.inst,
