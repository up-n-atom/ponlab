+static void dp_set_bp_flags(unsigned long flags, struct bridge_member_port *bmp)
+{
+	if (flags & BR_HAIRPIN_MODE)
+		bmp->hairpin = 1;
+	else
+		bmp->hairpin = 0;
+
+	if (flags & BR_ISOLATED)
+		bmp->isolate = 1;
+	else
+		bmp->isolate = 0;
+
+	DP_DEBUG(DP_DBG_FLAG_SWDEV, "%s:BP=%d hairpin=%d isolate=%d\n",
+		 __func__, bmp->bportid, bmp->hairpin, bmp->isolate);
+}
+
 static int dp_swdev_port_attr_bridge_flags_set(struct net_device *dev,
 					       unsigned long flags,
 					       struct switchdev_trans *trans)
 {
 	struct inst_info *i_info;
 	dp_subif_t subif;
+	struct net_device *br_dev;
+	struct bridge_member_port *bmp;
+	struct br_info *br_info;
+
+	br_dev = netdev_master_upper_dev_get(dev);
+	if (!br_dev)
+		return -1;
 
 	if (switchdev_trans_ph_prepare(trans))
 		return DP_SUCCESS;
@@ -868,11 +891,28 @@ static int dp_swdev_port_attr_bridge_flags_set(struct net_device *dev,
 		return -EINVAL;
 	}
 
+	DP_LIB_LOCK(&dp_lock);
+	br_info = dp_swdev_bridge_entry_lookup_rcu(br_dev);
+	if (br_info) {
+		list_for_each_entry(bmp, &br_info->bp_list, list) {
+			if (bmp->bportid == subif.bport) {
+				dp_set_bp_flags(flags, bmp);
+				break;
+			}
+		}
+	}
 	i_info = &dp_port_prop[subif.inst].info;
-	if (i_info->swdev_bridge_port_flags_set)
-		return i_info->swdev_bridge_port_flags_set(subif.inst,
-						  subif.bport, flags);
-
+	if (!i_info->swdev_bridge_port_flags_set)
+		goto EXIT;
+	if(i_info->swdev_bridge_port_flags_set(br_info, subif.inst, subif.bport,
+					       flags)) {
+		goto EXIT;
+	} else {
+		DP_LIB_UNLOCK(&dp_lock);
+		return DP_SUCCESS;
+	}
+EXIT:
+	DP_LIB_UNLOCK(&dp_lock);
 	return -EOPNOTSUPP;
 }
 
