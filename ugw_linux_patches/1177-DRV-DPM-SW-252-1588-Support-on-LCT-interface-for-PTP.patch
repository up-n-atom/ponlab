From 9f3915588605afadf4f110a3be1c6615a5d64980 Mon Sep 17 00:00:00 2001
From: thampan <joby.thampan@intel.com>
Date: Thu, 21 May 2020 15:42:05 +0800
Subject: [PATCH] DRV_DPM_SW-252: 1588 Support on LCT interface for PTP over
 UDP

---
 drivers/net/datapath/dpm/datapath_api.c   | 14 -----------
 drivers/net/datapath/dpm/datapath_ioctl.c | 40 +++++++++++++++++--------------
 drivers/net/datapath/dpm/datapath_proc.c  |  5 +++-
 3 files changed, 26 insertions(+), 33 deletions(-)

diff --git a/drivers/net/datapath/dpm/datapath_api.c b/drivers/net/datapath/dpm/datapath_api.c
index a8c2c8cf29b6..901ae74aef52 100644
--- a/drivers/net/datapath/dpm/datapath_api.c
+++ b/drivers/net/datapath/dpm/datapath_api.c
@@ -267,20 +267,6 @@ struct pmac_port_info *get_port_info_via_dp_port(int inst, int dp_port)
 	return NULL;
 }
 
-struct pmac_port_info *get_port_info_via_dev(struct net_device *dev)
-{
-	int i;
-	int inst = dp_get_inst_via_dev(dev, NULL, 0);
-
-	for (i = 0; i < dp_port_prop[inst].info.cap.max_num_dp_ports; i++) {
-		struct pmac_port_info *port = get_dp_port_info(inst, i);
-
-		if ((port->status & PORT_DEV_REGISTERED) && port->dev == dev)
-			return port;
-	}
-	return NULL;
-}
-
 int8_t parser_size(int8_t v)
 {
 	if (v == DP_PARSER_F_DISABLE)
diff --git a/drivers/net/datapath/dpm/datapath_ioctl.c b/drivers/net/datapath/dpm/datapath_ioctl.c
index da04af6f5848..4e78fdfdc855 100644
--- a/drivers/net/datapath/dpm/datapath_ioctl.c
+++ b/drivers/net/datapath/dpm/datapath_ioctl.c
@@ -90,6 +90,7 @@ static int dp_ndo_ptp_ioctl(struct net_device *dev,
 	int inst = 0;
 	struct pmac_port_info *port;
 	struct dp_dev *dp_dev = NULL;
+	dp_subif_t subif;
 
 	dp_dev = dp_dev_lookup(dev);
 	if (!dp_dev) {
@@ -106,32 +107,35 @@ static int dp_ndo_ptp_ioctl(struct net_device *dev,
 		return err;
 	}
 
-	port = get_port_info_via_dev(dev);
-	if (!port)
+	if (dp_get_netif_subifid(dev, NULL, NULL, NULL, &subif, 0)) {
+		pr_err("%s DP get subifid fail\n", __func__);
 		return -EFAULT;
+	}
 
-	ops = dp_port_prop[inst].mac_ops[port->port_id];
+	port = get_dp_port_info(0, subif.port_id);
+
+	ops = dp_port_prop[inst].mac_ops[subif.port_id];
 	if (!ops)
 		return -EFAULT;
 
 	switch (cmd) {
-		case SIOCSHWTSTAMP: {
-			err = ops->set_hwts(ops, ifr);
-			if (err < 0) {
-				port->f_ptp = 0;
-				break;
-			}
-			port->f_ptp = 1;
-			DP_DEBUG(DP_DBG_FLAG_DBG,
-				 "PTP in SIOCGHWTSTAMP done\n");
-			}
-			break;
-		case SIOCGHWTSTAMP: {
-			ops->get_hwts(ops, ifr);
-			DP_DEBUG(DP_DBG_FLAG_DBG,
-				 "PTP in SIOCGHWTSTAMP done\n");
+	case SIOCSHWTSTAMP:
+		err = ops->set_hwts(ops, ifr);
+		if (err < 0) {
+			port->f_ptp = 0;
 			break;
 		}
+		port->f_ptp = 1;
+		DP_DEBUG(DP_DBG_FLAG_DBG,
+			 "PTP in SIOCGHWTSTAMP done\n");
+		break;
+	case SIOCGHWTSTAMP:
+		ops->get_hwts(ops, ifr);
+		DP_DEBUG(DP_DBG_FLAG_DBG,
+			 "PTP in SIOCGHWTSTAMP done\n");
+		break;
+	default:
+		break;
 	}
 
 	return err;
diff --git a/drivers/net/datapath/dpm/datapath_proc.c b/drivers/net/datapath/dpm/datapath_proc.c
index d31af046a9cb..72021b6f0ea8 100644
--- a/drivers/net/datapath/dpm/datapath_proc.c
+++ b/drivers/net/datapath/dpm/datapath_proc.c
@@ -217,7 +217,10 @@ int proc_port_dump(struct seq_file *s, int pos)
 	int loop;
 	struct inst_info *info = NULL;
 	struct dma_chan_info *dma;
-	struct cqm_port_info *cqm, *cqm_info;
+	struct cqm_port_info *cqm;
+#if REINSERTION_NEWQMAP_ENABLE
+	struct cqm_port_info *cqm_info;
+#endif
 
 	if (!capable(CAP_SYS_PACCT))
 		return -1;
