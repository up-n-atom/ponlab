From f14b933b8806a1ecf2628f657c919a5d7b60c10c Mon Sep 17 00:00:00 2001
From: Gu Chao <gux.chao@intel.com>
Date: Tue, 24 Mar 2020 11:53:22 +0800
Subject: [PATCH] DRV_DPM_SW-212: DPM Fix issue of wrong port id when calling
 dp notifier

---
 drivers/net/datapath/dpm/datapath_api.c | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/drivers/net/datapath/dpm/datapath_api.c b/drivers/net/datapath/dpm/datapath_api.c
index 0a27dba806e2..06f36b3ead80 100644
--- a/drivers/net/datapath/dpm/datapath_api.c
+++ b/drivers/net/datapath/dpm/datapath_api.c
@@ -1088,6 +1088,7 @@ int32_t dp_update_subif_info(struct dp_subif_upd_info *info)
 					 GFP_ATOMIC);
 	if (!old_subif_id_sync)
 		goto exit;
+	old_subif_id_sync->port_id = info->dp_port;
 	dp_sync_subifid(old_dev, NULL, old_subif_id_sync, &old_data,
 			DP_F_DEREGISTER, &f_old_subif);
 	/* no need any DQ port modification if prev & new tcont are same */
@@ -1120,6 +1121,7 @@ int32_t dp_update_subif_info(struct dp_subif_upd_info *info)
 		devm_kfree(&g_dp_dev->dev, old_subif_id_sync);
 		goto exit;
 	}
+	new_subif_id_sync->port_id = info->dp_port;
 	dp_sync_subifid(sif->netif, NULL, new_subif_id_sync, &new_data, 0,
 			&f_new_subif);
 	DP_LIB_UNLOCK(&dp_lock);
@@ -1467,6 +1469,7 @@ int32_t dp_register_subif_ext(int inst, struct module *owner,
 		DP_LIB_UNLOCK(&dp_lock);
 		return DP_FAILURE;
 	}
+	subif_id_sync->port_id = port_id;
 	dp_sync_subifid(dev, subif_name, subif_id_sync, data, flags, &f_subif);
 	DP_LIB_UNLOCK(&dp_lock);
 	if (!res)
