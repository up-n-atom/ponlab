From 7756b7449436fb8c26174834627cb77580933321 Mon Sep 17 00:00:00 2001
From: Elad Fernandes <elad.fernandes@intel.com>
Date: Sun, 26 Apr 2020 11:36:25 +0300
Subject: [PATCH] PONRTSYS-7747: changing the DF mask bits logic

---
 drivers/net/ppv4/pp-hal/session-info/pp_si.h | 15 ++++++++++-----
 1 file changed, 10 insertions(+), 5 deletions(-)

diff --git a/drivers/net/ppv4/pp-hal/session-info/pp_si.h b/drivers/net/ppv4/pp-hal/session-info/pp_si.h
index f86ce71fe6f6..56ac4855bdcb 100644
--- a/drivers/net/ppv4/pp-hal/session-info/pp_si.h
+++ b/drivers/net/ppv4/pp-hal/session-info/pp_si.h
@@ -3,7 +3,7 @@
  * Description: PP session information (SI) definitions
  *
  * SPDX-License-Identifier: GPL-2.0-only
- * Copyright (C) 2018-2019 Intel Corporation
+ * Copyright (C) 2018-2020 Intel Corporation
  */
 
 #ifndef __PP_SI_H__
@@ -602,15 +602,20 @@ struct pp_dsi {
 	bool valid;
 };
 
+/**
+ * DF MASK bits in HW SI means:
+ * 0 - MASK the DF bit in packet (ignore DF)
+ * 1 - don't MASK the DF bit in packet (use packet DF)
+ */
 #define SI_DF_MASK_BUILD(ext_mask, int_mask) \
-	(PP_FIELD_PREP(BIT(0), ext_mask) |   \
-	 PP_FIELD_PREP(BIT(1), int_mask))
+	(PP_FIELD_PREP(BIT(0), !ext_mask) |  \
+	 PP_FIELD_PREP(BIT(1), !int_mask))
 
 #define SI_DF_MASK_GET_EXT(df_mask)          \
-		PP_FIELD_GET(BIT(0), df_mask)
+	(!PP_FIELD_GET(BIT(0), df_mask))
 
 #define SI_DF_MASK_GET_INT(df_mask)          \
-		PP_FIELD_GET(BIT(1), df_mask)
+	(!PP_FIELD_GET(BIT(1), df_mask))
 
 #define SI_IS_DPU_EXIST(si)             ((si)->dpu.nat_sz || (si)->dpu.nhdr_sz)
 #define SI_IS_BCE_EXIST(si)             (SI_IS_DPU_EXIST(si))
