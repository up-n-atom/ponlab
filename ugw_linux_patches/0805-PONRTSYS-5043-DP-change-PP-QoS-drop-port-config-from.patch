From 43f85649c3e47d311580b3d85fe435a031f2a204 Mon Sep 17 00:00:00 2001
From: Rekha Eswaran <rekha.eswaran@intel.com>
Date: Thu, 12 Sep 2019 16:11:43 +0800
Subject: [PATCH] PONRTSYS-5043 - DP change PP QoS drop port config from
 disable to enable for CBM DQ

---
 drivers/net/datapath/dpm/gswip31/datapath_ppv4.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/net/datapath/dpm/gswip31/datapath_ppv4.c b/drivers/net/datapath/dpm/gswip31/datapath_ppv4.c
index f795f3a3e3e4..f0e879bbc498 100644
--- a/drivers/net/datapath/dpm/gswip31/datapath_ppv4.c
+++ b/drivers/net/datapath/dpm/gswip31/datapath_ppv4.c
@@ -268,7 +268,7 @@ int init_ppv4_qos(int inst, int flag)
 	t->p_conf.ring_size = dp_deq_port_tbl[inst][idx].tx_ring_size;
 	t->p_conf.packet_credit_enable = 1;
 	t->p_conf.credit = dp_deq_port_tbl[inst][idx].tx_pkt_credit;
-	t->p_conf.disable = 1; /*not allowed for dequeue*/
+	t->p_conf.disable = 0; /*allowed for dequeue*/
 
 #if IS_ENABLED(CONFIG_INTEL_DATAPATH_DBG)
 	if (dp_dbg_flag & DP_DBG_FLAG_QOS) {
