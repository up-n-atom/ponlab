From 05cf13fb014ec698c7194b0d5e1b03d6b603c1a0 Mon Sep 17 00:00:00 2001
From: Xu Liang <liang.xu@intel.com>
Date: Wed, 18 Sep 2019 12:53:28 +0800
Subject: [PATCH] PONRTSYS-4996: GSW API - fix 512th multicast entry is not
 read

---
 drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c | 2 +-
 include/net/switch_api/gsw_tbl_rw.h                    | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c b/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c
index 40959b084575..14f940078e25 100644
--- a/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c
+++ b/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c
@@ -11386,7 +11386,7 @@ GSW_return_t GSW_MulticastTableEntryRead(void *cdev,
 				gswdev->msw_rinx++;
 			}
 
-			if (gswdev->msw_rinx >= gswdev->mctblsize) {
+			if (!ret && gswdev->msw_rinx >= gswdev->mctblsize) {
 				memset(parm, 0, sizeof(GSW_multicastTableRead_t));
 				parm->bLast = 1;
 				gswdev->msw_rinx = 0;
diff --git a/include/net/switch_api/gsw_tbl_rw.h b/include/net/switch_api/gsw_tbl_rw.h
index 6cb7d2e75d43..cf91d34c2033 100644
--- a/include/net/switch_api/gsw_tbl_rw.h
+++ b/include/net/switch_api/gsw_tbl_rw.h
@@ -140,7 +140,7 @@ typedef struct {
 
 /* GSWIP Table structure to access all tables */
 typedef struct {
-	u8 tbl_entry;
+	u32 tbl_entry;
 	/** Start offset mem dump purpose */
 	u32 tbl_addr;
 	u32 tbl_id;
