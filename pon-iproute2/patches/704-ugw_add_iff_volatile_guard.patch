From 62affd5317c727650230219cec6980bd426e6b64 Mon Sep 17 00:00:00 2001
From: Jitendra <jitendra@maxlinear.com>
Date: Wed, 23 Feb 2022 15:35:04 +0100
Subject: Guarded IFF_VOLATILE of iproute2 package

Avoid redefinition of the IFF_VOLATILE macro

---
 include/uapi/linux/if.h | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/include/uapi/linux/if.h b/include/uapi/linux/if.h
index b287b2a0..82da03e6 100644
--- a/include/uapi/linux/if.h
+++ b/include/uapi/linux/if.h
@@ -131,8 +131,10 @@ enum net_device_flags {
 #define IFF_ECHO			IFF_ECHO
 #endif /* __UAPI_DEF_IF_NET_DEVICE_FLAGS_LOWER_UP_DORMANT_ECHO */
 
+#ifndef IFF_VOLATILE
 #define IFF_VOLATILE	(IFF_LOOPBACK|IFF_POINTOPOINT|IFF_BROADCAST|IFF_ECHO|\
 		IFF_MASTER|IFF_SLAVE|IFF_RUNNING|IFF_LOWER_UP|IFF_DORMANT)
+#endif
 
 #define IF_GET_IFACE	0x0001		/* for querying only */
 #define IF_GET_PROTO	0x0002
