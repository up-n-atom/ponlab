diff --git a/ip/iplink_llid.c b/ip/iplink_llid.c
new file mode 100644
index 00000000..d8de9b85
--- /dev/null
+++ b/ip/iplink_llid.c
@@ -0,0 +1,184 @@
+/*		 EPON device support
+ *
+ *              This program is free software; you can redistribute it and/or
+ *              modify it under the terms of the GNU General Public License
+ *              as published by the Free Software Foundation; either version
+ *              2 of the License, or (at your option) any later version.
+ *
+ *
+ * Authors:     2019 Intel Corporation
+ *              Based on iplink_vrf.c from
+ *                      Shrijeet Mukherjee <shm@cumulusnetworks.com>
+ */
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <linux/if_link.h>
+#include <errno.h>
+
+#include "rt_names.h"
+#include "utils.h"
+#include "ip_common.h"
+
+/* The NetLink messages for EPON and type llid to add new netdev and
+ * to configure pmapper.
+ */
+enum {
+	IFLA_PON_LLID_UNSPEC,
+	IFLA_PON_LLID_IDX,
+	IFLA_PON_LLID_PMAP_PCP_DEF,
+	IFLA_PON_LLID_PMAP_PCP_0,
+	IFLA_PON_LLID_PMAP_PCP_1,
+	IFLA_PON_LLID_PMAP_PCP_2,
+	IFLA_PON_LLID_PMAP_PCP_3,
+	IFLA_PON_LLID_PMAP_PCP_4,
+	IFLA_PON_LLID_PMAP_PCP_5,
+	IFLA_PON_LLID_PMAP_PCP_6,
+	IFLA_PON_LLID_PMAP_PCP_7,
+	IFLA_PON_LLID_NUM_OF_QUEUES,
+	IFLA_PON_LLID_MAX
+};
+
+static void llid_explain(FILE *f)
+{
+	fprintf(f, "Usage: ... llid <idx> <num_of_q [4,8]> \n");
+	fprintf(f, "Usage: ... [pcp <VALUE> <QUEUE>] [pcpdef <pcp num>]\n");
+}
+
+static void explain(void)
+{
+	llid_explain(stderr);
+}
+
+static int llid_parse_opt(struct link_util *lu, int argc, char **argv,
+			   struct nlmsghdr *n)
+{
+	while (argc > 0) {
+		if (matches(*argv, "idx") == 0) {
+			__u8 idx;
+
+			NEXT_ARG();
+			if (get_u8(&idx, *argv, 0))
+				invarg("invalid epon llid index\n", *argv);
+
+			addattr8(n, 1024, IFLA_PON_LLID_IDX, idx);
+
+		} else if (matches(*argv, "pcp") == 0) {
+			__u16 pcp;
+			__u16 queue;
+
+			NEXT_ARG();
+			if (get_u16(&pcp, *argv, 0))
+				invarg("invalid pmapper pcp\n", *argv);
+
+			if (pcp >= 8) {
+				fprintf(stderr, "pcp value too big: %u\n", pcp);
+				exit(-1);
+			}
+
+			NEXT_ARG();
+			if (get_u16(&queue, *argv, 0))
+				invarg("invalid pmapper queue\n", *argv);
+
+			if (queue >= 64) {
+				fprintf(stderr, "queue value too big: %u\n", queue);
+				exit(-1);
+			}
+
+			addattr16(n, 1024, IFLA_PON_LLID_PMAP_PCP_0 + pcp,
+				  queue);
+		} else if (matches(*argv, "pcpdef") == 0) {
+			__u16 pcpdef;
+
+			NEXT_ARG();
+			if (get_u16(&pcpdef, *argv, 0))
+				invarg("invalid pmapper pcpdef\n", *argv);
+
+			if (pcpdef >= 64) {
+				fprintf(stderr, "pcpdef value too big: %u\n",
+					pcpdef);
+				exit(-1);
+			}
+
+			addattr16(n, 1024, IFLA_PON_LLID_PMAP_PCP_DEF, pcpdef);
+
+		} else if (matches(*argv, "numofqueues") == 0) {
+			__u8 num_of_queues;
+
+			NEXT_ARG();
+			if (get_u8(&num_of_queues, *argv, 0))
+				invarg("invalid epon num_of_queues\n", *argv);
+
+			if (num_of_queues > 8) {
+				fprintf(stderr, "Invalid num_of_queues value: %u\n",
+					num_of_queues);
+				exit(-1);
+			}
+
+			addattr8(n, 1024, IFLA_PON_LLID_NUM_OF_QUEUES, num_of_queues);
+
+		} else if (matches(*argv, "help") == 0) {
+			explain();
+			return -1;
+		} else {
+			fprintf(stderr, "llid: unknown option \"%s\"?\n",
+				*argv);
+			explain();
+			return -1;
+		}
+		argc--, argv++;
+	}
+
+	return 0;
+}
+
+static void llid_print_opt(struct link_util *lu, FILE *f, struct rtattr *tb[])
+{
+	__u8 idx;
+	__u8 num_of_queues;
+	__u16 pcpdef;
+	__u16 queue;
+	int i;
+
+	if (!tb)
+		return;
+
+	if (tb[IFLA_PON_LLID_IDX]) {
+		idx = rta_getattr_u8(tb[IFLA_PON_LLID_IDX]);
+		fprintf(f, "idx: %u ", idx);
+	}
+
+	if (tb[IFLA_PON_LLID_NUM_OF_QUEUES]) {
+		num_of_queues = rta_getattr_u8(tb[IFLA_PON_LLID_NUM_OF_QUEUES]);
+		fprintf(f, "num_of_queues: %u ", num_of_queues);
+	}
+
+	for (i = 0; i < 8; i++) {
+		if (tb[IFLA_PON_LLID_PMAP_PCP_0 + i]) {
+
+			queue = rta_getattr_u16(tb[IFLA_PON_LLID_PMAP_PCP_0 + i]);
+			fprintf(f, "pcp %i: %u ", i, queue);
+		}
+	}
+
+	if (tb[IFLA_PON_LLID_PMAP_PCP_DEF]) {
+		pcpdef = rta_getattr_u16(tb[IFLA_PON_LLID_PMAP_PCP_DEF]);
+		fprintf(f, "pcpdef: %u ", pcpdef);
+	}
+}
+
+static void llid_print_help(struct link_util *lu, int argc, char **argv,
+			     FILE *f)
+{
+	llid_explain(f);
+}
+
+struct link_util llid_link_util = {
+	.id		= "llid",
+	.maxattr	= IFLA_PON_LLID_MAX,
+	.parse_opt	= llid_parse_opt,
+	.print_opt	= llid_print_opt,
+	.print_help	= llid_print_help,
+};
