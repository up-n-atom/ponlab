diff --git a/ip/iplink_gem.c b/ip/iplink_gem.c
new file mode 100644
index 00000000..6051da92
--- /dev/null
+++ b/ip/iplink_gem.c
@@ -0,0 +1,286 @@
+/* iplink_gpon.c	GPON device support
+ *
+ *              This program is free software; you can redistribute it and/or
+ *              modify it under the terms of the GNU General Public License
+ *              as published by the Free Software Foundation; either version
+ *              2 of the License, or (at your option) any later version.
+ *
+ *
+ * Authors:     2017 Intel Corporation
+ *              Based on iplink_vrf.c from
+ *                      Shrijeet Mukherjee <shm@cumulusnetworks.com>
+ */
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <net/if.h>
+#include <linux/if_link.h>
+#include <errno.h>
+
+#include "rt_names.h"
+#include "utils.h"
+#include "ip_common.h"
+
+/* Ethernet (G.989), Ethernet unicast (G.984) */
+#define GEM_TRAFFIC_TYPE_ETH 0
+/* OMCI (G.984, G.989) */
+#define GEM_TRAFFIC_TYPE_OMCI 1
+/* Ethernet multicast (G.984 only) */
+#define GEM_TRAFFIC_TYPE_ETHM 2
+/* Encryption disabled (G.984, G989) */
+#define GEM_ENC_DIS 0
+/* Unicast payload encryption in both directions (G.989 only) or encrypted
+ * (G.984)
+ */
+#define GEM_ENC_UC 1
+/* Broadcast encryption (G.989 only) */
+#define GEM_ENC_BC 2
+/* Unicast encryption in downstream only (G.984, G.989) */
+#define GEM_ENC_DSEN 3
+/* Disabled (GEM port not used) */
+#define GEM_DIR_DIS 0
+/* Upstream (UNI-to-ANI) */
+#define GEM_DIR_US 1
+/* Downstream (ANI-to-UNI) */
+#define GEM_DIR_DS 2
+/* Bidirectional */
+#define GEM_DIR_BI 3
+/* Mark non-multicast GEM */
+#define GEM_MC_DIS 0
+/* Mark multicast GEM */
+#define GEM_MC_EN 1
+
+/* Netlink messages for the GEM configuration */
+enum {
+	IFLA_PON_GEM_UNSPEC,
+	IFLA_PON_GEM_IDX,
+	IFLA_PON_GEM_ID,
+	IFLA_PON_GEM_TCONT,
+	IFLA_PON_GEM_TRAFFIC_TYPE,
+	IFLA_PON_GEM_MAX_SIZE,
+	IFLA_PON_GEM_DIR,
+	IFLA_PON_GEM_ENC,
+	IFLA_PON_GEM_MC,
+	IFLA_PON_GEM_BP,
+	IFLA_PON_GEM_CTP,
+	IFLA_PON_GEM_MAX
+};
+
+static void gem_explain(FILE *f)
+{
+	fprintf(f, "Usage: ... type gem id <id> traffic_type <eth|omci|ethm> dir <dis|us|ds|bi> enc <dis|uc|bc|dsen> max_size <value> mc <en|dis>\n");
+}
+
+static void explain(void)
+{
+	gem_explain(stderr);
+}
+
+static int gem_parse_opt(struct link_util *lu, int argc, char **argv,
+			 struct nlmsghdr *n)
+{
+	while (argc > 0) {
+		if (matches(*argv, "id") == 0) {
+			__u32 gem_id;
+
+			NEXT_ARG();
+			if (get_u32(&gem_id, *argv, 0))
+				invarg("invalid gpon gem_id\n", *argv);
+
+			addattr32(n, 1024, IFLA_PON_GEM_ID, gem_id);
+		} else if (matches(*argv, "idx") == 0) {
+			__u16 gem_idx;
+
+			NEXT_ARG();
+			if (get_u16(&gem_idx, *argv, 0))
+				invarg("invalid gpon gem_idx\n", *argv);
+
+			addattr16(n, 1024, IFLA_PON_GEM_IDX, gem_idx);
+		} else if (matches(*argv, "traffic_type") == 0) {
+			__u8 gem_traffic_type;
+
+			NEXT_ARG();
+			if (strcmp(*argv, "eth") == 0) {
+				gem_traffic_type = GEM_TRAFFIC_TYPE_ETH;
+			} else if (strcmp(*argv, "omci") == 0) {
+				gem_traffic_type = GEM_TRAFFIC_TYPE_OMCI;
+			} else if (strcmp(*argv, "ethm") == 0) {
+				gem_traffic_type = GEM_TRAFFIC_TYPE_ETHM;
+			} else {
+				invarg("invalid gpon gem_traffic_type\n", *argv);
+				return -1;
+			}
+
+			addattr8(n, 1024, IFLA_PON_GEM_TRAFFIC_TYPE, gem_traffic_type);
+		} else if (matches(*argv, "dir") == 0) {
+			__u8 gem_dir;
+
+			NEXT_ARG();
+			if (strcmp(*argv, "dis") == 0) {
+				gem_dir = GEM_DIR_DIS;
+			} else if (strcmp(*argv, "us") == 0) {
+				gem_dir = GEM_DIR_US;
+			} else if (strcmp(*argv, "ds") == 0) {
+				gem_dir = GEM_DIR_DS;
+			} else if (strcmp(*argv, "bi") == 0) {
+				gem_dir = GEM_DIR_BI;
+			} else {
+				invarg("invalid gpon gem_dir\n", *argv);
+				return -1;
+			}
+
+			addattr8(n, 1024, IFLA_PON_GEM_DIR, gem_dir);
+		} else if (matches(*argv, "enc") == 0) {
+			__u8 gem_enc;
+
+			NEXT_ARG();
+			if (strcmp(*argv, "dis") == 0) {
+				gem_enc = GEM_ENC_DIS;
+			} else if (strcmp(*argv, "uc") == 0) {
+				gem_enc = GEM_ENC_UC;
+			} else if (strcmp(*argv, "bc") == 0) {
+				gem_enc = GEM_ENC_BC;
+			} else if (strcmp(*argv, "dsen") == 0) {
+				gem_enc = GEM_ENC_DSEN;
+			} else {
+				invarg("invalid gpon gem_enc\n", *argv);
+				return -1;
+			}
+
+			addattr8(n, 1024, IFLA_PON_GEM_ENC, gem_enc);
+		} else if (matches(*argv, "max_size") == 0) {
+			__u16 gem_max_size;
+
+			NEXT_ARG();
+			if (get_u16(&gem_max_size, *argv, 0))
+				invarg("invalid gpon gem_max_size\n", *argv);
+
+			addattr16(n, 1024, IFLA_PON_GEM_MAX_SIZE, gem_max_size);
+		} else if (matches(*argv, "tcont") == 0) {
+			__u32 tcont_idx;
+
+			NEXT_ARG();
+			tcont_idx = if_nametoindex(*argv);
+			if (tcont_idx == 0) {
+				fprintf(stderr, "Cannot find device \"%s\"\n",
+					*argv);
+				exit(-1);
+			}
+
+			addattr32(n, 1024, IFLA_PON_GEM_TCONT, tcont_idx);
+		} else if (matches(*argv, "dsonly") == 0) {
+			addattr32(n, 1024, IFLA_PON_GEM_TCONT, 0);
+		} else if (matches(*argv, "help") == 0) {
+			explain();
+			return -1;
+		} else if (matches(*argv, "mc") == 0) {
+			__u8 gem_mc;
+
+			NEXT_ARG();
+			if (strcmp(*argv, "en") == 0) {
+				gem_mc = GEM_MC_EN;
+			} else if (strcmp(*argv, "dis") == 0) {
+				gem_mc = GEM_MC_DIS;
+			} else {
+				invarg("invalid gpon gem_mc\n", *argv);
+				return -1;
+			}
+
+			addattr8(n, 1024, IFLA_PON_GEM_MC, gem_mc);
+		} else {
+			fprintf(stderr, "gem: unknown option \"%s\"?\n",
+				*argv);
+			explain();
+			return -1;
+		}
+		argc--, argv++;
+	}
+
+	return 0;
+}
+
+static void gem_print_opt(struct link_util *lu, FILE *f, struct rtattr *tb[])
+{
+	__u16 gem_idx;
+	__u32 gem_id;
+	__u8 gem_traffic_type;
+	__u8 gem_dir;
+	__u8 gem_enc;
+	__u16 gem_max_size;
+	__u32 tcont_idx;
+	__u8 gem_mc;
+	__u32 gem_ctp;
+	char tcont_name[IF_NAMESIZE];
+
+	if (!tb)
+		return;
+
+	if (tb[IFLA_PON_GEM_IDX]) {
+		gem_idx = rta_getattr_u16(tb[IFLA_PON_GEM_IDX]);
+		fprintf(f, "idx: %u ", gem_idx);
+	}
+	if (tb[IFLA_PON_GEM_ID]) {
+		gem_id = rta_getattr_u32(tb[IFLA_PON_GEM_ID]);
+		fprintf(f, "id: %u ", gem_id);
+	}
+	if (tb[IFLA_PON_GEM_TRAFFIC_TYPE]) {
+		gem_traffic_type = rta_getattr_u8(tb[IFLA_PON_GEM_TRAFFIC_TYPE]);
+		fprintf(f, "traffic type: %u ", gem_traffic_type);
+	}
+	if (tb[IFLA_PON_GEM_DIR]) {
+		gem_dir = rta_getattr_u8(tb[IFLA_PON_GEM_DIR]);
+		fprintf(f, "dir: %u ", gem_dir);
+	}
+	if (tb[IFLA_PON_GEM_ENC]) {
+		gem_enc = rta_getattr_u8(tb[IFLA_PON_GEM_ENC]);
+		fprintf(f, "enc: %u ", gem_enc);
+	}
+	if (tb[IFLA_PON_GEM_MAX_SIZE]) {
+		gem_max_size = rta_getattr_u16(tb[IFLA_PON_GEM_MAX_SIZE]);
+		fprintf(f, "max size: %u ", gem_max_size);
+	}
+	if (tb[IFLA_PON_GEM_TCONT]) {
+		const char *name;
+
+		tcont_idx = rta_getattr_u32(tb[IFLA_PON_GEM_TCONT]);
+		if (tcont_idx == 0) {
+			fprintf(f, "dsonly ");
+		} else {
+			name = if_indextoname(tcont_idx, tcont_name);
+
+			if (name)
+				fprintf(f, "tcont: %s ", name);
+			else
+				fprintf(f, "tcont: %u ", tcont_idx);
+		}
+	}
+	if (tb[IFLA_PON_GEM_MC]) {
+		gem_mc = rta_getattr_u8(tb[IFLA_PON_GEM_MC]);
+		fprintf(f, "mc: %u ", gem_mc);
+	}
+	if (tb[IFLA_PON_GEM_BP]) {
+		gem_mc = rta_getattr_u16(tb[IFLA_PON_GEM_BP]);
+		fprintf(f, "bp: %u ", gem_mc);
+	}
+
+	if (tb[IFLA_PON_GEM_CTP]) {
+		gem_ctp = rta_getattr_u32(tb[IFLA_PON_GEM_CTP]);
+		fprintf(f, "ctp: %u ", gem_ctp);
+	}
+}
+
+static void gem_print_help(struct link_util *lu, int argc, char **argv,
+			   FILE *f)
+{
+	gem_explain(f);
+}
+
+struct link_util gem_link_util = {
+	.id		= "gem",
+	.maxattr	= IFLA_PON_GEM_MAX,
+	.parse_opt	= gem_parse_opt,
+	.print_opt	= gem_print_opt,
+	.print_help	= gem_print_help,
+};
