+#include "utils.h"
+#include "ip_common.h"
+
+/* Use default PCP value for DSCP bit */
+#define PON_PMAPPER_DSCP_DEFAULT 0xff
+
+#define DP_PMAP_PCP 1
+#define DP_PMAP_DSCP 2
+#define DP_PMAP_DSCP_ONLY 3
+
+/** The NetLink messages the IEEE 802.1p mapper configuration. */
+enum {
+	IFLA_PON_PMAPPER_UNSPEC,
+	IFLA_PON_PMAPPER_PCP_DEF,
+	IFLA_PON_PMAPPER_PCP_0,
+	IFLA_PON_PMAPPER_PCP_1,
+	IFLA_PON_PMAPPER_PCP_2,
+	IFLA_PON_PMAPPER_PCP_3,
+	IFLA_PON_PMAPPER_PCP_4,
+	IFLA_PON_PMAPPER_PCP_5,
+	IFLA_PON_PMAPPER_PCP_6,
+	IFLA_PON_PMAPPER_PCP_7,
+	IFLA_PON_PMAPPER_MODE,
+	IFLA_PON_PMAPPER_DSCP,
+	IFLA_PON_PMAPPER_BP,
+	IFLA_PON_GEM_CTP_0,
+	IFLA_PON_GEM_CTP_1,
+	IFLA_PON_GEM_CTP_2,
+	IFLA_PON_GEM_CTP_3,
+	IFLA_PON_GEM_CTP_4,
+	IFLA_PON_GEM_CTP_5,
+	IFLA_PON_GEM_CTP_6,
+	IFLA_PON_GEM_CTP_7,
+	IFLA_PON_PMAPPER_MAX
+};
+
+enum {
+	IFLA_PON_PMAPPER_DSCP_UNSPEC,
+	IFLA_PON_PMAPPER_DSCP_0,
+	IFLA_PON_PMAPPER_DSCP_1,
+	IFLA_PON_PMAPPER_DSCP_2,
+	IFLA_PON_PMAPPER_DSCP_3,
+	IFLA_PON_PMAPPER_DSCP_4,
+	IFLA_PON_PMAPPER_DSCP_5,
+	IFLA_PON_PMAPPER_DSCP_6,
+	IFLA_PON_PMAPPER_DSCP_7,
+	IFLA_PON_PMAPPER_DSCP_8,
+	IFLA_PON_PMAPPER_DSCP_9,
+	IFLA_PON_PMAPPER_DSCP_10,
+	IFLA_PON_PMAPPER_DSCP_11,
+	IFLA_PON_PMAPPER_DSCP_12,
+	IFLA_PON_PMAPPER_DSCP_13,
+	IFLA_PON_PMAPPER_DSCP_14,
+	IFLA_PON_PMAPPER_DSCP_15,
+	IFLA_PON_PMAPPER_DSCP_16,
+	IFLA_PON_PMAPPER_DSCP_17,
+	IFLA_PON_PMAPPER_DSCP_18,
+	IFLA_PON_PMAPPER_DSCP_19,
+	IFLA_PON_PMAPPER_DSCP_20,
+	IFLA_PON_PMAPPER_DSCP_21,
+	IFLA_PON_PMAPPER_DSCP_22,
+	IFLA_PON_PMAPPER_DSCP_23,
+	IFLA_PON_PMAPPER_DSCP_24,
+	IFLA_PON_PMAPPER_DSCP_25,
+	IFLA_PON_PMAPPER_DSCP_26,
+	IFLA_PON_PMAPPER_DSCP_27,
+	IFLA_PON_PMAPPER_DSCP_28,
+	IFLA_PON_PMAPPER_DSCP_29,
+	IFLA_PON_PMAPPER_DSCP_30,
+	IFLA_PON_PMAPPER_DSCP_31,
+	IFLA_PON_PMAPPER_DSCP_32,
+	IFLA_PON_PMAPPER_DSCP_33,
+	IFLA_PON_PMAPPER_DSCP_34,
+	IFLA_PON_PMAPPER_DSCP_35,
+	IFLA_PON_PMAPPER_DSCP_36,
+	IFLA_PON_PMAPPER_DSCP_37,
+	IFLA_PON_PMAPPER_DSCP_38,
+	IFLA_PON_PMAPPER_DSCP_39,
+	IFLA_PON_PMAPPER_DSCP_40,
+	IFLA_PON_PMAPPER_DSCP_41,
+	IFLA_PON_PMAPPER_DSCP_42,
+	IFLA_PON_PMAPPER_DSCP_43,
+	IFLA_PON_PMAPPER_DSCP_44,
+	IFLA_PON_PMAPPER_DSCP_45,
+	IFLA_PON_PMAPPER_DSCP_46,
+	IFLA_PON_PMAPPER_DSCP_47,
+	IFLA_PON_PMAPPER_DSCP_48,
+	IFLA_PON_PMAPPER_DSCP_49,
+	IFLA_PON_PMAPPER_DSCP_50,
+	IFLA_PON_PMAPPER_DSCP_51,
+	IFLA_PON_PMAPPER_DSCP_52,
+	IFLA_PON_PMAPPER_DSCP_53,
+	IFLA_PON_PMAPPER_DSCP_54,
+	IFLA_PON_PMAPPER_DSCP_55,
+	IFLA_PON_PMAPPER_DSCP_56,
+	IFLA_PON_PMAPPER_DSCP_57,
+	IFLA_PON_PMAPPER_DSCP_58,
+	IFLA_PON_PMAPPER_DSCP_59,
+	IFLA_PON_PMAPPER_DSCP_60,
+	IFLA_PON_PMAPPER_DSCP_61,
+	IFLA_PON_PMAPPER_DSCP_62,
+	IFLA_PON_PMAPPER_DSCP_63,
+	IFLA_PON_PMAPPER_DSCP_MAX
+};
+
+static void pmapper_explain(FILE *f)
+{
+	fprintf(f, "Usage: ... pmapper [pcp <VALUE> <DEVICE> ] [pcpdef <pcp num>] [mode <pcp|dscp|dscp_only] [dscp <DSCP> <PCP>]\n");
+}
+
+static void explain(void)
+{
+	pmapper_explain(stderr);
+}
+
+struct dscp_values {
+	bool used;
+	__u8 dscp;
+	__u8 pcp;
+};
+
+static int pmapper_parse_opt(struct link_util *lu, int argc, char **argv,
+			     struct nlmsghdr *n)
+{
+	struct dscp_values dscp_map[64] = {0,};
+	struct rtattr *nest;
+	int i;
+
+	while (argc > 0) {
+		if (matches(*argv, "pcp") == 0) {
+			__u8 pcp;
+			__u32 gem_if_idx;
+
+			NEXT_ARG();
+			if (get_u8(&pcp, *argv, 0))
+				invarg("invalid pmapper pcp\n", *argv);
+
+			if (pcp >= 8) {
+				fprintf(stderr, "pcp value too big: %u\n", pcp);
+				exit(-1);
+			}
+
+			NEXT_ARG();
+			if (strcmp(*argv, "drop") == 0) {
+				gem_if_idx = 0;
+			} else {
+				gem_if_idx = if_nametoindex(*argv);
+				if (gem_if_idx == 0) {
+					fprintf(stderr, "Cannot find device \"%s\"\n",
+						*argv);
+					exit(-1);
+				}
+			}
+
+			addattr32(n, 1024, IFLA_PON_PMAPPER_PCP_0 + pcp,
+				  gem_if_idx);
+		} else if (matches(*argv, "dscp") == 0) {
+			__u8 dscp;
+			__u8 dscp_value;
+
+			NEXT_ARG();
+			if (get_u8(&dscp, *argv, 0))
+				invarg("invalid pmapper dscp\n", *argv);
+
+			if (dscp >= 64) {
+				fprintf(stderr, "dscp value too big: %u\n",
+					dscp);
+				exit(-1);
+			}
+
+			NEXT_ARG();
+			if (strcmp(*argv, "def") == 0) {
+				dscp_value = PON_PMAPPER_DSCP_DEFAULT;
+			} else {
+				if (get_u8(&dscp_value, *argv, 0))
+					invarg("invalid pmapper dscp_map\n",
+						*argv);
+			}
+			for (i = 0; i < ARRAY_SIZE(dscp_map); i++) {
+				if (dscp_map[i].used)
+					continue;
+				dscp_map[i].dscp = dscp;
+				dscp_map[i].pcp = dscp_value;
+				dscp_map[i].used = true;
+				break;
+			}
+		} else if (matches(*argv, "pcpdef") == 0) {
+			__u8 pcpdef;
+
+			NEXT_ARG();
+			if (get_u8(&pcpdef, *argv, 0))
+				invarg("invalid pmapper pcp\n", *argv);
+
+			if (pcpdef >= 8) {
+				fprintf(stderr, "pcp value too big: %u\n",
+					pcpdef);
+				exit(-1);
+			}
+
+			addattr8(n, 1024, IFLA_PON_PMAPPER_PCP_DEF, pcpdef);
+		} else if (matches(*argv, "mode") == 0) {
+			__u8 mode;
+
+			NEXT_ARG();
+			if (strcmp(*argv, "pcp") == 0)
+				mode = DP_PMAP_PCP;
+			else if (strcmp(*argv, "dscp") == 0)
+				mode = DP_PMAP_DSCP;
+			else if (strcmp(*argv, "dscp_only") == 0)
+				mode = DP_PMAP_DSCP_ONLY;
+			else
+				invarg("invalid pmapper mode\n", *argv);
+
+			addattr8(n, 1024, IFLA_PON_PMAPPER_MODE, mode);
+		} else if (matches(*argv, "help") == 0) {
+			explain();
+			return -1;
+		} else {
+			fprintf(stderr, "pmapper: unknown option \"%s\"?\n",
+				*argv);
+			explain();
+			return -1;
+		}
+		argc--, argv++;
+	}
+
+	if (dscp_map[0].used) {
+		nest = addattr_nest(n, 1024,
+				    IFLA_PON_PMAPPER_DSCP | NLA_F_NESTED);
+
+		for (i = 0; i < ARRAY_SIZE(dscp_map); i++) {
+			if (!dscp_map[i].used)
+				continue;
+
+			addattr8(n, 1024,
+				 IFLA_PON_PMAPPER_DSCP_0 + dscp_map[i].dscp,
+				 dscp_map[i].pcp);
+		}
+		addattr_nest_end(n, nest);
+	}
+
+	return 0;
+}
+
+static void pmapper_print_opt(struct link_util *lu, FILE *f, struct rtattr *tb[])
+{
+	__u32 gem_if_idx;
+	int i;
+	__u8 pcpdef;
+	__u8 mode = DP_PMAP_PCP;
+	char gem_name[IF_NAMESIZE];
+	struct rtattr *nest;
+	__u16 bp;
+	__u32 gem_ctp;
+
+	if (!tb)
+		return;
+
+	if (tb[IFLA_PON_PMAPPER_MODE])
+		mode = rta_getattr_u8(tb[IFLA_PON_PMAPPER_MODE]);
+
+	switch (mode) {
+	case DP_PMAP_PCP:
+		fprintf(f, "mode: pcp ");
+		break;
+	case DP_PMAP_DSCP:
+		fprintf(f, "mode: dscp ");
+		break;
+	case DP_PMAP_DSCP_ONLY:
+		fprintf(f, "mode: dscp_only ");
+		break;
+	}
+
+	for (i = 0; i < 8; i++) {
+		if (tb[IFLA_PON_PMAPPER_PCP_0 + i]) {
+			const char *name;
+
+			gem_if_idx = rta_getattr_u32(tb[IFLA_PON_PMAPPER_PCP_0 + i]);
+			name = if_indextoname(gem_if_idx, gem_name);
+
+			if (name)
+				fprintf(f, "pcp %i: %s ", i, name);
+			else
+				fprintf(f, "pcp %i: %u ", i, gem_if_idx);
+		}
+
+		if (tb[IFLA_PON_GEM_CTP_0 + i]) {
+			gem_ctp = rta_getattr_u32(tb[IFLA_PON_GEM_CTP_0 + i]);
+			fprintf(f, "ctp: %u ", gem_ctp);
+		}
+	}
+
+	if (tb[IFLA_PON_PMAPPER_PCP_DEF]) {
+		pcpdef = rta_getattr_u8(tb[IFLA_PON_PMAPPER_PCP_DEF]);
+		fprintf(f, "pcpdef: %u ", pcpdef);
+	}
+
+	if (tb[IFLA_PON_PMAPPER_BP]) {
+		bp = rta_getattr_u16(tb[IFLA_PON_PMAPPER_BP]);
+		fprintf(f, "bp: %u ", bp);
+	}
+
+	nest = tb[IFLA_PON_PMAPPER_DSCP];
+	if ((mode == DP_PMAP_DSCP || mode == DP_PMAP_DSCP_ONLY) && nest) {
+		struct rtattr *dscp[IFLA_PON_PMAPPER_DSCP_MAX + 1];
+
+		parse_rtattr_nested(dscp, IFLA_PON_PMAPPER_DSCP_MAX, nest);
+
+		fprintf(f, "\n    dscp [ ");
+		for (i = 0; i < 64; i++) {
+			__u8 dscp_map;
+
+			if (!dscp[IFLA_PON_PMAPPER_DSCP_0 + i]) {
+				fprintf(f, "-, ");
+				continue;
+			}
+
+			dscp_map = rta_getattr_u8(dscp[IFLA_PON_PMAPPER_DSCP_0 + i]);
+
+			if (dscp_map == PON_PMAPPER_DSCP_DEFAULT)
+				fprintf(f, "def, ");
+			else
+				fprintf(f, "%hhu, ", dscp_map);
+		}
+		fprintf(f, "] ");
+	}
+	fprintf(f, "\n    ");
+}
+
+static void pmapper_print_help(struct link_util *lu, int argc, char **argv,
+			   FILE *f)
+{
+	pmapper_explain(f);
+}
+
+struct link_util pmapper_link_util = {
+	.id		= "pmapper",
+	.maxattr	= IFLA_PON_PMAPPER_MAX,
+	.parse_opt	= pmapper_parse_opt,
+	.print_opt	= pmapper_print_opt,
+	.print_help	= pmapper_print_help,
+};
