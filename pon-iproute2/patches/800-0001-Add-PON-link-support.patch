From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Maxlinear <nobody@maxlinear.com>
Date: Fri, 18 Feb 2022 09:46:41 +0100
Subject: Add PON link support

This adds support for PON links with the MaxLinear PON ethernet driver.

This allows to create, modify and delete GEM ports, T-Conts, pmappers,
llids and ip host interfaces.

Get the help like this:
ip link add gem1123 type gem help
Usage: ... type gem id <id> traffic_type <eth|omci|ethm> dir <dis|us|ds|bi> enc <dis|uc|bc|dsen> max_size <value> mc <en|dis>

This is one example configuration sequence:
ip link add link pon0 tcont1033 type tcont id 1033
ip link add link pon0 gem1123 type gem id 1123 traffic_type eth dir ds enc dis
ip link set gem1123 type gem tcont tcont1033 dir bi
ip link add link pon0 pmapper1 type pmapper
ip link set pmapper1 type pmapper pcp 0 gem1123 pcp 1 gem1123 pcpdef 1

root@prx321-sfu-qspi-pon:/# ip -d link show
....
14: pon0: <BROADCAST,MULTICAST> mtu 1500 qdisc prio state DOWN mode DEFAULT group default qlen 1000
    link/ether 00:00:00:00:00:00 brd ff:ff:ff:ff:ff:ff promiscuity 0
    pon queue_lookup_mode: 1 addrgenmode eui64 numtxqueues 8 numrxqueues 8 gso_max_size 65536 gso_max_segs 65535
....
18: tcont1033@pon0: <BROADCAST,MULTICAST,M-DOWN> mtu 1500 qdisc noop state DOWN mode DEFAULT group default qlen 1000
    link/ether d6:39:da:14:e8:d6 brd ff:ff:ff:ff:ff:ff promiscuity 0
    tcont idx: 1 id: 1033 addrgenmode eui64 numtxqueues 8 numrxqueues 1 gso_max_size 65536 gso_max_segs 65535
19: gem1123@pon0: <BROADCAST,MULTICAST,M-DOWN> mtu 1500 qdisc noop state DOWN mode DEFAULT group default qlen 1000
    link/ether 3e:74:be:cf:7f:70 brd ff:ff:ff:ff:ff:ff promiscuity 0
    gem idx: 1 id: 1123 traffic type: 0 dir: 3 enc: 0 max size: 0 tcont: tcont1033 mc: 0 addrgenmode eui64 numtxqueues 1 numrxqueues 1 gso_max_size 65536 gso_max_segs 65535
20: pmapper1@pon0: <BROADCAST,MULTICAST,M-DOWN> mtu 1500 qdisc noop state DOWN mode DEFAULT group default qlen 1000
    link/ether d6:8d:e1:a1:34:5b brd ff:ff:ff:ff:ff:ff promiscuity 0
    pmapper pcp 0: gem1123 pcp 1: gem1123 pcpdef: 1 addrgenmode eui64 numtxqueues 1 numrxqueues 1 gso_max_size 65536 gso_max_segs 65535
