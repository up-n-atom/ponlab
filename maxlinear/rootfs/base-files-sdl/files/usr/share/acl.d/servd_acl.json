{
	"user": "servd",
	"group": "servd",
	"access": {
		"system": {
			"methods": [ "reboot", "factoryreset" ]
		},
		"csd": {
			"methods": [ "wr-cfg", "web-get", "web-set", "servd-get", "servd-set", "restore" ]
		},
		"uci": {
			"methods": [ "set", "get", "add", "delete", "order", "commit", "backup_restore" ]
		},
		"wsd": {
			"methods": [ "notify", "notify.status", "notify.update", "log" ]
		},
		"devmd": {
			"methods": [ "notify", "notify_default_wanup", "notify_default_wanchange", "notify_default_wandown" ]
		},
		"dwpald": {
			"methods": [ "notify" ]
		},
		"network.interface.lan": {
			"methods": [ "renew" ]
		},
		"diagnosticsd": {
			"methods": [ "ping" , "tracert" ,"nslookup" , "ping_lanhost" ]
		},
		"polld": {
			"methods": [ "get" ]
		}
	},
	"publish":[ "servd" ]
}
