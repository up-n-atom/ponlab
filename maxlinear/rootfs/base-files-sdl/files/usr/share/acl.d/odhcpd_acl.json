{
    "user": "odhcpd",
    "group": "odhcpd",
    "access": {
    "service": {
        "methods": [ "signal" ]
        },
        "network.interface": {
            "methods": [ "up", "down", "status", "prepare", "dump", "add_device", "remove_device", "notify_proto", "remove", "set_data" ]
        },
        "network": {
            "methods": [ "restart", "reload", "add_host_route", "get_proto_handlers", "add_dynamic" ]
        },
    },
    "publish":[ "dhcp" ]
}
