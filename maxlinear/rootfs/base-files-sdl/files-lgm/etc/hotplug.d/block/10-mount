[ "$ACTION" = "add" -o "$ACTION" = "remove" ] && \
	mkdir -p "/tmp/usb" && \
	mkdir -p "/tmp/blockd" && \
	mkdir -p "/tmp/mounts" && \
	/sbin/block detect > /tmp/blockd/fstab && \
	mmcdev=$(grep -rl "upgrade_partition" /sys/class/block/mmcblk0p*/uevent |cut -f5 -d/) && \
	uuid_key=$(block info | grep $mmcdev | cut -f2 -d\") && \
	uuid_lineno=$(grep -inr $uuid_key /tmp/blockd/fstab | cut -f1 -d:) && \
	config_lineno=`expr $uuid_lineno - 2` && \
	sed -ie "${config_lineno}s/mount/umount/" /tmp/blockd/fstab && \
	/sbin/block hotplug
