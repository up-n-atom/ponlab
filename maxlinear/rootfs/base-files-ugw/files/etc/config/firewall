config forwarding "LAN_TO_WAN"
	option src 'lan'
	option dest '*'

config include
        option path '/tmp/firewall/firewall.user'
        option reload '1'	

config include
        option path '/tmp/firewall/firewall.ubus'
        option reload '1'

config include
        option path '/usr/share/miniupnpd/firewall.include'
        option reload '1'	
        option type 'script'	

config include
        option path '/opt/intel/firewall/enable_lanwan_forward'
        option reload '1'

config defaults 'policy'
	option input 'DROP'
	option output 'ACCEPT'
	option forward 'DROP'
	option drop_invalid '1'
	option syn_flood '1'
	option synflood_burst '50'
	option synflood_protect '1'
	option synflood_rate '25'
