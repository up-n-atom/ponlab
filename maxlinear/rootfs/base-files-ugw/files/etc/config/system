
config system
	option timezone 'UTC'
	option urandom_seed '0'
	option ttylogin '1'
	option hostname 'ugwcpe.intel.com'
	option hostname6 'ugwcpe6.intel.com'
	option log_file '/var/log/messages'
	option log_type 'file'
	option log_size '128'
	option log_buffer_size '256'

config timeserver 'ntp'
	option enabled '1'
	option enable_server '0'
	list server '0.lede.pool.ntp.org'
	list server '1.lede.pool.ntp.org'
	list server '2.lede.pool.ntp.org'
	list server '3.lede.pool.ntp.org'

config led 'led_power_red'
	option name 'POWER_RED'
	option sysfs 'board:red:power'
	option trigger 'none'
	option default '0'

config led 'led_power_blue'
	option name 'POWER_BLUE'
	option sysfs 'board:blue:power'
	option trigger 'none'
	option default '0'

config led 'led_power_green'
	option name 'POWER_GREEN'
	option sysfs 'board:green:power'
	option trigger 'default-on'
	option default '1'

config led 'led_internet'
	option name 'INTERNET'
	option sysfs 'led11:green:Internet'
	option trigger 'netdev'
	option mode 'link tx rx'
	option default '0'

config led 'led_dsl0'
	option name 'DSL0'
	option sysfs 'led8:green:Broadband0'
	option trigger 'netdev'
	option mode 'link tx rx'
	option default '0'

config led 'led_dsl1'
	option name 'DSL1'
	option sysfs 'led12:green:Broadband1'
	option trigger 'netdev'
	option mode 'link tx rx'
	option default '0'

config led 'led_wifi2g'
	option name 'WIFI2G'
	option sysfs 'led10:green:wifi2g'
	option trigger 'netdev'
	option mode 'link tx rx'
	option dev 'wlan0'
	option default '1'

config led 'led_wifi5g'
	option name 'WIFI5G'
	option sysfs 'led6:green:wifi5g'
	option trigger 'netdev'
	option mode 'link tx rx'
	option dev 'wlan2'
	option default '1'

config led 'led_voip'
	option name 'VOIP'
	option sysfs 'led7:green:voip'
	option trigger 'none'
	option default '0'

config led 'led_dect'
	option name 'DECT'
	option sysfs 'led5:green:dect'
	option trigger 'none'
	option default '0'

config led 'led_lte'
	option name 'LTE'
	option sysfs 'led9:green:lte'
	option trigger 'netdev'
	option mode 'link tx rx'
	option default '1'

config led 'led_ethlan1'
	option name 'ETHLAN1'
	option sysfs 'led1:green:gphy'
	option trigger 'netdev'
	option mode 'link tx rx'
	option dev 'eth0_1'
	option default '1'

config led 'led_ethlan2'
	option name 'ETHLAN2'
	option sysfs 'led2:green:gphy'
	option trigger 'netdev'
	option mode 'link tx rx'
	option dev 'eth0_2'
	option default '1'

config led 'led_ethlan3'
	option name 'ETHLAN3'
	option sysfs 'led3:green:gphy'
	option trigger 'netdev'
	option mode 'link tx rx'
	option dev 'eth0_3'
	option default '1'

config led 'led_ethlan4'
	option name 'ETHLAN4'
