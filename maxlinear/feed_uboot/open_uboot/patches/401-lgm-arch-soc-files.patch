+#include <asm/lapic.h>
+#include <malloc.h>
+#include <version.h>
+#include <errno.h>
+#include <asm/arch/project.h>
+#include <spi.h>
+#include <spi_flash.h>
+#include <asm/secureboot.h>
+
+DECLARE_GLOBAL_DATA_PTR;
+
+#define CONFIG_COMPRESS 1
+
+extern int lightning_board_init(void);
+extern int spl_early_board_init(void);
+extern int fdt_dm_setup(void);
+extern int board_recovery_mode(void);
+extern int cpu_is_bsp(void);
+extern int initr_malloc(u32 malloc_base, u32 malloc_size);
+extern void uncompress_image(ulong image_addr, int uncompress);
+extern void ia_vmm(void);
+
+static struct spi_flash *qspi_flash;
+struct global_data *tmp_ptr;
+
+int board_init_f_cont(gd_t *new_gd)
+{
+	int ret;
+	u32 apic_id = lapicid();
+
+	if (!apic_id) {
+		/* save gd ptr for APIC */
+		tmp_ptr = new_gd;
+
+		initr_malloc(CONFIG_SYS_SPL_MALLOC_START + apic_id * 0x10000,
+				CONFIG_SYS_SPL_MALLOC_SIZE);
+
+		ret = fdt_dm_setup();
+		if (ret)
+			goto err;
+	}
+
+	/* board specific configuration */
+	lightning_board_init();
+
+	/* recovery mode check and execute */
+	ret = board_recovery_mode();
+	if (ret)
+		goto err;
+
+	/* init and probe qspi */
+	qspi_flash = spi_flash_probe(CONFIG_SF_DEFAULT_BUS, CONFIG_SF_DEFAULT_CS,
+					CONFIG_SF_DEFAULT_SPEED,
+					CONFIG_SF_DEFAULT_MODE);
+	if (NULL == qspi_flash) {
+		printf("\n SPL: spi_flash_probe() returned NULL\n");
+		goto err;
+	}
+
+#ifdef CONFIG_TEP_PKG
+	/* load TEP firmware
+	 * FW is loaded at start address, this is for
+	 * development purpose only.
+	 * TODO: Get addresses from securelib header
+	 */
+	spi_flash_read(qspi_flash,
+			TEP_FIRMWARE_OFFSET,
+			TEP_FIRMWARE_SIZE,
+			(u8 *)TEP_LOAD_BASE);
+
+	ret = launch_tep(TEP_LOAD_BASE, 0x01000000);
+	if (ret)
+		goto err;
+#endif /* CONFIG_TEP_PKG */
+
+	/*
+	 * Load U-Boot image from NOR into RAM
+	 */
+	printf("\n SPL: <SYS_FLASH_U_BOOT_OFFS:0x%x>\n", SYS_FLASH_U_BOOT_OFFS);
+	ret = spi_flash_read(qspi_flash,
+			(ulong)SYS_FLASH_U_BOOT_OFFS,
+			CONFIG_LGM_U_BOOT_SIZE,
+			(u8*)LZMA_UBOOT_LOAD_ADDR);
+	if (ret)
+		goto err;
+
+	/* copy gphy firmware */
+	/* spi_flash_read(qspi_flash, (ulong) FIRMWARE_OFFSET, FIRMWARE_SIZE, (u8*) FIRMWARE_LOAD_ADDR); */
+
+#if defined(CONFIG_CHD_SECURE_BOOT)
+	u32 img_rollback_id = 0;
+	u32 otp_rollback_id  = 0;
+	u32 sb_attrib_err = SB_ATTRIB_VALID;
+	struct SBIF_Attributes attribute_table;
+
+	/* copy the mkimage header to prevent it from being overwritten
+	 * by the authentication process
+	 */
+	memcpy((u32 *)(LZMA_UBOOT_LOAD_ADDR - sizeof(struct image_header)),
+		(u32 *)(LZMA_UBOOT_LOAD_ADDR),
+		sizeof(struct image_header));
+	/*
+	 * call bootrom seclib api to auth signed lzma u-boot image
+	 * image offset without header (0x8000000 + 0x40 = 0x7FFFFC0)
+	 * seclib will perform xip decrpytion
+	 */
+	ret = bootrom_sec_api_auth(LZMA_UBOOT_LOAD_ADDR
+				+ sizeof(struct image_header), &attribute_table);
+	if (ret)
+		goto err;
+
+	sb_attrib_err = get_sbif_attributes(&attribute_table, NULL, NULL,
+										&img_rollback_id, NULL);
+	if (SB_ATTRIB_INVALID == sb_attrib_err) {
+		/* invalid image attribute */
+		return SB_ATTRIB_INVALID;
+	} else {
+		/* todo: image attribute handling, now pass through */
+		printf("\n TODO: ATTRIB HANDLING <0x%08x>: <%s>:<%d>:<%s> \n",
+							sb_attrib_err, __FILE__, __LINE__, __func__);
+	} /* SB_ATTRIB_INVALID */
+
+#if defined(CONFIG_ROLLBACKID_SUPPORT)
+	otp_rollback_id = chk_rollback_id(SB_ROLLBACK_ID_UBOOT);
+
+	/* check image anti-rollback with otp anti-rollback value */
+	if (img_rollback_id < otp_rollback_id)
+		goto err;
+#endif /* CONFIG_ROLLBACKID_SUPPORT */
+
+	/* read image header, uncompress image and jump */
+	uncompress_image(LZMA_UBOOT_LOAD_ADDR
+			- sizeof(struct image_header), CONFIG_COMPRESS);
+#else
+	uncompress_image(LZMA_UBOOT_LOAD_ADDR, CONFIG_COMPRESS);
+	goto err;
+#endif /* CONFIG_INTEL_CHD_SECURE_BOOT */
+
+err:
+	hang();
+}
+
+void board_init_f(ulong bootflag)
+{
+	int ret;
+
+#if defined(CONFIG_CHD_SECURE_BOOT) && defined(CONFIG_ROLLBACKID_SUPPORT)
+	/* RBE self anti-rollback id check with otp anti-rollback value */
+	if (CONFIG_ROLLBACKID_VALUE < chk_rollback_id(SB_ROLLBACK_ID_RBE))
+		goto err;
+#endif
+
+	/* Only BSP will execute this code */
+	if (cpu_is_bsp()) {
+		spl_early_flash_config();
+
+		/* pre-fdt early board init */
+		ret = spl_early_board_init();
+		if (ret)
+			goto err;
+
+		/* BSP will not return here */
+		ret = relocate_to_ddr();
+		if (ret) {
+			printf("unable to relocate to ddr\n");
+			goto err;
+		}
+	} else {
+		ia_vmm(); /* all APs need to switch to IA_VMM mode */
+	}
+
+	board_init_f_cont(gd);
+err:
+	hang();
+}
+
diff --git a/arch/x86/lib/spl_lgm_spi_nand.c b/arch/x86/lib/spl_lgm_spi_nand.c
new file mode 100644
--- /dev/null
+++ b/arch/x86/lib/spl_lgm_spi_nand.c
@@ -0,0 +1,296 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Copyright (C) 2016, 2017 Intel Technology Asia Pte Ltd
+ * Copyright (C) 2022 Maxlinear Corporation
+ *
+ */
+
+#include <common.h>
+#include <command.h>
+#include <nand.h>
+#include <mtd.h>
+#include <errno.h>
+#include <hang.h>
+#include <image.h>
+#include <asm/io.h>
+#include <asm/arch/project.h>
+#include <asm/secureboot.h>
+#include <linux/mtd/rawnand.h>
+
+DECLARE_GLOBAL_DATA_PTR;
+
+/* For debug purposes */
+/* #define NAND_UNCOMPRESS_IMAGE */
+#ifdef NAND_UNCOMPRESS_IMAGE
+#define CONFIG_SYS_NAND_U_BOOT_SIZE			(512 << 10)
+#else
+/* limit compressed uboot (u-boot-ram.bin) to 320kb */
+#define CONFIG_COMPRESS						1
+#define CONFIG_SYS_NAND_U_BOOT_SIZE			(320 << 10)
+#endif
+
+#ifdef CONFIG_TEP_PKG
+#define SIZE_OF_MKIMAGE_HEADER		0x40
+#define TEP_FIRMWARE_OFFSET_NAND	((CONFIG_SYS_NAND_U_BOOT_OFFS + CONFIG_LGM_U_BOOT_SIZE) * 2)
+extern int launch_tep(u32 tep_ddr_base, u32 aic_address);
+#endif /* CONFIG_TEP_PKG */
+extern void uncompress_image(ulong image_addr, int uncompress);
+
+
+/* hw abstraction layer of loading from nand flash */
+static int nand_load(struct mtd_info *mtd, unsigned int offset,
+			unsigned int uboot_size, uchar *dst)
+{
+	unsigned int off = offset;
+	unsigned int remaining = uboot_size;
+	struct mtd_oob_ops io_op = {};
+
+	io_op.mode = MTD_OPS_AUTO_OOB;
+	io_op.len = mtd->writesize;
+	io_op.ooblen = 0;
+	io_op.datbuf = dst;
+
+	/* Loop over the pages to do the actual read/write */
+	while (remaining) {
+		/* Skip the block if it is bad */
+		if (mtd->_block_isbad(mtd, off)) {
+			off += mtd->erasesize;
+			continue;
+		}
+
+		mtd->_read_oob(mtd, off, &io_op);
+		off += io_op.retlen;
+		remaining -= io_op.retlen;
+		io_op.datbuf += io_op.retlen;
+
+		/* reset return length after each read */
+		io_op.retlen = 0;
+	}
+
+	return 0;
+}
+
+#ifdef CONFIG_TEP_PKG
+static int load_tep_firmware(struct mtd_info *mtd_data,
+				int bootimage)
+{
+	int ret;
+	unsigned long tep_offset;
+	u32 entry_addr, aic_addr;
+
+	/* since we do not have any mtd info, use the build configuration
+	 * data that we have on the TEP location in flash.
+	 */
+	if (bootimage == 0)
+		tep_offset = TEP_FIRMWARE_OFFSET_NAND;
+	else
+		tep_offset = TEP_FIRMWARE_OFFSET_NAND + TEP_FIRMWARE_SIZE;
+
+	/*
+	 * Load TEP image from NAND into RAM
+	 */
+	rbe_debug_print("\n SPL: <TEP_FIRMWARE_OFFSET_NAND:0x%x>\n", TEP_FIRMWARE_OFFSET_NAND);
+	rbe_debug_print(" SPL: <TEP_FIRMWARE_SIZE:0x%x>\n", TEP_FIRMWARE_SIZE);
+	rbe_debug_print(" SPL: <TEP_LOAD_BASE:0x%x>\n", TEP_LOAD_BASE);
+
+	ret = nand_load(mtd_data, tep_offset,
+			TEP_FIRMWARE_SIZE,
+			(uchar *)TEP_LOAD_BASE);
+	if (ret)
+		return ret;
+
+#if defined(CONFIG_CHD_SECURE_BOOT)
+	u32 img_rollback_id = 0;
+	u32 otp_rollback_id  = 0;
+	u32 img_id = 0;
+	u32 sb_attrib_err = SB_ATTRIB_VALID;
+	struct SBIF_Attributes attribute_table;
+
+	ret = bootrom_sec_api_auth(TEP_LOAD_BASE, &attribute_table);
+	if (ret)
+		return ret;
+
+	sb_attrib_err = get_sbif_attributes(&attribute_table, &aic_addr,
+							&entry_addr, &img_rollback_id, &img_id);
+	if (SB_ATTRIB_INVALID == sb_attrib_err) {
+		/* invalid image attribute */
+		return SB_ATTRIB_INVALID;
+	} else {
+		rbe_debug_print("\n TODO: ATTRIB HANDLING <0x%08x>: <%s>:<%d>:<%s> \n",
+					sb_attrib_err, __FILE__, __LINE__, __func__);
+	} /* SB_ATTRIB_INVALID */
+
+#if defined(CONFIG_ROLLBACKID_SUPPORT)
+	otp_rollback_id = chk_rollback_id(SB_ROLLBACK_ID_TEP);
+
+	/* check image anti-rollback with otp anti-rollback value */
+	if (img_rollback_id < otp_rollback_id)
+		return 1;
+#endif /* CONFIG_ROLLBACKID_SUPPORT */
+
+#else
+	/* TODO: Will remove this, for development purpose only
+	 * TEP will not run without secure boot.
+	 */
+	entry_addr = TEP_LOAD_BASE;
+	aic_addr = 0x01000000;
+#endif /* CONFIG_CHD_SECURE_BOOT */
+
+	ret = launch_tep(entry_addr, aic_addr);
+	if (ret) {
+		printf("Error launching TEP\n");
+		return ret;
+	}
+
+	return 0;
+}
+#endif /* CONFIG_TEP_PKG */
+
+static int do_boot_uboot(struct mtd_info *mtd_data,
+			int bootimage)
+{
+	int ret;
+	unsigned long mkimage_size = 0;
+	unsigned long uboot_offset;
+	unsigned long spl_pad_size;
+	unsigned long uboot_part_size = CONFIG_UBOOT_PART_SIZE;
+
+	spl_pad_size = env_get_ulong("rbe_pad_size", 16, 0);
+
+	if (spl_pad_size == 0)
+		spl_pad_size = CONFIG_SYS_NAND_U_BOOT_OFFS;
+
+	if (bootimage == 0)
+		uboot_offset = spl_pad_size;
+	else
+		uboot_offset = (spl_pad_size * 2 + uboot_part_size);
+
+#if defined(CONFIG_CUSTOMER_TEST_IMG_BUILD)
+	uboot_offset = CONFIG_SYS_NAND_U_BOOT_OFFS;
+#endif
+
+	/*
+	 * Load U-Boot image from NAND into RAM
+	 */
+	rbe_debug_print("\n SPL: <CONFIG_SYS_NAND_U_BOOT_OFFS:0x%x>\n", CONFIG_SYS_NAND_U_BOOT_OFFS);
+	rbe_debug_print(" SPL: <CONFIG_SYS_NAND_U_BOOT_SIZE:0x%x>\n", CONFIG_SYS_NAND_U_BOOT_SIZE);
+	rbe_debug_print(" SPL: <LZMA_UBOOT_LOAD_ADDR:0x%x>\n", LZMA_UBOOT_LOAD_ADDR);
+	rbe_debug_print("\n SPL: <spl_pad_size:0x%x>\n", spl_pad_size);
+	rbe_debug_print(" SPL: <uboot_part_size:0x%x>\n", uboot_part_size);
+
+	ret = nand_load(mtd_data, uboot_offset,
+			CONFIG_SYS_NAND_U_BOOT_SIZE,
+			(uchar *)LZMA_UBOOT_LOAD_ADDR);
+	if (ret)
+		goto error;
+
+#if defined(CONFIG_CHD_SECURE_BOOT)
+	u32 img_rollback_id = 0;
+	u32 otp_rollback_id  = 0;
+	u32 img_id = 0;
+	u32 sb_attrib_err = SB_ATTRIB_VALID;
+	struct SBIF_Attributes attribute_table;
+
+	mkimage_size = sizeof(struct image_header);
+
+	/* copy the mkimage header to prevent it from being overwritten
+	 * by the authentication process
+	 */
+	memcpy((u32 *)(LZMA_UBOOT_LOAD_ADDR - sizeof(struct image_header)),
+		(u32 *)(LZMA_UBOOT_LOAD_ADDR),
+		sizeof(struct image_header));
+	/*
+	 * call bootrom seclib api to auth signed lzma u-boot image
+	 */
+	ret = bootrom_sec_api_auth(LZMA_UBOOT_LOAD_ADDR
+				+ sizeof(struct image_header),
+				&attribute_table);
+	if (ret)
+		goto error;
+
+	sb_attrib_err = get_sbif_attributes(&attribute_table,
+						NULL, NULL,
+						&img_rollback_id, &img_id);
+	if (SB_ATTRIB_INVALID == sb_attrib_err) {
+		/* invalid image attribute */
+		goto error;
+	} else {
+		rbe_debug_print("\n TODO: ATTRIB HANDLING <0x%08x>: <%s>:<%d>:<%s> \n",
+				sb_attrib_err, __FILE__, __LINE__, __func__);
+	} /* SB_ATTRIB_INVALID */
+
+#if defined(CONFIG_ROLLBACKID_SUPPORT)
+	otp_rollback_id = chk_rollback_id(SB_ROLLBACK_ID_UBOOT);
+
+	/* check image anti-rollback with otp anti-rollback value */
+	if (img_rollback_id < otp_rollback_id)
+		goto error;
+#endif /* CONFIG_ROLLBACKID_SUPPORT */
+#endif /* CONFIG_CHD_SECURE_BOOT */
+
+	/* read image header, uncompress image and jump
+	 * should not return
+	*/
+	uncompress_image(LZMA_UBOOT_LOAD_ADDR
+			- mkimage_size, CONFIG_COMPRESS);
+
+error:
+	return -EINVAL;
+}
+
+/*
+ * The main entry for NAND booting. It's necessary that SDRAM is already
+ * configured and available since this code loads the main U-Boot image
+ * from NAND into SDRAM and starts it from there.
+ */
+void nand_boot(void)
+{
+	volatile int ret;
+	int bootimage = 0;
+	int image_failure = 0;
+	struct mtd_info *mtd_data;
+
+	board_nand_init(NULL);
+
+	mtd_data = get_mtd_device_nm("spi-nand0");
+
+	/* Init environment
+	 * In NAND boot, we will only use the compiled env
+	 */
+	env_init();
+
+	if (readl(EPU_AON_DDR_HASH_6) & 0xf) {
+		bootimage = 1;
+		SET_IMAGE_FAILURE(image_failure, RBE_FAILURE);
+	}
+
+	/* update boot failure status */
+	writel(image_failure, BOOT_FAILURE_ADDR);
+
+#ifdef CONFIG_TEP_PKG
+	ret = load_tep_firmware(mtd_data, bootimage);
+	if (ret != 0 && bootimage == 0) {
+		SET_IMAGE_FAILURE(image_failure, POST_RBE_FAILURE);
+		writel(image_failure, BOOT_FAILURE_ADDR);
+		bootimage = 1;
+		ret = load_tep_firmware(mtd_data, bootimage);
+		if (ret)
+			goto error;
+	}
+#endif /* CONFIG_TEP_PKG */
+
+	ret = do_boot_uboot(mtd_data, bootimage);
+	if (ret != 0 && (image_failure & 1) == 1)
+		goto error;
+
+	/* intended boot image failed, signal failure and retry */
+	SET_IMAGE_FAILURE(image_failure, POST_RBE_FAILURE);
+	writel(image_failure, BOOT_FAILURE_ADDR);
+	bootimage = 1;
+	/* do_boot_uboot will not return if image is OK */
+	do_boot_uboot(mtd_data, bootimage);
+
+	/* TODO: Erase? */
+error:
+	hang();
+}
