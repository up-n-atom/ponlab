diff --git a/arch/x86/dts/lightning-mountain.dtsi b/arch/x86/dts/lightning-mountain.dtsi
new file mode 100644
--- /dev/null
+++ b/arch/x86/dts/lightning-mountain.dtsi
@@ -0,0 +1,246 @@
+/*
+ * Copyright 2022 Maxlinear Corporation.
+ *
+ * SPDX-License-Identifier: GPL-2.0+
+ */
+
+/dts-v1/;
+/include/ "skeleton.dtsi"
+
+/ {
+	/* system name in the form <manufacturer>,<model> */
+	compatible = "mxl,lightning";
+
+	#address-cells = <1>;
+	#size-cells = <1>;
+
+	aliases {
+		serial0	= "/asc@e0a00000";
+		spi0	= "/qspi@ec000000";
+		eth0	= "/ethernet@e7150000"; /* eth prime */
+		i2c0	= "/i2c0@e0500000";
+		i2c1	= "/i2c1@e1300000";
+		i2c2	= "/i2c2@e1f00000";
+		i2c3	= "/i2c3@e2000000";
+		leds	= "/leds@e0d40000";
+		gpio0	= "/gpio@e2800000";
+		gpio1	= "/gpio@e2800100";
+		gpio2	= "/gpio@e2800200";
+		gpio3	= "/gpio@e2800300";
+	};
+
+	chosen {
+		stdout-path = "/asc@e0a00000";
+	};
+
+	/* cpu model in the form <manufacturer>,<model> */
+	cpus {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		cpu@0 {
+			compatible = "intel,atom";
+			reg = <0>;
+		};
+
+		cpu@1 {
+			compatible = "intel,atom";
+			reg = <1>;
+		};
+
+		cpu@2 {
+			compatible = "intel,atom";
+			reg = <2>;
+		};
+
+		cpu@3 {
+			compatible = "intel,atom";
+			reg = <3>;
+		};
+	};
+
+	/* every device node must have a name in the form <name>[@<unit-address>] */
+	asc@e0a00000 {
+		compatible = "mxl,lightning-serial";
+		reg = <0xe0a00000 0x100000>;
+		id = <0>;
+		current-speed = <115200>;
+		status = "okay";
+	};
+
+	spi0: qspi@ec000000 {
+		compatible = "cdns,qspi";
+		#address-cells = <1>;
+		#size-cells = <0>;
+		u-boot,dm-pre-reloc;
+		reg = <0xec000000 0x100>,
+		      <0xe8000000 0x200000>;
+		is-decoded-cs = <0>;
+		cdns,fifo-depth = <128>;
+		cdns,fifo-width = <4>;
+		cdns,trigger-address = <0xe8000000>;
+		cdns,chip-select = <1>;
+		cdns,spi-max-frequency = <200000000>;
+		cdns,page-size = <2048>;
+		cdns,block-size = <17>;
+		status = "disabled";
+
+		flash0 {
+			#address-cells = <1>;
+			#size-cells = <1>;
+			spi-max-frequency = <34000000>;
+			u-boot,dm-pre-reloc;
+			status = "okay";
+		};
+
+		spi-nand0 {
+			compatible = "spi-nand";
+			#address-cells = <1>;
+			#size-cells = <1>;
+			spi-max-frequency = <34000000>;
+			u-boot,dm-pre-reloc;
+			status = "okay";
+		};
+	};
+
+	i2c0: i2c0@e0500000 {
+		compatible = "snps,designware-i2c";
+		#address-cells = <1>;
+		#size-cells = <0>;
+		reg = <0xe0500000 0x100>;
+		status = "okay";
+	};
+
+	i2c1: i2c1@e1300000 {
+		compatible = "snps,designware-i2c";
+		#address-cells = <1>;
+		#size-cells = <0>;
+		reg = <0xe1300000 0x100>;
+		status = "disabled";
+	};
+
+	i2c2: i2c2@e1f00000 {
+		compatible = "snps,designware-i2c";
+		#address-cells = <1>;
+		#size-cells = <0>;
+		reg = <0xe1f00000 0x100>;
+		status = "disabled";
+	};
+
+	i2c3: i2c3@e2000000 {
+		compatible = "snps,designware-i2c";
+		#address-cells = <1>;
+		#size-cells = <0>;
+		reg = <0xe2000000 0x100>;
+		status = "disabled";
+	};
+
+	pvt@e0680000 {
+		compatible = "mxl,pvt-sensor";
+		reg = <0xe0680000 0x1fff>;
+		status = "okay";
+	};
+
+	wdt0: wdt@e2500000 {
+		compatible = "mxl,lgm-wdt";
+		reg = <0xe2500000 0x100>;
+		status = "okay";
+	};
+
+	gpio0: gpio@e2800000 {
