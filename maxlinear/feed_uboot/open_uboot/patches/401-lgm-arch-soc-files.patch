+/*  ..\arch\x86\include\asm\arch-lightning\hal_asc.h                   */
+/***********************************************************************/
+
+
+/***********************************************************************/
+/*  Module      :  CGU register address and bits                       */
+/*  obselete refer                                                     */
+/*  ..\arch\x86\include\asm\arch-lightning\hal_cgu.h                   */
+/***********************************************************************/
+
+
+/***********************************************************************/
+/*  Module      :  QSPI register address and bits                      */
