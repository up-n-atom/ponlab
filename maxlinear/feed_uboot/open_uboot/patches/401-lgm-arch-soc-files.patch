diff --git a/arch/x86/cpu/intel_common/microcode.c b/arch/x86/cpu/intel_common/microcode.c
--- a/arch/x86/cpu/intel_common/microcode.c
+++ b/arch/x86/cpu/intel_common/microcode.c
@@ -120,6 +120,30 @@ static void microcode_read_cpu(struct mi
 	      cpu->update_revision);
 }
 
+/* Update APIC microcode */
+int microcode_update_apic(void)
+{
+	struct microcode_update update;
+	ulong address;
+	int rev;
+
+	if (!ucode_base) {
+		printf("microcode not available for APIC\n");
+		return -EEXIST;
+	}
+
+	/* ucode data will be populated by BSP */
+	update.data = (ulong *)ucode_base;
+	update.size = ucode_size;
+
+	address = (ulong)update.data + UCODE_HEADER_LEN;
+	wrmsr(MSR_IA32_UCODE_WRITE, address, 0);
+	rev = microcode_read_rev();
+	debug("APIC microcode: updated to revision 0x%x\n", rev);
+
+	return 0;
+}
+
 /* Get a microcode update from the device tree and apply it */
 int microcode_update_intel(void)
 {
@@ -132,6 +156,15 @@ int microcode_update_intel(void)
 	int ret;
 	int rev;
 
+#if defined(CONFIG_IS_HAPS) || defined(CONFIG_IS_SIMICS)
+	/* TODO:
+	 * This does not work at the moment due to
+	 * HAPS/Simics mapping issues. Will enable this
+	 * when it is proven working
+	 */
+	return 0;
+#endif
+
 	microcode_read_cpu(&cpu);
 	node = 0;
 	count = 0;
@@ -186,3 +219,31 @@ int microcode_update_intel(void)
 		}
 	} while (1);
 }
+
+void microcode_patch_done(void)
+{
+	/* Setting this bit indicates the patching process is completed. P-unit will proceed to its
+	 * initialization flow after this bit is set. If the patch failed (and P-unit FW is NOT loaded),
+	 * setting this bit will likely freeze the system, as the Punit hung in an empty FW RAM.
+	 */
+	rbe_debug_print("\n\nSet BIOS_RESET_DONE bit \n");
+
+	asm volatile (
+                "mov $0xcf8, %dx\n\t"
+                "mov $0x800000d4, %eax\n\t"
+                "out %eax, %dx\n\t"
+
+                "mov $0xcfc, %dx\n\t"
+                "mov $0xffffffff, %eax\n\t"
+                "out %eax, %dx\n\t"
+
+                "mov $0xcf8, %dx\n\t"
+                "mov $0x800000d0, %eax\n\t"
+                "out %eax, %dx\n\t"
+
+                "mov $0xcfc, %dx\n\t"
+                "mov $0x070405ff, %eax\n\t"
+                "out %eax, %dx\n\t"
+	);
+	rbe_debug_print("microcode patch done.\n");
+}
