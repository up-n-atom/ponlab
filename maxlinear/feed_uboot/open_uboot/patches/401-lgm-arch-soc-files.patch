+ *
+ * SPDX-License-Identifier:	GPL-2.0+
+ */
+
+#include <common.h>
+#include <asm/lapic.h>
+#include <asm/post.h>
+#include <asm/processor.h>
+#include <asm/msr.h>
+#include <asm/mtrr.h>
+#include <asm/msr-index.h>
+#include <asm/arch/api.h>
+#include <asm/arch/project.h>
+
+#define FREQ_BLK 	78
+#define TABLE_INDEX_MAX 6
+#define CPU_624M 	8
+#define CPU_1560M 	20
+#define CPU_1716M	22
+#define CPU_1872M	24
+#define CPU_2028M	26
+#define CPU_2496M	32
+
+#define PCU_SOIX_CTRL_REG	0xFE904044
+#define SOIX_DISABLE_OFFSET	11
+
+struct cpu_freq_table {
+	u8 fid;
+	u8 vid;
+};
+
+/* Frequency index & voltage encoding table */
+static struct cpu_freq_table freq_table[TABLE_INDEX_MAX] = {
+	{ CPU_624M, 0x2 },
+	{ CPU_1560M, 0x3 },
+	{ CPU_1716M, 0x4 },
+	{ CPU_1872M, 0x5 },
+	{ CPU_2028M, 0x6 },
+	{ CPU_2496M, 0x7 }
+};
+
+u16 get_vid(u8 fid)
+{
+	int i;
+
+	for (i = 0; i < TABLE_INDEX_MAX; i++) {
+		if (fid == freq_table[i].fid)
+			return freq_table[i].vid; 
+	}
+	return 0;
+}
+
+void set_cpu_freq(u8 fid, u8 vid)
+{
+	msr_t msr;
+
+	/* Enable speed step */
+	msr = msr_read(MSR_IA32_MISC_ENABLE);
+	msr.lo |= (1 << 16);
+	msr_write(MSR_IA32_MISC_ENABLE, msr);
+
+	/* Set perf_ctl */
+	msr.hi = 0;
+	msr.lo = (fid << 8) | vid;
+	msr_write(MSR_IA32_PERF_CTL, msr);
+}
+
+int arch_cpu_init(void)
+{
+	int ret;
+	msr_t perf_ctl;
+	u8 cpu_freq_id = CONFIG_LGM_CPU_FREQ;
+
+	/* Disable SOIx feature, not supported */
+	writel(1 << SOIX_DISABLE_OFFSET, PCU_SOIX_CTRL_REG);
+
+	if ((cpu_is_urx6x1()) &&
+		cpu_freq_id > 0x16)
+		cpu_freq_id = 0x16;
+
+	/* frequency change */
+	u16 vid = get_vid(cpu_freq_id);
+
+	if (!vid) {
+		printf("Freq step 0x%02x not supported\n",
+			CONFIG_LGM_CPU_FREQ);
+		goto f_done;
+	}
+
+	set_cpu_freq(cpu_freq_id, vid);
+
+f_done:
+	perf_ctl = msr_read(MSR_IA32_PERF_CTL);
+
+	printf("CPU running at %d Mhz\n",
+		FREQ_BLK * (perf_ctl.lo >> 8));
+
+	ret = x86_cpu_init_f();
+	if (ret)
+		return ret;
+
+	return 0;
+}
+
+/* Backup encoded handover messages written by bootrom.
+ * Area used by TEP at the later stages.
+ */
+void rom_msg_backup(void)
+{
+#ifdef CONFIG_SPL_BUILD
+	int bootinfo = 0;
+
+	/*
+	 * store boot information to aon register
+	 * DDR_HASH_6[31:15] = BOOT_SOCMODE[15:0] (soc mode)
+	 * DDR_HASH_6[15:8] = BOOT_IMG_SRC[15:8]  (boot media)
+	 * DDR_HASH_6[7:0] = BOOT_IMG_SRC[7:0]    (tail number)
+	*/
+	bootinfo |= ((readl(BOOT_SOCMODE) & 0x0000FFFF) << 16);
+	bootinfo |= (readl(BOOT_IMG_INFO) & 0x0000FFFF);
+	writel(bootinfo, EPU_AON_DDR_HASH_6);
+
+	/* TEP always clears NRST_REG_NRST_0.bit0 and this
+	 * gives a wrong reset cause in SB mode. The reset cause is read
+	 * after the TEP firmware is loaded and running.
+	 * Hence, NRST_REG_NRST_0.31 is used to back-up the
+	 * status register and will also denote the
+	 * TEP WDT reset cause.
+	*/
+	if (readl(NRST_REG_NRST_0) & 0x1)
+		writel((readl(NRST_REG_NRST_0) | (1 << 31)), NRST_REG_NRST_0);
+#endif
+}
+
+int cpu_is_bsp(void)
+{
+	u32 apic_id = lapicid();
+	rbe_debug_print("apic id: 0x%08x\n", apic_id);
+	if (apic_id)
+		return 0;
+	
+	return 1;
+}
+
+unsigned long get_soc_id(void)
+{
+	unsigned long cpuid;
+
+	cpuid = (readl(MPS_CHIPID) & PNUM_MASK);
+	cpuid = cpuid >> PNUM_SHIFT;
+	return cpuid;
+}
+
+unsigned long get_soc_version(void)
+{
+	unsigned long version;
+
+	version = (readl(MPS_CHIPID) & VERSION_MASK);
+	version = version >> VERSION_SHIFT;	
+	return version;
+}
+
+int cpu_is_lgmc(void)
+{
+	unsigned long chip_ver;
+
+	chip_ver = get_soc_version();
+	if (chip_ver == 0x4)
+		return 1;
+	return 0;
+}
+
+int cpu_is_urx6x1(void)
+{
+	unsigned long cpuid;
+
+	cpuid = (readl(MPS_CHIPID) & PNUM_MASK);
+	cpuid = cpuid >> PNUM_SHIFT;
+
+	switch (cpuid) {
+	case URX651_CPU_ID:
+	case URX641_CPU_ID:
+	case URX641_C0_CPU_ID:
+	case URX640_C0_CPU_ID:
+		return 1;
+	default:
+		break;
+	}
+
+	return 0;
+}
+
+int print_cpuinfo(void)
+{
+	post_code(POST_CPU_INFO);
+	return default_print_cpuinfo();
+}
+
