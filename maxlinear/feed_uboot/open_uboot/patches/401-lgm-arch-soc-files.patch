+		return err;
+	}
+
+	err = uclass_get_device(UCLASS_MMC, mmc_dev, &dev);
+	if (err) {
+		printf("SPL: could not find mmc device. error: %d\n", err);
+		return err;
+	}
+
+	*mmcp = mmc_get_mmc_dev(dev);
+	return 0;
