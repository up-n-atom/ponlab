+	0x1400601408003904, 0x1402701483120030,
+	0x1404501483920230, 0x14025014439E0460,
+	0x00004016439E0260, 0x0000000060160000,
+	0x0080000000005096
+};
+
+static void update_epu_ucode(void)
+{
+	u32 base_addr = EPU_GEN_PASEQMEM_PASEQMEM_INST_MEM0;
+	const u64 *ucode = &epu_ucode[0];
+	int size = sizeof(epu_ucode) / sizeof(epu_ucode[0]);
+	int paseq_num, i;
+
+	for (paseq_num = 0; paseq_num < 4; paseq_num++) {
+		base_addr += paseq_num * 0x100;
+		for (i = 0; i < size; i++)
+			REG64(base_addr + i * 8) = ucode[i];
+	}
+}
+#else
+static void update_epu_ucode(void) {};
+#endif /* !CONFIG_LIGHTNING_A0 */
+
+void epu_init(void)
+{
+	int ret = 0;
+#ifdef CONFIG_PMIC_CONFIGURATIONS
+	int pmic_connected = 0;
+#endif
+	u64 reg_data64_r = 0;
+	u64 reg_data64_w = 0;
+	u64 epu_reg64;
+	u32 pvt_read;
+	u32 vft_val, rpi1_val, rpi0_val, temp_val;
+	int cip_chip = 0;
+	unsigned int grade;
+	unsigned long ff_threshold;
+	unsigned long speed_val;
+
+#ifdef CONFIG_PMIC_CONFIGURATIONS
+	struct pmic_device *vendor = &pmic_vendors[0];
+
+	/* We need to enable TX_EMPTY interrupt for EPU I2C to work */
+	/* However we mask out the IOAPIC interrupt to prevent
+	 * the infinite trigger
+	 * Init i2c0 before configuring EPU table
+	 */
+	ret = i2c_set_bus_num(0);
+	if (ret) {
+		printf("I2C0 bus init failed\n");
+	} else {
+		ret = i2c_probe(PMIC_CONNECTED);
+		if (ret){
+			printf("PMIC probe failed, no PMIC connected\n");
+		}
+		else{
+#ifdef CONFIG_PMIC_CONFIGURATIONS
+			pmic_connected = 1;
+#endif
+		}
+	}
+#endif /* CONFIG_PMIC_CONFIGURATIONS */
+
+	/* This is just a temp. workaround for the reset issue.
+	 * This might be the solution for A-step, although
+	 * the conclusion is not final. Leaving it here
+	 * till the fix is finalised.
+	 */
+#if 0
+	if (!pmic_connected) {
+		powergood_signal_toggle(0);
+	}
+	else {
+		powergood_signal_toggle(1);
+	}
+#else
+	powergood_signal_toggle(0);
+#endif
+	set_pmic_status_timeout(EPU_STATUS_TIMEOUT);
+
+	REG32(EPU_AON_POWERGOOD_TIMEOUT2) = 0x399A180; /* set to 1510ms */
+
+	rbe_debug_print("\nEPU initialization ... ");
+	/* 8. Program rest of EPU registers (user-definitions) */
+	/* - [1] ADP_DFS_HYST_TIMER_L */
+	/* - [2] ADP_DFS_HYST_TIMER_H */
+	/* - [3] SOC_WAKE_EVENT_MASK (Note: Configure here, or before entering S3) */
+	/* - [4] DEVICES_*_S0I3_PATTERN* registers (3 instances) */
+	/* EPU Cluster: CLUSTER_SYSTEM */
+	/* 9. Set OPC_CONTROL.RUN = 0 */
+	REG64(EPU_GEN_CLUSTER_SYSTEM_OPC_CONTROL) &= (~(((u64)1 << CLUSTER_SYSTEM_OPC_CONTROL_RUN_POS) & CLUSTER_SYSTEM_OPC_CONTROL_RUN_MASK));
+
+#if defined(LOW_BOM_CONFIG)
+	/* *** Mandatory for LOW BOM config *** */
+	/* EPU Cluster: CLUSTER_SYSTEM */
+	/* Program OPC_DOMAIN_OPERATING_POINT_TABLE_LA* registers according to System Cluster sheet. */
+	/* Need to re-program OPC cluster members when in LOW BOM configuration. */
+	/* Default configuration is used in MEDIUM BOM. HIGH and MEDIUM BOM are one and the same. */
+	REG64(EPU_GEN_CLUSTER_SYSTEM_OPC_DOMAIN_OPERATING_POINT_TABLE_LA0) = (((u64)CLUSTER_SYSTEM_OPC_DOMAIN_OPERATING_POINT_TABLE_LA0_VALID6_DATA <<
+			CLUSTER_SYSTEM_OPC_DOMAIN_OPERATING_POINT_TABLE_LA0_VALID6_POS) &
+			CLUSTER_SYSTEM_OPC_DOMAIN_OPERATING_POINT_TABLE_LA0_VALID6_MASK) |
+			(((u64)CLUSTER_SYSTEM_OPC_DOMAIN_OPERATING_POINT_TABLE_LA0_DPI6_DATA << CLUSTER_SYSTEM_OPC_DOMAIN_OPERATING_POINT_TABLE_LA0_DPI6_POS) &
+			CLUSTER_SYSTEM_OPC_DOMAIN_OPERATING_POINT_TABLE_LA0_DPI6_MASK) |
+			(((u64)CLUSTER_SYSTEM_OPC_DOMAIN_OPERATING_POINT_TABLE_LA0_VALID5_DATA << CLUSTER_SYSTEM_OPC_DOMAIN_OPERATING_POINT_TABLE_LA0_VALID5_POS) &
+			CLUSTER_SYSTEM_OPC_DOMAIN_OPERATING_POINT_TABLE_LA0_VALID5_MASK) |
+			(((u64)CLUSTER_SYSTEM_OPC_DOMAIN_OPERATING_POINT_TABLE_LA0_DPI5_DATA << CLUSTER_SYSTEM_OPC_DOMAIN_OPERATING_POINT_TABLE_LA0_DPI5_POS) &
+			CLUSTER_SYSTEM_OPC_DOMAIN_OPERATING_POINT_TABLE_LA0_DPI5_MASK) |
+			(((u64)CLUSTER_SYSTEM_OPC_DOMAIN_OPERATING_POINT_TABLE_LA0_VALID4_DATA << CLUSTER_SYSTEM_OPC_DOMAIN_OPERATING_POINT_TABLE_LA0_VALID4_POS) &
+			CLUSTER_SYSTEM_OPC_DOMAIN_OPERATING_POINT_TABLE_LA0_VALID4_MASK) |
+			(((u64)CLUSTER_SYSTEM_OPC_DOMAIN_OPERATING_POINT_TABLE_LA0_DPI4_DATA << CLUSTER_SYSTEM_OPC_DOMAIN_OPERATING_POINT_TABLE_LA0_DPI4_POS) &
+			CLUSTER_SYSTEM_OPC_DOMAIN_OPERATING_POINT_TABLE_LA0_DPI4_MASK) |
+			(((u64)CLUSTER_SYSTEM_OPC_DOMAIN_OPERATING_POINT_TABLE_LA0_VALID3_DATA << CLUSTER_SYSTEM_OPC_DOMAIN_OPERATING_POINT_TABLE_LA0_VALID3_POS) &
+			CLUSTER_SYSTEM_OPC_DOMAIN_OPERATING_POINT_TABLE_LA0_VALID3_MASK) |
+			(((u64)CLUSTER_SYSTEM_OPC_DOMAIN_OPERATING_POINT_TABLE_LA0_DPI3_DATA << CLUSTER_SYSTEM_OPC_DOMAIN_OPERATING_POINT_TABLE_LA0_DPI3_POS) &
+			CLUSTER_SYSTEM_OPC_DOMAIN_OPERATING_POINT_TABLE_LA0_DPI3_MASK) |
