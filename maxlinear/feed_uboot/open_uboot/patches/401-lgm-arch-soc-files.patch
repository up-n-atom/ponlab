@@ -0,0 +1,1554 @@
+/* ----------------------------------------------------------------------------
+         Copyright (C) 2016 - 2017 Intel Technology Asia Pte Ltd
+         Sec Class: Intel Confidential (IC)
+-----------------------------------------------------------------------------*/
+
+#ifndef __ASC_REG_H__
+#define __ASC_REG_H__
+
+/*! \defgroup UART Register File UART - UART Registers Description */
+/*! @{ */
+
+/*! Base Address of ASC3 */
+#define ASC3_MODULE_BASE 0xE0300000u
+/*! Base Address of ASC0 */
+#define ASC0_MODULE_BASE 0xE0A00000u
+/*! Base Address of ASC1 */
+#define ASC1_MODULE_BASE 0xE0C00000u
+/*! Base Address of ASC2 */
+#define ASC2_MODULE_BASE 0xE1100000u
+
+/*! \defgroup ASC_CLC Register ASC_CLC - Clock Control Register */
+/*! @{ */
+
+/*! Register Offset (relative) */
+#define ASC_CLC 0x0
+
+/*! Register Reset Value */
+#define ASC_CLC_RST 0x00000002u
+
+/*! Field DISR - Disable Request Bit */
+#define ASC_CLC_DISR_POS 0
+/*! Field DISR - Disable Request Bit */
+#define ASC_CLC_DISR_MASK 0x1u
+
+/*! Field DISS - Disable Status Bit */
+#define ASC_CLC_DISS_POS 1
+/*! Field DISS - Disable Status Bit */
+#define ASC_CLC_DISS_MASK 0x2u
+
+/*! Field SPEN - Suspend Enable Bit for OCDS */
+#define ASC_CLC_SPEN_POS 2
+/*! Field SPEN - Suspend Enable Bit for OCDS */
+#define ASC_CLC_SPEN_MASK 0x4u
+/*! Constant SUS_OFF - SUS_OFF */
+#define CONST_ASC_CLC_SPEN_SUS_OFF 0x0
+/*! Constant SUS_ON - SUS_ON */
+#define CONST_ASC_CLC_SPEN_SUS_ON 0x1
+
+/*! Field EDIS - External Request Disable */
+#define ASC_CLC_EDIS_POS 3
+/*! Field EDIS - External Request Disable */
+#define ASC_CLC_EDIS_MASK 0x8u
+/*! Constant SLP_ON - SLP_ON */
+#define CONST_ASC_CLC_EDIS_SLP_ON 0x0
+/*! Constant SLP_OFF - SLP_OFF */
+#define CONST_ASC_CLC_EDIS_SLP_OFF 0x1
+
+/*! Field SBWE - Suspend Bit Write Enable for OCDS */
+#define ASC_CLC_SBWE_POS 4
+/*! Field SBWE - Suspend Bit Write Enable for OCDS */
+#define ASC_CLC_SBWE_MASK 0x10u
+/*! Constant SPEN_PROT - SPEN_PROT */
+#define CONST_ASC_CLC_SBWE_SPEN_PROT 0x0
+/*! Constant SPEN_WE - SPEN_WE */
+#define CONST_ASC_CLC_SBWE_SPEN_WE 0x1
+
+/*! Field FSOE - Fast Shut-Off Enable Bit */
+#define ASC_CLC_FSOE_POS 5
+/*! Field FSOE - Fast Shut-Off Enable Bit */
+#define ASC_CLC_FSOE_MASK 0x20u
+/*! Constant SLOW_SLP - SLOW_SLP */
+#define CONST_ASC_CLC_FSOE_SLOW_SLP 0x0
+/*! Constant FAST_SLP - FAST_SLP */
+#define CONST_ASC_CLC_FSOE_FAST_SLP 0x1
+
+/*! Field RMC - Clock Divider for Normal Run Mode */
+#define ASC_CLC_RMC_POS 8
+/*! Field RMC - Clock Divider for Normal Run Mode */
+#define ASC_CLC_RMC_MASK 0xFF00u
+
+/*! Field SMC - Clock Divider for Sleep Mode */
+#define ASC_CLC_SMC_POS 16
+/*! Field SMC - Clock Divider for Sleep Mode */
+#define ASC_CLC_SMC_MASK 0xFF0000u
+
+/*! @} */
+
+/*! \defgroup ASC_PISEL Register ASC_PISEL - Port Input Select Register */
+/*! @{ */
+
+/*! Register Offset (relative) */
+#define ASC_PISEL 0x4
+
+/*! Register Reset Value */
+#define ASC_PISEL_RST 0x00000000u
+
+/*! Field RIS - Receiver Input Select */
+#define ASC_PISEL_RIS_POS 0
+/*! Field RIS - Receiver Input Select */
+#define ASC_PISEL_RIS_MASK 0x1u
+/*! Constant A - A */
+#define CONST_ASC_PISEL_RIS_A 0x0
+/*! Constant B - B */
+#define CONST_ASC_PISEL_RIS_B 0x1
+
+/*! @} */
+
+/*! \defgroup ASC_ID Register ASC_ID - Identification Register */
+/*! @{ */
+
+/*! Register Offset (relative) */
+#define ASC_ID 0x8
+
+/*! Register Reset Value */
+#define ASC_ID_RST 0x101044C4u
+
+/*! Field REV - Revision */
+#define ASC_ID_REV_POS 0
+/*! Field REV - Revision */
+#define ASC_ID_REV_MASK 0x1Fu
+
+/*! Field CFG0 - Configuration */
+#define ASC_ID_CFG0_POS 5
+/*! Field CFG0 - Configuration */
+#define ASC_ID_CFG0_MASK 0x20u
+/*! Constant NO_DMA - NO_DMA */
+#define CONST_ASC_ID_CFG0_NO_DMA 0x0
+/*! Constant DMA - DMA */
+#define CONST_ASC_ID_CFG0_DMA 0x1
+
+/*! Field CFG1 - Configuration */
+#define ASC_ID_CFG1_POS 6
+/*! Field CFG1 - Configuration */
+#define ASC_ID_CFG1_MASK 0x40u
+/*! Constant NO_IRDA - NO_IRDA */
+#define CONST_ASC_ID_CFG1_NO_IRDA 0x0
+/*! Constant IRDA - IRDA */
+#define CONST_ASC_ID_CFG1_IRDA 0x1
+
+/*! Field CFG2 - Configuration */
+#define ASC_ID_CFG2_POS 7
+/*! Field CFG2 - Configuration */
+#define ASC_ID_CFG2_MASK 0x80u
+/*! Constant NO_AB - NO_AB */
+#define CONST_ASC_ID_CFG2_NO_AB 0x0
+/*! Constant AB - AB */
+#define CONST_ASC_ID_CFG2_AB 0x1
+
+/*! Field ID - Module ID */
+#define ASC_ID_ID_POS 8
+/*! Field ID - Module ID */
+#define ASC_ID_ID_MASK 0xFF00u
+
+/*! Field RXFS - Receive FIFO Size */
+#define ASC_ID_RXFS_POS 16
+/*! Field RXFS - Receive FIFO Size */
+#define ASC_ID_RXFS_MASK 0x3F0000u
+
+/*! Field RX32 - Receive Path 32 Bits */
+#define ASC_ID_RX32_POS 23
+/*! Field RX32 - Receive Path 32 Bits */
+#define ASC_ID_RX32_MASK 0x800000u
+/*! Constant RW8 - RW8 */
+#define CONST_ASC_ID_RX32_RW8 0x0
+/*! Constant RW32 - RW32 */
+#define CONST_ASC_ID_RX32_RW32 0x1
+
+/*! Field TXFS - Transmit FIFO Size */
+#define ASC_ID_TXFS_POS 24
+/*! Field TXFS - Transmit FIFO Size */
+#define ASC_ID_TXFS_MASK 0x3F000000u
+
+/*! Field TX32 - Transmit Path 32 Bits */
+#define ASC_ID_TX32_POS 31
+/*! Field TX32 - Transmit Path 32 Bits */
+#define ASC_ID_TX32_MASK 0x80000000u
+/*! Constant TW8 - TW8 */
+#define CONST_ASC_ID_TX32_TW8 0x0
+/*! Constant TW32 - TW32 */
+#define CONST_ASC_ID_TX32_TW32 0x1
+
+/*! @} */
+
+/*! \defgroup ASC_MCON Register ASC_MCON - Control Register */
+/*! @{ */
+
+/*! Register Offset (relative) */
+#define ASC_MCON 0x10
+
+/*! Register Reset Value */
+#define ASC_MCON_RST 0x00000000u
+
+/*! Field M - Mode Control */
+#define ASC_MCON_M_POS 0
+/*! Field M - Mode Control */
+#define ASC_MCON_M_MASK 0x3u
+/*! Constant ASYNC - ASYNC */
+#define CONST_ASC_MCON_M_ASYNC 0x0
+/*! Constant IRDA - IRDA */
+#define CONST_ASC_MCON_M_IRDA 0x1
+/*! Constant RES1 - Res1 */
+#define CONST_ASC_MCON_M_RES1 0x2
+/*! Constant RES2 - Res2 */
+#define CONST_ASC_MCON_M_RES2 0x3
+
+/*! Field WLS - Word Length Select */
+#define ASC_MCON_WLS_POS 2
+/*! Field WLS - Word Length Select */
+#define ASC_MCON_WLS_MASK 0xCu
+/*! Constant D8 - D8 */
+#define CONST_ASC_MCON_WLS_D8 0x0
+/*! Constant D7 - D7 */
+#define CONST_ASC_MCON_WLS_D7 0x1
+/*! Constant RES1 - Res1 */
+#define CONST_ASC_MCON_WLS_RES1 0x2
+/*! Constant RES2 - Res2 */
+#define CONST_ASC_MCON_WLS_RES2 0x3
+
+/*! Field PEN - Parity Check Enable */
+#define ASC_MCON_PEN_POS 4
+/*! Field PEN - Parity Check Enable */
+#define ASC_MCON_PEN_MASK 0x10u
+/*! Constant OFF - OFF */
+#define CONST_ASC_MCON_PEN_OFF 0x0
+/*! Constant ON - ON */
+#define CONST_ASC_MCON_PEN_ON 0x1
+
+/*! Field ODD - Parity Selection */
+#define ASC_MCON_ODD_POS 5
+/*! Field ODD - Parity Selection */
+#define ASC_MCON_ODD_MASK 0x20u
+/*! Constant NO - NO */
+#define CONST_ASC_MCON_ODD_NO 0x0
+/*! Constant YES - YES */
+#define CONST_ASC_MCON_ODD_YES 0x1
+
+/*! Field SP - Sticky Parity */
+#define ASC_MCON_SP_POS 6
+/*! Field SP - Sticky Parity */
+#define ASC_MCON_SP_MASK 0x40u
+/*! Constant OFF - OFF */
+#define CONST_ASC_MCON_SP_OFF 0x0
+/*! Constant ON - ON */
+#define CONST_ASC_MCON_SP_ON 0x1
