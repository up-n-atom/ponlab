+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Copyright (C) 2016, 2017 Intel Technology Asia Pte Ltd
+ * Copyright (C) 2022 Maxlinear Corporation 
+ *
+ */
+
+#ifndef __LIGHTNING_REG_H
+#define __LIGHTNING_REG_H
+
+/***********************************************************************/
+/*  General register helper                                            */
+/***********************************************************************/
+/* MACROS */
+#define STORE_FENCE()						asm("sfence")
+#define LOAD_FENCE()						asm("lfence")
+#define LOAD_STORE_FENCE()					asm("mfence")
+
+#define REG8(addr)							*((volatile u8 *)(addr))
+#define REG16(addr)							*((volatile u16 *)(addr))
+#define REG32(addr)							*((volatile u32 *)(addr))
+#define REG64(addr)							*((volatile u64 *)(addr))
+
+#define SET_BIT(reg, mask)					reg |= (mask)
+#define SET_BITS(reg, mask)					SET_BIT(reg, mask)
+
+#define CLEAR_BIT(reg, mask)				reg &= (~mask)
+#define CLEAR_BITS(reg, mask)				CLEAR_BIT(reg, mask)
+
+#define SET_BITFIELD(reg, mask, off, val)	{reg &= (~mask); reg |= (val << off);}
+
+#define mxl_dma_r32(x)					REG32((x))
+#define mxl_dma_w32(x, y)					(REG32((y)) = (x))
+#define mxl_dma_w32_mask(clear, set, reg)	\
+		  mxl_dma_w32((mxl_dma_r32(reg) & ~(clear)) | (set), reg)
+
+
+/***********************************************************************/
+/*  Module      :  x86 CPU register address                            */
+/***********************************************************************/
+#define MOUNTAIN_PLATFORM					"MOUNTAIN"
+
+#define LAPIC_BASE							0xFEE00000
+#define IOAPIC_BASE							0xFEC00000
+
+
+/***********************************************************************/
+/*  Module      :  EBU register address and bits                       */
+/*  obselete refer                                                     */
+/*  ..\arch\x86\include\asm\arch-lightning\hal_ebu_h.h                 */
+/***********************************************************************/
+#define EBU_CHIP_SELECT_0					0x0
+#define EBU_CHIP_SELECT_1					0x1
+
+
+/***********************************************************************/
+/*  Module      :  GPIO_FUNCTION register address and bits             */
+/*  obselete refer                                                     */
+/*  ..\arch\x86\include\asm\arch-lightning\hal_gpio_function.h         */
+/***********************************************************************/
+#define GPIO_DEFAULT						0xFF
+#define GPIO_INPUT_DIR						0x0
+#define GPIO_OUTPUT_DIR						0x1
+
+#define GPIO_ALT_FUNC_0						0x0
+#define GPIO_ALT_FUNC_1						0x1
+#define GPIO_ALT_FUNC_2						0x2
+#define GPIO_ALT_FUNC_3						0x3
+#define GPIO_ALT_FUNC_4						0x4
+
+
+/***********************************************************************/
+/*  Module      :  GPIO_PAD_CTRL register address and bits             */
+/*  obselete refer                                                     */
+/*  ..\arch\x86\include\asm\arch-lightning\hal_gpio_pad_ctrl.h         */
+/***********************************************************************/
+
+
+/***********************************************************************/
+/*  Module      :  SSC register address and bits                       */
+/*  obselete refer                                                     */
+/*  ..\arch\x86\include\asm\arch-lightning\hal_ssc.h                   */
+/***********************************************************************/
+#define SSC_CHIP_SELECT_0					0x0
+#define SSC_CHIP_SELECT_1					0x1
+
+
+/***********************************************************************/
+/*  Module      :  ASC register address and bits                       */
