+ * SPDX-License-Identifier:	GPL-2.0+
+ *
+ * SSC Helper
+ *
+*/
+
+#ifndef __SSC_HELPER_H
+#define __SSC_HELPER_H
+
+#include "ssc_reg.h"
+
+
+/* SPI low level debug print */
+/* #define TRACE_SPI_TXRX */
+
+
+#define reg32(addr)					*((volatile u32 *)(addr))
+
+/* SSC_MCON - Control Register */
+#define SSC_CON_BM(value)			(((( 1 << 5) - 1) & (value)) << 16)
+
+/* SSC_STATE - State Register */
+#define SSC_STAT_BC(value)			(((( 1 << 5) - 1) & (value)) << 16)
+
+/* SSC_RXFCON - Receive FIFO Control Register */
+#define SSC_RXFCON_RXFITL(value)	(((( 1 << 6) - 1) & (value)) << 8)
+
+/* SSC_TXFCON - Transmit FIFO Control Register */
+#define SSC_TXFCON_RXFITL(value)	(((( 1 << 6) - 1) & (value)) << 8)
+
+/* SSC_FSTAT - FIFO Status Register */
+#define SSC_FSTAT_TXFFL(value)		(((( 1 << 6) - 1) & (value)) << 8)
+#define SSC_FSTAT_RXFFL(value)		(((( 1 << 6) - 1) & (value)) << 0)
+
+
+static inline void ssc_cs_set(u32 base, unsigned char bit)
+{
+	/* Set Output Register Bit */
+	reg32(SSC_WHBGPOSTAT+base) = (1<<(bit+SSC_WHBGPOSTAT_SETOUTN_POS));
+}
+
+
+static inline void ssc_cs_clr(u32 base, unsigned char bit)
+{
+	/* Clear Output Register Bit */
+	reg32(SSC_WHBGPOSTAT+base) = (1<<(bit+SSC_WHBGPOSTAT_CLROUTN_POS));
+}
+
+
+static inline void ssc_sync(u32 base)
+{
+	/* Busy Flag */
+	while(((reg32(SSC_STATE+base)) & SSC_STATE_BSY_MASK) == SSC_STATE_BSY_MASK);
+}
+
+
+static inline void ssc_tx_only(u32 base)
+{
+	ssc_sync(base);
+	/* change to TX only mode */
+	reg32(SSC_MCON+base) = ((reg32(SSC_MCON+base)) & (~SSC_MCON_TXOFF_MASK))
+							  | SSC_MCON_RXOFF_MASK;
+
+#ifdef TRACE_SPI_TXRX
+	printf("\n SPI_HELPER: <%s>:SSC_MCON<0x%02x> \n", 
+			  __func__, reg32(SSC_MCON+base));
+#endif
+}
+
+
+static inline void ssc_rx_only(u32 base)
+{
+	ssc_sync(base);
+	/* change to RX only mode */
+	reg32(SSC_MCON+base) = ((reg32(SSC_MCON+base)) & (~SSC_MCON_RXOFF_MASK))
+							  | SSC_MCON_TXOFF_MASK;
+	/* flush RX */
+	reg32(SSC_RXFCON+base) = reg32(SSC_RXFCON+base) | SSC_RXFCON_RXFLU_MASK;
+
+#ifdef TRACE_SPI_TXRX
+	printf("\n SPI_HELPER: <%s>:SSC_MCON<0x%02x>:SSC_RXFCON<0x%02x> \n",
+			  __func__, reg32(SSC_MCON+base), reg32(SSC_RXFCON+base));
+#endif
+}
+
+
+static inline int ssc_write(u32 base, unsigned char uc_value)
+{
+	ssc_sync(base);
+	/* write to Transmitter FIFO */
+	reg32(SSC_TB+base) = (u32)uc_value;
+	ssc_sync(base);
+
+#ifdef TRACE_SPI_TXRX
+	printf("\n SPI_HELPER: <%s>:SSC_TB<0x%02x> \n",
+			  __func__, reg32(SSC_TB+base));
+#endif
+
+	return 0;
+}
+
+
+static inline u8 ssc_read(u32 base)
+{
+	ssc_sync(base);
+	/* Receive Request */
+	reg32(SSC_RXREQ+base) = 1;
+
+	/* poll RXFFL - Receive FIFO Filling Level */
+	while((SSC_FSTAT_RXFFL(reg32(SSC_FSTAT+base))) == 0) { };
+
+#ifdef TRACE_SPI_TXRX
+	u32 data = reg32(SSC_RB+base);
+	printf("\n SPI_HELPER: <%s>:SSC_FSTAT<0x%02x>:SSC_RB<0x%02x> \n",
+			  __func__, reg32(SSC_FSTAT+base), data);
+
+	return (u8)(data);
+#else
+	/* Receive Data Register */
+	return (u8)(reg32(SSC_RB+base));
+#endif
+}
