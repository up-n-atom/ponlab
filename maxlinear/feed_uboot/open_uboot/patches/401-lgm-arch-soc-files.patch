+#define I2C0_DW_APB_I2C_ADDR_BLOCK1_IC_ENABLE 0xE050006C
+#define I2C0_DW_APB_I2C_ADDR_BLOCK1_IC_CON 0xE0500000
+#define I2C0_DW_APB_I2C_ADDR_BLOCK1_IC_TAR 0xE0500004
+#define I2C0_DW_APB_I2C_ADDR_BLOCK1_IC_HS_MADDR 0xE050000C
+#define I2C0_DW_APB_I2C_ADDR_BLOCK1_IC_SS_SCL_HCNT 0xE0500014
+#define I2C0_DW_APB_I2C_ADDR_BLOCK1_IC_SS_SCL_LCNT 0xE0500018
+#define I2C0_DW_APB_I2C_ADDR_BLOCK1_IC_RX_TL 0xE0500038
+#define I2C0_DW_APB_I2C_ADDR_BLOCK1_IC_TX_TL 0xE050003C
+#define I2C0_DW_APB_I2C_ADDR_BLOCK1_IC_INTR_MASK 0xE0500030
+#define I2C0_DW_APB_I2C_ADDR_BLOCK1_IC_ENABLE 0xE050006C
+#define I2C0_DW_APB_I2C_ADDR_BLOCK1_IC_FS_SCL_HCNT 0xE050001C
+#define I2C0_DW_APB_I2C_ADDR_BLOCK1_IC_FS_SCL_LCNT 0xE0500020
+#define I2C0_DW_APB_I2C_ADDR_BLOCK1_IC_HS_SCL_HCNT 0xE0500024
+#define I2C0_DW_APB_I2C_ADDR_BLOCK1_IC_HS_SCL_LCNT 0xE0500028
+
+/* Agreed upon PMIC slave address */
+#define PMIC_CONNECTED	0x6a
+/* Keep PMIC buck info for expandability */
+#define CONFIG_CPU0_VOLTAGE 0x51
+#define CONFIG_CPU1_VOLTAGE 0x51
+#define CONFIG_ADP_VOLTAGE 0x3D
+
+#define PASEQ0_START_VALUE	0x0
+#define PASEQ1_START_VALUE	0x100
+#define PASEQ2_START_VALUE	0x200
+
+extern int config_gpio(int gpio_num, int func);
+
+#if defined(CONFIG_PMIC_CONFIGURATIONS) \
+	&& defined(CONFIG_SPL_BUILD)
+struct pmic_device {
+	u8 pmic_offset;
+	u8 pmic_id;
+	u8 buck0;
+	u8 buck1;
+	u8 buck2;
+	u8 buck3;
+};
+
+struct buck_values {
+	u8 buck0_value;
+	u8 buck1_value;
+	u8 buck2_value;
+	u8 buck3_value;
+};
+
+static struct pmic_device pmic_vendors[] = {
+	{
+		/* ROHM BD2653SWV */
+		.pmic_offset = 0x6a,
+		.pmic_id = 0xa1,
+		.buck0 = 0x0a,
+		.buck1 = 0x0e,
+		.buck2 = 0x12,
+		.buck3 = 0x16,
+	}
+};
+
+/* Reference board values, not finalised.. */
+/* static struct buck_values pmic_buck_values = { 0x52, 0x52, 0x52, 0x53 }; */
+static struct buck_values pmic_buck_values = {
+	.buck0_value = CONFIG_CPU0_VOLTAGE,
+	.buck1_value = CONFIG_CPU1_VOLTAGE,
+	.buck2_value = CONFIG_ADP_VOLTAGE,
+	.buck3_value = CONFIG_ROC_VOLTAGE, /* taken from build config */
+};
+
+/* Manually change rail voltages via PMIC using i2c0
+ * We only change the CPU voltage if we see that the voltage
+ * currently applied differs to the 624MHZ voltage to
+ * prevent a missing EPU ACK
+ */
+static int pmic_set_manual_voltage(struct pmic_device *dev,
+			struct buck_values *buck, u8 cpu0_volt,
+			u8 cpu1_volt)
+{
+	int ret;
+	u8 regaddr = dev->pmic_offset;
+	u8 pmic_cpu0_read, pmic_cpu1_read;
+
+	/* read cpu0 voltage */
+	ret = i2c_read(regaddr, dev->buck0,
+			1, &pmic_cpu0_read, 1);
+	if (ret) {
+		printf("PMIC not ready for buck0 access\n");
+		return ret;
+	}
+
+	/* read cpu1 voltage */
+	ret = i2c_read(regaddr, dev->buck1,
+			1, &pmic_cpu1_read, 1);
+	if (ret) {
+		printf("PMIC not ready for buck0 access\n");
+		return ret;
+	}
+
+	rbe_debug_print("CPU0 voltage: 0x%02x, EPU table voltage: 0x%02x\n",
+			pmic_cpu0_read, cpu0_volt);
+	rbe_debug_print("CPU1 voltage: 0x%02x, EPU table voltage: 0x%02x\n",
+			pmic_cpu1_read, cpu1_volt);
+
+	/* bump the voltage only if cpu0 voltage differs */
+	if (pmic_cpu0_read != cpu0_volt) {
+		ret = i2c_write(regaddr, dev->buck0, 1,
+					&cpu0_volt, 1);
+		if (ret)
+			return ret;
+	}
+
+	/* bump the voltage only if cpu1 voltage differs
+	 * We also program cpu1 voltage so that if we boot
+	 * configure sys at 624MHZ, we are not using default
+	 * boot voltage which will prevent EPU to send
+	 * request to PMIC
+	 */
+	if (pmic_cpu1_read != cpu1_volt) {
+		ret = i2c_write(regaddr, dev->buck1, 1,
+					&cpu1_volt, 1);
+		if (ret)
+			return ret;
+	}
+
+	ret = i2c_write(regaddr, dev->buck3, 1, &buck->buck3_value, 1);
+	if (ret)
+		return ret;
+
+	printf("EPU Table version %d.%02d.%02d.%02d\n",
+			EPU_TABLE_VER_MAJOR,
+			EPU_TABLE_VER_MINOR,
+			EPU_TABLE_VER_BUILD,
+			EPU_TABLE_VER_REV);
+	return 0;
+}
+#endif /* CONFIG_PMIC_CONFIGURATIONS && CONFIG_SPL_BUILD */
+
+void set_adp_hysteresis_timer (u64 value)
+{
+	REG32(EPU_AON_ADP_DFS_HYST_TIMER_L) = (u32)(value & 0xFFFFFFFF);
+	REG32(EPU_AON_ADP_DFS_HYST_TIMER_H) = (u32)((value >> 32) & 0xFFFFFFFF);
+}
+
+void set_pmic_status_timeout (u32 value)
+{
+	REG32(EPU_AON_PMIC_CPU0_STATUS_TIMEOUT) = value;
+	REG32(EPU_AON_PMIC_CPU1_STATUS_TIMEOUT) = value;
+	REG32(EPU_AON_PMIC_ADP_STATUS_TIMEOUT) = value;
+	REG32(EPU_AON_PMIC_REQUEST_TIMEOUT) = value;
+	REG32(EPU_AON_POWERGOOD_TIMEOUT) = value;
+}
+
+void powergood_signal_toggle(bool val)
+{
+	if (val) {
+		REG32(EPU_AON_PMIC_POWERGOOD_TOGGLE_FROM_REQUEST_SIGNAL) = 0x1;
+	} else {
+		REG32(EPU_AON_PMIC_POWERGOOD_TOGGLE_FROM_REQUEST_SIGNAL) = 0x0;
+	}
+	rbe_debug_print("configured to %s mode\n", val ? "pmic" : "powergood");
+}
+
+int set_adp_dvfs_level(int level)
+{
+	u32 reg;
+	int timeout = 0xffff;
+
+	reg = REG32(EPU_AON_ADP_PM_CONTROL);
+	reg &= (~ADP_PM_CONTROL_SW_DVFS_LEVEL_REQUEST_MASK);
+	reg |= ((level << ADP_PM_CONTROL_SW_DVFS_LEVEL_REQUEST_POS)
+			& ADP_PM_CONTROL_SW_DVFS_LEVEL_REQUEST_MASK);
+	REG32(EPU_AON_ADP_PM_CONTROL) = reg;
+
+	while (timeout >= 0) {
+		reg = ((REG32(EPU_AON_ADP_PM_STATUS)
+			& ADP_PM_STATUS_SW_DVFS_LEVEL_MASK))
+				>> ADP_PM_STATUS_SW_DVFS_LEVEL_POS;
+		if (reg == level)
+			break;
+
+		if (timeout == 0)
+			return -1;
+
+		timeout--;
+	}
+	return 0;
+}
+
+void epu_and_i2c_disable(void)
+{
+	u32 timeout = 0xfff;
+
+	REG64(EPU_GEN_CLUSTER_SYSTEM_OPC_CONTROL) &=
+		(~(((u64)1 << CLUSTER_SYSTEM_OPC_CONTROL_RUN_POS)
+		& CLUSTER_SYSTEM_OPC_CONTROL_RUN_MASK));
+
+	/* disable i2c0*/
+	REG32(I2C0_DW_APB_I2C_ADDR_BLOCK1_IC_ENABLE) = 0x00000000;
+	while (REG32(I2C0_DW_APB_I2C_ADDR_BLOCK1_IC_ENABLE) & 0x1) {
+		if (timeout-- <= 0) {
+			printf("i2c0 cannot be disabled\n");
+			break;
+		}
+		udelay(20);
+	}
+
+	/* put i2c0 HW to reset, it seems that this is the
+	 * only way to guarantee proper i2c0 handover
+	 */
+	REG32(RCU_RST_REQ_AON) |= RST_REQ_AON_I2C0_MASK;
+	udelay(20);
+}
+
+void toggle_epu_enable(int enable)
+{
+	if (enable)
+		REG64(EPU_GEN_CLUSTER_SYSTEM_OPC_CONTROL)
+			|= (((u64)1 << CLUSTER_SYSTEM_OPC_CONTROL_RUN_POS)
+				& CLUSTER_SYSTEM_OPC_CONTROL_RUN_MASK);
+	else
+		REG64(EPU_GEN_CLUSTER_SYSTEM_OPC_CONTROL)
+			&= (~(((u64)1 << CLUSTER_SYSTEM_OPC_CONTROL_RUN_POS)
+				& CLUSTER_SYSTEM_OPC_CONTROL_RUN_MASK));
+}
+
