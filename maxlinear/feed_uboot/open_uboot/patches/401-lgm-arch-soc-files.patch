+#include <asm/cache.h>
+#include <asm/io.h>
+#include <firewall.h>
+
+#if defined(CONFIG_LIGHTNING_A0)
+#define RCU_MISC_REG		0xE0000094
+#define FW_START_INDEX		0
+#else
+#define RCU_MISC_REG		0xE00201E4
+/* the first 10 entries will be reserved for bootrom */
+#define FW_START_INDEX		0
+#endif
+
+#define SECURITY_TOP		0xE00C0000
+#define FIREWALL_HSIO_R		0xC1700000
+#define FIREWALL_HSIO_L		0xD1700000
+#define FIREWALL_DDR		0xECF04000
+#define FIREWALL_AXI		0xECF03000
+#define FIREWALL_ETH		0xECF02000
+#define FIREWALL_SSB		0xECF01000
+#define FIREWALL_PERI		0xECF00000
+#define REGION_INDEX_MAX	47
+#define REGION_INDEX_H		0
+#define REGION_INDEX_L		0x100
+#define RW_INDEX		0x200
+#define REGION_SAI_INDEX	0x300
+
+#define CPU0_SAI		0x9
+#define CPU1_SAI		0x19
+#define CPU2_SAI		0x49
+#define CPU3_SAI		0x59
+
+#define VMM0_SAI		0xB
+#define VMM1_SAI		0x1B
+#define VMM2_SAI		0x4B
+#define VMM3_SAI		0x5B
+
+#define PMIAXI_SAI		0x7F
+#define SAI_MASK_OFFSET		0x400
+#define ALL_MASKED_VAL		0xFF
+#define CLR_BOOT_FLAG		0x1
+#define EFF_SAI_REG		0x404
+#define FIREWALL_INT_SR		0x808
+
+void configure_sai_mask(u32 address, u8 mask)
+{
+	writel(mask, address);
+}
+
+int read_firewall_entry(u32 base_addr,
+			struct firewall_desc *fwall, int entry)
+{
+	u32 reg;
+	u32 offset = entry * 4;
+
+	if (entry >= 64) {
+		printf("No such entry\n");
+		return 1;
+	}
+
+	fwall->region_hi = readl(base_addr + REGION_INDEX_H + offset);
+	fwall->region_lo = readl(base_addr + REGION_INDEX_L + offset);
+	reg = readl(base_addr + RW_INDEX + offset);
+	fwall->rd_en = (reg & 0x1) >> 1;
+	fwall->wr_en = (reg & 0x2) >> 2;
+	fwall->rd_wr_en = (reg & 0x4) >> 3;
+	fwall->sai_number = readl(base_addr + REGION_SAI_INDEX + offset);
+	return 0;
+}
+
+/* configure single firewall entry */
+int configure_firewall_entry(u32 base_addr,
+			struct firewall_desc *fwall,
+			int entry, u8 sai_number)
+{
+	u32 reg;
+	u32 offset = entry * 4;
+
+	if (entry >= 64) {
+		printf("No such entry\n");
+		return 1;
+	}
+
+	/* config hi */
+	writel(fwall->region_hi, base_addr + REGION_INDEX_H + offset);
+	/* config lo */
+	writel(fwall->region_lo, base_addr + REGION_INDEX_L + offset);
+	reg = (fwall->rd_en << 1 | fwall->wr_en << 2
+		| fwall->rd_wr_en << 3);
+	/* config permissions */
+	writel(reg, base_addr + RW_INDEX + offset);
+	/* config sai no to entry */
+	writel(sai_number, base_addr + REGION_SAI_INDEX + offset);
+	return 0;
+}
+
+static void config_top_noc_firewall(u32 base_addr)
+{
+	int i;
+	u32 reg;
+
+	for (i = FW_START_INDEX; i < REGION_INDEX_MAX; i++) {
+		
+		if (i >= 9 && i < 12) /* see switch-case code to understand this */
+			continue;
+
+		writel(0xFFFFFF, base_addr + REGION_INDEX_H + (i * 4));
+		writel(0x0, base_addr + REGION_INDEX_L + (i * 4));
+		writel(0xE, base_addr + RW_INDEX + (i * 4));
+
+		/* Configure all the SAI entries */
+		switch (i) {
+		case 0:
+			writel(CPU0_SAI,
+				base_addr + REGION_SAI_INDEX + (4 * i));
+#if !defined(CONFIG_LIGHTNING_A0)
+			writel(CPU0_SAI,
+				base_addr + EFF_SAI_REG + 4*(CPU0_SAI >> 1));
+#endif
+			break;
+		case 1:
+			writel(CPU1_SAI,
+				base_addr + REGION_SAI_INDEX + (4 * i));
+#if !defined(CONFIG_LIGHTNING_A0)
+			writel(CPU1_SAI,
+				base_addr + EFF_SAI_REG + 4*(CPU1_SAI >> 1));
+#endif
+			break;
+		case 2:
+			writel(CPU2_SAI,
+				base_addr + REGION_SAI_INDEX + (4 * i));
+#if !defined(CONFIG_LIGHTNING_A0)
+			writel(CPU2_SAI,
+				base_addr + EFF_SAI_REG + 4*(CPU2_SAI >> 1));
+#endif
+			break;
+		case 3:
+			writel(CPU3_SAI,
+				base_addr + REGION_SAI_INDEX + (4 * i));
+#if !defined(CONFIG_LIGHTNING_A0)
+			writel(CPU3_SAI,
+				base_addr + EFF_SAI_REG + 4*(CPU3_SAI >> 1));
+#endif
+			break;
+		case 4:
+			writel(PMIAXI_SAI,
+				base_addr
+				+ REGION_SAI_INDEX + (4 * i));
+#if !defined(CONFIG_LIGHTNING_A0)
+			writel(PMIAXI_SAI,
+				base_addr + EFF_SAI_REG + 4*(PMIAXI_SAI >> 1));
+#endif
+			break;
+
+		/* we are using case 5 to 8 for IA VMM because they are unused in reference code */
+		case 5:
+			writel(VMM0_SAI,
+				base_addr + REGION_SAI_INDEX + (4 * i));
+#if !defined(CONFIG_LIGHTNING_A0)
+			writel(VMM0_SAI,
+				base_addr + EFF_SAI_REG + 4*(VMM0_SAI >> 1));
+#endif
+			break;
+		case 6:
+			writel(VMM1_SAI,
+				base_addr + REGION_SAI_INDEX + (4 * i));
+#if !defined(CONFIG_LIGHTNING_A0)
+			writel(VMM1_SAI,
+				base_addr + EFF_SAI_REG + 4*(VMM1_SAI >> 1));
+#endif
+			break;
+		case 7:
+			writel(VMM2_SAI,
+				base_addr + REGION_SAI_INDEX + (4 * i));
+#if !defined(CONFIG_LIGHTNING_A0)
+			writel(VMM2_SAI,
+				base_addr + EFF_SAI_REG + 4*(VMM2_SAI >> 1));
+#endif
+			break;
+		case 8:
+			writel(VMM3_SAI,
+				base_addr + REGION_SAI_INDEX + (4 * i));
+#if !defined(CONFIG_LIGHTNING_A0)
+			writel(VMM3_SAI,
+				base_addr + EFF_SAI_REG + 4*(VMM3_SAI >> 1));
+#endif
+			break;
+
+		default:
+			/* this works based on i>=12; SAI_IA_PCI_0 starts at offset 0x30 */
+			reg = readl(SECURITY_TOP + (4 * i)); 
+			writel(reg,
+				base_addr + REGION_SAI_INDEX + (4 * i));
+#if !defined(CONFIG_LIGHTNING_A0)
+			writel(reg,
+				base_addr + EFF_SAI_REG + 4*(reg >> 1));
+#endif
+			break;
+		}
+	}
+
+#if defined(CONFIG_LIGHTNING_A0)
+	for (i = 1; i <= 36; i++)
+		configure_sai_mask(base_addr + SAI_MASK_OFFSET + (i * 4),
+					ALL_MASKED_VAL);
+#endif
+
+}
+
+/* make this function non-static to prevent undesired optimization with other firewall configuration */
+/* prevent u-boot user from modifying otp contents */
+void config_firewall_protect_otp(u32 base_addr)
+{
+	int i;
+	
+	/* rule 0 */
+	i = 63;
+	writel(0xFFFFFF, base_addr + REGION_INDEX_H + (i * 4));
+	writel(0xECF04, base_addr + REGION_INDEX_L + (i * 4));
+	writel(0xE, base_addr + RW_INDEX + (i * 4));
+	writel(1, base_addr + REGION_SAI_INDEX + (4 * i));
+
+	/* rule 1 */	
+	i = 62;
+	writel(0xECF03, base_addr + REGION_INDEX_H + (i * 4)); /* axi firewall */
+	writel(0xECF03, base_addr + REGION_INDEX_L + (i * 4));
+	writel(0x0, base_addr + RW_INDEX + (i * 4));
+	writel(1, base_addr + REGION_SAI_INDEX + (4 * i));
+
+	/* rule 2 */
+	i = 61;
+	writel(0xECF02, base_addr + REGION_INDEX_H + (i * 4));
+	writel(0xECCC2, base_addr + REGION_INDEX_L + (i * 4));
+	writel(0xE, base_addr + RW_INDEX + (i * 4));
+	writel(1, base_addr + REGION_SAI_INDEX + (4 * i));
+
+	/* rule 3 */
+	i = 60;
+	writel(0xECCC1, base_addr + REGION_INDEX_H + (i * 4)); /* otp sram*/
+	writel(0xECCC0, base_addr + REGION_INDEX_L + (i * 4));
+	writel(0x0, base_addr + RW_INDEX + (i * 4));
+	writel(1, base_addr + REGION_SAI_INDEX + (4 * i));
+
+	/* rule 4 */
+	i = 59;
+	writel(0xECCBF, base_addr + REGION_INDEX_H + (i * 4));
+	writel(0xEC504, base_addr + REGION_INDEX_L + (i * 4));
+	writel(0xE, base_addr + RW_INDEX + (i * 4));
+	writel(1, base_addr + REGION_SAI_INDEX + (4 * i));
+
+	/* rule 5 */
+	i = 58;
+	writel(0xEC503, base_addr + REGION_INDEX_H + (i * 4)); /* vault130 */
+	writel(0xEC500, base_addr + REGION_INDEX_L + (i * 4));
+	writel(0x0, base_addr + RW_INDEX + (i * 4));
+	writel(1, base_addr + REGION_SAI_INDEX + (4 * i));
+
+	/* rule 6 */
+	i = 57;
+	writel(0xEC4FF, base_addr + REGION_INDEX_H + (i * 4));
+	writel(0x0, base_addr + REGION_INDEX_L + (i * 4));
+	writel(0xE, base_addr + RW_INDEX + (i * 4));
+	writel(1, base_addr + REGION_SAI_INDEX + (4 * i));
+	
+	writel(1, base_addr + EFF_SAI_REG + 4*(CPU0_SAI >> 1));
+	writel(1, base_addr + EFF_SAI_REG + 4*(CPU1_SAI >> 1));
+	writel(1, base_addr + EFF_SAI_REG + 4*(CPU2_SAI >> 1));
+	writel(1, base_addr + EFF_SAI_REG + 4*(CPU3_SAI >> 1));
+
+	mb();
+
+	/* block all other SAI */
+	for (i = 0; i < 64; i++)
+	{
+		if ( (i != (CPU0_SAI >> 1)) && (i != (CPU1_SAI >> 1)) &&
+			(i != (CPU2_SAI >> 1)) && (i != (CPU3_SAI >> 1)) )
+		{
+			writel(0, base_addr + EFF_SAI_REG + (4*i));
+		}
+	}
+
+	/* clear all unwanted rules by bootrom */
+	for (i = 0; i < 57; i++)
+	{
+		writel(0x0, base_addr + REGION_INDEX_H + (i * 4));
+		writel(0x0, base_addr + REGION_INDEX_L + (i * 4));
+		writel(0x1, base_addr + RW_INDEX + (i * 4));		
+		writel(0, base_addr + REGION_SAI_INDEX + (4 * i));
+	}
+
+}
+
+
+/* TODO: Initialize with the firewall settings defined by SE.
+ * Definition of peri accesibility is not yet well established.
+ */
+void init_firewall(void)
+{
+	rbe_debug_print("Initializing the firewall ..");
+	/* configure ETH */
+	config_top_noc_firewall(FIREWALL_ETH);
+
+	/* configure peri */
+	config_top_noc_firewall(FIREWALL_PERI);
+
+	/* configure SSB */
+	config_top_noc_firewall(FIREWALL_SSB);
+
+	/* configure DDR */
+	config_top_noc_firewall(FIREWALL_DDR);
+
+#if !defined(CONFIG_IS_HAPS)
+	config_top_noc_firewall(FIREWALL_HSIO_L);
+	config_top_noc_firewall(FIREWALL_HSIO_R);
+#endif
+
+	/* clear NOC error generated by rom */
+	writel(0x1f, FIREWALL_ETH + FIREWALL_INT_SR);
+
+	mb();
+
+#if !defined(CONFIG_IS_HAPS)
+	/* configure AXI */
+	/* must configure FIREWALL_AXI last as we will block firewall region */ 
+	config_firewall_protect_otp(FIREWALL_AXI);
+#endif
+
+	mb();
+	writel(CLR_BOOT_FLAG, RCU_MISC_REG);
+
+	rbe_debug_print("firewall init done\n");
+}
diff --git a/arch/x86/cpu/lightning_mountain/firewall_closed.c b/arch/x86/cpu/lightning_mountain/firewall_closed.c
new file mode 100644
--- /dev/null
+++ b/arch/x86/cpu/lightning_mountain/firewall_closed.c
@@ -0,0 +1,173 @@
+/*
+ * Copyright (c) 2020, MaxLinear, Inc.
+ *
+ * SPDX-License-Identifier: GPL-2.0+
+ *
+*/
+
+#include <common.h>
+#include <asm/io.h>
+#include <asm/cache.h>
+#include <asm/arch/project.h>
+#include <asm/arch/noc/noc_fw_eff_sai.h>
+#include <asm/arch/noc/rbe_noc_fw_ddr_rules.h>
+#include <asm/arch/noc/rbe_noc_fw_lbaxi_rules.h>
+#include <asm/arch/noc/rbe_noc_fw_peri_rules.h>
+#include <asm/arch/noc/rbe_noc_fw_ssb_rules.h>
+
+#define REGION_INDEX_H		0
+#define REGION_INDEX_L		0x100
+#define RW_INDEX		0x200
+#define REGION_SAI_INDEX	0x300
+#define CLR_BOOT_FLAG		0x1
+#define EFF_SAI_REG		0x404
+#define FIREWALL_INT_SR		0x808
+#define RCU_MISC_REG		0xE00201E4
+#define FW_BOOT_FLAG		0x1
+
+/* No HSIO on HAPS mapping, therefore we ommit */
+#ifdef CONFIG_IS_HAPS
+#define NOC_FW_OFFSET		2
+#else
+#define NOC_FW_OFFSET		0
+#endif
+
+static void config_rules(struct noc_fw_rule *rule_list,
+			u32 noc_base, int rule_size,
+			int eff_sai_idx)
+{
+	int i;
+	int rule_idx_max = 63;
+	u32 eff_sai;
+	u32 access_byte;
+
+	if (rule_size > 64) {
+		printf("rule too large\n");
+		return;
+	}
+
+	for (i = 0; i < rule_size; i++, rule_list++) {
+		eff_sai = noc_fw_eff_sai[eff_sai_idx].eff_sai[rule_list->sai >> 1];
+
+		writel(rule_list->low_addr >> 8,
+			noc_base + REGION_INDEX_L + ((rule_idx_max - i) * 4));
+		writel(rule_list->high_addr >> 8,
+			noc_base + REGION_INDEX_H + ((rule_idx_max - i) * 4));
+
+		/* In the header file, values are right shifted by 1. In the register, we need to left shift by 1 before programming */
+		/* The right shift is done to allow the the access permissions to fit in a byte */
+		access_byte = (rule_list->access) << 1;
+		writel(access_byte,
+			noc_base + RW_INDEX + ((rule_idx_max - i) * 4));
+
+		writel(eff_sai,
+			noc_base + REGION_SAI_INDEX + ((rule_idx_max - i) * 4));
+	}
+}
+
+static void config_eff_sai(u32 noc_base, int eff_sai_array_index)
+{
+	int i;
+	int num_sai_indexes = 64;
+
+	/* for each FW, we update the eff sai index value */
+	for (i = 0; i < num_sai_indexes; i++)
+		writel(noc_fw_eff_sai[eff_sai_array_index].eff_sai[i],
+				noc_base + NOC_EFF_SAI_OFFSET + i*4);
+}
+
+static void initialize_sai_values(void)
+{
+	int i;
+	int size = sizeof(sai_ia)
+			/ sizeof(sai_ia[0]);
+
+	/* reconfigure SAI values for software use */
+	for (i = 0; i < size; i++) {
+		writel(sai_ia[i].sai_ia,
+			sai_ia[i].off + SAI_IA_OFFSET
+				+ SECURITY_TOP_BASE);
+	}
+}
+
+static void clear_fw_rules(u32 noc_addr, int start, int end)
+{
+	int i;
+
+	for (i = start; i < end; i++) {
+		writel(0, noc_addr + REGION_INDEX_L + (i * 4));
+		writel(0, noc_addr + REGION_INDEX_H + (i * 4));
+		writel(1, noc_addr + RW_INDEX + (i * 4));
+		writel(0, noc_addr + REGION_SAI_INDEX + (i * 4));
+	}
+}
+
+/* Initialize with the firewall settings
+ * for U-boot and beyond
+ */
+void init_firewall(void)
+{
+	int i;
+	int num_of_fw = 7;
+	int fw_array_start = NOC_FW_OFFSET;
+	int ssb_rule_size, ddr_rule_size;
+	int peri_rule_size, axi_rule_size;
+
+	initialize_sai_values();
+
+	/* Peri firewall rules */
+	peri_rule_size = sizeof(rbe_fw_peri_rules)
+			/ sizeof(rbe_fw_peri_rules[0]);
+	config_rules(&rbe_fw_peri_rules[0],
+			FIREWALL_PERI, peri_rule_size, 2);
+
+	/* AXI firewall rules */
+	axi_rule_size = sizeof(rbe_fw_lbaxi_rules)
+			/ sizeof(rbe_fw_lbaxi_rules[0]);
+	config_rules(&rbe_fw_lbaxi_rules[0],
+			FIREWALL_AXI, axi_rule_size, 5);
+
+	/* DDR firewall rules */
+	ddr_rule_size = sizeof(rbe_fw_ddr_rules)
+			/ sizeof(rbe_fw_ddr_rules[0]);
+	config_rules(&rbe_fw_ddr_rules[0],
+			FIREWALL_DDR, ddr_rule_size, 6);
+
+	/* SSB firewall rules */
+	ssb_rule_size = sizeof(rbe_fw_ssb_rules)
+			/ sizeof(rbe_fw_ssb_rules[0]);
+	config_rules(&rbe_fw_ssb_rules[0],
+			FIREWALL_SSB, ssb_rule_size, 3);
+
+	for (i = fw_array_start; i < num_of_fw; i++) {
+		config_eff_sai(noc_fws[i].fw_base, i);
+	}
+
+	/* Clear PERI */
+	clear_fw_rules(FIREWALL_PERI, 0, 64 - peri_rule_size);
+	/* Clear  AXI */
+	clear_fw_rules(FIREWALL_AXI, 0, 64 - axi_rule_size);
+	/* Clear DDR */
+	clear_fw_rules(FIREWALL_DDR, 0, 64 - ddr_rule_size);
+	/* Clear SSB */
+	clear_fw_rules(FIREWALL_SSB, 0, 64 - ssb_rule_size);
+
+#if !defined(CONFIG_IS_HAPS)
+	/* Skip HSIO configuration on HAPS, no HW mapping */
+	/* Clear HSIO_R */
+	clear_fw_rules(FIREWALL_HSIO_R, 0, 64);
+	/* Clear HSIO_L */
+	clear_fw_rules(FIREWALL_HSIO_L, 0, 64);
+#endif /* CONFIG_IS_HAPS */
+
+	/* Clear ETH */
+	clear_fw_rules(FIREWALL_ETH, 0, 64);
+
+	mb();
+	writel(FW_BOOT_FLAG, RCU_MISC_REG);
+
+	/* clear NOC error generated by rom */
+	writel(0x1f, FIREWALL_ETH + FIREWALL_INT_SR);
+
+	return;
+}
diff --git a/arch/x86/cpu/lightning_mountain/ia_vmm.S b/arch/x86/cpu/lightning_mountain/ia_vmm.S
new file mode 100644
--- /dev/null
+++ b/arch/x86/cpu/lightning_mountain/ia_vmm.S
@@ -0,0 +1,94 @@
+/*
+ * Copyright (C) 2019, Intel Technology Asia
+ *
+ * SPDX-License-Identifier:	GPL-2.0+
+ */
+
+/* Can be called as C function allowing switch to IA_VMM mode */
+
+.globl ia_vmm
+ia_vmm:
+        push   %edi
+        push   %esi
+        push   %eax
+        push   %ebx
+        push   %ecx
+        push   %edx
+
+        movl   $0xFEE00000, %edi
+        movl   0x20(%edi), %eax
+        shr    $0x19, %eax
+
+        cmp    $0x7, %eax
+        jz     core7_setup
+
+        cmp    $0x6, %eax
+        jz     core6_setup
+
+        cmp    $0x5, %eax
+        jz     core5_setup
+
+        cmp    $0x4, %eax
+        jz     core4_setup
+
+        cmp    $0x3, %eax
+        jz     core3_setup
+
+        cmp    $0x2, %eax
+        jz     core2_setup
+
+        cmp    $0x1, %eax
+        jz     core1_setup
+
+        cmp    $0x0, %eax
+        jz     core0_setup
+
+core7_setup:
+        movl   $0xE600AE40, %esi
+        jmp    secure_access
+
+core6_setup:
+        movl   $0xE600AC40, %esi
+        jmp    secure_access
+
+core5_setup:
+        movl   $0xE600AA40, %esi
+        jmp    secure_access
+
+core4_setup:
+        movl   $0xE600A840, %esi
+        jmp    secure_access
+
+core3_setup:
+        movl   $0xE600A640, %esi
+        jmp    secure_access
+
+core2_setup:
+        movl   $0xE600A440, %esi
+        jmp    secure_access
+
+core1_setup:
+        movl   $0xE600A240, %esi
+        jmp    secure_access
+
+core0_setup:
+        movl   $0xE600A040, %esi
+        jmp    secure_access
+
+secure_access:
+        movl   $0x120, %ecx
+        rdmsr
+
+#ifdef CONFIG_ENABLE_IA_VMM_SWITCH
+        orl    $0x040, %eax
+        wrmsr
+#endif
+
+        pop   %edx
+        pop   %ecx
+        pop   %ebx
+        pop   %eax
+        pop   %esi
+        pop   %edi
+        ret
+
diff --git a/arch/x86/cpu/lightning_mountain/microcode.c b/arch/x86/cpu/lightning_mountain/microcode.c
new file mode 100644
--- /dev/null
+++ b/arch/x86/cpu/lightning_mountain/microcode.c
@@ -0,0 +1,151 @@
+/*
+ * Copyright (C) 2016, 2017 Intel Technology Asia Pte Ltd
+ *
+ * SPDX-License-Identifier:	GPL-2.0+
+ */
+
+#include <common.h>
+#include <asm/lapic.h>
+#include <asm/arch/project.h>
+#include <asm/arch/api.h>
+#include <asm/msr.h>
+#include <asm/msr-index.h>
+#include <asm/cpu.h>
+#include <asm/cache.h>
+#include <asm/processor.h>
+#include <asm/microcode.h>
+#include <hang.h>
+#include <linux/delay.h>
+#include <asm/global_data.h>
+
+DECLARE_GLOBAL_DATA_PTR;
+
+#ifdef MICROCODE_PATCH_INTEL_CHD
+#define C10					8
+/* Note: DDR need to be setup before ucode patch */
+#define SMP_CHECK_REG		0x3ffc
+#define AP_RESET_VECTOR		0x4000
+
+#ifdef CONFIG_SPL_BUILD
+extern u32 _start_ap;
+extern u32 _end_ap;
+u32 ucode_base = 0;
+u32 ucode_size = 0;
+
+const u8 APIC[4] = {0, 2, C10, C10+2};
+#endif
+
+int x86_CHD_SMP_microcode_patching(void)
+{
+	int ret;
+	u32 mode,sub,cmd,adr;
+	u32 apic_id = lapicid();
+	u32 cpu_id = ((apic_id < C10)?(apic_id):(apic_id+4-C10))/2;
+
+	rbe_debug_print("\n x86_uCODE: <APIC ID:%02x> <CPU ID:%02x> \n",
+			apic_id, cpu_id);
+
+	if (apic_id) {
+		if (cpu_id != 3)
+			ret = microcode_update_apic();
+		else
+			ret = 0;
+
+		if (ret == 0 || ret == -EEXIST || ret == -ENOENT) {
+			REG32(SMP_CHECK_REG) = 1;
+			wmb();
+			/*put core2/3 in c6 power off state for unfused chip*/
+			if ((cpu_id >= 2) && (REG32(0xecc80004) == 0x000808c3) ){
+				mode = 6;
+				sub = 2;
+				cmd = ((mode-1)<<4)+sub;//0x52
+				adr = 0x30000000 + (cpu_id-2)*0x100000;
+				asm volatile("monitor\n\t"::"a"(adr), "c"(0), "d"(0));
+				asm volatile("mwait  \n\t"::"a"(cmd), "c"(0));
+			}
+
+			/* AP ready to halt and wait for SIPI in kernel */
+			for(;;)
+				cpu_hlt();
+		} else {
+			printf("microcode patch failed for APIC %d, ret: %d\n",
+				apic_id, ret);
+			hang();
+		}
+	} else {
+		ret = microcode_update_intel();
+		if (ret < 0) {
+			printf("microcode patch failed, ret: %d\n", ret);
+			hang();
+		}
+
+		/* Complete & confirm p-unit patch */
+		microcode_patch_done();
+
+		/* after BSP ucode patching increase the cpu id manually,
+		 * a better way is to use semaphore instead of
+		 * SMP_CHECK_REG check
+		*/
+		cpu_id++;
+	}
+
+
+#ifdef CONFIG_SPL_BUILD
+	u16 i;
+	int num_cores = CONFIG_SMP_CORES;
+	u32 relocation_mask = CONFIG_SPL_TEXT_BASE & 0xFF000000;
+	/* VV = 4, AP reset vector 4000H */
+	u32 *resetvec_dst_ptr = (u32 *)AP_RESET_VECTOR;
+	u32 *resetvec_src_ptr = (u32 *)&_start_ap;
+	u32 *end_vector = (u32 *)(&_end_ap);
+	u32 *end_ptr, *start_ptr;
+
+	/* to make sure that the start and end vectors are relocated */
+	if (((u32)end_vector & relocation_mask) &&
+		((u32)resetvec_src_ptr & relocation_mask) == 0)
+		end_ptr = (u32 *)((u32)end_vector + gd->reloc_off);
+	else
+		end_ptr = end_vector;
+
+	if ((u32)resetvec_src_ptr & relocation_mask &&
+			((u32)end_vector & relocation_mask) == 0)
+		start_ptr = (u32 *)((u32)resetvec_src_ptr + gd->reloc_off);
+	else
+		start_ptr = resetvec_src_ptr;
+
+	if (cpu_is_urx6x1())
+		num_cores = 2;
+
+	/* copy AP reset vector code to AP_RESET_VECTOR */
+	for(; start_ptr < end_ptr;) {
+		*resetvec_dst_ptr++ = *start_ptr++;
+	}
+
+	wmb();
+
+	/* SIPI message contains a vector to the BIOS AP initialization code at
+		000VV000H, where VV is the vector contained in the SIPI message */
+	/*process 4 cores for unfused chip*/
+	if(REG32(0xecc80004) == 0x000808c3)
+		num_cores = 4;
+	for (i = 1; i < num_cores; i++) {
+		udelay(10);
+		REG32(SMP_CHECK_REG) = 0;
+		wmb();
+		/* Sequentially wake up APIC, one-by-one */
+		*(volatile u32 *)(0xfee00310) = ((APIC[i]&0xff)<<24);
+		*(volatile u32 *)(0xfee00300) = 0x500;
+		udelay(500);
+		*(volatile u32 *)(0xfee00310) = ((APIC[i]&0xff)<<24);
+		/* VV = 4, AP reset vector 4000H */
+		*(volatile u32 *)(0xfee00300) = 0x604;
+		/* wait for AP to increase cpu_id counter */
+		while(REG32(SMP_CHECK_REG) == 0);
+		cpu_id++;
+	}
+
+#endif
+
+	return 0;
+}
+#endif /* MICROCODE_PATCH_INTEL_CHD */
diff --git a/arch/x86/cpu/lightning_mountain/mtrr.c b/arch/x86/cpu/lightning_mountain/mtrr.c
new file mode 100644
--- /dev/null
+++ b/arch/x86/cpu/lightning_mountain/mtrr.c
@@ -0,0 +1,161 @@
+/*
+ * SPDX-License-Identifier:	GPL-2.0+
+ *
+ * Memory Type Range Regsters - these are used to tell the CPU whether
+ * memory is cacheable and if so the cache write mode to use.
+ *
+ * These can speed up booting. See the mtrr command.
+ *
+ * Reference: Intel Architecture Software Developer's Manual, Volume 3:
+ * System Programming
+ */
+
+#include <common.h>
+#include <asm/io.h>
+#include <asm/global_data.h>
+#include <asm/msr.h>
+#include <asm/mtrr.h>
+
+#define PAGE_SHIFT 12
+
+DECLARE_GLOBAL_DATA_PTR;
+
+/* Prepare to adjust MTRRs */
+void mtrr_open(struct mtrr_state *state, bool do_caches)
+{
+	if (!gd->arch.has_mtrr)
+		return;
+
+	state->enable_cache = dcache_status();
+
+	if (state->enable_cache)
+		disable_caches();
+	state->deftype = native_read_msr(MTRR_DEF_TYPE_MSR);
+	wrmsrl(MTRR_DEF_TYPE_MSR, state->deftype & ~MTRR_DEF_TYPE_EN);
+}
+
+/* Clean up after adjusting MTRRs, and enable them */
+void mtrr_close(struct mtrr_state *state, bool do_caches)
+{
+	if (!gd->arch.has_mtrr)
+		return;
+
+	wrmsrl(MTRR_DEF_TYPE_MSR, state->deftype | MTRR_DEF_TYPE_EN);
+	if (state->enable_cache)
+		enable_caches();
+}
+
+void init_mtrr_range(unsigned int reg, unsigned long base, unsigned long size, unsigned int type)
+{
+	unsigned int base_msr_low;
+	unsigned int base_msr_high;
+	unsigned int mask_msr_low;
+	unsigned int mask_msr_high;
+	unsigned int size_and_mask = 0x00f00000;
+	unsigned int reg_base ;
+	unsigned int reg_mask ;
+
+	reg_mask = 0x200 + reg*2 + 1;
+	reg_base = 0x200 + reg*2;
+
+	base = base >> PAGE_SHIFT;
+	size = size >> PAGE_SHIFT;
+
+	base_msr_low = base << PAGE_SHIFT | type ;
+	base_msr_high  = ( base & size_and_mask ) >> (32 - PAGE_SHIFT);
+	mask_msr_low = -size << PAGE_SHIFT | 0x800;
+	mask_msr_high = (-size & size_and_mask) >> (32 - PAGE_SHIFT);
+
+	asm  __volatile__ (
+			" mov %0, %%ecx ; "
+			" mov %1, %%edx ; "
+			" mov %2, %%eax ; "
+			" wrmsr ; "
+			:
+			: "r"(reg_base),  "r"(base_msr_high), "r"(base_msr_low)
+			: "%eax", "%edx", "%ecx"
+			);
+
+	asm  __volatile__ (
+			" mov %0, %%ecx ; "
+			" mov %1, %%edx ; "
+			" mov %2, %%eax ; "
+			" wrmsr ; "
+
+			:
+			: "r"(reg_mask), "r"(mask_msr_high), "r"(mask_msr_low)
+			: "%eax", "%edx", "%ecx"
+			);
+}
+
+void mtrr_init(void)
+{
+	asm  __volatile__ (
+			" mov $0x2ff, %%ecx ; "
+			" mov $0x0, %%edx ; "
+			" mov $0x800, %%eax ; "
+			" wrmsr ; "
+
+			:
+			:
+			: "%eax", "%edx", "%ecx"
+			);
+}
+
+void mtrr_disable(void)
+{
+	asm  __volatile__ (
+			" mov $0x2ff, %%ecx ; "
+			" mov $0x0, %%edx ; "
+			" mov $0x0, %%eax ; "
+			" wrmsr ; "
+
+			:
+			:
+			: "%eax", "%edx", "%ecx"
+			);
+}
+
+unsigned long int boundary_2xx_align(unsigned long int origin)
+{
+	unsigned int one_bits_total = 0, one_bits_highest = 0;
+	unsigned long int new = 0;
+	int move = 0;
+
+	for (move = 0; move < 64; move++)
+	{
+		if ((origin & 0x00000001) != 0)
+		{
+			one_bits_total++;
+			one_bits_highest = move;
+		}
+		origin = (origin >> 1);
+	}
+	if (one_bits_total <= 1)
+		new = (1 << one_bits_highest);
+	else
+		new = (1 << (one_bits_highest + 1));
+	return new;
+}
+
+void mtrr_set_req_offset(int offset, int type, uint32_t start_addr,
+				uint32_t sect_size)
+{
+	struct mtrr_state state;
+	uint64_t mask;
+	uint64_t start, size;
+
+	start = 0;
+	size = 0;
+
+	start |= (uint64_t)start_addr;
+	size |= (uint64_t)sect_size;
+
+	mtrr_open(&state, true);
+	mask = ~(size - 1);
+	mask &= (1ULL << CONFIG_CPU_ADDR_BITS) - 1;
+	wrmsrl(MTRR_PHYS_BASE_MSR(offset), start | type);
+	wrmsrl(MTRR_PHYS_MASK_MSR(offset), mask | MTRR_PHYS_MASK_VALID);
+
+	mtrr_close(&state, true);
+}
diff --git a/arch/x86/cpu/lightning_mountain/pon_shell.c b/arch/x86/cpu/lightning_mountain/pon_shell.c
new file mode 100644
--- /dev/null
+++ b/arch/x86/cpu/lightning_mountain/pon_shell.c
@@ -0,0 +1,11 @@
+#include "pon_shell.h"
+
+int pon_shell_init(void)
+{
+#ifdef CONFIG_LIGHTNING_A0
+	REG32(PON_SHELL_GEN_CTRL) &= (~(0x7<<11)) | 0x70;
+#else
+	REG32(PON_SHELL_GEN_CTRL) &= (~(0x1<<12)) | 0x10;
+#endif
+	return 0;
+}
