+
+/* Shift first, then mask, usually for write operation */
+#define SM(_v, _f)		(((_v) << _f##_S) & (_f))
+
+/* Mask first , then shift, usually for read operation */
+#define MS(_v, _f)		(((_v) & (_f)) >> _f##_S)
+
+enum {
+	PCIE_PORT0 = 0,
+	PCIE_PORT1,
+	PCIE_PORT2,
