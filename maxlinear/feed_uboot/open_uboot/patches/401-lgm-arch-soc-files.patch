+	PCIE_PORT4,
+	PCIE_PORT5,
+	PCIE_PORT6,
+	PCIE_PORT7,
+	PCIE_PORT_MAX,
+};
+
+#define PCIE_HSIO_LEFT(X) ((X) == PCIE_PORT0 || (X) == PCIE_PORT1 ||\
+			   (X) == PCIE_PORT2 || (X) == PCIE_PORT3)
+
+
+#define PCIE_HSIO_RIGHT(X) ((X) == PCIE_PORT4 || (X) == PCIE_PORT5 ||\
