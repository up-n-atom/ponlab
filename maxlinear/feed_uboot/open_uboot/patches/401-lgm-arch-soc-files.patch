+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program; if not, write to the Free Software
+ * Foundation, Inc., 59 Temple Place, Suite 330, Boston,
+ * MA 02111-1307 USA
+ */
+
+#include <config.h>
+#include <asm/processor-flags.h>
+#include <generated/asm-offsets.h>
+
+.section .text
+
+.globl car_init
+car_init:
+	/* 0x00000000..0x7fffffff (2GB) WB (type=6) */
+	mov $0x00000006, %eax;
+	mov $0x00000000, %edx;
+	mov $0x200, %ecx;				# MTRRphysBase0
+	wrmsr;
+	mov $0x80000800, %eax;
+	mov $0x0000000f, %edx;
+	mov $0x201, %ecx;				# MTRRphysMask0
+	wrmsr;
+	inc %esi
+
+	/* 0x80000000..0xbfffffff (1GB) WB (type=6) */
+	mov $0x80000006, %eax;
+	mov $0x00000000, %edx;
+	mov $0x202, %ecx;				# MTRRphysBase1
+	wrmsr;
+	mov $0xc0000800, %eax;
+	mov $0x0000000f, %edx;
+	mov $0x203, %ecx;				# MTRRphysMask1
+	wrmsr;
+	inc %esi
+
+	/* 0xecd00000..0xecd7ffff (512KB) WP (type=5) */
+	/* DO NOT CHANGE TO WB (type=6) because SOC hardware
+	 * cannot support this address range
+	 */
+	mov $0xecd00005, %eax;
+	mov $0x00000000, %edx;
+	mov $0x204, %ecx;				# MTRRphysBase2
+	wrmsr;
+	mov $0xfff80800, %eax;
+	mov $0x0000000f, %edx;
+	mov $0x205, %ecx;				# MTRRphysMask2
+	wrmsr;
+	inc %esi
+
+	/* 0xfffc0000..0xffffffff (256KB) WP (type=5) */
+	/* NO NEED TO CHANGE THIS TO WB (type=6) because
+	 * writes to ROM region WILL NOT happen
+	 */
+	mov $0xfffc0005, %eax;
+	mov $0x00000000, %edx;
+	mov $0x206, %ecx;				# MTRRphysBase3
+	wrmsr;
+	mov $0xfffc0800, %eax;
+	mov $0x0000000f, %edx;
+	mov $0x207, %ecx;				# MTRRphysMask3
+	wrmsr;
+	inc %esi
+
+	/* 4.0000.0000..4.bfff.ffff, 3GB to 4GB region WB (type=6) */
+	mov $0x00000006, %eax;
+	mov $0x00000004, %edx;
+	mov $0x208, %ecx;				# MTRRphysBase4
+	wrmsr;
+	mov $0xc0000800, %eax;
+	mov $0x0000000f, %edx;
+	mov $0x209, %ecx;				# MTRRphysMask4
+	wrmsr;
+	inc %esi
+
+	# 0x1.0000.0000..0x1.ffff.ffff (4GB) WB (type=6)
+	mov $0x00000006, %eax;
+	mov $0x00000001, %edx;
+	mov $0x20a, %ecx;				# MTRRphysBase5
+	wrmsr;
+	mov $0x00000800, %eax;
+	mov $0x0000000f, %edx;
+	mov $0x20b, %ecx;				# MTRRphysMask5
+	wrmsr;
+	inc %esi
+
+	# 0x2.0000.0000..0x3.ffff.ffff (8GB) WB (type=6)
+	mov $0x00000006, %eax;
+	mov $0x00000002, %edx;
+	mov $0x20c, %ecx;				# MTRRphysBase6
+	wrmsr;
+	mov $0x00000800, %eax;
+	mov $0x0000000e, %edx;
+	mov $0x20d, %ecx;				# MTRRphysMask6
+	wrmsr;
+	inc %esi
+
+	# Program E (bit 11 = MTRR Enabled) flag + FE (fixed MTRRs disabled) flag
+	# Default memory type = 0 (Strong UC)
+	mov $0x800, %eax;
+	mov $0x000, %edx;
+	mov $0x2ff, %ecx;				# MTRRdefType
+	wrmsr;
+
+	# Cache setting
+	movl %cr0, %eax;
+	andl $(0x9fffffff), %eax;		# Enable Cache: Clear CR0.CD, CR0.NW
+	#orl $(0x60000000), %eax;		# Disable Cache: Set CR0.CD, CR0.NW
+
+	# Now enable SSE and the like
+	and $0xfffb, %ax;				# Clear coprocessor emulation CR0.EM
+	or  $0x2, %ax;					# Set coprocessor monitoring  CR0.MP
+	mov %eax, %cr0;
+	mov %cr4, %eax;
+	or  $0x600, %ax;				# Set CR4.OSFXSR and CR4.OSXMMEXCPT at the same time
+	mov %eax, %cr4;
+	fninit;							# Initialize FPU without checking for pending unmasked floating-point exceptions.
+
+	jmp	car_init_ret
