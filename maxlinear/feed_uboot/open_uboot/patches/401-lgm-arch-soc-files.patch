+#include <asm/secureboot.h>
+#include <linux/mtd/rawnand.h>
+
+DECLARE_GLOBAL_DATA_PTR;
+
+#define CONFIG_SYS_NAND_READ_DELAY \
+	{ volatile int dummy = 0; int i; for (i=0; i<10000; i++) dummy++; }
+
+#ifndef CONFIG_SYS_NAND_OOBSIZE
+#define CONFIG_SYS_NAND_OOBSIZE	64
+#endif
+
+/* For debug purposes */
+/* #define NAND_UNCOMPRESS_IMAGE */
+#ifdef NAND_UNCOMPRESS_IMAGE
+#define CONFIG_COMPRESS						0
+#define CONFIG_SYS_NAND_U_BOOT_SIZE			(512 << 10)
+#define UNCOMPRESS_UBOOT_LOAD_ADDR			(CONFIG_SYS_TEXT_BASE - sizeof(struct image_header))
+#define LZMA_UBOOT_LOAD_ADDR				UNCOMPRESS_UBOOT_LOAD_ADDR
+#else
+/* limit compressed uboot (u-boot-ram.bin) to 320kb */
+#define CONFIG_COMPRESS						1
+#define CONFIG_SYS_NAND_U_BOOT_SIZE			(320 << 10)
+#endif
+
+#ifdef CONFIG_TEP_PKG
+#define SIZE_OF_MKIMAGE_HEADER		0x40
+/* as defined in mtdparts */
+#define TEP_FIRMWARE_OFFSET_NAND	((CONFIG_SYS_NAND_U_BOOT_OFFS + CONFIG_UBOOT_PART_SIZE) * 2)
+extern int launch_tep(u32 tep_ddr_base, u32 aic_address);
+#endif /* CONFIG_TEP_PKG */
+extern void uncompress_image(ulong image_addr, int uncompress);
+unsigned char oob_buf[CONFIG_SYS_NAND_OOBSIZE];
+
+
+static int nand_spl_bad(struct mtd_info *mtd, loff_t ofs)
+{
+	return 0;
+}
+
+/* extracted command control from nand base layer.
+ * this is here to reduce the size of nand flash spl
+ */
+static int nand_command(struct mtd_info *mtd, int block,
+			int page, int offs, u8 cmd)
+{
+	struct nand_chip *this = mtd_to_nand(mtd);
+	int page_addr = page + block * CONFIG_SYS_NAND_PAGE_COUNT;
+
+	if (this->dev_ready)
+		while (!this->dev_ready(mtd))
+			;
+	else
+		CONFIG_SYS_NAND_READ_DELAY;
+
+	/* Emulate NAND_CMD_READOOB */
+	if (cmd == NAND_CMD_READOOB) {
+		offs += CONFIG_SYS_NAND_PAGE_SIZE;
+		cmd = NAND_CMD_READ0;
+	}
+
+	/* Begin command latch cycle */
+	this->cmd_ctrl(mtd, cmd, NAND_CTRL_CLE | NAND_CTRL_CHANGE);
+	/* Set ALE and clear CLE to start address cycle */
+	/* Column address */
+	this->cmd_ctrl(mtd, offs & 0xff,
+		       NAND_CTRL_ALE | NAND_CTRL_CHANGE); /* A[7:0] */
+	this->cmd_ctrl(mtd, (offs >> 8) & 0xff, NAND_CTRL_ALE); /* A[11:9] */
+	/* Row address */
+	this->cmd_ctrl(mtd, (page_addr & 0xff), NAND_CTRL_ALE); /* A[19:12] */
+	this->cmd_ctrl(mtd, ((page_addr >> 8) & 0xff),
+		       NAND_CTRL_ALE); /* A[27:20] */
+#ifdef CONFIG_SYS_NAND_5_ADDR_CYCLE
+	/* One more address cycle for devices > 128MiB */
+	this->cmd_ctrl(mtd, (page_addr >> 16) & 0x0f,
+		       NAND_CTRL_ALE); /* A[31:28] */
+#endif
+	/* Latch in address */
+	this->cmd_ctrl(mtd, NAND_CMD_READSTART,
+		       NAND_CTRL_CLE | NAND_CTRL_CHANGE);
+	this->cmd_ctrl(mtd, NAND_CMD_NONE, NAND_NCE | NAND_CTRL_CHANGE);
+
+	/*
+	 * Wait a while for the data to be ready
+	 */
+	if (this->dev_ready)
+		while (!this->dev_ready(mtd))
+			;
+	else
+		CONFIG_SYS_NAND_READ_DELAY;
+
+	return 0;
+}
+
+/* read page with ecc enabled */
+static int nand_page_read(struct mtd_info *mtd, struct nand_chip *chip,
+			u8 *dst, unsigned int block,
+			unsigned int page)
+{
+	u32 pg_per_blk = mtd->erasesize / mtd->writesize;
+
+	nand_command(mtd, block, page, 0, NAND_CMD_READ0);
+	chip->ecc.read_page(mtd, chip,
+			dst, 0, (block * pg_per_blk) + page);
+
+	return 0;
+}
+
+/* hw abstraction layer of loading from nand flash */
+static int nand_load(struct mtd_info *mtd, unsigned int offs,
+			unsigned int uboot_size, uchar *dst)
+{
+	unsigned int block, lastblock;
+	unsigned int page;
+	struct nand_chip *chip = mtd_to_nand(mtd);
+
+	/*
+	 * offs has to be aligned to a page address!
+	 */
+	block = offs / CONFIG_SYS_NAND_BLOCK_SIZE;
+	lastblock = (offs + uboot_size - 1) / CONFIG_SYS_NAND_BLOCK_SIZE;
+	page = (offs % CONFIG_SYS_NAND_BLOCK_SIZE) / CONFIG_SYS_NAND_PAGE_SIZE;
+
+	while (block <= lastblock) {
+		if (!chip->block_bad(mtd, offs)) {
+			/*
+			 * Skip bad blocks
+			 */
+			while (page < CONFIG_SYS_NAND_PAGE_COUNT) {
+				nand_page_read(mtd, chip,
+						dst, block, page);
+				dst += CONFIG_SYS_NAND_PAGE_SIZE;
+				page++;
+			}
+			page = 0;
+		} else {
+			lastblock++;
+		}
+
+		block++;
+	}
+	return 0;
+}
+
+static void mtd_info_init(struct mtd_info *mtd_data,
+			struct nand_chip *chip)
+{
+	mtd_data->size = CONFIG_NAND_FLASH_SIZE * (1 << 20);
+	mtd_data->erasesize = CONFIG_SYS_NAND_BLOCK_SIZE;
+	mtd_data->writesize = CONFIG_SYS_NAND_PAGE_SIZE;
+	mtd_data->oobsize = CONFIG_SYS_NAND_OOBSIZE;
+	chip->page_shift = ffs(mtd_data->writesize) - 1;
+	chip->bbt_erase_shift = ffs(mtd_data->erasesize) - 1;
+	chip->numchips = 1;
+	chip->chipsize = mtd_data->size;
+	chip->oob_poi = (u8 *)&oob_buf;
+	chip->block_bad = nand_spl_bad;
+}
+
+#ifdef CONFIG_TEP_PKG
+static int load_tep_firmware(struct mtd_info *mtd_data,
+				int bootimage)
+{
+	int ret;
+	unsigned long tep_offset;
+	u32 entry_addr, aic_addr;
+
+	/* since we do not have any mtd info, use the build configuration
+	 * data that we have on the TEP location in flash.
+	 */
+	if (bootimage == 0)
+		tep_offset = TEP_FIRMWARE_OFFSET_NAND;
+	else
+		tep_offset = TEP_FIRMWARE_OFFSET_NAND + TEP_FIRMWARE_SIZE;
+
+	/*
+	 * Load TEP image from NAND into RAM
+	 */
+	rbe_debug_print("\n SPL: <TEP_FIRMWARE_OFFSET_NAND:0x%x>\n", TEP_FIRMWARE_OFFSET_NAND);
+	rbe_debug_print(" SPL: <TEP_FIRMWARE_SIZE:0x%x>\n", TEP_FIRMWARE_SIZE);
+	rbe_debug_print(" SPL: <TEP_LOAD_BASE:0x%x>\n", TEP_LOAD_BASE);
+
+	ret = nand_load(mtd_data, tep_offset,
+			TEP_FIRMWARE_SIZE,
+			(uchar *)TEP_LOAD_BASE);
+	if (ret)
+		return ret;
+
+#if defined(CONFIG_CHD_SECURE_BOOT)
+	u32 img_rollback_id = 0;
+	u32 otp_rollback_id  = 0;
+	u32 img_id = 0;
+	u32 sb_attrib_err = SB_ATTRIB_VALID;
+	struct SBIF_Attributes attribute_table;
+
+	ret = bootrom_sec_api_auth(TEP_LOAD_BASE, &attribute_table);
+	if (ret)
+		return ret;
+
+	sb_attrib_err = get_sbif_attributes(&attribute_table, &aic_addr,
+							&entry_addr, &img_rollback_id, &img_id);
+	if (SB_ATTRIB_INVALID == sb_attrib_err) {
+		/* invalid image attribute */
+		return SB_ATTRIB_INVALID;
+	} else {
+		rbe_debug_print("\n TODO: ATTRIB HANDLING <0x%08x>: <%s>:<%d>:<%s> \n",
+					sb_attrib_err, __FILE__, __LINE__, __func__);
+	} /* SB_ATTRIB_INVALID */
+
+#if defined(CONFIG_ROLLBACKID_SUPPORT)
+	otp_rollback_id = chk_rollback_id(SB_ROLLBACK_ID_TEP);
+
+	/* check image anti-rollback with otp anti-rollback value */
+	if (img_rollback_id < otp_rollback_id)
+		return 1;
+#endif /* CONFIG_ROLLBACKID_SUPPORT */
+
+#else
+	/* TODO: Will remove this, for development purpose only
+	 * TEP will not run without secure boot.
+	 */
+	entry_addr = TEP_LOAD_BASE;
+	aic_addr = 0x01000000;
+#endif /* CONFIG_CHD_SECURE_BOOT */
+
+	ret = launch_tep(entry_addr, aic_addr);
+	if (ret) {
+		printf("Error launching TEP\n");
+		return ret;
+	}
+
+	return 0;
+}
+#endif /* CONFIG_TEP_PKG */
+
+static int do_boot_uboot(struct mtd_info *mtd_data,
+			int bootimage)
+{
+	int ret;
+	unsigned long mkimage_size = 0;
+	unsigned long uboot_offset;
+	unsigned long spl_pad_size;
+	unsigned long uboot_part_size = CONFIG_UBOOT_PART_SIZE;
+
+	spl_pad_size = env_get_ulong("rbe_pad_size", 16, 0);
+
+	if (spl_pad_size == 0)
+		spl_pad_size = CONFIG_SYS_NAND_U_BOOT_OFFS;
+
+	if (bootimage == 0)
+		uboot_offset = spl_pad_size;
+	else
+		uboot_offset = (spl_pad_size * 2 + uboot_part_size);
+
+#if defined(CONFIG_CUSTOMER_TEST_IMG_BUILD)
+	uboot_offset = CONFIG_SYS_NAND_U_BOOT_OFFS;
+#endif
+
+	/*
+	 * Load U-Boot image from NAND into RAM
+	 */
+	rbe_debug_print("\n SPL: spl_pad_size:0x%x>\n", spl_pad_size);
+	rbe_debug_print(" SPL: uboot_part_size:0x%x>\n", uboot_part_size);
+	rbe_debug_print(" SPL: <LZMA_UBOOT_LOAD_ADDR:0x%x>\n", LZMA_UBOOT_LOAD_ADDR);
+
+	ret = nand_load(mtd_data, uboot_offset,
+			CONFIG_SYS_NAND_U_BOOT_SIZE,
+			(uchar *)LZMA_UBOOT_LOAD_ADDR);
+	if (ret)
+		goto error;
+
+#if defined(CONFIG_CHD_SECURE_BOOT)
+	u32 img_rollback_id = 0;
+	u32 otp_rollback_id  = 0;
+	u32 img_id = 0;
+	u32 sb_attrib_err = SB_ATTRIB_VALID;
+	struct SBIF_Attributes attribute_table;
+
+	mkimage_size = sizeof(struct image_header);
+
+	/* copy the mkimage header to prevent it from being overwritten
+	 * by the authentication process
+	 */
+	memcpy((u32 *)(LZMA_UBOOT_LOAD_ADDR - sizeof(struct image_header)),
+		(u32 *)(LZMA_UBOOT_LOAD_ADDR),
+		sizeof(struct image_header));
+	/*
+	 * call bootrom seclib api to auth signed lzma u-boot image
+	 */
+	ret = bootrom_sec_api_auth(LZMA_UBOOT_LOAD_ADDR
+				+ sizeof(struct image_header),
+				&attribute_table);
+	if (ret)
+		goto error;
+
+	sb_attrib_err = get_sbif_attributes(&attribute_table,
+						NULL, NULL,
+						&img_rollback_id, &img_id);
+	if (SB_ATTRIB_INVALID == sb_attrib_err) {
+		/* invalid image attribute */
+		goto error;
+	} else {
+		rbe_debug_print("\n TODO: ATTRIB HANDLING <0x%08x>: <%s>:<%d>:<%s> \n",
+				sb_attrib_err, __FILE__, __LINE__, __func__);
+	} /* SB_ATTRIB_INVALID */
+
+#if defined(CONFIG_ROLLBACKID_SUPPORT)
+	otp_rollback_id = chk_rollback_id(SB_ROLLBACK_ID_UBOOT);
+
+	/* check image anti-rollback with otp anti-rollback value */
+	if (img_rollback_id < otp_rollback_id)
+		goto error;
+#endif /* CONFIG_ROLLBACKID_SUPPORT */
+#endif /* CONFIG_CHD_SECURE_BOOT */
+
+	/* read image header, uncompress image and jump
+	 * should not return
+	*/
+	uncompress_image(LZMA_UBOOT_LOAD_ADDR
+			- mkimage_size, CONFIG_COMPRESS);
+
+error:
+	return -EINVAL;
+}
+
+/*
+ * The main entry for NAND booting. It's necessary that SDRAM is already
+ * configured and available since this code loads the main U-Boot image
+ * from NAND into SDRAM and starts it from there.
+ */
+void nand_boot(void)
+{
+	volatile int ret;
+	int bootimage = 0;
+	int image_failure = 0;
+	struct nand_chip nand_chip;
+	struct mtd_info *mtd_data = nand_to_mtd(&nand_chip);
+
+	memset(&nand_chip, 0, sizeof(struct nand_chip));
+
+	/*
+	 * Init board specific nand support
+	 */
+	mtd_data->priv = &nand_chip;
+
+	board_nand_init(&nand_chip);
+
+	if (nand_chip.select_chip)
+		nand_chip.select_chip(mtd_data, 0);
+
+	mtd_info_init(mtd_data, &nand_chip);
+
+	/* Init environment
+	 * In NAND boot, we will only use the compiled env
+	 */
+	env_init();
+
+	if (readl(EPU_AON_DDR_HASH_6) & 0xf) {
+		bootimage = 1;
+		SET_IMAGE_FAILURE(image_failure, RBE_FAILURE);
+	}
+
+	/* update boot failure status */
+	writel(image_failure, BOOT_FAILURE_ADDR);
+
+#ifdef CONFIG_TEP_PKG
+	ret = load_tep_firmware(mtd_data, bootimage);
+	if (ret != 0 && bootimage == 0) {
+		SET_IMAGE_FAILURE(image_failure, POST_RBE_FAILURE);
+		writel(image_failure, BOOT_FAILURE_ADDR);
+		bootimage = 1;
+		ret = load_tep_firmware(mtd_data, bootimage);
+		if (ret)
+			goto error;
+	}
+#endif /* CONFIG_TEP_PKG */
+
+	ret = do_boot_uboot(mtd_data, bootimage);
+	if (ret != 0 && (image_failure & 1) == 1)
+		goto error;
+
+	/* intended boot image failed, signal failure and retry */
+	SET_IMAGE_FAILURE(image_failure, POST_RBE_FAILURE);
+	writel(image_failure, BOOT_FAILURE_ADDR);
+	bootimage = 1;
+	/* do_boot_uboot will not return if image is OK */
+	do_boot_uboot(mtd_data, bootimage);
+
+	/* TODO: Erase? */
+error:
+	hang();
+}
