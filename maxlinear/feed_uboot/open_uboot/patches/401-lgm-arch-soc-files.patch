diff --git a/arch/x86/cpu/lightning_mountain/resetvec_ap.S b/arch/x86/cpu/lightning_mountain/resetvec_ap.S
new file mode 100644
--- /dev/null
+++ b/arch/x86/cpu/lightning_mountain/resetvec_ap.S
@@ -0,0 +1,69 @@
+/*
+ *  U-Boot - x86 AP Startup Code
+ *
+ * SPDX-License-Identifier:	GPL-2.0+
+ */
+
+/* AP Reset vector, jumps to _x86boot_start */
+
+#include <config.h>
+
+#define SPL_ENTRY_ADDR	(SPL_RELOCATE_MEM_TOP - SPL_RELOCATE_MEM_SIZE)
+
+.extern _x86boot_start
+.extern _start
+.section .resetvec_ap, "ax"
+.code16
+__resetvec_ap_start:
+	cli							# disable interrupts
+	cld							# clear direction flag
+	movw  $0, %ax
+
+	# set up gdt
+	.byte  0x2e					# CS override prefix
+	.byte  0x66					# operand size prefix 
+	.byte  0x0f, 0x01, 0x16		# LGDT
+	.word  0x00d0				# GDT = 0xd0
+
+	# Finally switch to protected mode
+	movw  $1, %ax				# protected mode (PE) bit
+	lmsw  %ax					# This is it!
+	jmp   prot_world
+
+prot_world:
+	movw  $0x10, %ax			# 0x10 selecting gdt_ds
+	movw  %ax, %ds
+	movw  %ax, %ss
+
+	# Jump to the next module with 32 bit code.
+	.byte 0x66, 0xEA			# ljmpw inst 
+	.long SPL_ENTRY_ADDR			# entry point of ap from spl
+	.word 0x08				# 0x08 selecting gdt_cs	
+
+gdt_start:
+gdt_null:
+	.long 0x00000000
+	.long 0x00000000
+gdt_code:						#GDT[0x8]
+	.word 0xffff				#4Gb - (0x100000*0x1000 = 4Gb)
+	.word 0x0000				#base[15:0] = 0
+	.byte 0x00					#base[23:16] = 0
+	.byte 0b10011011			#code read/exec, accessed
+	.byte 0b11001111			#granularity = 4096, 386
+	.byte 0x00					#base[31:24] = 0
+gdt_data:						#GDT[0x10]	
+	.word 0xffff
+	.word 0x0
+	.byte 0x0
+	.byte 0b10010011			#data read/write
+	.byte 0b11001111
+	.byte 0x0
+gdt_end:
+
+	.org 0xd0 
+gdt_ptr:
+	.word gdt_end - gdt_start
+	.long gdt_start
+	.long 0x0 
+
+_end:
diff --git a/arch/x86/cpu/lightning_mountain/sdram.c b/arch/x86/cpu/lightning_mountain/sdram.c
new file mode 100644
--- /dev/null
+++ b/arch/x86/cpu/lightning_mountain/sdram.c
@@ -0,0 +1,91 @@
+#include <common.h>
+#include <asm/arch/api.h>
+#include <asm/e820.h>
+#include <asm/global_data.h>
+
+#define E820_ENTRIES	8
+
+DECLARE_GLOBAL_DATA_PTR;
+
+void announce_boot_pre_silicon(void)
+{
+#if CONFIG_DEBUG_UART
+	asc_serial_puts("\n <Intel CHD Pre-silicon Development> \n");
+#endif
+}
+
+int dram_init_banksize(void)
+{
+	if (!CONFIG_NR_DRAM_BANKS)
+		return 0;
+
+	/* simply use a single bank to have whole size for now */
+	gd->bd->bi_dram[0].start = 0;
+	gd->bd->bi_dram[0].size = gd->ram_size;
+
+	return 0;
+}
+
+int dram_init(void)
+{
+	rbe_debug_print("\n <dram_init> \n");
+	gd->ram_size = CONFIG_SYS_SDRAM_SIZE;
+
+	return 0;
+}
+
+int announce_main_loop(void)
+{
+	rbe_debug_print("\n <jump and enter mainloop> \n");
+	return 0;
+}
+
+unsigned int install_e820_map(unsigned int max_entries,
+				struct e820_entry *entries)
+{
+	/* UBOOT_SW-333-lightning-kernel-boot */
+	printf("\n WA: CONFIG_VENDOR_MAXLINEAR <boot_params_default>\n");
+	//setup_base->e820_entries = 7;
+
+	/* BIOS 1MB, can be classified further */
+	entries[0].addr = 0;
+	entries[0].size = 0xc0000;
+	entries[0].type = E820_RAM;
+
+	/* 256KB shadow RAM for ROM and boot parameters */
+	entries[1].addr = 0xc0000;
+	entries[1].size = 0x40000;
+	entries[1].type = E820_RESERVED;
+
+	/* DDR 3GB */
+	entries[2].addr = 0x00100000;
+	entries[2].size = 0xbfe00000;
+	entries[2].type = E820_RAM;
+
+	/* MMIO region */
+	entries[3].addr = 0xbff00000;
+	entries[3].size = 0x04100000;
+	entries[3].type = E820_RESERVED;
+
+	/* MMIO region */
+	entries[4].addr = 0xD0000000;
+	entries[4].size = 0x04000000;
+	entries[4].type = E820_RESERVED;
+
+	/* MMIO region */
+	entries[5].addr = 0xE0000000;
+	entries[5].size = 0x20000000;
+	entries[5].type = E820_RESERVED;
+
+	/* DDR 3-4GB */
+	entries[6].addr = 0x400000000;
+	entries[6].size = 0x040000000;
+	entries[6].type = E820_RAM;
+
+	/* DDR 4GB */
+	entries[7].addr = 0x100000000;
+	entries[7].size = 0x300000000;
+	entries[7].type = E820_RAM;
+
+	return E820_ENTRIES;
+}
diff --git a/arch/x86/cpu/lightning_mountain/u-boot.lds b/arch/x86/cpu/lightning_mountain/u-boot.lds
new file mode 100644
--- /dev/null
+++ b/arch/x86/cpu/lightning_mountain/u-boot.lds
@@ -0,0 +1,108 @@
+/*
+ * Copyright (C) 2016 Intel Technology Asia Pte Ltd
+ *
+ * SPDX-License-Identifier:	GPL-2.0+
+ */
+
+OUTPUT_FORMAT("elf32-i386", "elf32-i386", "elf32-i386")
+OUTPUT_ARCH(i386)
+ENTRY(_x86boot_start)
+
+SECTIONS
+{
+#ifndef CONFIG_CMDLINE
+	/DISCARD/ : { *(.u_boot_list_2_cmd_*) }
+#endif
+
+	. = CONFIG_SYS_TEXT_BASE;	/* Location of bootcode in flash */
+	__text_start = .;
+
+	.text.start : { *(.text.start); }
+
+	.__efi_runtime_start : {
+		*(.__efi_runtime_start)
+	}
+
+	.efi_runtime : {
+		*(.text.efi_runtime*)
+		*(.rodata.efi_runtime*)
+		*(.data.efi_runtime*)
+	}
+
+	.__efi_runtime_stop : {
+		*(.__efi_runtime_stop)
+	}
+
+	.text  : { *(.text*); }
+
+	. = ALIGN(4);
+
+	. = ALIGN(4);
+	.u_boot_list : {
+		KEEP(*(SORT(.u_boot_list*)));
+	}
+
+	. = ALIGN(4);
+	.rodata : {
+		*(SORT_BY_ALIGNMENT(SORT_BY_NAME(.rodata*)))
+		KEEP(*(.rodata.efi.init));
+	}
+
+	. = ALIGN(4);
+	.data : { *(.data*) }
+
+	. = ALIGN(4);
+	.hash : { *(.hash*) }
+
+	. = ALIGN(4);
+	.got : { *(.got*) }
+
+	. = ALIGN(4);
+
+	.efi_runtime_rel_start :
+	{
+		*(.__efi_runtime_rel_start)
+	}
+
+	.efi_runtime_rel : {
+		*(.rel*.efi_runtime)
+		*(.rel*.efi_runtime.*)
+	}
+
+	.efi_runtime_rel_stop :
+	{
+		*(.__efi_runtime_rel_stop)
+	}
+
+	. = ALIGN(4);
+
+	__data_end = .;
+	__init_end = .;
+
+	. = ALIGN(4);
+	.dynsym : { *(.dynsym*) }
+
+	. = ALIGN(4);
+	__rel_dyn_start = .;
+	.rel.dyn : {
+		*(.rel*)
+	}
+	__rel_dyn_end = .;
+	. = ALIGN(4);
+	_end = .;
+
+	.bss __rel_dyn_start (OVERLAY) : {
+		__bss_start = .;
+		*(.bss*)
+		*(COM*)
+		. = ALIGN(4);
+		__bss_end = .;
+	}
+
+	/DISCARD/ : { *(.dynstr*) }
+	/DISCARD/ : { *(.dynamic*) }
+	/DISCARD/ : { *(.plt*) }
+	/DISCARD/ : { *(.interp*) }
+	/DISCARD/ : { *(.gnu*) }
+	/DISCARD/ : { *(.note.gnu.property) }
+}
