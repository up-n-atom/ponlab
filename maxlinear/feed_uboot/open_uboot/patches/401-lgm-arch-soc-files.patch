+	char partition_name[8];
+	struct blk_desc *mmc_dev;
+	struct disk_partition part;
+
+	/* depending on bootrom's boot, primary or backup */
+	if (bootimage == 0)
+		snprintf(partition_name, 8, "uboot_a");
+	else
+		snprintf(partition_name, 8, "uboot_b");
+
+	/* select user part */
+	err = blk_dselect_hwpart(mmc_get_blk_desc(mmc), 0);
+	if (err) {
+		printf("SPL: mmc partition switch failed\n");
+		return err;
+	}
+
+	mmc_dev = mmc_get_blk_desc(mmc);
+	if (!mmc_dev) {
+		printf("cannot find blk device\n");
+		return -1;
+	}
+
+	/* get the image partiton info by name */
+	err = part_get_info_by_name_type(mmc_dev, partition_name,
+				&part, PART_TYPE_EFI);
+	if (err < 0) {
+		printf("Cannot find partition name %s\n", partition_name);
+		return err;
+	}
+
+	/* load U-boot from partition */
+	sector_offset = part.start;
+	err = mmc_load_image_raw_sector(mmc,
+					sector_offset,
+					addr);
+#else
+	/* switch to boot0 (1) or boot1 (2) partition */
+	err = blk_dselect_hwpart(mmc_get_blk_desc(mmc), bootimage + 1);
+	if (err) {
+		printf("SPL: mmc partition switch failed\n");
+		return err;
+	}
+
+	/* Sector offset needs to be calculated independently.
+	 * U-boot sits at CONFIG_SPL_PAD_SIZE offset
+	*/
+	rbe_debug_print("\n SPL: <SYS_EMMC_U_BOOT_OFFS:0x%x>\n", SYS_EMMC_U_BOOT_OFFS);
+	sector_offset = sector_offset/512;
+	err = mmc_load_image_raw_sector(mmc,
+					sector_offset,
+					addr);
+#endif /* CONFIG_UBOOT_IN_USER_PART */
+
+	return err;
+}
+
+#if defined(CONFIG_DDR_TUNING_SEPARATE)
+/* At this point, the environment variables are
+ * not ready yet due to mem constraints.
+ * In essence, it is not aware of which partition
+ * it should load from. To make it simple,
+ * the loader will try both boot partitions to read
+ * a suitable ddr binary for the tuning process.
+*/
+int load_ddr_init_binary(void)
+{
+	int err, retry_cnt = 0;
+	int (*ddr_init)(char *const argv);
+	char *argv;
+	image_header_t *hdr;
+	u32 load_address = DDR_TUNING_START_ADDRESS;
+	u32 img_size, img_checksum, mmc_load_address;
+	ulong count, size = DDR_TUNING_BIN_SIZE;
+	struct mmc *mmc = NULL;
+
+	/* no mmc node, dead on arrival */
+	err = spl_mmc_find_device(&mmc);
+	if (err)
+		return err;
+
+retry:
+	err = blk_dselect_hwpart(mmc_get_blk_desc(mmc), retry_cnt + 1);
+	if (err) {
+		printf("SPL: mmc partition switch failed\n");
+		return err;
+	}
+
+	mmc_load_address = load_address - sizeof(image_header_t);
+
+	count = blk_dread(mmc_get_blk_desc(mmc),
+			  CONFIG_DDR_TUNING_BIN_FLASH_OFFSET, size,
+			  (void *)mmc_load_address);
+	if (count != size) {
+		printf("SPL: read %lu smaller than part size %lu\n",
+			count, size);
+		return -2;
+	}
+
+	/* flash can be access and read, we start our processing
+	 * and retry mechanisms from here onwards.
+	*/
+	hdr = (image_header_t *)mmc_load_address;
+	if (ntohl(hdr->ih_magic) != IH_MAGIC) {
+		if (retry_cnt++ > 1)
+			return -EINVAL;
+		else
+			goto retry;
+	}
+
+	img_checksum = ntohl(hdr->ih_dcrc);
+	img_size = ntohl(hdr->ih_size);
+	if (crc32(0, (unsigned char *)load_address,
+			img_size) != img_checksum) {
+		printf("DDR bin checksum err from boot part %d\n", retry_cnt);
+		if (retry_cnt++ > 1)
+			return -EINVAL;
+		else
+			goto retry;
+	}
+
+#ifdef CONFIG_CHD_SECURE_BOOT
+	/* TODO: No criteria for DDR binary attributes check.
+	 * DDR binary will not be updated in the field,
+	 * therefore we will not check the rollbackid, imageid, etc.
+	*/
+	struct SBIF_Attributes attribute_table;
+
+	err = bootrom_sec_api_auth(load_address, &attribute_table);
+	if (err) {
+		printf("Authentication error for the DDR binary\n");
+		if (retry_cnt++ > 1)
+			return err;
+		else
+			goto retry;
+	}
+#endif /* CONFIG_CHD_SECURE_BOOT */
+
+	/* Since x86 does not keep global data info in any internal
+	 * cpu registers, this has to be done explicitly
+	*/
+	argv = (char *)gd;
+	ddr_init = (void *)(load_address);
+	ddr_init(argv);
+
+	return 0;
+}
+#endif /* CONFIG_DDR_TUNING_SEPARATE */
+
+#if defined(CONFIG_MXL_OF_DTB_UBOOT_EXT)
+
+static int spl_mmc_load_uboot_dtb(int bootimage)
+{
+	int err;
+	struct mmc *mmc = NULL;
+	char partition_name[16];
+	struct blk_desc *mmc_dev;
+	struct disk_partition part;
+	ulong count;
+
+	err = spl_mmc_find_device(&mmc);
+	if (err)
+		return err;
+
+	/* depending on bootrom's boot, primary or backup */
+	if (bootimage == 0)
+		snprintf(partition_name, 16, "uboot_dtb_a");
+	else
+		snprintf(partition_name, 16, "uboot_dtb_b");
+
+	/* select user part */
+	err = blk_dselect_hwpart(mmc_get_blk_desc(mmc), 0);
+	if (err) {
+		printf("SPL: mmc partition switch failed\n");
+		return err;
+	}
+
+	mmc_dev = mmc_get_blk_desc(mmc);
+	if (!mmc_dev) {
+		printf("cannot find blk device\n");
+		return -1;
+	}
+
+	/* get the image partiton info by name */
+	err = part_get_info_by_name_type(mmc_dev, partition_name,
+				&part, PART_TYPE_EFI);
+	if (err < 0) {
+		printf("Cannot find partition name %s\n", partition_name);
+		return err;
+	}
+
+	/* load U-boot dtb from partition */
+	count = blk_dread(mmc_get_blk_desc(mmc), part.start,
+			  part.size,
+			  (void *)CONFIG_MXL_OF_DTB_UBOOT_ADDR);
+	if (count != part.size) {
+		printf("SPL: read %d smaller than part size %d\n", count, part.size);
+		return -2;
+	}
+
+	return 0;
+}
+
+#endif /* defined(CONFIG_MXL_OF_DTB_UBOOT_EXT) */
+
+static int do_boot_uboot(int bootimage)
+{
+	u32 addr = 0;
+	int ret;
+
+	/* load image from emmc */
+	rbe_debug_print("\n SPL: <Loading image from emmc> \n");
+	ret = intel_spl_mmc_load_image(&addr, bootimage);
+	if (ret || !addr)
+		return 1;
+
+#if defined(CONFIG_MXL_OF_DTB_UBOOT_EXT) && \
+    defined(CONFIG_UBOOT_IN_USER_PART)
+	ret = spl_mmc_load_uboot_dtb(bootimage);
+	if (ret)
+		return 2;
+#endif /* defined(CONFIG_MXL_OF_DTB_UBOOT_EXT) && CONFIG_IS_ENABLED(UBOOT_IN_USER_PART) */
+
+#if defined(CONFIG_CHD_SECURE_BOOT)
+	u32 img_rollback_id = 0;
+	u32 otp_rollback_id  = 0;
+	u32 sb_attrib_err = SB_ATTRIB_VALID;
+	struct SBIF_Attributes attribute_table;
+
+	/*
+	 * call bootrom seclib api to auth signed lzma u-boot image
+	 * image offset without header (0x8000000 + 0x40 = 0x8000040)
+	 * seclib will perform xip decrpytion
+	 */
+	ret = bootrom_sec_api_auth(addr + sizeof(struct image_header),
+								&attribute_table);
+	if (ret)
+		return 1;
+
+	sb_attrib_err = get_sbif_attributes(&attribute_table, NULL, NULL,
+											&img_rollback_id, NULL);
+	if (SB_ATTRIB_INVALID == sb_attrib_err) {
+		/* invalid image attribute */
+		return SB_ATTRIB_INVALID;
+	} else {
+		/* todo: image attribute handling, now pass through */
+		rbe_debug_print("\n TODO: ATTRIB HANDLING <0x%08x>: <%s>:<%d>:<%s> \n",
+							sb_attrib_err, __FILE__, __LINE__, __func__);
+	} /* SB_ATTRIB_INVALID */
+
+#if defined(CONFIG_ROLLBACKID_SUPPORT)
+	otp_rollback_id = chk_rollback_id(SB_ROLLBACK_ID_UBOOT);
+
+	/* check image anti-rollback with otp anti-rollback value */
+	if (img_rollback_id < otp_rollback_id)
+		return 1;
+#endif /* CONFIG_ROLLBACKID_SUPPORT */
+
+	/* read image header (backup @ 0x7FFFFC0), uncompress image and jump */
+	uncompress_image(addr - sizeof(struct image_header), CONFIG_COMPRESS);
+#else
+	/* uncompress image and jump */
+	uncompress_image(addr, CONFIG_COMPRESS);
+#endif
+
+	/* return failure because we should not be here */
+	return 1;
+}
+
+static void erase_boot_partition(int boot_partition)
+{
+	int err;
+	int timeout = 1000;
+	struct mmc *mmc = NULL;
+	u32 start_rem, blkcnt_rem;
+	lbaint_t start = 0, blkcnt;
+	lbaint_t blk = 0, blk_r = 0;
+
+	err = spl_mmc_find_device(&mmc);
+	if (err)
+		printf("\n SPL: FAILED:<spl_mmc_find_device> \n");
+
+	err = blk_dselect_hwpart(mmc_get_blk_desc(mmc), boot_partition+1);
+	if (err)
+		printf("\n SPL: FAILED:<blk_dselect_hwpart> \n");
+
+	if (mmc == NULL){
+		return;
+	}
+	blkcnt = mmc->capacity_boot / mmc->read_bl_len;
+
+	if (mmc_getwp(mmc) == 1) {
+		printf("\n SPL: emmc is write protected!\n");
+	}
+
+	/*
+	 * We want to see if the requested start or total block count are
+	 * unaligned.  We discard the whole numbers and only care about the
+	 * remainder.
+	 */
+	err = div_u64_rem(start, mmc->erase_grp_size, &start_rem);
+	err = div_u64_rem(blkcnt, mmc->erase_grp_size, &blkcnt_rem);
+	if (start_rem || blkcnt_rem)
+		rbe_debug_print("\n\nCaution! Your devices Erase group is 0x%x\n"
+		       "The erase range would be change to "
+		       "0x" LBAF "~0x" LBAF "\n\n",
+		       mmc->erase_grp_size, start & ~(mmc->erase_grp_size - 1),
+		       ((start + blkcnt + mmc->erase_grp_size)
+		       & ~(mmc->erase_grp_size - 1)) - 1);
+
+	while (blk < blkcnt) {
+		blk_r = ((blkcnt - blk) > mmc->erase_grp_size) ?
+			mmc->erase_grp_size : (blkcnt - blk);
+		err = mmc_erase(mmc, start + blk, blk_r);
+		if (err)
+			break;
+
+		blk += blk_r;
+
+		/* Waiting for the ready status */
+		if (mmc_send_status(mmc, timeout)) {
+			printf("\n SPL: emmc timeout!\n");
+		}
+	}
+}
+
+/* entry function after SPL relocation */
+int board_init_f_cont(gd_t *new_gd)
+{
+	int ret;
+	int bootimage = 0;
+	unsigned long boot_partition;
+	unsigned long image_failure = 0;
+	u32 apic_id = lapicid();
+
+	if (!apic_id) {
+		/* save gd ptr for APIC */
+		tmp_ptr = new_gd;
+		initr_malloc(CONFIG_SYS_SPL_MALLOC_START + apic_id * 0x10000,
+				CONFIG_SYS_SPL_MALLOC_SIZE);
+
+		/* update reloc gd dm root */
+		gd->dm_root_f = gd->dm_root;
+		gd->dm_root = NULL;
+
+		/*
+		 * move fdtsetup to before reloc in case OF_SEPARATE
+		 */
+		#ifdef CONFIG_OF_SEPARATE
+		#ifdef CONFIG_SPL_DM
+		ret = dm_init_and_scan(false);
+		if (ret)
+			goto reset;
+		#endif /* CONFIG_SPL_DM */
+		#else /* CONFIG_OF_SEPARATE */
+
+		ret = fdt_dm_setup(false);
+		if (ret)
+			goto reset;
+		#endif /* CONFIG_OF_SEPARATE */
+	}
+
+	/* board specific initializatio, AP will not ret */
+	lightning_board_init();
+
+	/* recovery mode check and execute */
+	ret = board_recovery_mode();
+	if (ret)
+		goto reset;
+
+#if defined(CONFIG_MANUBOOT)
+	/*
+	 * if socmode == 1 (RoT), the decryted in-place rot image @ CONFIG_SPL_TEXT_BASE
+	 * hence uncompression lzma will be located @ offset CONFIG_SPL_PAD_SIZE for u-boot
+	 */
+	if (0x1 == readl(BOOT_SOCMODE)) {
+		rbe_debug_print("\n SPL: <socmode:0x%x>\n", readl(BOOT_SOCMODE));
+		uncompress_image((CONFIG_SPL_TEXT_BASE + SYS_EMMC_U_BOOT_OFFS), CONFIG_COMPRESS);
+		return 1;
+	}
+#endif
+
+	ret = init_mmc_device();
+	if (ret)
+		goto reset;
+
+	/* init environment */
+	env_init();
+	/* load env from flash */
+	env_relocate();
+
+	/* Which partition the other early boot images should boot from */
+	boot_partition = env_get_ulong("boot_p", 16, 0);
+
+	/* check which boot partition we had
+	 * boot with from bootrom and signal failure if RBE is boot
+	 * from partition 1. RBE always boots from partition 0
+	*/
+	if ((readl(EPU_AON_DDR_HASH_6) & 0xf) >= CONFIG_MAX_RBE_PER_PART) {
+		bootimage = 1;
+		SET_IMAGE_FAILURE(image_failure, RBE_FAILURE);
+	}
+
+	if (boot_partition == 1)
+		bootimage = 1;
+
+	/* update boot failure status */
+	writel(image_failure, BOOT_FAILURE_ADDR);
+
+	debug("bootpartition: %ld, bootimage: %d\n", boot_partition, bootimage);
+#ifdef CONFIG_TEP_PKG
+	ret = load_tep_firmware(bootimage);
+	if (ret) {
+		/* intended boot image failed, signal failure and retry */
+		SET_IMAGE_FAILURE(image_failure, POST_RBE_FAILURE);
+		writel(image_failure, BOOT_FAILURE_ADDR);
+		/* try again, swap image to next partition */
+		bootimage ^= 1;
+		ret = load_tep_firmware(bootimage);
+		if (ret)
+			goto reset;
+	}
+#endif
+	/* do_boot_uboot will not return if image is OK.
+	 * If previous try to boot TEP failed on the
+	 * intended boot partition, we exit
+	 * boot sequence to prevent mismatch of images.
+	*/
+	ret = do_boot_uboot(bootimage);
+	if (ret && (image_failure & 1) == 1)
+		goto reset;
+
+	/* intended boot image failed, signal failure and retry */
+	SET_IMAGE_FAILURE(image_failure, POST_RBE_FAILURE);
+	writel(image_failure, BOOT_FAILURE_ADDR);
+	bootimage ^= 1;
+	/* do_boot_uboot will not return if image is OK */
+	ret = do_boot_uboot(bootimage);
+
+	/* should not fall here */
+	printf("SPL: jump fail!\n");
+
+reset:
+	/* erase boot partition 0 or 1*/
+	erase_boot_partition(0);
+	erase_boot_partition(1);
+
+	/* reset core 0 */
+	reset_cpu();
+
+	/* Will not process till here */
+	return 1;
+}
+
+void board_init_f(ulong bootflag)
+{
+	int ret;
+	int bootimage = 0;
+
+	if ((readl(EPU_AON_DDR_HASH_6) & 0xf) >= CONFIG_MAX_RBE_PER_PART)
+		bootimage = 1;
+
+#if defined(CONFIG_CHD_SECURE_BOOT) && defined(CONFIG_ROLLBACKID_SUPPORT)
+	/* RBE self anti-rollback id check with otp anti-rollback value */
+	if (CONFIG_ROLLBACKID_VALUE < chk_rollback_id(SB_ROLLBACK_ID_RBE))
+		goto reset;
+#endif
+
+	/* only BSP will execute this */
+	if (cpu_is_bsp()) {
+		/* Init simple malloc ptr */
+		gd->malloc_limit = gd->malloc_base +
+					CONFIG_VAL(SYS_MALLOC_F_LEN);
+		gd->malloc_ptr = 0;
+
+		#ifdef CONFIG_OF_SEPARATE
+		/* setup fdt first, so that the info gets relocated */
+		ret = fdtdec_setup();
+		if (ret)
+			goto reset;
+		#endif /* CONFIG_OF_SEPARATE */
+
+		spl_early_flash_config();
+
+		#ifdef CONFIG_DDR_TUNING_SEPARATE
+		ret = fdt_dm_setup(true);
+		if (ret)
+			goto reset;
+
+		/* init mmc before reading ddr binary */
+		ret = init_mmc_device();
+		if (ret)
+			goto reset;
+
+		#endif /* CONFIG_DDR_TUNING_SEPARATE */
+
+		/* pre-fdt early board init */
+		ret = spl_early_board_init();
+		if (ret)
+			goto reset;
+
+		/* BSP will not return here */
+		ret = relocate_to_ddr();
+		if (ret) {
+			printf("unable to relocate to ddr\n");
+			goto reset;
+		}
+	} else {
+		ia_vmm(); /* all APs need to switch to IA_VMM mode */
+	}
+
+	/* APIC will execute this and not return */
+	board_init_f_cont(gd);
+
+reset:
+	/* erase boot partition 0 or 1*/
+	if (bootimage == 0) {
+		erase_boot_partition(0);
+	} else {
+		erase_boot_partition(0);
+		erase_boot_partition(1);
+	}
+
+	/* reset core 0 */
+	reset_cpu();
+}
+
diff --git a/arch/x86/lib/spl_lgm_nand.c b/arch/x86/lib/spl_lgm_nand.c
new file mode 100644
--- /dev/null
+++ b/arch/x86/lib/spl_lgm_nand.c
@@ -0,0 +1,123 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Copyright (C) 2016, 2017 Intel Technology Asia Pte Ltd
+ * Copyright (C) 2022 Maxlinear Corporation
+ *
+ */
+
+#include <common.h>
+#include <malloc.h>
+#include <version.h>
+#include <errno.h>
+#include <hang.h>
+#include <nand.h>
+#include <asm/io.h>
+#include <asm/lapic.h>
+#include <asm/arch/project.h>
+#include <asm/secureboot.h>
+
+DECLARE_GLOBAL_DATA_PTR;
+
+extern int lightning_board_init(void);
+extern int spl_early_board_init(void);
+extern int fdt_dm_setup(void);
+extern int board_recovery_mode(void);
+extern int cpu_is_bsp(void);
+extern int initr_malloc(u32 malloc_base, u32 malloc_size);
+extern void ia_vmm(void);
+
+#define CONFIG_COMPRESS 1
+#define C55_VOICE_SS_C55_ENABLE 0xED2D0000
+#define C55_VOICE_SS_RAM	0xED900000
+
+struct global_data *tmp_ptr;
+
+int board_init_f_cont(gd_t *new_gd)
+{
+
+	int ret;
+	u32 apic_id = lapicid();
+
+	if (!apic_id) {
+		/* save gd ptr for APIC */
+		tmp_ptr = new_gd;
+
+		initr_malloc(CONFIG_SYS_SPL_MALLOC_START + apic_id * 0x10000,
+				CONFIG_SYS_SPL_MALLOC_SIZE);
+
+		/* setup first, so that the info gets relocated */
+		ret = fdt_dm_setup();
+		if (ret)
+			goto err;
+	}
+
+	/* board specific configuration, AP will not ret */
+	lightning_board_init();
+
+	/* recovery mode check and execute */
+	ret = board_recovery_mode();
+	if (ret)
+		goto err;
+
+	rbe_debug_print("\n SPL: <%s>:<%d>:<%s> \n", __FILE__, __LINE__, __func__);
+	rbe_debug_print("\n SPL: <socmode:0x%x>\n", readl(BOOT_SOCMODE));
+
+	/* main entry for NAND booting*/
+	nand_boot();
+
+err:
+	hang();
+
+	/* will not reach here */
+	return 1;
+}
+
+void board_init_f(ulong bootflag)
+{
+	int ret;
+
+#if defined(CONFIG_LIGHTNING_A0)
+	int i;
+	if (REG32(C55_VOICE_SS_C55_ENABLE) != 0) {
+		/* Clear C55 memories before switching it off
+		 * w/o this, you may see issues with SW reset
+		 * on Ax chips
+		 */
+		for (i = 0; i < 0x4000; i += 4)
+			REG32(C55_VOICE_SS_RAM + i) = 0x0;
+
+		/* UBOOT_SW-924 - WA - C55 DISABLE */
+		REG32(C55_VOICE_SS_C55_ENABLE) = 0x0;
+	}
+#endif /* CONFIG_LIGHTNING_A0 */
+
+#if defined(CONFIG_CHD_SECURE_BOOT) && defined(CONFIG_ROLLBACKID_SUPPORT)
+	/* RBE self anti-rollback id check with otp anti-rollback value */
+	if (CONFIG_ROLLBACKID_VALUE < chk_rollback_id(SB_ROLLBACK_ID_RBE))
+		goto err;
+#endif
+
+	/* Only BSP will execute this code */
+	if (cpu_is_bsp()) {
+		spl_early_flash_config();
+
+		/* pre-fdt early board init */
+		ret = spl_early_board_init();
+		if (ret)
+			goto err;
+
+		/* BSP will not return here */
+		ret = relocate_to_ddr();
+		if (ret) {
+			printf("unable to relocate to ddr\n");
+			goto err;
+		}
+	} else {
+		ia_vmm(); /* all APs need to switch to IA_VMM mode */
+	}
+
+	board_init_f_cont(gd);
+err:
+	hang();
+}
+
