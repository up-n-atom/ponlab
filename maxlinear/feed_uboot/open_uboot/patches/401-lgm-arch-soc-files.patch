+static int mmc_load_image_raw_sector(struct mmc *mmc, unsigned long sector,
+				     u32 *addr)
+{
+	unsigned long count;
+	struct image_header *header;
+	int ret = 0;
+	u32 image_size_sectors;
+	u32 header_size = sizeof(struct image_header);
+	u32 size;
+	u32 comp;
+	u32 load_addr;
+
+	/* read image header to find the image size & load address */
+	/* load header to the base offset as a backup (0x8000000 - 0x40 = 0x7FFFFC0) */
+	header = (struct image_header *) (LZMA_UBOOT_LOAD_ADDR - sizeof(struct image_header));
+	count = blk_dread(mmc_get_blk_desc(mmc), sector, 1, header);
+	debug("SPL: hdr read sector %lx, count=%lu\n", sector, count);
+	if (count == 0) {
+		rbe_debug_print("SPL: image read from emmc is 0\n");
+		ret = -EIO;
+		goto end;
+	}
+
+	/* parse image header */
+	if (image_get_magic(header) == IH_MAGIC) {
+		comp = image_get_comp(header);
+		if (comp == IH_COMP_NONE) {
+			load_addr = image_get_load(header) - header_size;
+		} else if (comp == IH_COMP_LZMA) {
+			load_addr = LZMA_UBOOT_LOAD_ADDR;
+		} else {
+			printf("SPL: unsupported compression type %d\n", comp);
+			return -EINVAL;
+		}
+
+		size = image_get_data_size(header) + header_size;
+		debug("SPL: payload image: load addr: 0x%x size: %d comp: %d\n",
+		      load_addr, size, comp);
+	} else {
+		printf("SPL: ** no signature found!");
+		return -EIO;
+	}
+
+	/* convert size to sectors - round up */
+	image_size_sectors = (size + mmc->read_bl_len - 1) / mmc->read_bl_len;
+
+	debug("SPL: reading %x sectors to %x\n", image_size_sectors, load_addr);
+
+	/* Read the header too to avoid extra memcpy */
+	count = blk_dread(mmc_get_blk_desc(mmc), sector, image_size_sectors,
+			  (void *)(ulong)load_addr);
+	debug("SPL: read %x sectors to %x\n", image_size_sectors, load_addr);
+	if (count != image_size_sectors) {
+		printf("SPL: fail to load mmc image, count %lu size %u\n",
+		       count, image_size_sectors);
+		return -EIO;
+	}
+
+	*addr = load_addr;
+end:
+	return ret;
+}
