 	uint32_t		b_flags;
@@ -77,6 +80,38 @@ static int find_next_bit(int i, uint32_t x)
 	return j ? j + i : 0;
 }
 
+static int get_vid_range(uint32_t *addr, uint16_t *vid_start, int16_t *vid_end)
+{
+	int16_t word = 0, range_end = -1, prev_bit = 0, last_found = 0;
+
+	/* find begin of the range in the bitmap */
+	while (!addr[word] && (word < RTNL_LINK_BRIDGE_VLAN_BITMAP_MAX / 32))
+		word++;
+
+	if (word == RTNL_LINK_BRIDGE_VLAN_BITMAP_MAX / 32)
+		return -1; /* no bit found */
+
+	if (addr[word])
+		*vid_start =  word * 32 + find_next_bit(-1, addr[word]) - 1;
+
+	/* find end of the range in the bitmap */
+	word = (RTNL_LINK_BRIDGE_VLAN_BITMAP_MAX / 32) -1;
+	while (!addr[word] && (word > 0))
+		word--;
+
+	if (addr[word])
+		while ((prev_bit = find_next_bit(prev_bit, addr[word]))) {
+			if (prev_bit == -1)
+				break;
+			last_found = prev_bit;
+		}
+
+	range_end = word * 32 + last_found -1;
+	*vid_end = range_end != *vid_start ? range_end : -1;
+
+	return 0;
+}
