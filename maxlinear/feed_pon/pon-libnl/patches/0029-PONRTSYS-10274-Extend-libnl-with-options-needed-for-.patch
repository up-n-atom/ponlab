 };
 
+/**
+ * Set VLAN id range
+ * @arg link		Link object of type bridge
+ * @arg vid_start	Begin of the VLAN id range to set.
+ * @arg vid_end		End of the VLAN id renage to set,
+ * 			or -1 in case the vid_start is the only VLAN id to set.
+ *
+ * @return Zero on success, otherwise a negative error code.
+ * @retval -NLE_OPNOTSUPP Link is not a bridge
+ */
+int rtnl_link_bridge_set_vlan_range(struct rtnl_link *link, uint16_t vid_start,
+				    int16_t vid_end)
+{
+	struct bridge_data *bd = bridge_data(link);
+	int16_t vid;
+
+	IS_BRIDGE_LINK_ASSERT(link);
+
+	set_bit(vid_start, bd->vlan_info.vlan_bitmap);
+	bd->ce_mask |= BRIDGE_ATTR_VLAN_INFO;
+
+	for (vid = vid_start + 1; vid <= vid_end; vid++)
+		set_bit(vid, bd->vlan_info.vlan_bitmap);
+
+	return 0;
+}
+
 static void __init bridge_init(void)
 {
 	rtnl_link_af_register(&bridge_ops);
