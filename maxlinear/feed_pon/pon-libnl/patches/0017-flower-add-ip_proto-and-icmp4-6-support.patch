+
+	if (f->fl_mask & FLOWER_ATTR_KEY_ICMPV6_TYPE_MASK)
+		NLA_PUT_U8(msg, TCA_FLOWER_KEY_ICMPV6_TYPE_MASK,
+			   f->fl_icmpv6_type_mask);
 
 	if (f->fl_mask & FLOWER_ATTR_ACTION) {
 		int err;
@@ -736,6 +835,136 @@ int rtnl_flower_get_cvlan_eth_type(struct rtnl_cls *cls,
