#!/bin/sh

# This allows to enable and disable the PON MBOX logging
# Documentation: https://www.kernel.org/doc/html/v4.11/admin-guide/dynamic-debug-howto.html

case $1 in
"mbox")
	case $2 in
	"enable"|1)
		echo -n  'func pon_mbox_read_msg +pt; func pon_mbox_write_msg +pt; func pon_mbox_read_payload +pt' > /sys/kernel/debug/dynamic_debug/control
		;;
	"disable"|0)
		echo -n  'func pon_mbox_read_msg -pt; func pon_mbox_write_msg -pt; func pon_mbox_read_payload -pt' > /sys/kernel/debug/dynamic_debug/control
		;;
	*)
		echo "run" $0 " mbox [enable | disable]"
		;;
	esac
	;;
"reg")
	case $2 in
	"enable"|1)
		echo -n  'func pon_mbox_pdev_write +pt; func pon_mbox_pdev_read +pt' > /sys/kernel/debug/dynamic_debug/control
		;;
	"disable"|0)
		echo -n  'func pon_mbox_pdev_write -pt; func pon_mbox_pdev_read -pt' > /sys/kernel/debug/dynamic_debug/control
		;;
	*)
		echo "run" $0 " reg [enable | disable]"
		;;
	esac
	;;
"loop")
	case $2 in
	"enable"|1)
		echo -n  'func urx800_lt_state1 +pt; func urx800_lt_cdr_lock +pt' > /sys/kernel/debug/dynamic_debug/control
		echo -n  'func urx800_lt_state4 +pt; func urx800_lt_state5 +pt; func urx800_lt_state6 +pt' > /sys/kernel/debug/dynamic_debug/control
		echo -n  'func urx800_sw_loop_timing_los +pt; func urx800_sw_loop_timing +pt' > /sys/kernel/debug/dynamic_debug/control
		echo -n  'func pon_mbox_handle_alarm_report +pt; func pon_mbox_handle_alarm_clear +pt' > /sys/kernel/debug/dynamic_debug/control
		;;
	"disable"|0)
		echo -n  'func urx800_lt_state1 -pt; func urx800_lt_cdr_lock -pt' > /sys/kernel/debug/dynamic_debug/control
		echo -n  'func urx800_lt_state4 -pt; func urx800_lt_state5 -pt; func urx800_lt_state6 -pt' > /sys/kernel/debug/dynamic_debug/control
		echo -n  'func urx800_sw_loop_timing_los -pt; func urx800_sw_loop_timing -pt' > /sys/kernel/debug/dynamic_debug/control
		echo -n  'func pon_mbox_handle_alarm_report -pt; func pon_mbox_handle_alarm_clear -pt' > /sys/kernel/debug/dynamic_debug/control
		;;
	*)
		echo "run" $0 " loop [enable | disable]"
		;;
	esac
	;;
"serd")
	case $2 in
	"enable"|1)
		echo -n  'func pon_mbox_pon_app_write +pt; func pon_mbox_pon_apb_app_write +pt; func urx800_lt_cdr_lock +pt' > /sys/kernel/debug/dynamic_debug/control
		echo -n  'func pon_mbox_serdes_write +pt; func urx800_serdes_basic_init +pt; func urx800_pll5_init +pt' > /sys/kernel/debug/dynamic_debug/control
		echo -n  'func urx800_serdes_init +pt; func pon_mbox_handle_alarm_clear +pt' > /sys/kernel/debug/dynamic_debug/control
		echo -n  'func prx300_serdes_basic_init +pt; func prx300_pll5_init +pt; func prx300_serdes_init +pt' > /sys/kernel/debug/dynamic_debug/control
		;;
	"disable"|0)
		echo -n  'func pon_mbox_pon_app_write -pt; func pon_mbox_pon_apb_app_write -pt; func urx800_lt_cdr_lock -pt' > /sys/kernel/debug/dynamic_debug/control
		echo -n  'func pon_mbox_serdes_write -pt; func urx800_serdes_basic_init -pt; func urx800_pll5_init -pt' > /sys/kernel/debug/dynamic_debug/control
		echo -n  'func urx800_serdes_init -pt; func pon_mbox_handle_alarm_clear -pt' > /sys/kernel/debug/dynamic_debug/control
		echo -n  'func prx300_serdes_basic_init -pt; func prx300_pll5_init -pt; func prx300_serdes_init -pt' > /sys/kernel/debug/dynamic_debug/control
		;;
	*)
		echo "run" $0 " serd [enable | disable]"
		;;
	esac
	;;
"serdfw")
	case $2 in
	"enable"|1)
		echo -n  'func pon_mbox_serdes_fw_write +pt; func pon_mbox_serdes_fw_download +pt' > /sys/kernel/debug/dynamic_debug/control
		;;
	"disable"|0)
		echo -n  'func pon_mbox_serdes_fw_write -pt; func pon_mbox_serdes_fw_download -pt' > /sys/kernel/debug/dynamic_debug/control
		;;
	*)
		echo "run" $0 " serdfw [enable | disable]"
		;;
	esac
	;;
"cnt")
	case $2 in
	"enable"|1)
		echo -n  'func pon_mbox_cnt_autoupdate_update +pt; func gem_port_id_write_update +pt' > /sys/kernel/debug/dynamic_debug/control
		;;
	"disable"|0)
		echo -n  'func pon_mbox_cnt_autoupdate_update -pt; func gem_port_id_write_update -pt' > /sys/kernel/debug/dynamic_debug/control
		;;
	*)
		echo "run" $0 " cnt [enable | disable]"
		;;
	esac
	;;
"eth")
	case $2 in
	"enable"|1)
		echo -n  'module mod_pon_eth +pt' > /sys/kernel/debug/dynamic_debug/control
		;;
	"disable"|0)
		echo -n  'module mod_pon_eth -pt' > /sys/kernel/debug/dynamic_debug/control
		;;
	*)
		echo "run" $0 " eth [enable | disable]"
		;;
	esac
	;;
"mcc")
	case $2 in
	"enable"|1)
		echo -n  'module  mod_pon_mcc +pt' > /sys/kernel/debug/dynamic_debug/control
		;;
	"disable"|0)
		echo -n  'module mod_pon_mcc -pt' > /sys/kernel/debug/dynamic_debug/control
		;;
	*)
		echo "run" $0 " mcc [enable | disable]"
		;;
	esac
	;;
"enable"|1)
	echo -n  'func pon_mbox_read_msg +pt; func pon_mbox_write_msg +pt; func pon_mbox_read_payload +pt;' > /sys/kernel/debug/dynamic_debug/control
	echo "deprecated use "  $0 " mbox enable"
	;;
"disable"|0)
	echo -n  'func pon_mbox_read_msg -pt; func pon_mbox_write_msg -pt; func pon_mbox_read_payload -pt;' > /sys/kernel/debug/dynamic_debug/control
	echo "deprecated use "  $0 " mbox disable"
	;;
"enable-cnt")
	echo -n  'func pon_mbox_cnt_autoupdate_update +pt; func gem_port_id_write_update +pt' > /sys/kernel/debug/dynamic_debug/control
	echo "deprecated use "  $0 " cnt enable"
	;;
"disable-cnt")
	echo -n  'func pon_mbox_cnt_autoupdate_update -pt; func gem_port_id_write_update -pt' > /sys/kernel/debug/dynamic_debug/control
	echo "deprecated use "  $0 " cnt disable"
	;;
*)
	echo "run" $0 " [mbox | reg | loop | serd | serdfw | cnt | eth | mcc] [enable | disable]"
	;;
esac
