+static int do_show_rule(int argc, char **argv)
+{
+	struct map_parm *p;
+	struct map_rule_parm rp;
+	struct map_pool_parm pp;
+	struct map_parm *pptr;
+	struct map_rule_parm *rptr;
+	char s1[1024];
+	char s2[1024];
+	int i;
+
+	p = malloc(sizeof(struct map_parm));
+	if (!p)
+		return -1;
+	memset(p, 0, sizeof(struct map_parm));
+
+	if (parse_args(argc, argv, SIOCGETMAP, p, &rp, &pp) < 0)
+		goto out;
+	if (map_ioctl(p->name, SIOCGETMAPPOOLS, p)) {
+		goto out;
+	}
+	if (p->rule_num == 0) {
+		printf("No Rules are present\n");
+		goto out;
+	}
+	pptr = malloc(sizeof(struct map_parm) + (sizeof(struct map_rule_parm) * p->rule_num));
+	if (!pptr)
+		goto out;
+	if (parse_args(argc, argv, SIOCGETMAP, pptr, &rp, &pp) < 0)
+		goto out;
+	if (map_ioctl(pptr->name, SIOCGETMAPRULES, pptr))
+		goto out;
+	printf("\n");
+	printf(" Mode: 'E' = Encapsulation, 'T' = Translation. FMR: 'T' = FMR, '-' = Not FMR.\n");
+	printf("\n");
+	printf(" \tIPv6 prefix,\t IPv4 prefix,\t PSID prefix,\t EA-bits length,\t PSID offset,\t Mode,\t FMR.\n");
+	for (i = 0; i < pptr->rule_num; i++) {
+		rptr = &pptr->rule[i];
+		printf(" Rules %d: %10s/%-3d %10s/%-2d\t 0x%04x/%-2d\t %2d\t\t\t %2d\t\t %s\t %s\n",
+				i,
+				inet_ntop(AF_INET6, &rptr->ipv6_prefix, s1, sizeof(s1)),
+				rptr->ipv6_prefix_length,
+				format_host(AF_INET, 4, &rptr->ipv4_prefix),
+				rptr->ipv4_prefix_length,
+				rptr->psid_prefix,
+				rptr->psid_prefix_length,
+				rptr->ea_length,
+				rptr->psid_offset,
+				(rptr->forwarding_mode == MAP_FORWARDING_MODE_T ? "T" : "E"),
+				(rptr->forwarding_rule == MAP_FORWARDING_RULE_T ? "F" : "-"));
+	}
+	printf("\n");
+	free(pptr);
+	free(p);
+
+	return 0;
+out:
+	if (p)
+		free(p);
+	if (pptr)
+		free(pptr);
+	return -1;
+}
