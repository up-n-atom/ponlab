Subject: flower: add cfm support

Add support for matching on CFM level and opcode.

Signed-off-by: Zahari Doychev <zdoychev@maxlinear.com>
---
 include/uapi/linux/pkt_cls.h |  12 ++++
 lib/ll_proto.c               |   1 +
 man/man8/tc-flower.8         |  25 ++++++++-
 tc/f_flower.c                | 103 ++++++++++++++++++++++++++++++++++-
 4 files changed, 139 insertions(+), 2 deletions(-)

diff --git a/include/uapi/linux/pkt_cls.h b/include/uapi/linux/pkt_cls.h
index 28938439..9ba4fd18 100644
--- a/include/uapi/linux/pkt_cls.h
+++ b/include/uapi/linux/pkt_cls.h
@@ -585,6 +585,8 @@ enum {
 	TCA_FLOWER_KEY_HASH,		/* u32 */
 	TCA_FLOWER_KEY_HASH_MASK,	/* u32 */
 
+	TCA_FLOWER_KEY_CFM,
+
 	__TCA_FLOWER_MAX,
 };
 
@@ -678,6 +680,16 @@ enum {
 	TCA_FLOWER_KEY_FLAGS_FRAG_IS_FIRST = (1 << 1),
 };
 
+enum {
+	TCA_FLOWER_KEY_CFM_OPT_UNSPEC,
+	TCA_FLOWER_KEY_CFM_MD_LEVEL,	/* u8 */
+	TCA_FLOWER_KEY_CFM_OPCODE, /* u8 */
+	__TCA_FLOWER_KEY_CFM_OPT_MAX,	/* u8 */
+};
+
+#define TCA_FLOWER_KEY_CFM_OPT_MAX \
+		(__TCA_FLOWER_KEY_CFM_OPT_MAX - 1)
+
 #define TCA_FLOWER_MASK_FLAGS_RANGE	(1 << 0) /* Range-based match */
 
 /* Match-all classifier */
