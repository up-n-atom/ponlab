# These options are part of the utility program ptp4l
# For more details about each option use 'ptp4l -h'
config 'ieee_1588' 'ptp_sync'
	option 'delay_mechanism'	'-E'
	option 'network_transport'	'-2'
	option 'timestamping'		'-H'
	option 'cfg_file'		'/etc/g_8275_1.conf'	# -f
	option 'interface'		'lct0'			# -i
	option 'log_level'		'6'			# -l
	option 'stdout'			''			# -m
	option 'syslog'			''			# -q

# These options are part of the utility program phc2sys
# For more details about each option use 'phc2sys -h'
config 'ieee_1588' 'tod2phc'
	option 'xpectd_mc_name'		'Intel PON TOD'
	option 'xpectd_sc_name'		'Intel F24S'
	option 'master_clock'		'ptp0'			# -s
	option 'slave_clock'		'ptp1'			# -c
	option 'offset'			'0'			# -O
	option 'time_thr'		'4'			# -T
	option 'sync_offset'		'-14'			# -o
	option 'step_thr'		'0.00002'		# -S
	option 'log_level'		'6'			# -l
	option 'stdout'			''			# -m
	option 'syslog'			''			# -q

# These options are part of the utility program phc2sys
# For more details about each option use 'phc2sys -h'
config 'ieee_1588' 'tod2ktimer'
	option 'xpectd_phc_name'	'Intel PON TOD'
	option 'auto_cfg'		'-a'
	option 'synch_sys_clk'		'-r'
	option 'phc_clk'		'ptp0'			# -p
	option 'domain_num'		'24'			# -n
	option 'offset'			'0'			# -O
	option 'log_level'		'6'			# -l
	option 'stdout'			''			# -m
	option 'syslog'			''			# -q
