config 'optic' 'common'
	option 'bias_hold_time' '202545'
	option 'bias_setup_time' '0'
	option 'serdes_hold_time' '3288945'
	option 'serdes_setup_time' '0'
	option 'burst_idle_pattern' '0x0000FFFF'
	option 'burst_en_mode' '0'
	option 'tx_en_mode' '0'
	option 'tx_pup_mode' '0'
	option 'sd_polarity' '0'
	option 'pse_en' '0'
	option 'tx_power_scale' '0' # TX power scaling factor (0 = 0.1 uW/LSB, 1 = 0.2 uW/LSB)

	# The options below are (currently) not changed by optic-db.
	# When one of them needs to be changed based on transceiver,
	# please move it up here and add it to all files in optic-db.
	option 'loop_timing_mode' '3'
	option 'loop_timing_power_save' '1'
	option 'laser_hold_time' '0'
	option 'laser_setup_time' '0'
	option 'gpio21_mode' '0' # This is reserved for future use, only the default mode 0 is supported
	option 'gpio24_mode' '0' # Selects the driver of OPT_TX_PUP (0 = hw, 1 = hw with fw override)
	option 'gpio25_mode' '0' # This is reserved for future use, only the default mode 0 is supported
	option 'dg_dis' '0' # Disable (1) automatic sending of dying gasp information upon undervoltage detection
	option 'aon_mode' '0' # 0: PON operation mode (default), 1: Active Ethernet operation mode
	option 'aon_pol' '1' # 0: OPT_TX_ENABLE is active high, 1: OPT_TX_ENABLE is active low (default)
	option 'opt_tx_sd_polarity' '0'
	option 'rogue_lead_time' '0'
	option 'rogue_lag_time' '0'
	option 'rogue_auto_en' '2' # PMD-based rogue ONU detection is enabled

config 'optic' 'twdm'
	option 'tuning' '0'
	option 'optical_link_type' 'A'
	option 'rx_wl_switch_time' '8000'
	option 'tx_wl_switch_time' '8000'
	option 'dwlch_id' '0'
	option 'free_spectral_range' '3000'
	option 'wl_ch_spacing' '200'
	option 'spectral_excursion' '20'
	option 'tuning_gran' '0'
	option 'fine_tune_time' '0'
	option 'ch_partition_index' '0'

	option 'channel_mask' '0xF'
	option 'tx_power_min' '4'
	option 'tx_power_max' '9'
	option 'cal_status_record' '0x3333000000000000'
	option 'config_method' '0'
	option 'wl_switch_delay' '24000' # 125 us units

config optic 'threshold'
	option 'lower_receive_optical_threshold' '-29'
	option 'upper_receive_optical_threshold' '-7'
	option 'lower_transmit_power_threshold' '1'
	option 'upper_transmit_power_threshold' '10'
	option 'bias_threshold' '60000'
