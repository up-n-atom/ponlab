config 'omci' 'default'
	option 'cur_mib_file' '/etc/mibs/current_mib.ini'
	option 'loid' 'loid'
	option 'lpwd' 'lpasswd'
	option 'omcc_version' '0xA3'
	option 'dbg_lvl' '3'
	option 'lct_disable' '$LCT_DIS'
	option 'warmstart' '0'
	option 'mib_data_sync' '0'
	option 'traffic_management' '2'
	option 'enabled' '1'

# Traffic policer from bridge port to IP Host software handler:
config 'omci' 'iphost'
	option 'enabled'     '1'          # enable (1) or disable (0) the policer function
	option 'committed'   '32000 2048' # committed information rate (bytes/s) followed by committed burst size (bytes)
	option 'peak'        '32000 2048' # optional peak information rate (bytes/s) followed by peak burst size (bytes)
	option 'color_aware' '0'          # 0 = color unaware, 1 = color aware
	option 'mode'        '0'          # 0 = default, 1 = RFC4115, 2 = RFC2698
