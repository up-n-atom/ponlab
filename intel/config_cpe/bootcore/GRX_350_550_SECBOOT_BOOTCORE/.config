CONFIG_BUILD_LOG=y
CONFIG_BUSYBOX_CUSTOM=y
# CONFIG_CERTIFICATION_SUPPORT is not set
CONFIG_DEVEL=y
CONFIG_EXTERNAL_KERNEL_TREE="$(TOPDIR)/../source/linux_bootcore"
CONFIG_GPL_DRIVER=y
CONFIG_IMAGEOPT=y
CONFIG_KERNEL_DEVMEM=y
CONFIG_KERNEL_GIT_CLONE_TO_EXTERNAL_TREE=y
CONFIG_KERNEL_GIT_CLONE_URI="$(TOPDIR)/../source/linux"
CONFIG_KERNEL_GIT_LOCAL_REPOSITORY=""
CONFIG_KERNEL_GIT_REF=""
CONFIG_KERNEL_PROC_PAGE_MONITOR=y
CONFIG_PACKAGE_eip123=y
CONFIG_PACKAGE_icc_user=y
CONFIG_PACKAGE_kmod-eip123=y
CONFIG_PACKAGE_libpthread=y
CONFIG_PACKAGE_librt=y
CONFIG_PACKAGE_secure-app=y
# CONFIG_PACKAGE_openwrt-keyring is not set
CONFIG_PACKAGE_sse_server=y
# CONFIG_PACKAGE_usign is not set
CONFIG_PHYS_RAM_OFFSET=0x20000000
# CONFIG_PKG_FORTIFY_SOURCE_1 is not set
CONFIG_PKG_FORTIFY_SOURCE_2=y
CONFIG_PRIVATE_KEY="privatekey.der"
CONFIG_PROD_UNIQUE_KEY="CRkey.bin"
CONFIG_RAM_CAPACITY=0x20000000
# CONFIG_REPRODUCIBLE_BUILDS is not set
CONFIG_SECBOOT=y
# CONFIG_SIGNED_PACKAGES is not set
CONFIG_SIGNTOOL="signtool"
CONFIG_TARGET_INITRAMFS_COMPRESSION_XZ=y
CONFIG_TARGET_ROOTFS_INITRAMFS=y
# CONFIG_TARGET_ROOTFS_SQUASHFS is not set
CONFIG_TARGET_intel_mips=y
CONFIG_TARGET_intel_mips_xrx500_4kec=y
CONFIG_TARGET_intel_mips_xrx500_4kec_Default=y
CONFIG_TOOLCHAINOPTS=y
