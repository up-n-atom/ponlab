 /* Max Sub-Block Size for CTP VLAN aware feature */
 #define VLAN_PCE_MAX_SUBBLK_SIZE 8
 
+/* CTP flow entry index used during reset in GSWIP CTP_PortCfgSet */
+#define CTP_FLOW_ENTRY_IDX_RESET 0xFFFFFFFF
+
 /* Main PCE rule entry struct */
 struct dp_pce_rule {
 	u32 hw_rules_max;
diff --git a/drivers/net/datapath/dpm/datapath_swdev.h b/drivers/net/datapath/dpm/datapath_swdev.h
index d1de50d53417..b61219fa283e 100644
--- a/drivers/net/datapath/dpm/datapath_swdev.h
+++ b/drivers/net/datapath/dpm/datapath_swdev.h
@@ -22,6 +22,7 @@
 #define CPU_PORT_DISABLE	BIT(4)
 
 #define DP_SWDEV_BRIDGE_ITEM 1
+#define DP_DEF_MAX_VLAN_LIMIT 8
 
 struct bridge_id_entry_item {
 	struct net_device *dev;
@@ -43,6 +44,8 @@ struct br_info {
 	u32 dp_port;
 	struct list_head bp_list;
 	bool br_vlan_en; 		/* VLAN Enabled for this bridge */
+	u32 max_vlan_limit;		/* Max Vlan allowed for this bridge */
+	u32 max_brid_limit;		/* Max Brid allowed for this bridge */
 	u32 num_vlan;			/* Num of vlans supported in br */
 	u32 num_fid;			/* Num of vlan aware fid in br */
 	struct list_head br_vlan_list;  /* List pointing to the vlan entry */
