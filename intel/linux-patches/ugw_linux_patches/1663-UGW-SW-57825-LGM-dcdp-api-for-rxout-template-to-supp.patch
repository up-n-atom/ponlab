From 448edf1ea898230a90c0c8b66565f7b50b251d00 Mon Sep 17 00:00:00 2001
From: Anath Bandhu Garai <anath.bandux.garai@intel.com>
Date: Wed, 5 May 2021 20:38:10 +0530
Subject: [PATCH] UGW_SW-57825 : LGM: dcdp api for rxout template to support dc
 buffer pool of high mem region

---
 include/net/directconnect_dp_api.h | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/include/net/directconnect_dp_api.h b/include/net/directconnect_dp_api.h
index f538e2f68959..4c082b728c69 100644
--- a/include/net/directconnect_dp_api.h
+++ b/include/net/directconnect_dp_api.h
@@ -52,7 +52,7 @@
 /**
   \brief DC DP API version code
  */
-#define DC_DP_API_VERSION_CODE        0x050005
+#define DC_DP_API_VERSION_CODE        0x050006
 
 /**
   \brief DC DP API version
@@ -1063,6 +1063,9 @@ struct dc_dp_ring_res {
                                             PRX (Falcon) - DW contains Policy, Pool */
 	uint32_t rxout_temp_dw3; /*!< [out] RXOUT (dev2soc) Template DW3  - 32bit
                                             LGM - DW contains Policy, Pool */
+	uint32_t rxout_temp_dw1; /*!< [out] RXOUT (dev2soc) Template DW1  - 32bit
+                                            LGM - DW contains 4bit High Address
+                                            PRX (Falcon) - NA SoC will set this to 0 */
 };
 
 /**
