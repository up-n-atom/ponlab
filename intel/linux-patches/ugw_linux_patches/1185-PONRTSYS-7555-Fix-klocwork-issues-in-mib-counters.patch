From 983ec67eb40f1fb17cbd5f72e636554b3b7c414f Mon Sep 17 00:00:00 2001
From: Robert Dabrowski <robertx.dabrowski@intel.com>
Date: Fri, 29 May 2020 17:19:23 +0200
Subject: [PATCH] PONRTSYS-7555: Fix klocwork issues in mib_counters

---
 drivers/net/datapath/mib_counters/dp_mib_counters.c | 10 ++++------
 1 file changed, 4 insertions(+), 6 deletions(-)

diff --git a/drivers/net/datapath/mib_counters/dp_mib_counters.c b/drivers/net/datapath/mib_counters/dp_mib_counters.c
index be2b68b6d9db..995d4a88ee94 100644
--- a/drivers/net/datapath/mib_counters/dp_mib_counters.c
+++ b/drivers/net/datapath/mib_counters/dp_mib_counters.c
@@ -157,6 +157,8 @@ static void update_dev_counters(struct mib_counters *cnt, u8 initial_update)
 	tmp_counters = devm_kzalloc(&g_dp_dev->dev,
 				    (2 * sizeof(GSW_RMON_Port_cnt_t)),
 				    GFP_ATOMIC);
+	if (!tmp_counters)
+		return;
 
 	ops = dp_port_prop[cnt->inst].ops[0];
 
@@ -180,7 +182,7 @@ static void update_dev_counters(struct mib_counters *cnt, u8 initial_update)
 		}
 	}
 	/* After this loop tmp_counters[0] contains all CTP counters, RX and TX
-	 * where RX counters are valid but TX can be not valid. 
+	 * where RX counters are valid but TX can be not valid.
 	 * In tmp_counters[1] there are CTP Bypass TX counters, all RX counters
 	 * here are invalid.
 	 * CTP Tx counters are placed before QoS modules, and they
@@ -530,15 +532,11 @@ void mib_cnt_get_ethtool_stats_31(struct net_device *dev,
 	read_unlock(&dev_list_lock);
 
 	/* Get reinserted packets counters */
-	ret = dp_get_reinsert_cnt_31(mib_cnt->inst,
+	(void)dp_get_reinsert_cnt_31(mib_cnt->inst,
 				     mib_cnt->port_id,
 				     mib_cnt->sub_if_id_grp,
 				     0,
 				     &dp_reins_count);
-	if (ret != DP_SUCCESS) {
-		netdev_err(mib_cnt->dev, "dp_get_reinsert_cnt_31 returned %d\n", ret);
-		return;
-	}
 
 	/* Take away reinserted packets */
 	wide_cnt_mod.nRx64BytePkts -= dp_reins_count.dp_64BytePkts;
