From 30131f79ef0ec31622bfd1b39c8a790c3ba82aac Mon Sep 17 00:00:00 2001
From: Elad Fernandes <elad.fernandes@intel.com>
Date: Wed, 21 Oct 2020 09:53:46 +0300
Subject: [PATCH] LMTSYS-4051: Support pppoe payload len update for header
 replace recipe in LGM PPv4

---
 .../ppv4/pp-api/pp-session-mgr/pp_session_mgr.c    | 74 ++++++++++++++++------
 .../net/ppv4/pp-hal/modifier/modifier_recipes.c    | 66 +++++++++++++++++--
 2 files changed, 113 insertions(+), 27 deletions(-)

diff --git a/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c b/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c
index b9fa5dc8a028..164716aea92f 100644
--- a/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c
+++ b/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c
@@ -524,6 +524,21 @@ __smgr_is_ipv6_opt_changed(struct sess_info *s, u8 rx_lvl, u8 tx_lvl)
 	return false;
 }
 
+/**
+ * @brief Check whether a session is pppoe bypass or not
+ * @param s the session to test
+ * @return bool true if it is, false otherwise
+ */
+static inline bool __smgr_is_pppoe_bypass(struct sess_info *s)
+{
+	/* is pppoe header on both directions and session is bridged */
+	if (SESS_RX_IS_OUTER_PPPOE(s) && SESS_TX_IS_OUTER_PPPOE(s) &&
+	    __smgr_is_sess_bridged(s))
+		return true;
+
+	return false;
+}
+
 /**
  * @brief Check whether a session is pppoe inner encapsulation or not
  * @param s the session to test
@@ -2825,34 +2840,51 @@ static void __smgr_pppoe_mod_set(struct sess_info *s)
 
 	sce->valid = true;
 
-	if (__smgr_is_pppoe_encap(s)) {
+	if (__smgr_is_pppoe_outer_encap(s) ||
+	    (__smgr_is_pppoe_bypass(s) && __smgr_is_outer_l2_changed(s))) {
 		/* pppoe encapsulation, set the sce parameters so that
-		 * the recipe will calculate the pppoe header length and
-		 * will update the new header accordingly
-		 */
-		sce->pppoe_diff = 2 /* for the eth last protocol */;
+		* the recipe will calculate the pppoe header length and
+		* will update the new header accordingly
+		*/
+		sce->pppoe_diff = 2; /* for the eth last protocol */
 		sce->l2_org_val = 0;
-		/* calculate the pppoe header offset */
-		if (__smgr_is_pppoe_outer_encap(s)) {
-			/* in case we have new header with ipv6 we must add
-			 * the ipv6 header length also to the pppoe_diff
-			 * cause its length field doesn't include it
-			 */
-			if (__smgr_is_iptun_encp_sess(s) &&
-			    SESS_TX_IS_OUTER_V6(s))
-				sce->pppoe_diff += sizeof(struct ipv6hdr);
-			dpu->pppoe_off = pktprs_hdr_off(SESS_TX_PKT(s),
-							PKTPRS_PROTO_PPPOE,
-							HDR_OUTER);
+		/* in case we have ipv6 we must add
+		 * the ipv6 header length also to the pppoe_diff
+		 * cause its length field doesn't include it
+		 */
+		if (SESS_TX_IS_OUTER_V6(s)) {
+			sce->pppoe_diff += sizeof(struct ipv6hdr);
+			dpu->lyr_fld_off =
+				offsetof(struct ipv6hdr, payload_len);
 		} else {
-			dpu->pppoe_off = pktprs_hdr_off(SESS_TX_PKT(s),
-							PKTPRS_PROTO_PPPOE,
-							HDR_INNER);
+			dpu->lyr_fld_off = offsetof(struct iphdr, tot_len);
 		}
+		dpu->pppoe_off = pktprs_hdr_off(SESS_TX_PKT(s),
+						PKTPRS_PROTO_PPPOE,
+						HDR_OUTER);
+		return;
+	}
+
+	if (__smgr_is_pppoe_inner_encap(s)) {
+		/* pppoe encapsulation, set the sce parameters so that
+		* the recipe will calculate the pppoe header length and
+		* will update the new header accordingly
+		*/
+		sce->pppoe_diff = 2; /* for the eth last protocol */
+		sce->l2_org_val = 0;
+		/* in case we have ipv6 we must add
+		 * the ipv6 header length also to the pppoe_diff
+		 * cause its length field doesn't include it
+		 */
+		if (SESS_TX_IS_INNER_V6(s))
+			sce->pppoe_diff += sizeof(struct ipv6hdr);
+		dpu->pppoe_off = pktprs_hdr_off(SESS_TX_PKT(s),
+						PKTPRS_PROTO_PPPOE,
+						HDR_INNER);
 		return;
 	}
 
-	/* not pppoe encapsulation, to reduce number of recipes, we
+	/* not pppoe encapsulation or bypass, to reduce number of recipes, we
 	 * always do the pppoe length calculations, but when we don't
 	 * have pppoe encapsulation, we need to set the right values
 	 * so the recipe will overwrite the new header with the same
diff --git a/drivers/net/ppv4/pp-hal/modifier/modifier_recipes.c b/drivers/net/ppv4/pp-hal/modifier/modifier_recipes.c
index 5af212bb1c19..5115e77b8414 100644
--- a/drivers/net/ppv4/pp-hal/modifier/modifier_recipes.c
+++ b/drivers/net/ppv4/pp-hal/modifier/modifier_recipes.c
@@ -385,11 +385,24 @@ static s32 mod_rcp_no_mod_set(s32 rcp_idx)
 	return ret;
 }
 
-static s32 mod_rcp_hdr_rplc_set(s32 rcp_idx,
+static s32 mod_rcp_hdr_rplc_set(s32 rcp_idx, bool pppoe_update,
 				enum mod_eu_stw_mux_sel strip_l3_off)
 {
 	struct mod_recipe rcp;
 	s32 ret = 0;
+	s32 pkt_l3_len     = DPU_RCP_REG0_B0;
+	s32 si_l3_ttl_diff = DPU_RCP_REG1_B0;
+	s32 pppoe_diff     = DPU_RCP_REG1_B1;
+	s32 pppoe_len      = DPU_RCP_REG1_B2;
+
+	/* USE registers R12 - R15 with extra caution as they are
+	 * the registers to compare to for the alu conditions
+	 * R12 - in used by ALU0 for pppoe and l4 csum calculation and MUST
+	 *       be zero in the time of the calculation
+	 * R13 - not used
+	 * R14 - not used
+	 * R15 - not used
+	 */
 
 	if (unlikely(rcp_idx > MOD_RCP_LAST)) {
 		pr_err("error: invalid recipe id, %d\n", rcp_idx);
@@ -401,12 +414,53 @@ static s32 mod_rcp_hdr_rplc_set(s32 rcp_idx,
 	memset(&rcp, 0, sizeof(rcp));
 	rcp.index = rcp_idx;
 
+	if (pppoe_update) {
+		/*==========================================*/
+		/* copy from sce mux to dpu registers (sce) */
+		/*==========================================*/
+		/* Fetch SI info: ttl, pppoe diff and pppoe length fields */
+		ret |= mod_sce_mux_to_reg_cpy(&rcp, si_l3_ttl_diff,
+					      SCE_SI_SEL_TTL);
+
+		/*===========================================*/
+		/* copy from packet to dpu registers (store) */
+		/*===========================================*/
+		/* store L3 total_len */
+		ret |= mod_pkt_to_reg_cpy(&rcp, pkt_l3_len, strip_l3_off,
+					  MOD_SI_PKT_OFF,
+					  FIELD_SIZEOF(struct iphdr, tot_len));
+
+		/*=========================*/
+		/*      ALU operations     */
+		/*=========================*/
+		/* sync to the IP len field */
+		ret |= mod_alu_synch(EU_ALU0, &rcp, strip_l3_off,
+				     MOD_SI_PKT_OFF,
+				     FIELD_SIZEOF(struct iphdr, tot_len));
+
+		/* pppoe_len = pppoe_diff ? pppoe_diff + l3 len : l2_org_val */
+		ret |= mod_alu_add_cond(EU_ALU0, &rcp, pppoe_diff, 1,
+					pkt_l3_len, 2, pppoe_len,
+					EU_ALU_L0_BIG_R2, EU_ALU_COND_MET);
+	}
+
 	/*============================================*/
 	/* copy from si bce (sram) to packet (insrep) */
 	/*============================================*/
 	/* replace old header with new header */
 	ret |= mod_hdr_rplc(&rcp, BCE_OFF_0, strip_l3_off);
 
+	/*======================================================*/
+	/* copy from dpu registers to packet new header (reps1) */
+	/*======================================================*/
+	if (pppoe_update)
+		ret |= mod_reg_to_new_hdr_cpy(&rcp, pppoe_len,
+					      EU_SI_SEL_PPPOE_OFF,
+					      offsetof(struct pppoe_hdr,
+						       length),
+					      FIELD_SIZEOF(struct pppoe_hdr,
+							   length));
+
 	/*=================================================*/
 	/* complete recipe with nop command and 'last' bit */
 	/*=================================================*/
@@ -459,10 +513,10 @@ static s32 mod_rcp_ipv4_routed_set(s32 rcp_idx, enum mod_eu_stw_mux_sel l3_off,
 
 	/* USE registers R12 - R15 with extra caution as they are
 	 * the registers to compare to for the alu conditions
-	 * R12 - not used
-	 * R13 - not used
-	 * R14 - in used by ALU1 for pppoe and l4 csum calculation and MUST
+	 * R12 - in used by ALU0 for pppoe and l4 csum calculation and MUST
 	 *       be zero in the time of the calculation
+	 * R13 - not used
+	 * R14 - not used
 	 * R15 - not used
 	 */
 
@@ -1120,7 +1174,7 @@ s32 mod_rcp_init(void)
 		goto err;
 
 	/* config recipe L2 replacing only */
-	ret = mod_rcp_hdr_rplc_set(MOD_RCP_HDR_RPLC, EU_STW_SEL_L3_OFF0);
+	ret = mod_rcp_hdr_rplc_set(MOD_RCP_HDR_RPLC, true, EU_STW_SEL_L3_OFF0);
 	if (unlikely(ret))
 		goto err;
 
@@ -1251,7 +1305,7 @@ s32 mod_rcp_init(void)
 		goto err;
 
 	/* recipe for esp w/o outer ip header at egress */
-	ret = mod_rcp_hdr_rplc_set(MOD_RCP_ESP_OUTER_IP_REM,
+	ret = mod_rcp_hdr_rplc_set(MOD_RCP_ESP_OUTER_IP_REM, false,
 				   EU_STW_SEL_L3_OFF1);
 	if (unlikely(ret))
 		goto err;
