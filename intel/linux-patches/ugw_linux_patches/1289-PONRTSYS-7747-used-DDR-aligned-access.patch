From 12ff6dd222fcd7a08c7ecccebd80c6cc6abe5b60 Mon Sep 17 00:00:00 2001
From: avishalo <avi1.shalom@intel.com>
Date: Thu, 2 Apr 2020 12:07:50 +0300
Subject: [PATCH] PONRTSYS-7747: used DDR aligned access

Signed-off-by: avishalo <avi1.shalom@intel.com>
---
 drivers/net/ppv4/pp-hal/rx-dma/rx_dma.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/drivers/net/ppv4/pp-hal/rx-dma/rx_dma.c b/drivers/net/ppv4/pp-hal/rx-dma/rx_dma.c
index 59ab6bfd7a49..ed934ab568f9 100644
--- a/drivers/net/ppv4/pp-hal/rx-dma/rx_dma.c
+++ b/drivers/net/ppv4/pp-hal/rx-dma/rx_dma.c
@@ -3,7 +3,7 @@
  * Description: Packet Processor RX-DMA Driver
  *
  * SPDX-License-Identifier: GPL-2.0-only
- * Copyright (C) 2018-2019 Intel Corporation
+ * Copyright (C) 2018-2020 Intel Corporation
  */
 #include <linux/kernel.h>
 #include <linux/types.h>
@@ -129,7 +129,7 @@ static s32 __rx_dma_config_set(struct pp_rx_dma_init_params *cfg)
 
 	/* Configure DMA alignment and burst size */
 	reg_val = PP_REG_RD32(PP_RX_DMA_CFG_REG);
-	reg_val = PP_FIELD_MOD(PP_RX_DMA_CFG_DDR_ALIGN_EN_MSK, 0, reg_val);
+	reg_val = PP_FIELD_MOD(PP_RX_DMA_CFG_DDR_ALIGN_EN_MSK, 1, reg_val);
 	reg_val = PP_FIELD_MOD(PP_RX_DMA_CFG_MAX_BURST_MSK,
 			       RX_DMA_CFG_MAX_BURST, reg_val);
 	PP_REG_WR32(PP_RX_DMA_CFG_REG, reg_val);
