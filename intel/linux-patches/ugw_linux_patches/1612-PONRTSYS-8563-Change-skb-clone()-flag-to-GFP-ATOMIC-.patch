From ca6b019433e78b583b224b2ec7a6188a97d13381 Mon Sep 17 00:00:00 2001
From: Cardoso Tiago <tiago.cardoso.abrahao@intel.com>
Date: Thu, 25 Feb 2021 18:10:08 +0100
Subject: [PATCH] PONRTSYS-8563 Change skb_clone() flag to GFP_ATOMIC and
 initialize cb_lock

---
 drivers/net/datapath/bridge_filter/arp_ndp_reinsert.c | 2 +-
 drivers/net/datapath/dpm/gswip31/datapath_misc.c      | 2 ++
 2 files changed, 3 insertions(+), 1 deletion(-)

diff --git a/drivers/net/datapath/bridge_filter/arp_ndp_reinsert.c b/drivers/net/datapath/bridge_filter/arp_ndp_reinsert.c
index 1712b6fc81a3..c93a69a7a640 100644
--- a/drivers/net/datapath/bridge_filter/arp_ndp_reinsert.c
+++ b/drivers/net/datapath/bridge_filter/arp_ndp_reinsert.c
@@ -43,7 +43,7 @@ static int arp_ndp_reinsert_packet(struct sk_buff *skb)
 		return -EIO;
 	}
 
-	nskb = skb_clone(skb, GFP_KERNEL);
+	nskb = skb_clone(skb, GFP_ATOMIC);
 	if (!nskb)
 		return -ENOMEM;
 
diff --git a/drivers/net/datapath/dpm/gswip31/datapath_misc.c b/drivers/net/datapath/dpm/gswip31/datapath_misc.c
index e37ef4507319..f64345c7a7e9 100644
--- a/drivers/net/datapath/dpm/gswip31/datapath_misc.c
+++ b/drivers/net/datapath/dpm/gswip31/datapath_misc.c
@@ -1409,6 +1409,8 @@ static int dp_platform_set(int inst, u32 flag)
 
 		priv = (struct hal_priv *)dp_prop->priv_hal;
 
+		DP_TX_CB_LOCK_INIT(&priv->cb_lock);
+
 		/* Drop Q is currently mapped to 255 */
 		priv->ppv4_drop_q = MAX_QUEUE - 1;
 
