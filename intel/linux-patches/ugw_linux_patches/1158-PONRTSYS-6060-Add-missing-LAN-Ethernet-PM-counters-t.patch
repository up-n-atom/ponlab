-/********************* ETHTOOL STATISTIC SUPPORT ****************************/
-
-#if IS_ENABLED(CONFIG_INTEL_MIB_COUNTERS)
-/* ethtool statistics serviced in mib_counters module */
-#else
-/* This function is used for retrieving MIB counters statistics from
- * HW registers when "mib_counters" kernel module isn't used for
- * handling counters overflow
- */
-void dp_net_dev_get_ethtool_stats_31(struct net_device *dev,
-				     struct ethtool_stats *stats, u64 *data)
-{
-	GSW_RMON_Port_cnt_t *g_counters;
-	struct pmac_port_info *port_info;
-	struct core_ops *ops;
-	dp_subif_t *ps_subif;
-	u32 flags = 0;
-	u64 *data_dst;
-	s32 ret = 0;
-	u8 i = 0;
-
-	ops = dp_port_prop[0].ops[0];
-
-	ps_subif = devm_kzalloc(&g_dp_dev->dev, (sizeof(dp_subif_t)),
-				GFP_ATOMIC);
-	if (!ps_subif)
-		return;
-
-	/* two counters structures are used
-	 * one set for BP or regular CTP
-	 * second set for CTP PCE-Bypass
-	 */
-	g_counters = devm_kzalloc(&g_dp_dev->dev,
-				  (2 * sizeof(GSW_RMON_Port_cnt_t)),
-				  GFP_ATOMIC);
-	if (!g_counters) {
-		devm_kfree(&g_dp_dev->dev, ps_subif);
-		return;
-	}
-	/* get subif information from net device */
-	ret = dp_get_netif_subifid(dev, NULL, NULL, NULL, ps_subif, flags);
-	if (ret != DP_SUCCESS) {
-		netdev_err(dev, "dp_get_netif_subifid returned %d\n", ret);
-		devm_kfree(&g_dp_dev->dev, ps_subif);
-		devm_kfree(&g_dp_dev->dev, g_counters);
-		return;
-	}
-
-	/* for all port kinds use the same algorithm:
-	 * read Rx counters using CTP_PORT (even for BRIDGE ports)
-	 * read Tx counters using CTP Bypass
-	 */
-	port_info = get_dp_port_info(0, ps_subif->port_id);
-	/* first pass reads CTP counters,
-	 * second pass reads CTP-Bypass counters
-	 */
-	for (i = 0; i < 2; i++) {
-		g_counters[i].ePortType = GSW_CTP_PORT;
-		g_counters[i].nPortId = ps_subif->port_id;
-		g_counters[i].nSubIfIdGroup = GET_VAP(ps_subif->subif,
-						      port_info->vap_offset,
-						      port_info->vap_mask);
-		g_counters[i].bPceBypass = i;
-
-		/* read CTP counters */
-		ret = ops->gsw_rmon_ops.RMON_Port_Get(ops, &g_counters[i]);
-		if (ret != DP_SUCCESS) {
-			netdev_err(dev, "RMON_Port_Get returned %d\n", ret);
-			devm_kfree(&g_dp_dev->dev, g_counters);
-			devm_kfree(&g_dp_dev->dev, ps_subif);
-			return;
-		}
-	}
-
-	/* CTP TX counters are placed before QoS modules, and they
-	 * record packets dropped by QoS modules too.
-	 * CTP TX Bypass counters are placed after QoS modules,
-	 * and they record the packets actually transmitted.
-	 */
-#define _DP_ETHTOOL_TX(r)	g_counters[0].r = g_counters[1].r;
-	DP_ETHTOOL_STAT_REG_TX_DECLARE
-#undef _DP_ETHTOOL_TX
-
-	/* here subtract counters by reinserted packets */
-
-	/* copy counters' values to ethtool buffer */
-	data_dst = data;
-
-#define _DP_ETHTOOL(x, y)	*data_dst++ = g_counters[0].y;
-	DP_ETHTOOL_STAT_REG_DECLARE
-#undef _DP_ETHTOOL
-
-	devm_kfree(&g_dp_dev->dev, g_counters);
-	devm_kfree(&g_dp_dev->dev, ps_subif);
-}
-#endif /* CONFIG_INTEL_MIB_COUNTERS */
