From 13d07ca24e1b1254322bdd779a7a4f61243bae6a Mon Sep 17 00:00:00 2001
From: ofirbitt <ofir1.bitton@intel.com>
Date: Wed, 11 Mar 2020 08:50:42 +0200
Subject: [PATCH] PONRTSYS-6779: Fix PPv4 QoS lock init

---
 drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_main.c  | 1 -
 drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.c | 2 ++
 2 files changed, 2 insertions(+), 1 deletion(-)

diff --git a/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_main.c b/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_main.c
index b47004188059..9727fb7d8e27 100644
--- a/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_main.c
+++ b/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_main.c
@@ -4126,7 +4126,6 @@ struct pp_qos_dev *pp_qos_dev_open(u32 id)
 		QOS_LOG_DEBUG("Allocate new QoS instance id %d\n", id);
 		qos_devs[id] = kzalloc(sizeof(*qos_devs[id]), GFP_ATOMIC);
 		qos_devs[id]->id = id;
-		QOS_LOCK_INIT(qos_devs[id]);
 	}
 
 	spin_unlock(&drv_lock);
diff --git a/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.c b/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.c
index 2c98c314ed40..36d9ad12eece 100644
--- a/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.c
+++ b/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.c
@@ -2082,6 +2082,8 @@ s32 qos_dev_init_db(struct pp_qos_dev *qdev, u32 max_ports, u32 max_queues,
 	memset(qdev, 0, sizeof(struct pp_qos_dev));
 	qdev->init_params.max_ports = max_ports;
 
+	QOS_LOCK_INIT(qdev);
+
 	if (qos_pools_init(qdev, max_ports, max_queues, reserved_queues,
 			   num_syncqs))
 		goto fail;
