From 94bc675383d9d190b3055953f64887cf8ccb8466 Mon Sep 17 00:00:00 2001
From: arathinx <ayyappanx.rathinam@intel.com>
Date: Sun, 7 Jun 2020 14:02:16 +0800
Subject: [PATCH] DRVLIB_SW-3672: release the firmware if request fails

---
 drivers/net/ethernet/lantiq/xrx500_phy_fw.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/drivers/net/ethernet/lantiq/xrx500_phy_fw.c b/drivers/net/ethernet/lantiq/xrx500_phy_fw.c
index 806ea8fb48e8..03a1f7b7fae1 100644
--- a/drivers/net/ethernet/lantiq/xrx500_phy_fw.c
+++ b/drivers/net/ethernet/lantiq/xrx500_phy_fw.c
@@ -561,6 +561,7 @@ static int xway_gphy_load(struct xway_gphy_data *priv)
 	if (request_firmware(&fw, priv->fw_name, priv->dev)) {
 		dev_err(priv->dev, "failed to load firmware: %s\n",
 			priv->fw_name);
+		release_firmware(fw);
 		return -EIO;
 	}
 
