From 404e3cf812f7eeb2a65108a2aaaf2201c6feaa6d Mon Sep 17 00:00:00 2001
From: Deepansh Rastogi <deepansh.rastogi@intel.com>
Date: Fri, 27 Dec 2019 11:28:19 +0530
Subject: [PATCH] UGW_SW-46378: Changing drop algo of system default queues to
 Drop Tail mode

---
 drivers/net/ethernet/lantiq/cqm/grx500/cbm.c | 12 ++++++++++++
 include/net/drv_tmu_ll.h                     |  3 +++
 2 files changed, 15 insertions(+)

diff --git a/drivers/net/ethernet/lantiq/cqm/grx500/cbm.c b/drivers/net/ethernet/lantiq/cqm/grx500/cbm.c
index acb144c342ea..e4b937052fda 100644
--- a/drivers/net/ethernet/lantiq/cqm/grx500/cbm.c
+++ b/drivers/net/ethernet/lantiq/cqm/grx500/cbm.c
@@ -3353,6 +3353,7 @@ dp_enable(
 	int q_buff_num;
 	unsigned long sys_flag;
 	int port, port_high;
+	struct tmu_equeue_drop_params thx = {0};
 
 	qidt_set.ep = port_id;
 	qidt_mask.ep_mask = 0;
@@ -3431,6 +3432,17 @@ dp_enable(
 		tmu_equeue_enable(tmp_q_buff3[j], (flags & CBM_PORT_F_DISABLE) ? 0 : 1);
 		LOGF_KLOG_INFO("enable queue %d\n", tmp_q_buff3[j]);
 		LOGF_KLOG_INFO("flag %d refcnt %d\n", ((flags & CBM_PORT_F_DISABLE) ? 0 : 1), cbm_qtable[tmp_q_buff3[j]].refcnt);
+
+		tmu_equeue_drop_params_get(tmp_q_buff3[j], &thx);
+		/*
+		 * Change drop algo to DT and increase green threshold to thren times
+		 * the default threshold
+		 */
+		thx.dmod = 0;
+		thx.math0 = 3 * TMU_GREEN_DEFAULT_THRESHOLD;
+		thx.math1 = TMU_GREEN_DEFAULT_THRESHOLD;
+		thx.qtth1 = TMU_GREEN_DEFAULT_THRESHOLD;
+		tmu_equeue_drop_params_set(tmp_q_buff3[j], &thx);
 	}
 	/*Enable the TMU port, i*/
 	tmu_egress_port_enable(res[0].tmu_port, (flags & CBM_PORT_F_DISABLE) ? 0 : 1);
diff --git a/include/net/drv_tmu_ll.h b/include/net/drv_tmu_ll.h
index 0a3aa99b92f1..b7681b6a8809 100644
--- a/include/net/drv_tmu_ll.h
+++ b/include/net/drv_tmu_ll.h
@@ -124,6 +124,9 @@ In order to easy setting, here only use 9K normal frame number
 /** Factory default value for TBS peak maximum burst size*/
 #define TMU_TBS_PBS_DEF	16000000UL
 
+/** Factory default value for green threshold*/
+#define TMU_GREEN_DEFAULT_THRESHOLD 0x24
+
 /**
    This structure is used to set the modes and drop thresholds
    for an egress queue.
