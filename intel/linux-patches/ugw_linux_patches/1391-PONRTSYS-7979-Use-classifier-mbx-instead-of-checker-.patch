From 0b69c1c417147ae8654414a5ba32063f150a7e8c Mon Sep 17 00:00:00 2001
From: Oren Bakshe <oren.bakshe@intel.com>
Date: Wed, 12 Aug 2020 14:13:39 +0300
Subject: [PATCH] PONRTSYS-7979: Use classifier mbx instead of checker mbx in
 a-step

---
 drivers/net/ppv4/pp-dev/pp_dts.c                   |   8 +-
 drivers/net/ppv4/pp-hal/classifier/classifier.c    | 204 +++++++++++++--------
 drivers/net/ppv4/pp-hal/micro-controller/uc.c      |   7 +
 drivers/net/ppv4/pp-hal/micro-controller/uc.h      |   1 +
 .../net/ppv4/pp-hal/micro-controller/uc_common.h   |  34 +++-
 5 files changed, 171 insertions(+), 83 deletions(-)

diff --git a/drivers/net/ppv4/pp-dev/pp_dts.c b/drivers/net/ppv4/pp-dev/pp_dts.c
index 96af488ff237..2688414d57f7 100644
--- a/drivers/net/ppv4/pp-dev/pp_dts.c
+++ b/drivers/net/ppv4/pp-dev/pp_dts.c
@@ -3,7 +3,7 @@
  * Description: PP Device Driver
  *
  * SPDX-License-Identifier: GPL-2.0-only
- * Copyright (C) 2018-2019 Intel Corporation
+ * Copyright (C) 2018-2020 Intel Corporation
  */
 #include <linux/platform_device.h>
 #include <linux/of_device.h>
@@ -743,6 +743,11 @@ static s32 __dts_egr_uc_cfg(struct pp_dts_cfg *dts_cfg)
 	/* Get TX-manager credit physical base */
 	ret = __dts_phys_addr_get(pdev, "txm-cred-base-addr",
 				  &ucp->txm_cred_base);
+	if (unlikely(ret))
+		goto done;
+
+	/* Get classifier physical base */
+	ret = __dts_phys_addr_get(pdev, "cls-base-addr", &ucp->cls_base);
 
 	if (!ret)
 		ucp->valid = true;
@@ -946,6 +951,7 @@ void pp_dts_cfg_dump(struct pp_dts_cfg *cfg)
 		cfg->uc_params.egr.client_base);
 	pr_info("Egress uC TXM credit Base 0x%llx\n",
 		cfg->uc_params.egr.txm_cred_base);
+	pr_info("Egress uC CLS Base 0x%llx\n", cfg->uc_params.egr.cls_base);
 	pr_info("Ingress uC Base 0x%llx\n",
 		pp_virt_to_phys((void *)cfg->uc_params.ing.uc_base));
 	pr_info("Ingress uC max-cpus %u\n", cfg->uc_params.ing.cpus.max_cpu);
diff --git a/drivers/net/ppv4/pp-hal/classifier/classifier.c b/drivers/net/ppv4/pp-hal/classifier/classifier.c
index cf3706f60c2f..0e48d4e1f12a 100644
--- a/drivers/net/ppv4/pp-hal/classifier/classifier.c
+++ b/drivers/net/ppv4/pp-hal/classifier/classifier.c
@@ -731,7 +731,7 @@ s32 cls_session_add(void *si, struct pp_hash *hash)
 	return db->cls_cmd_status;
 }
 
-static inline bool __cls_is_cmd_fifo_ready(u32 cmd_num_words)
+static inline bool __cls_is_cmd_fifo_ready(void)
 {
 	/* Check num of free words on FIFO */
 	if (pp_reg_poll(PP_CLS_CMD_STATUS_REG,
@@ -744,33 +744,93 @@ static inline bool __cls_is_cmd_fifo_ready(u32 cmd_num_words)
 	return true;
 }
 
-static inline void __cls_cmd_hash_wr(u32 h1, u32 h2, u32 sig)
+static inline bool __cls_cmd_is_done(void)
 {
-	/* Write the hash results to command fifo */
-	PP_REG_WR32(PP_CLS_CMD_DATA_REG, h1);
-	PP_REG_WR32(PP_CLS_CMD_DATA_REG, h2);
-	PP_REG_WR32(PP_CLS_CMD_DATA_REG, sig);
+	if (pp_reg_poll(PP_CLS_CMD_STATUS_REG, PP_CLS_CMD_STATUS_MSK, 0)) {
+		pr_err("Failed polling on classifier command status\n");
+		return false;
+	}
+
+	return true;
 }
 
-static inline void __cls_cmd_start(u32 cmd)
+/**
+ * @brief Dispatch mailbox command to the classifier
+ * @note MUST be called under a lock
+ * @param id session id
+ * @param cmd the command
+ */
+static inline s32 __cls_cmd_dispatch(struct uc_cls_cmd *uc_cmd)
 {
-	/* Kick command */
-	PP_REG_WR32(PP_CLS_CMD_KICK_REG, cmd);
+	s32 ret = 0;
+
+	pr_debug("cmd_id %u\n", uc_cmd->cmd_id);
+
+	/* send command */
+	ret = uc_egr_mbox_cmd_send(UC_CMD_CLS_MBX, 0, (const void *)uc_cmd,
+				   sizeof(*uc_cmd), NULL, 0);
+	if (ret)
+		pr_err("UC_CMD_CLS_MBX command failed\n");
+
+	return ret;
 }
 
-static inline bool __cls_cmd_is_done(void)
+static inline s32 __cls_cmd_execute(struct uc_cls_cmd *cmd)
 {
-	if (pp_reg_poll(PP_CLS_CMD_STATUS_REG, PP_CLS_CMD_STATUS_MSK, 0)) {
-		pr_err("Failed polling on classifier command status\n");
-		return false;
+	s32 ret = 0;
+	u32 i;
+
+	pr_debug("Executing CLS CMD %u\n", cmd->cmd_id);
+
+	/* A Step */
+	if (pp_silicon_step_get() == PP_SSTEP_A) {
+		ret = __cls_cmd_dispatch(cmd);
+		if (ret)
+			pr_err("CLS CMD %u failed\n", cmd->cmd_id);
+		else
+			pr_debug("CLS CMD done successfully\n");
+		return ret;
 	}
 
-	return true;
+	/* B Step */
+	PP_REG_WR32(PP_CLS_CMD_DATA_REG, cmd->h1);
+	PP_REG_WR32(PP_CLS_CMD_DATA_REG, cmd->h2);
+	PP_REG_WR32(PP_CLS_CMD_DATA_REG, cmd->sig);
+	PP_REG_WR32(PP_CLS_CMD_DATA_REG, cmd->cmd_info);
+	PP_REG_WR32(PP_CLS_CMD_DATA_REG, cmd->dsi_info);
+
+	/* Write SI */
+	if (cmd->cmd_id == CLS_CMD_IF_ADD) {
+		for (i = 0; i < PP_SI_WORDS_CNT; i++) {
+			pr_debug("CLS_CMD_WORD[%-2u]:  0x%X\n",
+					 i, cmd->si[i]);
+			PP_REG_WR32_NO_SWAP(PP_CLS_CMD_DATA_REG, cmd->si[i]);
+		}
+	}
+
+	/* Kick command */
+	PP_REG_WR32(PP_CLS_CMD_KICK_REG, cmd->cmd_id);
+
+	if (unlikely(!__cls_cmd_is_done())) {
+		db->cls_cmd_status = -ETIME;
+		return -EINVAL;
+	}
+
+	if (unlikely(!__cls_is_cmd_fifo_ready())) {
+		db->cls_cmd_status = -ENOMEM;
+		return -EINVAL;
+	}
+
+	pr_debug("CLS CMD done successfully\n");
+
+	return 0;
 }
 
 s32 cls_session_dsi_update(u32 id, u16 dst_q, bool clr_cntr)
 {
+	struct uc_cls_cmd uc_cmd;
 	u32 reg;
+	s32 ret = 0;
 
 	pr_debug("CLS CMD update session %u: new_queue=%hu clear_counters=%s\n",
 		 id, dst_q, clr_cntr ? "YES" : "NO");
@@ -781,19 +841,15 @@ s32 cls_session_dsi_update(u32 id, u16 dst_q, bool clr_cntr)
 		return -EINVAL;
 	}
 
-	__cls_cmd_lock();
-	if (unlikely(!__cls_is_cmd_fifo_ready(CLS_UPDATE_CMD_SZ))) {
-		__cls_cmd_unlock();
-		return -ENOMEM;
-	}
-
 	/* Write the hash results - NA for update command */
-	__cls_cmd_hash_wr(0, 0, 0);
+	uc_cmd.h1 = 0;
+	uc_cmd.h2 = 0;
+	uc_cmd.sig = 0;
 
 	/* Write the command info */
 	reg  = PP_FIELD_PREP(CLS_CMD_UPDT_DSI_INFO, 1);
 	reg |= PP_FIELD_PREP(CLS_CMD_SESS_ID, id);
-	PP_REG_WR32(PP_CLS_CMD_DATA_REG, reg);
+	uc_cmd.cmd_info = reg;
 
 	/* Write DSI info */
 	if (dst_q != PP_QOS_INVALID_ID) {
@@ -801,20 +857,21 @@ s32 cls_session_dsi_update(u32 id, u16 dst_q, bool clr_cntr)
 		reg |= PP_FIELD_PREP(CLS_CMD_DSI_DST_Q, dst_q);
 	}
 	reg |= PP_FIELD_PREP(CLS_CMD_DSI_CNT_CLR, clr_cntr);
-	PP_REG_WR32(PP_CLS_CMD_DATA_REG, reg);
+	uc_cmd.dsi_info = reg;
 
 	/* Kick command */
-	__cls_cmd_start(CLS_CMD_IF_UPDATE);
+	uc_cmd.cmd_id = CLS_CMD_IF_UPDATE;
 
-	if (unlikely(!__cls_cmd_is_done())) {
-		__cls_cmd_unlock();
-		return -ETIME;
-	}
-	__cls_cmd_unlock();
+	__cls_cmd_lock();
 
-	pr_debug("CMD done successfully\n");
+	/* Execute command */
+	ret = __cls_cmd_execute(&uc_cmd);
+	if (unlikely(ret))
+		db->cls_cmd_status = ret;
 
-	return 0;
+	__cls_cmd_unlock();
+
+	return ret;
 }
 
 s32 cls_session_del(u32 id, u32 fv_sz, struct pp_hash *hash)
@@ -926,6 +983,7 @@ s32 cls_stats_get(struct cls_stats *stats)
 
 static void __cls_add_cmd_send(const struct cuckoo_hash_action *event)
 {
+	struct uc_cls_cmd uc_cmd;
 	u32 i, reg, dst_q;
 	s32 ret;
 
@@ -937,13 +995,10 @@ static void __cls_add_cmd_send(const struct cuckoo_hash_action *event)
 		return;
 	}
 
-	if (unlikely(!__cls_is_cmd_fifo_ready(CLS_ADD_CMD_SZ))) {
-		db->cls_cmd_status = -ENOMEM;
-		return;
-	}
-
 	/* Write the hash results */
-	__cls_cmd_hash_wr(event->item.h1, event->item.h2, event->item.sig);
+	uc_cmd.h1 = event->item.h1;
+	uc_cmd.h2 = event->item.h2;
+	uc_cmd.sig = event->item.sig;
 
 	/* Write the command info */
 	reg  = PP_FIELD_PREP(CLS_CMD_UPDT_SIG_ENT, 1);
@@ -951,7 +1006,7 @@ static void __cls_add_cmd_send(const struct cuckoo_hash_action *event)
 	reg |= PP_FIELD_PREP(CLS_CMD_HASH_TBL, event->new_tbl);
 	reg |= PP_FIELD_PREP(CLS_CMD_BKT_OFF, event->new_slot);
 	reg |= PP_FIELD_PREP(CLS_CMD_SESS_ID, (unsigned long)event->item.value);
-	PP_REG_WR32(PP_CLS_CMD_DATA_REG, reg);
+	uc_cmd.cmd_info = reg;
 
 	/* Write DSI info */
 	reg  = PP_FIELD_PREP(CLS_CMD_DSI_VVAL,    1);
@@ -962,23 +1017,20 @@ static void __cls_add_cmd_send(const struct cuckoo_hash_action *event)
 	reg |= PP_FIELD_PREP(CLS_CMD_DSI_DQWR,    1);
 	reg |= PP_FIELD_PREP(CLS_CMD_DSI_CNT_CLR, 1);
 	reg |= PP_FIELD_PREP(CLS_CMD_DSI_DST_Q,   dst_q);
-	PP_REG_WR32(PP_CLS_CMD_DATA_REG, reg);
+	uc_cmd.dsi_info = reg;
 
 	/* Write SI */
 	for (i = 0; i < PP_SI_WORDS_CNT; i++) {
 		pr_debug("CLS_CMD_WORD[%-2u]:  0x%X\n", i, db->cls_si_req[i]);
-		PP_REG_WR32_NO_SWAP(PP_CLS_CMD_DATA_REG, db->cls_si_req[i]);
+		uc_cmd.si[i] = db->cls_si_req[i];
 	}
 
-	/* Kick command */
-	__cls_cmd_start(CLS_CMD_IF_ADD);
-
-	if (unlikely(!__cls_cmd_is_done())) {
-		db->cls_cmd_status = -ETIME;
-		return;
-	}
+	uc_cmd.cmd_id = CLS_CMD_IF_ADD;
 
-	pr_debug("CMD done successfully\n");
+	/* Execute command */
+	ret = __cls_cmd_execute(&uc_cmd);
+	if (unlikely(ret))
+		db->cls_cmd_status = ret;
 }
 
 s32 cls_session_update(u32 id, u32 fv_sz, struct pp_hash *hash,
@@ -1039,52 +1091,47 @@ s32 cls_session_update(u32 id, u32 fv_sz, struct pp_hash *hash,
 
 static void __cls_move_cmd_send(const struct cuckoo_hash_action *event)
 {
+	struct uc_cls_cmd uc_cmd;
 	u32 reg;
+	s32 ret;
 
 	pr_debug("CLS CMD move session\n");
 
-	if (unlikely(!__cls_is_cmd_fifo_ready(CLS_UPDATE_CMD_SZ))) {
-		db->cls_cmd_status = -ENOMEM;
-		return;
-	}
-
 	/* Write the hash results */
-	__cls_cmd_hash_wr(event->item.h1, event->item.h2, event->item.sig);
+	uc_cmd.h1 = event->item.h1;
+	uc_cmd.h2 = event->item.h2;
+	uc_cmd.sig = event->item.sig;
 
 	/* Write the command info */
 	reg  = PP_FIELD_PREP(CLS_CMD_UPDT_SIG_ENT,  1);
 	reg |= PP_FIELD_PREP(CLS_CMD_HASH_TBL, event->new_tbl);
 	reg |= PP_FIELD_PREP(CLS_CMD_BKT_OFF, event->new_slot);
 	reg |= PP_FIELD_PREP(CLS_CMD_SESS_ID, (unsigned long)event->item.value);
-	PP_REG_WR32(PP_CLS_CMD_DATA_REG, reg);
+	uc_cmd.cmd_info = reg;
 
 	/* Write DSI info */
-	PP_REG_WR32(PP_CLS_CMD_DATA_REG, 0);
+	uc_cmd.dsi_info = 0;
 
-	/* Kick command */
-	__cls_cmd_start(CLS_CMD_IF_UPDATE);
-
-	if (unlikely(!__cls_cmd_is_done())) {
-		db->cls_cmd_status = -ETIME;
-		return;
-	}
+	uc_cmd.cmd_id = CLS_CMD_IF_UPDATE;
 
-	pr_debug("CMD done successfully\n");
+	/* Execute command */
+	ret = __cls_cmd_execute(&uc_cmd);
+	if (unlikely(ret))
+		db->cls_cmd_status = ret;
 }
 
 static void __cls_rmv_cmd_send(const struct cuckoo_hash_action *event)
 {
+	struct uc_cls_cmd uc_cmd;
 	u32 reg;
+	s32 ret;
 
 	pr_debug("CLS CMD remove session\n");
 
-	if (unlikely(!__cls_is_cmd_fifo_ready(CLS_DEL_CMD_SZ))) {
-		db->cls_cmd_status = -ENOMEM;
-		return;
-	}
-
 	/* Write the hash results */
-	__cls_cmd_hash_wr(event->item.h1, event->item.h2, event->item.sig);
+	uc_cmd.h1 = event->item.h1;
+	uc_cmd.h2 = event->item.h2;
+	uc_cmd.sig = event->item.sig;
 
 	pr_debug("CMD del session %lu, from tbl %hhu slot %hhu\n",
 		 (unsigned long)event->item.value, event->old_tbl,
@@ -1097,7 +1144,7 @@ static void __cls_rmv_cmd_send(const struct cuckoo_hash_action *event)
 	reg |= PP_FIELD_PREP(CLS_CMD_HASH_TBL, event->old_tbl);
 	reg |= PP_FIELD_PREP(CLS_CMD_BKT_OFF, event->old_slot);
 	reg |= PP_FIELD_PREP(CLS_CMD_SESS_ID, (unsigned long)event->item.value);
-	PP_REG_WR32(PP_CLS_CMD_DATA_REG, reg);
+	uc_cmd.cmd_info = reg;
 
 	/* Write DSI info */
 	reg  = PP_FIELD_PREP(CLS_CMD_DSI_VWR,     1);
@@ -1106,18 +1153,15 @@ static void __cls_rmv_cmd_send(const struct cuckoo_hash_action *event)
 	reg |= PP_FIELD_PREP(CLS_CMD_DSI_DWR,     1);
 	reg |= PP_FIELD_PREP(CLS_CMD_DSI_DQWR,    1);
 	reg |= PP_FIELD_PREP(CLS_CMD_DSI_CNT_CLR, 1);
-
-	PP_REG_WR32(PP_CLS_CMD_DATA_REG, reg);
+	uc_cmd.dsi_info = reg;
 
 	/* Kick command */
-	__cls_cmd_start(CLS_CMD_IF_DEL);
-
-	if (unlikely(!__cls_cmd_is_done())) {
-		db->cls_cmd_status = -ETIME;
-		return;
-	}
+	uc_cmd.cmd_id = CLS_CMD_IF_DEL;
 
-	pr_debug("CMD done successfully\n");
+	/* Execute command */
+	ret = __cls_cmd_execute(&uc_cmd);
+	if (unlikely(ret))
+		db->cls_cmd_status = ret;
 }
 
 static void __cls_cuckoo_event_handler(const struct cuckoo_hash_action *event)
diff --git a/drivers/net/ppv4/pp-hal/micro-controller/uc.c b/drivers/net/ppv4/pp-hal/micro-controller/uc.c
index 587093a069c8..6217f9bbe010 100644
--- a/drivers/net/ppv4/pp-hal/micro-controller/uc.c
+++ b/drivers/net/ppv4/pp-hal/micro-controller/uc.c
@@ -86,6 +86,11 @@ static u32 txm_cred_base;
  */
 static phys_addr_t chk_base_addr;
 
+/**
+ * @brief classifier physical base address
+ */
+static phys_addr_t cls_base_addr;
+
 /**
  * @brief checker counter cache physical base address
  */
@@ -1665,6 +1670,7 @@ s32 __uc_egr_info_set(void)
 	info.chk_base       = UC_PP_ADDR(chk_base_addr);
 	info.chk_ctrs_cache_base = UC_PP_ADDR(chk_ctrs_cache_base_addr);
 	info.chk_dsi_ddr_base = (u32)chk_dsi_phys_base_get();
+	info.cls_base       = UC_PP_ADDR(cls_base_addr);
 
 	return uc_egr_mbox_cmd_send(UC_CMD_INIT, 0, (const void *)&info,
 				    sizeof(info), NULL, 0);
@@ -1868,6 +1874,7 @@ s32 uc_init(struct uc_init_params *init_param)
 	chk_base_addr    = init_param->egr.chk_base;
 	chk_ctrs_cache_base_addr = init_param->egr.chk_ctrs_cache_base_addr;
 	rxdma_base_addr  = init_param->egr.rxdma_base;
+	cls_base_addr    = init_param->egr.cls_base;
 
 	if (init_param->egr.cpus.max_cpu) {
 		ret = __uc_egr_init(&init_param->egr);
diff --git a/drivers/net/ppv4/pp-hal/micro-controller/uc.h b/drivers/net/ppv4/pp-hal/micro-controller/uc.h
