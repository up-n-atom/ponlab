+++ b/drivers/net/ppv4/pp-hal/micro-controller/uc_common.h
@@ -13,7 +13,7 @@
  * the version here
  */
 #define EGRESS_VER_MAJOR  1
-#define EGRESS_VER_MINOR  15
+#define EGRESS_VER_MINOR  16
 
 #define INGRESS_VER_MAJOR 1
 #define INGRESS_VER_MINOR 2
@@ -75,8 +75,10 @@ enum uc_mbox_cmd_type {
 	UC_CMD_TDOX_STATS,
 	/*! Checker mailbox */
 	UC_CMD_CHK_MBX,
+	/*! Classifier mailbox */
+	UC_CMD_CLS_MBX,
 
-	UC_CMD_LAST = UC_CMD_CHK_MBX,
+	UC_CMD_LAST = UC_CMD_CLS_MBX,
 	UC_CMD_MAX  = U32_MAX,
 };
 
@@ -134,6 +136,8 @@ struct eg_uc_init_info {
 	u32 chk_ctrs_cache_base;
 	/* checker dsi ddr base */
 	u32 chk_dsi_ddr_base;
+	/* classifier base address */
