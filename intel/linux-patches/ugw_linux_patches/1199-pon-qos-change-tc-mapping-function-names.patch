From 5a81f93da975450507e625a162b64e4a1b6d02d4 Mon Sep 17 00:00:00 2001
From: Zahari Doychev <zahari.doychev@intel.com>
Date: Mon, 11 May 2020 14:50:09 +0200
Subject: [PATCH] pon_qos: change tc mapping function names

Signed-off-by: Zahari Doychev <zahari.doychev@intel.com>
---
 drivers/net/datapath/pon_qos/pon_qos_tc_flower.c |  4 ++--
 drivers/net/datapath/pon_qos/pon_qos_tc_qmap.c   | 10 ++++------
 drivers/net/datapath/pon_qos/pon_qos_tc_qmap.h   |  6 ++----
 3 files changed, 8 insertions(+), 12 deletions(-)

diff --git a/drivers/net/datapath/pon_qos/pon_qos_tc_flower.c b/drivers/net/datapath/pon_qos/pon_qos_tc_flower.c
index b76cc555fbb7..23446621ff05 100644
--- a/drivers/net/datapath/pon_qos/pon_qos_tc_flower.c
+++ b/drivers/net/datapath/pon_qos/pon_qos_tc_flower.c
@@ -80,7 +80,7 @@ static int flower_remove(struct net_device *dev,
 	case TC_TYPE_VLAN_FILTER:
 		return pon_qos_tc_vlan_filter_del(dev, arg1, arg2);
 	case TC_TYPE_QUEUE:
-		return pon_qos_tc_flower_unassign_tc(dev, arg1);
+		return pon_qos_tc_unmap(dev, arg1);
 	case TC_TYPE_MIRRED:
 		return pon_qos_mirred_unoffload(dev, f, handle);
 	default:
@@ -200,7 +200,7 @@ static int pon_qos_tc_flower_replace(struct net_device *dev,
 	case TC_TYPE_VLAN_FILTER:
 		return pon_qos_tc_vlan_filter_add(dev, f);
 	case TC_TYPE_QUEUE:
-		return pon_qos_tc_flower_assign_tc(dev, f);
+		return pon_qos_tc_map(dev, f);
 	case TC_TYPE_MIRRED:
 		return pon_qos_mirred_offload(dev, f, handle);
 	default:
diff --git a/drivers/net/datapath/pon_qos/pon_qos_tc_qmap.c b/drivers/net/datapath/pon_qos/pon_qos_tc_qmap.c
index 100d9298c900..616649ef68ca 100644
--- a/drivers/net/datapath/pon_qos/pon_qos_tc_qmap.c
+++ b/drivers/net/datapath/pon_qos/pon_qos_tc_qmap.c
@@ -105,8 +105,7 @@ static int pon_qos_parse_tc_flower(struct tc_cls_flower_offload *f,
 	return ret;
 }
 
-int pon_qos_tc_flower_assign_tc(struct net_device *dev,
-				struct tc_cls_flower_offload *f)
+int pon_qos_tc_map(struct net_device *dev, struct tc_cls_flower_offload *f)
 {
 	struct flower_cls_map *map = NULL;
 	struct net_device *indev = NULL;
@@ -156,10 +155,9 @@ int pon_qos_tc_flower_assign_tc(struct net_device *dev,
 	kfree(map);
 	return ret;
 }
-EXPORT_SYMBOL(pon_qos_tc_flower_assign_tc);
+EXPORT_SYMBOL(pon_qos_tc_map);
 
-int pon_qos_tc_flower_unassign_tc(struct net_device *dev,
-				  void *list_node)
+int pon_qos_tc_unmap(struct net_device *dev, void *list_node)
 {
 	struct flower_cls_map *map;
 	struct pon_qos_qmap_tc qmap = { 0 };
@@ -186,5 +184,5 @@ int pon_qos_tc_flower_unassign_tc(struct net_device *dev,
 
 	return 0;
 }
-EXPORT_SYMBOL(pon_qos_tc_flower_unassign_tc);
+EXPORT_SYMBOL(pon_qos_tc_unmap);
 
diff --git a/drivers/net/datapath/pon_qos/pon_qos_tc_qmap.h b/drivers/net/datapath/pon_qos/pon_qos_tc_qmap.h
index 73e237e456d4..72586ae49edc 100644
--- a/drivers/net/datapath/pon_qos/pon_qos_tc_qmap.h
+++ b/drivers/net/datapath/pon_qos/pon_qos_tc_qmap.h
@@ -7,9 +7,7 @@
 #ifndef _PON_QOS_TC_QMAP_
 #define _PON_QOS_TC_QMAP_
 
-int pon_qos_tc_flower_assign_tc(struct net_device *dev,
-				struct tc_cls_flower_offload *f);
+int pon_qos_tc_map(struct net_device *dev, struct tc_cls_flower_offload *f);
+int pon_qos_tc_unmap(struct net_device *dev, void *list_node);
 
-int pon_qos_tc_flower_unassign_tc(struct net_device *dev,
-				  void *list_node);
 #endif
