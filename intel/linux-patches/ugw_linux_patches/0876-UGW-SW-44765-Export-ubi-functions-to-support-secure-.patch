From 67c179d27a918476900c83a3a7cbf3660ec98d79 Mon Sep 17 00:00:00 2001
From: pungavan <ramesh.pungavanam@intel.com>
Date: Thu, 5 Dec 2019 00:13:49 +0530
Subject: [PATCH] UGW_SW-44765 Export ubi functions to support secure storage

---
 drivers/char/ltq_icc/drv_icc.c   | 2 +-
 drivers/mtd/ubi/build.c          | 2 ++
 drivers/mtd/ubi/eba.c            | 1 +
 drivers/mtd/ubi/misc.c           | 3 +++
 drivers/mtd/ubi/upd.c            | 2 ++
 drivers/mtd/ubi/vmt.c            | 1 +
 include/uapi/linux/icc/drv_icc.h | 5 +++--
 7 files changed, 13 insertions(+), 3 deletions(-)

diff --git a/drivers/char/ltq_icc/drv_icc.c b/drivers/char/ltq_icc/drv_icc.c
index 6bccaffcce03..719d2da8e194 100644
--- a/drivers/char/ltq_icc/drv_icc.c
+++ b/drivers/char/ltq_icc/drv_icc.c
@@ -386,7 +386,7 @@ long icc_ioctl (struct file *file_p,uint32_t nCmd, unsigned long arg){
 		 			iccdev[num].Installed=1;
 #if defined(CONFIG_SOC_GRX500_BOOTCORE) || defined(CONFIG_SOC_PRX300_BOOTCORE)
 					/*Intimate to IAP that bootcore is ready if sec services gets registered*/
-					if(num == SEC_STORE_SERVICE)
+					if(num == SEC_SERVICE)
 					{
 						mps_message Mpsmsg;
 
diff --git a/drivers/mtd/ubi/build.c b/drivers/mtd/ubi/build.c
index 211ee13d36ed..7ef515c2eba4 100644
--- a/drivers/mtd/ubi/build.c
+++ b/drivers/mtd/ubi/build.c
@@ -276,6 +276,7 @@ struct ubi_device *ubi_get_device(int ubi_num)
 
 	return ubi;
 }
+EXPORT_SYMBOL_GPL(ubi_get_device);
 
 /**
  * ubi_put_device - drop an UBI device reference.
@@ -288,6 +289,7 @@ void ubi_put_device(struct ubi_device *ubi)
 	put_device(&ubi->dev);
 	spin_unlock(&ubi_devices_lock);
 }
+EXPORT_SYMBOL_GPL(ubi_put_device);
 
 /**
  * ubi_get_by_major - get UBI device by character device major number.
diff --git a/drivers/mtd/ubi/eba.c b/drivers/mtd/ubi/eba.c
index d0884bd9d955..dd6e1cdd5ec1 100644
--- a/drivers/mtd/ubi/eba.c
+++ b/drivers/mtd/ubi/eba.c
@@ -722,6 +722,7 @@ int ubi_eba_read_leb(struct ubi_device *ubi, struct ubi_volume *vol, int lnum,
 	leb_read_unlock(ubi, vol_id, lnum);
 	return err;
 }
+EXPORT_SYMBOL_GPL(ubi_eba_read_leb);
 
 /**
  * ubi_eba_read_leb_sg - read data into a scatter gather list.
diff --git a/drivers/mtd/ubi/misc.c b/drivers/mtd/ubi/misc.c
index 989036c681b8..c95bfbf54ee6 100644
--- a/drivers/mtd/ubi/misc.c
+++ b/drivers/mtd/ubi/misc.c
@@ -92,6 +92,7 @@ int ubi_check_volume(struct ubi_device *ubi, int vol_id)
 	vfree(buf);
 	return err;
 }
+EXPORT_SYMBOL_GPL(ubi_check_volume);
 
 /**
  * ubi_update_reserved - update bad eraseblock handling accounting data.
@@ -186,6 +187,7 @@ void ubi_warn(const struct ubi_device *ubi, const char *fmt, ...)
 
 	va_end(args);
 }
+EXPORT_SYMBOL_GPL(ubi_warn);
 
 /* UBI error messages */
 void ubi_err(const struct ubi_device *ubi, const char *fmt, ...)
@@ -202,3 +204,4 @@ void ubi_err(const struct ubi_device *ubi, const char *fmt, ...)
 	       ubi->ubi_num, __builtin_return_address(0), &vaf);
 	va_end(args);
 }
+EXPORT_SYMBOL_GPL(ubi_err);
diff --git a/drivers/mtd/ubi/upd.c b/drivers/mtd/ubi/upd.c
index 39712560b4c1..9c4b93091812 100644
--- a/drivers/mtd/ubi/upd.c
+++ b/drivers/mtd/ubi/upd.c
@@ -168,6 +168,7 @@ int ubi_start_update(struct ubi_device *ubi, struct ubi_volume *vol,
 	vol->upd_received = 0;
 	return 0;
 }
+EXPORT_SYMBOL_GPL(ubi_start_update);
 
 /**
  * ubi_start_leb_change - start atomic LEB change.
@@ -375,6 +376,7 @@ int ubi_more_update_data(struct ubi_device *ubi, struct ubi_volume *vol,
 
 	return err;
 }
+EXPORT_SYMBOL_GPL(ubi_more_update_data);
 
 /**
  * ubi_more_leb_change_data - accept more data for atomic LEB change.
diff --git a/drivers/mtd/ubi/vmt.c b/drivers/mtd/ubi/vmt.c
index 1bcb25bc35ef..1d25702e5fae 100644
--- a/drivers/mtd/ubi/vmt.c
+++ b/drivers/mtd/ubi/vmt.c
@@ -348,6 +348,7 @@ int ubi_create_volume(struct ubi_device *ubi, struct ubi_mkvol_req *req)
 	ubi_err(ubi, "cannot create volume %d, error %d", vol_id, err);
 	return err;
 }
+EXPORT_SYMBOL_GPL(ubi_create_volume);
 
 /**
  * ubi_remove_volume - remove volume.
diff --git a/include/uapi/linux/icc/drv_icc.h b/include/uapi/linux/icc/drv_icc.h
index 9b8d7d4e3d34..6679227b037c 100644
--- a/include/uapi/linux/icc/drv_icc.h
+++ b/include/uapi/linux/icc/drv_icc.h
@@ -24,7 +24,7 @@
 #define MIN_THRESHOLD 4
 #define MAX_THRESHOLD 12
 #define ICC_MSG_FLOW_CONTROL 0x1
-#define SEC_STORE_ID 0x3
+#define SEC_SERVICE_ID 0x3
 
 
 /*DebugInfo*/
@@ -65,7 +65,8 @@ typedef enum
 	 SR,/*System reset driver*/
 	 IR,/*Ioctl redirector*/
 	 PR,/*procfs redirector*/
-	 SEC_STORE_SERVICE = 10, /*Secure store service */
+	 SEC_SERVICE = 10, /*Secure service */
+	 SEC_STORAGE = 11, /*Secure storage service */
    MAX_CLIENT=21/*MAX_CLIENT_ID*/
 } icc_devices;/*enum for all the possible clients*/
 /******************************************************************************
