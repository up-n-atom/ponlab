From 03245c2fdfa486210f6a28f3390316ef1d8f4924 Mon Sep 17 00:00:00 2001
From: Cardoso Tiago <tiago.cardoso.abrahao@intel.com>
Date: Thu, 12 Mar 2020 17:18:44 +0100
Subject: [PATCH] PONRTSYS-6905 Hotfixes for bugs found by fuzz testing

Aditional out-of-bounds checks
---
 drivers/net/ethernet/lantiq/switch-api/gsw_debug.c |  52 ++-
 .../net/ethernet/lantiq/switch-api/gsw_flow_core.c | 384 +++++++++++++++++----
 2 files changed, 370 insertions(+), 66 deletions(-)

diff --git a/drivers/net/ethernet/lantiq/switch-api/gsw_debug.c b/drivers/net/ethernet/lantiq/switch-api/gsw_debug.c
index ff03a24a3b5c..23542b52f4bf 100644
--- a/drivers/net/ethernet/lantiq/switch-api/gsw_debug.c
+++ b/drivers/net/ethernet/lantiq/switch-api/gsw_debug.c
@@ -38,8 +38,8 @@ GSW_return_t GSW_Debug_RMON_Port_Get(void *cdev, GSW_Debug_RMON_Port_cnt_t *parm
 		return GSW_statusErr;
 	}
 
-	Portmode = parm->ePortType;
-	PortId = parm->nPortId;
+	Portmode = (u32)parm->ePortType;
+	PortId = (u32)parm->nPortId;
 	/*Clear the structure before using*/
 	memset(parm, 0, sizeof(GSW_Debug_RMON_Port_cnt_t));
 
@@ -349,6 +349,12 @@ GSW_return_t GSW_Debug_GetCtpStatistics(void *cdev, GSW_debug_t *parm)
 		return GSW_statusErr;
 	}
 
+	ctpidx = parm->nTableIndex;
+	if (ctpidx >= ARRAY_SIZE(gswdev->ctpportconfig_idx)) {
+		printk("ERROR: Ctp Port Index out of bounds!\n");
+		return GSW_statusErr;
+	}
+
 	memset(&Assign_get, 0x00, sizeof(Assign_get));
 	memset(&CTP_get, 0x00, sizeof(CTP_get));
 	memset(&BP_get, 0x00, sizeof(BP_get));
@@ -356,9 +362,8 @@ GSW_return_t GSW_Debug_GetCtpStatistics(void *cdev, GSW_debug_t *parm)
 	memset(&Pmac_Count, 0x00, sizeof(Pmac_Count));
 	memset(&Rmon_get, 0x00, sizeof(Rmon_get));
 
-
 	printk("\n");
-	ctpidx = parm->nTableIndex;
+
 	lp = gswdev->ctpportconfig_idx[ctpidx].AssociatedLogicalPort;
 
 	if (!gswdev->ctpportconfig_idx[ctpidx].IndexInUse) {
@@ -709,6 +714,10 @@ GSW_return_t GSW_Debug_CtpTableStatus(void *cdev, GSW_debug_t *parm)
 
 		return GSW_statusOk;
 	}
+	if (parm->nTableIndex >= ARRAY_SIZE(gswdev->ctpportconfig_idx)) {
+		pr_err("%s:%s:%d nTableIndex out of bounds!", __FILE__, __func__, __LINE__);
+		return GSW_statusErr;
+	}
 
 	if (parm->nForceSet) {
 		gswdev->ctpportconfig_idx[parm->nTableIndex].IndexInUse = 1;
@@ -770,6 +779,10 @@ GSW_return_t GSW_Debug_BrgPortTableStatus(void *cdev, GSW_debug_t *parm)
 
 		return GSW_statusOk;
 	}
+	if (parm->nTableIndex >= ARRAY_SIZE(gswdev->brdgeportconfig_idx)) {
+		pr_err("%s:%s:%d nTableIndex out of bounds!", __FILE__, __func__, __LINE__);
+		return GSW_statusErr;
+	}
 
 	if (parm->nForceSet) {
 		gswdev->brdgeportconfig_idx[parm->nTableIndex].IndexInUse = 1;
@@ -826,11 +839,15 @@ GSW_return_t GSW_Debug_BrgTableStatus(void *cdev, GSW_debug_t *parm)
 		pr_err("%s:%s:%d", __FILE__, __func__, __LINE__);
 		return GSW_statusErr;
 	}
+	if (parm->nTableIndex >= ARRAY_SIZE(gswdev->brdgeconfig_idx)) {
+		pr_err("%s:%s:%d nTableIndex out of bounds!", __FILE__, __func__, __LINE__);
+		return GSW_statusErr;
+	}
 
 	printk("\n");
 
 	if (parm->nCheckIndexInUse) {
-		for (j = 0; j < gswdev->num_of_bridge_port; j++) {
+		for (j = 0; j < gswdev->num_of_bridge; j++) {
 			if (gswdev->brdgeconfig_idx[j].IndexInUse) {
 				printk("Bridge  %d	= InUse.\n", j);
 			}
@@ -883,6 +900,10 @@ GSW_return_t GSW_Debug_ExvlanTableStatus(void *cdev, GSW_debug_t *parm)
 
 		return GSW_statusOk;
 	}
+	if (parm->nTableIndex >= ARRAY_SIZE(gswdev->extendvlan_idx.vlan_idx)) {
+		pr_err("%s:%s:%d nTableIndex out of bounds!", __FILE__, __func__, __LINE__);
+		return GSW_statusErr;
+	}
 
 	if (parm->nForceSet) {
 		gswdev->extendvlan_idx.vlan_idx[parm->nTableIndex].IndexInUse = 1;
@@ -926,6 +947,10 @@ GSW_return_t GSW_Debug_VlanFilterTableStatus(void *cdev, GSW_debug_t *parm)
 
 		return GSW_statusOk;
 	}
+	if (parm->nTableIndex >= ARRAY_SIZE(gswdev->vlanfilter_idx.filter_idx)) {
+		pr_err("%s:%s:%d nTableIndex out of bounds!", __FILE__, __func__, __LINE__);
+		return GSW_statusErr;
+	}
 
 	if (parm->nForceSet) {
 		gswdev->vlanfilter_idx.filter_idx[parm->nTableIndex].IndexInUse = 1;
@@ -957,6 +982,10 @@ GSW_return_t GSW_Debug_MeterTableStatus(void *cdev, GSW_debug_t *parm)
 		pr_err("%s:%s:%d", __FILE__, __func__, __LINE__);
 		return GSW_statusErr;
 	}
+	if (parm->nTableIndex >= ARRAY_SIZE(gswdev->meter_idx)) {
+		pr_err("%s:%s:%d nTableIndex out of bounds!", __FILE__, __func__, __LINE__);
+		return GSW_statusErr;
+	}
 
 	printk("\n");
 
@@ -991,6 +1020,10 @@ GSW_return_t GSW_Debug_Dscp2PcpTableStatus(void *cdev, GSW_debug_t *parm)
 		pr_err("%s:%s:%d", __FILE__, __func__, __LINE__);
 		return GSW_statusErr;
 	}
+	if (parm->nTableIndex >= ARRAY_SIZE(gswdev->dscp2pcp_idx)) { 
+		pr_err("%s:%s:%d nTableIndex out of bounds!", __FILE__, __func__, __LINE__);
+		return GSW_statusErr;
+	}
 
 	printk("\n");
 
@@ -1028,6 +1061,11 @@ GSW_return_t GSW_Debug_PmapperTableStatus(void *cdev, GSW_debug_t *parm)
 		return GSW_statusOk;
 	}
 
+	if (parm->nTableIndex >= ARRAY_SIZE(gswdev->pmapper_idx)) {
+		pr_err("%s:%s:%d nTableIndex out of bounds!", __FILE__, __func__, __LINE__);
+		return GSW_statusErr;
+	}
+
 	if (parm->nForceSet) {
 		gswdev->pmapper_idx[parm->nTableIndex].IndexInUse = 1;
 		printk("P-Mapper Table Index  %d is Forced to InUSe\n", parm->nTableIndex);
@@ -1213,6 +1251,10 @@ GSW_return_t GSW_Debug_PceRuleTableStatus(void *cdev, GSW_debug_t *parm)
 
 		return GSW_statusOk;
 	}
+	if (parm->nTableIndex >= ARRAY_SIZE(gswdev->tflow_idx.flow_idx)) {
+		pr_err("%s:%s:%d nTableIndex out of bounds!", __FILE__, __func__, __LINE__);
+		return GSW_statusErr;
+	}
 
 	if (parm->nForceSet) {
 		gswdev->tflow_idx.flow_idx[parm->nTableIndex].indexinuse = 1;
diff --git a/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c b/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c
index 0084f097a39d..ab533e92b711 100644
--- a/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c
+++ b/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c
@@ -2192,6 +2192,8 @@ static u32 mratecalc(u32 ibsid, u32 expont, u32 mants)
 
 	if ((ibsid == 0) && (expont == 0) && (mants == 0))
 		return 0;
+	if (ibsid >= ARRAY_SIZE(ibs_table))
+		return 0;
 
 	ibs = ibs_table[ibsid];
 
@@ -3567,12 +3569,14 @@ GSW_return_t GSW_MAC_TableEntryAdd(void *cdev,
 	spin_lock_bh(&gswdev->lock_pce);
 #endif
 
-	if (gswdev->gipver == LTQ_GSWIP_3_0) {
-		if ((parm->nPortId >= gswdev->tpnum) &&
-		    (!(parm->nPortId & 0x80000000))) {
-			ret = GSW_statusErr;
-			goto UNLOCK_AND_RETURN;
-		}
+	if ((IS_VRSN_NOT_31(gswdev->gipver)
+	     && parm->nPortId >= gswdev->tpnum
+	     && !(parm->nPortId & 0x80000000))
+	    || (IS_VRSN_31(gswdev->gipver)
+		&& parm->nPortId >= gswdev->num_of_bridge_port
+		&& !(parm->nPortId & 0x80000000))) {
+		ret = GSW_statusErr;
+		goto UNLOCK_AND_RETURN;
 	}
 
 	memset(&tbl_prog, 0, sizeof(pctbl_prog_t));
@@ -3637,7 +3641,8 @@ GSW_return_t GSW_MAC_TableEntryAdd(void *cdev,
 
 				i = parm->nPortId / (sizeof(tbl_prog.val[0]) * 8);
 				j = parm->nPortId & (sizeof(tbl_prog.val[0]) * 8 - 1);
-				tbl_prog.val[i + 2] = 1 << j;
+				if ((i + 2) < ARRAY_SIZE(tbl_prog.val))
+					tbl_prog.val[i + 2] = 1 << j;
 			}
 		} else {
 			if (parm->nPortId & 0x80000000) { /*Port Map 3.0 */
@@ -4066,11 +4071,9 @@ GSW_return_t GSW_PortCfgGet(void *cdev, GSW_portCfg_t *parm)
 	spin_lock_bh(&gswdev->lock_misc);
 #endif
 
-	if (IS_VRSN_NOT_31(gswdev->gipver)) {
-		if (parm->nPortId >= gswdev->tpnum) {
-			ret = GSW_statusErr;
-			goto UNLOCK_AND_RETURN;
-		}
+	if (pidx >= gswdev->tpnum) {
+		ret = GSW_statusErr;
+		goto UNLOCK_AND_RETURN;
 	}
 
 	/* See if PORT enable or not */
@@ -4304,12 +4307,13 @@ GSW_return_t GSW_PortCfgSet(void *cdev, GSW_portCfg_t *parm)
 	spin_lock_bh(&gswdev->lock_misc);
 #endif
 
-	if (IS_VRSN_NOT_31(gswdev->gipver)) {
-		if (parm->nPortId >= gswdev->tpnum) {
-			ret = GSW_statusErr;
-			goto UNLOCK_AND_RETURN;
-		}
+	if (pidx >= gswdev->tpnum
+	    || pidx >= ARRAY_SIZE(gswdev->pconfig)) {
+		ret = GSW_statusErr;
+		goto UNLOCK_AND_RETURN;
+	}
 
+	if (VRSN_CMP(gswdev->gipver, LTQ_GSWIP_3_0) <= 0) {
 		/* Port locking flag  */
 		gsw_w32(cdev, (PCE_PCTRL_0_PLOCK_OFFSET + (0xA * pidx)),
 			PCE_PCTRL_0_PLOCK_SHIFT,
@@ -17199,6 +17203,7 @@ GSW_return_t GSW_8021X_EAPOL_RuleSet(void *cdev, GSW_8021X_EAPOL_Rule_t *parm)
 	ethsw_api_dev_t *gswdev = GSW_PDATA_GET(cdev);
 	stp8021x_t *scfg = &gswdev->stpconfig;
 	static GSW_PCE_rule_t pcrule;
+	u32 fsize, msize;
 	u32 ret;
 
 	if (gswdev == NULL) {
@@ -17233,9 +17238,20 @@ GSW_return_t GSW_8021X_EAPOL_RuleSet(void *cdev, GSW_8021X_EAPOL_Rule_t *parm)
 		pr_err("(Incorrect forward port action) %s:%s:%d\n",
 		       __FILE__, __func__, __LINE__);
 
-	/*TODO*/
-	//Govind - Can occur out of array bounds problem.
-	pcrule.action.nForwardPortMap[0] = (1 << parm->nForwardPortId);
+	fsize = sizeof(pcrule.action.nForwardPortMap[0]) * 8;
+	msize = sizeof(pcrule.action.nForwardPortMap) * 8;
+	if (VRSN_CMP(gswdev->gipver, LTQ_GSWIP_3_0) <= 0) {
+		if (parm->nForwardPortId < gswdev->tpnum
+		    && parm->nForwardPortId < fsize)
+			pcrule.action.nForwardPortMap[0] = BIT(parm->nForwardPortId);
+	} else if (parm->nForwardPortId < gswdev->num_of_bridge_port
+		   && parm->nForwardPortId < msize) {
+		u32 i, j;
+
+		i = parm->nForwardPortId / fsize;
+		j = parm->nForwardPortId % fsize;
+		pcrule.action.nForwardPortMap[i] = BIT(j);
+	}
 
 	/* We prepare everything and write into PCE Table */
 	if (0 != pce_rule_write(cdev, &gswdev->phandler, &pcrule)) {
@@ -18540,6 +18556,11 @@ GSW_return_t GSW_CTP_PortAssignmentAlloc(void *cdev, GSW_CTP_portAssignment_t *p
 		pr_err("%s:%s:%d", __FILE__, __func__, __LINE__);
 		return GSW_statusErr;
 	}
+	if (parm->nBridgePortId >= ARRAY_SIZE(gswdev->brdgeportconfig_idx)) {
+		pr_err("%s:%s:%d nBridgePortId out of bounds!", __FILE__, __func__, __LINE__);
+		return GSW_statusErr;
+	}
+
 
 #ifdef __KERNEL__
 	spin_lock_bh(&gswdev->lock_ctp_map);
@@ -19463,6 +19484,10 @@ GSW_return_t GSW_QOS_PmapperTableGet(void *cdev, GSW_PMAPPER_t *parm)
 		pr_err("%s:%s:%d", __FILE__, __func__, __LINE__);
 		return GSW_statusErr;
 	}
+	if (parm->nPmapperId >= ARRAY_SIZE(gswdev->pmapper_idx)) {
+		pr_err("%s:%s:%d nPmapperId out of bounds!", __FILE__, __func__, __LINE__);
+		return GSW_statusErr;
+	}
 
 	/*If P-Mapper ID is valid,Check whether it is InUSE
 	  if not InUse,return ERROR*/
@@ -19536,7 +19561,10 @@ static u8 GSW_SearchExVlanContiguousBlock(ethsw_api_dev_t *gswdev, u32 BlockId,
 {
 	u32 i;
 
-	for (i = BlockId; i <= (BlockId + NumberOfEntries); i++) {
+	if (BlockId + NumberOfEntries >= ARRAY_SIZE(gswdev->extendvlan_idx.vlan_idx))
+		return 0;
+
+	for (i = BlockId; i < (BlockId + NumberOfEntries); i++) {
 		if (gswdev->extendvlan_idx.vlan_idx[i].IndexInUse)
 			return 0;
 	}
@@ -20231,6 +20259,11 @@ GSW_return_t GSW_ExtendedVlanSet(void *cdev, GSW_EXTENDEDVLAN_config_t *parm)
 	*/
 	if (parm->sTreatment.bNewMeterEnable) {
 		meterid = parm->sTreatment.sNewTrafficMeterId;
+		if (meterid >= ARRAY_SIZE(gswdev->meter_idx)) {
+			pr_err("ERROR :Meter Id %d out of bounds!", meterid);
+			ret = GSW_statusErr;
+			goto UNLOCK_AND_RETURN;
+		}
 		/*This below field enable indicates that this meter id is
 		 already assigned and it's idx recorded for this Exvlan tbl.
 		 If next time the user update this meter field with different meter idx !!
@@ -20370,6 +20403,11 @@ GSW_return_t GSW_ExtendedVlanSet(void *cdev, GSW_EXTENDEDVLAN_config_t *parm)
 		 so the previous dscp2pcp pointer must be released from this
 		 Extended VLAN idx*/
 		idx = parm->nExtendedVlanBlockId + parm->nEntryIndex;
+		if (idx >= ARRAY_SIZE(gswdev->extendvlan_idx.vlan_idx)) {
+			pr_err("ERROR :vlan idx %d out of bounds!", idx);
+			ret = GSW_statusErr;
+			goto UNLOCK_AND_RETURN;
+		}
 
 		if (gswdev->extendvlan_idx.vlan_idx[idx].Dscp2PcpPointerAssigned) {
 			int old_dscp2pcp_pointer;
@@ -21036,7 +21074,10 @@ static u8 GSW_SearchVlanFilterContiguousBlock(ethsw_api_dev_t *gswdev, u32 Block
 {
 	u32 i;
 
-	for (i = BlockId; i <= (BlockId + NumberOfEntries); i++) {
+	if (BlockId + NumberOfEntries >= ARRAY_SIZE(gswdev->vlanfilter_idx.filter_idx))
+		return 0;
+
+	for (i = BlockId; i < (BlockId + NumberOfEntries); i++) {
 		if (gswdev->vlanfilter_idx.filter_idx[i].IndexInUse)
 			return 0;
 	}
@@ -21078,6 +21119,12 @@ GSW_return_t GSW_VlanFilterAlloc(void *cdev, GSW_VLANFILTER_alloc_t *param)
 
 		/*Contiguous block found in the table*/
 		if (ContiguousBlockFound) {
+			if (VlanFilterIndex + param->nNumberOfEntries >=
+				ARRAY_SIZE(gswdev->vlanfilter_idx.filter_idx)) {
+				ret = GSW_statusErr;
+				goto UNLOCK_AND_RETURN;
+			}
+
 			param->nVlanFilterBlockId = VlanFilterIndex;
 
 			/*Mark the contiguous table indexes as InUse and tag it with block id*/
@@ -21487,6 +21534,11 @@ GSW_return_t GSW_BridgeConfigSet(void *cdev, GSW_BRIDGE_config_t *param)
 		/*GSW_BRIDGE_PORT_EGRESS_METER_BROADCAST*/
 		if (param->bSubMeteringEnable[0]) {
 			meterid = param->nTrafficSubMeterId[0];
+			if (meterid >= ARRAY_SIZE(gswdev->meter_idx)) {
+				pr_err("ERROR: meterid out of bounds! meterid=%d]\n", meterid);
+				ret = GSW_statusErr;
+				goto UNLOCK_AND_RETURN;
+			}
 
 			/*This below field enable indicates that this meter id is
 			 already assigned and it's idx recorded for this Bridge Port id.
@@ -21539,6 +21591,11 @@ GSW_return_t GSW_BridgeConfigSet(void *cdev, GSW_BRIDGE_config_t *param)
 		/*GSW_BRIDGE_PORT_EGRESS_METER_MULTICAST*/
 		if (param->bSubMeteringEnable[1]) {
 			meterid = param->nTrafficSubMeterId[1];
+			if (meterid >= ARRAY_SIZE(gswdev->meter_idx)) {
+				pr_err("ERROR :Meter Id %d out of bounds!", meterid);
+				ret = GSW_statusErr;
+				goto UNLOCK_AND_RETURN;
+			}
 
 			/*This below field enable indicates that this meter id is
 			 already assigned and it's idx recorded for this Bridge Port id.
@@ -21591,6 +21648,11 @@ GSW_return_t GSW_BridgeConfigSet(void *cdev, GSW_BRIDGE_config_t *param)
 		/*GSW_BRIDGE_PORT_EGRESS_METER_UNKNOWN_MC_IP*/
 		if (param->bSubMeteringEnable[2]) {
 			meterid = param->nTrafficSubMeterId[2];
+			if (meterid >= ARRAY_SIZE(gswdev->meter_idx)) {
+				pr_err("ERROR :Meter Id %d out of bounds!", meterid);
+				ret = GSW_statusErr;
+				goto UNLOCK_AND_RETURN;
+			}
 
 			/*This below field enable indicates that this meter id is
 			 already assigned and it's idx recorded for this Bridge Port id.
@@ -21602,6 +21664,11 @@ GSW_return_t GSW_BridgeConfigSet(void *cdev, GSW_BRIDGE_config_t *param)
 					if (gswdev->brdgeconfig_idx[param->nBridgeId].UnknownMultiIpMeteringId !=
 					    meterid) {
 						idx = gswdev->brdgeconfig_idx[param->nBridgeId].UnknownMultiIpMeteringId;
+						if (idx >= ARRAY_SIZE(gswdev->meter_idx)) {
+							pr_err("ERROR :idx for meter_idx %d out of bounds!", idx);
+							ret = GSW_statusErr;
+							goto UNLOCK_AND_RETURN;
+						}
 						/*release the usage of previous meter idx*/
 						gswdev->meter_idx[idx].IndexInUsageCnt--;
 						gswdev->brdgeconfig_idx[param->nBridgeId].UnknownMultiIpMeteringAssigned = 0;
@@ -21642,6 +21709,11 @@ GSW_return_t GSW_BridgeConfigSet(void *cdev, GSW_BRIDGE_config_t *param)
 		/*GSW_BRIDGE_PORT_EGRESS_METER_UNKNOWN_MC_NON_IP*/
 		if (param->bSubMeteringEnable[3]) {
 			meterid = param->nTrafficSubMeterId[3];
+			if (meterid >= ARRAY_SIZE(gswdev->meter_idx)) {
+				pr_err("ERROR :Meter Id %d out of bounds!", meterid);
+				ret = GSW_statusErr;
+				goto UNLOCK_AND_RETURN;
+			}
 
 			/*This below field enable indicates that this meter id is
 			 already assigned and it's idx recorded for this Bridge Port id.
@@ -21694,6 +21766,11 @@ GSW_return_t GSW_BridgeConfigSet(void *cdev, GSW_BRIDGE_config_t *param)
 		/*GSW_BRIDGE_PORT_EGRESS_METER_UNKNOWN_UC*/
 		if (param->bSubMeteringEnable[4]) {
 			meterid = param->nTrafficSubMeterId[4];
+			if (meterid >= ARRAY_SIZE(gswdev->meter_idx)) {
+				pr_err("ERROR :Meter Id %d out of bounds!", meterid);
+				ret = GSW_statusErr;
+				goto UNLOCK_AND_RETURN;
+			}
 
 			/*This below field enable indicates that this meter id is
 			 already assigned and it's idx recorded for this Bridge Port id.
@@ -22375,6 +22452,11 @@ GSW_return_t GSW_BridgePortConfigSet(void *cdev, GSW_BRIDGE_portConfig_t *param)
 				if (gswdev->brdgeportconfig_idx[param->nBridgePortId].BrdgId !=
 				    param->nBridgeId) {
 					idx = gswdev->brdgeportconfig_idx[param->nBridgePortId].BrdgId;
+					if (idx >= ARRAY_SIZE(gswdev->brdgeconfig_idx)) {
+						pr_err("ERROR :idx for brdgeconfig_idx %d out of bounds!", idx);
+						ret = GSW_statusErr;
+						goto UNLOCK_AND_RETURN;
