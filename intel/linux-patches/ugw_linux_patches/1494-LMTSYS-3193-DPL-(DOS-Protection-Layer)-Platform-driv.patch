+static void __chk_map_set(u16 port, u8 tc, u8 hoh, u8 id)
 {
 	unsigned long mapping_base_addr;
 	u32 mapping_val;
 
 	pr_debug("port %u. tc %u. hoh %u. id %u\n", port, tc, hoh, id);
 
+	mapping_base_addr = CHK_ALT_SI_MAP_RAM(port, tc);
