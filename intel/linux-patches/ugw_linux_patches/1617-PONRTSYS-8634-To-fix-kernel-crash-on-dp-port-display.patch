From 7d9c98b54b775f982bf6ef9ffa3afac97f569a51 Mon Sep 17 00:00:00 2001
From: Rekha Eswaran <rekha.eswaran@intel.com>
Date: Mon, 1 Mar 2021 20:51:54 +0800
Subject: [PATCH] PONRTSYS-8634 - To fix kernel crash on dp port display

---
 drivers/net/datapath/dpm/datapath_proc.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/drivers/net/datapath/dpm/datapath_proc.c b/drivers/net/datapath/dpm/datapath_proc.c
index 1aa289a7882a..253fd6bcff84 100644
--- a/drivers/net/datapath/dpm/datapath_proc.c
+++ b/drivers/net/datapath/dpm/datapath_proc.c
@@ -815,7 +815,7 @@ int proc_port_dump(struct seq_file *s, int pos)
 
 	if (!seq_has_overflowed(s))
 		pos++;
-	if (pos >= MAX_DP_PORTS || dump_one_port) {
+	if (pos >= info->cap.max_num_dp_ports || dump_one_port) {
 		tmp_inst++;
 		pos = 0;
 	}
@@ -993,7 +993,7 @@ ssize_t proc_port_write(struct file *file, const char *buf, size_t count,
 
 	if (param_list[1]) {
 		idx_s = dp_atoi(param_list[1]);
-		if (idx_s >= MAX_DP_PORTS) {
+		if (idx_s >= info->cap.max_num_dp_ports) {
 			pr_err("invalid port index, expect 0 ~ %d\n",
 			       info->cap.max_num_dp_ports - 1);
 			return count;
