From c3288f8448fce662443792a1f48d6bdcaa8a4643 Mon Sep 17 00:00:00 2001
From: Lishan Liu <lishan.liu@intel.com>
Date: Wed, 19 May 2021 17:40:08 +0800
Subject: [PATCH] DRVLIB_SW-4161: PRX CQM support policy for streaming port

---
 drivers/net/datapath/dpm/gswip31/datapath_misc.c | 2 --
 drivers/net/ethernet/lantiq/cqm/prx300/cqm.c     | 5 +++++
 include/net/lantiq_cbm_api.h                     | 5 +++++
 3 files changed, 10 insertions(+), 2 deletions(-)

diff --git a/drivers/net/datapath/dpm/gswip31/datapath_misc.c b/drivers/net/datapath/dpm/gswip31/datapath_misc.c
index 02eb6666571c..bff02040de50 100644
--- a/drivers/net/datapath/dpm/gswip31/datapath_misc.c
+++ b/drivers/net/datapath/dpm/gswip31/datapath_misc.c
@@ -1244,12 +1244,10 @@ int dp_platform_queue_set(int inst, u32 flag)
 		return DP_FAILURE;
 	}
 
-#if IS_ENABLED(CONFIG_INTEL_DATAPATH_HAL_GSWIP32)
 	cpu_port->rx_policy_base = cpu_data.policy_base[0][0];
 	cpu_port->rx_policy_num = cpu_data.policy_num[0][0];
 	cpu_port->tx_policy_base = cpu_data.policy_base[0][0];
 	cpu_port->tx_policy_num = cpu_data.policy_num[0][0];
-#endif
 
 	if (is_soc_lgm(inst)) {
 		dev_platform_set(inst, CPU_PORT, NULL, 0);
diff --git a/drivers/net/ethernet/lantiq/cqm/prx300/cqm.c b/drivers/net/ethernet/lantiq/cqm/prx300/cqm.c
index 44c0653ea74e..3ce3fe68fec8 100644
--- a/drivers/net/ethernet/lantiq/cqm/prx300/cqm.c
+++ b/drivers/net/ethernet/lantiq/cqm/prx300/cqm.c
@@ -1972,6 +1972,8 @@ s32 cqm_cpu_port_get(struct cbm_cpu_port_data *data, u32 flags)
 
 	for (i = 0; i < CQM_MAX_CPU; i++) {
 		type = dqm_port_info[i].cpu_port_type;
+		data->policy_num[i][0] = cqm_ctrl->num_pools;
+		data->policy_base[i][0] = 0;
 		if (!((dqm_port_info[i].valid) && IS_CPU_PORT_TYPE(type))) {
 			data->dq_tx_push_info[i].deq_port = -1;
 			continue;
@@ -2598,6 +2600,7 @@ static int fill_rx_ring_data(struct cbm_dp_alloc_complete_data *dp_data)
 				dp_data->rx_ring[ring_idx]->prefill_pkt_num;
 		/* Need to be disccused and modified later base on policy */
 		dp_data->rx_ring[ring_idx]->rx_policy_base = 0;
+		dp_data->rx_ring[ring_idx]->policy_num = 1;
 		p_info->dma_ch_in_use = true;
 		ret = CBM_SUCCESS;
 	}
@@ -2718,6 +2721,8 @@ static s32 dp_port_alloc_complete(struct module *owner, struct net_device *dev,
 		       | data->qid_base);
 		cbm_w32(cqm_ctrl->enq + EPON_EPON_MODE_REG, reg);
 	}
+	data->tx_policy_base = 0;
+	data->tx_policy_num = cqm_ctrl->num_pools;
 
 	dev_dbg(cqm_ctrl->dev, "%s: exit\n", __func__);
 	return CBM_SUCCESS;
diff --git a/include/net/lantiq_cbm_api.h b/include/net/lantiq_cbm_api.h
index 83899cb5c448..f5979e5b029e 100644
--- a/include/net/lantiq_cbm_api.h
+++ b/include/net/lantiq_cbm_api.h
@@ -191,6 +191,7 @@
 #define CBM_Q_F_RESTORE_ONLY 0x00000002
 
 #define CQM_MAX_CPU 4
+#define PORTS_PER_CPU 1
 
 #define CBM_PORT_DP_SET			BIT(0)
 #define CBM_PORT_DQ_SET			BIT(1)
@@ -396,6 +397,8 @@ struct cbm_cpu_port_data {
 	struct cbm_tx_push dq_tx_flush_info;
 	/** output: deq_port = -1 means not valid*/
 	struct cbm_tx_push dq_tx_push_info[CQM_MAX_CPU];
+	u32 policy_num[CQM_MAX_CPU][PORTS_PER_CPU];  /* the number of continuous policy */
+	s16 policy_base[CQM_MAX_CPU][PORTS_PER_CPU];
 	/** the default CPU DP should map for the default
 	 * exception session and lookup table.
 	 * For LGM, DP should set up the default exception
@@ -662,6 +665,8 @@ struct cbm_dp_alloc_complete_data {
 	u32 num_qid; /* [in] EPON num qid */
 	u32 bm_policy_res_id; /* [in] buffer policy id */
 	struct dp_dev_opt_param opt_param; /* [in] optional parameters */
+	int tx_policy_base; /* [out] tx policy id base */
+	int tx_policy_num; /* [out] tx policy num */
 };
 
 s32 cbm_dp_port_alloc_complete(
