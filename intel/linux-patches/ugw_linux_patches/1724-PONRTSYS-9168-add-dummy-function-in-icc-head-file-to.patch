From 99b75a4246b2391de3b874e9172090fb31468523 Mon Sep 17 00:00:00 2001
From: yixin zhu <yixin.zhu@intel.com>
Date: Wed, 28 Jul 2021 11:41:32 +0800
Subject: [PATCH] PONRTSYS-9168: add dummy function in icc head file to avoid
 compilation dependency

---
 drivers/cpufreq/xrx500-cpufreq.c |  2 +-
 include/uapi/linux/icc/drv_icc.h | 40 ++++++++++++++++++++++++++++++++++++++++
 2 files changed, 41 insertions(+), 1 deletion(-)

diff --git a/drivers/cpufreq/xrx500-cpufreq.c b/drivers/cpufreq/xrx500-cpufreq.c
index d802aac3d6de..3f8f84b36d22 100644
--- a/drivers/cpufreq/xrx500-cpufreq.c
+++ b/drivers/cpufreq/xrx500-cpufreq.c
@@ -215,7 +215,7 @@ static int xrx500_cpufreq_driver_init(void)
 	/* Instantiate cpufreq-dt */
 	platform_device_register_full(&devinfo);
 
-	if (platform == PLF_PRX) {
+	if (platform == PLF_PRX && IS_ENABLED(CONFIG_LTQ_ICC)) {
 		/* we need to check what is the current f_vco_clock for pll0a
 		 *f_vco_clk = f_osc_clk * FBDIV / REFDIV
 		 *f_osc_clk = 40MHz
diff --git a/include/uapi/linux/icc/drv_icc.h b/include/uapi/linux/icc/drv_icc.h
index 7f4504e5a420..90cfcbc66e07 100644
--- a/include/uapi/linux/icc/drv_icc.h
+++ b/include/uapi/linux/icc/drv_icc.h
@@ -14,6 +14,7 @@
    Description : This file contains the defines, the structures declarations
                  the tables declarations and the global functions declarations.
 *******************************************************************************/
+#include <linux/errno.h>
 #include "drv_mps.h"
 /* ============================= */
 /* ICC Common defines            */
@@ -112,6 +113,7 @@ typedef struct {
 	volatile int Installed;
 } icc_dev;
 
+#if IS_ENABLED(CONFIG_LTQ_ICC)
 int icc_open (struct inode *inode, struct file *file_p);
 int icc_close (struct inode *inode, struct file *filp);
 int icc_register_callback (icc_devices type,
@@ -123,6 +125,44 @@ int icc_regmap_sync_read(icc_devices ClientId, phys_addr_t paddr,
 				unsigned int *val);
 int icc_regmap_sync_write(icc_devices ClientId, phys_addr_t paddr,
 				unsigned int val);
+#else
+int icc_open (struct inode *inode, struct file *file_p)
+{
+	return -EOPNOTSUPP;
+}
+int icc_close (struct inode *inode, struct file *filp)
+{
+	return -EOPNOTSUPP;
+}
+int icc_register_callback (icc_devices type, void (*callback) (icc_wake_type))
+{
+	return -EOPNOTSUPP;
+}
+int icc_unregister_callback (icc_devices type)
+{
+	return -EOPNOTSUPP;
+}
+int icc_read (icc_devices type, icc_msg_t * rw)
+{
+	return -EOPNOTSUPP;
+}
+int icc_write (icc_devices type, icc_msg_t * rw)
+{
+	return -EOPNOTSUPP;
+}
+int icc_regmap_sync_read(icc_devices ClientId, phys_addr_t paddr,
+				unsigned int *val)
+{
+	return -EOPNOTSUPP;
+}
+int icc_regmap_sync_write(icc_devices ClientId, phys_addr_t paddr,
+				unsigned int val)
+{
+	return -EOPNOTSUPP;
+}
+
+#endif /* CONFIG_LTQ_ICC */
+
 #endif /*__KERNEL__*/
 #ifdef __LIBRARY__
 int icc_init(void);
