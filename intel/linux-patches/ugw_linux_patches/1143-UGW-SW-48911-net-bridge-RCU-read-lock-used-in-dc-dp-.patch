From 7d2fa84c694fdb32ada4a3868f9e4ca4e3c9b3c5 Mon Sep 17 00:00:00 2001
From: agaraix <anath.bandux.garai@intel.com>
Date: Tue, 5 May 2020 12:24:33 +0530
Subject: [PATCH] UGW_SW-48911 : net: bridge: RCU read lock used in
 dc_dp_br_fdb_delete()

---
 net/bridge/br_fdb.c | 23 ++++++++++-------------
 1 file changed, 10 insertions(+), 13 deletions(-)

diff --git a/net/bridge/br_fdb.c b/net/bridge/br_fdb.c
index 6c0cd4ca6896..26d8d6b1581e 100644
--- a/net/bridge/br_fdb.c
+++ b/net/bridge/br_fdb.c
@@ -1083,21 +1083,18 @@ int dc_dp_br_fdb_delete(struct net_device *dev, const unsigned char *addr)
 	if (!dev)
 		return -EINVAL;
 
-	if (br_port_exists(dev)) {
-		p = br_port_get_rcu(dev);
-		if (!p) {
-			pr_debug("bridge: %s not a bridge port\n",
-				dev->name);
-			return -EINVAL;
-		}
-	} else {
+	if (!br_port_exists(dev))
 		return -EINVAL;
-	}
 
-	if (addr)
-		err = __br_fdb_delete(p, addr, 0);
-	else
-		br_fdb_delete_by_port(p->br, p, 0, 0);
+	rcu_read_lock();
+	p = br_port_get_rcu(dev);
+	if (p) {
+		if (addr)
+			err = __br_fdb_delete(p, addr, 0);
+		else
+			br_fdb_delete_by_port(p->br, p, 0, 0);
+	}
+	rcu_read_unlock();
 
 	return err;
 }
