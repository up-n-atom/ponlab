From cc3aa64ef39dbdada9c6e098ee7656c2549da45e Mon Sep 17 00:00:00 2001
From: Oren Bakshe <oren.bakshe@intel.com>
Date: Wed, 11 Dec 2019 14:21:59 +0200
Subject: [PATCH] PONRTSYS-6255: pput fails creating more than 300 sessions

---
 drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c      | 6 ++++++
 drivers/net/ppv4/pp-headers/pp_common.h                      | 5 ++++-
 drivers/net/ppv4/pp-tools/unit-test/tests/pp_session_tests.c | 6 +++++-
 3 files changed, 15 insertions(+), 2 deletions(-)

diff --git a/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c b/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c
index 183c864e0ecb..3b65e519eaa6 100644
--- a/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c
+++ b/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c
@@ -2223,6 +2223,7 @@ static inline s32 __smgr_sess_ent_prepare(struct sess_info *sess)
 {
 	struct pp_sess_create_args *args = sess->args;
 	struct sess_db_entry *ent;
+	u32 sess_id;
 
 	if (unlikely(list_empty(&db->free_list))) {
 		pr_err("No free session available\n");
@@ -2233,8 +2234,13 @@ static inline s32 __smgr_sess_ent_prepare(struct sess_info *sess)
 	ent = DB_FREE_LIST_GET_NODE(db);
 	DB_FREE_LIST_DEL_NODE(ent);
 
+	/* Reset the info struct before using it */
+	sess_id = ent->info.sess_id;
+	memset(&ent->info, 0, sizeof(ent->info));
+
 	/* Prepare the entry */
 	memcpy(&ent->info.hash, &args->hash, sizeof(args->hash));
+	ent->info.sess_id   = sess_id;
 	ent->info.in_port   = args->in_port;
 	ent->info.eg_port   = args->eg_port;
 	ent->info.fv_sz     = sess->si.fv_sz;
diff --git a/drivers/net/ppv4/pp-headers/pp_common.h b/drivers/net/ppv4/pp-headers/pp_common.h
index efff76712c57..8ef31ec54360 100644
--- a/drivers/net/ppv4/pp-headers/pp_common.h
+++ b/drivers/net/ppv4/pp-headers/pp_common.h
@@ -1107,7 +1107,10 @@ static inline void *pp_devm_kvmalloc(struct device *dev, size_t sz, gfp_t flags)
 		return NULL;
 
 #ifdef CONFIG_PPV4_FPGA
-	ptr = vmalloc(sz);
+	if (flags & __GFP_ZERO)
+		ptr = vzalloc(sz);
+	else
+		ptr = vmalloc(sz);
 #else
 	ptr = kvmalloc(sz, flags);
 #endif
diff --git a/drivers/net/ppv4/pp-tools/unit-test/tests/pp_session_tests.c b/drivers/net/ppv4/pp-tools/unit-test/tests/pp_session_tests.c
index c8ecb4c302be..740b24665bf3 100644
--- a/drivers/net/ppv4/pp-tools/unit-test/tests/pp_session_tests.c
+++ b/drivers/net/ppv4/pp-tools/unit-test/tests/pp_session_tests.c
@@ -32,6 +32,9 @@ struct sgc_grp_test_info {
 /* number of clocks rate to test in the tbm tests */
 #define NUM_CLOCKS 3
 
+/* QoS port */
+#define PP_SESSION_TEST_QOS_PORT 7
+
 struct tbm_calc_data {
 	u64 rate;
 	u16 expected_mantissa[NUM_CLOCKS];
@@ -255,7 +258,8 @@ static int pp_sess_pre_test(void *data)
 	}
 
 	/* allocate qos port */
-	if (unlikely(pp_qos_port_allocate(qdev, ALLOC_PORT_ID, &qos_port))) {
+	if (unlikely(pp_qos_port_allocate(qdev, PP_SESSION_TEST_QOS_PORT,
+					  &qos_port))) {
 		pr_err("failed to allocate qos port\n");
 		return PP_UT_FAIL;
 	}
