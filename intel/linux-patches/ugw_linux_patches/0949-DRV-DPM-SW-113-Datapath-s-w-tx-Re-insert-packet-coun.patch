From f94ec4470af6353cafdb8690fa454c998e9f0bf6 Mon Sep 17 00:00:00 2001
From: Rekha Eswaran <rekha.eswaran@intel.com>
Date: Mon, 6 Jan 2020 10:08:43 +0800
Subject: [PATCH] DRV_DPM_SW-113 - Datapath s/w tx Re-insert packet count

---
 drivers/net/datapath/dpm/datapath.h              | 22 +++++++++++++++++
 drivers/net/datapath/dpm/gswip31/datapath_misc.c | 21 ++++++++++++++--
 drivers/net/datapath/dpm/gswip31/datapath_misc.h |  3 +++
 drivers/net/datapath/dpm/gswip31/datapath_tx.c   | 31 ++++++++++++++++++++++++
 include/net/datapath_inst.h                      |  1 -
 5 files changed, 75 insertions(+), 3 deletions(-)

diff --git a/drivers/net/datapath/dpm/datapath.h b/drivers/net/datapath/dpm/datapath.h
index 20d583a32c01..90121a6682b6 100644
--- a/drivers/net/datapath/dpm/datapath.h
+++ b/drivers/net/datapath/dpm/datapath.h
@@ -426,6 +426,27 @@ struct dev_mib {
 	atomic_t tx_pkt_dropped;	/*! dropped packet counter */
 };
 
+/**
+ * struct dp_reinsert_count - datapath re-insertion counters in TX
+ */
+/*! @brief DP different sized re-insertion counters */
+struct dp_reinsert_count {
+	/* Size 64 Bytes Packet Count. */
+	u64 dp_64BytePkts;
+	/* Size 65-127 Bytes Packet Count. */
+	u64 dp_127BytePkts;
+	/* Size 128-255 Bytes Packet Count. */
+	u64 dp_255BytePkts;
+	/* Size 256-511 Bytes Packet Count. */
+	u64 dp_511BytePkts;
+	/* Size 512-1023 Bytes Packet Count. */
+	u64 dp_1023BytePkts;
+	/* Size 1024-1522 Bytes (or more, if configured) Packet Count. */
+	u64 dp_MaxBytePkts;
+	/* DP Oversize Good Packet Count. */
+	u64 dp_OversizeGoodPkts;
+};
+
 struct logic_dev {
 	struct list_head list;
 	struct net_device *dev;
@@ -442,6 +463,7 @@ struct dp_subif_info {
 	struct net_device *netif; /*! pointer to  net_device */
 	char device_name[IFNAMSIZ]; /*! devide name, like wlan0, */
 	struct dev_mib mib; /*! mib */
+	struct dp_reinsert_count reins_cnt;
 	struct net_device *ctp_dev; /*CTP dev for PON pmapper case*/
 	u16 bp; /*bridge port */
 	u16 fid; /* switch bridge id */
diff --git a/drivers/net/datapath/dpm/gswip31/datapath_misc.c b/drivers/net/datapath/dpm/gswip31/datapath_misc.c
index 6266bf70524d..eb3b854eb887 100644
--- a/drivers/net/datapath/dpm/gswip31/datapath_misc.c
+++ b/drivers/net/datapath/dpm/gswip31/datapath_misc.c
@@ -391,11 +391,14 @@ static void dump_tx_pmac(struct pmac_tx_hdr *pmac)
 		pmac->igp_egp);
 }
 
-static void mib_init(u32 flag)
+static void mib_init(u32 flag, int inst)
 {
+	struct hal_priv *priv = HAL(inst);
+
 #if IS_ENABLED(CONFIG_INTEL_DATAPATH_MIB)
 	dp_mib_init(0);
 #endif
+	spin_lock_init(&priv->dp_sw_tx_lock);
 	gsw_mib_reset_31(0, 0); /* GSW O */
 }
 
@@ -1203,7 +1206,7 @@ static int dp_platform_set(int inst, u32 flag)
 			 inst, priv->bp_def);
 
 		if (!inst) /*only inst zero will support mib feature */
-			mib_init(0);
+			mib_init(0, inst);
 		dp_get_gsw_parser_31(NULL, NULL, NULL, NULL);
 #if IS_ENABLED(CONFIG_INTEL_DATAPATH_CPUFREQ)
 	if (!inst)
@@ -2028,6 +2031,20 @@ static int dp_ctp_tc_map_set_31(struct dp_tc_cfg *tc, int flag,
 	return 0;
 }
 
+int dp_get_reinsert_cnt_31(int inst, int dp_port, int vap, int flag,
+			   struct dp_reinsert_count *dp_reins_count)
+{
+	struct pmac_port_info *port_info = get_dp_port_info(inst, dp_port);
+	struct dp_subif_info *sif = get_dp_port_subif(port_info, vap);
+	struct hal_priv *priv = HAL(inst);
+
+	spin_lock_bh(&priv->dp_sw_tx_lock);
+	memcpy(dp_reins_count, &sif->reins_cnt,	sizeof(*dp_reins_count));
+	DP_DEBUG(DP_DBG_FLAG_DBG, "Reinsert counters\n");
+	spin_unlock_bh(&priv->dp_sw_tx_lock);
+	return DP_SUCCESS;
+}
+
 static int not_valid_rx_ep(int ep)
 {
 	return (((ep >= 3) && (ep <= 6)) || (ep == 2) || (ep > 15));
diff --git a/drivers/net/datapath/dpm/gswip31/datapath_misc.h b/drivers/net/datapath/dpm/gswip31/datapath_misc.h
index 302876b85409..7ddbd1412470 100644
--- a/drivers/net/datapath/dpm/gswip31/datapath_misc.h
+++ b/drivers/net/datapath/dpm/gswip31/datapath_misc.h
@@ -106,6 +106,7 @@ struct hal_priv {
 			 * to get physical queue id
 			 */
 	struct ppv4_port_map_table ppv4_port_map;/* PPV4 Ports table map */
+	spinlock_t dp_sw_tx_lock;
 };
 
 struct datapath_ctrl {
@@ -220,6 +221,8 @@ int set_port_lookup_mode_31(int inst, u8 ep, u32 flags);
 int tc_vlan_set_31(struct core_ops *ops, struct dp_tc_vlan *vlan,
 		   struct dp_tc_vlan_info *info,
 		   int flag);
+int dp_get_reinsert_cnt_31(int inst, int dp_port, int vap, int flag,
+			   struct dp_reinsert_count *dp_reins_count);
 
 /*!
  *@brief dp_net_dev_get_ethtool_stats_31 - function used by callback
diff --git a/drivers/net/datapath/dpm/gswip31/datapath_tx.c b/drivers/net/datapath/dpm/gswip31/datapath_tx.c
index d2e85ad5edfc..c1f35b9af8e3 100644
--- a/drivers/net/datapath/dpm/gswip31/datapath_tx.c
+++ b/drivers/net/datapath/dpm/gswip31/datapath_tx.c
@@ -100,6 +100,35 @@ void dp_xmit_dbg(
 	DP_DEBUG(DP_DBG_FLAG_DUMP_TX, "\n\n");
 }
 
+static int dp_reinsert_pkt_cnt(struct pmac_port_info *dp_info, int vap, struct sk_buff *skb)
+{
+	struct dp_reinsert_count *stats;
+	int inst = 0;
+	struct hal_priv *priv = HAL(inst);
+	int len = (skb->len - PMAC_SIZE);
+
+	DP_DEBUG(DP_DBG_FLAG_DBG, "len=%d vap=%d\n", len, vap);
+	stats = &get_dp_port_subif(dp_info, vap)->reins_cnt;
+	spin_lock_bh(&priv->dp_sw_tx_lock);
+	if (len <= 64) {
+		stats->dp_64BytePkts++;
+	} else if ((len <= 127) && (len >= 65)) {
+		stats->dp_127BytePkts++;
+	} else if ((len <= 255) && (len >= 128)) {
+		stats->dp_255BytePkts++;
+	} else if ((len <= 511) && (len >= 256)) {
+		stats->dp_511BytePkts++;
+	} else if ((len <= 1023) && (len >= 512)) {
+		stats->dp_1023BytePkts++;
+	} else if ((len <= 1518) && (len >= 1024)) {
+		stats->dp_MaxBytePkts++;
+	} else if (len >= 1519) {
+		stats->dp_OversizeGoodPkts++;
+	}
+	spin_unlock_bh(&priv->dp_sw_tx_lock);
+	return DP_SUCCESS;
+}
+
 int32_t dp_xmit_31(struct net_device *rx_if, dp_subif_t *rx_subif,
 		   struct sk_buff *skb, int32_t len, uint32_t flags)
 {
@@ -377,6 +406,8 @@ int32_t dp_xmit_31(struct net_device *rx_if, dp_subif_t *rx_subif,
 		data.dp_inst = 0;
 	}
 	res = cbm_cpu_pkt_tx(skb, &data, 0);
+	if (flags & DP_TX_INSERT)
+		dp_reinsert_pkt_cnt(dp_info, vap, skb);
 	UP_STATS(mib->tx_cbm_pkt);
 	return res;
 
