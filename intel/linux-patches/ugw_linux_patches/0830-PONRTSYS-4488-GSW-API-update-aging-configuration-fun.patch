@@ -2659,6 +2659,63 @@ static void get_gsw_hw_cap(void *cdev)
 
 }
 
+u32 gsw_aging_get(void *cdev)
+{
+	ethsw_api_dev_t *gswdev = GSW_PDATA_GET(cdev);
+	u32 mant = 0;
+	u32 exp = 0;
+	u64 tmp;
+
+	BUG_ON(!cdev);
+
+	gsw_r32(cdev, PCE_AGE_1_MANT_OFFSET, PCE_AGE_1_MANT_SHIFT,
+		PCE_AGE_1_MANT_SIZE, &mant);
+	gsw_r32(cdev, PCE_AGE_0_EXP_OFFSET, PCE_AGE_0_EXP_SHIFT,
+		PCE_AGE_0_EXP_SIZE, &exp);
+	BUG_ON(!mant && !exp);
+
+	tmp = ((u64)mant + 1) << exp;
+	tmp *= gswdev->mactblsize;
+	tmp *= AGING_STEPS;
+	tmp += AGING_CLK / 2;
+	do_div(tmp, AGING_CLK);
+
+	return (u32)tmp;
+}
+
+int gsw_aging_set(void *cdev, u32 aging)
+{
+	ethsw_api_dev_t *gswdev = GSW_PDATA_GET(cdev);
+	u64 tmp1;
+	u32 tmp2;
+	u32 mant, exp;
+
+	BUG_ON(!cdev);
+
+	if (!gswdev || !aging)
+		return GSW_statusParam;
+
+	tmp1 = (u64)aging * AGING_CLK;
+	tmp2 = (u32)gswdev->mactblsize * AGING_STEPS;
+	tmp1 += tmp2 / 2;
+	do_div(tmp1, tmp2);
+	tmp1--;
+
+	if ((tmp1 & ~0x7FFFFFFFULL))
+		return GSW_statusParam;
+
+	tmp2 = (u32)tmp1;
+	exp = (u16)fls((int)(tmp2 >> 16));
+	mant = (u16)(tmp2 >> exp);
+
+	gsw_w32(cdev, PCE_AGE_1_MANT_OFFSET, PCE_AGE_1_MANT_SHIFT,
+		PCE_AGE_1_MANT_SIZE, mant);
+	gsw_w32(cdev, PCE_AGE_0_EXP_OFFSET, PCE_AGE_0_EXP_SHIFT,
+		PCE_AGE_0_EXP_SIZE, exp);
+
+	return GSW_statusOk;
+}
+
