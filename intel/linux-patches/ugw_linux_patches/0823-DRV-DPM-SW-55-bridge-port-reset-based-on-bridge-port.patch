From 824caa4b32e49efc0636dd8c1287721baf6db859 Mon Sep 17 00:00:00 2001
From: Rekha Eswaran <rekha.eswaran@intel.com>
Date: Mon, 7 Oct 2019 17:10:01 +0800
Subject: [PATCH] DRV_DPM_SW-55 - bridge port reset based on bridge port list
 instead of bridge port member map

---
 drivers/net/datapath/dpm/datapath.h                |  1 +
 drivers/net/datapath/dpm/datapath_misc.c           |  6 ++--
 drivers/net/datapath/dpm/datapath_swdev.c          |  3 +-
 drivers/net/datapath/dpm/gswip31/datapath_gswip.c  |  7 +++--
 .../net/datapath/dpm/gswip31/datapath_switchdev.c  | 35 ++++++++++++++--------
 5 files changed, 34 insertions(+), 18 deletions(-)

diff --git a/drivers/net/datapath/dpm/datapath.h b/drivers/net/datapath/dpm/datapath.h
index 7d3d594125f2..f592e8ca85f8 100644
--- a/drivers/net/datapath/dpm/datapath.h
+++ b/drivers/net/datapath/dpm/datapath.h
@@ -537,6 +537,7 @@ struct pmac_port_info {
 #if !IS_ENABLED(CONFIG_INTEL_DATAPATH_HAL_GSWIP30)
 	struct dp_umt_port umt; /*!< UMT Param */
 #endif
+	enum DP_DATA_PORT_TYPE type;
 	/* These members must be end. */
 	u32 tail;
 	struct dp_subif_info *subif_info;
diff --git a/drivers/net/datapath/dpm/datapath_misc.c b/drivers/net/datapath/dpm/datapath_misc.c
index 81cea023a2b4..b4d39897271c 100644
--- a/drivers/net/datapath/dpm/datapath_misc.c
+++ b/drivers/net/datapath/dpm/datapath_misc.c
@@ -1331,7 +1331,7 @@ int32_t dp_sync_subifid(struct net_device *dev, char *subif_name,
 			pr_err("DP subif synchronization fail\n");
 			return DP_FAILURE;
 		}
-		if (data->ctp_dev) {
+		if (data && data->ctp_dev) {
 			if (dp_get_netif_subifid_priv(data->ctp_dev, NULL,
 						      subif_data, NULL,
 						      &subif_id[1], 0))
@@ -1363,7 +1363,7 @@ int32_t dp_sync_subifid_priv(struct net_device *dev, char *subif_name,
 		subif_data = (void *)subif_name;
 	/*check flag for register / deregister to update/del */
 	if (flags & DP_F_DEREGISTER) {
-		if (data->ctp_dev)
+		if (data && data->ctp_dev)
 			dp_del_subif(data->ctp_dev, subif_data, &subif_id[1],
 				     NULL, flags);
 
@@ -1377,7 +1377,7 @@ int32_t dp_sync_subifid_priv(struct net_device *dev, char *subif_name,
 		if (*f_subif_up == 1) {
 			dp_update_subif(dev, subif_data, &subif_id[0],
 					subif_name, flags, subifid_fn);
-		if (data->ctp_dev)
+		if (data && data->ctp_dev)
 			dp_update_subif(data->ctp_dev, subif_data, &subif_id[1],
 					NULL, flags, subifid_fn);
 		}
diff --git a/drivers/net/datapath/dpm/datapath_swdev.c b/drivers/net/datapath/dpm/datapath_swdev.c
index dcd8f829f754..ba5b19f6c542 100644
--- a/drivers/net/datapath/dpm/datapath_swdev.c
+++ b/drivers/net/datapath/dpm/datapath_swdev.c
@@ -270,7 +270,8 @@ static int dp_swdev_clr_gswip_cfg(struct bridge_id_entry_item *br_item,
 	if (ret == DEL_BRENTRY) {
 		i_info->swdev_free_brcfg(br_item->inst, br_item->fid);
 		dp_swdev_remove_bridge_id_entry(br_info);
-		DP_DEBUG(DP_DBG_FLAG_SWDEV, "rem bport(%d),bridge(%s)\n",
+		DP_DEBUG(DP_DBG_FLAG_SWDEV,
+			 "last bport(%d) to remove from bridge(%s)\n",
 			 br_item->portid, br_item->br_device_name);
 	}
 	DP_DEBUG(DP_DBG_FLAG_SWDEV, "rem bport(%d)\n", br_item->portid);
diff --git a/drivers/net/datapath/dpm/gswip31/datapath_gswip.c b/drivers/net/datapath/dpm/gswip31/datapath_gswip.c
index 4b35e0123703..e890a5d9251f 100644
--- a/drivers/net/datapath/dpm/gswip31/datapath_gswip.c
+++ b/drivers/net/datapath/dpm/gswip31/datapath_gswip.c
@@ -428,9 +428,12 @@ int dp_set_gsw_parser_31(u8 flag, u8 cpu, u8 mpe1,
 		return -1;
 	}
 	memset(&reg, 0, sizeof(reg));
-	reg.nRegAddr = 0x001; /**/
+	reg.nRegAddr = 0x001;
 	gsw_handle->gsw_common_ops.RegisterGet(gsw_handle, &reg);
-	reg.nData |= 1 << 0; /**/
+	reg.nData |= 1 << 0; /* to enable SLL memory write.
+			      * GSWIP HW will write parser flags only when this
+			      * bit is set
+			      */
 	gsw_handle->gsw_common_ops.RegisterSet(gsw_handle, &reg);
 
 	dp_parser_info_refresh(param.eNoMPEParserCfg,
diff --git a/drivers/net/datapath/dpm/gswip31/datapath_switchdev.c b/drivers/net/datapath/dpm/gswip31/datapath_switchdev.c
index bde4560fcfa9..bc6eb0656af4 100644
--- a/drivers/net/datapath/dpm/gswip31/datapath_switchdev.c
+++ b/drivers/net/datapath/dpm/gswip31/datapath_switchdev.c
@@ -82,12 +82,17 @@ int dp_swdev_bridge_port_cfg_set(struct br_info *br_item,
 			if ((bport_list->dev_priv_flag & IFF_NO_QUEUE) ||
 			    ((bport_list->no_loop_flag) &&
 			    (bport_list->dp_port == dport))) {
-				DP_DEBUG(DP_DBG_FLAG_SWDEV,
-					 "IFF_NO_QUEUE Don't add if to pmap\n");
+				DP_DEBUG(DP_DBG_FLAG_SWDEV, "%s%d to %d%s",
+					 "IFF_NO_QUEUE set Don't add BP=",
+					 bport_list->portid, bport,
+					 " bp map\n");
 				UNSET_BP_MAP(brportcfg.nBridgePortMap,
 					     bport_list->portid);
 				continue;
 			}
+			DP_DEBUG(DP_DBG_FLAG_SWDEV, "%s%d to %d%s",
+				 "add BP=", bport_list->portid, bport,
+				 " bp map\n");
 			SET_BP_MAP(brportcfg.nBridgePortMap,
 				   bport_list->portid);
 		}
@@ -124,10 +129,17 @@ int dp_swdev_bridge_port_cfg_set(struct br_info *br_item,
 		    ((bport_list->no_loop_flag) &&
 		    (bport_list->dp_port == dport))) {
 			DP_DEBUG(DP_DBG_FLAG_SWDEV,
-				 "IFF_NO_QUEUE/no_loop Don't add if to pmap\n");
+				 "%s %d to %d %s",
+				 "IFF_NO_QUEUE/no_loop Don't add BP",
+				 bport, bport_list->portid,
+				 "bp map\n");
 			UNSET_BP_MAP(brportcfg.nBridgePortMap,
 				     bport);
 		} else {
+			DP_DEBUG(DP_DBG_FLAG_SWDEV,
+				 "set %d to %d %s",
+				 bport, bport_list->portid,
+				 "bp pmap\n");
 			SET_BP_MAP(brportcfg.nBridgePortMap, bport);
 		}
 		brportcfg.nBridgeId = br_item->fid;
@@ -148,7 +160,7 @@ int dp_swdev_bridge_port_cfg_reset(struct br_info *br_item,
 {
 	GSW_BRIDGE_portConfig_t brportcfg;
 	struct bridge_member_port *bport_list = NULL;
-	int i, cnt = 0, bp = 0;
+	int cnt = 0, bp = 0;
 	GSW_return_t ret;
 	struct core_ops *gsw_handle;
 	struct brdgport_ops *gsw_bp;
@@ -177,17 +189,16 @@ int dp_swdev_bridge_port_cfg_reset(struct br_info *br_item,
 			 "GSW_BRIDGE_portConfig_t fail:bp=%d\n", bport);
 		return -1;
 	}
-	for (i = 0; i < MAX_BP_NUM; i++) {
-		if (GET_BP_MAP(brportcfg.nBridgePortMap, i)) {
-			bp = i;
+	list_for_each_entry(bport_list, &br_item->bp_list, list) {
+		if (bport_list->portid)
 			cnt++;
-		}
 	}
 	DP_DEBUG(DP_DBG_FLAG_SWDEV, "cnt:%d last bp:%d\n", cnt, bp);
 	list_for_each_entry(bport_list, &br_item->bp_list, list) {
 		if (bport_list->portid != bport) {
 			DP_DEBUG(DP_DBG_FLAG_SWDEV,
-				 "reset other from current BP=%d inst:%d\n",
+				 "reset BP %d from current BP=%d inst:%d\n",
+				 bport_list->portid,
 				 brportcfg.nBridgePortId, inst);
 			UNSET_BP_MAP(brportcfg.nBridgePortMap,
 				     bport_list->portid);
@@ -210,8 +221,8 @@ int dp_swdev_bridge_port_cfg_reset(struct br_info *br_item,
 		memset(&brportcfg, 0, sizeof(GSW_BRIDGE_portConfig_t));
 		brportcfg.nBridgePortId = bport_list->portid;
 		DP_DEBUG(DP_DBG_FLAG_SWDEV,
-			 "reset current BP from other BP=%d inst:%d\n",
-			 brportcfg.nBridgePortId, inst);
+			 "reset current BP(%d) from other BP=%d inst:%d\n",
+			 bport, brportcfg.nBridgePortId, inst);
 		brportcfg.eMask = GSW_BRIDGE_PORT_CONFIG_MASK_BRIDGE_PORT_MAP |
 				  GSW_BRIDGE_PORT_CONFIG_MASK_BRIDGE_ID;
 		ret = gsw_bp->BridgePort_ConfigGet(gsw_handle, &brportcfg);
@@ -233,7 +244,7 @@ int dp_swdev_bridge_port_cfg_reset(struct br_info *br_item,
 	/*Remove bridge entry if no member in port map of
 	 * current bport except CPU port
 	 */
-	if ((bp == 0 && cnt == 1) || (cnt == 0))
+	if (cnt == 0)
 		return DEL_BRENTRY;
 
 	return 0;
