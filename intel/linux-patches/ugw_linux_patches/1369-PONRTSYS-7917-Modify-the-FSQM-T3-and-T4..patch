From cfbad98d32f161b7eb42e179b28c06dca52e15f6 Mon Sep 17 00:00:00 2001
From: kavitha3 <k.subramanian@intel.com>
Date: Tue, 18 Aug 2020 12:04:41 +0800
Subject: [PATCH] PONRTSYS-7917: Modify the FSQM T3 and T4.

To avoid high priority packets being dropped in GSWIP in DS SP
---
 drivers/net/ethernet/lantiq/cqm/prx300/cqm.c | 12 +++++++++---
 1 file changed, 9 insertions(+), 3 deletions(-)

diff --git a/drivers/net/ethernet/lantiq/cqm/prx300/cqm.c b/drivers/net/ethernet/lantiq/cqm/prx300/cqm.c
index b4346ca89c33..76b297bfeb15 100644
--- a/drivers/net/ethernet/lantiq/cqm/prx300/cqm.c
+++ b/drivers/net/ethernet/lantiq/cqm/prx300/cqm.c
@@ -2810,12 +2810,18 @@ static void init_fsqm(void)
 	cbm_w32((fsqm + FSQT0), fsqm_frm_num / 5);
 	cbm_w32((fsqm + FSQT1), fsqm_frm_num / 8);
 	cbm_w32((fsqm + FSQT2), fsqm_frm_num / 12);
-	cbm_w32((fsqm + FSQT3), fsqm_frm_num / 25);
-	cbm_w32((fsqm + FSQT4), fsqm_frm_num / 25);
+
+	/* FSQT4 should be 2x(Number of 128B segments for the largest packet)
+	 * for supporting 9.K Jumbo buffer plus some safety margin, we set it to
+	 * 0xa0.FSQT4=FSQT3 will cause back-pressure when the threshold is
+	 * reached. So set FSQT3 to 0xa1
+	 */
+	cbm_w32((fsqm + FSQT3), 0xa1);
+	cbm_w32((fsqm + FSQT4), 0xa0);
 	cbm_w32(fsqm + IO_BUF_RD, 0);
 	cbm_w32(fsqm + IO_BUF_WR, 0);
 	cbm_w32(fsqm + FSQM_CTRL, 0x1);
-	/*Dump FSQM registers*/
+	/* Dump FSQM registers */
 	{
 #if 1
 		print_reg("FSQM_CTRL",	(u32 *)(fsqm + FSQM_CTRL));
