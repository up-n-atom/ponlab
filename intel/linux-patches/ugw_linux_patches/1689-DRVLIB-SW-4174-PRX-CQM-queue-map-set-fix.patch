From 3392d2b094c0a45fcad7cbfa1dd99379ffc7de79 Mon Sep 17 00:00:00 2001
From: Lishan Liu <lishan.liu@intel.com>
Date: Wed, 9 Jun 2021 18:24:41 +0800
Subject: [PATCH] DRVLIB_SW-4174: PRX CQM queue map set fix

---
 drivers/net/ethernet/lantiq/cqm/prx300/cqm.c | 26 +++++++++++++++++++-------
 drivers/net/ethernet/lantiq/cqm/prx300/cqm.h |  1 +
 2 files changed, 20 insertions(+), 7 deletions(-)

diff --git a/drivers/net/ethernet/lantiq/cqm/prx300/cqm.c b/drivers/net/ethernet/lantiq/cqm/prx300/cqm.c
index a8eeb237241c..5f47012f45f8 100644
--- a/drivers/net/ethernet/lantiq/cqm/prx300/cqm.c
+++ b/drivers/net/ethernet/lantiq/cqm/prx300/cqm.c
@@ -813,6 +813,8 @@ static void restore_orig_q(const struct cbm_lookup_entry *lu_entry)
 static inline void find_next_sub_if_id(u32 *idx_p, u32 mask, u32 mask_all,
 				       u32 limit_v, u32 start_v)
 {
+	if (*idx_p < start_v)
+		*idx_p = start_v;
 	if (mask && (*idx_p) && mask_all) {
 		while ((start_v != ((*idx_p) & (~mask))) &&
 		       ((*idx_p) < limit_v)) {
@@ -908,7 +910,8 @@ static void cqm_qidt_set_mode0(const struct cqm_qidt_elm *qid_set,
 				     &flag_done.mpe2_done, qid_set->mpe2,
 				     qid_mask->mpe2_mask, &qidt_elm.mpe2,
 				     &qidt_idx.mpe2);
-			cqm_qid_reg_set(&qidt_elm, qid_val, sel_field);
+			if (!flag_done.mpe2_done)
+				cqm_qid_reg_set(&qidt_elm, qid_val, sel_field);
 			break;
 		case STATE_NONE:
 			break;
@@ -977,7 +980,8 @@ static void cqm_qidt_set_mode1(const struct cqm_qidt_elm *qid_set,
 				     &flag_done.mpe2_done, qid_set->mpe2,
 				     qid_mask->mpe2_mask, &qidt_elm.mpe2,
 				     &qidt_idx.mpe2);
-			cqm_qid_reg_set(&qidt_elm, qid_val, sel_field);
+			if (!flag_done.mpe2_done)
+				cqm_qid_reg_set(&qidt_elm, qid_val, sel_field);
 			break;
 		case STATE_NONE:
 			break;
@@ -1059,7 +1063,8 @@ static void cqm_qidt_set_mode2(const struct cqm_qidt_elm *qid_set,
 				     &flag_done.mpe2_done, qid_set->mpe2,
 				     qid_mask->mpe2_mask, &qidt_elm.mpe2,
 				     &qidt_idx.mpe2);
-			cqm_qid_reg_set(&qidt_elm, qid_val, sel_field);
+			if (!flag_done.mpe2_done)
+				cqm_qid_reg_set(&qidt_elm, qid_val, sel_field);
 			break;
 		case STATE_NONE:
 			break;
@@ -1136,7 +1141,8 @@ static void cqm_qidt_set_mode3(const struct cqm_qidt_elm *qid_set,
 				     &flag_done.mpe2_done, qid_set->mpe2,
 				     qid_mask->mpe2_mask, &qidt_elm.mpe2,
 				     &qidt_idx.mpe2);
-			cqm_qid_reg_set(&qidt_elm, qid_val, sel_field);
+			if (!flag_done.mpe2_done)
+				cqm_qid_reg_set(&qidt_elm, qid_val, sel_field);
 			break;
 		case STATE_NONE:
 			break;
@@ -1275,6 +1281,7 @@ static s32 queue_map_set(int cbm_inst, s32 queue_id,
 	unsigned long sys_flag;
 	struct cqm_qidt_elm qidt_elm;
 	struct cqm_qidt_mask qidt_mask = {0};
+	u32 i;
 
 	if (!entry)
 		return CBM_FAILURE;
@@ -1300,8 +1307,6 @@ static s32 queue_map_set(int cbm_inst, s32 queue_id,
 		qidt_mask.mpe1_mask = 1;
 	if (flags & CBM_QUEUE_MAP_F_MPE2_DONTCARE)
 		qidt_mask.mpe2_mask = 1;
-	if (flags & CBM_QUEUE_MAP_F_EP_DONTCARE)
-		qidt_mask.ep_mask = 1;
 	if (flags & CBM_QUEUE_MAP_F_TC_DONTCARE)
 		qidt_mask.classid_mask = 1;
 	if (flags & CBM_QUEUE_MAP_F_SUBIF_DONTCARE) {
@@ -1311,7 +1316,14 @@ static s32 queue_map_set(int cbm_inst, s32 queue_id,
 	}
 
 	spin_lock_irqsave(&cqm_qidt_lock, sys_flag);
-	cqm_qidt_set(&qidt_elm, &qidt_mask, queue_id);
+	if (flags & CBM_QUEUE_MAP_F_EP_DONTCARE) {
+		for (i = 0; i < MAX_QID_MAP_EP_NUM; i++) {
+			qidt_elm.ep = i;
+			cqm_qidt_set(&qidt_elm, &qidt_mask, queue_id);
+		}
+	} else {
+		cqm_qidt_set(&qidt_elm, &qidt_mask, queue_id);
+	}
 	spin_unlock_irqrestore(&cqm_qidt_lock, sys_flag);
 	return CBM_SUCCESS;
 }
diff --git a/drivers/net/ethernet/lantiq/cqm/prx300/cqm.h b/drivers/net/ethernet/lantiq/cqm/prx300/cqm.h
index e616a33aa251..3afbedcc1156 100644
--- a/drivers/net/ethernet/lantiq/cqm/prx300/cqm.h
+++ b/drivers/net/ethernet/lantiq/cqm/prx300/cqm.h
@@ -54,6 +54,7 @@
 #define MODE1_SUB_IF_ID_LIMIT	BIT(8)
 #define MODE2_SUB_IF_ID_LIMIT	BIT(4)
 #define MODE3_SUB_IF_ID_LIMIT	BIT(5)
+#define MAX_QID_MAP_EP_NUM	16
 /***********************
  * ENUM
  ***********************/
