+#define CBM_PORT_F_FLUSH 0x40
+
 /** \addtogroup CBM_Driver_CPU_Defines */
 /*! \brief Stop Rx i.e. assert backpressure */
 #define CBM_CPU_F_RX_STOP		0x1
