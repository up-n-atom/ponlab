From 92f8e32fe1fbd323d9fbc2f89784e71abedf989f Mon Sep 17 00:00:00 2001
From: "Rywacki, Kamil" <kamil.rywacki@intel.com>
Date: Fri, 25 Sep 2020 12:13:45 +0200
Subject: [PATCH] PONRTSYS-7767: Remove CPU port from brige port map of
 eth0_0_us

---
 drivers/net/ethernet/lantiq/ltq_eth_drv_xrx500.c | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/drivers/net/ethernet/lantiq/ltq_eth_drv_xrx500.c b/drivers/net/ethernet/lantiq/ltq_eth_drv_xrx500.c
index 67f0f391c1f5..38c0fa2eb287 100644
--- a/drivers/net/ethernet/lantiq/ltq_eth_drv_xrx500.c
+++ b/drivers/net/ethernet/lantiq/ltq_eth_drv_xrx500.c
@@ -2004,6 +2004,15 @@ static void unregister_macsec(struct net_device *netdev)
 }
 #endif
 
+static void ltq_eth_iphost_cpu_disconnect(struct net_device *dev)
+{
+	struct dp_bp_attr conf = {0};
+
+	conf.dev = dev;
+	conf.en = 0;
+	dp_set_bp_attr(&conf, 0);
+}
+
 static int ltq_eth_dev_reg(struct xrx500_hw *hw, u32 xgmac_id_param,
 			   u32 lct_en, u32 dp_port, int start, int end,
 			   struct ltq_eth_priv *master)
@@ -2052,6 +2061,9 @@ static int ltq_eth_dev_reg(struct xrx500_hw *hw, u32 xgmac_id_param,
 #if IS_ENABLED(CONFIG_INTEL_E160)
 		register_macsec(eth_dev[i]);
 #endif
+		if (i == PON_IP_HOST_SUBIF_IDX)
+			ltq_eth_iphost_cpu_disconnect(eth_dev[i]);
+
 		num++;
 	}
 	return 0;
