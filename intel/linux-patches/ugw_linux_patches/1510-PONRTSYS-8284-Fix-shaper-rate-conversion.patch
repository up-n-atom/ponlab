From 213243cc00841a48e824c13c7bb055f31cc25ede Mon Sep 17 00:00:00 2001
From: Jan Dominiak <janx.dominiak@intel.com>
Date: Tue, 17 Nov 2020 08:39:57 +0100
Subject: [PATCH] PONRTSYS-8284: Fix shaper rate conversion

---
 drivers/net/datapath/pon_qos/pon_qos_tc_qos.c | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/drivers/net/datapath/pon_qos/pon_qos_tc_qos.c b/drivers/net/datapath/pon_qos/pon_qos_tc_qos.c
index 65d4dcc46832..8923dfde4a2c 100644
--- a/drivers/net/datapath/pon_qos/pon_qos_tc_qos.c
+++ b/drivers/net/datapath/pon_qos/pon_qos_tc_qos.c
@@ -1195,8 +1195,10 @@ int pon_qos_shaper_add(struct pon_qos_qdisc *sch,
 		   __func__, cfg.inst, cfg.type, cfg.cmd, cfg.id.q_id,
 		   cfg.id.sch_id, cfg.id.cqm_deq_port);
 
-	cfg.cir = div_u64(params->rate, 1000);
-	cfg.pir = div_u64(params->prate, 1000);
+	/* Convert from bytes to kilobits */
+	cfg.cir = div_u64(params->rate * 8, 1000);
+	cfg.pir = div_u64(params->prate * 8, 1000);
+
 	cfg.cbs = params->burst;
 	cfg.pbs = params->pburst;
 
