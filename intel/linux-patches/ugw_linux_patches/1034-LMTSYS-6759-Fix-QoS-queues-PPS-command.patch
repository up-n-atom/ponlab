From 796b2a076a603c210827f73b6428784003f8d88b Mon Sep 17 00:00:00 2001
From: avishalo <avi1.shalom@intel.com>
Date: Mon, 10 Feb 2020 17:57:38 +0200
Subject: [PATCH] LMTSYS-6759: Fix QoS queues PPS command

Signed-off-by: avishalo <avi1.shalom@intel.com>
---
 drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.c | 16 +++++++++-------
 drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.h |  2 ++
 2 files changed, 11 insertions(+), 7 deletions(-)

diff --git a/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.c b/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.c
index e860a6fe35e3..99e0eff47954 100644
--- a/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.c
+++ b/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.c
@@ -60,9 +60,7 @@ s32 qos_queues_stats_show(char *buf, size_t sz, size_t *n, void *stats,
 			   "| %-3u(%-3u)-rlm-%-3u | %-10u  | %-10u  | %-10u  | %-10u  |\n",
 			   node_id, node_phy, node->data.queue.rlm,
 			   it->wred.queue_packets_occupancy,
-			   it->wred.total_packets_accepted -
-				it->wred.queue_packets_occupancy -
-				it->codel.packets_dropped,
+			   it->total_fwd_pkts,
 			   it->wred.total_packets_dropped,
 			   it->codel.packets_dropped);
 	}
@@ -78,10 +76,11 @@ static void __queue_stats_diff(const struct queue_stats *pre,
 {
 	U32_STRUCT_DIFF(&pre->codel, &post->codel, &delta->codel);
 	delta->wred.queue_packets_occupancy =
-		post->wred.queue_packets_occupancy -
-		pre->wred.queue_packets_occupancy;
-	delta->wred.queue_bytes_occupancy = post->wred.queue_bytes_occupancy -
-					    pre->wred.queue_bytes_occupancy;
+	(pre->wred.queue_packets_occupancy + post->wred.queue_packets_occupancy)
+	/ 2;
+	delta->wred.queue_bytes_occupancy =
+	(pre->wred.queue_bytes_occupancy + post->wred.queue_bytes_occupancy)
+	/ 2;
 	delta->wred.total_packets_accepted = post->wred.total_packets_accepted -
 					     pre->wred.total_packets_accepted;
 	delta->wred.total_packets_dropped = post->wred.total_packets_dropped -
@@ -93,6 +92,7 @@ static void __queue_stats_diff(const struct queue_stats *pre,
 					   pre->wred.total_bytes_accepted;
 	delta->wred.total_bytes_dropped =
 		post->wred.total_bytes_dropped - pre->wred.total_bytes_dropped;
+	delta->total_fwd_pkts = post->total_fwd_pkts - pre->total_fwd_pkts;
 }
 
 s32 qos_queues_stats_diff(void *pre, u32 num_pre, void *post, u32 num_post,
@@ -159,6 +159,8 @@ s32 qos_queues_stats_get(void *stats, u32 num_stats, void *data)
 				    node_id, ret);
 			return ret;
 		}
+		it->total_fwd_pkts = it->wred.total_packets_accepted -
+		it->wred.queue_packets_occupancy - it->codel.packets_dropped;
 	}
 
 	return 0;
diff --git a/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.h b/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.h
index b1d4ada8c1ae..95a8570804d0 100644
--- a/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.h
+++ b/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.h
@@ -205,6 +205,8 @@ struct queue_stats {
 	struct pp_qos_queue_stat wred;
 	/*! codel stats */
 	struct pp_qos_codel_stat codel;
+	/*! total forward packets */
+	u32 total_fwd_pkts;
 };
 
 enum node_type {
