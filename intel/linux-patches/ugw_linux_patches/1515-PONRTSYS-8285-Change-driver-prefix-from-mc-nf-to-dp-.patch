From 40134f94fae2ea4817edd880a1e321370dc9cce3 Mon Sep 17 00:00:00 2001
From: Hauke Mehrtens <hauke.mehrtens@intel.com>
Date: Thu, 19 Nov 2020 15:23:03 +0100
Subject: [PATCH] PONRTSYS-8285: Change driver prefix from mc_nf to dp_mcast

Change the prefix of the driver functions.
---
 .../mcast_bridge_filter/mcast_bridge_filter.c      | 38 +++++++++++-----------
 include/net/mcast_bridge_filter.h                  |  6 ++--
 2 files changed, 22 insertions(+), 22 deletions(-)

diff --git a/drivers/net/datapath/mcast_bridge_filter/mcast_bridge_filter.c b/drivers/net/datapath/mcast_bridge_filter/mcast_bridge_filter.c
index 273852794ba3..1cec7c571511 100644
--- a/drivers/net/datapath/mcast_bridge_filter/mcast_bridge_filter.c
+++ b/drivers/net/datapath/mcast_bridge_filter/mcast_bridge_filter.c
@@ -25,13 +25,13 @@
 /* max number of encapsulated vlan tags */
 #define MAX_VLAN_TAGS	3
 
-bool mc_nf_vlan_activate = false;
+bool dp_mcast_vlan_activate = false;
 
 /*
  * Iterates over the VLAN tags and increases nhoff for each VLAN tag.
  * returns 0 on success and -EINVAL in case of an parsing error.
  */
-static int mc_nf_vlan_iter(struct sk_buff *skb, __be16 *proto, int *nhoff)
+static int dp_mcast_vlan_iter(struct sk_buff *skb, __be16 *proto, int *nhoff)
 {
 	const struct vlan_hdr *vlan = NULL;
 	struct vlan_hdr _vlan;
@@ -55,7 +55,7 @@ static int mc_nf_vlan_iter(struct sk_buff *skb, __be16 *proto, int *nhoff)
  * Returns 1 for an IPv6 MLD or MGM packet, 0, -EINVAL on an parsing error and
  * 0 if it is not an IPv6 MLD or MGM packet.
  */
-static int mc_nf_ipv6_is_mld_pkt(struct sk_buff *skb, int nhoff)
+static int dp_mcast_ipv6_is_mld_pkt(struct sk_buff *skb, int nhoff)
 {
 	const struct icmp6hdr *icmp6hdr;
 	struct icmp6hdr _icmp6hdr;
@@ -77,7 +77,7 @@ static int mc_nf_ipv6_is_mld_pkt(struct sk_buff *skb, int nhoff)
 	return 0;
 }
 
-static unsigned int mc_nf_br_hook_ipv4(struct sk_buff *skb, int nhoff)
+static unsigned int dp_mcast_br_hook_ipv4(struct sk_buff *skb, int nhoff)
 {
 	const struct iphdr *iph;
 	struct iphdr _iph;
@@ -95,7 +95,7 @@ static unsigned int mc_nf_br_hook_ipv4(struct sk_buff *skb, int nhoff)
 	return NF_ACCEPT;
 }
 
-static unsigned int mc_nf_br_hook_ipv6(struct sk_buff *skb, int nhoff)
+static unsigned int dp_mcast_br_hook_ipv6(struct sk_buff *skb, int nhoff)
 {
 	const struct ipv6hdr *iph;
 	struct ipv6hdr _iph;
@@ -119,25 +119,25 @@ static unsigned int mc_nf_br_hook_ipv6(struct sk_buff *skb, int nhoff)
 	if (nexthdr != NEXTHDR_ICMP)
 		return NF_ACCEPT;
 
-	if (mc_nf_ipv6_is_mld_pkt(skb, nhoff) == 1) {
+	if (dp_mcast_ipv6_is_mld_pkt(skb, nhoff) == 1) {
 		pr_debug("IPv6 MLD packet dropped");
 		return NF_DROP;
 	}
 	return NF_ACCEPT;
 }
 
-static unsigned int mc_nf_br_hook(void *priv, struct sk_buff *skb,
+static unsigned int dp_mcast_br_hook(void *priv, struct sk_buff *skb,
 				  const struct nf_hook_state *state)
 {
 	__be16 proto = skb->protocol;
 	int nhoff = skb_network_offset(skb);
 	int err;
 
-	if (!mc_nf_vlan_activate)
+	if (!dp_mcast_vlan_activate)
 		return NF_ACCEPT;
 
 	if (eth_type_vlan(proto)) {
-		err = mc_nf_vlan_iter(skb, &proto, &nhoff);
+		err = dp_mcast_vlan_iter(skb, &proto, &nhoff);
 		if (err) {
 			pr_debug("VLAN header broken, accepted");
 			return NF_ACCEPT;
@@ -146,35 +146,35 @@ static unsigned int mc_nf_br_hook(void *priv, struct sk_buff *skb,
 
 	switch (proto) {
 	case htons(ETH_P_IP):
-		return mc_nf_br_hook_ipv4(skb, nhoff);
+		return dp_mcast_br_hook_ipv4(skb, nhoff);
 	case htons(ETH_P_IPV6):
-		return mc_nf_br_hook_ipv6(skb, nhoff);
+		return dp_mcast_br_hook_ipv6(skb, nhoff);
 	default:
 		return NF_ACCEPT;
 	}
 }
 
-static struct nf_hook_ops mc_nf_ops = {
-	.hook = mc_nf_br_hook,
+static struct nf_hook_ops dp_mcast_ops = {
+	.hook = dp_mcast_br_hook,
 	.hooknum = NF_BR_PRE_ROUTING,
 	.pf = NFPROTO_BRIDGE,
 	.priority = NF_BR_PRI_BRNF,
 };
 
-int __init mc_nf_init(void)
+int __init dp_mcast_init(void)
 {
 #if (KERNEL_VERSION(4, 13, 0) > LINUX_VERSION_CODE)
-	return nf_register_hook(&mc_nf_ops);
+	return nf_register_hook(&dp_mcast_ops);
 #else
-	return nf_register_net_hook(&init_net, &mc_nf_ops);
+	return nf_register_net_hook(&init_net, &dp_mcast_ops);
 #endif
 }
 
-void __exit mc_nf_fini(void)
+void __exit dp_mcast_fini(void)
 {
 #if (KERNEL_VERSION(4, 13, 0) > LINUX_VERSION_CODE)
-	nf_unregister_hook(&mc_nf_ops);
+	nf_unregister_hook(&dp_mcast_ops);
 #else
-	nf_unregister_net_hook(&init_net, &mc_nf_ops);
+	nf_unregister_net_hook(&init_net, &dp_mcast_ops);
 #endif
 }
diff --git a/include/net/mcast_bridge_filter.h b/include/net/mcast_bridge_filter.h
index 1b0dcfd0886e..72952dc011e8 100644
--- a/include/net/mcast_bridge_filter.h
+++ b/include/net/mcast_bridge_filter.h
@@ -11,11 +11,11 @@
 #define __PON_MCC_MCNF_H
 
 /* Init the IGMP / MLD bridge filter. */
-int __init mc_nf_init(void);
+int __init dp_mcast_init(void);
 /* Uninit the IGMP / MLD bridge filter. */
-void __exit mc_nf_fini(void);
+void __exit dp_mcast_fini(void);
 
 /* Activate the IGMP / MLD bridge filter. */
-extern bool mc_nf_vlan_activate;
+extern bool dp_mcast_vlan_activate;
 
 #endif /* __PON_MCC_MCNF_H */
