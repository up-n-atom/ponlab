From 71361236e0d8c525d4d48455ec537aaf5e1078cd Mon Sep 17 00:00:00 2001
From: thampan <joby.thampan@intel.com>
Date: Fri, 10 Jan 2020 17:10:15 +0800
Subject: [PATCH] PONRTSYS-5710: GSWIP rmon clear US and DS stuck issue fix

---
 .../net/ethernet/lantiq/switch-api/gsw_flow_core.c    | 19 +++++++++++++++++++
 1 file changed, 19 insertions(+)

diff --git a/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c b/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c
index 5a7120027717..3f6379dc4bae 100644
--- a/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c
+++ b/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c
@@ -14153,6 +14153,17 @@ GSW_return_t GSW_RMON_Clear(void *cdev, GSW_RMON_clear_t *parm)
 				BM_RMON_GCTRL_RED_RES_SIZE, 0x1);
 		}
 
+		/* Disable all Logical ports CTP counter, otherwise
+		 * Upstream and Dowstream traffic will get stuck while
+		 * clear all
+		 */
+		for (index = 0; index < num_ports; index++) {
+			gsw_w32(cdev,
+				BM_PCFG_CNTEN_OFFSET + (index * 2),
+				BM_PCFG_CNTEN_SHIFT,
+				BM_PCFG_CNTEN_SIZE, 0x0);
+		}
+
 		/* Reset all port based RMON counter */
 		for (index = 0; index < num_ports; index++) {
 			pr_debug("Rmon clear for CTP RX/TX --Logical Port %u\n", index);
@@ -14175,6 +14186,14 @@ GSW_return_t GSW_RMON_Clear(void *cdev, GSW_RMON_clear_t *parm)
 			}
 		}
 
+		/* Enable back all Logical ports CTP counter */
+		for (index = 0; index < num_ports; index++) {
+			gsw_w32(cdev,
+				BM_PCFG_CNTEN_OFFSET + (index * 2),
+				BM_PCFG_CNTEN_SHIFT,
+				BM_PCFG_CNTEN_SIZE, 0x1);
+		}
+
 		break;
 
 	case GSW_RMON_PMAC_TYPE:
