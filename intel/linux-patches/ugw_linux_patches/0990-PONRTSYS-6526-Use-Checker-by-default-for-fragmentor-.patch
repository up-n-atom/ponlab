From ef2e5799447e24c71c7755b8d7ff726d9111305b Mon Sep 17 00:00:00 2001
From: Oren Bakshe <oren.bakshe@intel.com>
Date: Tue, 21 Jan 2020 14:36:54 +0200
Subject: [PATCH] PONRTSYS-6526: Use Checker by default for fragmentor flow

---
 drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c          | 3 +++
 drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr_debugfs.c  | 6 ++++--
 drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr_internal.h | 1 +
 3 files changed, 8 insertions(+), 2 deletions(-)

diff --git a/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c b/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c
index 0a101df46e89..8325eb34babb 100644
--- a/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c
+++ b/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c
@@ -2724,6 +2724,9 @@ static s32 __smgr_frag_si_ud_set(struct sess_info *sess)
 		}
 	}
 
+	if (__smgr_is_pppoe_encap(sess))
+		frag_info.flags |= FRAG_INFO_FLAG_PPPOE;
+
 	ret = pp_port_tx_max_pkt_size_get(sess->args->eg_port,
 					  &frag_info.max_pkt_size);
 	if (unlikely(ret)) {
diff --git a/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr_debugfs.c b/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr_debugfs.c
index 8c8779101675..01a077cce75c 100644
--- a/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr_debugfs.c
+++ b/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr_debugfs.c
@@ -354,7 +354,7 @@ void __smgr_dbg_session_si_dump(struct seq_file *f)
 		if (test_bit(SESS_FLAG_MTU_CHCK, &info.flags)) {
 			frag_info = (struct si_ud_frag_info *)
 				    &si.ud[PP_PS_REGION_SZ];
-			seq_printf(f, " %-20s: %u (INT_DF %d (IGNORE %d), EXT_DF %d (IGNORE %d), FRAG_EXT %d, IPV4 %d)\n",
+			seq_printf(f, " %-20s: %u (INT_DF %d (IGNORE %d), EXT_DF %d (IGNORE %d), FRAG_EXT %d, IPV4 %d, PPPOE %d)\n",
 				   "frag.flags", frag_info->flags,
 				   !!(frag_info->flags &
 				      FRAG_INFO_FLAG_INT_DF),
@@ -366,7 +366,9 @@ void __smgr_dbg_session_si_dump(struct seq_file *f)
 				      FRAG_INFO_FLAG_IGNORE_EXT_DF),
 				   !!(frag_info->flags &
 				      FRAG_INFO_FLAG_FRAG_EXT),
-				   !!(frag_info->flags & FRAG_INFO_FLAG_IPV4));
+				   !!(frag_info->flags & FRAG_INFO_FLAG_IPV4),
+				   !!(frag_info->flags &
+				      FRAG_INFO_FLAG_PPPOE));
 			seq_printf(f, " %-20s: %u\n", "frag.l3_off",
 				   frag_info->l3_off);
 			seq_printf(f, " %-20s: %u\n", "frag.dst_q",
diff --git a/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr_internal.h b/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr_internal.h
index 1790ebd744e0..7c1f9e386ce7 100644
--- a/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr_internal.h
+++ b/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr_internal.h
@@ -326,6 +326,7 @@ struct smgr_reass_uc_cpu_stats {
 #define FRAG_INFO_FLAG_IGNORE_EXT_DF    (BIT(3))
 #define FRAG_INFO_FLAG_FRAG_EXT         (BIT(4))
 #define FRAG_INFO_FLAG_IPV4             (BIT(5))
+#define FRAG_INFO_FLAG_PPPOE            (BIT(6))
 
 /**
  * struct si_ud_frag_info - Fragmentation info
