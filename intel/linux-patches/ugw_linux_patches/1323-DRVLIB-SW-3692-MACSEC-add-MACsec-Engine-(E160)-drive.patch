+ *
+ * @dev: pointer to e160 meta data
+ * @pnthr_sum: the pn_thold_sum structure for threshold summary
+ */
+int e160_get_egr_pn_thold_sum(struct e160_metadata *dev, struct pn_thold_sum *pnthr_sum);
+
