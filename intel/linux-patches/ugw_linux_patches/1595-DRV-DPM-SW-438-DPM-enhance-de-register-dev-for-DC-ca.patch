diff --git a/drivers/net/datapath/dpm/datapath_api.c b/drivers/net/datapath/dpm/datapath_api.c
index d937c8445166..c5f0ae8eb3bc 100644
--- a/drivers/net/datapath/dpm/datapath_api.c
+++ b/drivers/net/datapath/dpm/datapath_api.c
@@ -1433,13 +1433,26 @@ int32_t dp_register_dev_ext(int inst, struct module *owner, u32 port_id,
 			dp_notifier_invoke(inst, port_info->dev, port_id, 0,
 					   DP_EVENT_DE_REGISTER_DEV);
 			port_info->status = PORT_ALLOCATED;
-			DP_CB(inst, dev_platform_set)(inst, port_id, data,
-						      flags);
 #if !IS_ENABLED(CONFIG_INTEL_DATAPATH_HAL_GSWIP30)
+			cbm_data = kzalloc(sizeof(*cbm_data), GFP_ATOMIC);
+			if (!cbm_data)
+				goto exit;
+
+			if (dp_build_cqm_data(inst, port_id, cbm_data, data))
+				goto exit;
+
+			/* Free CQM resources allocated during dev register */
+			if (dp_cqm_port_alloc_complete(owner, port_info,
+						       port_id, cbm_data,
+						       DP_F_DEREGISTER))
+				goto exit;
+
 			p = get_dp_deqport_info(inst, port_info->deq_port_base);
 			if (p->ref_cnt_umt && !(--p->ref_cnt_umt))
 				remove_umt(inst, &port_info->umt);
 #endif
+			DP_CB(inst, dev_platform_set)(inst, port_id, data,
+						      flags);
 			res = DP_SUCCESS;
 		} else {
 			pr_err("(%s)de-register fail for status:%d,%s(%d)\n",
@@ -1447,57 +1460,42 @@ int32_t dp_register_dev_ext(int inst, struct module *owner, u32 port_id,
 			       port_info->status, "num_subif",
 			       port_info->num_subif);
 		}
-		DP_LIB_UNLOCK(&dp_lock);
-		return res;
+		goto exit;
 	}
 
 	/*register a device */
 	if (port_info->status != PORT_ALLOCATED) {
 		pr_err("register dev fail for %s for unknown status:%d\n",
 		       owner->name, port_info->status);
-		DP_LIB_UNLOCK(&dp_lock);
-		return DP_FAILURE;
+		res = DP_FAILURE;
+		goto exit;
 	}
 
 	if (port_info->owner != owner) {
 		pr_err("No matched owner(%s):%px->%px\n",
 		       owner->name, owner, port_info->owner);
-		DP_LIB_UNLOCK(&dp_lock);
-		return res;
+		goto exit;
 	}
 
 	DP_CB(inst, dev_platform_set)(inst, port_id, data, flags);
 	port_info->res_qid_base = data->qos_resv_q_base;
 	port_info->num_resv_q = data->num_resv_q;
 
-	cbm_data = devm_kzalloc(&g_dp_dev->dev, sizeof(*cbm_data), GFP_ATOMIC);
-	if (!cbm_data) {
-		DP_LIB_UNLOCK(&dp_lock);
-		return res;
-	}
+	cbm_data = kzalloc(sizeof(*cbm_data), GFP_ATOMIC);
+	if (!cbm_data)
+		goto exit;
 
-	res = dp_build_cqm_data(inst, port_id, cbm_data, data);
-	if (res == DP_FAILURE) {
-		devm_kfree(&g_dp_dev->dev, cbm_data);
-		DP_LIB_UNLOCK(&dp_lock);
-		return res;
-	}
+	if (dp_build_cqm_data(inst, port_id, cbm_data, data))
+		goto exit;
 
 	/* Register device to CQM */
 	if (dp_cqm_port_alloc_complete(owner, port_info, port_id, cbm_data,
-				       flags)) {
-		devm_kfree(&g_dp_dev->dev, cbm_data);
-		DP_LIB_UNLOCK(&dp_lock);
-		return DP_FAILURE;
-	}
+				       flags))
+		goto exit;
 
 	if (data->num_rx_ring || data->num_tx_ring) {
-		res = dp_register_dc(inst, port_id, cbm_data, data, flags);
-		if (res == DP_FAILURE) {
-			devm_kfree(&g_dp_dev->dev, cbm_data);
-			DP_LIB_UNLOCK(&dp_lock);
-			return res;
-		}
+		if (dp_register_dc(inst, port_id, cbm_data, data, flags))
+			goto exit;
 	}
 
 	/* TODO: Need a HAL layer API for CQM and DMA Setup for CQM QoS path
@@ -1510,10 +1508,12 @@ int32_t dp_register_dev_ext(int inst, struct module *owner, u32 port_id,
 	dp_notifier_invoke(inst, port_info->dev, port_id, 0,
 			   DP_EVENT_REGISTER_DEV);
 
-	DP_LIB_UNLOCK(&dp_lock);
-	devm_kfree(&g_dp_dev->dev, cbm_data);
+	res = DP_SUCCESS;
 
-	return DP_SUCCESS;
+exit:
+	kfree(cbm_data);
+	DP_LIB_UNLOCK(&dp_lock);
+	return res;
 }
 EXPORT_SYMBOL(dp_register_dev_ext);
 
@@ -2931,15 +2931,13 @@ void dp_cleanup_module(void)
 
 	if (dp_init_ok) {
 		DP_LIB_LOCK(&dp_lock);
-#if IS_ENABLED(CONFIG_INTEL_DATAPATH_MIB)
-		dp_mib_exit();
-#endif
 		for (i = 0; i < dp_inst_num; i++) {
 			DP_CB(i, dp_platform_set)(i, DP_PLATFORM_DE_INIT);
 			free_dma_chan_tbl(i);
 			free_dp_port_subif_info(i);
 		}
 		dp_init_ok = 0;
+
 #if IS_ENABLED(CONFIG_INTEL_DATAPATH_CPUFREQ)
 		dp_cpufreq_notify_exit();
 #endif
