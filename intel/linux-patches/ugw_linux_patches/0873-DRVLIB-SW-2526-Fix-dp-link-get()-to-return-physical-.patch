From 2b976c62e9aa96ec972c9038d012009a3ede0c7e Mon Sep 17 00:00:00 2001
From: Rekha Eswaran <rekha.eswaran@intel.com>
Date: Thu, 28 Nov 2019 09:41:48 +0800
Subject: [PATCH] DRVLIB_SW-2526 - Fix dp_link_get() to return physical CQM DQ
 port instead of nodeid

---
 drivers/net/datapath/dpm/gswip31/datapath_ppv4_api.c | 12 ++++--------
 1 file changed, 4 insertions(+), 8 deletions(-)

diff --git a/drivers/net/datapath/dpm/gswip31/datapath_ppv4_api.c b/drivers/net/datapath/dpm/gswip31/datapath_ppv4_api.c
index 916235d4e74c..7353f45bbb54 100644
--- a/drivers/net/datapath/dpm/gswip31/datapath_ppv4_api.c
+++ b/drivers/net/datapath/dpm/gswip31/datapath_ppv4_api.c
@@ -2239,10 +2239,6 @@ static int dp_map_qid_to_cqmdeq(struct dp_node_link *info, int flag)
 		dp_link_get_31(&q_link, 0);
 		DP_DEBUG(DP_DBG_FLAG_QOS, "Parent PORT[%d]\n",
 			 q_link.cqm_deq_port);
-		q_link.cqm_deq_port =
-			get_cqm_deq_port_by_node(info->inst,
-						 q_link.cqm_deq_port,
-						 flag);
 		cqm_qid2ep_map_set(q_link.q_id, q_link.cqm_deq_port);
 		DP_DEBUG(DP_DBG_FLAG_QOS, "%s qid:%d, dq_port:%d\n",
 			 "cqm_qid2ep_map_set", q_link.q_id,
@@ -2262,10 +2258,6 @@ static int dp_map_qid_to_cqmdeq(struct dp_node_link *info, int flag)
 				dp_link_get_31(&q_link, 0);
 				DP_DEBUG(DP_DBG_FLAG_QOS, "Parent PORT[%d]\n",
 					 q_link.cqm_deq_port);
-				q_link.cqm_deq_port =
-				get_cqm_deq_port_by_node(info->inst,
-							 q_link.cqm_deq_port,
-							 flag);
 				cqm_qid2ep_map_set(q_link.q_id,
 						   q_link.cqm_deq_port);
 				DP_DEBUG(DP_DBG_FLAG_QOS,
@@ -3603,6 +3595,10 @@ int dp_link_get_31(struct dp_qos_link *cfg, int flag)
 		}
 		cfg->cqm_deq_port =
 			priv->qos_sch_stat[cfg->sch[i].id].parent.node_id;
+		cfg->cqm_deq_port =
+			get_cqm_deq_port_by_node(cfg->inst,
+						 cfg->cqm_deq_port,
+						 0);
 		return DP_SUCCESS;
 	}
 	return DP_FAILURE;
