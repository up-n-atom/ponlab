From 19d0fd1a8991d68c28a3850bede60bd3dd09bf2c Mon Sep 17 00:00:00 2001
From: Lishan Liu <lishan.liu@intel.com>
Date: Thu, 10 Jun 2021 13:40:25 +0800
Subject: [PATCH] PONRTSYS-9069: PRX CQM increase FSQM buffer to 896KB

---
 drivers/net/ethernet/lantiq/cqm/prx300/cqm.c        | 2 +-
 drivers/net/ethernet/lantiq/cqm/prx300/cqm_config.h | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/drivers/net/ethernet/lantiq/cqm/prx300/cqm.c b/drivers/net/ethernet/lantiq/cqm/prx300/cqm.c
index c6dfe5366641..a8eeb237241c 100644
--- a/drivers/net/ethernet/lantiq/cqm/prx300/cqm.c
+++ b/drivers/net/ethernet/lantiq/cqm/prx300/cqm.c
@@ -3329,7 +3329,7 @@ static void cqm_cpu_free_tasklet(unsigned long cpu)
 int is_fsqm(u32 desc2)
 {
 	if ((desc2 >= (u32)(CQM_SRAM_BASE)) &&
-	    (desc2 <= (u32)(CQM_SRAM_BASE + CQM_SRAM_SIZE)))
+	    (desc2 < (u32)(CQM_SRAM_BASE + CQM_SRAM_SIZE)))
 		return 1;
 	return 0;
 }
diff --git a/drivers/net/ethernet/lantiq/cqm/prx300/cqm_config.h b/drivers/net/ethernet/lantiq/cqm/prx300/cqm_config.h
index 2c235495c47c..7bad13c7290c 100644
--- a/drivers/net/ethernet/lantiq/cqm/prx300/cqm_config.h
+++ b/drivers/net/ethernet/lantiq/cqm/prx300/cqm_config.h
@@ -8,7 +8,7 @@
 #define CQM_PRX300_POOL_POL_HDR_SIZE	4
 #define CQM_QIDT_DW_NUM	0x1000
 #define CQM_QID2EP_DW_NUM	0x100
-#define CQM_SRAM_SIZE	0xC0000
+#define CQM_SRAM_SIZE	0xE0000
 #define CQM_SRAM_FRM_SIZE 128
 #define CQM_CPU_POOL_BUF_ALW_NUM	128
 #define CQM_SRAM_BASE	0x18D00000
