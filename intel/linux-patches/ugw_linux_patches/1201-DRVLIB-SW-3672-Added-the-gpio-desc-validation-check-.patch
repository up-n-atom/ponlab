From 2be66877c6ccd59979415757e8e86308fc000cfc Mon Sep 17 00:00:00 2001
From: arathinx <ayyappanx.rathinam@intel.com>
Date: Sat, 6 Jun 2020 23:13:22 +0800
Subject: [PATCH] DRVLIB_SW-3672: Added the gpio_desc validation check in
 pinctrl driver

---
 drivers/pinctrl/pinctrl-equilibrium.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/pinctrl/pinctrl-equilibrium.c b/drivers/pinctrl/pinctrl-equilibrium.c
index 2ed8a9b3df93..da82f9ba5983 100644
--- a/drivers/pinctrl/pinctrl-equilibrium.c
+++ b/drivers/pinctrl/pinctrl-equilibrium.c
@@ -1407,7 +1407,7 @@ static int pinbank_probe(struct intel_pinctrl_drv_data *drvdata)
 			pinbank_init(np_bank, drvdata, banks + i, i);
 			prop = of_find_property(np_bank,
 						EQBR_PINBANK_GPIO_CTRL, NULL);
-			if (prop) {
+			if ((prop)&&(gpio_desc)) {
 				phandle = be32_to_cpup(prop->value);
 				gpio_desc[i].node
 					= of_find_node_by_phandle(phandle);
