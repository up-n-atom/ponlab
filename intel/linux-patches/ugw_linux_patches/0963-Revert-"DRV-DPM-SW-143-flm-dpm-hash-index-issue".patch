From aeafb627ceaa66884c0e680b29877d40962fd313 Mon Sep 17 00:00:00 2001
From: mglowacx <michalx.glowacki@intel.com>
Date: Fri, 24 Jan 2020 15:54:48 +0100
Subject: [PATCH] Revert "DRV_DPM_SW-143-flm-dpm-hash-index-issue"

---
 drivers/net/datapath/dpm/datapath_instance.c | 14 ++++++++++++--
 drivers/net/datapath/dpm/datapath_instance.h |  6 ++++--
 drivers/net/datapath/dpm/datapath_swdev.c    | 10 ++++------
 drivers/net/datapath/dpm/datapath_swdev.h    |  6 +++++-
 4 files changed, 25 insertions(+), 11 deletions(-)

diff --git a/drivers/net/datapath/dpm/datapath_instance.c b/drivers/net/datapath/dpm/datapath_instance.c
index 2ca65b43196e..df0e6276eff2 100644
--- a/drivers/net/datapath/dpm/datapath_instance.c
+++ b/drivers/net/datapath/dpm/datapath_instance.c
@@ -179,7 +179,14 @@ struct dp_hw_cap *match_hw_cap(struct dp_inst_info *info, u32 flag)
  */
 u32 dp_dev_hash(struct net_device *dev, char *subif_name)
 {
-	return hash_ptr(dev ? dev : subif_name, DP_DEV_HASH_BIT_LENGTH);
+	unsigned long index;
+
+	if (!dev)
+		index = (unsigned long)subif_name;
+	else
+		index = (unsigned long)dev;
+	/*Note: it is 4K alignment. Need tune later */
+	return (u32)((index >> DP_DEV_HASH_SHIFT) % DP_DEV_HASH_SIZE);
 }
 
 struct dp_dev *dp_dev_lookup(struct hlist_head *head,
@@ -382,7 +389,10 @@ int dp_inst_del_dev(struct net_device *dev, char *subif_name, int inst, int ep,
 
 u32 dp_mod_hash(struct module *owner, u16 ep)
 {
-	return hash_ptr(owner, DP_MOD_HASH_BIT_LENGTH);
+	unsigned long index;
+
+	index = (unsigned long)owner;
+	return (u32)(((index >> DP_MOD_HASH_SHIFT) % DP_MOD_HASH_SIZE) | ep);
 }
 
 struct dp_mod *dp_mod_lookup(struct hlist_head *head, struct module *owner,
diff --git a/drivers/net/datapath/dpm/datapath_instance.h b/drivers/net/datapath/dpm/datapath_instance.h
index 22d86ccbb6d6..3ecc4c623c41 100644
--- a/drivers/net/datapath/dpm/datapath_instance.h
+++ b/drivers/net/datapath/dpm/datapath_instance.h
@@ -13,11 +13,13 @@
 extern int dp_cap_num;
 extern struct dp_hw_cap hw_cap_list[DP_MAX_HW_CAP];
 
+#define DP_DEV_HASH_SHIFT 8
 #define DP_DEV_HASH_BIT_LENGTH 10
-#define DP_DEV_HASH_SIZE (1 << DP_DEV_HASH_BIT_LENGTH)
+#define DP_DEV_HASH_SIZE ((1 << DP_DEV_HASH_BIT_LENGTH) - 1)
 
+#define DP_MOD_HASH_SHIFT 8
 #define DP_MOD_HASH_BIT_LENGTH 10
-#define DP_MOD_HASH_SIZE (1 << DP_MOD_HASH_BIT_LENGTH)
+#define DP_MOD_HASH_SIZE ((1 << DP_MOD_HASH_BIT_LENGTH) - 1)
 
 #define NO_NEED_PMAC(flags)  ((flags & \
 		(DP_F_FAST_WLAN | DP_F_FAST_DSL)) && \
diff --git a/drivers/net/datapath/dpm/datapath_swdev.c b/drivers/net/datapath/dpm/datapath_swdev.c
index 2716858cd585..0659f484133d 100644
--- a/drivers/net/datapath/dpm/datapath_swdev.c
+++ b/drivers/net/datapath/dpm/datapath_swdev.c
@@ -53,13 +53,11 @@ static inline void swdev_unlock(void)
 
 u16 dp_swdev_cal_hash(unsigned char *name)
 {
-	unsigned long hash = init_name_hash(name);
+	size_t hash = 5381;
 
-	if (name) {
-		while (*name)
-			hash = partial_name_hash(*name++, hash);
-	}
-	return hash_long(hash, BRIDGE_ID_ENTRY_HASH_LENGTH);
+	while (*name)
+		hash = 33 * hash ^ (unsigned char)*name++;
+	return (u16)(hash & 0x3F);
 }
 
 /* dp_kfree - used as destructor for
diff --git a/drivers/net/datapath/dpm/datapath_swdev.h b/drivers/net/datapath/dpm/datapath_swdev.h
index 2c9d0c17b66e..42c9d70a545c 100644
--- a/drivers/net/datapath/dpm/datapath_swdev.h
+++ b/drivers/net/datapath/dpm/datapath_swdev.h
@@ -10,8 +10,12 @@
 #define ENABLE 1
 #define DISABLE 0
 
-#define BRIDGE_ID_ENTRY_HASH_LENGTH 6
+#define BRIDGE_ID_ENTRY_HASH_SHIFT			0
+#define BRIDGE_ID_ENTRY_HASH_LENGTH			6
+#define BRIDGE_ID_ENTRY_HASH_MASK ((BIT(BRIDGE_ID_ENTRY_HASH_LENGTH)) - 1)
 #define BR_ID_ENTRY_HASH_TABLE_SIZE BIT(BRIDGE_ID_ENTRY_HASH_LENGTH)
+#define BRIDGE_ID_ENTRY_HASH_TABLE_VALUE(x) \
+	(((u32)(x) >> BRIDGE_ID_ENTRY_HASH_SHIFT) & BRIDGE_ID_ENTRY_HASH_MASK)
 
 #define ADD_BRENTRY	0x00000001
 #define DEL_BRENTRY	0x00000002
