-int lookup_dump31(struct seq_file *s, int pos)
-{
-	if (!capable(CAP_NET_ADMIN))
-		return -EPERM;
-	if (find_pattern(pos, s, -1) < 0)
-		return pos;
-	pos++;
-	if (pos >= 16)
-		pos = -1;
-	return pos;
-}
