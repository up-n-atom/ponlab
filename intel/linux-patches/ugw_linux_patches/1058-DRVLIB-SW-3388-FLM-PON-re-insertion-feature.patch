From 5f4add1ae83ae50aff9b9eb02f6f44ad09f9bdd4 Mon Sep 17 00:00:00 2001
From: arathinx <ayyappanx.rathinam@intel.com>
Date: Wed, 12 Feb 2020 17:20:19 +0800
Subject: [PATCH] DRVLIB_SW-3388: FLM PON re-insertion feature

---
 drivers/net/ethernet/lantiq/cqm/cqm_dev.c           |  5 +++++
 drivers/net/ethernet/lantiq/cqm/cqm_dev.h           |  1 +
 drivers/net/ethernet/lantiq/cqm/prx300/cqm.c        | 20 ++++++++++++++++++++
 drivers/net/ethernet/lantiq/cqm/prx300/cqm.h        |  2 ++
 drivers/net/ethernet/lantiq/cqm/prx300/cqm_config.c | 10 ++++++++++
 include/net/lantiq_cbm_api.h                        |  2 ++
 6 files changed, 40 insertions(+)

diff --git a/drivers/net/ethernet/lantiq/cqm/cqm_dev.c b/drivers/net/ethernet/lantiq/cqm/cqm_dev.c
index fb1a272b5520..ed1e35598936 100755
--- a/drivers/net/ethernet/lantiq/cqm/cqm_dev.c
+++ b/drivers/net/ethernet/lantiq/cqm/cqm_dev.c
@@ -131,6 +131,11 @@ struct device_node *parse_dts(int j, void **pdata, struct resource **res,
 	if (of_property_read_s32(node, "intel,highprio-lan",
 				 &cqm_pdata->highprio_lan))
 		cqm_pdata->highprio_lan = -1;
+
+	if (of_property_read_u32(node, "intel,re-insertion",
+				 &cqm_pdata->re_insertion))
+		cqm_pdata->re_insertion = -1;
+
 	return node;
 
 err_free_pdata:
diff --git a/drivers/net/ethernet/lantiq/cqm/cqm_dev.h b/drivers/net/ethernet/lantiq/cqm/cqm_dev.h
index 38c2d125996f..6b5d96da18a3 100644
--- a/drivers/net/ethernet/lantiq/cqm/cqm_dev.h
+++ b/drivers/net/ethernet/lantiq/cqm/cqm_dev.h
@@ -50,5 +50,6 @@ struct cqm_data {
 	u32 num_dq_port;
 	int gint_mode;
 	int highprio_lan;
+	int re_insertion;
 };
 #endif
diff --git a/drivers/net/ethernet/lantiq/cqm/prx300/cqm.c b/drivers/net/ethernet/lantiq/cqm/prx300/cqm.c
index fbe87281b1f8..af165fc26fa9 100644
--- a/drivers/net/ethernet/lantiq/cqm/prx300/cqm.c
+++ b/drivers/net/ethernet/lantiq/cqm/prx300/cqm.c
@@ -50,6 +50,8 @@ static s32 cqm_dma_port_enable(s32 cqm_port_id, u32 flags, s32 type);
 static s32 cqm_dq_dma_chan_init(s32 cqm_port_id, u32 flags);
 static void init_cqm_deq_cpu_port(int idx, u32 tx_ring_size);
 static s32 cqm_dequeue_dma_port_uninit(s32 cqm_port_id, u32 flags);
+static void fill_dp_alloc_data(struct cbm_dp_alloc_data *data, int dp,
+			       int port, u32 flags);
 
 #ifdef ENABLE_LL_DEBUG
 static void do_cbm_debug_tasklet(unsigned long cpu);
@@ -1897,6 +1899,11 @@ s32 cqm_cpu_port_get(struct cbm_cpu_port_data *data, u32 flags)
 		ptr->tx_ring_offset = TXPUSH_CMD_RX_EGP_1;
 		ptr->tx_pkt_credit = dqm_port_info[i].dq_txpush_num;
 	}
+
+	if (cqm_ctrl->re_insertion > 0)
+		fill_dp_alloc_data(&data->re_insertion, 0,
+				   DMA_PORT_RE_INSERTION, 0);
+
 	return CBM_SUCCESS;
 }
 
@@ -4263,6 +4270,15 @@ bool fsqm_check(uint16_t len)
 	return pass;
 }
 
+static void cqm_enable_re_insertion_port(s32 portid)
+{
+	struct cbm_dp_alloc_data data = {0};
+
+	/* Fill the DMA channels and enable */
+	fill_dp_alloc_data(&data, 0, DMA_PORT_RE_INSERTION, 0);
+	handle_dma_chnl_init(DMA_PORT_RE_INSERTION, 0);
+}
+
 static int cqm_prx300_probe(struct platform_device *pdev)
 {
 	struct resource *res[PRX300_MAX_RESOURCE] = {NULL};
@@ -4409,6 +4425,10 @@ static int cqm_prx300_probe(struct platform_device *pdev)
 		}
 	}
 
+	cqm_ctrl->re_insertion = pdata->re_insertion;
+	if (cqm_ctrl->re_insertion > 0)
+		cqm_enable_re_insertion_port(cqm_ctrl->re_insertion);
+
 #if 1
 	for_each_online_cpu(i)
 		tasklet_init(&cqm_ctrl->cqm_tasklet[i],
diff --git a/drivers/net/ethernet/lantiq/cqm/prx300/cqm.h b/drivers/net/ethernet/lantiq/cqm/prx300/cqm.h
index 11a56dfd3fcd..cd69303c5aab 100644
--- a/drivers/net/ethernet/lantiq/cqm/prx300/cqm.h
+++ b/drivers/net/ethernet/lantiq/cqm/prx300/cqm.h
@@ -39,6 +39,7 @@
 #define FLAG_PIB_BYPASS		BIT(5)
 #define FLAG_PIB_DELAY		BIT(6)
 #define FLAG_PIB_PKT_LEN_ADJ	BIT(7)
+#define DMA_PORT_RE_INSERTION	23
 #define DMA_PORT_FOR_FLUSH 25
 #define PRX300_CQM_DROP_Q	0x0
 #define PRX300_CQM_Q_MASK	0xff
@@ -616,6 +617,7 @@ struct cqm_ctrl {
 	u32 prx300_pool_ptrs[CQM_PRX300_NUM_BM_POOLS];
 	u32 prx300_pool_size[CQM_PRX300_NUM_BM_POOLS];
 	int gint_mode;
+	int re_insertion;
 };
 
 struct cqm_buf_dbg_cnt {
diff --git a/drivers/net/ethernet/lantiq/cqm/prx300/cqm_config.c b/drivers/net/ethernet/lantiq/cqm/prx300/cqm_config.c
index b2ace1524ba0..199d6ee05a29 100644
--- a/drivers/net/ethernet/lantiq/cqm/prx300/cqm_config.c
+++ b/drivers/net/ethernet/lantiq/cqm/prx300/cqm_config.c
@@ -147,6 +147,16 @@ const struct cqm_config prx300_cqm_config[] = {
 	.data.dqm_dma.txpush_desc = 8,
 	},
 	{
+	.type = DQM_DMA_TYPE,
+	.data.dqm_dma.port = DMA_PORT_RE_INSERTION,
+	.data.dqm_dma.port_range = 0,
+	.data.dqm_dma.dma_ctrl = 1,
+	.data.dqm_dma.dma_chan = 16,
+	.data.dqm_dma.port_enable = 1,
+	.data.dqm_dma.num_desc = 8,
+	.data.dqm_dma.txpush_desc = 8,
+	},
+	{
 	.type = DQM_PON_TYPE,
 	.data.dqm_dma.port = 26,
 	.data.dqm_dma.port_range = 0,
diff --git a/include/net/lantiq_cbm_api.h b/include/net/lantiq_cbm_api.h
index c3ef22c0655b..0ed55858ee97 100644
--- a/include/net/lantiq_cbm_api.h
+++ b/include/net/lantiq_cbm_api.h
@@ -593,6 +593,8 @@ struct cbm_cpu_port_data {
 	struct cbm_tx_push dq_tx_flush_info;
 	/*output: deq_port = -1 means not valid*/
 	struct cbm_tx_push dq_tx_push_info[CQM_MAX_CPU];
+	/* re-insertion port */
+	struct cbm_dp_alloc_data re_insertion;
 };
 
 struct pib_stat {
