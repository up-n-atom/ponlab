From e538ec07713ca36c2c45dd5467d36ecd7e9992d5 Mon Sep 17 00:00:00 2001
From: thampan <joby.thampan@intel.com>
Date: Thu, 27 Feb 2020 16:13:37 +0800
Subject: [PATCH] DRV_DPM_SW-183: Transparent Bridging work for Prx300

---
 drivers/net/ethernet/lantiq/intel_pon_hgu_vuni.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/net/ethernet/lantiq/intel_pon_hgu_vuni.c b/drivers/net/ethernet/lantiq/intel_pon_hgu_vuni.c
index ae7e9cf4aa5e..2ffb243e1e86 100644
--- a/drivers/net/ethernet/lantiq/intel_pon_hgu_vuni.c
+++ b/drivers/net/ethernet/lantiq/intel_pon_hgu_vuni.c
@@ -339,7 +339,7 @@ static int vuni_init(struct net_device *dev)
 	if (priv->vani == 1) {
 		priv->dp_subif.subif = -1;
 		priv->dp_subif.port_id = priv->dp_port_id;
-		data.flag_ops = DP_SUBIF_VANI;
+		data.flag_ops = DP_SUBIF_VANI | DP_SUBIF_SWDEV;
 		ret = dp_register_subif_ext(0, priv->owner,
 					    dev, dev->name, &priv->dp_subif,
 					    &data, 0);
