From 253d8e883bf491e24c445e49700671e660b13f72 Mon Sep 17 00:00:00 2001
From: Rekha Eswaran <rekha.eswaran@intel.com>
Date: Fri, 23 Oct 2020 18:39:41 +0800
Subject: [PATCH] PONRTSYS-1919 - Support PON meter testing & fix changes for
 its config in DPM

---
 drivers/net/datapath/dpm/gswip31/datapath_gswip.c | 59 +++++++++--------------
 include/net/datapath_api_qos.h                    |  4 ++
 2 files changed, 28 insertions(+), 35 deletions(-)

diff --git a/drivers/net/datapath/dpm/gswip31/datapath_gswip.c b/drivers/net/datapath/dpm/gswip31/datapath_gswip.c
index 3bcb0e3c6d88..34a805862d33 100644
--- a/drivers/net/datapath/dpm/gswip31/datapath_gswip.c
+++ b/drivers/net/datapath/dpm/gswip31/datapath_gswip.c
@@ -10,12 +10,12 @@
 #include "../datapath.h"
 #include "datapath_misc.h"
 
-#define BP_CFG(bp_cfg, _index, bflag, id) ({ \
+#define BP_CFG(bp_cfg, _index, id, bflag) ({ \
 	typeof(_index) (index) = (_index); \
 	(bp_cfg)->bEgressSubMeteringEnable[(index)] = bflag; \
 	(bp_cfg)->nEgressTrafficSubMeterId[(index)] = id; })
 
-#define BR_CFG(br_cfg, _index, bflag, id) ({\
+#define BR_CFG(br_cfg, _index, id, bflag) ({\
 	typeof(_index) (index) = (_index); \
 	(br_cfg)->bSubMeteringEnable[(index)] = bflag; \
 	(br_cfg)->nTrafficSubMeterId[(index)] = id; })
@@ -1186,8 +1186,7 @@ int dp_meter_add_31(struct net_device *dev,  struct dp_meter_cfg  *meter,
 
 	if (flag & DP_METER_ATTACH_PCE) {
 		/* pattern setting */
-		pce_rule = devm_kzalloc(&g_dp_dev->dev,
-					sizeof(GSW_PCE_rule_t), GFP_ATOMIC);
+		pce_rule = kzalloc(sizeof(GSW_PCE_rule_t), GFP_ATOMIC);
 		if (!pce_rule) {
 			pr_err("pce_rule alloc failed\n");
 			goto err;
@@ -1209,9 +1208,7 @@ int dp_meter_add_31(struct net_device *dev,  struct dp_meter_cfg  *meter,
 			pr_err("can't use CTP,pmapper is enable\n");
 			goto err;
 		}
-		ctp_cfg = devm_kzalloc(&g_dp_dev->dev,
-				       sizeof(GSW_CTP_portConfig_t),
-				       GFP_ATOMIC);
+		ctp_cfg = kzalloc(sizeof(GSW_CTP_portConfig_t), GFP_ATOMIC);
 		if (!ctp_cfg) {
 			pr_err("ctp_cfg alloc failed\n");
 			goto err;
@@ -1254,14 +1251,15 @@ int dp_meter_add_31(struct net_device *dev,  struct dp_meter_cfg  *meter,
 			pr_err("flag_bp value 0\n");
 			goto err;
 		}
-		bp_cfg = devm_kzalloc(&g_dp_dev->dev,
-				      sizeof(GSW_BRIDGE_portConfig_t),
-				      GFP_ATOMIC);
+		bp_cfg = kzalloc(sizeof(GSW_BRIDGE_portConfig_t), GFP_ATOMIC);
 		if (!bp_cfg) {
 			pr_err("bp_cfg alloc failed\n");
 			goto err;
 		}
 		bp_cfg->nBridgePortId = mtr_subif->subif.bport;
+		if (meter->dir == DP_DIR_EGRESS)
+			bp_cfg->eMask =
+				GSW_BRIDGE_PORT_CONFIG_MASK_EGRESS_SUB_METER;
 		ret = gsw_bp->BridgePort_ConfigGet(gsw_handle, bp_cfg);
 		if (ret != GSW_statusOk) {
 			pr_err("BridgePort_ConfigGet API failed :%d\n", ret);
@@ -1306,9 +1304,7 @@ int dp_meter_add_31(struct net_device *dev,  struct dp_meter_cfg  *meter,
 			goto err;
 		}
 	} else if (flag & DP_METER_ATTACH_BRIDGE) {
-		br_cfg = devm_kzalloc(&g_dp_dev->dev,
-				      sizeof(GSW_BRIDGE_config_t),
-				      GFP_ATOMIC);
+		br_cfg = kzalloc(sizeof(GSW_BRIDGE_config_t), GFP_ATOMIC);
 		if (!br_cfg) {
 			pr_err("br_cfg alloc failed\n");
 			goto err;
@@ -1348,10 +1344,10 @@ int dp_meter_add_31(struct net_device *dev,  struct dp_meter_cfg  *meter,
 	}
 	bret = 0;
 err:
-	devm_kfree(&g_dp_dev->dev, br_cfg);
-	devm_kfree(&g_dp_dev->dev, bp_cfg);
-	devm_kfree(&g_dp_dev->dev, ctp_cfg);
-	devm_kfree(&g_dp_dev->dev, pce_rule);
+	kfree(br_cfg);
+	kfree(bp_cfg);
+	kfree(ctp_cfg);
+	kfree(pce_rule);
 	return bret;
 }
 
@@ -1382,8 +1378,7 @@ int dp_meter_del_31(struct net_device *dev,  struct dp_meter_cfg  *meter,
 	gsw_bp = &gsw_handle->gsw_brdgport_ops;
 	gsw_brdg = &gsw_handle->gsw_brdg_ops;
 	if (meter->dir & DP_METER_ATTACH_PCE) {
-		pce_rule = devm_kzalloc(&g_dp_dev->dev, sizeof(GSW_PCE_ruleDelete_t),
-					GFP_ATOMIC);
+		pce_rule = kzalloc(sizeof(GSW_PCE_ruleDelete_t), GFP_ATOMIC);
 		if (!pce_rule) {
 			pr_err("pce_rule alloc failed\n");
 			bret = DP_FAILURE;
@@ -1404,9 +1399,7 @@ int dp_meter_del_31(struct net_device *dev,  struct dp_meter_cfg  *meter,
 			pr_err("flag_pmapper is set\n");
 			goto err;
 		}
-		ctp_cfg = devm_kzalloc(&g_dp_dev->dev,
-				       sizeof(GSW_CTP_portConfig_t),
-				       GFP_ATOMIC);
+		ctp_cfg = kzalloc(sizeof(GSW_CTP_portConfig_t), GFP_ATOMIC);
 		if (!ctp_cfg) {
 			pr_err("ctp_cfg alloc failed\n");
 			goto err;
@@ -1445,14 +1438,15 @@ int dp_meter_del_31(struct net_device *dev,  struct dp_meter_cfg  *meter,
 			pr_err("flag_bp is 0\n");
 			goto err;
 		}
-		bp_cfg = devm_kzalloc(&g_dp_dev->dev,
-				      sizeof(GSW_BRIDGE_portConfig_t),
-				      GFP_ATOMIC);
+		bp_cfg = kzalloc(sizeof(GSW_BRIDGE_portConfig_t), GFP_ATOMIC);
 		if (!bp_cfg) {
 			pr_err("bp_cfg alloc failed\n");
 			goto err;
 		}
 		bp_cfg->nBridgePortId = mtr_subif->subif.bport;
+		if (meter->dir == DP_DIR_EGRESS)
+			bp_cfg->eMask =
+				GSW_BRIDGE_PORT_CONFIG_MASK_EGRESS_SUB_METER;
 		ret = gsw_bp->BridgePort_ConfigGet(gsw_handle, bp_cfg);
 		if (ret != GSW_statusOk) {
 			pr_err("BridgePort_ConfigGet API failed\n");
@@ -1495,8 +1489,7 @@ int dp_meter_del_31(struct net_device *dev,  struct dp_meter_cfg  *meter,
 		}
 	}
 	if (flag & DP_METER_ATTACH_BRIDGE) {
-		br_cfg = devm_kzalloc(&g_dp_dev->dev,
-				      sizeof(GSW_BRIDGE_config_t), GFP_ATOMIC);
+		br_cfg = kzalloc(sizeof(GSW_BRIDGE_config_t), GFP_ATOMIC);
 		if (!br_cfg) {
 			pr_err("br_cfg alloc failed\n");
 			goto err;
@@ -1537,14 +1530,10 @@ int dp_meter_del_31(struct net_device *dev,  struct dp_meter_cfg  *meter,
 
 	bret = 0;
 err:
-	if (br_cfg)
-		devm_kfree(&g_dp_dev->dev, br_cfg);
-	if (bp_cfg)
-		devm_kfree(&g_dp_dev->dev, bp_cfg);
-	if (ctp_cfg)
-		devm_kfree(&g_dp_dev->dev, ctp_cfg);
-	if (pce_rule)
-		devm_kfree(&g_dp_dev->dev, pce_rule);
+	kfree(br_cfg);
+	kfree(bp_cfg);
+	kfree(ctp_cfg);
+	kfree(pce_rule);
 	return bret;
 }
 
diff --git a/include/net/datapath_api_qos.h b/include/net/datapath_api_qos.h
index 6b9ddf160856..6174b484807b 100644
--- a/include/net/datapath_api_qos.h
+++ b/include/net/datapath_api_qos.h
@@ -1123,12 +1123,16 @@ enum dp_meter_type {
 
 /*! Enumeration for traffic types needed for flow and bridge meters config */
 enum dp_meter_traffic_type {
+	/*!< All traffic */
+	DP_OTHERS,
 	/*!< Unicast traffic with no destination address */
 	DP_UKNOWN_UNICAST,
 	/*!< Upstream multicast traffic */
 	DP_MULTICAST,
 	/*!< Upstream broadcast traffic */
 	DP_BROADCAST,
+	/*!< All traffic flows */
+	DP_TRAFFIC_TYPE_MAX,
 };
 
 /*!
