From 64c2e3e7307cadc0ecd9ed743411e2787a5b84fb Mon Sep 17 00:00:00 2001
From: Robert Dabrowski <robertx.dabrowski@intel.com>
Date: Thu, 6 Feb 2020 10:15:25 +0100
Subject: [PATCH] PONRTSYS-5867:HW counter overflow handling - deregister
 notify CB - use cb_id

---
 drivers/net/datapath/dpm/datapath_notifier.c       |  2 +-
 .../net/datapath/mib_counters/dp_mib_counters.c    | 42 ++++++++++++----------
 2 files changed, 24 insertions(+), 20 deletions(-)

diff --git a/drivers/net/datapath/dpm/datapath_notifier.c b/drivers/net/datapath/dpm/datapath_notifier.c
index ef9d97b9b510..fb658fd75407 100644
--- a/drivers/net/datapath/dpm/datapath_notifier.c
+++ b/drivers/net/datapath/dpm/datapath_notifier.c
@@ -353,7 +353,7 @@ int unregister_dp_event_notifier(struct dp_event *info)
 
 	atomic_notifier_chain_unregister(&dp_evt_notif_list, evt_notif->nb);
 	devm_kfree(&g_dp_dev->dev, evt_notif->nb);
-	/* devm_kfree(&g_dp_dev->dev, evt_notif); */
+	devm_kfree(&g_dp_dev->dev, evt_notif);
 
 	return 0;
 }
diff --git a/drivers/net/datapath/mib_counters/dp_mib_counters.c b/drivers/net/datapath/mib_counters/dp_mib_counters.c
index 28adb635f01f..3df646e209a2 100644
--- a/drivers/net/datapath/mib_counters/dp_mib_counters.c
+++ b/drivers/net/datapath/mib_counters/dp_mib_counters.c
@@ -51,6 +51,8 @@ static struct list_head registered_devices_list;
 /* Devices list lock */
 static rwlock_t dev_list_lock;
 
+/* Notify callback registration ID - used for deregister CB */
+static s32 g_notify_cb_id;
 /* Wraparound counter handle */
 static u64 wraparound(u64 curr, u64 last, u32 size)
 {
@@ -82,7 +84,7 @@ static void update_dev_counters(struct mib_counters *cnt)
 	 */
 	ops = dp_port_prop[0].ops[0];
 
-	DP_DEBUG(DP_DBG_FLAG_DBG,
+	DP_DEBUG(DP_DBG_FLAG_REG,
 		 "MIB CNT - update_dev_counters for dev: %s, port_id: %d, sub_if_id_grp: %d\n",
 		 cnt->dev->name, cnt->port_id, cnt->sub_if_id_grp);
 
@@ -132,7 +134,7 @@ static void update_all_devs_counters(void)
 	struct mib_counters *mib_cnt;
 	struct list_head *p;
 
-	DP_DEBUG(DP_DBG_FLAG_DBG, "MIB CNT - update all counters\n");
+	DP_DEBUG(DP_DBG_FLAG_REG, "MIB CNT - update all counters\n");
 
 	read_lock(&dev_list_lock);
 	list_for_each(p, &registered_devices_list)
@@ -175,7 +177,7 @@ s32 add_dev_to_list(struct net_device *dev, s32 port_id, s32 sub_if, s32 inst)
 	list_add_tail(&dev_cnt->dev_list, &registered_devices_list);
 	write_unlock(&dev_list_lock);
 
-	DP_DEBUG(DP_DBG_FLAG_DBG, "MIB CNT - added device: %s port_id = %d, sub_if_id_grp = %d <- from sub_if: %d\n",
+	DP_DEBUG(DP_DBG_FLAG_REG, "MIB CNT - added device: %s port_id = %d, sub_if_id_grp = %d <- from sub_if: %d\n",
 		 dev->name, port_id, dev_cnt->sub_if_id_grp, sub_if);
 
 	return 0;
@@ -199,15 +201,15 @@ s32 rm_dev_from_list(struct net_device *dev, s32 port_id, s32 sub_if, s32 inst)
 
 	port_info = get_dp_port_info(inst, port_id);
 
-	DP_DEBUG(DP_DBG_FLAG_DBG, "MIB CNT - inside rm_dev_from_list\n");
-	DP_DEBUG(DP_DBG_FLAG_DBG,
+	DP_DEBUG(DP_DBG_FLAG_REG, "MIB CNT - inside rm_dev_from_list\n");
+	DP_DEBUG(DP_DBG_FLAG_REG,
 		 "MIB CNT -- looking for item to delete: name = %s, port_id = %d, sub_if = %d, inst = %d\n",
 		 dev->name, port_id, sub_if, inst);
 
 	sub_if_id_grp = GET_VAP(sub_if, port_info->vap_offset,
 				port_info->vap_mask);
 
-	DP_DEBUG(DP_DBG_FLAG_DBG,
+	DP_DEBUG(DP_DBG_FLAG_REG,
 		 "MIB CNT --- sub_if_id_grp taken from VAP = %d\n",
 		 sub_if_id_grp);
 
@@ -216,19 +218,19 @@ s32 rm_dev_from_list(struct net_device *dev, s32 port_id, s32 sub_if, s32 inst)
 	{
 		mib_cnt = list_entry(p, struct mib_counters, dev_list);
 
-		DP_DEBUG(DP_DBG_FLAG_DBG,
+		DP_DEBUG(DP_DBG_FLAG_REG,
 			 "MIB CNT - list item: name = %s, port_id = %d, sub_if_id_grp = %d, inst = %d\n",
 			 mib_cnt->dev->name, mib_cnt->port_id, mib_cnt->sub_if_id_grp, mib_cnt->inst);
 
 		if ((mib_cnt->port_id == port_id) &&
 		    (mib_cnt->sub_if_id_grp == sub_if_id_grp) &&
 		    (mib_cnt->inst == inst)) {
-			DP_DEBUG(DP_DBG_FLAG_DBG, "MIB CNT - removed device: %s port_id = %d, sub_if_id_grp = %d\n",
+			DP_DEBUG(DP_DBG_FLAG_REG, "MIB CNT - removed device: %s port_id = %d, sub_if_id_grp = %d\n",
 				 dev->name, port_id, sub_if_id_grp);
 			list_del(p);
 			devm_kfree(&g_dp_dev->dev, mib_cnt);
 		} else {
-			DP_DEBUG(DP_DBG_FLAG_DBG, "MIB CNT  -  item DOES NOT MATCH\n");
+			DP_DEBUG(DP_DBG_FLAG_REG, "MIB CNT  -  item DOES NOT MATCH\n");
 		}
 	}
 	write_unlock(&dev_list_lock);
@@ -262,21 +264,21 @@ struct mib_counters *find_registered_dev(s32 port_id, s32 sub_if_id_grp,
 /* Callback function to register new net device (subif) reported by DP API */
 s32 subif_register_cb(struct dp_event_info *info)
 {
-	DP_DEBUG(DP_DBG_FLAG_DBG,
+	DP_DEBUG(DP_DBG_FLAG_REG,
 		 "MIB CNT - EVENT - SUBIF REGISTER CB called\n - event info type = %d\n",
 		 info->type);
 
 	switch (info->type) {
 	case DP_EVENT_REGISTER_SUBIF:
-		DP_DEBUG(DP_DBG_FLAG_DBG,
+		DP_DEBUG(DP_DBG_FLAG_REG,
 			 "MIB CNT - event type: DP_EVENT_REGISTER_SUBIF\n");
-		DP_DEBUG(DP_DBG_FLAG_DBG,
+		DP_DEBUG(DP_DBG_FLAG_REG,
 			 "MIB CNT - info->reg_subif_info.dpid = %d\n",
 			 info->reg_subif_info.dpid);
-		DP_DEBUG(DP_DBG_FLAG_DBG,
+		DP_DEBUG(DP_DBG_FLAG_REG,
 			 "MIB CNT - info->reg_subif_info.subif = %d\n",
 			 info->reg_subif_info.subif);
-		DP_DEBUG(DP_DBG_FLAG_DBG,
+		DP_DEBUG(DP_DBG_FLAG_REG,
 			 "MIB CNT - info->reg_subif_info.dev->name = %s\n",
 			 info->reg_subif_info.dev->name);
 
@@ -288,15 +290,15 @@ s32 subif_register_cb(struct dp_event_info *info)
 		break;
 	case DP_EVENT_DE_REGISTER_SUBIF:
 
-		DP_DEBUG(DP_DBG_FLAG_DBG,
+		DP_DEBUG(DP_DBG_FLAG_REG,
 			 "MIB CNT - event type: DP_EVENT_DE_REGISTER_SUBIF\n");
-		DP_DEBUG(DP_DBG_FLAG_DBG,
+		DP_DEBUG(DP_DBG_FLAG_REG,
 			 "MIB CNT - info->de_reg_subif_info.dpid = %d\n",
 			 info->de_reg_subif_info.dpid);
-		DP_DEBUG(DP_DBG_FLAG_DBG,
+		DP_DEBUG(DP_DBG_FLAG_REG,
 			 "MIB CNT - info->de_reg_subif_info.subif = %d\n",
 			 info->de_reg_subif_info.subif);
-		DP_DEBUG(DP_DBG_FLAG_DBG,
+		DP_DEBUG(DP_DBG_FLAG_REG,
 			 "MIB CNT - info->de_reg_subif_info.dev->name = %s\n",
 			 info->de_reg_subif_info.dev->name);
 
@@ -409,6 +411,8 @@ static int __init mib_counters_mod_init(void)
 		return ret;
 	}
 
+	g_notify_cb_id = event_info.id;
+
 	return 0;
 }
 
@@ -423,7 +427,7 @@ static void __exit mib_counters_mod_exit(void)
 	event_info.inst = 0;
 	event_info.owner = DP_EVENT_OWNER_MIB;
 	event_info.type = DP_EVENT_DE_REGISTER_SUBIF;
-	event_info.id = 0;
+	event_info.id = g_notify_cb_id;
 	event_info.dp_event_cb = subif_register_cb;
 
 	ret = dp_register_event_cb(&event_info, DP_F_DEREGISTER);
