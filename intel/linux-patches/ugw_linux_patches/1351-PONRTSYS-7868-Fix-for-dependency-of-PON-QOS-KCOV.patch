From c07480e4886456031f81c9188e6b1ce4d58ddecb Mon Sep 17 00:00:00 2001
From: Cardoso Tiago <tiago.cardoso.abrahao@intel.com>
Date: Thu, 30 Jul 2020 13:40:50 +0200
Subject: [PATCH] PONRTSYS-7868 Fix for dependency of PON_QOS_KCOV

---
 drivers/net/datapath/pon_qos/Kconfig | 3 +--
 1 file changed, 1 insertion(+), 2 deletions(-)

diff --git a/drivers/net/datapath/pon_qos/Kconfig b/drivers/net/datapath/pon_qos/Kconfig
index f139fe533cdf..87649b245c7d 100644
--- a/drivers/net/datapath/pon_qos/Kconfig
+++ b/drivers/net/datapath/pon_qos/Kconfig
@@ -13,8 +13,7 @@ config PON_QOS
 	  actual hardware configuration.
 
 config PON_QOS_KCOV
-	default n if KCOV_INSTRUMENT_ALL
 	bool "PON QoS KCOV"
-	depends on KCOV
+	depends on KCOV && PON_QOS
 	help
 	  Enable coverage on PON QoS driver for fuzzing.
