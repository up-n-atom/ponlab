From b32602812b854597f3fa0e4f04380781e43830fa Mon Sep 17 00:00:00 2001
From: avishalo <avi1.shalom@intel.com>
Date: Thu, 23 Apr 2020 20:20:01 +0300
Subject: [PATCH] PONRTSYS-7747: Add Buffer Manager Pop API

Signed-off-by: avishalo <avi1.shalom@intel.com>
---
 .../net/ppv4/pp-api/pp-buffer-mgr/pp_buffer_mgr.c  | 68 ++++++++++++++++++++++
 .../pp-api/pp-buffer-mgr/pp_buffer_mgr_debugfs.c   | 12 +++-
 .../pp-api/pp-buffer-mgr/pp_buffer_mgr_internal.h  | 40 +++++++++++++
 include/linux/pp_buffer_mgr_api.h                  | 20 ++++++-
 4 files changed, 137 insertions(+), 3 deletions(-)

diff --git a/drivers/net/ppv4/pp-api/pp-buffer-mgr/pp_buffer_mgr.c b/drivers/net/ppv4/pp-api/pp-buffer-mgr/pp_buffer_mgr.c
index d5948da22303..1fb7ba57a3e5 100644
--- a/drivers/net/ppv4/pp-api/pp-buffer-mgr/pp_buffer_mgr.c
+++ b/drivers/net/ppv4/pp-api/pp-buffer-mgr/pp_buffer_mgr.c
@@ -1907,6 +1907,70 @@ s32 pp_bmgr_set_total_active_pools(u32 num_active_pools)
 }
 EXPORT_SYMBOL(pp_bmgr_set_total_active_pools);
 
+s32 pp_bmgr_push_buffer(u32 policy, u32 pool, u64 buff)
+{
+	s32 ret;
+
+	ret = bm_push_buffer(policy, pool, buff);
+	if (ret) {
+		atomic_inc(&db->stats.num_fail_push_req);
+		return ret;
+	}
+
+	atomic_inc(&db->stats.num_succ_push_req);
+	return 0;
+}
+EXPORT_SYMBOL(pp_bmgr_push_buffer);
+
+s32 pp_bmgr_pop_buffer(u32 policy, u32 *pool, u64 *buff)
+{
+	s32 ret;
+
+	if (ptr_is_null(buff)) {
+		pr_err("buff pointer is NULL. Unable to pop buffer.\n");
+		return -EINVAL;
+	}
+
+	if (ptr_is_null(pool)) {
+		pr_err("pool pointer is NULL. Unable to pop buffer.\n");
+		return -EINVAL;
+	}
+
+	ret = bm_pop_buffer(policy, pool, buff);
+	if ((ret) || (*buff == 0)) {
+		atomic_inc(&db->stats.num_fail_pop_req);
+		return -EINVAL;
+	}
+
+	atomic_inc(&db->stats.num_succ_pop_req);
+	return 0;
+}
+EXPORT_SYMBOL(pp_bmgr_pop_buffer);
+
+u32 bmgr_get_succ_pop_req(void)
+{
+	return atomic_read(&db->stats.num_succ_pop_req);
+}
+EXPORT_SYMBOL(bmgr_get_succ_pop_req);
+
+u32 bmgr_get_fail_pop_req(void)
+{
+	return atomic_read(&db->stats.num_fail_pop_req);
+}
+EXPORT_SYMBOL(bmgr_get_fail_pop_req);
+
+u32 bmgr_get_succ_push_req(void)
+{
+	return atomic_read(&db->stats.num_succ_push_req);
+}
+EXPORT_SYMBOL(bmgr_get_succ_push_req);
+
+u32 bmgr_get_fail_push_req(void)
+{
+	return atomic_read(&db->stats.num_fail_push_req);
+}
+EXPORT_SYMBOL(bmgr_get_fail_push_req);
+
 s32 pp_bmgr_init(const struct pp_bmgr_init_param *init_param)
 {
 	if (!init_param->valid)
@@ -1933,6 +1997,10 @@ s32 pp_bmgr_init(const struct pp_bmgr_init_param *init_param)
 		return -EINVAL;
 	}
 
+	atomic_set(&db->stats.num_fail_pop_req, 0);
+	atomic_set(&db->stats.num_succ_pop_req, 0);
+	atomic_set(&db->stats.num_fail_pop_req, 0);
+	atomic_set(&db->stats.num_succ_pop_req, 0);
 	return 0;
 }
 EXPORT_SYMBOL(pp_bmgr_init);
diff --git a/drivers/net/ppv4/pp-api/pp-buffer-mgr/pp_buffer_mgr_debugfs.c b/drivers/net/ppv4/pp-api/pp-buffer-mgr/pp_buffer_mgr_debugfs.c
index 7e29567914bb..5e7db544095b 100644
--- a/drivers/net/ppv4/pp-api/pp-buffer-mgr/pp_buffer_mgr_debugfs.c
+++ b/drivers/net/ppv4/pp-api/pp-buffer-mgr/pp_buffer_mgr_debugfs.c
@@ -503,6 +503,14 @@ PP_DEFINE_DEBUGFS(hw_stats, __dbg_dump_hw_stats, NULL);
 void __dbg_dump_sw_stats(struct seq_file *f)
 {
 	__dump_db(f);
+	seq_printf(f, "\nbm successful pop  requests  : %-10u\n",
+		   bmgr_get_succ_pop_req());
+	seq_printf(f, "bm successful push requests  : %-10u\n",
+		   bmgr_get_succ_push_req());
+	seq_printf(f, "bm failed     pop  requests  : %-10u\n",
+		   bmgr_get_fail_pop_req());
+	seq_printf(f, "bm failed     push requests  : %-10u\n\n",
+		   bmgr_get_fail_push_req());
 }
 
 PP_DEFINE_DEBUGFS(sw_stats, __dbg_dump_sw_stats, NULL);
@@ -526,7 +534,7 @@ void pop(char *cmd_buf, void *data)
 		n = BM_MAX_BUFFER_POPS;
 
 	for (i = 0; i < n; i++) {
-		bm_pop_buffer(policy, &pool, &buff);
+		pp_bmgr_pop_buffer(policy, &pool, &buff);
 		if (!buff)
 			break;
 
@@ -551,7 +559,7 @@ void push(char *cmd_buf, void *data)
 		return;
 
 	pr_info("<== PUSH %#llx (pool %u, policy %u)\n", buff, pool, policy);
-	bm_push_buffer(policy, pool, buff);
+	pp_bmgr_push_buffer(policy, pool, buff);
 }
 
 PP_DEFINE_DEBUGFS(push, push_help, push);
diff --git a/drivers/net/ppv4/pp-api/pp-buffer-mgr/pp_buffer_mgr_internal.h b/drivers/net/ppv4/pp-api/pp-buffer-mgr/pp_buffer_mgr_internal.h
index 8286dae7401a..94e96927468a 100644
--- a/drivers/net/ppv4/pp-api/pp-buffer-mgr/pp_buffer_mgr_internal.h
+++ b/drivers/net/ppv4/pp-api/pp-buffer-mgr/pp_buffer_mgr_internal.h
@@ -114,12 +114,27 @@ struct bmgr_policy_db_entry {
 	u8     is_busy;
 };
 
+/**
+ * @brief This structure holds the buffer manager driver statistics
+ * @num_succ_pop_req Number of successful pop requests
+ * @num_fail_pop_req Number of failed pop requests
+ * @num_succ_push_req Number of successful push requests
+ * @num_fail_push_req Number of failed push requests
+ */
+struct bmgr_driver_stats {
+	atomic_t    num_succ_pop_req;
+	atomic_t    num_fail_pop_req;
+	atomic_t    num_succ_push_req;
+	atomic_t    num_fail_push_req;
+};
+
 /**
  * @brief This structure holds the buffer manager database
  * @cfg Initial configuration
  * @pools Pools information
  * @policies Policies information
  * @group Group information
+ * @stats driver stats for pop and push requests
  * @ready specify if the buffer manager ready to be called
  * @db_lock
  * @num_pools Number of active pools
@@ -130,12 +145,37 @@ struct bmgr_driver_db {
 	struct bmgr_pool_db_entry   pools[PP_BM_MAX_POOLS];
 	struct bmgr_policy_db_entry policies[PP_BM_MAX_POLICIES];
 	struct bmgr_group_db_entry  groups[BM_MAX_GROUPS];
+	struct bmgr_driver_stats    stats;
 	bool        ready;
 	spinlock_t  db_lock;
 	u32         num_pools;
 	u32         num_policies;
 };
 
+/**
+ * @brief Get num of successful pop requests
+ * @return Successful pop requests count
+ */
+u32 bmgr_get_succ_pop_req(void);
+
+/**
+ * @brief Get num of failed pop requests
+ * @return Failed pop requests count
+ */
+u32 bmgr_get_fail_pop_req(void);
+
+/**
+ * @brief Get num of successful push requests
+ * @return Successful push requests count
+ */
+u32 bmgr_get_succ_push_req(void);
+
+/**
+ * @brief Get num of failed push requests
+ * @return Failed push requests count
+ */
+u32 bmgr_get_fail_push_req(void);
+
 /**
  * @brief Get buffer manager config registers
  * @param config struct
diff --git a/include/linux/pp_buffer_mgr_api.h b/include/linux/pp_buffer_mgr_api.h
index ada091e2013b..967ba5d31c59 100644
--- a/include/linux/pp_buffer_mgr_api.h
+++ b/include/linux/pp_buffer_mgr_api.h
@@ -3,7 +3,7 @@
  * Description: Packet Processor Buffer Manager API
  *
  * SPDX-License-Identifier: GPL-2.0-only
- * Copyright (C) 2018 Intel Corporation
+ * Copyright (C) 2018-2020 Intel Corporation
  */
 #ifndef __PP_BUFFER_MGR_API_H__
 #define __PP_BUFFER_MGR_API_H__
@@ -246,4 +246,22 @@ bool pp_bmgr_is_policy_active(u16 policy);
  * @return 0 on success, other error code on failure
  */
 s32 pp_bmgr_set_total_active_pools(u32 num_active_pools);
+
+/**
+ * @brief Pop a buffer from a policy. This API shall not be used for data flows
+ * @param policy policy id to pop from
+ * @param pool the pool id the buffer was popped from
+ * @param buff the buffer pointer
+ * @return s32 0 on success, error code otherwise
+ */
+s32 pp_bmgr_pop_buffer(u32 policy, u32 *pool, u64 *buff);
+
+/**
+ * @brief Push a buffer to a policy and pool. This API shall not be used for data flows
+ * @param policy policy id to push to
+ * @param pool pool id to push to
+ * @param buff the buffer pointer
+ * @return s32 0 on success, error code otherwise
+ */
+s32 pp_bmgr_push_buffer(u32 policy, u32 pool, u64 buff);
 #endif /* __PP_BUFFER_MGR_API_H__ */
