 	return ret;
 }
 
+/* For GRX550 platform only, for other platforms,
+ * the registers might have a different structure
+ */
+#define IFMUX_CFG	0x120
+#define P6_SEL		BIT(20)
+#define PORT_NUM	6
+
+static inline void grx550_misc_config(ethsw_api_dev_t *gswdev) {
+	u32 val = 0;
+	struct core_ops *ops;
+
+	/* MII Port reset connect to  GSWIP-R */
+	regmap_read(gswdev->chiptop_base, IFMUX_CFG, &val);
+	val &= ~P6_SEL;
+	regmap_write(gswdev->chiptop_base, IFMUX_CFG, val);
+
+	ops = gsw_get_swcore_ops(LTQ_FLOW_DEV_INT_R);
+	/* assign port 1 address in gswip-r as port 6 */
+	gsw_w32(ops, (GSWT_PHY_ADDR_1_ADDR_OFFSET + GSW30_TOP_OFFSET),
+		GSWT_PHY_ADDR_1_ADDR_SHIFT,GSWT_PHY_ADDR_1_ADDR_SIZE, PORT_NUM);
+
+	ops = gsw_get_swcore_ops(LTQ_FLOW_DEV_INT);
+	/* enable port 6 MDC GSWIP-L */
+	gsw_r32(ops, (GSWT_MDCCFG_0_PEN_ALL_OFFSET + GSW30_TOP_OFFSET),
+		GSWT_MDCCFG_0_PEN_ALL_SHIFT,GSWT_MDCCFG_0_PEN_ALL_SIZE, &val);
+	val |= 1 << (PORT_NUM - 1);
+	gsw_w32(ops, (GSWT_MDCCFG_0_PEN_ALL_OFFSET + GSW30_TOP_OFFSET),
+		GSWT_MDCCFG_0_PEN_ALL_SHIFT,GSWT_MDCCFG_0_PEN_ALL_SIZE, val);
+
+	/* MII Port connect to GSWIP-R */
+	regmap_read(gswdev->chiptop_base, IFMUX_CFG, &val);
+	val |= P6_SEL;
+	regmap_write(gswdev->chiptop_base, IFMUX_CFG, val);
+}
+
