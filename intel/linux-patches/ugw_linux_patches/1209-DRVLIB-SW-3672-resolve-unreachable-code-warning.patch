From 4ab59e60d21041c1ac14984f239955fed656367a Mon Sep 17 00:00:00 2001
From: arathinx <ayyappanx.rathinam@intel.com>
Date: Mon, 8 Jun 2020 13:42:24 +0800
Subject: [PATCH] DRVLIB_SW-3672: resolve unreachable code warning

Thermal support is not added for PRX300
---
 drivers/net/ethernet/lantiq/ltq_eth_drv_xrx500.c | 9 ++-------
 1 file changed, 2 insertions(+), 7 deletions(-)

diff --git a/drivers/net/ethernet/lantiq/ltq_eth_drv_xrx500.c b/drivers/net/ethernet/lantiq/ltq_eth_drv_xrx500.c
index 903c8184077d..bc6c7b7843f8 100644
--- a/drivers/net/ethernet/lantiq/ltq_eth_drv_xrx500.c
+++ b/drivers/net/ethernet/lantiq/ltq_eth_drv_xrx500.c
@@ -2384,13 +2384,8 @@ static int ltq_eth_drv_init(struct platform_device *pdev)
 	ltq_eth_genetlink_init();
 #endif
 
-	if (of_find_property(node, "#cooling-cells", NULL)) {
-		ret = ltq_eth_thermal_init(node, &xrx500_hw);
-		if (ret) {
-			pr_err("%s: net cooling device not registered (err %d)\n",
-			       __func__, ret);
-		}
-	}
+	if (of_find_property(node, "#cooling-cells", NULL))
+		ltq_eth_thermal_init(node, &xrx500_hw);
 
 	pr_info("Lantiq ethernet driver for XRX500 init.\n");
 	return 0;
