+u64 prsr_imem_hit_map_get(void)
+{
+	u64 high, low;
+
+	low  = (u64)PP_REG_RD32(PP_PRSR_LY3_PROTO_HIT_STICKY_0_31_REG);
+	high = (u64)PP_REG_RD32(PP_PRSR_LY3_PROTO_HIT_STICKY_32_63_REG);
+
+	return ((high << 32) | low);
+}
