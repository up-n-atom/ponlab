+	seq_puts(f, " +----------+-----------+-----------+\n");
+
+	for (i = 0; i < UC_CPUS_MAX; i++) {
+		if (!uc_is_cpu_active(UC_IS_EGR, i))
+			continue;
+
+		if (smgr_mcast_uc_cpu_stats_get(i, &stats[i])) {
+			seq_puts(f, "failed to get mcast counters\n");
+			return;
+		}
+		seq_printf(f, " | %-8u | %-9s | %-9u |\n", i, "RX",
+			   stats[i].rx);
+		seq_printf(f, " | %-8u | %-9s | %-9u |\n", i, "TX",
+			   stats[i].tx);
+		seq_printf(f, " | %-8u | %-9s | %-9u |\n", i, "DROP",
+			   stats[i].drop);
+		seq_puts(f, " +----------+-----------+-----------+\n");
+		total_rx  += stats[i].rx;
+		total_tx  += stats[i].tx;
+		total_drp += stats[i].drop;
+	}
+	seq_printf(f, " | %-8s | %-9s | %-9u |\n", "TOTAL", "RX", total_rx);
+	seq_printf(f, " | %-8s | %-9s | %-9u |\n", "TOTAL", "TX", total_tx);
+	seq_printf(f, " | %-8s | %-9s | %-9u |\n", "TOTAL", "DROP", total_drp);
+	seq_puts(f, " +----------+-----------+-----------+\n");
+	seq_puts(f, "\n");
+}
+
+PP_DEFINE_DEBUGFS(pkt_stats, __smgr_dbg_pkt_stats_show, NULL);
