+	seq_puts(f, "+--------------------------------+------------+\n");
+	seq_printf(f, "| %-30s | %-10u |\n", "Port Invalid Error",
+		   stats.port_invalid_err);
+	seq_printf(f, "| %-30s | %-10u |\n", "Port Invalid Headroom",
