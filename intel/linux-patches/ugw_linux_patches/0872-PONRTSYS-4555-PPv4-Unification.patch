+int bm_dbg_init(struct bmgr_driver_db *db, struct dentry *parent)
+{
+	return pp_debugfs_create(parent, "buff_mgr", &dbgfs, bm_debugfs_files,
+				 ARRAY_SIZE(bm_debugfs_files), db);
+}
