+/**
+ * @brief Debugfs port stat show API, prints port stats
+ */
+void __pmgr_dbg_port_stats_show(struct seq_file *f)
+{
+	u32 p = (unsigned long)f->private;
+	s32 ret;
+	struct pp_stats stats;
+
+	/* Print Port Statistics */
+	seq_puts(f, "\n");
