+static void uc_dbg_stats_show(struct seq_file *f)
+{
+	u32 rx, rx_total, tx_total, qu;
+	u8 uc_types = 2;
+
+	if (unlikely(!uc_is_cluster_valid(UC_IS_EGR) &&
+		     !uc_is_cluster_valid(UC_IS_ING))) {
+		seq_puts(f, "uc clusters are disabled\n");
+		return;
+	}
+
+	seq_puts(f, "\n");
+	seq_puts(f, " +-------------------------------------+\n");
+	seq_puts(f, " |             UC JOBS STATS           |\n");
+	seq_puts(f, " +-------------------------------------+\n");
+	seq_puts(f, " |  CLUSTER  |     RX     |     TX     |\n");
+	seq_puts(f, " +-----------+------------+------------+\n");
+	while (uc_types--) {
+		if (unlikely(!uc_is_cluster_valid(!!uc_types)))
+			continue;
+
+		for (rx_total = 0, qu = 0; qu < UC_WRITER_QU_MAX; qu++) {
+			if (uc_writer_queue_in_jobs_get(!!uc_types, qu, &rx)) {
+				seq_printf(f, "failed to get the %s in_jobs\n",
+					   !!uc_types ? "egress" : "ingress");
+				return;
+			}
+			rx_total += rx;
+		}
+		if (uc_reader_out_jobs_get(!!uc_types, &tx_total)) {
+			seq_printf(f, "failed to get the %s out_jobs\n",
+				   !!uc_types ? "egress" : "ingress");
+			return;
+		}
+		seq_printf(f, " | %-9s | %-10u | %-10u |\n",
+			   !!uc_types ? "EGRESS" : "INGRESS",
+			   rx_total, tx_total);
+		seq_puts(f, " +-----------+------------+------------+\n");
+	}
+	seq_puts(f, "\n");
+}
+
+PP_DEFINE_DEBUGFS(stats, uc_dbg_stats_show, NULL);
+
+static void uc_dbg_version_show(struct seq_file *f)
+{
+	u32 ver;
+
+	seq_puts(f, "\n");
+	if (likely(!uc_ver_get(UC_IS_EGR, &ver))) {
+		seq_printf(f, "EGRESS  : MAJOR[%u], MINOR[%u], BUILD[%u]\n",
+			   (ver >> 16) & U8_MAX, (ver >> 8) & U8_MAX,
+			   ver & U8_MAX);
+	}
+
+	if (likely(!uc_ver_get(UC_IS_ING, &ver))) {
+		seq_printf(f, "INGRESS : MAJOR[%u], MINOR[%u], BUILD[%u]\n",
+			   (ver >> 16) & U8_MAX, (ver >> 8) & U8_MAX,
+			   ver & U8_MAX);
+	}
+}
+
+PP_DEFINE_DEBUGFS(version, uc_dbg_version_show, NULL);
+
+enum uc_log_opts {
+	uc_log_opt_help = 1,
+	uc_log_opt_reset,
+	uc_log_opt_level,
+};
+
+static const match_table_t uc_log_tokens = {
+	{ uc_log_opt_help,  "help" },
+	{ uc_log_opt_reset, "reset" },
+	{ uc_log_opt_level, "level=%u" },
+};
+
+static void __uc_log_help(void)
+{
+	pr_info("\n");
+	pr_info(" Brief: Print/configure UC logger\n");
+	pr_info(" Usage: echo <option>[=value] ... > log\n");
+	pr_info(" Options:\n");
+	pr_info("   help   - print this help\n");
+	pr_info("   reset  - delete all logs\n");
+	pr_info("   level  - set log level\n");
+	pr_info(" Examples:\n");
+	pr_info("   print log: cat log\n");
+	pr_info("   reset log: echo reset > log\n");
+}
+
+static void __uc_log_set(char *args, void *data)
+{
+	substring_t substr[MAX_OPT_ARGS];
+	enum uc_log_opts opt;
+	char *tok;
+	s32 val;
+
+	/* iterate over user arguments */
+	while ((tok = strsep(&args, " \t\n")) != NULL) {
+		if (!*tok)
+			continue;
+		opt = match_token(tok, uc_log_tokens, substr);
+		switch (opt) {
+		case uc_log_opt_help:
+			__uc_log_help();
+			break;
+		case uc_log_opt_reset:
+			uc_log_reset();
+			break;
+		case uc_log_opt_level:
+			if (match_int(&substr[0], &val))
+				goto opt_parse_err;
+			uc_log_level_set((enum uc_log_level)val);
+			break;
+		default:
+			pr_info("Error: Invalid option '%s'\n", tok);
+			break;
+		}
+	}
+
+	return;
+
+opt_parse_err:
+	pr_err("Failed to parse %s value\n", tok);
+}
+
+static void uc_dbg_log_show(struct seq_file *f)
+{
+	char *level_str[] = { "FATAL", "ERROR", "WARN", "INFO", "DEBUG" };
+	struct uc_log_msg *msgs, *msg;
+	void *buff;
+	size_t sz;
+
+	uc_log_buff_info_get(&buff, &sz);
+
+	msgs = kzalloc(sz, GFP_KERNEL);
+	if (unlikely(!msgs)) {
+		pr_err("failed to allocate %zu bytes buffer\n", sz);
+		return;
+	}
+
+	DDR_RD_REP(buff, msgs, sz);
+	seq_puts(f, "  UC Log\n");
+	seq_puts(f, "==========\n");
+	for_each_arr_entry(msg, msgs, sz / sizeof(*msg)) {
+		if (strlen(msg->str) == 0)
+			continue;
+		seq_printf(f, "[%8x]:[%-5s]:[%s]: %s %u, %#x\n", msg->ts,
+			   level_str[msg->level], msg->func, msg->str, msg->val,
+			   msg->val);
+	}
+	seq_puts(f, "\n");
+
+	kfree(msgs);
+}
+
+PP_DEFINE_DEBUGFS(uc_log, uc_dbg_log_show, __uc_log_set);
+
+enum uc_aux_reg_opts {
+	uc_aux_reg_help = 1,
+	uc_aux_reg_rd,
+	uc_aux_reg_wr,
+	uc_aux_reg_id,
+	uc_aux_reg_val,
+	uc_aux_reg_max
+};
+
+static const match_table_t uc_aux_reg_tokens = {
+	{ uc_aux_reg_help, "help" },
+	{ uc_aux_reg_rd,   "rd" },
+	{ uc_aux_reg_wr,   "wr" },
+	{ uc_aux_reg_id,   "id=%u" },
+	{ uc_aux_reg_val,  "val=%u" },
+};
+
+static void __uc_aux_reg_help(void)
+{
+	pr_info("\n");
+	pr_info(" Brief: Read/Write egress UC auxiliary registers\n");
+	pr_info("        for full list of auxiliary registers see Figure 3-5\n");
+	pr_info("        in ARCv2 Programmer's Reference Manual\n");
+	pr_info(" Usage: echo <action> [option][=value] ... > eg_aux_reg\n");
+	pr_info(" actions:\n");
+	pr_info("   help   - print this help\n");
+	pr_info("   rd     - read register\n");
+	pr_info("   write  - write register\n");
+	pr_info(" options:\n");
+	pr_info("   id     - register id\n");
+	pr_info("   value  - value to write\n");
+	pr_info(" Examples:\n");
+	pr_info("   read: echo read id=0x11 > aux_reg\n");
+	pr_info("   reset echo write id=0xc5 0x50 > aux_reg\n");
+}
+
+static void __uc_aux_reg(char *args, void *data)
+{
+	substring_t substr[MAX_OPT_ARGS];
+	enum uc_aux_reg_opts opt;
+	enum uc_aux_reg_opts act = uc_aux_reg_max;
+	char *tok;
+	s32 tmp, ret;
+	u32 reg, val;
+	bool val_valid = false;
+
+	/* iterate over user arguments */
+	while ((tok = strsep(&args, " \t\n")) != NULL) {
+		if (!*tok)
+			continue;
+		opt = match_token(tok, uc_aux_reg_tokens, substr);
+		switch (opt) {
+		case uc_aux_reg_help:
+		case uc_aux_reg_rd:
+		case uc_aux_reg_wr:
+			act = opt;
+			break;
+		case uc_aux_reg_id:
+			if (match_int(&substr[0], &tmp))
+				goto opt_parse_err;
+			reg = tmp;
+			break;
+		case uc_aux_reg_val:
+			if (match_int(&substr[0], &tmp))
+				goto opt_parse_err;
+			val = tmp;
+			val_valid = true;
+			break;
+		default:
+			pr_info("Error: Invalid option '%s'\n", tok);
+			break;
+		}
+	}
+
+	switch (act) {
+	case uc_aux_reg_help:
+		__uc_aux_reg_help();
+		break;
+	case uc_aux_reg_rd:
+		ret = uc_aux_reg_read(reg, &val);
+		if (ret)
+			pr_info("Failed to read aux reg %#x\n", reg);
+		else
+			pr_info("Auxiliary register %#x ==> %#x\n", reg,
+				val);
+		break;
+	case uc_aux_reg_wr:
+		if (!val_valid) {
+			pr_info("value wasn't specified\n");
+			break;
+		}
+		ret = uc_aux_reg_write(reg, val);
+		if (ret)
+			pr_info("Failed to write %#x to aux reg %#x\n", val,
+				reg);
+		else
+			pr_info("Auxiliary register %#x <== %#x\n", reg,
+				val);
+		break;
+	default:
+		break;
+	}
+
+	return;
+
+opt_parse_err:
+	pr_err("Failed to parse %s value\n", tok);
+}
+
+PP_DEFINE_DEBUGFS(uc_aux_reg, NULL, __uc_aux_reg);
+
+static struct debugfs_file uc_dbg_files[] = {
+	{"nf_cfg", &PP_DEBUGFS_FOPS(nf_cfg)},
+	{"core_run_halt", &PP_DEBUGFS_FOPS(core_run_halt)},
+	{"uc_enable", &PP_DEBUGFS_FOPS(uc_enable)},
+	{"dma_access", &PP_DEBUGFS_FOPS(dma_access)},
+	{"fat", &PP_DEBUGFS_FOPS(fat)},
+	{"ccu_gpreg", &PP_DEBUGFS_FOPS(ccu_gpreg)},
+	{"ccu_irr", &PP_DEBUGFS_FOPS(ccu_irr)},
+	{"reader_irr", &PP_DEBUGFS_FOPS(reader_irr)},
+	{"stats", &PP_DEBUGFS_FOPS(stats)},
+	{"log", &PP_DEBUGFS_FOPS(uc_log)},
+	{"aux_reg", &PP_DEBUGFS_FOPS(uc_aux_reg)},
+	{"version", &PP_DEBUGFS_FOPS(version)},
+};
+
+s32 uc_dbg_init(struct dentry *parent)
+{
+	if (unlikely(!debugfs_initialized())) {
+		pr_err("Debugfs not initialized yet\n");
+		return -EPERM;
+	}
+
+	/* uc debugfs dir */
+	return pp_debugfs_create(parent, "uc", &dbgfs, uc_dbg_files,
+				 ARRAY_SIZE(uc_dbg_files), NULL);
+}
+
+void uc_dbg_clean(void)
+{
+	debugfs_remove_recursive(dbgfs);
+	dbgfs = NULL;
+}
diff --git a/drivers/net/ppv4/pp-hal/micro-controller/uc_egr_mbox.c b/drivers/net/ppv4/pp-hal/micro-controller/uc_egr_mbox.c
new file mode 100644
index 000000000000..aba216842154
--- /dev/null
+++ b/drivers/net/ppv4/pp-hal/micro-controller/uc_egr_mbox.c
@@ -0,0 +1,271 @@
+/*
+ * Description: PP Egress micro-controllers mailbox
+ *
+ * SPDX-License-Identifier: GPL-2.0-only
+ * Copyright (C) 2019 Intel Corporation
+ */
+
+#define pr_fmt(fmt) "[PP_UC_MBOX]:%s:%d: " fmt, __func__, __LINE__
+
+#include <linux/kernel.h>
+#include <linux/errno.h>
+#include <linux/dma-mapping.h>
+#include <linux/spinlock.h>
+#include <linux/types.h>
+#include <linux/bitops.h>
+
+#include "pp_regs.h"
+#include "pp_common.h"
+#include "uc_regs.h"
+#include "uc.h"
+#include "uc_internal.h"
+#include "infra.h"
+
+#define UC_CMD_BUSY               1
+#define UC_CMD_DONE               0
+#define UC_CMD_SYNC_REG_IDX       2
+#define UC_MBOX_MSG_FLAG_IRQ_MSK  BIT(0)
+#define UC_MBOX_MSG_FLAG_DATA_MSK BIT(1)
+
+/**
+ * @enum uc_mbox_data_words
+ * @brief mailbox data word index
+ */
+enum uc_mbox_data_words {
+	/*! command type word */
+	UC_MBOX_CMD_TYPE_WORD,
+	/*! command parameter word */
+	UC_MBOX_CMD_PARAM_WORD,
+	/*! number of command data words */
+	UC_MBOX_CMD_WORD_MAX,
+};
+
+/**
+ * @brief locks database and HW accesses
+ */
+static spinlock_t mbox_lock;
+
+/**
+ * @brief mailbox DDR buffer cpu address
+ */
+static void      *mbox_buff_virt;
+
+/**
+ * @brief mailbox DDR buffer phys address
+ */
+static dma_addr_t mbox_buff_phys;
+
+/**
+ * @brief Acquire mbox lock
+ */
+static inline void __mbox_lock(void)
+{
+	pr_debug("caller %ps\n", __builtin_return_address(0));
+
+	/* we are not allowed to run in irq context */
+	WARN(in_irq(), "uc mbox shouldn't be used from irq context\n");
+	spin_lock_bh(&mbox_lock);
+}
+
+/**
+ * @brief Release mbox lock
+ */
+static inline void __mbox_unlock(void)
+{
+	pr_debug("caller %ps\n", __builtin_return_address(0));
+
+	spin_unlock_bh(&mbox_lock);
+}
+
+static s32 __uc_egr_mbox_buff_alloc(void)
+{
+#ifdef CONFIG_PPV4_FPGA
+	mbox_buff_phys = (dma_addr_t)DDR_UC_MBOX_BUFF_BASE;
+	mbox_buff_virt = (void *)DDR_UC_MBOX_BUFF_BASE;
+#else
+	mbox_buff_virt = dma_zalloc_coherent(NULL, UC_CMD_BUFF_SIZE,
+					     &mbox_buff_phys, GFP_KERNEL);
+	if (unlikely(!mbox_buff_virt)) {
+		pr_err("Could not allocate %u bytes for uc mbox buff\n",
+		       (u32)UC_CMD_BUFF_SIZE);
+		return -ENOMEM;
+	}
+#endif
+	return 0;
+}
+
+static void __uc_egr_mbox_buff_free(void)
+{
+	if (!IS_ENABLED(CONFIG_PPV4_FPGA) && mbox_buff_virt) {
+		dma_free_coherent(NULL, UC_CMD_BUFF_SIZE, mbox_buff_virt,
+				  mbox_buff_phys);
+	}
+}
+
+s32 uc_egr_mbox_cmd_send_buff(enum uc_mbox_cmd_type type, const u32 *buff,
+			      size_t len)
+{
+	u32 flags = UC_MBOX_MSG_FLAG_DATA_MSK;
+	s32 ret = 0, i;
+
+	pr_debug("uc mbox cmd %u, buff %ps, len %zu\n", (u32)type, buff, len);
+
+	if (unlikely(type > UC_CMD_LAST || type < UC_CMD_FIRST)) {
+		pr_err("invalid command type %u\n", (u32)type);
+		return -EINVAL;
+	}
+
+	if (unlikely(len * 4 > UC_CMD_BUFF_SIZE)) {
+		pr_err("buffer to write too big %zu, max is %u\n", len,
+		       (u32)UC_CMD_BUFF_SIZE);
+		return -EINVAL;
+	}
+
+	__mbox_lock();
+	if (unlikely(pp_reg_poll(UC_EGR_MBOX_MSG0_WR_STATUS, 0xFF, 0))) {
+		pr_err("command interface not ready\n");
+		ret = -EPERM;
+		goto unlock;
+	}
+	if (unlikely(!PP_REG_RD32(UC_EGR_MBOX_WR_CREDIT(UC_CH_MESSAGE)))) {
+		pr_err("command failed, no credit for channel %u\n",
+		       (u32)UC_CH_MESSAGE);
+		ret = -EPERM;
+		goto unlock;
+	}
+
+	/* copy data to FW buffer */
+	for (i = 0; i < len; i++, buff++)
+		DDR_WR32(mbox_buff_virt + i * 4, *buff);
+
+	/* cache flush/evict */
+	if (IS_ENABLED(CONFIG_OF))
+		dma_map_single(pp_dev_get(), mbox_buff_virt, len,
+			       DMA_TO_DEVICE);
+
+	/* set the command */
+	PP_REG_WR32(UC_EGR_MBOX_MSG0_WR_DATA0,   type);
+	PP_REG_WR32(UC_EGR_MBOX_MSG0_WR_DATA1,   (u32)mbox_buff_phys);
+	PP_REG_WR32(UC_EGR_MBOX_MSG0_WR_FLAGS,   flags);
+	PP_REG_WR32(UC_EGR_MBOX_MSG0_WR_ADDRESS, 0);
+	PP_REG_WR32(UC_EGR_MBOX_MSG0_WR_LENGTH,  0);
+	/* set the gp reg for synchronization */
+	PP_REG_WR32(UC_CCU_GPREG_REG(EGRESS, UC_CMD_SYNC_REG_IDX), UC_CMD_BUSY);
+
+	/* trigger the command */
+	if (pp_silicon_step_get() == PP_SSTEP_A)
+		PP_REG_WR32(UC_SW_WRITER_MBOX_CH_TRIGGER, UC_CH_MESSAGE);
+	else
+		PP_REG_WR32(UC_EGR_MBOX_MSG0_WR_CHANNEL, UC_CH_MESSAGE);
+
+	/* wait for command done signal */
+	if (unlikely(pp_reg_poll(UC_CCU_GPREG_REG(EGRESS, UC_CMD_SYNC_REG_IDX),
+				 U32_MAX, UC_CMD_DONE))) {
+		pr_err("command %u failed, error %u\n", (u32)type,
+		       PP_REG_RD32(UC_CCU_GPREG_REG(EGRESS,
+						    UC_CMD_SYNC_REG_IDX)));
+		ret = -EPERM;
+		goto unlock;
+	}
+
+unlock:
+	__mbox_unlock();
+	return ret;
+}
+
+s32 uc_egr_mbox_cmd_send(enum uc_mbox_cmd_type type, u32 param, void *response,
+			 u16 response_len)
+{
+	u32 flags = UC_MBOX_MSG_FLAG_DATA_MSK;
+	s32 ret = 0;
+
+	pr_debug("uc mbox cmd %u, param %u, response buff len %hu\n",
+		 (u32)type, param, response_len);
+
+	if (unlikely(type > UC_CMD_LAST || type < UC_CMD_FIRST)) {
+		pr_err("invalid command type %u\n", (u32)type);
+		return -EINVAL;
+	}
+
+	if (unlikely(response_len > UC_CMD_BUFF_SIZE)) {
+		pr_err("invalid command response len %hu, max=%u\n",
+		       response_len, (u32)UC_CMD_BUFF_SIZE);
+		return -EINVAL;
+	}
+
+	__mbox_lock();
+	if (unlikely(pp_reg_poll(UC_EGR_MBOX_MSG0_WR_STATUS, 0xFF, 0))) {
+		pr_err("command interface not ready\n");
+		ret = -EPERM;
+		goto unlock;
+	}
+	if (unlikely(!PP_REG_RD32(UC_EGR_MBOX_WR_CREDIT(UC_CH_MESSAGE)))) {
+		pr_err("command failed, no credit for channel %u\n",
+		       (u32)UC_CH_MESSAGE);
+		ret = -EPERM;
+		goto unlock;
+	}
+
+	/* reset the mbox response buffer */
+	if (response && response_len) {
+		DDR_MEMSET(mbox_buff_virt, response_len, 0);
+		if (IS_ENABLED(CONFIG_OF))
+			dma_map_single(pp_dev_get(), mbox_buff_virt,
+				       response_len, DMA_TO_DEVICE);
+	}
+
+	/* set the command */
+	PP_REG_WR32(UC_EGR_MBOX_MSG0_WR_DATA0,   type);
+	PP_REG_WR32(UC_EGR_MBOX_MSG0_WR_DATA1,   param);
+	PP_REG_WR32(UC_EGR_MBOX_MSG0_WR_FLAGS,   flags);
+	PP_REG_WR32(UC_EGR_MBOX_MSG0_WR_ADDRESS, (u32)mbox_buff_phys);
+	PP_REG_WR32(UC_EGR_MBOX_MSG0_WR_LENGTH,  response_len);
+	/* set the gp reg for synchronization */
+	PP_REG_WR32(UC_CCU_GPREG_REG(EGRESS, UC_CMD_SYNC_REG_IDX), UC_CMD_BUSY);
+	/* trigger the command */
+	if (pp_silicon_step_get() == PP_SSTEP_A)
+		PP_REG_WR32(UC_SW_WRITER_MBOX_CH_TRIGGER, UC_CH_MESSAGE);
+	else
+		PP_REG_WR32(UC_EGR_MBOX_MSG0_WR_CHANNEL, UC_CH_MESSAGE);
+
+	/* wait for command done signal */
+	if (unlikely(pp_reg_poll(UC_CCU_GPREG_REG(EGRESS, UC_CMD_SYNC_REG_IDX),
+				 U32_MAX, UC_CMD_DONE))) {
+		pr_err("command %u failed, error %u\n", (u32)type,
+		       PP_REG_RD32(UC_CCU_GPREG_REG(EGRESS,
+						    UC_CMD_SYNC_REG_IDX)));
+		ret = -EPERM;
+		goto unlock;
+	}
+
+	/* copy uc response to caller if needed */
+	if (response && response_len) {
+		if (IS_ENABLED(CONFIG_OF))
+			dma_map_single(pp_dev_get(), mbox_buff_virt,
+				       response_len, DMA_FROM_DEVICE);
+		DDR_RD_REP(mbox_buff_virt, response, response_len);
+	}
+
+unlock:
+	__mbox_unlock();
+	return ret;
+}
+
+s32 uc_egr_mbox_init(void)
+{
+	s32 ret;
+
+	ret = __uc_egr_mbox_buff_alloc();
+	if (unlikely(ret))
+		return ret;
+
+	/* init lock */
+	spin_lock_init(&mbox_lock);
+
+	return 0;
+}
+
+void uc_egr_mbox_exit(void)
+{
+	__uc_egr_mbox_buff_free();
+}
diff --git a/drivers/net/ppv4/pp-hal/micro-controller/uc_internal.h b/drivers/net/ppv4/pp-hal/micro-controller/uc_internal.h
new file mode 100644
index 000000000000..1398cf5b2fdb
--- /dev/null
+++ b/drivers/net/ppv4/pp-hal/micro-controller/uc_internal.h
@@ -0,0 +1,386 @@
+/*
+ * Description: PP micro-comtroller internal definitions
+ *
+ * SPDX-License-Identifier: GPL-2.0-only
+ * Copyright (C) 2019 Intel Corporation
+ */
+
+#ifndef __PP_UC_INTERNAL_H__
+#define __PP_UC_INTERNAL_H__
+
+#include <linux/types.h>
+#include "uc_regs.h"
+
+/* UC version - version major and minor numbers must be aligned with
+ * the fw version, if the fw was changed without any interface changes
+ * only the build number should be changed and no need to update
+ * the version here
+ */
+#define EGRESS_VER_MAJOR              (1)
+#define EGRESS_VER_MINOR              (4)
+#define INGRESS_VER_MAJOR             (1)
+#define INGRESS_VER_MINOR             (0)
+#define UC_VER_MAJOR(t)               (t ## _VER_MAJOR)
+#define UC_VER_MINOR(t)               (t ## _VER_MINOR)
+
+#define INGRESS_VER_SSRAM_OFF         (0x4000)
+#define UC_CCU_INTERRUPT_ALL          (0xFF)
+#define UC_READER_INTERRUPT_ALL       (0xFF)
+#define UC_READER_WDT_DFLT_VAL        (0x800)
+#define UC_READER_RTRY_CNT_DFLT_VAL   (0x3)
+#define UC_READER_RTRY_ITRVL_DFLT_VAL (256)
+#define UC_DMA_BRST_LEN_DFLT_VAL      (256)
+#define UC_DMA_LINE_SZ_DFLT_VAL       (64)
+#define UC_WRITER_QU_MAX              (16)
+
+/* UC Egress SW implementation for A-STEP */
+/* CPU 3 DCCM address for the port credit inc address */
+#define UC_SW_WRITER_TX_PORT_CRED(p)  (UC_DCCM(EGRESS, 3, (p) << 2))
+/* CPU 3 DCCM address for the port ring address */
+#define UC_SW_WRITER_TX_PORT_RING(p)  (0x50 + UC_DCCM(EGRESS, 3, (p) << 5))
+/* DCCM address for triggering the command */
+#define UC_SW_WRITER_MBOX_CH_TRIGGER  UC_SW_WRITER_TX_PORT_CRED(16)
+
+enum uc_log_level {
+	UC_LOG_FATAL,
+	UC_LOG_ERROR,
+	UC_LOG_WARN,
+	UC_LOG_INFO,
+	UC_LOG_DEBUG,
+	UC_LOG_LEVELS_NUM
+};
+
+/**
+ * @brief UC log message
+ * @note keep the structure aligned to power of 2
+ */
+struct uc_log_msg {
+	u32  val;
+	u32  ts;
+	u8   level;
+	u8   rsrv;
+	char str[38];
+	char func[16];
+};
+
+/**
+ * @struct uc_fat_ent
+ */
+struct uc_fat_ent {
+	bool enable; /*! if entry is enabled */
+	u8   val;    /*! value to replace    */
+};
+
+/**
+ * @enum uc_egr_port
+ * @brief uc egress port type
+ */
+enum uc_egr_port {
+	UC_MCAST_PORT,
+	UC_REASS_PORT,
+	UC_FRAG_PORT,
+	UC_TDOX_PORT,
+	UC_IPSEC_PORT,
+	UC_EGR_MAX_PORT,
+};
+
+/**
+ * @brief init the uc egress mailbox module
+ * @return s32 0 on success, error code otherwise
