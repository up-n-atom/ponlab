+	PPUT_FAIL_TEST(pp_qos_queue_allocate(qdev, &q[0]) == 0,
+		       "Could not allocate queue\n");
+	PPUT_FAIL_TEST(pp_qos_queue_set(qdev, q[0], &confq) == 0,
