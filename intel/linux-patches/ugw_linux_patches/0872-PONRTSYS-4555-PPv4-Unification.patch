+		goto out;
+	}
+	/* init port dist */
+	ret = port_dist_init(&dts_cfg->port_dist_params);
+	if (unlikely(ret)) {
+		pr_err("Failed to init port dist module\n");
+		goto out;
+	}
+
+	/* init HW dynamic clock gating */
+	if (dts_cfg->infra_params.valid)
