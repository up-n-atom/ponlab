+{
+	if (unlikely(pmgr_port_del(PP_TEST_PORT, false))) {
+		pr_err("pp_port_del failed, port%u\n", PP_TEST_PORT);
+		return PP_UT_FAIL;
+	}
+
+	return PP_UT_PASS;
+}
