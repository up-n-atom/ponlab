+/**
+ * @brief set the egress uc shared accelerators
+ * @param cfg uc init parameters
+ * @return s32 0 on success, error code otherwise
+ */
+static s32 __uc_eg_shrd_acc_set(struct uc_egr_init_params *cfg)
+{
+	s32 ret, i;
+	u8 hw_max_cpu;
+
+	ret = uc_ccu_maxcpus_get(UC_IS_EGR, &hw_max_cpu);
+	if (unlikely(ret))
+		return ret;
+
+	for (i = 0; i < hw_max_cpu; i++)
+		__uc_cpu_valid_set(UC_IS_EGR, i, true);
+
+	ret = __uc_cluster_verify(UC_IS_EGR, cfg->cpus.max_cpu);
+	if (unlikely(ret))
+		return ret;
+
+	uc_ccu_ier_set(UC_IS_EGR, UC_CCU_INTERRUPT_ALL);
+	ret = __uc_cluster_mem_access_set(UC_IS_EGR);
+	if (unlikely(ret))
+		return ret;
+
+	uc_reader_wdt_set(UC_IS_EGR, true, true, UC_READER_WDT_DFLT_VAL);
+	uc_reader_ier_set(UC_IS_EGR, UC_READER_INTERRUPT_ALL);
+
+	for (i = 0; i < UC_EGR_MAX_PORT; i++) {
+		uc_reader_port_retry_count_set(UC_IS_EGR, i,
+					       UC_READER_RTRY_CNT_DFLT_VAL);
+	}
+
+	uc_reader_port_retry_interval_set(UC_IS_EGR,
+					  UC_READER_RTRY_ITRVL_DFLT_VAL);
+
+	uc_reader_wred_addr_set(UC_IS_EGR, cfg->wred_base);
+	uc_reader_client_addr_set(UC_IS_EGR, cfg->client_base);
+	uc_reader_qm_addr_set(UC_IS_EGR, cfg->qm_base);
+	uc_reader_bm_addr_set(UC_IS_EGR, cfg->bm_base);
+
+	/* DMAE */
+	ret = uc_dma_ddr_burst_len_set(UC_IS_EGR, UC_DMA_BRST_LEN_DFLT_VAL);
+	if (unlikely(ret))
+		return ret;
+	uc_dma_ddr_line_sz_set(UC_IS_EGR, UC_DMA_LINE_SZ_DFLT_VAL);
+
+	return 0;
+}
+
+/**
+ * @brief set the ingress uc shared accelerators
+ * @param cfg uc init parameters
+ * @return s32 0 on success, error code otherwise
+ */
+static s32 __uc_in_shrd_acc_set(struct uc_ing_init_params *cfg)
+{
+	s32 ret, i;
+	u8 hw_max_cpu;
+
+	ret = uc_ccu_maxcpus_get(UC_IS_ING, &hw_max_cpu);
+	if (unlikely(ret))
+		return ret;
+
+	for (i = 0; i < hw_max_cpu; i++)
+		__uc_cpu_valid_set(UC_IS_ING, i, true);
+
+	ret = __uc_cluster_verify(UC_IS_ING, cfg->cpus.max_cpu);
+	if (unlikely(ret))
+		return ret;
+
+	uc_ccu_ier_set(UC_IS_ING, UC_CCU_INTERRUPT_ALL);
+	ret = __uc_cluster_mem_access_set(UC_IS_ING);
+	if (unlikely(ret))
+		return ret;
+
+	uc_reader_wdt_set(UC_IS_ING, true, true, UC_READER_WDT_DFLT_VAL);
+	uc_reader_ier_set(UC_IS_ING, UC_READER_INTERRUPT_ALL);
+
+	/* DMAE */
+	ret = uc_dma_ddr_burst_len_set(UC_IS_ING, UC_DMA_BRST_LEN_DFLT_VAL);
+	if (unlikely(ret))
+		return ret;
+	uc_dma_ddr_line_sz_set(UC_IS_ING, UC_DMA_LINE_SZ_DFLT_VAL);
+
+	return 0;
+}
