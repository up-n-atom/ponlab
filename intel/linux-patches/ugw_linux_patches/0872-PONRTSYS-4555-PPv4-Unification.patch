+		       num_threads, db->num_lu_threads);
+		return -EINVAL;
+	}
+
+	pr_debug("num_threads=%u\n", num_threads);
+
+	/* set zeros in the 'num_threads' first bits */
+	PP_REG_WR32(PP_CLS_LU_MASK_REG, U32_MAX << num_threads);
