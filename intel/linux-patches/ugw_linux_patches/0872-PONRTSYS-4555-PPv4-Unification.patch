+	/* IPv6 -> L2TPv3 over IP */
+	params->pre[1].np_logic = NP_LOGIC_IPV6;
+	params->pre[1].val      = IPPROTO_L2TP;
+	/* extract info */
+	/* extract session id */
+	fld = &params->ext.fld[params->ext.n_fld++];
+	fld->fv_idx = offsetof(struct pp_fv, first.l4.l2tpoip);
+	fld->len    = L2TPV3IP_SESS_ID_SZ;
+	fld->off    = 0;
+	fld->mask   = 0;
+	__proto_pr_debug(info);
+	pr_debug("done\n");
+
+	return 0;
+}
