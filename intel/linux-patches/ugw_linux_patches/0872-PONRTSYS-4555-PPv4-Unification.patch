+/**
+ * @brief Get port's segmentation enable status
+ * @param pid the port
+ * @param seg_en pointer to store the status
+ * @return s32 0 on success, error code otherwise
+ */
+s32 pp_port_seg_en_get(u16 pid, bool *seg_en);
