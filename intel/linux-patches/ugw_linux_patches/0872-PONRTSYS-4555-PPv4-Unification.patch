+	spin_lock_bh(&db->port_lock);
+
+	/* Get the exception session ID (DP) from HAL */
+	ret = chk_exception_session_map_get(pid, tc, hoh, &hal_dp);
+	if (ret) {
+		pr_err("Exception map get failed for port %d, tc %d\n",
+		       pid, tc);
+	}
+
+	spin_unlock_bh(&db->port_lock);
+
+out:
+	return hal_dp;
