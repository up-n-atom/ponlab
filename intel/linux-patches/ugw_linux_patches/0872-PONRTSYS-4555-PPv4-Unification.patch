+	reg |= PP_FIELD_PREP(PP_PRSR_MAC_CFG_PIT_IDX_MSK,    pit->base);
+	pr_debug("len = %u, pit base %u, pit cnt %u --> reg %#x\n",
+		 len, pit->base, pit->cnt, reg);
