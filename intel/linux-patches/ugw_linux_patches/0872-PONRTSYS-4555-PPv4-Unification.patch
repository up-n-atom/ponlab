-	if (QOS_BW_GRP_VALID(id) && (qdev->groups[id].used)) {
-		_pp_qos_shared_limit_group_get_members(
-				qdev, id, &tmp, 1, &num);
-		if (num) {
-			QOS_LOG_ERR(
-					"Shared group %u has members can't remove\n",
-					id);
