+	seq_puts(f, " +-------+-----------------+\n");
+	seq_puts(f, " | PIT   | Length          |\n");
+	seq_puts(f, " +-------+-----------------+\n");
+	__pit_seq_printf(f, &pit, 5);
+	seq_printf(f, " | %-15u |\n", len);
+
+	ret = prsr_ethertype_cfg_get(&dflt, &pit);
+	if (unlikely(ret)) {
