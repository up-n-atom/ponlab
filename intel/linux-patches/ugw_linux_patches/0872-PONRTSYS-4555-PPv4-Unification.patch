+#ifndef __PP_SESSION_MGR_INTERNAL_H__
+#define __PP_SESSION_MGR_INTERNAL_H__
+
+#include <linux/types.h>
+#include <linux/spinlock.h>
+#include <linux/list.h>
+#include <linux/bitops.h>
+#include <linux/pp_api.h>
