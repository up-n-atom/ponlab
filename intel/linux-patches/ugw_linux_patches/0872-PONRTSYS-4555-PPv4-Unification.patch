+/**
+ * @brief send a mailbox command to the egress(only) uc
+ * @param type command type
+ * @param param command parameter (optional)
+ * @param response command response address (optional)
+ * @param response_len command response buffer size (optional)
+ * @return s32 0 on success, error code otherwise
+ */
+s32 uc_egr_mbox_cmd_send(enum uc_mbox_cmd_type type, u32 param, void *response,
+			 u16 response_len);
+
+/**
+ * @brief send a mailbox command to the egress(only) uc w/o
+ *        a response back
+ * @param type command type
+ * @param buff buffer with the params (optional)
+ * @param len buffer length (optional)
+ * @return s32 0 on success, error code otherwise
+ */
+s32 uc_egr_mbox_cmd_send_buff(enum uc_mbox_cmd_type type, const u32 *buff,
+			      size_t len);
+
+/**
+ * @brief allocate a DDR buffer for mailbox command
+ * @param phys allocated buffer physical address
+ * @param sz buffer size
+ * @return void* allocated buffer cpu address, NULL if failed
+ */
+void *uc_egr_mbox_buff_alloc(dma_addr_t *phys, size_t sz);
+
+/**
+ * @brief free the mailbox command DDR buffer
+ * @param virt buffer cpu address
+ * @param phys buffer physical address
+ * @param sz buffer size
