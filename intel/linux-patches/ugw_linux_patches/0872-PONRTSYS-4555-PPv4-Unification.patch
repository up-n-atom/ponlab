+	seq_printf(f, " %-20s: %d\n",   "pkt_len_diff", si->pkt_len_diff);
+	seq_printf(f, " %-20s: %#lx\n", "sgc_en_map  ", si->sgc_en_map);
+	for_each_set_bit(i, &si->sgc_en_map, PP_SI_SGC_MAX)
