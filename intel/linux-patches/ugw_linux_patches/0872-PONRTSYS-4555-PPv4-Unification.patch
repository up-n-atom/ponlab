+{
+	struct smgr_stats *stats = &db->stats;
+
+	atomic_inc(&stats->sess_deleted);
+	atomic_dec(&stats->sess_open);
+	atomic_inc(&stats->sess_free);
+	/* TBD: update session type based stats: IPv4, IPv6, TCP, UDP */
+}
