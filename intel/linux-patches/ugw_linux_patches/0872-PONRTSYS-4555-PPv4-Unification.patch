-static u32 enable_pop(void)
-{
-	u32 reg = RD_REG_32(BMGR_CTRL_REG_ADDR(BM_BASE));
-
-	reg &= (~0x2);
-	WR_REG_32(BMGR_CTRL_REG_ADDR(BM_BASE), reg);
-
-	return RC_SUCCESS;
-}
-
-static u32 disable_pop(void)
-{
-	u32 reg = RD_REG_32(BMGR_CTRL_REG_ADDR(BM_BASE));
-
-	reg |= 0x2;
-	WR_REG_32(BMGR_CTRL_REG_ADDR(BM_BASE), reg);
-
-	return RC_SUCCESS;
-}
