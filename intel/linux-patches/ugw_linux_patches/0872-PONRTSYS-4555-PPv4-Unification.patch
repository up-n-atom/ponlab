+	QOS_LOCK(qdev);
+	PP_QOS_ENTER_FUNC();
+	if (!qos_device_ready(qdev)) {
+		rc = -EINVAL;
+		goto out;
+	}
+
+	rc = _pp_qos_port_conf_get(qdev, id, &conf);
+	if (rc)
+		goto out;
+
+	conf.disable = 1;
+	rc =  _pp_qos_port_set(qdev, id, &conf);
+	if (rc)
+		goto out;
+
+	update_cmd_id(&qdev->drvcmds);
+	rc = transmit_cmds(qdev);
+out:
+	QOS_UNLOCK(qdev);
+	return rc;
+}
