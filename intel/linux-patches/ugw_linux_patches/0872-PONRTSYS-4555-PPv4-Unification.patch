+enum sgc_opts {
+	sgc_opt_help = 1,
+	sgc_opt_owner,
+	sgc_opt_grp,
+	sgc_opt_cntr,
+	sgc_opt_reset,
+	sgc_opt_pkts,
+	sgc_opt_bytes,
+	sgc_opt_print,
+	sgc_opt_alloc,
+	sgc_opt_free,
+	sgc_opt_res,
+	sgc_opt_unres,
+	sgc_opt_add,
+	sgc_opt_sub,
+};
+
+enum sgc_action {
+	SGC_ACT_HELP,
+	SGC_ACT_GET,
+	SGC_ACT_MOD,
+	SGC_ACT_ALLOC,
+	SGC_ACT_FREE,
+	SGC_ACT_RES,
+	SGC_ACT_UNRES,
+	SGC_NUM_ACTIONS
+};
+
+struct sgc_dbg_args {
+	enum pp_stats_op op;
+	enum sgc_action act;
+	struct pp_stats stats;
+	u32 n_sessions;
+	u32 owner;
+	u8  grp;
+	u16 cntr;
+};
+
+static const match_table_t sgc_tokens = {
+	{sgc_opt_help,  "help"},
+	{sgc_opt_print, "print"},
+	{sgc_opt_alloc, "alloc"},
+	{sgc_opt_free,  "free"},
+	{sgc_opt_res,   "res"},
+	{sgc_opt_unres, "unres"},
+	{sgc_opt_add,   "add"},
+	{sgc_opt_sub,   "sub"},
+	{sgc_opt_reset, "reset"},
+	{sgc_opt_owner, "owner=%u"},
+	{sgc_opt_grp,   "grp=%u"},
+	{sgc_opt_cntr,  "cntr=%u"},
+	{sgc_opt_pkts,  "pkts=%u"},
+	{sgc_opt_bytes, "bytes=%u"},
+};
