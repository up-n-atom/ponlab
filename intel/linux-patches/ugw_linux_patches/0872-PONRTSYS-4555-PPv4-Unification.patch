+	/* Check port value validity */
+	if (unlikely(!__pp_is_port_valid(pid)))
+		goto out;
+
+	/* Check TC value validity */
+	if (unlikely(!PP_IS_TC_VALID(tc)))
+		goto out;
+
+	/* Check Hash Of Hash value validity */
+	if (unlikely(hoh >= CHK_HOH_MAX))
+		goto out;
