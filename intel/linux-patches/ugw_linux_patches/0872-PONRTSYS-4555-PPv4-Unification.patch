-		QOS_ASSERT(same_octet(first_phy, first_phy + count - 1) &&
-			   same_octet(first_phy, first_phy + shift) &&
-			   same_octet(first_phy, first_phy + shift + count - 1)
-			   ,
-			   "shift %d places of %u nodes from %u crosses octet boundaries\n",
