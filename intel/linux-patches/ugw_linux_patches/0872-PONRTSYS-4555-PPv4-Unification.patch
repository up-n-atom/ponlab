+	if (unlikely(!(state >= SMGR_DISABLE &&
+		       state <= SMGR_ENABLE))) {
+		pr_err("invalid state %u\n", state);
+		return -EINVAL;
+	}
+
+	__smgr_lock();
+	if (state == SMGR_DISABLE)
+		__smgr_port_flush(PP_MAX_PORT);
+	db->state = state;
+	__smgr_unlock();
+	pr_debug("PP Session Manager %s\n", state == SMGR_ENABLE ?
+		 "enabled" : "disabled");
+
+	return 0;
+}
