+	u32 port_invalid_err;
+	u32 port_invalid_headroom;
+	u32 port_act_err;
+	u32 port_inact_err;
+	u32 port_update_no_changes_err;
+	u32 port_cls_param_err;
+	u32 port_policy_param_err;
+	u32 port_tx_cfg_err;
+	u32 port_rx_cfg_err;
