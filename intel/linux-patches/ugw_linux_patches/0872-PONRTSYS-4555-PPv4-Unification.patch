+}
+
+PP_DEFINE_DEBUGFS(test_dma, __dbg_test_dma, NULL);
+
+/* Currently pop one buffer from policies 0-3 in increament order */
+void __dbg_pop(struct seq_file *f)
+{
+	memset(&buff_info, 0x0, sizeof(buff_info));
+
+	buff_info.num_allocs = 1;
+	buff_info.policy_id = policy_pop_test;
+
+	bmgr_pop_buffer(&buff_info);
+
+	policy_pop_test++;
+	if (policy_pop_test == 4)
+		policy_pop_test = 0;
+
+	seq_printf(f, "pop buffer address 0x%x (high 0x%x) from policy %d pool %d\n",
+		   buff_info.addr_low[0], buff_info.addr_high[0],
+		   buff_info.policy_id, buff_info.pool_id[0]);
+}
+
+PP_DEFINE_DEBUGFS(pop, __dbg_pop, NULL);
+
+/* Currently push only last pop-ed buffer */
+void __dbg_push(struct seq_file *f)
+{
+	bmgr_push_buffer(&buff_info);
+
+	seq_printf(f, "push buffer address 0x%x (high 0x%x) from policy %d pool %d\n",
+		   buff_info.addr_low[0], buff_info.addr_high[0],
+		   buff_info.policy_id, buff_info.pool_id[0]);
+}
+
+PP_DEFINE_DEBUGFS(push, __dbg_push, NULL);
+
+static struct debugfs_file bm_debugfs_files[] = {
+	{"hw_stats", &PP_DEBUGFS_FOPS(hw_stats)},
+	{"sw_stats", &PP_DEBUGFS_FOPS(sw_stats)},
+	{"pop", &PP_DEBUGFS_FOPS(pop)},
+	{"push", &PP_DEBUGFS_FOPS(push)},
+	{"test_dma", &PP_DEBUGFS_FOPS(test_dma)},
+	{"conf_get", &PP_DEBUGFS_FOPS(conf_get)},
+	{"conf_set", &PP_DEBUGFS_FOPS(conf_set)},
+	{"pool_add", &PP_DEBUGFS_FOPS(pool_add)},
+	{"pool_rem", &PP_DEBUGFS_FOPS(pool_rem)},
+	{"policy_add", &PP_DEBUGFS_FOPS(policy_add)},
+	{"policy_rem", &PP_DEBUGFS_FOPS(policy_rem)},
+	{"policy_reset", &PP_DEBUGFS_FOPS(policy_reset)},
+};
