+		   pmgr->hif_dps_count);
+
+	pr_buf_cat(buf, sz, *n, " | %-28s | %-10u | %-28s | %-10u |\n",
+		   "Active Policies", bmgr->active_policies, "Active Pools",
+		   bmgr->active_pools);
+
+	pr_buf_cat(buf, sz, *n, " | %-28s | %-10u | %-28s | %-10u |\n",
+		   "Active QOS Nodes", qos->active_nodes, "Active QOS Ports",
