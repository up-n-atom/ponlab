+	stats->total_bytes_used =
+		RPB_GLB_FILLING_CNT_GET(PP_REG_RD32(RPB_GLB_FILLING_CNT_REG));
+	stats->total_pkts_used =
+		RPB_GLB_PKTS_CNT_GET(PP_REG_RD32(RPB_GLB_PKTS_CNT_REG));
