+	seq_puts(f, " | PIT   | Default PC      |\n");
+	seq_puts(f, " +-------+-----------------+\n");
+	__pit_seq_printf(f, &pit, 5);
+	seq_printf(f, " | %-15u |\n", dflt);
+
+	__pr_l2_entries(f, 0, ~0, true, true);
+}
