+void __smgr_dbg_inact_sessions_dump(struct seq_file *f)
+{
+	struct pp_request req;
+	u32 *sessions, n_sessions;
+	s32 ret;
+
+	ret = smgr_sessions_arr_alloc(&sessions, &n_sessions);
+	if (unlikely(ret))
+		return;
