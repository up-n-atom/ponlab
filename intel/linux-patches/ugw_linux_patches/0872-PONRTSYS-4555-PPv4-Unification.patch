+	(BM_PLCY_POOLS_MAPPING_BASE + BM_OFFSET_OF_PLCY(policy))
+
+#define BM_PLCY_ALLOC_BUFF_CTR_BASE                   (PP_BM_RAM_BASE + 0xA000)
