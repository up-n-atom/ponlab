+static int test_ports(struct pp_qos_dev *qdev)
+{
+	struct pp_qos_port_conf conf;
+	struct pp_qos_queue_conf confq;
+	unsigned int id1;
+	unsigned int id2;
+	int tmp;
+	struct qos_node *node;
+	struct pp_qos_port_info info;
+	uint16_t ids[5];
+	unsigned int tmp2;
+	u32 qid[3];
+	s32 ret;
+
