+static void __smgr_dbg_sess_del_help(void)
+{
+	pr_info("\n");
+	pr_info(" Usage: echo <option>[=value] > delete_session\n");
+	pr_info(" Options:\n");
+	pr_info("   help - print this help function\n");
+	pr_info("   id   - session id to delete\n");
+	pr_info("   prio - session delete priority\n");
