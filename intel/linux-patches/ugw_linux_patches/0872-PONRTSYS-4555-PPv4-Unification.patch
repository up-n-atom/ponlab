+	/* (DSlite) IPv4 -> IPv4 */
+	params->pre[0].np_logic = NP_LOGIC_IPV4;
+	params->pre[0].val      = IPPROTO_IPIP;
+	/* (DSlite) IPv6 -> IPv4 */
