+
+s32 cls_session_lookup(void *fv, u32 fv_sz, struct pp_hash *hash, u32 *id)
+{
+	struct cuckoo_hash_item session;
+
+	if (unlikely(!(!ptr_is_null(fv)   &&
+		       !ptr_is_null(hash) &&
+		       !ptr_is_null(id))))
+		return -EINVAL;
+
+	/* set invalid value */
+	*id             = CLS_SESSION_INVALID;
+	/* prepare the cuckoo item */
+	session.key     = fv;
+	session.key_len = fv_sz;
+	session.h1      = hash->h1;
+	session.h2      = hash->h2;
+	session.sig     = hash->sig;
+
+	if (cuckoo_hash_lookup(db->cuckoo, &session) != EEXIST) {
+		pr_debug("session not found in cuckoo hash\n");
+		goto done;
+	}
+
+	*id = (unsigned long)session.value;
+	pr_debug("session %u found in cuckoo hash\n", *id);
+
+done:
+	return 0;
+}
+
+s32 cls_session_add(void *si, struct pp_hash *hash)
+{
+	struct cuckoo_hash_item session;
+	u32 s_id, fv_sz;
+	s32 ret;
+
+	if (unlikely(!(!ptr_is_null(si) &&
+		       !ptr_is_null(hash))))
+		return -EINVAL;
+
+	/* store the si template for the event handling */
+	db->cls_si_req     = si;
+	db->cls_cmd_status = 0;
+
+	ret = pp_si_fld_get(si, SI_FLD_SESS_ID, &s_id);
+	if (unlikely(ret))
+		return -EINVAL;
+
+	ret = pp_si_fld_get(si, SI_FLD_FV_SZ, &fv_sz);
+	if (unlikely(ret))
+		return -EINVAL;
+
+	/* prepare the cuckoo item */
+	if (s_id >= db->num_sessions) {
+		pr_err("invalid session id %u, support %u sessions\n",
+		       s_id, db->num_sessions);
+		return -EINVAL;
+	}
+
+#ifdef CONFIG_PPV4_FPGA
+	memcpy(&db->fv[s_id], CLS_FV_START_ADDR(si, fv_sz), fv_sz);
+	session.key        = &db->fv[s_id];
+#else /* !CONFIG_PPV4_FPGA */
+	session.key = (void *)CLS_FV_ADDR((unsigned long)(db->si_base_virt),
+					  s_id, fv_sz);
+#endif /* CONFIG_PPV4_FPGA */
+
+	session.key_len    = fv_sz;
+	session.value      = (void *)(unsigned long)s_id;
+	session.h1         = hash->h1;
+	session.h2         = hash->h2;
+	session.sig        = hash->sig;
+
+	ret = cuckoo_hash_insert(db->cuckoo, &session);
+	if (ret) {
+		pr_err("failed to add the session to cuckoo hash, %u\n", s_id);
+		return ret;
+	}
+
+	return db->cls_cmd_status;
+}
+
+static inline bool __cls_is_cmd_fifo_ready(u32 cmd_num_words)
+{
+	u32 reg;
+
+	/* Check num of free words on FIFO */
+	reg = FIELD_GET(PP_CLS_CMD_STATUS_FW_REMAIN_WORD_MSK,
+			PP_REG_RD32(PP_CLS_CMD_STATUS_REG));
+
+	if (reg < cmd_num_words) {
+		pr_err("Not enough space in cmd FIFO, needed=%u, left=%u\n",
+		       CLS_UPDATE_CMD_SZ, reg);
+		return false;
+	}
+
+	return true;
+}
+
+static inline void __cls_cmd_hash_wr(u32 h1, u32 h2, u32 sig)
+{
+	/* Write the hash results to command fifo */
+	PP_REG_WR32(PP_CLS_CMD_DATA_REG, h1);
+	PP_REG_WR32(PP_CLS_CMD_DATA_REG, h2);
+	PP_REG_WR32(PP_CLS_CMD_DATA_REG, sig);
+}
+
+static inline void __cls_cmd_start(u32 cmd)
+{
+	/* Kick command */
+	PP_REG_WR32(PP_CLS_CMD_KICK_REG, cmd);
+}
+
+static inline bool __cls_cmd_is_done(void)
+{
+	if (pp_reg_poll(PP_CLS_CMD_STATUS_REG, PP_CLS_CMD_STATUS_MSK, 0)) {
+		pr_err("Failed polling on classifier command status\n");
+		return false;
+	}
+
+	return true;
+}
+
+s32 cls_session_dsi_update(u32 id, u16 dst_q, bool clr_cntr)
+{
+	u32 reg;
+
+	pr_debug("CLS CMD update session %u: new_queue=%hu clear_counters=%s\n",
+		 id, dst_q, clr_cntr ? "YES" : "NO");
+
+	/* do we have something to update ?*/
+	if (unlikely(dst_q == PP_QOS_INVALID_ID && !clr_cntr)) {
+		pr_err("nothing to update for session %u\n", id);
+		return -EINVAL;
+	}
+
+	if (unlikely(!__cls_is_cmd_fifo_ready(CLS_UPDATE_CMD_SZ)))
+		return -ENOMEM;
+
+	/* Write the hash results - NA for update command */
+	__cls_cmd_hash_wr(0, 0, 0);
+
+	/* Write the command info */
+	reg  = PP_FIELD_PREP(CLS_CMD_UPDT_DSI_INFO, 1);
+	reg |= PP_FIELD_PREP(CLS_CMD_SESS_ID, id);
+	PP_REG_WR32(PP_CLS_CMD_DATA_REG, reg);
+
+	/* Write DSI info */
+	if (dst_q != PP_QOS_INVALID_ID) {
+		reg |= PP_FIELD_PREP(CLS_CMD_DSI_DQWR, 1);
+		reg |= PP_FIELD_PREP(CLS_CMD_DSI_DST_Q, dst_q);
+	}
+	reg |= PP_FIELD_PREP(CLS_CMD_DSI_CNT_CLR, clr_cntr);
+	PP_REG_WR32(PP_CLS_CMD_DATA_REG, reg);
+
+	/* Kick command */
+	__cls_cmd_start(CLS_CMD_IF_UPDATE);
+
+	if (unlikely(!__cls_cmd_is_done()))
+		return -ETIME;
+
+	pr_debug("CMD done successfully\n");
+
+	return 0;
+}
+
+s32 cls_session_del(u32 id, u32 fv_sz, struct pp_hash *hash)
+{
+	struct cuckoo_hash_item session;
+	s32 ret;
+
+	if (unlikely(ptr_is_null(hash)))
+		return -EINVAL;
+
+	if (unlikely(!fv_sz)) {
+		pr_err("field vector size is zero\n");
+		return -EINVAL;
+	}
+
+	db->cls_cmd_status = 0;
+
+	/* prepare the cuckoo item */
+#ifdef CONFIG_PPV4_FPGA
+	if (id >= db->num_sessions) {
+		pr_err("invalid session id %u, support %u sessions\n",
+		       id, db->num_sessions);
+		return -EINVAL;
+	}
+	session.key        = &db->fv[id];
+#else /* !CONFIG_PPV4_FPGA */
+	session.key = (void *)CLS_FV_ADDR((unsigned long)(db->si_base_virt),
+					  id, fv_sz);
+#endif /* CONFIG_PPV4_FPGA */
+	session.key_len    = fv_sz;
+	session.h1         = hash->h1;
+	session.h2         = hash->h2;
+	session.sig        = hash->sig;
+
+	ret = cuckoo_hash_remove(db->cuckoo, &session);
+	if (ret) {
+		pr_err("failed to del the session from cuckoo hash, %u\n", id);
+		return ret;
+	}
+
+	return db->cls_cmd_status;
+}
