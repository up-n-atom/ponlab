+static const match_table_t l2_tokens = {
+	{l2_opt_idx,      "idx=%u"     },
+	{l2_opt_valid,    "valid=%u"   },
+	{l2_opt_fallback, "fallback=%u"},
+	{l2_opt_cmp_op,   "cmp_op=%u"  },
+	{l2_opt_ethtype,  "ethtype=%u" },
+	{l2_opt_len,      "len=%u"     },
+	{l2_opt_pit_idx,  "pidx=%u"    },
