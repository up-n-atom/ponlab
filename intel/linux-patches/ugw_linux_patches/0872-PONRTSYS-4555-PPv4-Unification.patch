+	BUF_FLD_INIT_DESC(cls_stw_flds, STW_CLS_FLD_TCP_ACK);
+	BUF_FLD_INIT_DESC(cls_stw_flds, STW_CLS_FLD_TCP_DATA_OFFSET);
