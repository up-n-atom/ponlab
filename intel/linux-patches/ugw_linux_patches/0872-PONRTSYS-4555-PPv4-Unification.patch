+#define RPB_CMD_SRC_40MODE_REG          (PP_RPB_GLGEN_DUAL40_REG)
+#define RPB_RX_DMA_CMD_SRC_SET(r, s)    PP_FIELD_MOD((u32)BIT(4), s, r)
+#define RPB_RX_DMA_CMD_SRC_GET(r)       PP_FIELD_GET((u32)BIT(4), r)
