+
+#endif /* __PP_UC_INTERNAL_H__ */
diff --git a/drivers/net/ppv4/pp-hal/micro-controller/uc_private_engines.h b/drivers/net/ppv4/pp-hal/micro-controller/uc_private_engines.h
new file mode 100644
index 000000000000..686bfa0d4ccf
--- /dev/null
+++ b/drivers/net/ppv4/pp-hal/micro-controller/uc_private_engines.h
@@ -0,0 +1,276 @@
+/*
+ * uc_private_engines.h
+ * Description: PP micro-comtrollers private accelerators definitions
+ *
+ * SPDX-License-Identifier: GPL-2.0-only
+ * Copyright (C) 2019 Intel Corporation
+ */
+
+#ifndef __PP_UC_PRIVATE_ENGINES_H__
+#define __PP_UC_PRIVATE_ENGINES_H__
+
+/* this file defines the <AID,RID> of the HW entities in the
+ * uC  (aka Private engines)
+ *  +-------------------------------------------------------+
+ *  | Important: the <AID,RID> must be aligned with the RDL |
+ *  +-------------------------------------------------------+
+ * Comments:
+ *(1): internal register, can be used for debug.
+ *(2): set by host
+ */
+
+/* Private Engines AID: */
+/**
+ * @define boot configuration
+ */
+#define BOOT_AID        0
+/**
+ * @define task switch SM
+ */
+#define TSSM_AID        1
+/**
+ * @define task scheduler
+ */
+#define TASKSCHED_AID   2
+/**
+ * @define multitasking support registers
+ */
+#define MTSR_AID        3
+/**
+ * @define BGCopy helper
+ */
+#define BGCH_AID        4
+/* AIDs 5,6,7 are reserved */
+/**
+ * @define GP registers (BGCopy arbiter)
+ */
+#define GP_REG_AID      8
+/**
+ * @define auxiliary registers (BGCopy arbiter)
+ */
+#define AUX_REG_AID     9
+/**
+ * @define common to InsertJob, ExtractJob
+ */
+#define EXTINSJOB_AID   10
+/**
+ * @define InsertJob
+ */
+#define INSERTJOB_AID   11
+/**
+ * @define pop accelerator
+ */
+#define POPA_AID        12
+/**
+ * @define ExtractJob
+ */
+#define EXTRACTJOB_AID  13
+/**
+ * @define push engine
+ */
+#define PUSHE_AID       14
+/**
+ * @define copy accelerator
+ */
+#define COPYA_AID       15
+/**
+ * @define post accelerator
+ */
+#define POSTA_AID       16
+/**
+ * @define accept accelerator
+ */
+#define ACCEPTA_AID     17
+/**
+ * @define alarm clock
+ */
+#define DELAYA_AID      18
+/**
+ * @define sort accelerator
+ */
+#define SORTA_AID       19
+
+////////////////////////////////
+// RID of registers, per AID: //
+////////////////////////////////
+
+/* Boot: */
+/**
+ * @define (2) uC vector table
+ */
+#define BOOT_RST_VEC            0
+/**
+ * @define (2) outputs the signal arc_run_req_a
+ */
+#define BOOT_CORE_RUNHALT       1
+/**
+ * @define (1) holds MyCID, hard-wired
+ */
+#define BOOT_MYCID              2
+/**
+ * @define general-purpose 32 bits
+ */
+#define BOOT_GPREG              3
+/**
+ * @define RW, array, debug
+ */
+#define BOOT_SWREG              4
+/**
+ * @define (2) inputs the signal arc_run_ack
+ */
+#define BOOT_RUNHALT_ACK        5
+/**
+ * @define holds the value of MY_FUSE[1:0] (MAC-CPU)
+ */
+#define BOOT_GETFUSE            6
+
+/* TSSM: */
+/**
+ * @define next task ID
+ */
+#define TSSM_NEXT               0
+/**
+ * @define previous task ID
+ */
+#define TSSM_PREV               1
+/**
+ * @define Enable core sleep in sleep state
+ */
+#define TSSM_SLEEP_EN           2
+/**
+ * @define write at init to start the SM
+ */
+#define TSSM_ENABLE             3
+/**
+ * @define write at init
+ */
+#define TSSM_WDT_VAL            4
+/**
+ * @define write at init after enabling the SM
+ */
+#define TSSM_WDT_RESET          5
+
+/* TASKSCHED: */
+/**
+ * @define ID of next task to switch to
+ */
+#define TASKSCHED_NTID          0
+/**
+ * @define write at init to start the logic
+ */
+#define TASKSCHED_ENABLE        1
+/**
+ * @define scheduler algorithm
+ */
+#define TASKSCHED_ALGO          2
+
+/* MTSR: */
+/**
+ * @define Ready vector
+ */
+#define MTSR_READY              0
+#define MTSR_HIPRIOR            1
+#define MTSR_CTID               2
+#define MTSR_QUSTAMP            3
+
+/* BGCH: */
+#define BGCH_RDRSRL             0
+#define BGCH_POP                1
+#define BGCH_POPQU              2
+#define BGCH_START_OP           3
+#define BGCH_TID                4
+
+/* EXTINSJOB: */
+#define EXTINSJOB_MODE          0
+#define EXTINSJOB_PD_SIZE       1
+#define EXTINSJOB_HDR_OFFSET    2
+#define EXTINSJOB_JOB_OFFSET    3
+
+/**
+ * @define INSERTJOB: num of jobs inserted to DCCM via INSERTJOB
+ */
+#define INSERTJOB_TOTAL         0
+
+/* POPA: */
+/**
+ * @define triggers pop operation
+ */
+#define POPA_START              0
+/**
+ * @define array, maps tasks to queues
+ */
+#define POPA_MAP                1
+#define POPA_TID                2
+#define POPA_TYPE               3
+#define POPA_JOBIDX             4
+#define POPA_COUNT              5
+#define POPA_ACTIVE_LO          6
+#define POPA_ACTIVE_HI          7
+#define POPA_NEWINQU            8
+/**
+ * @define holds the last updated JOB_BASE
+ */
+#define POPA_LASTJB             9
+
+/* PUSHE: */
+/**
+ * @define used to push a job back to default queue
+ */
+#define PUSHE_PUTJOB            0
+
+/* COPYA: */
+/**
+ * @define used by BGCH to insert a copy request into FIFO
+ */
+#define COPYA_START             0
+/**
+ * @define holds the DMA channel and the priority.
+ * used by DMAE to invoke the COPYA to program the channel
+ */
+#define COPYA_GO                1
+/**
+ * @define FIFO of tasks per priority
+ */
+#define COPYA_PENDTASK          2
+/**
+ * @define array of copy requests
+ */
+#define COPYA_REQUEST           3
+
+/* POSTA: */
+#define POSTA_START         0
+
+/**
+ * @define per task t, MSG0[t]+MSG1[t] holds 8 bytes message
+ */
+#define POSTA_MSG0          1
+#define POSTA_MSG1          2
+#define POSTA_GO            3
+#define POSTA_H_MSG0        4
+#define POSTA_H_MSG1        5
+#define POSTA_OBJ           6
+#define POSTA_ACTIVE        7
+#define POSTA_H_VALID       8
+#define POSTA_H_TASK        9
+#define POSTA_COUNT         10
+#define POSTA_STAMP         11
+
+/* ACCEPTA: */
+#define ACCEPTA_START           0
+#define ACCEPTA_DEST            1
+
+/* DELAYA: */
+#define DELAYA_START            0
+/**
+ * @define 5 bits
+ */
+#define DELAYA_SCALE            1
+/**
+ * @define relevant to MAC-CPU only
+ */
+#define DELAYA_ABORT            2
+
+/* SORTA: */
+#define SORTA_START             0
+
+#endif /* __PP_UC_PRIVATE_ENGINES_H__ */
diff --git a/drivers/net/ppv4/pp-hal/micro-controller/uc_regs.h b/drivers/net/ppv4/pp-hal/micro-controller/uc_regs.h
new file mode 100644
index 000000000000..0fed76ea547d
--- /dev/null
+++ b/drivers/net/ppv4/pp-hal/micro-controller/uc_regs.h
@@ -0,0 +1,434 @@
+/*
+ * uc.h
+ * Description: PP micro-comtroller definitions
+ *
+ * SPDX-License-Identifier: GPL-2.0-only
+ * Copyright (C) 2019 Intel Corporation
+ */
+
+#ifndef __PP_UC_REGS_H__
+#define __PP_UC_REGS_H__
+
+#include "uc_private_engines.h"
+#include "uc_shared_engines.h"
+
+extern u64 uc_egr_base_addr;
+extern u64 uc_ing_base_addr;
+
+/* uC Cluster has base address: */
+#define EGRESS_UC_BASE  uc_egr_base_addr
+#define INGRESS_UC_BASE uc_ing_base_addr
+
+/* RTL parameters */
+#define UC_MAXPORT             16
+#define UC_MAXCPU              4
+#define UC_EGR_MAXTASK         32
+#define UC_EGR_MAXQUEUE        6
+#define UC_EGR_MAXJOB          8
+#define UC_EGR_JOBSIZE         256
+#define UC_EGR_QUEUESIZE       2048
+#define UC_EGR_MAXMBOXCHANNEL  8
+#define UC_EGR_LN_JOBSIZE      8
+#define UC_EGR_LN_MAXJOB       3
+#define UC_EGR_LN_MAXQUEUE     3
+#define UC_EGR_LN_MAXPORT      4
+#define UC_EGR_MAXSYNCOBJ      16
+#define UC_EGR_MAX_QU_CREDIT   7
+
+#define UC_ING_MAXQUEUE        2
+#define UC_ING_MAXTASK         16
+#define UC_ING_MAXJOB          6
+#define UC_ING_JOBSIZE         1024
+#define UC_ING_QUEUESIZE       8192
+#define UC_ING_LN_JOBSIZE      10
+#define UC_ING_LN_MAXJOB       3
+#define UC_ING_LN_MAXQUEUE     1
+
+/* From the host's point of view,
+ * a uC Cluster address map is divided into 4 peripherals,
+ * with IDs:
+ */
+/**
+ * @define DCCM of an individual uC
+ */
+#define PERIPH_ID_DCCM        0
+
+/**
+ * @define The shared SRAM in the cluster
+ */
+#define PERIPH_ID_SHARED_SRAM 1
+
+/**
+ * @define The entities inside an individual uC, except its DCCM
+ */
+#define PERIPH_ID_PRVT_ACCL   2
+
+/**
+ * @define The entities which are common to all uC in the
+ *         Cluster, except the shared SRAM
+ */
+#define PERIPH_ID_SHARED_ACCL 3
+
+/*********************/
+/* Private registers */
+/*********************/
+
+/* Address of a register is: <NAME>_UC_BASE|OFFSET,
+ * where NAME is INGRESS or EGRESS, and the OFFSET has the following format:
+ * +------+-------------------+-----+-----+------+----------+---+
+ * |Size: |                2  |  2  |  5  |  5   |    6     | 2 |
+ * +------+-------------------+-----+-----+------+----------+---+
+ * |Name: |Peripheral_ID      |uCID | AID | RID  |Index     | - |
+ * +------+-------------------+-----+-----+------+----------+---+
+ * |Value:|PERIPH_ID_PRVT_ACCL|uCID | AID | RID  |Index/CTID| 0 |
+ * +------+-------------------+-----+-----+------+----------+---+
+ * |Range:|        21:20      |19:18|17:13| 12:8 |    7:2   |1:0|
+ * +------+-------------------+-----+-----+------+----------+---+
+ *
+ * conventions:
+ * t - uC type, either INGRESS or EGRESS
+ * c - uC id, in range 0..MAXCPU
+ * a - accelerator name
+ * r - register name
+ * q - queue id, in range 0..MAXQUEUE
+ * p - port id, in range 0..MAXPORT
+ * n - channel number, in range 0..MAXMBOXCHANNEL
+ * e - event number, in range 0..MAXHWEVENT
+ * x,y - indices
+ * z - offset in memory
+ */
+
+/**
+ * @define address of integer at offset z in DCCM:
+ */
+#define UC_DCCM(t, c, z)                 \
+	((t ## _UC_BASE) | (PERIPH_ID_DCCM << 20) | ((c) << 18) | (z))
+
+/**
+ * @define address of integer at offset z in shared SRAM:
+ */
+#define UC_SSRAM(t, z)                 \
+	((t ## _UC_BASE) | (PERIPH_ID_SHARED_SRAM << 20) | (z))
+
+/**
+ * @define private accelerators registers base address
+ * @param t uc type name INGRESS/EGRESS
+ */
+#define UC_PRIV_BASE(t)                  \
+	((t ## _UC_BASE) | (PERIPH_ID_PRVT_ACCL << 20))
+
+/**
+ * @define private accelerators register address
+ * @param t uc type name INGRESS/EGRESS
+ * @param c uc cpu id
+ * @param a accelerator name AID
+ * @param r register id RID
+ */
+#define UC_PRIV_REG(t, c, a, r)          \
+	(UC_PRIV_BASE(t) | ((c) << 18) | (a ## _AID << 13) | (a ## _ ## r << 8))
+
+/**
+ * @define private accelerators register word address
+ * @param t uc type name INGRESS/EGRESS
+ * @param c uc cpu id
+ * @param a accelerator name AID
+ * @param r register name RID
+ * @param w word index
+ */
+#define UC_PRIV_REG_IDX(t, c, a, r, w)   \
+	(UC_PRIV_REG(t, c, a, r) | ((w) << 2))
+
+/**  BOOT **/
+
+/**
+ * SW_REG_NAME : UC_BOOT_RST_VEC_REG
+ * HW_REG_NAME : reg_boot_reset_vector
+ * DESCRIPTION : uC vector table
+ */
+#define UC_BOOT_RST_VEC_WORDS            64
+#define UC_BOOT_RST_VEC_MSK              GENMASK(31, 0)
+#define UC_BOOT_RST_VEC_REG(t, c, x)     UC_PRIV_REG_IDX(t, c, BOOT, RST_VEC, x)
+
+/**
+ * SW_REG_NAME : UC_BOOT_CORE_RUN_REG
+ * HW_REG_NAME : reg_boot_core_run_halt
+ * DESCRIPTION : 0 upon reset
+ */
+#define UC_BOOT_CORE_RUN_MSK             GENMASK(1, 0)
+#define UC_BOOT_CORE_RUN_REG(t, c)       UC_PRIV_REG(t, c, BOOT, CORE_RUNHALT)
+
+/**
+ * SW_REG_NAME : UC_BOOT_RUN_ACK_REG
+ * HW_REG_NAME : reg_boot_run_halt_ack
+ * DESCRIPTION : Run Ack
+ */
+#define UC_BOOT_RUN_ACK_MSK              GENMASK(1, 0)
+#define UC_BOOT_RUN_ACK_REG(t, c)        UC_PRIV_REG(t, c, BOOT, RUNHALT_ACK)
+
+/**
+ * SW_REG_NAME : UC_BOOT_GPREG_REG
+ * HW_REG_NAME : reg_boot_gp_reg
+ * DESCRIPTION : General Purpose Register
+ */
+#define UC_BOOT_GPREG_MSK                GENMASK(31, 0)
+#define UC_BOOT_GPREG_REG(t, c)          UC_PRIV_REG(t, c, BOOT, GPREG)
+
+/* EXTINSJOB, Ingress: */
+#define UC_ING_EXTINSJOB_PD_SIZE(c, q)   \
+	UC_PRIV_REG_IDX(INGRESS, c, EXTINSJOB, PD_SIZE, q)
+
+#define UC_ING_EXTINSJOB_HDR_OFFSET(c, q)\
+	UC_PRIV_REG_IDX(INGRESS, c, EXTINSJOB, HDR_OFFSET, q)
+
+#define UC_ING_EXTINSJOB_JOB_OFFSET(c, q)\
+	UC_PRIV_REG_IDX(INGRESS, c, EXTINSJOB, JOB_OFFSET, q)
+
+/*********************/
+/* Shared registers */
+/*********************/
+
+/* Address of a register at the Cluster level is: <NAME>_UC_BASE|OFFSET,
+ * where NAME is INGRESS or EGRESS, and the OFFSET has the following format:
+ * +------+----------------------+-----+-----+------+------+---+
+ * |Size: |   2                  |  5  |  5  |  2   |   6  | 2 |
+ * +------+----------------------+-----+-----+------+------+---+
+ * |Name: |Peripheral_ID         | AID | RID | uCID | Index| - |
+ * +------+----------------------+-----+-----+------+------+---+
+ * |Value:|PERIPH_ID_SHARED_ACCL | AID | RID |Index2|Index1| 0 |
+ * +------+----------------------+-----+-----+------+------+---+
+ * |Range:|  21:20               |19:15|14:10| 9:8  | 7:2  |1:0|
+ * +------+----------------------+-----+-----+------+------+---+
+ */
+
+/**
+ * @define shared accelerators registers base address
+ * @param t uc type name INGRESS/EGRESS
+ */
+#define UC_SHRD_BASE(t)                  \
+	((t ## _UC_BASE) | (PERIPH_ID_SHARED_ACCL << 20))
+
+/**
+ * @define shared accelerators register address
+ * @param t uc type name INGRESS/EGRESS
+ * @param a accelerator name AID
+ * @param r register name RID
+ */
+#define UC_SHRD_REG(t, a, r)             \
+	(UC_SHRD_BASE(t) | (a ## _AID << 15) | (a ## _ ## r << 10))
+
+/**
+ * @define shared accelerators register word address
+ * @param t uc type name INGRESS/EGRESS
+ * @param a accelerator name AID
+ * @param r register name RID
+ * @param w word index
+ */
+#define UC_SHRD_REG_IDX(t, a, r, w)      (UC_SHRD_REG(t, a, r) | ((w) << 2))
+
+#define UC_SHRD_REG_IDX_IDX(t, e, r, x, y)\
+	(UC_SHRD_REG(t, e, r) | ((x) << 8) | ((y) << 2))
+
+/***** READER REGISTERS *****/
+/* READER_READDONETO */
+#define UC_READER_WDT_VAL_FLD_MSK   GENMASK(15, 0)
+#define UC_READER_WDT_EN_FLD_MSK    BIT(16)
+#define UC_READER_WDT_FRZ_FLD_MSK   BIT(17)
+#define UC_READER_READDONETO(t)     UC_SHRD_REG(t, READER, READDONETO)
+/* READER_IRR */
+#define UC_READER_IRR(t)            UC_SHRD_REG(t, READER, IRR)
+/* READER_IER */
+#define UC_READER_IER(t)            UC_SHRD_REG(t, READER, IER)
+/* READER_OUT_SWAP */
+#define UC_READER_OUT_SWAP(t)       UC_SHRD_REG(t, READER, OUT_SWAP)
+/* READER_WRED_BASE */
+#define UC_READER_WRED_BASE(t)      UC_SHRD_REG(t, READER, WRED_BASE)
+/* READER_TOTAL_PUSHED */
+#define UC_READER_TOTAL_PUSHED(t)   UC_SHRD_REG(t, READER, TOTAL_PUSHED)
+/* READER_READ_REQ_A */
+#define UC_READER_READ_REQ_A(t)     UC_SHRD_REG(t, READER, READ_REQ_A)
+/* READER_RETRY_INTVAL */
+#define UC_READER_RETRY_INTVAL_MSK  GENMASK(23, 0)
+#define UC_READER_RETRY_INTVAL(t)   UC_SHRD_REG(t, READER, RETRY_INTVAL)
+/* READER_QMNGR_BASE */
+#define UC_READER_QMNGR_BASE(t)     UC_SHRD_REG(t, READER, QMNGR_BASE)
+/* READER_BMNGR_BASE */
+#define UC_READER_BMNGR_BASE_MSK    GENMASK(15, 0)
+#define UC_READER_BMNGR_BASE(t)     UC_SHRD_REG(t, READER, BMNGR_BASE)
+/* READER_CLIENT_BASE */
+#define UC_READER_CLIENT_BASE(t)    UC_SHRD_REG(t, READER, CLIENT_BASE)
+/* READER_RETRY_CNT */
+#define UC_READER_RETRY_CNT(t, p)   UC_SHRD_REG_IDX(t, READER, RETRY_CNT, p)
+/* READER_WRED_CLIENT */
+#define UC_READER_WRED_CLIENT_MSK   GENMASK(15, 0)
+#define UC_READER_WRED_CLIENT(t, p) UC_SHRD_REG_IDX(t, READER, WRED_CLIENT, p)
+/* READER_MB_RPLYCNT */
+#define UC_READER_MB_RPLYCNT(t, n)  UC_SHRD_REG_IDX(t, READER, MB_RPLYCNT, n)
+/*READER_MB_ADDR */
+#define UC_READER_MB_ADDR(t, n)     UC_SHRD_REG_IDX(t, READER, MB_ADDR, n)
+/* READER_MB_LEN */
+#define UC_READER_MB_LEN(t, n)      UC_SHRD_REG_IDX(t, READER, MB_LEN, n)
+/* READER_MB_FLAGS */
+#define UC_READER_MB_FLAGS(t, n)    UC_SHRD_REG_IDX(t, READER, MB_FLAGS, n)
+/* READER_MB_CNT */
+#define UC_READER_MB_CNT(t, n)      UC_SHRD_REG_IDX(t, READER, MB_CNT, n)
+/* READER_MB_JOBIDX */
+#define UC_READER_MB_JOBIDX(t, n)   UC_SHRD_REG_IDX(t, READER, MB_JOBIDX, n)
+/* READER_MB_IRR */
+#define UC_READER_MB_IRR(t)         UC_SHRD_REG(t, READER, MB_IRR)
+/* READER_MB_IER */
+#define UC_READER_MB_IER(t)         UC_SHRD_REG(t, READER, MB_IER)
+/* READER_MB_ICR */
+#define UC_READER_MB_ICR(t)         UC_SHRD_REG(t, READER, MB_ICR)
+/* READER_MB_BUSY */
+#define UC_READER_MB_BUSY(t, n)     UC_SHRD_REG_IDX(t, READER, MB_BUSY, n)
+/* READER_DBG_MUX */
+#define UC_READER_DBG_MUX(t)        UC_SHRD_REG(t, READER, DBG_MUX)
+
+/***** WRITER REGISTERS *****/
+/* WRITER_UCENABLE */
+#define UC_WRITER_UCENABLE(t, c)    UC_SHRD_REG_IDX(t, WRITER, UCENABLE, c)
+/* WRITER_TOTAL_INJECTS - Count the total Injects in a queue */
+#define UC_WRITER_TOTAL_INJECTS(t, q)\
+	UC_SHRD_REG_IDX(t, WRITER, TOTAL_INJECTS, q)
+/* WRITER_TOTAL_DESC - Count the total descriptors in a prot */
+#define UC_WRITER_TOTAL_DESC(t, p)   \
+	UC_SHRD_REG_IDX(t, WRITER, TOTAL_DESC, p)
+/***** WRITER INGRESS REGISTERS *****/
+/* WRITER_CREDIT */
+#define UC_ING_WRITER_CREDIT(c, q)  \
+	UC_SHRD_REG_IDX_IDX(INGRESS, WRITER, CREDIT, c, q)
+/* WRITER_PRE_L2 */
+#define UC_ING_WRITER_PRE_L2(q)     UC_SHRD_REG_IDX(INGRESS, WRITER, PRE_L2, q)
+/* WRITER_JOBIDX */
+#define UC_ING_WRITER_JOBIDX(c, q)  \
+	UC_SHRD_REG_IDX_IDX(INGRESS, WRITER, JOBIDX, c, q)
+/* WRITER_TOTAL_JOBS */
+/* WRITER_IN_SWAP */
+/* WRITER_HDR_SIZE */
+/* WRITER_RST_JOBIDX */
+/***** WRITER EGRESS REGISTERS *****/
+/* WRITER_TX_PORT */
+#define UC_EGR_WRITER_TX_PORT(p)    UC_SHRD_REG_IDX(EGRESS, WRITER, TX_PORT, p)
+/* WRITER_PORT_ENABLE */
+#define UC_EGR_WRITER_PORT_ENABLE(p) \
+	UC_SHRD_REG_IDX(EGRESS, WRITER, PORT_ENABLE, p)
+/* WRITER_PORT */
+#define UC_EGR_WRITER_PORT_ADDR(p)  \
+	(UC_SHRD_REG(EGRESS, WRITER, PORT) | ((p) << 4))
+/* WRITER_INJECT */
+/* WRITER_EXTPORT */
+/* WRITER_MAP */
+#define UC_EGR_WRITER_MAP(c, p)                   \
+	(UC_SHRD_REG(EGRESS, WRITER, MAP) |       \
+	((c) << (UC_EGR_LN_MAXPORT + 2))  | ((p) << 2))
+/* WRITER_QU_CREDIT */
+#define UC_EGR_WRITER_QU_CREDIT(c, p)             \
+	(UC_SHRD_REG(EGRESS, WRITER, QU_CREDIT) | \
+	((c) << (UC_EGR_LN_MAXPORT + 2))  | ((p) << 2))
+/* WRITER_TOTAL_CREDIT */
+#define UC_EGR_WRITER_TOTAL_CREDIT(p)    \
+	UC_SHRD_REG_IDX(EGRESS, WRITER, TOTAL_CREDIT, p)
+/* WRITER_PORT_CREDIT */
+#define UC_EGR_WRITER_PORT_CREDIT(p)     \
+	UC_SHRD_REG_IDX(EGRESS, WRITER, PORT_CREDIT, p)
+/* WRITER_INJECT_COUNT */
+/* WRITER_EGR_JOBIDX */
+/* WRITER_EGR_RST_JOBIDX */
+/* WRITER_PORT_DEPTH */
+#define UC_EGR_WRITER_PORT_DEPTH(p)      \
+	UC_SHRD_REG_IDX(EGRESS, WRITER, PORT_DEPTH, p)
+/* WRITER_PORT_TYPE */
+/***** WRITER MB EGRESS REGISTERS *****/
+/* WRITER_MB_MAP2UC */
+#define UC_EGR_MBOX_MAP2UC(n)            \
+	UC_SHRD_REG_IDX(EGRESS, WRITER, MB_MAP2UC, n)
+/* WRITER_MB_MAP2QU */
+#define UC_EGR_MBOX_MAP2QU(n)            \
+	UC_SHRD_REG_IDX(EGRESS, WRITER, MB_MAP2QU, n)
+/* WRITER_MB_MESSAGE */
+#define UC_EGR_MBOX_MSG0_WR_ADDRESS      \
+	UC_SHRD_REG_IDX(EGRESS, WRITER, MB_MESSAGE, 0)
+#define UC_EGR_MBOX_MSG0_WR_LENGTH       \
+	UC_SHRD_REG_IDX(EGRESS, WRITER, MB_MESSAGE, 1)
+#define UC_EGR_MBOX_MSG0_WR_DATA0        \
+	UC_SHRD_REG_IDX(EGRESS, WRITER, MB_MESSAGE, 2)
+#define UC_EGR_MBOX_MSG0_WR_DATA1        \
+	UC_SHRD_REG_IDX(EGRESS, WRITER, MB_MESSAGE, 3)
+#define UC_EGR_MBOX_MSG0_WR_FLAGS        \
+	UC_SHRD_REG_IDX(EGRESS, WRITER, MB_FLAGS,   0)
+#define UC_EGR_MBOX_MSG0_WR_CHANNEL      \
+	UC_SHRD_REG_IDX(EGRESS, WRITER, MB_CHANNEL, 0)
+#define UC_EGR_MBOX_MSG0_WR_STATUS       \
+	UC_SHRD_REG_IDX(EGRESS, WRITER, MB_STATUS,  0)
+
+#define UC_EGR_MBOX_MSG1_WR_ADDRESS      \
+	UC_SHRD_REG_IDX(EGRESS, WRITER, MB_MESSAGE, 4)
+#define UC_EGR_MBOX_MSG1_WR_LENGTH       \
+	UC_SHRD_REG_IDX(EGRESS, WRITER, MB_MESSAGE, 5)
+#define UC_EGR_MBOX_MSG1_WR_DATA0        \
+	UC_SHRD_REG_IDX(EGRESS, WRITER, MB_MESSAGE, 6)
+#define UC_EGR_MBOX_MSG1_WR_DATA1        \
+	UC_SHRD_REG_IDX(EGRESS, WRITER, MB_MESSAGE, 7)
+#define UC_EGR_MBOX_MSG1_WR_FLAGS        \
+	UC_SHRD_REG_IDX(EGRESS, WRITER, MB_FLAGS,   1)
+#define UC_EGR_MBOX_MSG1_WR_CHANNEL      \
+	UC_SHRD_REG_IDX(EGRESS, WRITER, MB_CHANNEL, 1)
+#define UC_EGR_MBOX_MSG1_WR_STATUS       \
+	UC_SHRD_REG_IDX(EGRESS, WRITER, MB_STATUS,  1)
+/* WRITER_MB_FLAGS */
+/* WRITER_MB_CHANNEL */
+/* WRITER_MB_STATUS */
+/* WRITER_MB_CREDIT */
+#define UC_EGR_MBOX_WR_CREDIT(n)         \
+	UC_SHRD_REG_IDX(EGRESS, WRITER, MB_CREDIT, n)
+/* WRITER_MB_CHANNEL_EN */
+#define UC_EGR_MBOX_CHANNEL_EN(n)        \
+	UC_SHRD_REG_IDX(EGRESS, WRITER, MB_CHANNEL_EN, n)
+
+// CCU Common:
+#define UC_CCU_ISR_REG(t)                UC_SHRD_REG(t, CCU, ISR)
+#define UC_CCU_IER_REG(t)                UC_SHRD_REG(t, CCU, IER)
+#define UC_CCU_IRR_REG(t)                UC_SHRD_REG(t, CCU, IRR)
+
+#define UC_CCU_MAXCPU_MSK                GENMASK(7, 0)
+#define UC_CCU_MAXCPU_REG(t)             UC_SHRD_REG(t, CCU, MAXCPU)
+
+#define UC_CCU_GPREG_MAX                (8)
+#define UC_CCU_GPREG_MSK                GENMASK(31, 0)
+#define UC_CCU_GPREG_REG(t, c)          UC_SHRD_REG_IDX(t, CCU, GPREG, c)
+
+#define UC_CCU_UC_UNRESET_REG(t, c)      UC_SHRD_REG_IDX(t, CCU, UC_UNRESET, c)
+#define UC_CCU_UC_CLK_EN_REG(t, c)       UC_SHRD_REG_IDX(t, CCU, UC_CLK_EN, c)
+
+/**
+ * CLUSTER BRIDGE FAT
+ */
+#define UC_CLUSTERBRIDGE_FAT_MAX_ENT     (16)
+#define UC_CLUSTERBRIDGE_FAT_MSK         GENMASK(8, 0)
+#define UC_CLUSTERBRIDGE_FAT(t, x)       \
+	UC_SHRD_REG_IDX(t, CLUSTERBRIDGE, FAT, x)
+
+// DMAE registers:
+#define UC_DMAE_DDR_LINE_SIZE(t)         UC_SHRD_REG(t, DMAE, DDR_LINE_SIZE)
+#define UC_DMAE_BURST_LENGTH(t)          UC_SHRD_REG(t, DMAE, BURST_LENGTH)
+#define UC_DMAE_DELAY_B4_READY(t)        UC_SHRD_REG(t, DMAE, DELAY_B4_READY)
+
+// SYNCOBJ registers:
+#define UC_EGR_SYNCOBJ_TYPE(t)           \
+	UC_SHRD_REG_IDX(EGRESS, SYNCOBJ, TYPE, t)
+
+// HWEVENTA Common:
+#define UC_HWEVENTA_IER(t)               UC_SHRD_REG(t, HWEVENTA, IER)
+#define UC_HWEVENTA_IRR(t)               UC_SHRD_REG(t, HWEVENTA, IRR)
+#define UC_HWEVENTA_EVENTF(t, e)         \
+	UC_SHRD_REG_IDX(t, HWEVENTA, EVENT_F, e)
+
+// Timers Control direct interface registers (TDOX ):
+#define UC_EGR_TIMERS_CTRL_STATUS        \
+	UC_SHRD_REG(EGRESS, TIMERS_CTRL, STATUS)
+#define UC_EGR_TIMERS_CTRL_MASK          \
+	UC_SHRD_REG(EGRESS, TIMERS_CTRL, MASK)
+#define UC_EGR_TIMERS_CTRL_COMMAND       \
+	UC_SHRD_REG(EGRESS, TIMERS_CTRL, COMMAND)
+
+#endif /* __PP_UC_REGS_H__ */
diff --git a/drivers/net/ppv4/pp-hal/micro-controller/uc_shared_engines.h b/drivers/net/ppv4/pp-hal/micro-controller/uc_shared_engines.h
new file mode 100644
index 000000000000..3e58f4cbe08c
--- /dev/null
+++ b/drivers/net/ppv4/pp-hal/micro-controller/uc_shared_engines.h
@@ -0,0 +1,385 @@
+/*
+ * uc_shared_engines.h
+ * Description: PP micro-comtrollers shared accelerators definitions
+ *
+ * SPDX-License-Identifier: GPL-2.0-only
+ * Copyright (C) 2019 Intel Corporation
+ */
+
+#ifndef __PP_UC_SHARED_ENGINES_H__
+#define __PP_UC_SHARED_ENGINES_H__
+
+/* this file defines the <AID,RID> of the HW entities in the
+ * uC Cluster  (aka Shared engines)
+ *  +-------------------------------------------------------+
+ *  | Important: the <AID,RID> must be aligned with the RDL |
+ *  +-------------------------------------------------------+
+ * Comments:
+ *(1): internal, for debug usage
+ *(2): host to program/use
+ */
+
+/* Shared Engines AID: */
+/**
+ * @define Writer
+ */
+#define WRITER_AID              1
+/**
+ * @define Reader
+ */
+#define READER_AID              2
+/**
+ * @define Cluster control unit
+ */
+#define CCU_AID                 3
+/**
+ * @define DMA engine
+ */
+#define DMAE_AID                4
+/**
+ * @define Sync objects
+ */
+#define SYNCOBJ_AID             5
+/**
+ * @define HW events
+ */
+#define HWEVENTA_AID            6
+/**
+ * @define Cluster Bridge
+ */
+#define CLUSTERBRIDGE_AID       7
+/**
+ * @define Times Module (TDOX) direct interface
+ */
+#define TIMERS_CTRL_AID         8
+/**
+ * @define second HW event engine, (DMAC_uC)
+ */
+#define HWEVENTA2_AID           9
+/**
+ * @define timer from MAC (DMAC_uC)
+ */
+#define TMR_1024_AID            10
+/**
+ * @define 4 64-bit timers, named also CNT64, using 100MHz clock
+ */
+#define LONG_TMR_AID            28
+/**
+ * @define TDOX Timers (Puma7 reuse) slave
+ */
+#define TDOX_TMR_AID            29
+
+/* Writer common: */
+/**
+ * @define (2) enable write to uC
+ */
+#define WRITER_UCENABLE         0
+
+/* Writer Ingress: */
+/**
+ * @define (2) credit per uC, per queue
+ */
+#define WRITER_CREDIT           1
+/**
+ * @define (2) flag, indicates that writer should read PreL2 header from RPB
+ */
+#define WRITER_PRE_L2           2
+/**
+ * @define (1) write pointer
+ */
+#define WRITER_JOBIDX           3
+#define WRITER_TOTAL_JOBS       4
+#define WRITER_IN_SWAP          5
+#define WRITER_HDR_SIZE         6
+/**
+ * @define reset JobIdx to 0 at init
+ */
+#define WRITER_RST_JOBIDX       7
+
+/* Writer_QoS Egress: */
+#define WRITER_TX_PORT          8
+#define WRITER_PORT_ENABLE      9
+#define WRITER_PORT             10
+#define WRITER_INJECT           11
+#define WRITER_EXTPORT          12
+#define WRITER_MAP              13
+#define WRITER_QU_CREDIT        14
+#define WRITER_TOTAL_CREDIT     15
+#define WRITER_PORT_CREDIT      16
+#define WRITER_INJECT_COUNT     17
+#define WRITER_EGR_JOBIDX       18
+#define WRITER_EGR_RST_JOBIDX   19
+#define WRITER_PORT_DEPTH       20
+#define WRITER_TOTAL_INJECTS    21
+/**
+ * @define counts descriptors per port in Egress
+ */
+#define WRITER_TOTAL_DESC       22
+/**
+ * @define used in case of MAC-CPU
+ */
+#define WRITER_PORT_TYPE        23
+
+/* Writer_MBOX Egress: */
+/**
+ * @define map channel to uC
+ */
+#define WRITER_MB_MAP2UC        24
+/**
+ * @define map channel to qu
+ */
+#define WRITER_MB_MAP2QU        25
+/**
+ * @define Address, Length and Data
+ */
+#define WRITER_MB_MESSAGE       26
+#define WRITER_MB_FLAGS         27
+#define WRITER_MB_CHANNEL       28
+/**
+ * @define Busy and ErrCount
+ */
+#define WRITER_MB_STATUS        29
+#define WRITER_MB_CREDIT        30
+#define WRITER_MB_CHANNEL_EN    31
+/* each bit in WRITER_MB_FLAGS is a flag: */
+#define WR_FLAG_INTERRUPT       0
+#define WR_FLAG_IS_DATA         1
+
+/* Reader: */
+#define READER_READDONETO       0
+#define READER_IRR              1
+#define READER_IER              2
+#define READER_OUT_SWAP         3
+#define READER_WRED_BASE        4
+#define READER_RSRVD1           5
+#define READER_TOTAL_PUSHED     6
+#define READER_READ_REQ_A       7
+#define READER_RETRY_INTVAL     8 /* Egress only */
+#define READER_QMNGR_BASE       9
+#define READER_BMNGR_BASE       10
+#define READER_CLIENT_BASE      11
+#define READER_RETRY_CNT        12
+#define READER_WRED_CLIENT      13
+#define READER_MB_RPLYCNT       14
+#define READER_MB_ADDR          15
+#define READER_MB_LEN           16
+#define READER_MB_FLAGS         17
+#define READER_MB_CNT           18
+#define READER_MB_JOBIDX        19
+#define READER_MB_IRR           24
+#define READER_MB_IER           25
+#define READER_MB_ICR           26
+#define READER_MB_BUSY          27
+#define READER_DBG_MUX          28
+/* Bit #0:  Ignore Egress WRED handshake (wait 2 clock cycles instead). */
+
+/* CCU: */
+/**
+ * @define interrupt status register, bit per source
+ */
+#define CCU_ISR         0
+/**
+ * @define uC_error Interrupt Enable, bit per uC
+ */
+#define CCU_IER         1
+/**
+ * @define uC_error Interrupt Request, bit per uC
+ */
+#define CCU_IRR         2
+/**
+ * @define deassert reset of a uC, array, index per uC
+ */
+#define CCU_UC_UNRESET  3
+/**
+ * @define clk_en a uC, array, index per uC
+ */
+#define CCU_UC_CLK_EN   4
+/**
+ * @define array of 8 GP registers. can be used at init
+ */
+#define CCU_GPREG       5
+/**
+ * @define number of uC's in the cluster
+ */
+#define CCU_MAXCPU      6
+/**
+ * @define reflects BAR[35:27] in TGM.
+ */
+#define CCU_MY_BAR      7
+
+/* each bit in ISR indicates interrupt source: */
+#define INT_SRC_UCERROR     0
+#define INT_SRC_HWEVENTA    1
+#define INT_SRC_MBOX        2
+#define INT_SRC_READER      3
+#define INT_SRC_BRIDGE      4
+
+/* DMAE: */
+/**
+ * @define DMAE activation
+ */
+#define DMAE_START              0
+/**
+ * @define array[4*3] (3 registers per channel).
+ * hold transaction request parameters, per channel.
+ * use uCID field for channel and index for 0,1,2
+ */
+#define DMAE_COMMAND            1
+/* DMAE config */
+#define DMAE_DDR_LINE_SIZE      2
+#define DMAE_BURST_LENGTH       3
+#define DMAE_DELAY_B4_READY     4
+/* DMAE internal */
+/**
+ * @define array[4], if allocated,
+ * it indicates the uC that is associated with the channel
+ */
+#define DMAE_CH_2UC             5
+/**
+ * @define array[4], indicates channel is allocated
+ */
+#define DMAE_CH_ALLOCATED       6
+/**
+ * @define array[MAXCPU*2], counts pending copy requests, per uC,
+ * per priority. uC in uCID field, priority in index.
+ */
+#define DMAE_PRIOR_COUNT        7
+/**
+ * @define array[2]. counts pending copy requests, per priority
+ */
+#define DMAE_TOTAL_COUNT        8
+#define DMAE_TOTAL_REQ_TRANS    9
+
+/* SYNCOBJ: */
+/**
+ * @define (2) defines the type of each object, Mutex/Rendezvous
+ */
+#define SYNCOBJ_TYPE            0
+#define SYNCOBJ_POST_START      1
+#define SYNCOBJ_ACCEPT_START    2
+#define SYNCOBJ_SYNC_DONE       3
+#define SYNCOBJ_GO_DONE         4
+#define SYNCOBJ_DEST            5
+#define SYNCOBJ_VALID           6
+#define SYNCOBJ_POSTER          7
+#define SYNCOBJ_ACCEPTOR        8
+#define SYNCOBJ_COUNT           9
+
+/* HWEVNTA: */
+/**
+ * @define trigger wait-event
+ */
+#define HWEVENTA_START          0
+#define HWEVENTA_EVENTF         1
+/**
+ * @define used to set bit(s) in IRR
+ */
+#define HWEVENTA_DONE           2
+/**
+ * @define (2) intr enable
+ */
+#define HWEVENTA_IER            3
+/**
+ * @define (2) intr request
+ */
+#define HWEVENTA_IRR            4
+#define HWEVENTA_REQUEST        5
+#define HWEVENTA_TASKF          6
+
+/* CLUSTERBRIDGE: */
+/**
+ * @define 1/0 indicates Egress/Ingress
+ */
+#define CLUSTERBRIDGE_IS_EGRESS 0
+/**
+ * @define filter and address translation table[16]
+ */
+#define CLUSTERBRIDGE_FAT       1
+/**
+ * @define enable the access violation interrupt
+ */
+#define CLUSTERBRIDGE_IER       2
+/**
+ * @define interrupt request
+ */
+#define CLUSTERBRIDGE_IRR       3
+/**
+ * @define destination address
+ */
+#define CLUSTERBRIDGE_DEST      4
+/**
+ * @define latched data, 4*32 bits
+ */
+#define CLUSTERBRIDGE_DATA      5
+
+/* TIMERS_CTRL (TDOX direct interface): */
+/**
+ * @define 16 bits of the groups_status[15:0]
+ */
+#define TIMERS_CTRL_STATUS      0
+/**
+ * @define 16 bits
+ */
+#define TIMERS_CTRL_MASK        1
+/**
+ * @define 2 bits
+ */
+#define TIMERS_CTRL_COMMAND     2
+/**
+ * @define 1 bit
+ */
+#define TIMERS_CTRL_ENDIANITY   3
+
+/* long timer (cnt64) */
+/**
+ * @define control register, includes: inc, mode, reset, go
+ */
+#define CNT_CTRL        0
+/**
+ * @define counter value LSB
+ */
+#define CNT_VALUE0      1
+/**
+ * @define counter value MSB
+ */
+#define CNT_VALUE1      2
+/**
+ * @define threshold LSB
+ */
+#define CNT_PERIOD0     3
+/**
+ * @define threshold MSB
+ */
+#define CNT_PERIOD1     4
+/**
+ * @define not used
+ */
+#define CNT_INT_STAT    5
+/**
+ * @define not used
+ */
+#define CNT_INT_CLR     6
+
+/* TMR_1024 */
+/**
+ * @define select timer source, MAC or 1588/PHY
+ */
+#define TMR_1024_SOURCE     0
+/**
+ * @define timer value
+ */
+#define TMR_1024_VALUE      1
+/**
+ * @define 4 thresholds
+ */
+#define TMR_1024_COMPARE    2
+/**
+ * @define 4 valid bits
+ */
+#define TMR_1024_VALID      3
+/**
+ * @define 4 clear registers
+ */
+#define TMR_1024_CLEAR      4
+
+#endif /* __PP_UC_SHARED_ENGINES_H__ */
diff --git a/drivers/net/ppv4/pp-hal/modifier/modifier.h b/drivers/net/ppv4/pp-hal/modifier/modifier.h
new file mode 100644
index 000000000000..ad9f4d6d98c2
--- /dev/null
+++ b/drivers/net/ppv4/pp-hal/modifier/modifier.h
@@ -0,0 +1,220 @@
+/*
+ * Description: Packet Processor Modifier Definitions
+ *
+ * SPDX-License-Identifier: GPL-2.0-only
+ * Copyright (C) 2018-2019 Intel Corporation
+ */
+
+#ifndef __MODIFIER_H__
+#define __MODIFIER_H__
+
+#include <linux/types.h>
+#include <linux/bitops.h>
+#include <linux/init.h>
+#include <linux/debugfs.h>
+
+#include "pp_common.h"
+
+/**
+ * @struct Modifier module init parameters
+ * @valid params valid
+ * @mod_base modifier base address
+ * @mod_ram_base modifier ram base address
+ * @dbgfs debugfs parent directory
+ */
+struct pp_mod_init_param {
+	bool valid;
+	u64  mod_base;
+	u64  mod_ram_base;
+	struct dentry *dbgfs;
+};
+
+#ifdef CONFIG_PHY_INTEL_COMBO_LGM
+/**
+ * @enum modifier recipe type
+ * @MOD_RCP_CUSTOM custom recipe
+ */
+enum mod_rcp_type {
+	/*! Recipe for no-modifications sessions, mainly for counting
+	 *  no-modification sessions on a different counter than exception
+	 *  sessions
+	 */
+	MOD_RCP_NO_MOD,
+	/*! Recipe for header replacement ONLY, use mainly when L3 is unknown */
+	MOD_RCP_HDR_RPLC,
+	/*! Recipe for nat changes in ipv4 w/o tunnels */
+	MOD_RCP_IPV4_NAT,
+	/*! Recipe for nat changes in ipv4 and tcp/udp w/o tunnels */
+	MOD_RCP_IPV4_NAPT,
+	/*! Recipe for ipv6 routed w/o tunnels */
+	MOD_RCP_IPV6_ROUTED,
+	/*! Recipe for encapsulating tunnel for ipv4(inner) over ipv4(outer)
+	 *  with nat changes in the inner ipv4 header
+	 */
+	MOD_RCP_IPV4_IPV4_ENCAP,
+	/*! Recipe for encapsulating tunnel for ipv4(inner) over ipv6(outer)
+	 *  with nat changes in the inner ipv4 header
+	 */
+	MOD_RCP_IPV6_IPV4_ENCAP,
+	/*! Recipe for encapsulating tunnel for ipv6(inner) over ipv6(outer)
+	 *  with routed inner ipv6 header
+	 */
+	MOD_RCP_IPV6_IPV6_ENCAP,
+	/*! Recipe for encapsulating tunnel for ipv6(inner) over ipv4(outer)
+	 *	with nat changes in the inner ipv6 header
+	 */
+	MOD_RCP_IPV4_IPV6_ENCAP,
+	/*! Recipe for decapsulating EoGRE tunnel over ipv4/ipv6 with inner
+	 *  [ipv4][tcp/udp] packet
+	 */
+	MOD_RCP_EOGRE_DECP_IPV4_NAPT,
+	/*! Recipe for decapsulating IPoGRE tunnel over ipv4/ipv6 with inner
+	 *  [ipv4][tcp/udp] packet
+	 */
+	MOD_RCP_IPOGRE_DECP_IPV4_NAPT,
+	/*! Recipe for decapsulating EoGRE tunnel over ipv4/ipv6 with inner
+	 *  [ipv6][tcp/udp] packet
+	 */
+	MOD_RCP_EOGRE_DECP_IPV6_ROUTED,
+	/*! Recipe for decapsulating IPoGRE tunnel over ipv4/ipv6 with inner
+	 *  [ipv6][tcp/udp] packet
+	 */
+	MOD_RCP_IPOGRE_DECP_IPV6_ROUTED,
+	/*! Recipe for decapsulating DsLite tunnel with tcp/udp */
+	MOD_RCP_DSLITE_DECP_NAPT,
+	/*! Recipe for decapsulating 6RD tunnel over ipv4/ipv6 with inner
+	 *  [ipv6][tcp/udp] packet
+	 */
+	MOD_RCP_6RD_DECP_ROUTED,
+	/*! Recipe for encapsulating ESP tunnel mode over ipv4(outer)
+	 *	without nat changes in the inner headers
+	 */
+	MOD_RCP_ESP_V4_TUNNL_ENCAP,
+	/*! Recipe for encapsulating ESP tunnel mode over ipv6(outer)
+	 *	without nat changes in the inner headers
+	 */
+	MOD_RCP_ESP_V6_TUNNL_ENCAP,
+	/*! Custom recipe for debug, KEEP THIS AS THE LAST RECIPE */
+	MOD_RCP_CUSTOM,
+	MOD_RCP_LAST    = MOD_RCP_CUSTOM,
+	MOD_RCPS_NUM,
+	MOD_RCP_NOP     = 0x7F,
+	MOD_RCP_IDX_MAX = 0x80,
+	MOD_NO_RCP      = 0xFF,
+};
+
+/**
+ * modification bitmap, keep aligned with mod_flag_str
+ */
+enum mod_flags {
+	/*! header replacement, due to mac addresses changes,
+	 *  VLAN or/and PPPoE was added/removed to/from the outer header
+	 */
+	MOD_HDR_RPLC_BIT,
+	/*! pppoe was added/removed to/from the inner packet */
+	MOD_INNER_PPPOE_BIT,
+	/*! IPV4 NAT tos/IP was modified and TTL was decremented */
+	MOD_IPV4_NAT_BIT,
+	/*! IPV6 hop limit was decremented */
+	MOD_IPV6_HOPL_BIT,
+	/*! L4 UDP/TCP was modified */
+	MOD_L4_NAPT_BIT,
+	/*! ICPM_V4 ID modified */
+	MOD_ICMP4_ID_BIT,
+	/*! EoGRE tunnel was removed */
+	MOD_EOGRE_DECP_BIT,
+	/*! EoGRE over IPv4 tunnel was added */
+	MOD_EOGRE_V4_ENCP_BIT,
+	/*! EoGRE over IPv6 tunnel was added */
+	MOD_EOGRE_V6_ENCP_BIT,
+	/*! IPoGRE tunnel was removed */
+	MOD_IPOGRE_DECP_BIT,
+	/*! IPoGRE over IPv4 tunnel was added */
+	MOD_IPOGRE_V4_ENCP_BIT,
+	/*! IPoGRE over IPv6 tunnel was added */
+	MOD_IPOGRE_V6_ENCP_BIT,
+	/*! DsLite tunnel was removed */
+	MOD_DSLITE_DECP_BIT,
+	/*! DsLite tunnel was added */
+	MOD_DSLITE_ENCP_BIT,
+	/*! 6RD tunnel was added */
+	MOD_6RD_ENCP_BIT,
+	/*! 6RD tunnel was removed */
+	MOD_6RD_DECP_BIT,
+	/*! ESP V4 tunnel was added */
+	MOD_ESP_V4_TUNNL_ENCP_BIT,
+	/*! ESP V6 tunnel was added */
+	MOD_ESP_V6_TUNNL_ENCP_BIT,
+
+	MOD_FLAG_LAST = MOD_ESP_V6_TUNNL_ENCP_BIT,
+	MOD_FLAG_NUM
+};
+
+struct mod_stats {
+	u32 pkts_rcvd_from_chk;
+	u32 pkts_rcvd_from_uc;
+	u32 pkts_modified;
+};
+
+/**
+ * @brief select the recipe type by the modification bitmap
+ * @param mod_bmap modification bitmap
+ * @param rcp modifier recipe type
+ * @return s32 0 on success, error code otherwise
+ */
+s32 mod_recipe_select(unsigned long mod_bmap, u8 *rcp);
+
+/**
+ * @brief Get the packet statistics
+ * @param stats
+ * @return s32 0 on success, error code otherwise
+ */
+s32 mod_stats_get(struct mod_stats *stats);
+
+/**
+ * @brief Reset modifier statistics
+ */
+void mod_stats_reset(void);
+
+/**
+ * @brief Get modifier recipe description
+ * @param rcp_idx recipe index
+ * @return const char*const recipe description string, for invalid
+ *         indexes "invalid" string is returned
+ */
+const char * const mod_rcp_to_str(u32 rcp_idx);
+
+/**
+ * @brief Get modifier flag description
+ * @param flag flag index
+ * @return const char*const flag description string, for invalid
+ *         indexes "invalid" string is returned
+ */
+const char * const mod_flag_to_str(u32 flag);
+
+/**
+ * @brief Module init function
+ * @param init_params initial parameters
+ * @return s32 0 on success, error code otherwise
+ */
+s32 mod_init(struct pp_mod_init_param *init_param);
+
+/**
+ * @brief Module exit function, clean all resources
+ * @return void
+ */
+void mod_exit(void);
+#else
+static inline s32 mod_init(struct pp_mod_init_param *init_param)
+{
+	if (init_param->valid)
+		return -EINVAL;
+	else
+		return 0;
+}
+
+static inline void mod_exit(void)
+{
+}
+#endif /* CONFIG_PHY_INTEL_COMBO_LGM */
+#endif /* __MODIFIER_H__ */
diff --git a/drivers/net/ppv4/pp-hal/modifier/modifier_core.c b/drivers/net/ppv4/pp-hal/modifier/modifier_core.c
new file mode 100644
index 000000000000..4f06e55811e8
--- /dev/null
+++ b/drivers/net/ppv4/pp-hal/modifier/modifier_core.c
@@ -0,0 +1,1023 @@
+/*
+ * Description: PP Modifier Core Module
+ *
+ * SPDX-License-Identifier: GPL-2.0-only
+ * Copyright (C) 2018-2019 Intel Corporation
+ */
+
+#define pr_fmt(fmt) "[PP_MODIFIER_CORE]: %s:%d: " fmt, __func__, __LINE__
+
+#include <linux/kernel.h>
+#include <linux/types.h>
+#include <linux/init.h>
+#include <linux/errno.h>
+
+#include "pp_regs.h"
+#include "pp_common.h"
+#include "modifier.h"
+#include "modifier_regs.h"
+#include "modifier_internal.h"
+
+/**
+ * @brief modifier HW base address
+ */
+u64 mod_base_addr;
+u64 mod_ram_base_addr;
+
+/**
+ * @brief module database
+ */
+static struct mod_database *db;
+
+/**
+ * @brief get the execution unit current command address
+ * @param rcp_idx current recipe index
+ * @param type execution unit type
+ * @return u32 command address
+ */
+static s32 __mod_eu_cmd_addr_get(u32 rcp_idx, s32 type, u32 cmd_idx,
+				 unsigned long *addr)
+{
+	if (unlikely(ptr_is_null(addr)))
+		return -EINVAL;
+
+	if (unlikely(!mod_is_rcp_id_valid(rcp_idx)))
+		return -EINVAL;
+
+	if (unlikely(!mod_is_eu_type_valid(type)))
+		return -EINVAL;
+
+	if (unlikely(!mod_is_cmd_idx_valid(cmd_idx, db->eu[type].max_cmds)))
+		return -EINVAL;
+
+	*addr = db->eu[type].base_addr +
+		(rcp_idx * db->eu[type].max_cmds * db->eu[type].cmd_sz) +
+		(cmd_idx * db->eu[type].cmd_sz);
+
+	pr_debug("eu type %d, cmd addr %#lx\n", type, *addr);
+
+	return 0;
+}
+
+s32 mod_eu_cmd_wr(u32 rcp_idx, struct mod_eu_hw *cmd, s32 type, u32 cmd_idx)
+{
+	unsigned long cmd_addr;
+	u32 i;
+
+	if (unlikely(ptr_is_null(cmd)))
+		return -EINVAL;
+
+	if (unlikely(!mod_is_rcp_id_valid(rcp_idx)))
+		return -EINVAL;
+
+	if (unlikely(!mod_is_eu_type_valid(type)))
+		return -EINVAL;
+
+	if (unlikely(!mod_is_cmd_idx_valid(cmd_idx, db->eu[type].max_cmds)))
+		return -EINVAL;
+
+	pr_debug("eu type %d\n", type);
+
+	if (unlikely(__mod_eu_cmd_addr_get(rcp_idx, type, cmd_idx, &cmd_addr)))
+		return -EINVAL;
+
+	MOD_FOR_EACH_EU_CMD_WORD(i, db->eu[type].cmd_sz) {
+		pr_debug("cmd.addr %#lx: cmd.data[%u] = %#x\n",
+			 cmd_addr, i, cmd->word[i]);
+		PP_REG_WR32(cmd_addr, cmd->word[i]);
+		cmd_addr += 4;
+	}
+
+	return 0;
+}
+
+s32 mod_eu_cmd_rd(u32 rcp_idx, struct mod_eu_hw *cmd, s32 type, u32 cmd_idx)
+{
+	unsigned long cmd_addr;
+	u32 i;
+
+	if (unlikely(ptr_is_null(cmd)))
+		return -EINVAL;
+
+	if (unlikely(!mod_is_rcp_id_valid(rcp_idx)))
+		return -EINVAL;
+
+	if (unlikely(!mod_is_eu_type_valid(type)))
+		return -EINVAL;
+
+	if (unlikely(!mod_is_cmd_idx_valid(cmd_idx, db->eu[type].max_cmds)))
+		return -EINVAL;
+
+	pr_debug("eu type %d\n", type);
+
+	memset(cmd, 0, sizeof(*cmd));
+
+	if (unlikely(__mod_eu_cmd_addr_get(rcp_idx, type, cmd_idx, &cmd_addr)))
+		return -EINVAL;
+
+	MOD_FOR_EACH_EU_CMD_WORD(i, db->eu[type].cmd_sz) {
+		cmd->word[i] = PP_REG_RD32(cmd_addr);
+		pr_debug("cmd.addr %#lx: cmd.data[%u] = %#x\n",
+			 cmd_addr, i, cmd->word[i]);
+		cmd_addr += 4;
+	}
+
+	return 0;
+}
+
+s32 mod_eu_cmd_word_set(u32 rcp_idx, u32 cmd_idx, u32 type, u32 word, u32 val)
+{
+	struct mod_eu_hw cmd_buf = { 0 };
+	s32 ret;
+
+	pr_debug("rcp %u, cmd %u, eu %u, word %u, val %u\n",
+		 rcp_idx, cmd_idx, type, word, val);
+	ret = mod_eu_cmd_rd(rcp_idx, &cmd_buf, type, cmd_idx);
+	if (unlikely(ret))
+		return ret;
+
+	if (word >= db->eu[type].cmd_sz) {
+		pr_err("invalid word %u index for eu %u command\n", word, type);
+		return -EINVAL;
+	}
+
+	cmd_buf.word[word] = val;
+
+	ret = mod_eu_cmd_wr(rcp_idx, &cmd_buf, type, cmd_idx);
+	if (unlikely(ret))
+		return ret;
+
+	return 0;
+}
+
+/**
+ * @brief set execution unit command, convert the command to hw
+ *        format
+ * @param rcp current recipe
+ * @param eu execution unit command
+ * @return s32 0 on success, error code otherwise
+ */
+static s32 __mod_rcp_eu_cmd_set(struct mod_recipe *rcp, struct mod_eu_cmd *eu)
+{
+	struct mod_eu_hw cmd;
+
+	if (unlikely(!(!ptr_is_null(rcp) &&
+		       !ptr_is_null(eu))))
+		return -EINVAL;
+
+	memset(&cmd, 0, sizeof(cmd));
+	pr_debug("set mod eu %d command\n", eu->type);
+	pr_debug("stw_mux0 = %hhu\n", eu->stw_mux0);
+	pr_debug("stw_mux1 = %hhu\n", eu->stw_mux1);
+	pr_debug("si_mux0 = %hhu\n",  eu->si_mux0);
+	pr_debug("si_mux1 = %hhu\n",  eu->si_mux1);
+	pr_debug("jm_load0 = %d\n",   eu->jm_load0);
+	pr_debug("jm_store = %d\n",   eu->jm_store);
+	pr_debug("jm_chnk_sz = %d\n", eu->jm_chnk_sz);
+	pr_debug("jm_load1 = %d\n",   eu->jm_load1);
+	pr_debug("jm_op = %d\n",      eu->jm_op);
+	pr_debug("sz_off = %hhu\n",   eu->sz_off);
+	pr_debug("nop = %d\n",        eu->nop);
+	pr_debug("imm = %d\n",        eu->imm);
+	pr_debug("last = %d\n",       eu->last);
+	pr_debug("stall = %d\n",      eu->stall);
+	pr_debug("load0 = %hu\n",     eu->load0);
+	pr_debug("store = %hu\n",     eu->store);
+	pr_debug("load1 = %hu\n",     eu->load1);
+	pr_debug("op0 = %hhu\n",      eu->op0);
+	pr_debug("op1 = %hhu\n",      eu->op1);
+	pr_debug("\n");
+
+	cmd.word[MOD_EU_STW_MUX0_WORD]  |= PP_FIELD_PREP(MOD_EU_STW_MUX0_FLD,
+							eu->stw_mux0);
+	cmd.word[MOD_EU_STW_MUX1_WORD]  |= PP_FIELD_PREP(MOD_EU_STW_MUX1_FLD,
+							eu->stw_mux1);
+	cmd.word[MOD_EU_SI_MUX0_WORD]   |= PP_FIELD_PREP(MOD_EU_SI_MUX0_FLD,
+							eu->si_mux0);
+	cmd.word[MOD_EU_SI_MUX1_WORD]   |= PP_FIELD_PREP(MOD_EU_SI_MUX1_FLD,
+							eu->si_mux1);
+	cmd.word[MOD_EU_JM_OPCODE_WORD] |= PP_FIELD_PREP(MOD_EU_JM_OP_LD0_FLD,
+							eu->jm_load0);
+	cmd.word[MOD_EU_JM_OPCODE_WORD] |= PP_FIELD_PREP(MOD_EU_JM_OP_STR_FLD,
+							eu->jm_store);
+	cmd.word[MOD_EU_JM_OPCODE_WORD] |= PP_FIELD_PREP(MOD_EU_JM_OP_SZ_FLD,
+							eu->jm_chnk_sz);
+	cmd.word[MOD_EU_JM_OPCODE_WORD] |= PP_FIELD_PREP(MOD_EU_JM_OP_LD1_FLD,
+							eu->jm_load1);
+	cmd.word[MOD_EU_JM_OPCODE_WORD] |= PP_FIELD_PREP(MOD_EU_JM_OP_OP0_FLD,
+							eu->jm_op);
+	cmd.word[MOD_EU_SIZE_OFF_WORD]  |= PP_FIELD_PREP(MOD_EU_SIZE_OFF_FLD,
+							eu->sz_off);
+	cmd.word[MOD_EU_NOP_WORD]       |= PP_FIELD_PREP(MOD_EU_NOP_FLD,
+							eu->nop);
+	cmd.word[MOD_EU_IMM_WORD]       |= PP_FIELD_PREP(MOD_EU_IMM_FLD,
+							eu->imm);
+	cmd.word[MOD_EU_LAST_WORD]      |= PP_FIELD_PREP(MOD_EU_LAST_FLD,
+							eu->last);
+	cmd.word[MOD_EU_STALL_WORD]     |= PP_FIELD_PREP(MOD_EU_STALL_FLD,
+							eu->stall);
+	cmd.word[MOD_EU_LOAD0_WORD]     |= PP_FIELD_PREP(MOD_EU_LOAD0_FLD,
+							 eu->load0);
+	cmd.word[MOD_EU_STORE_WORD]     |= PP_FIELD_PREP(MOD_EU_STORE_FLD,
+							eu->store);
+	cmd.word[MOD_EU_LOAD1_WORD]     |= PP_FIELD_PREP(MOD_EU_LOAD1_FLD,
+							eu->load1);
+	cmd.word[MOD_EU_OPCODE0_WORD]   |= PP_FIELD_PREP(MOD_EU_OPCODE0_FLD,
+							eu->op0);
+	cmd.word[MOD_EU_OPCODE1_WORD]   |= PP_FIELD_PREP(MOD_EU_OPCODE1_FLD,
+							eu->op1);
+
+	return mod_eu_cmd_wr(rcp->index, &cmd, eu->type,
+			     rcp->eu_cmd_cnt[eu->type] - 1);
+}
+
+/**
+ * @brief set sce command, convert the command to hw format
+ * @param rcp current recipe
+ * @param sce sce command
+ * @return s32 0 on success, error code otherwise
+ */
+static s32 __mod_rcp_sce_cmd_set(struct mod_recipe *rcp,
+				 struct mod_sce_cmd *sce)
+{
+	struct mod_eu_hw cmd;
+
+	if (unlikely(!(!ptr_is_null(rcp) &&
+		       !ptr_is_null(sce))))
+		return -EINVAL;
+
+	pr_debug("eu type %d\n", EU_SCE);
+	memset(&cmd, 0, sizeof(cmd));
+	cmd.word[0] |= PP_FIELD_PREP(MOD_SCE_ADDR_FLD,    sce->addr);
+	cmd.word[0] |= PP_FIELD_PREP(MOD_SCE_MUX_SEL_FLD, sce->mux_sel);
+	cmd.word[0] |= PP_FIELD_PREP(MOD_SCE_CNT_FLD,     sce->cnt);
+	cmd.word[0] |= PP_FIELD_PREP(MOD_SCE_LAST_FLD,    sce->last);
+
+	return mod_eu_cmd_wr(rcp->index, &cmd, EU_SCE,
+			     rcp->eu_cmd_cnt[EU_SCE] - 1);
+}
+
+/**
+ * @brief allocate execution unit command
+ * @param rcp current recipe
+ * @param type execution unit type
+ * @return s32 0 on success, error code otherwise
+ */
+static s32 __mod_eu_cmd_alloc(struct mod_recipe *rcp, s32 type)
+{
+	if (unlikely(ptr_is_null(rcp)))
+		return -EINVAL;
+
+	if (unlikely(!mod_is_eu_type_valid(type)))
+		return -EINVAL;
+
+	pr_debug("eu type %d\n", type);
+
+	if (rcp->eu_cmd_cnt[type] >= db->eu[type].max_cmds) {
+		pr_err("error: eu type %d command overflow\n", type);
+		return -ENOSPC;
+	}
+	rcp->eu_cmd_cnt[type]++;
+
+	return 0;
+}
+
+/**
+ * @brief modify the last command by setting the 'last' bit
+ * @param rcp current recipe
+ * @param type execution unit type
+ * @return s32 0 on success, error code otherwise
+ */
+static s32 __mod_eu_last_cmd_mod(struct mod_recipe *rcp, s32 type)
+{
+	s32 ret;
+	struct mod_eu_hw cmd;
+
+	if (unlikely(ptr_is_null(rcp)))
+		return -EINVAL;
+
+	if (unlikely(!mod_is_eu_type_valid(type)))
+		return -EINVAL;
+
+	pr_debug("eu type %d\n", type);
+
+	/* read last command */
+	ret = mod_eu_cmd_rd(rcp->index, &cmd, type, rcp->eu_cmd_cnt[type] - 1);
+
+	if (unlikely(ret))
+		goto done;
+
+	/* set 'last' bit */
+	if (type == EU_SCE) {
+		cmd.word[MOD_SCE_CMD_WORD] =
+			PP_FIELD_MOD(MOD_SCE_LAST_FLD, 1,
+				     cmd.word[MOD_SCE_CMD_WORD]);
+	} else {
+		cmd.word[MOD_EU_LAST_WORD] =
+			PP_FIELD_MOD(MOD_EU_LAST_FLD, 1,
+				     cmd.word[MOD_EU_LAST_WORD]);
+	}
+
+	/* write back command */
+	return mod_eu_cmd_wr(rcp->index, &cmd, type, rcp->eu_cmd_cnt[type] - 1);
+
+done:
+	return ret;
+}
+
+/**
+ * @brief adding 'nop' command
+ * @param rcp current recipe
+ * @param type execution unit type
+ * @return s32 0 on success, error code otherwise
+ */
+static s32 __mod_eu_nop_cmd_add(struct mod_recipe *rcp, s32 type)
+{
+	struct mod_eu_cmd  eu;
+	struct mod_sce_cmd sce;
+	s32 ret = 0;
+
+	if (unlikely(ptr_is_null(rcp)))
+		return -EINVAL;
+
+	if (unlikely(!mod_is_eu_type_valid(type)))
+		return -EINVAL;
+
+	pr_debug("eu type %d\n", type);
+
+	ret = __mod_eu_cmd_alloc(rcp, type);
+	if (unlikely(ret))
+		goto done;
+
+	if (type == EU_SCE) {
+		memset(&sce, 0, sizeof(sce));
+		sce.addr = MOD_DPU_ID_MASK & DPU_RCP_REG15_B0_COND;
+		sce.mux_sel = SCE_STW_SEL_ZERO;
+		sce.last = true;
+		ret = __mod_rcp_sce_cmd_set(rcp, &sce);
+	} else {
+		memset(&eu, 0, sizeof(eu));
+		eu.type = type;
+		eu.last = true;
+		eu.nop = true;
+		ret = __mod_rcp_eu_cmd_set(rcp, &eu);
+	}
+
+done:
+	return ret;
+}
+
+s32 mod_bce_ip_nat_cpy(struct mod_recipe *rcp, s32 bce_off, s32 dst_layer)
+{
+	struct mod_eu_cmd eu;
+	s32 ret;
+
+	if (unlikely(ptr_is_null(rcp)))
+		return -EINVAL;
+
+	if (unlikely(!mod_is_layer_valid(dst_layer)))
+		return -EINVAL;
+
+	if (unlikely(!mod_is_bce_off_valid(bce_off)))
+		return -EINVAL;
+
+	memset(&eu, 0, sizeof(eu));
+	eu.type = EU_INSREP;
+
+	ret = __mod_eu_cmd_alloc(rcp, eu.type);
+	if (unlikely(ret))
+		return ret;
+
+	/* SI0 = SI[si_mux0] (nat tamplate size) */
+	eu.si_mux0 = EU_SI_SEL_NAT_SZ;
+	/* SI1 = SI[si_mux1] (0) */
+	eu.si_mux1 = 0;
+	/* STW0 = L2 off (0) */
+	eu.stw_mux0 = EU_STW_SEL_L2_OFF;
+	/* STW1 = SW[stw_mux1] */
+	eu.stw_mux1 = dst_layer;
+
+	/* read from sram at offset bce_off x16 */
+	eu.load0 = MOD_SRAM_OFF | bce_off;
+	/* use load0 val as is */
+	eu.jm_load0 = EU_LOAD0_RAW;
+
+	eu.load1 = 0;
+	/* load1 = load1(0) + SI0 (nat tamplate size) */
+	eu.jm_load1 = EU_LOAD1_SI0;
+
+	/* ips offset in ipv4 header */
+	eu.store = 12;
+	/* store = store + SW1(L3 off) + SI1(0) - SW0(L2 off) */
+	eu.jm_store = EU_STORE_SI1_SW1_NO_SW0;
+
+	eu.sz_off = 0;
+	/* chank_size = size_off(0) + SI0(nat_size) */
+	eu.jm_chnk_sz = EU_CHNK_SZ_SI0;
+	/* Trim size MS Nibble =  0 */
+	eu.jm_op = EU_OP0_RAW;
+
+	return __mod_rcp_eu_cmd_set(rcp, &eu);
+}
+
+s32 mod_reg_to_hdr_cpy(struct mod_recipe *rcp, s32 src, s32 layer, u8 off,
+		       u8 sz)
+{
+	struct mod_eu_cmd eu;
+	s32 ret;
+
+	if (unlikely(ptr_is_null(rcp)))
+		return -EINVAL;
+
+	if (unlikely(!mod_is_dpu_valid(src)))
+		return -EINVAL;
+
+	if (unlikely(!mod_is_layer_valid(layer)))
+		return -EINVAL;
+
+	if (unlikely(!mod_is_op_size_valid(sz)))
+		return -EINVAL;
+
+	memset(&eu, 0, sizeof(eu));
+	eu.type = EU_REPS0;
+
+	ret = __mod_eu_cmd_alloc(rcp, eu.type);
+	if (unlikely(ret))
+		return ret;
+
+	/* source dpu register */
+	eu.load0      = src;
+	/* use load0 value as is */
+	eu.jm_load0   = EU_LOAD0_RAW;
+
+	/* destination offset in straem */
+	if (off == MOD_SI_PKT_OFF) {
+		/* take dest offset from SI */
+		eu.store   = MOD_PKT_OFF;
+		eu.si_mux1 = EU_SI_SEL_LYR_FLD_OFF;
+	} else {
+		/* static dest offset */
+		eu.store   = MOD_PKT_OFF | off;
+		eu.si_mux1 = EU_SI_SEL_ZERO;
+	}
+	/* STW1 = layer offset from STW MUX */
+	eu.stw_mux1 = layer;
+	/* stw0 = L2 from STW MUX */
+	eu.stw_mux0 = EU_STW_SEL_L2_OFF;
+	eu.jm_store = EU_STORE_SI1_SW1_NO_SW0;
+
+	/* size */
+	eu.sz_off     = sz;
+	eu.jm_chnk_sz = EU_CHNK_SZ_RAW;
+
+	/* set to HW */
+	return __mod_rcp_eu_cmd_set(rcp, &eu);
+}
+
+s32 mod_reg_to_new_hdr_cpy(struct mod_recipe *rcp, s32 src, s32 layer, u32 off,
+			   u32 sz)
+{
+	struct mod_eu_cmd eu;
+	s32 ret;
+
+	if (unlikely(ptr_is_null(rcp)))
+		return -EINVAL;
+
+	if (unlikely(!mod_is_dpu_valid(src)))
+		return -EINVAL;
+
+	if (unlikely(!mod_is_ext_layer_valid(layer)))
+		return -EINVAL;
+
+	if (unlikely(!mod_is_op_size_valid(sz)))
+		return -EINVAL;
+
+	memset(&eu, 0, sizeof(eu));
+	eu.type = EU_REPS1;
+
+	ret = __mod_eu_cmd_alloc(rcp, eu.type);
+	if (unlikely(ret))
+		return ret;
+
+	/* source dpu register */
+	eu.load0      = src;
+	/* use load0 value as is */
+	eu.jm_load0   = EU_LOAD0_RAW;
+
+	/* destination offset in stream */
+	eu.store      = MOD_PKT_OFF | off;
+	/* SI1 = layer in new header */
+	eu.si_mux1    = layer;
+	/* stw1 = L2 from STW MUX */
+	eu.stw_mux1   = EU_STW_SEL_L2_OFF;
+	eu.jm_store   = EU_STORE_SI1_SW1;
+
+	/* size */
+	eu.sz_off     = sz;
+	eu.jm_chnk_sz = EU_CHNK_SZ_RAW;
+
+	/* set to HW */
+	return __mod_rcp_eu_cmd_set(rcp, &eu);
+}
+
+/**
+ * @brief Tells if a given ALU operation takes just one operand
+ * @param op_code ALU operand to check
+ * @return bool true if op_code takes only one parameter, false otherwise
+ */
+static inline
+bool __mod_alu_is_single_op(enum mod_cmd_fmt_alu_op op_code)
+{
+	return (EU_ALU_INC == op_code || EU_ALU_DEC == op_code);
+}
+
+/**
+ * @brief Tells if a given ALU operation takes just one operand
+ * @param alu ALU engine, EU_ALU0 or EU_ALU1
+ * @param dst Destination register
+ * @return bool true if the destination is valid for the specified alu
+ */
+static inline
+bool __mod_alu_is_dst_valid(enum mod_eu_type alu, s32 dst)
+{
+	if (alu == EU_ALU1 && dst >= DPU_GLB_REG_FIRST &&
+	    dst <= DPU_GLB_REG_LAST) {
+		pr_err("Error, ALU1 cannot write to global registers\n");
+		return false;
+	}
+	return true;
+}
+
+s32 mod_alu_cmd_cond(enum mod_eu_type alu, struct mod_recipe *rcp, s32 op1,
+		     s32 sz1, s32 op2, s32 sz2, s32 dst,
+		     enum mod_cmd_fmt_alu_op op_code,
+		     enum mod_cmd_fmt_alu_cond_type cond,
+		     enum mod_cmd_fmt_alu_cond_op cond_op)
+{
+	struct mod_eu_cmd eu;
+	s32 ret;
+
+	if (unlikely(ptr_is_null(rcp)))
+		return -EINVAL;
+
+	if (unlikely(!mod_is_dpu_valid(op1)))
+		return -EINVAL;
+
+	if (unlikely(!mod_is_dpu_valid(dst)))
+		return -EINVAL;
+
+	if (unlikely(!mod_is_op_size_valid(sz1)))
+		return -EINVAL;
+
+	if (unlikely(!mod_is_alu_eu_type(alu)))
+		return -EINVAL;
+
+	if (unlikely(!__mod_alu_is_dst_valid(alu, dst)))
+		return -EINVAL;
+
+	if (!__mod_alu_is_single_op(op_code)) {
+		if (!mod_is_dpu_valid(op2) || !mod_is_op_size_valid(sz2))
+			return -EINVAL;
+	}
+
+	ret = __mod_eu_cmd_alloc(rcp, alu);
+	if (unlikely(ret))
+		return ret;
+
+	memset(&eu, 0, sizeof(eu));
+	eu.type     = alu;
+	/* configure reading operand1 from dpu registers */
+	eu.load0    = op1;
+	eu.jm_load0 = EU_LOAD0_RAW; /* use load0 value only */
+	eu.load0_sz = MOD_TO_HW_LOAD_SZ(sz1);
+
+	/* configure reading the operand2 from dpu registers */
+	if (!__mod_alu_is_single_op(op_code)) {
+		eu.load1    = op2;
+		eu.jm_load1 = EU_LOAD1_RAW; /* use load1 value only */
+		eu.load1_sz = MOD_TO_HW_LOAD_SZ(sz2);
+	}
+
+	/* configure saving the result to dpu dest register*/
+	eu.store    = dst;
+	eu.jm_store = EU_STORE_RAW; /* use dest value only */
+
+	/* configure the operation to execute */
+	eu.op0      = op_code;
+	eu.jm_op    = EU_OP0_RAW;
+	/* configure the execution condition */
+	eu.op1      = cond_op << 4 | cond;
+	/* execute immediately */
+	eu.imm      = true;
+
+	/* encode the eu size */
+	eu.sz_off     = eu.load1_sz << 2 | eu.load0_sz;
+	/* size of csum is taken from SIZE field only */
+	eu.jm_chnk_sz = EU_CHNK_SZ_RAW;
+
+	/* set to HW */
+	return __mod_rcp_eu_cmd_set(rcp, &eu);
+}
+
+s32 mod_alu_synch(enum mod_eu_type alu, struct mod_recipe *rcp, s32 layer,
+		  u8 off, u8 sz)
+{
+	struct mod_eu_cmd eu;
+	s32 ret;
+
+	if (unlikely(ptr_is_null(rcp)))
+		return -EINVAL;
+
+	if (unlikely(!mod_is_layer_valid(layer)))
+		return -EINVAL;
+
+	if (unlikely(!mod_is_alu_eu_type(alu)))
+		return -EINVAL;
+
+	ret = __mod_eu_cmd_alloc(rcp, alu);
+	if (unlikely(ret))
+		return ret;
+
+	memset(&eu, 0, sizeof(eu));
+	eu.type = alu;
+	/* we always sync to the last byte of the field, hence, sz - 1 */
+	if (off == MOD_SI_PKT_OFF) {
+		eu.load0   = MOD_PKT_OFF | (sz - 1);
+		eu.si_mux0 = EU_SI_SEL_LYR_FLD_OFF;
+	} else {
+		eu.load0   = MOD_PKT_OFF | (off + sz - 1);
+		eu.si_mux0 = EU_SI_SEL_ZERO;
+	}
+	eu.stw_mux1   = layer;/* SW1 = SW[stw_mux1] */
+	eu.stw_mux0   = EU_STW_SEL_L2_OFF;/* SW0 = SW[stw_mux0] */
+	/* use load0 + SI0 + SW1 - SW0 */
+	eu.jm_load0   = EU_LOAD0_SI0_SW1_NO_SW0;
+	eu.jm_chnk_sz = EU_CHNK_SZ_RAW;
+	eu.nop = true;
+
+	return __mod_rcp_eu_cmd_set(rcp, &eu);
+}
+
+s32 mod_pkt_to_reg_cpy(struct mod_recipe *rcp, s32 dst, s32 layer, u8 off,
+		       u8 sz)
+{
+	struct mod_eu_cmd eu;
+	s32 ret;
+
+	if (unlikely(ptr_is_null(rcp)))
+		return -EINVAL;
+
+	if (unlikely(!mod_is_dpu_valid(dst)))
+		return -EINVAL;
+
+	if (unlikely(!mod_is_layer_valid(layer)))
+		return -EINVAL;
+
+	if (unlikely(!mod_is_op_size_valid(sz)))
+		return -EINVAL;
+
+	memset(&eu, 0, sizeof(eu));
+	eu.type = EU_STORE;
+
+	ret = __mod_eu_cmd_alloc(rcp, eu.type);
+	if (unlikely(ret))
+		return ret;
+
+	if (off == MOD_SI_PKT_OFF) {
+		/* use offset from si */
+		eu.load0   = MOD_PKT_OFF;
+		eu.si_mux0 = EU_SI_SEL_LYR_FLD_OFF;
+	} else {
+		eu.load0   = MOD_PKT_OFF | off;
+		eu.si_mux0 = EU_SI_SEL_ZERO;
+	}
+	eu.stw_mux1 = layer;/* SW1 = SW[stw_mux1] */
+	eu.stw_mux0 = EU_STW_SEL_L2_OFF;/* SW0 = SW[stw_mux0] */
+	/* use load0 + SI0 + SW1 - SW0 */
+	eu.jm_load0 = EU_LOAD0_SI0_SW1_NO_SW0;
+	eu.store = dst;
+	eu.jm_store = EU_STORE_RAW; /* store = raw store field */
+	eu.sz_off = sz;
+	eu.jm_chnk_sz = EU_CHNK_SZ_RAW; /* size = raw size field*/
+
+	return __mod_rcp_eu_cmd_set(rcp, &eu);
+}
+
+s32 mod_sce_mux_to_reg_cpy(struct mod_recipe *rcp, s32 dst, s32 off)
+{
+	struct mod_sce_cmd sce;
+	s32 ret;
+
+	if (unlikely(ptr_is_null(rcp)))
+		return -EINVAL;
+
+	if (unlikely(!mod_is_dpu_rcp_valid(dst)))
+		return -EINVAL;
+
+	if (unlikely(dst & 0x3)) {
+		pr_err("error: sce dst reg must be register start addr\n");
+		return -EINVAL;
+	}
+
+	if (unlikely(!mod_is_sce_mux_off_valid(off)))
+		return -EINVAL;
+
+	ret = __mod_eu_cmd_alloc(rcp, EU_SCE);
+	if (unlikely(ret))
+		return ret;
+
+	memset(&sce, 0, sizeof(sce));
+
+	/* for sce address use register id */
+	sce.addr = MOD_DPU_ID(dst);
+
+	sce.mux_sel = off;
+	/* TODO: sce.cnt = cnt; */
+
+	return __mod_rcp_sce_cmd_set(rcp, &sce);
+}
+
+s32 mod_hdr_rplc(struct mod_recipe *rcp, u32 bce_off, s32 end_trim_layer)
+{
+	struct mod_eu_cmd eu;
+	s32 ret;
+
+	if (unlikely(ptr_is_null(rcp)))
+		return -EINVAL;
+
+	if (unlikely(!mod_is_layer_valid(end_trim_layer)))
+		return -EINVAL;
+
+	if (unlikely(!mod_is_bce_off_valid(bce_off)))
+		return -EINVAL;
+
+	memset(&eu, 0, sizeof(eu));
+	eu.type = EU_INSREP;
+
+	ret = __mod_eu_cmd_alloc(rcp, eu.type);
+	if (unlikely(ret))
+		return ret;
+
+	pr_debug("eu type %d\n", eu.type);
+	/* SI0 = header temlate size from SI MUX */
+	eu.si_mux0    = EU_SI_SEL_HDR_SZ;
+	/* SI1 = 0 */
+	eu.si_mux1    = 0;
+	/* STW1 = L2 offset from STW MUX */
+	eu.stw_mux1   = EU_STW_SEL_L2_OFF;
+	/* stw0 = end_trim_layer from STW MUX */
+	eu.stw_mux0   = end_trim_layer;
+	/* header starts in offset bce_off of bce SI region */
+	eu.load0      = MOD_SRAM_OFF | bce_off;
+	/* use load0 val as is */
+	eu.jm_load0   = EU_LOAD0_RAW;
+	/* load1 = 0 */
+	eu.load1      = 0;
+	/* load1 = load1 + SI0 (si tamplate size) */
+	eu.jm_load1   = EU_LOAD1_SI0;
+	/* always start trim from the packet start */
+	eu.store      = 0;
+	/* store = store + SW1(L2 off) + SI1(0) */
+	eu.jm_store   = EU_STORE_SI1_SW1;
+	/* sz_off = 0 */
+	eu.sz_off     = 0;
+	/* cnk_sz[3..0] = SW0[3..0](L3 off) - SW1[3..0](L2 off) */
+	eu.jm_chnk_sz = EU_SW0_NO_SW1;
+	/* cnk_sz[7..4] = SW0[7..4](L3 off) - SW1[7..4](L2 off) */
+	eu.jm_op      = EU_OP0_SW0_NO_SW1;
+
+	/* set to HW */
+	return __mod_rcp_eu_cmd_set(rcp, &eu);
+}
+
+s32 mod_rcp_complete(struct mod_recipe *rcp)
+{
+	s32 ret = 0;
+	u32 i;
+
+	if (unlikely(ptr_is_null(rcp)))
+		return -EINVAL;
+
+	for (i = 0; i < ARRAY_SIZE(rcp->eu_cmd_cnt); i++) {
+		if (rcp->eu_cmd_cnt[i]) {
+			/* eu is in used, set last command */
+			ret = __mod_eu_last_cmd_mod(rcp, i);
+			if (unlikely(ret))
+				goto done;
+		} else {
+			/* unused eu, add nop as last command */
+			ret = __mod_eu_nop_cmd_add(rcp, i);
+			if (unlikely(ret))
+				goto done;
+		}
+	}
+
+done:
+	return ret;
+}
+
+s32 mod_eu_cmd_max_get(s32 eu, u32 *max_cmds)
+{
+	if (unlikely(ptr_is_null(max_cmds)))
+		return -EINVAL;
+
+	if (unlikely(!mod_is_eu_type_valid(eu)))
+		return -EINVAL;
+
+	*max_cmds = db->eu[eu].max_cmds;
+
+	return 0;
+}
