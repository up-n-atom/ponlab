+		for_each_arr_entry(it, stats, ARRAY_SIZE(stats)) {
+			seq_printf(f, "| %10u ", *(((u32 *)it) + i));
+		}
+		seq_puts(f, "|\n");
+	}
+	seq_puts(f, "|---------------------------------------------------------------------|\n\n");
+}
