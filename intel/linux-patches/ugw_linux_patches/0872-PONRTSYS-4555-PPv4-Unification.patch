+static void uc_dbg_dma_access_set(char *cmd_buf, void *data)
+{
+	u8 uc_type;
+	u32 brst, sz;
+	s32 ret;
+
+	if (unlikely(sscanf(cmd_buf, "%hhu %u %u",
+			    &uc_type, &sz, &brst) != 3)) {
+		pr_err("Command format error\n");
+		pr_err("<uc cluster 0=ING, 1=EGR> <line size> <burst len>\n");
+		return;
+	}
+
+	if (unlikely(uc_type > 1)) {
+		pr_err("invalid uc cluster %hhu\n", uc_type);
+		return;
+	}
+
+	ret = uc_dma_ddr_burst_len_set(!!uc_type, brst);
+	if (unlikely(ret)) {
+		pr_err("failed to set the ddr burst len\n");
+		return;
+	}
+	uc_dma_ddr_line_sz_set(!!uc_type, sz);
+
+	pr_info("UC_TYPE[%s] DDR_LINE_SIZE[%u] DDR_BURST_LEN[%u]\n",
+		uc_type ? "EGRESS" : "INGRESS", sz, brst);
+}
+
+static void uc_dbg_dma_access_show(struct seq_file *f)
+{
+	u32 eg_sz   = 0;
+	u32 eg_brst = 0;
+	u32 in_sz   = 0;
+	u32 in_brst = 0;
+
+	if (likely(uc_is_cluster_valid(UC_IS_EGR))) {
+		eg_sz   = uc_dma_ddr_line_sz_get(UC_IS_EGR);
+		eg_brst = uc_dma_ddr_burst_len_get(UC_IS_EGR);
+	}
+	if (likely(uc_is_cluster_valid(UC_IS_ING))) {
+		in_sz   = uc_dma_ddr_line_sz_get(UC_IS_ING);
+		in_brst = uc_dma_ddr_burst_len_get(UC_IS_ING);
+	}
+
+	seq_puts(f, "\n");
+	seq_puts(f, " +--------------------------------------------+\n");
+	seq_puts(f, " |                DMA DDR ACCESS              |\n");
+	seq_puts(f, " +--------------------------------------------+\n");
+	seq_puts(f, " |  CLUSTER  | DDR LINE SIZE  | DDR BURST LEN |\n");
+	seq_puts(f, " +-----------+----------------+---------------+\n");
+	seq_printf(f, " | %-9s |  %-12u  |  %-11u  |\n", "EGRESS",
+		   eg_sz, eg_brst);
+	seq_puts(f, " +-----------+----------------+---------------+\n");
+	seq_printf(f, " | %-9s |  %-12u  |  %-11u  |\n", "INGRESS",
+		   in_sz, in_brst);
+	seq_puts(f, " +-----------+----------------+---------------+\n");
+	seq_puts(f, "\n");
+}
