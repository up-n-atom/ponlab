+
+	if (sscanf(cmd_buf, "%u %u",
+		   &physical_id, &table_id) != 2) {
+		QOS_LOG_ERR("sscanf err\n");
+		goto read_table_entry_done;
+	}
+
+#ifndef PP_QOS_DISABLE_CMDQ
+		QOS_LOG_INFO("Sending read table entry (%u) from phy (%u)\n",
