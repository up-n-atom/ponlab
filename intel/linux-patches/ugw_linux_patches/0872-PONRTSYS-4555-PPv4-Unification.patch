+	__smgr_dispatch_work(req, &wargs->base, 0);
+
+	/* sync request - return the real return code and free the memory */
+	if (PP_IS_SYNC_REQUEST(req)) {
+		ret = wargs->cb_args.base.ret;
+		kmem_cache_free(db->work_args_cache, wargs);
+	}
+
+	return ret;
+}
