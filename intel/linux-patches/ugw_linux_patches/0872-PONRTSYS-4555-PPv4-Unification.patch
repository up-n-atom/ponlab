+void create_add_sync_queue_cmd(struct pp_qos_dev *qdev,
+			       const struct pp_qos_queue_conf *conf,
+			       u32 phy, u32 rlm, u32 modified)
+{
+	if (PP_QOS_DEVICE_IS_ASSERT(qdev))
