+ *        offset or not
+ * @param mask
+ * @param val value to test
+ * @return bool true in case 'val' is valid, false otherwise
+ */
+static bool __SI_FLD_DPU_START_IS_VALID(s64 val)
+{
+	switch (val) {
+	case 0x20:
+	case 0x30:
+	case 0x40:
+		return true;
+	default:
+		break;
+	}
+	return false;
+}
