+static void __smgr_dbg_pkt_stats_show(struct seq_file *f)
+{
+	struct smgr_mcast_uc_cpu_pkt_stats stats[UC_CPUS_MAX];
+	u32 i;
+	u32 total_rx  = 0;
+	u32 total_tx  = 0;
+	u32 total_drp = 0;
+
+	seq_puts(f, "\n");
+	seq_puts(f, " +----------------------------------+\n");
+	seq_puts(f, " |           MCAST STATS            |\n");
+	seq_puts(f, " +----------------------------------+\n");
