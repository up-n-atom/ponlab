+/**
+ * Register all pp_port tests to pput
+ */
+void pp_port_tests_init(void)
+{
+	int test_idx;
+
+	/* Add Tests */
+	for (test_idx = 0 ; test_idx < ARRAY_SIZE(pp_port_tests); test_idx++)
+		pp_register_test(&pp_port_tests[test_idx]);
+}
