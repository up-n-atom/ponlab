-		/* Read start & end of command buffer to avoid race with FW */
-		qos_u32_from_uc(*(volatile uint32_t *)start);
-
-		if (cur)
-			qos_u32_from_uc(*(volatile uint32_t *)cur);
-
-		signal_uc(qdev);
-	}
-}
-#endif
