+static void __smgr_test_pkt_set(struct fv_pkt_info *pkt)
+{
+	pkt->fv_outer_bitmap |= FV_L2_BASE;
+	pkt->fv_outer_bitmap |= FV_L3_IPV4;
+	pkt->fv_outer_bitmap |= FV_L4_UDP;
+}
