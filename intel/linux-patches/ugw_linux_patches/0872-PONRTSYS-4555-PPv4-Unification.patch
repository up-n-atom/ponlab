+static void uc_dbg_uc_enable_show(struct seq_file *f)
+{
+	u32 i;
+	bool act;
+	u8 hw_max_cpu, uc_types = 2;
+
+	if (unlikely(!uc_is_cluster_valid(UC_IS_EGR) &&
+		     !uc_is_cluster_valid(UC_IS_ING))) {
+		seq_puts(f, "all uc cpus are disabled\n");
