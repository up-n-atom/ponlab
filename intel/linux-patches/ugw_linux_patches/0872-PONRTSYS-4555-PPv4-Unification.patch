-#define ARB_STR(a)                             \
-	((a) == PP_QOS_ARBITRATION_WSP ? "WSP" : \
-	 (a) == PP_QOS_ARBITRATION_WRR ? "WRR" :  \
-	 (a) == PP_QOS_ARBITRATION_WFQ ? "WFQ" :  \
-	 "Unknown")
