+
+/**
+ * @brief Debugfs version attribute show API, prints pp version
+ */
+void __pp_ver_show(struct seq_file *f)
+{
+	struct pp_version drv, fw, hw;
+	s32 ret = 0;
+
+	ret |= pp_version_get(&drv, PP_VER_TYPE_DRV);
