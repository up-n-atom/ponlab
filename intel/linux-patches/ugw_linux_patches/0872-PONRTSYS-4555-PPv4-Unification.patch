+/**
+ * @brief configure CoDel
+ */
+void codel_cfg(char *cmd_buf, void *data)
+{
+	struct pp_qos_dev *qdev;
+	struct pp_qos_codel_cfg cfg;
+	s32 ret;
+
+	qdev = pp_qos_dev_open((unsigned long)data);
