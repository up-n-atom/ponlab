+	seq_puts(f, "|\n");
+	seq_puts(f, "|-----------------+------------+------------+------------+------------|\n");
+
+	i = 0;
+	for_each_arr_entry(str, cntrs_str, ARRAY_SIZE(cntrs_str), i++) {
