+	/*! mailbox messages channel */
+	UC_CH_MESSAGE = UC_CH_FIRST,
+	/*! TODO: not supported in FW */
+	/*UC_CH_EVENT,*/
+	UC_CH_LAST    = UC_CH_MESSAGE,
+};
