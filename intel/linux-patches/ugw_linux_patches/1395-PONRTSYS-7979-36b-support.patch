From e3931ca43587f1e771060bdcbeb570ae77b98592 Mon Sep 17 00:00:00 2001
From: Oren Bakshe <oren.bakshe@intel.com>
Date: Thu, 20 Aug 2020 15:59:10 +0300
Subject: [PATCH] PONRTSYS-7979: 36b support

---
 drivers/net/ppv4/pp-hal/micro-controller/uc.c      | 56 +++++++++++++++++++---
 .../net/ppv4/pp-hal/micro-controller/uc_common.h   |  2 +-
 drivers/net/ppv4/pp-hal/micro-controller/uc_regs.h |  6 +++
 3 files changed, 57 insertions(+), 7 deletions(-)

diff --git a/drivers/net/ppv4/pp-hal/micro-controller/uc.c b/drivers/net/ppv4/pp-hal/micro-controller/uc.c
index b53a43df5378..2c6c7bf8b39a 100644
--- a/drivers/net/ppv4/pp-hal/micro-controller/uc.c
+++ b/drivers/net/ppv4/pp-hal/micro-controller/uc.c
@@ -1217,10 +1217,18 @@ static s32 __uc_cluster_bridge_a_default_set(bool uc_is_egr)
 
 	/* open all entries for 32bit access */
 	for (i = 0; i < UC_A_FAT_MAX_ENT; i++) {
-		if (i == UC_A_PP_FAT_ENT)
+		switch (i) {
+		case UC_A_PP_FAT_ENT:
 			ret = uc_fat_set(uc_is_egr, i, UC_A_PP_FAT_VAL, 1);
-		else
+			break;
+		case UC_A_IOC_FAT_ENT:
+			ret = uc_fat_set(uc_is_egr, i, UC_A_IOC_FAT_VAL, 1);
+			break;
+		default:
 			ret = uc_fat_set(uc_is_egr, i, i, 1);
+			break;
+		}
+
 		if (unlikely(ret))
 			return ret;
 	}
@@ -1249,6 +1257,12 @@ static s32 __uc_cluster_bridge_b_default_set(bool uc_is_egr)
 			/* open the ppv4 access */
 			ret = uc_fat_set(uc_is_egr, i, UC_B_PP_FAT_VAL_BASE +
 					 i - UC_B_PP_FAT_ENT_BASE, 1);
+		} else if (i >= UC_B_IOC_FAT_ENT_BASE && i <
+		    UC_B_IOC_FAT_ENT_BASE + UC_B_PP_FAT_NUM_ENT) {
+			/* open the ppv4 access */
+			ret = uc_fat_set(uc_is_egr, i,
+					 UC_B_IOC_C5_FAT_VAL_BASE +
+					 i - UC_B_IOC_FAT_ENT_BASE, 1);
 		} else {
 			ret = uc_fat_set(uc_is_egr, i, i, 1);
 		}
@@ -1258,7 +1272,15 @@ static s32 __uc_cluster_bridge_b_default_set(bool uc_is_egr)
 
 	/* open all spacial fat entries for 32bit access */
 	for (; i < UC_B_FAT_ALL_MAX_ENT; i++) {
-		ret = uc_fat_set(uc_is_egr, i, i << 22, 1);
+		if (i >= UC_B_IOC_C6_FAT_ENT_BASE && i <
+		    UC_B_IOC_C6_FAT_ENT_BASE + UC_B_PP_FAT_NUM_ENT) {
+			/* open the ppv4 access */
+			ret = uc_fat_set(uc_is_egr, i,
+					 UC_B_IOC_C6_FAT_VAL_BASE(
+					 i - UC_B_IOC_C6_FAT_ENT_BASE), 1);
+		} else {
+			ret = uc_fat_set(uc_is_egr, i, i << 22, 1);
+		}
 		if (unlikely(ret))
 			return ret;
 	}
@@ -1405,6 +1427,27 @@ s32 uc_aux_reg_write(u32 reg, u32 val)
 				    sizeof(args), NULL, 0);
 }
 
+/* Converts IO coherent address to uc perspective */
+static u32 __convert_36b_addr_to_32b(u64 addr)
+{
+	u32 msb = (addr >> 28) & 0xFF;
+	u32 uc_addr = addr;
+
+	/* Replace 0xC5XXX address to 0xBXXX */
+	if (msb == 0xc5) {
+		uc_addr &= 0x0FFFFFFF;
+		uc_addr |= 0xB0000000;
+	} else if (pp_silicon_step_get() == PP_SSTEP_B) {
+		/* Replace 0xC6XXX address to 0xCXXX */
+		if (msb == 0xc6) {
+			uc_addr &= 0x0FFFFFFF;
+			uc_addr |= 0xC0000000;
+		}
+	}
+
+	return uc_addr;
+}
+
 s32 __nf_reass_set(u16 tx_queue, u16 dflt_hif)
 {
 	struct reassembly_info info;
@@ -1430,7 +1473,7 @@ s32 __nf_reass_set(u16 tx_queue, u16 dflt_hif)
 	info.host_pid           = dflt_si.eg_port;
 	info.rxdma_base         = UC_PP_ADDR(rxdma_base_addr);
 	info.excp_si_base       = UC_PP_ADDR(chk_excp_si_phys_base_get());
-	info.si_base            = cls_si_phys_base_get();
+	info.si_base = __convert_36b_addr_to_32b(cls_si_phys_base_get());
 
 	port_cfg.port_id = dflt_si.eg_port;
 	ret = rx_dma_port_get(&port_cfg);
@@ -1665,11 +1708,12 @@ s32 __uc_egr_info_set(void)
 	struct eg_uc_init_info info;
 
 	memset(&info, 0, sizeof(info));
-	info.logger_buff    = (u32)logger_buff_phys;
+	info.logger_buff    = __convert_36b_addr_to_32b(logger_buff_phys);
 	info.logger_buff_sz = logger_buff_sz;
 	info.chk_base       = UC_PP_ADDR(chk_base_addr);
 	info.chk_ctrs_cache_base = UC_PP_ADDR(chk_ctrs_cache_base_addr);
-	info.chk_dsi_ddr_base = (u32)chk_dsi_phys_base_get();
+	info.chk_dsi_ddr_base =
+		__convert_36b_addr_to_32b(chk_dsi_phys_base_get());
 	info.cls_base       = UC_PP_ADDR(cls_base_addr);
 
 	return uc_egr_mbox_cmd_send(UC_CMD_INIT, 0, (const void *)&info,
diff --git a/drivers/net/ppv4/pp-hal/micro-controller/uc_common.h b/drivers/net/ppv4/pp-hal/micro-controller/uc_common.h
index c133804fd84b..038d03737682 100644
--- a/drivers/net/ppv4/pp-hal/micro-controller/uc_common.h
+++ b/drivers/net/ppv4/pp-hal/micro-controller/uc_common.h
@@ -13,7 +13,7 @@
  * the version here
  */
 #define EGRESS_VER_MAJOR  1
-#define EGRESS_VER_MINOR  17
+#define EGRESS_VER_MINOR  18
 
 #define INGRESS_VER_MAJOR 1
 #define INGRESS_VER_MINOR 2
diff --git a/drivers/net/ppv4/pp-hal/micro-controller/uc_regs.h b/drivers/net/ppv4/pp-hal/micro-controller/uc_regs.h
index 7c2f42a1e380..8b5eeaa0af20 100644
--- a/drivers/net/ppv4/pp-hal/micro-controller/uc_regs.h
+++ b/drivers/net/ppv4/pp-hal/micro-controller/uc_regs.h
@@ -422,6 +422,8 @@ extern u64 uc_ing_base_addr;
 #define UC_A_FAT_EN_BIT_SHIFT          8
 #define UC_A_PP_FAT_ENT                0xA
 #define UC_A_PP_FAT_VAL                0xF
+#define UC_A_IOC_FAT_ENT               0xB
+#define UC_A_IOC_FAT_VAL               0xC5
 #define UC_A_FAT_VAL_MSK               GENMASK(7, 0)
 #define UC_A_FAT_EN_MSK                BIT(8)
 #define UC_A_CLUSTERBRIDGE_FAT(t, x)   \
@@ -435,6 +437,10 @@ extern u64 uc_ing_base_addr;
 #define UC_B_FAT_ALL_MAX_ENT           (UC_B_FAT_BASE_MAX_ENT+UC_B_FAT_MAX_ENT)
 #define UC_B_PP_FAT_ENT_BASE           0x28
 #define UC_B_PP_FAT_VAL_BASE           0x3C
+#define UC_B_IOC_FAT_ENT_BASE          0x2C
+#define UC_B_IOC_C5_FAT_VAL_BASE       0x314 /* 0xC5 << 2 */
+#define UC_B_IOC_C6_FAT_ENT_BASE       0x30
+#define UC_B_IOC_C6_FAT_VAL_BASE(ind)  (((0xC6 << 2) + ind) << 22)
 #define UC_B_PP_FAT_NUM_ENT            4
 #define UC_B_FAT_VAL_MSK               GENMASK(9, 0)
 #define UC_B_FAT_EN_MSK                BIT(0)
