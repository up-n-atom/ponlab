From f5ee8219b9f4ed91f73831ac9f84d7d16938f790 Mon Sep 17 00:00:00 2001
From: santhoshx <santosh.kumarx.mamila@intel.com>
Date: Tue, 8 Dec 2020 23:01:43 +0800
Subject: [PATCH] PONRTSYS-8338:- Removing compilation warnings in cqm driver

---
 drivers/net/ethernet/lantiq/cqm/prx300/cqm.c | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/drivers/net/ethernet/lantiq/cqm/prx300/cqm.c b/drivers/net/ethernet/lantiq/cqm/prx300/cqm.c
index be7dce40eb36..3d5ac8431197 100644
--- a/drivers/net/ethernet/lantiq/cqm/prx300/cqm.c
+++ b/drivers/net/ethernet/lantiq/cqm/prx300/cqm.c
@@ -2681,7 +2681,7 @@ static void cqm_deq_pon_port_disable(u32 port, u32 alloc_flags)
 	struct cqm_dqm_port_info *p_info;
 	void *deq = cqm_ctrl->deq;
 	int chan, i;
-	u32 pib_ctrl_val, val = 0;
+	u32  val = 0;
 	struct pib_stat stat;
 
 	p_info = &dqm_port_info[port];
@@ -2692,7 +2692,7 @@ static void cqm_deq_pon_port_disable(u32 port, u32 alloc_flags)
 		       PIB_PON_IP_CMD_PORT_ID_POS) | 0x28000;
 		cbm_w32(cqm_ctrl->pib + PIB_PON_IP_CMD, val);
 		dev_dbg(cqm_ctrl->dev, "%s: write CQEM_PIB_PIB_PON_IP_CMD %lx , val %x\n",
-			__func__, cqm_ctrl->pib + PIB_PON_IP_CMD, val);
+			__func__, (unsigned long) cqm_ctrl->pib + PIB_PON_IP_CMD, val);
 		pib_status_get(&stat);
 		dev_dbg(cqm_ctrl->dev, "%s waiting for fifo_emtpy %d\n",
 			__func__, stat.fifo_empty);
@@ -2809,7 +2809,7 @@ static s32 dp_enable(struct module *owner, u32 port_id,
 			cbm_w32(cqm_ctrl->pib + PIB_PON_IP_CMD, val);
 			dev_dbg(cqm_ctrl->dev,
 				"%s: write CQEM_PIB_PIB_PON_IP_CMD %lx , val %x\n",
-				__func__, cqm_ctrl->pib + PIB_PON_IP_CMD, val);
+				__func__, (unsigned long) cqm_ctrl->pib + PIB_PON_IP_CMD, val);
 		}
 
 		if (!(flags & CBM_PORT_F_DISABLE)) {
@@ -4020,7 +4020,7 @@ static void init_cqm_deq_dma_port(int dqp_idx, int dmap_idx)
 		/* re-enable auto read increment here*/
 		set_val((cqm_ctrl->deq + DQ_DMA_PORT((dmap_idx), cfg)),
 			0, 0x2, 1);
-		dev_dbg(cqm_ctrl->dev, " %s 0x%x 0x%x\n",
+		dev_dbg(cqm_ctrl->dev, " %s 0x%x 0x%x\n dmap_idx %d, dqp_idx %d\n",
 			__func__,
 			(int)(deq + DQ_DMA_PORT(dmap_idx, cfg)),
 			0x02 |
