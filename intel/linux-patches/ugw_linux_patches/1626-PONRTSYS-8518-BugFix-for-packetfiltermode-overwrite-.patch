From fd820fce14a285f4700fd605de1b78bac46787f3 Mon Sep 17 00:00:00 2001
From: thampan <joby.thampan@intel.com>
Date: Thu, 11 Mar 2021 18:46:27 +0800
Subject: [PATCH] PONRTSYS-8518: BugFix for packetfiltermode overwrite for
 extended vlan

---
 drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c | 11 ++++++++---
 1 file changed, 8 insertions(+), 3 deletions(-)

diff --git a/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c b/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c
index dfa2234c78d5..c298af46507b 100644
--- a/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c
+++ b/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c
@@ -20520,11 +20520,16 @@ GSW_return_t GSW_ExtendedVlanSet(void *cdev, GSW_EXTENDEDVLAN_config_t *parm)
 		tbl_prog.val[5] |= ((parm->sTreatment.nNewTrafficClass & 0xF) << 9);
 	}
 
-	/** Treatment Metering
+	/* If MeterEnable then Treatment Metering
 		val 5 BIT 8 to enable Metering
 		val 5 BIT 7:0 for New Meter ID
-	**/
-	tbl_prog.val[5] &= ~(0x1FF);
+	    Else
+	        val 5 BIT 4 to enable bOriginalPacketFilterMode
+	        val 5 BIT 3:2 eTreatment_4_Tpid_Mode
+	        val 5 BIT 1:0 eFilter_4_Tpid_Mode
+	*/
+	if (parm->sTreatment.bNewMeterEnable)
+		tbl_prog.val[5] &= ~(0x1FF);
 
 	/* New meter ID TODO - KEEP CHECK on METERID.
 	Meter should be allocated with \ref GSW_QOS_METER_ALLOC before extended
