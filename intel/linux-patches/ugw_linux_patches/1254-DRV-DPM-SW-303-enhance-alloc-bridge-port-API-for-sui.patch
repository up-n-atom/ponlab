+++ b/drivers/net/datapath/dpm/datapath_swdev.c
@@ -405,20 +405,11 @@ static int dp_swdev_cfg_gswip(struct bridge_id_entry_item *br_item,
 {
 	struct inst_info *i_info;
 	struct br_info *br_info;
-	struct dp_bp_attr conf;
 	int ret;
 
 	i_info = get_dp_prop_info(br_item->inst);
 	DP_DEBUG(DP_DBG_FLAG_SWDEV, "britem flags:%x\n", br_item->flags);
 
-	if (br_item->flags & CPU_PORT_DISABLE) {
-		/* Remove CPU bridge port from bp member list */
-		conf.inst = br_item->inst;
-		conf.dev = dev;
-		conf.en = 0;
-		i_info->dp_set_bp_attr(&conf, br_item->bportid, 0);
-	}
-
 	if (br_item->flags & ADD_BRENTRY) {
 		DP_DEBUG(DP_DBG_FLAG_SWDEV, "Add bridge entry %s\n",
 			 br_item->dev->name);
