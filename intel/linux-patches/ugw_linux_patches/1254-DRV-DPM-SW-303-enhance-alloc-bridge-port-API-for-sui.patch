+++ b/drivers/net/datapath/dpm/datapath_api.c
@@ -656,7 +656,7 @@ int32_t dp_register_subif_private(int inst, struct module *owner,
 				 *For PRX300: it need to allocate BP for it
 				 */
 				return add_logic_dev(inst, port_id, dev,
-						     subif_id, flags);
+						    subif_id, data, flags);
 			}
 		}
 		start = 0;
@@ -969,7 +969,7 @@ static int dp_cbm_deq_update(int inst, struct dp_subif_upd_info *info)
 }
 
 static int dp_alloc_bp_priv(int inst, int port_id, int subif_ix,
-			    int fid, int bp_member)
+			    int fid, int bp_member, int flags)
 {
 	struct inst_info *inst_info;
 
@@ -979,7 +979,7 @@ static int dp_alloc_bp_priv(int inst, int port_id, int subif_ix,
 		return DP_FAILURE;
 	}
 	return inst_info->dp_alloc_bridge_port(inst, port_id, subif_ix,
-					       fid, bp_member);
+					       fid, bp_member, flags);
 }
 
 static int dp_free_bp_priv(int inst, int bp)
@@ -1006,6 +1006,7 @@ int32_t dp_update_subif_info(struct dp_subif_upd_info *info)
 	dp_subif_t *new_subif_id_sync, *old_subif_id_sync;
 	dp_get_netif_subifid_fn_t subifid_fn = NULL;
 	struct dp_subif_data old_data = {0}, new_data = {0};
+	int flags; /*to set CPU BP member */
 
 	if (unlikely(!dp_init_ok)) {
 		pr_err("%s failed: datapath not initialized yet\n", __func__);
@@ -1044,9 +1045,11 @@ int32_t dp_update_subif_info(struct dp_subif_upd_info *info)
 			DP_DEBUG(DP_DBG_FLAG_REG,
 				 "new master dev(%s) not exists\n",
 				 info->new_dev->name);
+			if (!(sif->cpu_port_en))
+				flags = DP_SUBIF_BP_CPU_DISABLE;
 			/* Allocate new bp */
 			bp = dp_alloc_bp_priv(info->inst, info->dp_port, vap,
-					      0, 0);
+					      0, 0, flags);
 			if (bp < 0) {
 				pr_err("Fail to alloc bridge port\n");
 				goto exit;
diff --git a/drivers/net/datapath/dpm/datapath_logical_dev.c b/drivers/net/datapath/dpm/datapath_logical_dev.c
