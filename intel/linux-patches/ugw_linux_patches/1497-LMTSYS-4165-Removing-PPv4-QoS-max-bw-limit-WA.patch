From 271d4727b5563cad44b2619d32785b8d52bbaf96 Mon Sep 17 00:00:00 2001
From: Elad Fernandes <elad.fernandes@intel.com>
Date: Sun, 25 Oct 2020 15:46:08 +0200
Subject: [PATCH] LMTSYS-4165: Removing PPv4 QoS max bw limit WA

---
 drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.c | 28 ++++-------------------
 1 file changed, 5 insertions(+), 23 deletions(-)

diff --git a/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.c b/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.c
index f1f672a72190..734d8fa52625 100644
--- a/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.c
+++ b/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.c
@@ -3135,25 +3135,11 @@ static s32 set_common(struct pp_qos_dev *qdev,
 		      uint32_t *modified)
 {
 	u32 grp_id;
-	u32 new_bw;
 	u32 burst;
 
 	if (node->bandwidth_limit != common->bandwidth_limit) {
-		new_bw = common->bandwidth_limit;
-
-		/* Workaround for FLM and LGM Step-A */
-		if (!IS_ENABLED(CONFIG_PPV4_LGM) ||
-		    (IS_ENABLED(CONFIG_PPV4_LGM) &&
-		     pp_silicon_step_get() == PP_SSTEP_A)) {
-			/* Use maximum bw instead of using unlimited bw */
-			if (new_bw == QOS_NO_BANDWIDTH_LIMIT)
-				new_bw = qdev->hwconf.max_bw_limit_kbps;
-		}
-
-		if (new_bw != node->bandwidth_limit) {
-			node->bandwidth_limit = new_bw;
-			QOS_BITS_SET(*modified, QOS_MODIFIED_BANDWIDTH_LIMIT);
-		}
+		node->bandwidth_limit = common->bandwidth_limit;
+		QOS_BITS_SET(*modified, QOS_MODIFIED_BANDWIDTH_LIMIT);
 	}
 
 	grp_id = common->shared_bw_group;
@@ -4224,7 +4210,6 @@ static void qos_dbg_dump_subtree(struct pp_qos_dev *qdev, struct qos_node *node,
 	bool aqm_queue;
 	bool codel_queue;
 	struct qos_node *child;
-	u32 max_bw = qdev->hwconf.max_bw_limit_kbps;
 
 	if (unlikely(depth > QOS_MAX_PREDECESSORS)) {
 		pr_err("Maximum depth of %u exceeded\n", QOS_MAX_PREDECESSORS);
@@ -4256,8 +4241,7 @@ static void qos_dbg_dump_subtree(struct pp_qos_dev *qdev, struct qos_node *node,
 			snprintf(indent_str, 64, "%s|-- ", tabs_str);
 
 		if (node_sched(child)) {
-			if (child->bandwidth_limit &&
-			    child->bandwidth_limit != max_bw)
+			if (child->bandwidth_limit)
 				snprintf(bw_str, 64, ", bw %u",
 					 child->bandwidth_limit);
 
@@ -4286,8 +4270,7 @@ static void qos_dbg_dump_subtree(struct pp_qos_dev *qdev, struct qos_node *node,
 			if (codel_queue)
 				snprintf(aqm_codel_str, 64, "-codel");
 
-			if ((child->bandwidth_limit &&
-			     child->bandwidth_limit != max_bw) ||
+			if ((child->bandwidth_limit) ||
 			    child->data.queue.eir)
 				snprintf(bw_str, 64, ", bw %u/%u",
 					 child->bandwidth_limit,
@@ -4320,7 +4303,6 @@ void __qos_dbg_tree_show(struct pp_qos_dev *qdev, bool user_tree,
 	struct qos_node *node;
 	u32 node_id, node_phy;
 	char bw_str[64];
-	u32 max_bw = qdev->hwconf.max_bw_limit_kbps;
 
 	/* Iterate through all port nodes */
 	for (node_phy = 0; node_phy < NUM_OF_NODES; ++node_phy) {
@@ -4329,7 +4311,7 @@ void __qos_dbg_tree_show(struct pp_qos_dev *qdev, bool user_tree,
 		if (!node_port(node))
 			continue;
 
-		if (node->bandwidth_limit && node->bandwidth_limit != max_bw)
+		if (node->bandwidth_limit)
 			snprintf(bw_str, 64, ", bw %u)",
 				 node->bandwidth_limit);
 		else
