From 0900a1bf6db149f0b4de12db5334da9849812919 Mon Sep 17 00:00:00 2001
From: Elad Fernandes <elad.fernandes@intel.com>
Date: Tue, 5 May 2020 13:04:50 +0300
Subject: [PATCH] PONRTSYS-7747: Disable fragmentation for TCP packets

---
 drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c b/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c
index 019ea4bcc3dc..3d11ba338e23 100644
--- a/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c
+++ b/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c
@@ -2218,7 +2218,9 @@ static void __smgr_sess_flags_set(struct sess_info *s)
 
 	/* Fragmentation should be potentialy done when adding a tunnel */
 	if (pp_misc_is_nf_en(PP_NF_FRAGMENTER)) {
-		if (__smgr_is_iptun_encp_sess(s) || __smgr_is_pppoe_encap(s)) {
+		if ((__smgr_is_iptun_encp_sess(s) ||
+		     __smgr_is_pppoe_encap(s)) &&
+		    !SESS_RX_IS_OUTER_TCP(s)) {
 			SESS_FLAG_SET(s->db_ent, SESS_FLAG_MTU_CHCK);
 			pr_debug("SESS_FLAG_MTU_CHCK is set\n");
 		}
