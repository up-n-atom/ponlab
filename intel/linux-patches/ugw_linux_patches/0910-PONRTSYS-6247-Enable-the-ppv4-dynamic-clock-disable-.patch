From 82ca9be381d6e9dcf7b4759cdee912d03a2e5f7d Mon Sep 17 00:00:00 2001
From: Elad Fernandes <elad.fernandes@intel.com>
Date: Thu, 21 Nov 2019 17:28:33 +0200
Subject: [PATCH] PONRTSYS-6247: Enable the ppv4 dynamic clock, disable port
 distributer by default

---
 drivers/net/ppv4/pp-hal/infra/infra.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/drivers/net/ppv4/pp-hal/infra/infra.c b/drivers/net/ppv4/pp-hal/infra/infra.c
index 4ef5b72db27b..3fe6f4416e99 100644
--- a/drivers/net/ppv4/pp-hal/infra/infra.c
+++ b/drivers/net/ppv4/pp-hal/infra/infra.c
@@ -447,6 +447,7 @@ void infra_dynamic_clk_init(void)
 		/* skip due to feature not working properly */
 		case DCLK_MOD_CLS_SESS_CACHE:
 		case DCLK_MOD_CLS_CHK_CACHE:
+		case DCLK_MOD_PORT_DIST:
 		/* skip due to feature no implemented in HW */
 		case DCLK_MOD_RX_DMA:
 		case DCLK_MOD_QOS_WRED:
@@ -462,8 +463,8 @@ void infra_dynamic_clk_init(void)
 	}
 	pr_debug("dclk reg ==> %#lx\n", dclk_reg);
 	PP_REG_WR32(PP_CLK_CTRL_DYNAMIC_CLK_GATED_EN_REG, (u32)dclk_reg);
-	/* enable force clock on for now... */
-	PP_REG_WR32(PP_CLK_CTRL_ICG_FORCE_CLK_REG, 1);
+	/* disable force clock on */
+	PP_REG_WR32(PP_CLK_CTRL_ICG_FORCE_CLK_REG, 0);
 }
 
 s32 infra_reset_hw(enum cru_module m)
