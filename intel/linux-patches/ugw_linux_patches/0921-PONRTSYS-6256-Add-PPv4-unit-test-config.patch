From 23a618c4e7cc448aa7511e2c67253db9a691c54f Mon Sep 17 00:00:00 2001
From: ofirbitt <ofir1.bitton@intel.com>
Date: Thu, 12 Dec 2019 14:02:22 +0200
Subject: [PATCH] PONRTSYS-6256: Add PPv4 unit test config

---
 drivers/net/ppv4/Kconfig                                   |  7 +++++++
 drivers/net/ppv4/Makefile                                  |  4 ++++
 drivers/net/ppv4/pp-dev/pp_dev.c                           | 14 ++++++++++----
 .../net/ppv4/pp-tools/unit-test/tests/pp_session_tests.c   |  4 +++-
 4 files changed, 24 insertions(+), 5 deletions(-)

diff --git a/drivers/net/ppv4/Kconfig b/drivers/net/ppv4/Kconfig
index 5c32141008ef..3833d6fe5b4b 100644
--- a/drivers/net/ppv4/Kconfig
+++ b/drivers/net/ppv4/Kconfig
@@ -6,3 +6,10 @@ config PPV4
 
 	---help---
 	  Packet Processor V4 Driver
+
+config PPV4_UT
+	bool "Packet Processor V4 Unit test"
+	depends on PPV4
+	default n
+	---help---
+	  Packet Processor V4 Driver Unit Test
diff --git a/drivers/net/ppv4/Makefile b/drivers/net/ppv4/Makefile
index 358ffb7ffac0..f390c38452f8 100644
--- a/drivers/net/ppv4/Makefile
+++ b/drivers/net/ppv4/Makefile
@@ -145,8 +145,11 @@ $(TARGET)-y += pp-api/pp-qos-mgr/pp_qos_fw.o
 $(TARGET)-$(CONFIG_PHY_INTEL_COMBO_LGM) += pp-api/pp-qos-mgr/pp_qos_sysfs.o
 $(TARGET)-$(CONFIG_DEBUG_FS) += pp-api/pp-qos-mgr/pp_qos_debugfs.o
 # PP unit-test
+ifeq ($(CONFIG_PPV4_UT),y)
 $(TARGET)-y += pp-tools/unit-test/pput_drv.o
+endif
 
+ifeq ($(CONFIG_PPV4_UT),y)
 ifeq ($(CONFIG_PHY_INTEL_COMBO_LGM),y)
 $(TARGET)-y += pp-tools/unit-test/tests/pp_infra_tests.o
 $(TARGET)-y += pp-tools/unit-test/tests/pp_port_tests.o
@@ -156,6 +159,7 @@ endif
 
 $(TARGET)-y += pp-tools/unit-test/tests/pp_qos_tests.o
 $(TARGET)-$(CONFIG_PPV4_FPGA) += pp-tools/unit-test/tests/pp_bm_tests.o
+endif
 
 ifneq ($(KERNELRELEASE),)
 
diff --git a/drivers/net/ppv4/pp-dev/pp_dev.c b/drivers/net/ppv4/pp-dev/pp_dev.c
index ed59b32b30ad..2bf046635ab9 100644
--- a/drivers/net/ppv4/pp-dev/pp_dev.c
+++ b/drivers/net/ppv4/pp-dev/pp_dev.c
@@ -510,9 +510,13 @@ static int __pp_dev_probe(struct platform_device *pdev)
 	}
 
 	/* init unit tests */
-	probe_ret = pput_init(pp_dbgfs_dir);
-	if (unlikely(probe_ret))
-		pr_err("Failed to init unit tests, ret %d\n", probe_ret);
+	if (IS_ENABLED(CONFIG_PPV4_UT)) {
+		probe_ret = pput_init(pp_dbgfs_dir);
+		if (unlikely(probe_ret)) {
+			pr_err("Failed to init unit tests, ret %d\n",
+			       probe_ret);
+		}
+	}
 
 	if (likely(!probe_ret))
 		init_done = true;
@@ -534,7 +538,9 @@ static int __pp_dev_remove(struct platform_device *pdev)
 	ready = false;
 
 	/* clean other modules first */
-	pput_exit();
+	if (IS_ENABLED(CONFIG_PPV4_UT))
+		pput_exit();
+
 	if (IS_ENABLED(CONFIG_PPV4_FPGA))
 		fpga_ppv4_dbg_clean();
 	__pp_api_exit();
diff --git a/drivers/net/ppv4/pp-tools/unit-test/tests/pp_session_tests.c b/drivers/net/ppv4/pp-tools/unit-test/tests/pp_session_tests.c
index 0a0173563605..4a547c2d95da 100644
--- a/drivers/net/ppv4/pp-tools/unit-test/tests/pp_session_tests.c
+++ b/drivers/net/ppv4/pp-tools/unit-test/tests/pp_session_tests.c
@@ -817,7 +817,9 @@ static int pp_sess_post_test(void *data)
 	if (pp_port != U32_MAX)
 		pmgr_port_del(pp_port, false);
 
-	smgr_tdox_dbg_timer_set(3000);
+	if (smgr_tdox_enable_get())
+		smgr_tdox_dbg_timer_set(3000);
+
 	kfree(created_tdox_sessions);
 
 	return PP_UT_PASS;
