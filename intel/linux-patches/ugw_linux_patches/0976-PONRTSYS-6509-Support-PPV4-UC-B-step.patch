From: Elad Fernandes <elad.fernandes@intel.com>
Date: Mon, 30 Dec 2019 14:13:53 +0200
Subject: [PATCH] PONRTSYS-6509: Support PPV4 UC B-step

---
 drivers/net/ppv4/pp-hal/micro-controller/uc.c      | 644 +++++++--------------
 drivers/net/ppv4/pp-hal/micro-controller/uc.h      |   3 +-
 .../net/ppv4/pp-hal/micro-controller/uc_debugfs.c  | 108 ----
 .../net/ppv4/pp-hal/micro-controller/uc_egr_mbox.c | 228 ++++----
 .../net/ppv4/pp-hal/micro-controller/uc_internal.h | 139 +----
 .../pp-hal/micro-controller/uc_private_engines.h   | 231 +-------
 drivers/net/ppv4/pp-hal/micro-controller/uc_regs.h | 335 +++++------
 .../pp-hal/micro-controller/uc_shared_engines.h    | 363 +++---------
 8 files changed, 556 insertions(+), 1495 deletions(-)

diff --git a/drivers/net/ppv4/pp-hal/micro-controller/uc.c b/drivers/net/ppv4/pp-hal/micro-controller/uc.c
index 83291dcec809..e1ca6f40937c 100644
--- a/drivers/net/ppv4/pp-hal/micro-controller/uc.c
+++ b/drivers/net/ppv4/pp-hal/micro-controller/uc.c
@@ -28,15 +28,17 @@
 /**
  * @define egress elf file name
  */
-#define UC_EGR_FW_NAME             "egress_uc.elf"
+#define UC_A_EGR_ELF           "egress_uc_v1.elf"
+#define UC_B_EGR_ELF           "egress_uc_v2.elf"
 /**
  * @define ingress elf file name
  */
-#define UC_ING_FW_NAME             "ingress_uc.elf"
+#define UC_A_ING_ELF           "ingress_uc_v1.elf"
+#define UC_B_ING_ELF           "ingress_uc_v2.elf"
 /**
  * @define maximum number of elf sections
  */
-#define UC_ELF_SEC_MAX             (32)
+#define UC_ELF_SEC_MAX             32
 /**
  * @define convert elf section address to offset
  */
@@ -44,19 +46,19 @@
 /**
  * @define boot done value is written by the uc
  */
-#define UC_BOOT_DONE_VAL           (0x20)
+#define UC_BOOT_DONE_VAL           0x20
 /**
  * @define ccu done value is written by the uc
  */
-#define UC_CCU_DONE_VAL            (0x1)
+#define UC_CCU_DONE_VAL            1
 /**
  * @define turn on value
  */
-#define UC_TURN_ON_VAL             (1)
+#define UC_TURN_ON_VAL             1
 /**
  * @define MSB nibble of the PP mem-space when accessing from uc
  */
-#define UC_PP_ADDR_MSB             (0xA)
+#define UC_PP_ADDR_MSB             0xA
 /**
  * @define convert the phy-address from host perspective to uc
  *         perspective
@@ -220,126 +222,76 @@ bool uc_is_cpu_active(bool uc_is_egr, u32 cid)
 	return false;
 }
 
-void uc_reader_wred_addr_set(bool uc_is_egr, u32 addr)
+static void __uc_egr_reader_wred_addr_set(u32 addr)
 {
-	if (unlikely(!uc_is_cluster_valid(uc_is_egr)))
-		return;
-
-	if (uc_is_egr)
-		PP_REG_WR32(UC_READER_WRED_BASE(EGRESS), UC_PP_ADDR(addr));
-	else
-		PP_REG_WR32(UC_READER_WRED_BASE(INGRESS), UC_PP_ADDR(addr));
-}
-
-void uc_reader_client_addr_set(bool uc_is_egr, u32 addr)
-{
-	if (unlikely(!uc_is_cluster_valid(uc_is_egr)))
-		return;
+	u64 reg;
 
-	if (uc_is_egr)
-		PP_REG_WR32(UC_READER_CLIENT_BASE(EGRESS), addr >> 20);
+	if (pp_silicon_step_get() == PP_SSTEP_A)
+		reg = UC_A_READER_WRED_BASE(EGRESS);
 	else
-		PP_REG_WR32(UC_READER_CLIENT_BASE(INGRESS), addr >> 20);
-}
-
-void uc_reader_qm_addr_set(bool uc_is_egr, u32 addr)
-{
-	if (unlikely(!uc_is_cluster_valid(uc_is_egr)))
-		return;
+		reg = UC_B_READER_WRED_BASE(EGRESS);
 
-	if (uc_is_egr)
-		PP_REG_WR32(UC_READER_QMNGR_BASE(EGRESS), UC_PP_ADDR(addr));
-	else
-		PP_REG_WR32(UC_READER_QMNGR_BASE(INGRESS), UC_PP_ADDR(addr));
+	PP_REG_WR32(reg, UC_PP_ADDR(addr));
 }
 
-void uc_reader_bm_addr_set(bool uc_is_egr, u32 addr)
+static void __uc_egr_reader_client_addr_set(u32 addr)
 {
-	u32 reg = PP_FIELD_PREP(UC_READER_BMNGR_BASE_MSK,
-				(UC_PP_ADDR(addr)) >> 16);
-
-	if (unlikely(!uc_is_cluster_valid(uc_is_egr)))
-		return;
+	u64 reg;
 
-	if (uc_is_egr)
-		PP_REG_WR32(UC_READER_BMNGR_BASE(EGRESS), reg);
+	if (pp_silicon_step_get() == PP_SSTEP_A)
+		reg = UC_A_READER_CLIENT_BASE(EGRESS);
 	else
-		PP_REG_WR32(UC_READER_BMNGR_BASE(INGRESS), reg);
-}
-
-void uc_dma_ddr_line_sz_set(bool uc_is_egr, u32 sz)
-{
-	if (unlikely(!uc_is_cluster_valid(uc_is_egr)))
-		return;
+		reg = UC_B_READER_CLIENT_BASE(EGRESS);
 
-	if (uc_is_egr)
-		PP_REG_WR32(UC_DMAE_DDR_LINE_SIZE(EGRESS), sz);
-	else
-		PP_REG_WR32(UC_DMAE_DDR_LINE_SIZE(INGRESS), sz);
+	PP_REG_WR32(reg, addr >> 20);
 }
 
-u32 uc_dma_ddr_line_sz_get(bool uc_is_egr)
+static void __uc_egr_reader_qm_addr_set(u32 addr)
 {
-	u32 reg = 0;
+	u64 reg;
 
-	if (unlikely(!uc_is_cluster_valid(uc_is_egr)))
-		goto out;
-
-	if (uc_is_egr)
-		reg = PP_REG_RD32(UC_DMAE_DDR_LINE_SIZE(EGRESS));
+	if (pp_silicon_step_get() == PP_SSTEP_A)
+		reg = UC_A_READER_QMNGR_BASE(EGRESS);
 	else
-		reg = PP_REG_RD32(UC_DMAE_DDR_LINE_SIZE(INGRESS));
+		reg = UC_B_READER_QMNGR_BASE(EGRESS);
 
-out:
-	return reg;
+	PP_REG_WR32(reg, UC_PP_ADDR(addr));
 }
 
-s32 uc_dma_ddr_burst_len_set(bool uc_is_egr, u32 len)
+static void __uc_egr_reader_bm_addr_set(u32 addr)
 {
-	if (unlikely(!uc_is_cluster_valid(uc_is_egr)))
-		return -EPERM;
-
-	if (!is_power_of_2(len)) {
-		pr_err("invalid burst size %u, must be power of 2\n", len);
-		return -EINVAL;
-	}
+	u64 reg;
+	u32 val = PP_FIELD_PREP(UC_READER_BMNGR_BASE_MSK,
+				(UC_PP_ADDR(addr)) >> 16);
 
-	if (uc_is_egr)
-		PP_REG_WR32(UC_DMAE_BURST_LENGTH(EGRESS), len);
+	if (pp_silicon_step_get() == PP_SSTEP_A)
+		reg = UC_A_READER_BMNGR_BASE(EGRESS);
 	else
-		PP_REG_WR32(UC_DMAE_BURST_LENGTH(INGRESS), len);
+		reg = UC_B_READER_BMNGR_BASE(EGRESS);
 
-	return 0;
-}
-
-u32 uc_dma_ddr_burst_len_get(bool uc_is_egr)
-{
-	u32 reg = 0;
-
-	if (unlikely(!uc_is_cluster_valid(uc_is_egr)))
-		goto out;
+	PP_REG_WR32(reg, val);
 
-	if (uc_is_egr)
-		reg = PP_REG_RD32(UC_DMAE_BURST_LENGTH(EGRESS));
-	else
-		reg = PP_REG_RD32(UC_DMAE_BURST_LENGTH(INGRESS));
-
-out:
-	return reg;
 }
 
 s32 uc_ccu_maxcpus_get(bool uc_is_egr, u8 *max_cpus)
 {
-	u32 reg;
+	u64 reg;
 
 	if (unlikely(ptr_is_null(max_cpus)))
 		return -EINVAL;
 
 	/* read ccu gpreg */
-	if (uc_is_egr)
-		reg = PP_REG_RD32(UC_CCU_MAXCPU_REG(EGRESS));
-	else
-		reg = PP_REG_RD32(UC_CCU_MAXCPU_REG(INGRESS));
+	if (pp_silicon_step_get() == PP_SSTEP_A) {
+		if (uc_is_egr)
+			reg = PP_REG_RD32(UC_A_CCU_MAXCPU_REG(EGRESS));
+		else
+			reg = PP_REG_RD32(UC_A_CCU_MAXCPU_REG(INGRESS));
+	} else {
+		if (uc_is_egr)
+			reg = PP_REG_RD32(UC_B_CCU_MAXCPU_REG(EGRESS));
+		else
+			reg = PP_REG_RD32(UC_B_CCU_MAXCPU_REG(INGRESS));
+	}
 
 	*max_cpus = PP_FIELD_GET(UC_CCU_MAXCPU_MSK, reg);
 
@@ -348,6 +300,8 @@ s32 uc_ccu_maxcpus_get(bool uc_is_egr, u8 *max_cpus)
 
 s32 uc_ccu_gpreg_get(bool uc_is_egr, u32 idx, u32 *gpreg)
 {
+	u64 reg;
+
 	if (unlikely(!uc_is_cluster_valid(uc_is_egr)))
 		return -EPERM;
 
@@ -361,16 +315,27 @@ s32 uc_ccu_gpreg_get(bool uc_is_egr, u32 idx, u32 *gpreg)
 	}
 
 	/* read ccu gpreg */
-	if (uc_is_egr)
-		*gpreg = PP_REG_RD32(UC_CCU_GPREG_REG(EGRESS, idx));
-	else
-		*gpreg = PP_REG_RD32(UC_CCU_GPREG_REG(INGRESS, idx));
+	if (pp_silicon_step_get() == PP_SSTEP_A) {
+		if (uc_is_egr)
+			reg = UC_A_CCU_GPREG_REG(EGRESS, idx);
+		else
+			reg = UC_A_CCU_GPREG_REG(INGRESS, idx);
+	} else {
+		if (uc_is_egr)
+			reg = UC_B_CCU_GPREG_REG(EGRESS, idx);
+		else
+			reg = UC_B_CCU_GPREG_REG(INGRESS, idx);
+	}
+
+	*gpreg = PP_REG_RD32(reg);
 
 	return 0;
 }
 
 s32 uc_ccu_gpreg_set(bool uc_is_egr, u32 idx, u32 gpreg_val)
 {
+	u64 reg;
+
 	if (unlikely(!uc_is_cluster_valid(uc_is_egr)))
 		return -EPERM;
 
@@ -381,16 +346,27 @@ s32 uc_ccu_gpreg_set(bool uc_is_egr, u32 idx, u32 gpreg_val)
 	}
 
 	/* write ccu gpreg */
-	if (uc_is_egr)
-		PP_REG_WR32(UC_CCU_GPREG_REG(EGRESS, idx), gpreg_val);
-	else
-		PP_REG_WR32(UC_CCU_GPREG_REG(INGRESS, idx), gpreg_val);
+	if (pp_silicon_step_get() == PP_SSTEP_A) {
+		if (uc_is_egr)
+			reg = UC_A_CCU_GPREG_REG(EGRESS, idx);
+		else
+			reg = UC_A_CCU_GPREG_REG(INGRESS, idx);
+	} else {
+		if (uc_is_egr)
+			reg = UC_B_CCU_GPREG_REG(EGRESS, idx);
+		else
+			reg = UC_B_CCU_GPREG_REG(INGRESS, idx);
+	}
+
+	PP_REG_WR32(reg, gpreg_val);
 
 	return 0;
 }
 
 s32 uc_ccu_irr_get(bool uc_is_egr, u32 *irr_bitmap)
 {
+	u64 reg;
+
 	if (unlikely(!uc_is_cluster_valid(uc_is_egr)))
 		return -EPERM;
 
@@ -398,43 +374,23 @@ s32 uc_ccu_irr_get(bool uc_is_egr, u32 *irr_bitmap)
 		return -EINVAL;
 
 	/* read interrupt request register */
-	if (uc_is_egr)
-		*irr_bitmap = PP_REG_RD32(UC_CCU_IRR_REG(EGRESS));
-	else
-		*irr_bitmap = PP_REG_RD32(UC_CCU_IRR_REG(INGRESS));
-
-	return 0;
-}
-
-s32 uc_ccu_ier_get(bool uc_is_egr, u32 *ier_bitmap)
-{
-	if (unlikely(!uc_is_cluster_valid(uc_is_egr)))
-		return -EPERM;
-
-	if (unlikely(ptr_is_null(ier_bitmap)))
-		return -EINVAL;
+	if (pp_silicon_step_get() == PP_SSTEP_A) {
+		if (uc_is_egr)
+			reg = UC_A_CCU_IRR_REG(EGRESS);
+		else
+			reg = UC_A_CCU_IRR_REG(INGRESS);
+	} else {
+		if (uc_is_egr)
+			reg = UC_B_CCU_IRR_REG(EGRESS);
+		else
+			reg = UC_B_CCU_IRR_REG(INGRESS);
+	}
 
-	/* read interrupt enable register */
-	if (uc_is_egr)
-		*ier_bitmap = PP_REG_RD32(UC_CCU_IER_REG(EGRESS));
-	else
-		*ier_bitmap = PP_REG_RD32(UC_CCU_IER_REG(INGRESS));
+	*irr_bitmap = PP_REG_RD32(reg);
 
 	return 0;
 }
 
-void uc_ccu_ier_set(bool uc_is_egr, u32 ier_bitmap)
-{
-	if (unlikely(!uc_is_cluster_valid(uc_is_egr)))
-		return;
-
-	/* enable uc_error interrupt */
-	if (uc_is_egr)
-		PP_REG_WR32(UC_CCU_IER_REG(EGRESS), ier_bitmap);
-	else
-		PP_REG_WR32(UC_CCU_IER_REG(INGRESS), ier_bitmap);
-}
-
 void uc_ccu_enable_set(bool uc_is_egr, u32 cid, bool enable)
 {
 	u32 val = enable ? UC_TURN_ON_VAL : 0;
@@ -442,16 +398,30 @@ void uc_ccu_enable_set(bool uc_is_egr, u32 cid, bool enable)
 	if (unlikely(!uc_is_cpu_valid(uc_is_egr, cid)))
 		return;
 
-	if (uc_is_egr) {
-		/* take the uc in/out of reset */
-		PP_REG_WR32(UC_CCU_UC_UNRESET_REG(EGRESS, cid), val);
-		/* enable/disable the uc clock */
-		PP_REG_WR32(UC_CCU_UC_CLK_EN_REG(EGRESS, cid), val);
+	if (pp_silicon_step_get() == PP_SSTEP_A) {
+		if (uc_is_egr) {
+			/* take the uc in/out of reset */
+			PP_REG_WR32(UC_A_CCU_UC_UNRESET_REG(EGRESS, cid), val);
+			/* enable/disable the uc clock */
+			PP_REG_WR32(UC_A_CCU_UC_CLK_EN_REG(EGRESS, cid), val);
+		} else {
+			/* take the uc in/out of reset */
+			PP_REG_WR32(UC_A_CCU_UC_UNRESET_REG(INGRESS, cid), val);
+			/* enable/disable the uc clock */
+			PP_REG_WR32(UC_A_CCU_UC_CLK_EN_REG(INGRESS, cid), val);
+		}
 	} else {
-		/* take the uc in/out of reset */
-		PP_REG_WR32(UC_CCU_UC_UNRESET_REG(INGRESS, cid), val);
-		/* enable/disable the uc clock */
-		PP_REG_WR32(UC_CCU_UC_CLK_EN_REG(INGRESS, cid), val);
+		if (uc_is_egr) {
+			/* take the uc in/out of reset */
+			PP_REG_WR32(UC_B_CCU_UC_UNRESET_REG(EGRESS, cid), val);
+			/* enable/disable the uc clock */
+			PP_REG_WR32(UC_B_CCU_UC_CLK_EN_REG(EGRESS, cid), val);
+		} else {
+			/* take the uc in/out of reset */
+			PP_REG_WR32(UC_B_CCU_UC_UNRESET_REG(INGRESS, cid), val);
+			/* enable/disable the uc clock */
+			PP_REG_WR32(UC_B_CCU_UC_CLK_EN_REG(INGRESS, cid), val);
+		}
 	}
 
 	__uc_cpu_active_set(uc_is_egr, cid, enable);
@@ -471,91 +441,6 @@ void uc_run_set(bool uc_is_egr, u32 cid, bool enable)
 		PP_REG_WR32(UC_BOOT_CORE_RUN_REG(INGRESS, cid), val);
 }
 
