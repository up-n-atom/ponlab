+
+	DP_LIB_LOCK(&dp_lock);
+
+	port_info = get_dp_port_info(conf->inst, conf->info.info.dpid);
+	if (!port_info) {
+		DP_LIB_UNLOCK(&dp_lock);
+		pr_err("Wrong dpid %d\n", conf->info.info.dpid);
