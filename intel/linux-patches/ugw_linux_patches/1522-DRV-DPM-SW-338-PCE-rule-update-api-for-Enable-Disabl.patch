-/* Add a new pce rule, If new vlan FID is created
- * If PCE index exists already for a BP, Enable the previously added rule index
- */
-static int dp_add_vlan_pce_rule(struct vlan_entry *ventry,
-				struct br_info *br_info, int bport)
-{
-	int ret = DP_SUCCESS;
-	struct pce_entry *pce_entry = NULL;
-	struct bridge_member_port *bmp = NULL;
-	struct vlist_entry *list_entry = NULL;
-
-	/* Go through all the Bridge Port members
-	 * check if vlan id present in bridge port ventry list
-	 */
-	list_for_each_entry(bmp, &br_info->bp_list, list) {
-		list_for_each_entry(list_entry, &bmp->bport_vlan_list, list) {
-			if (ventry->vlan_id != list_entry->vlan_entry->vlan_id)
-				continue;
-
-			/* First time when PCE list is empty */
-			if (list_empty(&bmp->pce_list))
-				goto ADD_NEW_PCE_RULE;
-
-			/* VLAN entry is there but no PCE rule yet, add it */
-			pce_entry = get_vlan_pce_entry_in_bp(ventry, bmp);
-			if (!pce_entry)
-				goto ADD_NEW_PCE_RULE;
-
-			/* Vlan Entry + PCE rule present, but rule disabled */
-			if (pce_entry->disable) {
-				DP_DEBUG(DP_DBG_FLAG_BR_VLAN,
-					 "%s: %s Bport %d vlanid %d\n",
-					 __func__,
-					 "Enabling PCE rule for",
-					 bmp->bportid,
-					 ventry->vlan_id);
-				dp_update_pce_rule(pce_entry->idx,
-						   bmp->blk_info,
-						   0);
-				pce_entry->disable = 0;
-			}
-			continue;
-			
-ADD_NEW_PCE_RULE:
-			DP_DEBUG(DP_DBG_FLAG_BR_VLAN,
-				 "%s: Creating PCE rule Bport %d vlanid %d\n",
-				 __func__,
-				 bmp->bportid,
-				 ventry->vlan_id);
-
-			/* It's a new pce rule for this bridge port add it */
-			if (dp_add_pce_entry_to_bp_list(list_entry->vlan_entry,
-							br_info, bmp))
-				return DP_FAILURE;
-		}
-	}
-	return ret;
-}
