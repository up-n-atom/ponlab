 drivers/net/datapath/dpm/datapath_swdev.c        |   42 +-
 drivers/net/datapath/dpm/datapath_swdev.h        |   13 +-
 drivers/net/datapath/dpm/gswip31/datapath_misc.c |    3 +-
 include/net/datapath_api.h                       |   21 +
 include/net/datapath_inst.h                      |    2 +
 10 files changed, 1490 insertions(+), 1290 deletions(-)

