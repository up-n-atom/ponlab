From fd6695d6822ecf461a9abb028094da731654753d Mon Sep 17 00:00:00 2001
From: Elad Fernandes <elad.fernandes@intel.com>
Date: Sun, 8 Nov 2020 18:01:38 +0200
Subject: [PATCH] LMTSYS-4247: [PPV4] Fixing the PPv4 trimmed debugfs output

---
 drivers/net/ppv4/pp-headers/pp_common.h | 14 ++++++++++----
 1 file changed, 10 insertions(+), 4 deletions(-)

diff --git a/drivers/net/ppv4/pp-headers/pp_common.h b/drivers/net/ppv4/pp-headers/pp_common.h
index 2f8e49b6a775..20d18f7a5537 100644
--- a/drivers/net/ppv4/pp-headers/pp_common.h
+++ b/drivers/net/ppv4/pp-headers/pp_common.h
@@ -2,7 +2,7 @@
  * Description: PP common definitions
  *
  * SPDX-License-Identifier: GPL-2.0-only
- * Copyright (C) 2018-2019 Intel Corporation
+ * Copyright (C) 2018-2020 Intel Corporation
  */
 
 #ifndef __PP_COMMON_H_
@@ -616,7 +616,10 @@ static inline bool __ptr_is_null(const void *ptr, const char *name,
  * @param fmt format string
  */
 #define pr_buf(buf, len, n, fmt, ...) \
-	(n = scnprintf(buf, len, fmt, ##__VA_ARGS__))
+	do {                                                                   \
+		n = snprintf(buf, len, fmt, ##__VA_ARGS__);                    \
+		n = min_t(int, n, len);                                        \
+	} while (0)
 
 /**
  * @define Shortcut macro for appending formatted string into a
@@ -627,8 +630,11 @@ static inline bool __ptr_is_null(const void *ptr, const char *name,
  * @param n characters written to 'buf' counter excluding trailing
  *          '\0'
  */
-#define pr_buf_cat(buf, len, n, fmt, ...) \
-	(n += scnprintf((buf) + (n), (len) - (n), fmt, ##__VA_ARGS__))
+#define pr_buf_cat(buf, len, n, fmt, ...)                                      \
+	do {                                                                   \
+		n += snprintf((buf) + (n), (len) - (n), fmt, ##__VA_ARGS__);   \
+		n = min_t(int, n, len);                                        \
+	} while (0)
 
 /**
  * @brief Find array's next entry which meet a specified condition
