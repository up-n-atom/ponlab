From a43a1a35214a5596a3253458e8d6dbf7d01e0892 Mon Sep 17 00:00:00 2001
From: Oren Bakshe <oren.bakshe@intel.com>
Date: Tue, 8 Sep 2020 16:00:11 +0300
Subject: [PATCH] PONRTSYS-7979: fixed max_burst accesses (was moved to
 common_prop struct)

---
 drivers/net/datapath/dpm/gswip31/datapath_ppv4.c | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/drivers/net/datapath/dpm/gswip31/datapath_ppv4.c b/drivers/net/datapath/dpm/gswip31/datapath_ppv4.c
index eb9ec414f583..10a335597111 100644
--- a/drivers/net/datapath/dpm/gswip31/datapath_ppv4.c
+++ b/drivers/net/datapath/dpm/gswip31/datapath_ppv4.c
@@ -14,6 +14,8 @@ void dp_print_sched_conf(const struct pp_qos_sched_conf *conf)
 		conf->common_prop.bandwidth_limit);
 	pr_info("shared_bw_grp         %x\n",
 		conf->common_prop.shared_bw_group);
+	pr_info("max_burst             %x\n",
+		conf->common_prop.max_burst);
 
 	pr_info("=====Parent Node properties====\n");
 	pr_info("best_effort_enable    %x\n",
@@ -43,6 +45,8 @@ void dp_print_port_conf(const struct pp_qos_port_conf *conf)
 		conf->common_prop.bandwidth_limit);
 	pr_info("shared_bw_grp         %x\n",
 		conf->common_prop.shared_bw_group);
+	pr_info("max_burst             %x\n",
+		conf->common_prop.max_burst);
 
 	pr_info("=====Parent Node properties====\n");
 	pr_info("best_effort_enable    %x\n",
@@ -71,6 +75,8 @@ void dp_print_queue_conf(const struct pp_qos_queue_conf *conf)
 		conf->common_prop.bandwidth_limit);
 	pr_info("shared_bw_grp         %x\n",
 		conf->common_prop.shared_bw_group);
+	pr_info("max_burst             %x\n",
+		conf->common_prop.max_burst);
 
 	pr_info("=====Child Node properties====\n");
 	pr_info("parent	               %x\n", conf->queue_child_prop.parent);
@@ -78,7 +84,6 @@ void dp_print_queue_conf(const struct pp_qos_queue_conf *conf)
 	pr_info("bandwidth_share       %x\n",
 		conf->queue_child_prop.wrr_weight);
 
-	pr_info("max_burst                   %x\n", conf->max_burst);
 	pr_info("blocked                     %x\n", conf->blocked);
 	pr_info("wred_enable                 %x\n", conf->wred_enable);
 	pr_info("wred_fixed_drop_prob_enable %x\n",
