-	else
-		reg = PP_FIELD_PREP(UC_CLUSTERBRIDGE_FAT_MSK, 0);
-
-	/* enable/disable the bridge fat */
+	/* enable/disable the cluster bridge fat */
 	if (pp_silicon_step_get() == PP_SSTEP_A) {
+		val |= enable << UC_A_FAT_EN_BIT_SHIFT;
