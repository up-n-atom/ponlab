+		} else {
+			PP_REG_WR32(UC_B_CLUSTERBRIDGE_VALID(INGRESS, ent), enable);
+			if (ent < UC_B_FAT_MAX_ENT ) {
+				PP_REG_WR32(UC_B_CLUSTERBRIDGE_FAT(INGRESS, ent), val);
+			} else {
+				ent -= UC_B_FAT_MAX_ENT;
