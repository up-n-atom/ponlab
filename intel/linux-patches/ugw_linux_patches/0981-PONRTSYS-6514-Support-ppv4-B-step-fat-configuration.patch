+				reg = UC_B_CLUSTERBRIDGE_BASE(INGRESS, ent);
+				*val = PP_REG_RD32(reg);
+			}
+		}
 	}
 
-	*val = PP_FIELD_GET(UC_CLUSTERBRIDGE_FAT_MSK, PP_REG_RD32(reg));
-
 	return 0;
