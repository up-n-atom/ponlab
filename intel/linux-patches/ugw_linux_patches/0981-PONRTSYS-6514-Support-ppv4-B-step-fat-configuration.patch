+			if (ent < UC_B_FAT_MAX_ENT ) {
+				reg = UC_B_CLUSTERBRIDGE_FAT(EGRESS, ent);
+				*val = PP_FIELD_GET(UC_B_FAT_VAL_MSK,
+						    PP_REG_RD32(reg));
+			} else {
+				ent -= UC_B_FAT_MAX_ENT;
+				reg = UC_B_CLUSTERBRIDGE_BASE(EGRESS, ent);
+				*val = PP_REG_RD32(reg);
