 		if (uc_is_egr)
 			reg = UC_A_CLUSTERBRIDGE_FAT(EGRESS, ent);
 		else
 			reg = UC_A_CLUSTERBRIDGE_FAT(INGRESS, ent);
+		*val = PP_FIELD_GET(UC_A_FAT_VAL_MSK, PP_REG_RD32(reg));
+		*enable = PP_FIELD_GET(UC_A_FAT_EN_MSK, PP_REG_RD32(reg));
 	} else {
-		/* TBD */
-		return 0;
