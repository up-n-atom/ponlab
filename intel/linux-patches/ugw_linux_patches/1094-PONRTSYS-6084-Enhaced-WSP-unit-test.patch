+static int enhanced_wsp_test(void *data)
+{
+	struct pp_qos_dev *qdev;
+	struct pp_qos_port_conf confp;
+	struct pp_qos_queue_conf confq;
+	u32 port_idx, queue_id, queue_idx, port[3], queue[24];
+	u32 test_ret = PP_UT_FAIL;
+
+	qdev = qos_restart(PP_QOS_INSTANCE_ID);
+	if (!qdev)
+		return PP_UT_FAIL;
+
+	if (!qdev->init_params.enhanced_wsp)
+		return PP_UT_PASS;
+
+	pp_qos_port_conf_set_default(&confp);
+	confp.port_parent_prop.arbitration = PP_QOS_ARBITRATION_WSP;
+	confp.ring_size = 1;
+	confp.enhanced_wsp = 1;
+
+	pp_qos_queue_conf_set_default(&confq);
+	confq.wred_max_allowed = 0x400;
+
+	/* add 3 ports, each has 8 queues */
+	for (port_idx = 0; port_idx < 3; port_idx++) {
+		pp_qos_port_allocate(qdev, ALLOC_PORT_ID, &port[port_idx]);
+		confp.ring_address = ring_addr_phys[port_idx];
+		pp_qos_port_set(qdev, port[port_idx], &confp);
+
+		confq.queue_child_prop.parent = port[port_idx];
+		for (queue_idx = 0; queue_idx < 8; queue_idx++) {
+			queue_id = (port_idx * 8) + queue_idx;
+			pp_qos_queue_allocate(qdev, &queue[queue_id]);
+			confq.queue_child_prop.priority = queue_idx;
+			pp_qos_queue_set(qdev, queue[queue_id], &confq);
+		}
+	}
+
+	/* Make sure only 12 ewsp queues are allocated */
+	PPUT_FAIL_RETURN(qdev->ewsp_cfg.num_queues == 12,
+			 "expected 12 ewsp queues, found %u\n",
+			 qdev->ewsp_cfg.num_queues);
+
+	/* Make sure only first 2 ports are assigned with 6 ewsp queues each */
+	for (queue_idx = 0; queue_idx < 24; queue_idx++) {
+		if ((queue_idx >= 0 && queue_idx <= 5) ||
+		    (queue_idx >= 8 && queue_idx <= 13)) {
+			PPUT_FAIL_RETURN(is_q_ewsp(qdev, queue[queue_idx]),
+					"Queue %u should be ewsp\n",
+					queue[queue_idx]);
+		} else {
+			PPUT_FAIL_RETURN(!is_q_ewsp(qdev, queue[queue_idx]),
+					"Queue %u should not be ewsp\n",
+					queue[queue_idx]);
+		}
+	}
+
+	/* Remove first queue, verify 3rd port is assigned with 1 ewsp queue */
+	pp_qos_queue_remove(qdev, queue[0]);
+	for (queue_idx = 1; queue_idx < 24; queue_idx++) {
+		if ((queue_idx >= 1 && queue_idx <= 5) ||
+		    (queue_idx >= 8 && queue_idx <= 13) ||
+		    (queue_idx == 16)) {
+			PPUT_FAIL_RETURN(is_q_ewsp(qdev, queue[queue_idx]),
+					"Queue %u should be ewsp\n",
+					queue[queue_idx]);
+		} else {
+			PPUT_FAIL_RETURN(!is_q_ewsp(qdev, queue[queue_idx]),
+					"Queue %u should not be ewsp\n",
+					queue[queue_idx]);
+		}
+	}
+
+	/* Remove 8th queue, verify 3rd port is assigned with 2 ewsp queue */
+	pp_qos_queue_remove(qdev, queue[7]);
+	for (queue_idx = 16; queue_idx < 24; queue_idx++) {
+		if (queue_idx >= 16 && queue_idx <= 17) {
+			PPUT_FAIL_RETURN(is_q_ewsp(qdev, queue[queue_idx]),
+					"Queue %u should be ewsp\n",
+					queue[queue_idx]);
+		} else {
+			PPUT_FAIL_RETURN(!is_q_ewsp(qdev, queue[queue_idx]),
+					"Queue %u should not be ewsp\n",
+					queue[queue_idx]);
+		}
+	}
+
+	/* Move priority 7 queue from 3rd port to 1st port */
+	pp_qos_queue_conf_get(qdev, queue[23], &confq);
+	confq.blocked = 1;
+	confq.queue_child_prop.parent = port[0];
+	queue[16] = queue[23];
+	pp_qos_queue_set(qdev, queue[23], &confq);
+	for (queue_idx = 1; queue_idx < 23; queue_idx++) {
+		if ((queue_idx >= 1 && queue_idx <= 5) ||
+		    (queue_idx >= 8 && queue_idx <= 13) ||
+		    (queue_idx == 16)) {
+			PPUT_FAIL_RETURN(is_q_ewsp(qdev, queue[queue_idx]),
+					"Queue %u should be ewsp\n",
+					queue[queue_idx]);
+		} else {
+			PPUT_FAIL_RETURN(!is_q_ewsp(qdev, queue[queue_idx]),
+					"Queue %u should not be ewsp\n",
+					queue[queue_idx]);
+		}
+	}
+	test_ret = PP_UT_PASS;
+
+	DUMP_QOS_TREE(qdev);
+	for (port_idx = 0; port_idx < 3; port_idx++)
+		pp_qos_port_remove(qdev, port[port_idx]);
+
+#ifdef FW_CHECK_SYNC
+	if (check_sync_with_fw(qdev, true)) {
+		pr_err("DB not consistent with fw\n");
+		test_ret = PP_UT_FAIL;
+	}
+#endif
+
+	return test_ret;
+}
+
 static int bw_reconfiguration_test(void *data)
 {
 	struct pp_qos_dev *qdev;
