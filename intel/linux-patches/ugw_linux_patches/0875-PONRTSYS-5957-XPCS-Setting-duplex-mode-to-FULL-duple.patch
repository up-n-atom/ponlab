From 7616991c68729a10a7888048f1f7eef224bdc8ac Mon Sep 17 00:00:00 2001
From: Dinesh Sudham <dineshx.sudham@intel.com>
Date: Wed, 20 Nov 2019 13:28:35 +0800
Subject: [PATCH] PONRTSYS-5957: XPCS: Setting duplex mode to FULL duplex

---
 drivers/net/ethernet/lantiq/xpcs/xpcs.c | 10 ++--------
 1 file changed, 2 insertions(+), 8 deletions(-)

diff --git a/drivers/net/ethernet/lantiq/xpcs/xpcs.c b/drivers/net/ethernet/lantiq/xpcs/xpcs.c
index 1f01b70ca72e..a8e26060327e 100644
--- a/drivers/net/ethernet/lantiq/xpcs/xpcs.c
+++ b/drivers/net/ethernet/lantiq/xpcs/xpcs.c
@@ -1043,14 +1043,8 @@ int xpcs_ethtool_ksettings_get(struct device *dev,
 		cmd->base.speed = SPEED_1000;
 	else if (pdata->mode == TWOP5G_SGMII_MODE)
 		cmd->base.speed = SPEED_2500;
-	/* Get Duplex mode from MII Control Register*/
-	pdata->duplex = XPCS_RGRD_VAL(pdata, SR_MII_CTRL,
-				      DUPLEX_MODE);
-	if (likely(pdata->duplex))
-		/* 10G capable adapters only support DUPLEX_FULL */
-		cmd->base.duplex = DUPLEX_FULL;
-	else
-		cmd->base.duplex = DUPLEX_HALF;
+	/* USXGMII support only FULL duplex */
+	cmd->base.duplex = DUPLEX_FULL;
 	return 0;
 }
 EXPORT_SYMBOL(xpcs_ethtool_ksettings_get);
