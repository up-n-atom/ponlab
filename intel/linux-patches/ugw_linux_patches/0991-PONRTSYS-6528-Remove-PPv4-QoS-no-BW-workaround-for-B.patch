From a4005696f1925ba671202eb8147b5a5042a18223 Mon Sep 17 00:00:00 2001
From: ofirbitt <ofir1.bitton@intel.com>
Date: Sun, 26 Jan 2020 14:29:33 +0200
Subject: [PATCH] PONRTSYS-6528: Remove PPv4 QoS no BW workaround for B Step

---
 drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.c | 13 ++++++++++---
 1 file changed, 10 insertions(+), 3 deletions(-)

diff --git a/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.c b/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.c
index 209788828be9..cdf837ca9a03 100644
--- a/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.c
+++ b/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.c
@@ -17,6 +17,7 @@
 #include "pp_qos_fw.h"
 #include "pp_regs.h"
 #include "pp_qos_utils.h"
+#include "infra.h"
 
 #define QOS_INVALID_PRIORITY   0xF
 
@@ -2759,9 +2760,15 @@ static s32 set_common(struct pp_qos_dev *qdev,
 
 	if (node->bandwidth_limit != common->bandwidth_limit) {
 		new_bw = common->bandwidth_limit;
-		/* Use maximum bandwidth instead of using unlimited bw */
-		if (new_bw == QOS_NO_BANDWIDTH_LIMIT)
-			new_bw = qdev->hwconf.max_bw_limit_kbps;
+
+		/* Workaround for FLM and LGM Step-A */
+		if (!IS_ENABLED(CONFIG_PPV4_LGM) ||
+		    (IS_ENABLED(CONFIG_PPV4_LGM) &&
+		     pp_silicon_step_get() == PP_SSTEP_A)) {
+			/* Use maximum bw instead of using unlimited bw */
+			if (new_bw == QOS_NO_BANDWIDTH_LIMIT)
+				new_bw = qdev->hwconf.max_bw_limit_kbps;
+		}
 
 		if (new_bw != node->bandwidth_limit) {
 			node->bandwidth_limit = new_bw;
