From be75121ebe7bd94f78ef7e9049814b25ca1ad4ac Mon Sep 17 00:00:00 2001
From: thampan <joby.thampan@intel.com>
Date: Wed, 13 May 2020 11:27:49 +0800
Subject: [PATCH] DRV_DPM_SW-250: BugFix ReInserted packet getting dropped if
 PTP is enabled

---
 drivers/net/datapath/dpm/datapath_instance.c   |  2 +-
 drivers/net/datapath/dpm/gswip31/datapath_tx.c | 29 +++++++++++++-------------
 2 files changed, 16 insertions(+), 15 deletions(-)

diff --git a/drivers/net/datapath/dpm/datapath_instance.c b/drivers/net/datapath/dpm/datapath_instance.c
index e95670fd0473..cb102322ac59 100644
--- a/drivers/net/datapath/dpm/datapath_instance.c
+++ b/drivers/net/datapath/dpm/datapath_instance.c
@@ -198,9 +198,9 @@ EXPORT_SYMBOL(pon_qos_setup_tc_fn);
 static int dp_ndo_setup_tc(struct net_device *dev, u32 handle,
 			   __be16 protocol, struct tc_to_netdev *tc)
 {
+#if IS_ENABLED(CONFIG_PON_QOS)
 	int ret = -1;
 
-#if IS_ENABLED(CONFIG_PON_QOS)
 	if (pon_qos_setup_tc_fn) {
 		ret = pon_qos_setup_tc_fn(dev, handle, protocol, tc, -1, -1);
 		if (!ret)
diff --git a/drivers/net/datapath/dpm/gswip31/datapath_tx.c b/drivers/net/datapath/dpm/gswip31/datapath_tx.c
index c9e74170f683..52e6c182bd55 100644
--- a/drivers/net/datapath/dpm/gswip31/datapath_tx.c
+++ b/drivers/net/datapath/dpm/gswip31/datapath_tx.c
@@ -267,20 +267,8 @@ int32_t dp_xmit_31(struct net_device *rx_if, dp_subif_t *rx_subif,
 				pmac.record_id_msb = 1;
 			else
 				pmac.record_id_msb = 0;
-		} else {
-			DP_CB(inst, get_dma_pmac_templ)(TEMPL_NORMAL, &pmac,
-							desc_0, desc_1,
-							dp_info);
-		}
-
-#if IS_ENABLED(CONFIG_INTEL_DATAPATH_PTP1588)
-#if IS_ENABLED(CONFIG_INTEL_DATAPATH_PTP1588_SW_WORKAROUND)
-		if (dp_info->f_ptp)
-#else
-		if (dp_info->f_ptp &&
-		    (skb_shinfo(skb)->tx_flags & SKBTX_HW_TSTAMP))
-#endif
-		{
+		} else if (dp_info->f_ptp &&
+			   (skb_shinfo(skb)->tx_flags & SKBTX_HW_TSTAMP)) {
 			ops = dp_port_prop[inst].mac_ops[dp_info->port_id];
 			if (!ops) {
 				err_ret = DP_XMIT_PTP_ERR;
@@ -295,7 +283,20 @@ int32_t dp_xmit_31(struct net_device *rx_if, dp_subif_t *rx_subif,
 							desc_0, desc_1,
 							dp_info);
 			pmac.record_id_msb = rec_id;
+		} else {
+			DP_CB(inst, get_dma_pmac_templ)(TEMPL_NORMAL, &pmac,
+							desc_0, desc_1,
+							dp_info);
 		}
+#if IS_ENABLED(CONFIG_INTEL_DATAPATH_PTP1588)
+#if IS_ENABLED(CONFIG_INTEL_DATAPATH_PTP1588_SW_WORKAROUND)
+	/* For A-Step Prx300 there is a bug in PTP block,
+	 * To workaround this bug, we need to set PTP flag for all Tx packets
+	 * if PTP is enabled for this port, this is fixed in B-Step
+	 */
+	if (dp_info->f_ptp)
+		pmac.ptp = 1;
+#endif
 #endif
 
 	} else if (dp_info->alloc_flags & DP_F_FAST_DSL) { /*some with pmac*/
