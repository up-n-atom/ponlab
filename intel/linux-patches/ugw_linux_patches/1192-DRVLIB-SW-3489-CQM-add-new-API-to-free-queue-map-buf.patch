From 9a1f80e8058d328ea59f8fed5415a9eb44d3b3e8 Mon Sep 17 00:00:00 2001
From: Jack Ping CHNG <jack.ping.chng@linux.intel.com>
Date: Wed, 3 Jun 2020 19:56:08 +0800
Subject: [PATCH] DRVLIB_SW-3489: CQM add new API to free queue map buffer

- New API cbm_queue_map_buf_free()
---
 drivers/net/ethernet/lantiq/cqm/cbm_wrapper.c     | 7 +++++++
 drivers/net/ethernet/lantiq/cqm/cqm_common.h      | 1 +
 drivers/net/ethernet/lantiq/cqm/grx500/cbm.c      | 6 ++++++
 drivers/net/ethernet/lantiq/cqm/grx500/cbm_proc.c | 4 ++--
 drivers/net/ethernet/lantiq/cqm/prx300/cqm.c      | 6 ++++++
 include/net/lantiq_cbm_api.h                      | 8 ++++++++
 6 files changed, 30 insertions(+), 2 deletions(-)

diff --git a/drivers/net/ethernet/lantiq/cqm/cbm_wrapper.c b/drivers/net/ethernet/lantiq/cqm/cbm_wrapper.c
index e7a540e72b7f..5a8834f5499c 100644
--- a/drivers/net/ethernet/lantiq/cqm/cbm_wrapper.c
+++ b/drivers/net/ethernet/lantiq/cqm/cbm_wrapper.c
@@ -57,6 +57,13 @@ s32 cbm_queue_map_set(int cbm_inst, s32 queue_id,
 }
 EXPORT_SYMBOL(cbm_queue_map_set);
 
+void cbm_queue_map_buf_free(cbm_queue_map_entry_t *entries)
+{
+	if (g_cbm_ops && g_cbm_ops->cbm_queue_map_buf_free)
+		g_cbm_ops->cbm_queue_map_buf_free(entries);
+}
+EXPORT_SYMBOL(cbm_queue_map_buf_free);
+
 s32 cqm_qid2ep_map_set(int qid, int port)
 {
 	if (g_cbm_ops && g_cbm_ops->cqm_qid2ep_map_set)
diff --git a/drivers/net/ethernet/lantiq/cqm/cqm_common.h b/drivers/net/ethernet/lantiq/cqm/cqm_common.h
index 75dafc882318..0245b1a5d23a 100644
--- a/drivers/net/ethernet/lantiq/cqm/cqm_common.h
+++ b/drivers/net/ethernet/lantiq/cqm/cqm_common.h
@@ -111,6 +111,7 @@ struct cbm_ops {
 				 u32 flags);
 	s32 (*cbm_queue_map_set)(int cbm_inst, s32 queue_id,
 				 cbm_queue_map_entry_t *entry, u32 flags);
+	void (*cbm_queue_map_buf_free)(cbm_queue_map_entry_t *entry);
 	s32 (*cqm_qid2ep_map_get)(int qid, int *port);
 	s32 (*cqm_qid2ep_map_set)(int qid, int port);
 	s32 (*cqm_mode_table_get)(int cbm_inst, int *mode,
diff --git a/drivers/net/ethernet/lantiq/cqm/grx500/cbm.c b/drivers/net/ethernet/lantiq/cqm/grx500/cbm.c
index f85e5d623e9f..321223a56122 100644
--- a/drivers/net/ethernet/lantiq/cqm/grx500/cbm.c
+++ b/drivers/net/ethernet/lantiq/cqm/grx500/cbm.c
@@ -1467,6 +1467,11 @@ u32 flags
 	return CBM_SUCCESS;
 }
 
+void queue_map_buf_free(cbm_queue_map_entry_t *entries)
+{
+	kfree(entries);
+}
+
 /*CBM CPU Enqueue API
  */
 static int setup_desc(struct cbm_desc *desc, u32 data_ptr, u32 data_len,
@@ -5272,6 +5277,7 @@ static const struct cbm_ops l_cbm_ops = {
 	.cbm_build_skb = build_skb_grx500,
 	.cbm_queue_map_get = queue_map_get,
 	.cbm_queue_map_set = queue_map_set,
+	.cbm_queue_map_buf_free = queue_map_buf_free,
 	.cbm_setup_desc = setup_desc,
 	.cbm_get_dptr_scpu_egp_count = get_dptr_scpu_egp_count,
 	.cbm_get_wlan_umt_pid = get_wlan_umt_pid_grx500,
diff --git a/drivers/net/ethernet/lantiq/cqm/grx500/cbm_proc.c b/drivers/net/ethernet/lantiq/cqm/grx500/cbm_proc.c
index 0aa7dbbc93fc..b61fca9a8669 100644
--- a/drivers/net/ethernet/lantiq/cqm/grx500/cbm_proc.c
+++ b/drivers/net/ethernet/lantiq/cqm/grx500/cbm_proc.c
@@ -979,11 +979,11 @@ ssize_t cbm_qocc_test_steps(struct file *file, const char *buf,
 			cbm_queue_map_get(0, 28, &num_entries, &temp_entry, 0);
 			pr_info("num entries 28 %d\n", num_entries);
 			if (num_entries)
-				kfree(temp_entry);
+				cbm_queue_map_buf_free(temp_entry);
 			cbm_queue_map_get(0, 100, &num_entries, &temp_entry, 0);
 			pr_info("num entries 100 %d\n", num_entries);
 			if (num_entries)
-				kfree(temp_entry);
+				cbm_queue_map_buf_free(temp_entry);
 			break;
 		case 16:
 			cbm_dp_q_enable (0, 15, -1, 19, -1, 100000, 0, (CBM_Q_F_DISABLE | CBM_Q_F_FLUSH));
diff --git a/drivers/net/ethernet/lantiq/cqm/prx300/cqm.c b/drivers/net/ethernet/lantiq/cqm/prx300/cqm.c
index ea2c12f1723c..558ae717b18a 100644
--- a/drivers/net/ethernet/lantiq/cqm/prx300/cqm.c
+++ b/drivers/net/ethernet/lantiq/cqm/prx300/cqm.c
@@ -1277,6 +1277,11 @@ static s32 queue_map_set(int cbm_inst, s32 queue_id,
 }
 #endif
 
+void queue_map_buf_free(cbm_queue_map_entry_t *entries)
+{
+	kfree(entries);
+}
+
 void *cqm_get_enq_base(void)
 {
 	return cqm_ctrl->enq;
@@ -4086,6 +4091,7 @@ static const struct cbm_ops cqm_ops = {
 	.cbm_build_skb = build_skb_cqm,
 	.cbm_queue_map_get = queue_map_get,
 	.cbm_queue_map_set = queue_map_set,
+	.cbm_queue_map_buf_free = queue_map_buf_free,
 	.cqm_qid2ep_map_get = qid2ep_map_get,
 	.cqm_qid2ep_map_set = qid2ep_map_set,
 	.cqm_mode_table_get = mode_table_get,
diff --git a/include/net/lantiq_cbm_api.h b/include/net/lantiq_cbm_api.h
index 0d22f74dee60..540d7a33e94d 100644
--- a/include/net/lantiq_cbm_api.h
+++ b/include/net/lantiq_cbm_api.h
@@ -1301,6 +1301,14 @@ cbm_queue_map_get(
 	uint32_t flags
 	);
 
+/*! \brief	CBM Queue Map entries buffer free
+	\param[in] entries	pointer to Queue map structure
+*/
+void
+cbm_queue_map_buf_free(
+	cbm_queue_map_entry_t *entries
+	);
+
 /*! \brief	CBM Mode table entry/entries Set
 	\param[in] entry	 pointer to mode structure (only ep, mpe1, mpe2, mode fields are setup)
 	\param[in] flags : Flags that qualify the Mapping mechanism
