diff --git a/drivers/net/ppv4/Kconfig b/drivers/net/ppv4/Kconfig
index 3833d6fe5b4b..97082d774c21 100644
--- a/drivers/net/ppv4/Kconfig
+++ b/drivers/net/ppv4/Kconfig
@@ -7,6 +7,13 @@ config PPV4
 	---help---
 	  Packet Processor V4 Driver
 
+config PPV4_LGM
+	bool "Packet Processor V4 for LGM"
+	depends on PPV4
+	default n
+	---help---
+	  Packet Processor V4 Driver for LGM
+
 config PPV4_UT
 	bool "Packet Processor V4 Unit test"
 	depends on PPV4
diff --git a/drivers/net/ppv4/Makefile b/drivers/net/ppv4/Makefile
index f390c38452f8..ee552f7a9dfa 100644
--- a/drivers/net/ppv4/Makefile
+++ b/drivers/net/ppv4/Makefile
@@ -57,7 +57,7 @@ $(TARGET)-$(CONFIG_OF) += pp-dev/pp_dts.o
 $(TARGET)-$(CONFIG_PPV4_FPGA) += pp-dev/pp_fpga.o
 
 ### TOOLS ###
-ifeq ($(CONFIG_PHY_INTEL_COMBO_LGM),y)
+ifeq ($(CONFIG_PPV4_LGM),y)
 # PP logger
 $(TARGET)-y += pp-tools/logger/pp_logger.o
 $(TARGET)-$(CONFIG_DEBUG_FS) += pp-tools/logger/pp_logger_debugfs.o
@@ -71,7 +71,7 @@ $(TARGET)-y += pp-tools/debugfs/pp_debugfs_common.o
 
 ### HAL ###
 # PP infra
-ifeq ($(CONFIG_PHY_INTEL_COMBO_LGM),y)
