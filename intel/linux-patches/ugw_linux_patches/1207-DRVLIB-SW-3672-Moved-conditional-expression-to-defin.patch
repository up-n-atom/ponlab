From 7c7b233b7aa6eed2bc1cde0d5aaf134ab9b3dd70 Mon Sep 17 00:00:00 2001
From: arathinx <ayyappanx.rathinam@intel.com>
Date: Mon, 8 Jun 2020 15:16:54 +0800
Subject: [PATCH] DRVLIB_SW-3672: Moved conditional expression to define

---
 drivers/net/ethernet/lantiq/cqm/prx300/cqm.c        | 3 +--
 drivers/net/ethernet/lantiq/cqm/prx300/cqm_config.h | 1 +
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/drivers/net/ethernet/lantiq/cqm/prx300/cqm.c b/drivers/net/ethernet/lantiq/cqm/prx300/cqm.c
index 1a7fe456b19b..38c17047fe6f 100644
--- a/drivers/net/ethernet/lantiq/cqm/prx300/cqm.c
+++ b/drivers/net/ethernet/lantiq/cqm/prx300/cqm.c
@@ -3277,7 +3277,6 @@ static int init_cqm_basic(struct platform_device *pdev)
 {
 	int tmp_v;
 	u32 version;
-	int frm_size_bit = (CQM_SRAM_FRM_SIZE == 128) ? 0 : 1;
 	int size;
 	void *c_base = cqm_ctrl->cqm;
 
@@ -3292,7 +3291,7 @@ static int init_cqm_basic(struct platform_device *pdev)
 	/*Program the PBS bit to Select between
 	 *Internal Packet Buffer frame size of 128 Bytes or 2 KBytes
 	 */
-	set_val((c_base + CBM_CTRL), frm_size_bit, CBM_CTRL_PBSEL_MASK,
+	set_val((c_base + CBM_CTRL), CQM_SRAM_FRM_SIZE_BIT, CBM_CTRL_PBSEL_MASK,
 		CBM_CTRL_PBSEL_POS);
 
 	/*Enable trigger for ACA ports from EQM*/
diff --git a/drivers/net/ethernet/lantiq/cqm/prx300/cqm_config.h b/drivers/net/ethernet/lantiq/cqm/prx300/cqm_config.h
index 7c0aa4a62fc9..63d3d69bd15a 100644
--- a/drivers/net/ethernet/lantiq/cqm/prx300/cqm_config.h
+++ b/drivers/net/ethernet/lantiq/cqm/prx300/cqm_config.h
@@ -10,6 +10,7 @@
 #define CQM_QID2EP_DW_NUM	0x100
 #define CQM_SRAM_SIZE	0xC0000
 #define CQM_SRAM_FRM_SIZE 128
+#define CQM_SRAM_FRM_SIZE_BIT ((CQM_SRAM_FRM_SIZE == 128) ? 0 : 1)
 #define CQM_CPU_POOL_BUF_ALW_NUM	128
 #define CQM_SRAM_BASE	0x18D00000
 #define CQM_CPU_POOL 0
