From f099316f235c58feef0832eccf94149504754495 Mon Sep 17 00:00:00 2001
From: Xu Liang <liang.xu@intel.com>
Date: Tue, 21 Jul 2020 14:07:30 +0800
Subject: [PATCH] DRVLIB_SW-3752: ETH - fix macro to determine whether
 CONFIG_INTEL_E160 is enabled

---
 drivers/net/ethernet/lantiq/ltq_eth_drv_xrx500.c | 23 ++++++++++++++---------
 drivers/net/ethernet/lantiq/ltq_eth_drv_xrx500.h |  2 +-
 2 files changed, 15 insertions(+), 10 deletions(-)

diff --git a/drivers/net/ethernet/lantiq/ltq_eth_drv_xrx500.c b/drivers/net/ethernet/lantiq/ltq_eth_drv_xrx500.c
index a594cea81ac5..113183414128 100644
--- a/drivers/net/ethernet/lantiq/ltq_eth_drv_xrx500.c
+++ b/drivers/net/ethernet/lantiq/ltq_eth_drv_xrx500.c
@@ -1874,7 +1874,7 @@ xrx500_of_port(struct net_device *dev, struct device_node *port)
 	priv->hw->port_map[p->num] = priv->hw->num_devs;
 }
 
-#ifdef CONFIG_INTEL_E160
+#if IS_ENABLED(CONFIG_INTEL_E160)
 static int macsec_prepare(struct macsec_context *ctx, macsec_irq_handler_t ig,
 			  macsec_irq_handler_t eg)
 {
@@ -1902,13 +1902,18 @@ static void macsec_unprepare(struct macsec_context *ctx)
 
 	pr_debug("E160: Enter %s\n", __FUNCTION__);
 
-	if (!ctx || !ctx->netdev)
-		return -EINVAL;
+	if (!ctx || !ctx->netdev) {
+		pr_err("Invalid MACsec context: ctx %p, ctx->netdev %p\n",
+			ctx, ctx ? ctx->netdev : NULL);
+		return;
+	}
 
 	priv = netdev_priv(ctx->netdev);
 	ops = gsw_get_mac_ops(0, priv->xgmac_id);
-	if (!ops)
-		return -EINVAL;
+	if (!ops) {
+		pr_err("Failed in get ops from XGMAC %u\n", priv->xgmac_id);
+		return;
+	}
 
 	pr_debug("E160: Exit %s\n", __FUNCTION__);
 
@@ -2049,7 +2054,7 @@ static int ltq_eth_dev_reg(struct xrx500_hw *hw, u32 xgmac_id_param,
 			       __func__, eth_dev[i], err);
 				return -1;
 		}
-#ifdef CONFIG_INTEL_E160
+#if IS_ENABLED(CONFIG_INTEL_E160)
 		register_macsec(eth_dev[i]);
 #endif
 		num++;
@@ -2106,7 +2111,7 @@ static int ltq_eth_dev_dereg(int start, int end)
 		netif_stop_queue(dev);
 		priv = netdev_priv(dev);
 		priv->dp_port_id = DP_FAILURE;
-#ifdef CONFIG_INTEL_E160
+#if IS_ENABLED(CONFIG_INTEL_E160)
 		unregister_macsec(dev);
 #endif
 		unregister_netdev(dev);
@@ -2299,7 +2304,7 @@ static int xrx500_of_iface(struct xrx500_hw *hw, struct device_node *iface,
 	if (!register_netdev(hw->devs[hw->num_devs])) {
 		pr_debug("%s: priv->extra_subif = %d interface %s !\n",
 			 __func__, priv->extra_subif, name);
-#ifdef CONFIG_INTEL_E160
+#if IS_ENABLED(CONFIG_INTEL_E160)
 		register_macsec(hw->devs[hw->num_devs]);
 #endif
 	}
@@ -2614,7 +2619,7 @@ static void ltq_eth_drv_exit(struct platform_device *pdev)
 		}
 
 		priv->dp_port_id = DP_FAILURE;
-#ifdef CONFIG_INTEL_E160
+#if IS_ENABLED(CONFIG_INTEL_E160)
 		unregister_macsec(dev);
 #endif
 		unregister_netdev(dev);
diff --git a/drivers/net/ethernet/lantiq/ltq_eth_drv_xrx500.h b/drivers/net/ethernet/lantiq/ltq_eth_drv_xrx500.h
index 3c0fb7a26af0..6ace35096fd6 100644
--- a/drivers/net/ethernet/lantiq/ltq_eth_drv_xrx500.h
+++ b/drivers/net/ethernet/lantiq/ltq_eth_drv_xrx500.h
@@ -54,7 +54,7 @@ struct xrx500_hw {
  * This structure is used internal purpose
  */
 struct ltq_eth_priv {
-#ifdef CONFIG_INTEL_E160
+#if IS_ENABLED(CONFIG_INTEL_E160)
 	void *macsec_data;
 	struct mac_e160_ops e160_ops;
 #endif
