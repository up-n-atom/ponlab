From 8097fcbae065ccaff445e9b8c89b88eeb1f7865b Mon Sep 17 00:00:00 2001
From: avishalo <avi1.shalom@intel.com>
Date: Mon, 1 Jun 2020 19:29:26 +0300
Subject: [PATCH] PONRTSYS-7747: Remove checker statistics from global and pps
 commands

Signed-off-by: avishalo <avi1.shalom@intel.com>
---
 drivers/net/ppv4/pp-hal/checker/checker.c | 18 ++++++++++--------
 1 file changed, 10 insertions(+), 8 deletions(-)

diff --git a/drivers/net/ppv4/pp-hal/checker/checker.c b/drivers/net/ppv4/pp-hal/checker/checker.c
index 9b12a7da54b7..be437f196658 100644
--- a/drivers/net/ppv4/pp-hal/checker/checker.c
+++ b/drivers/net/ppv4/pp-hal/checker/checker.c
@@ -917,14 +917,16 @@ static void __chk_stats_get(struct chk_stats *stats)
 
 	memset(stats, 0, sizeof(struct chk_stats));
 
-	for (s_idx = 0 ; s_idx < CHK_NUM_EXCEPTION_SESSIONS ; s_idx++) {
-		chk_exception_stats_get(s_idx, &s_stats);
-		if (s_idx == CHK_DEFAULT_SESSION_ID) {
-			stats->dflt_session_byte_cnt += s_stats.bytes;
-			stats->dflt_session_pkt_cnt  += s_stats.packets;
-		} else {
-			stats->exception_byte_cnt += s_stats.bytes;
-			stats->exception_pkt_cnt  += s_stats.packets;
+	if (pp_silicon_step_get() != PP_SSTEP_A) {
+		for (s_idx = 0 ; s_idx < CHK_NUM_EXCEPTION_SESSIONS ; s_idx++) {
+			chk_exception_stats_get(s_idx, &s_stats);
+			if (s_idx == CHK_DEFAULT_SESSION_ID) {
+				stats->dflt_session_byte_cnt += s_stats.bytes;
+				stats->dflt_session_pkt_cnt  += s_stats.packets;
+			} else {
+				stats->exception_byte_cnt += s_stats.bytes;
+				stats->exception_pkt_cnt  += s_stats.packets;
+			}
 		}
 	}
 
