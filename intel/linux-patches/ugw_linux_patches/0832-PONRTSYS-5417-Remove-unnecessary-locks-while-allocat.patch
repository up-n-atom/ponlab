From 3948bc05f3be2413cc7381f89d807a3f8276999d Mon Sep 17 00:00:00 2001
From: ofirbitt <ofir1.bitton@intel.com>
Date: Tue, 15 Oct 2019 11:35:20 +0300
Subject: [PATCH] PONRTSYS-5417: Remove unnecessary locks while allocating
 memory

---
 .../net/ethernet/lantiq/ppv4/qos/pp_qos_common.h   |  4 ++--
 drivers/net/ethernet/lantiq/ppv4/qos/pp_qos_fw.c   | 12 +++++------
 drivers/net/ethernet/lantiq/ppv4/qos/pp_qos_main.c |  3 +--
 .../net/ethernet/lantiq/ppv4/qos/pp_qos_utils.c    | 23 ++++------------------
 4 files changed, 13 insertions(+), 29 deletions(-)

diff --git a/drivers/net/ethernet/lantiq/ppv4/qos/pp_qos_common.h b/drivers/net/ethernet/lantiq/ppv4/qos/pp_qos_common.h
index eeb058b4be9c..9ca160eb0c74 100644
--- a/drivers/net/ethernet/lantiq/ppv4/qos/pp_qos_common.h
+++ b/drivers/net/ethernet/lantiq/ppv4/qos/pp_qos_common.h
@@ -114,8 +114,8 @@ do { \
 
 /* Memory allocation */
 #ifdef __KERNEL__
-#define QOS_MALLOC(size)	vmalloc(size)
-#define QOS_FREE(p)		vfree(p)
+#define QOS_MALLOC(size)	kzalloc(size, GFP_KERNEL)
+#define QOS_FREE(p)		kfree(p)
 #else
 #define QOS_MALLOC(size)	malloc(size)
 #define QOS_FREE(p)		free(p)
diff --git a/drivers/net/ethernet/lantiq/ppv4/qos/pp_qos_fw.c b/drivers/net/ethernet/lantiq/ppv4/qos/pp_qos_fw.c
index aa0d6cb1e578..d5cdb6e76d7b 100644
--- a/drivers/net/ethernet/lantiq/ppv4/qos/pp_qos_fw.c
+++ b/drivers/net/ethernet/lantiq/ppv4/qos/pp_qos_fw.c
@@ -1477,12 +1477,12 @@ void add_suspend_port(struct pp_qos_dev *qdev, unsigned int port)
 
 int init_fwdata_internals(struct pp_qos_dev *qdev)
 {
-	qdev->fwbuf = QOS_MALLOC(sizeof(struct fw_internal));
-	if (qdev->fwbuf) {
-		memset(qdev->fwbuf, 0, sizeof(struct fw_internal));
-		return 0;
-	}
-	return -EBUSY;
+	qdev->fwbuf = kzalloc(sizeof(struct fw_internal), GFP_ATOMIC);
+
+	if (!qdev->fwbuf)
+		return -ENOMEM;
+
+	return 0;
 }
 
 void clean_fwdata_internals(struct pp_qos_dev *qdev)
diff --git a/drivers/net/ethernet/lantiq/ppv4/qos/pp_qos_main.c b/drivers/net/ethernet/lantiq/ppv4/qos/pp_qos_main.c
index 63a8897bd2c8..5bd8f6827702 100644
--- a/drivers/net/ethernet/lantiq/ppv4/qos/pp_qos_main.c
+++ b/drivers/net/ethernet/lantiq/ppv4/qos/pp_qos_main.c
@@ -28,6 +28,7 @@
 #include "pp_qos_utils.h"
 #include "pp_qos_fw.h"
 #include "pp_qos_drv.h"
+#include <linux/slab.h>
 
 #define PP_QOS_ENTER_FUNC()
 #define PP_QOS_EXIT_FUNC()
@@ -2472,7 +2473,6 @@ int pp_qos_dev_init(struct pp_qos_dev *qdev, struct pp_qos_init_param *conf)
 {
 	int rc;
 
-	QOS_LOCK(qdev);
 	PP_QOS_ENTER_FUNC();
 
 	if (qdev->initialized) {
@@ -2560,7 +2560,6 @@ int pp_qos_dev_init(struct pp_qos_dev *qdev, struct pp_qos_init_param *conf)
 
 	rc = 0;
 out:
-	QOS_UNLOCK(qdev);
 	QOS_LOG_DEBUG("pp_qos_dev_init completed with %d\n", rc);
 	return rc;
 }
diff --git a/drivers/net/ethernet/lantiq/ppv4/qos/pp_qos_utils.c b/drivers/net/ethernet/lantiq/ppv4/qos/pp_qos_utils.c
index ce6415a76b5e..79118311e365 100644
--- a/drivers/net/ethernet/lantiq/ppv4/qos/pp_qos_utils.c
+++ b/drivers/net/ethernet/lantiq/ppv4/qos/pp_qos_utils.c
@@ -373,15 +373,7 @@ struct cmd_queue {
 
 static struct cmd_queue *cmd_queue_init(void)
 {
-	struct cmd_queue *q;
-
-	q = QOS_MALLOC(sizeof(struct cmd_queue));
-	if (q) {
-		q->read = 0;
-		q->write = 0;
-		q->count = 0;
-	}
-	return q;
+	return QOS_MALLOC(sizeof(struct cmd_queue));
 }
 
 static void cmd_queue_clean(struct cmd_queue *q)
@@ -474,13 +466,7 @@ struct pp_nodes {
 
 static struct pp_nodes *pp_nodes_init(void)
 {
-	struct pp_nodes *nodes;
-
-	nodes = QOS_MALLOC(sizeof(struct pp_nodes));
-	if (nodes)
-		memset(nodes, 0, sizeof(struct pp_nodes));
-
-	return nodes;
+	return QOS_MALLOC(sizeof(struct pp_nodes));
 }
 
 unsigned int get_phy_from_node(const struct pp_nodes *nodes,
@@ -1582,7 +1568,6 @@ void _qos_init(unsigned int max_port, struct pp_qos_dev **qdev)
 
 	*qdev = QOS_MALLOC(sizeof(struct pp_qos_dev));
 	if (*qdev) {
-		memset(*qdev, 0, sizeof(struct pp_qos_dev));
 		(*qdev)->max_port = max_port;
 
 		if (qos_pools_init(*qdev, max_port))
@@ -3083,13 +3068,13 @@ void __dbg_dump_subtree(struct pp_qos_dev *qdev,
 		return;
 	}
 
-	tabs_str = kzalloc(PP_QOS_DBG_MAX_INPUT, GFP_KERNEL);
+	tabs_str = kzalloc(PP_QOS_DBG_MAX_INPUT, GFP_ATOMIC);
 	if (!tabs_str) {
 		QOS_LOG_ERR("Cannot allocate temp string\n");
 		return;
 	}
 
-	indent_str = kzalloc(PP_QOS_DBG_MAX_INPUT, GFP_KERNEL);
+	indent_str = kzalloc(PP_QOS_DBG_MAX_INPUT, GFP_ATOMIC);
 	if (!indent_str) {
 		QOS_LOG_ERR("Cannot allocate temp string\n");
 		kfree(tabs_str);
