From 381ff009aacd928570f109a4d97908d40e8af9f4 Mon Sep 17 00:00:00 2001
From: Oren Bakshe <oren.bakshe@intel.com>
Date: Wed, 30 Dec 2020 09:29:45 +0200
Subject: [PATCH] LMTSYS-4409: [LGM][PPV4] queues are stuck in suspend after
 removing the high prio queue eir

---
 drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_fw.c      | 1 +
 drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_uc_defs.h | 5 +++--
 drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.c   | 3 +++
 3 files changed, 7 insertions(+), 2 deletions(-)

diff --git a/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_fw.c b/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_fw.c
index 2e9d8c9d1b59..09628b0e78d4 100644
--- a/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_fw.c
+++ b/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_fw.c
@@ -1225,6 +1225,7 @@ void create_move_cmd(struct pp_qos_dev *qdev, u16 dst, u16 src, u16 dst_port)
 		queue_cmd.fw.dst = dst;
 		queue_cmd.fw.dst_port = dst_port;
 		queue_cmd.fw.rlm = node->data.queue.rlm;
+		queue_cmd.fw.is_alias = node->data.queue.is_alias;
 		fill_preds(qdev->nodes, dst, queue_cmd.fw.preds,
 			   QOS_MAX_PREDECESSORS);
 		cmd_queue_put(qdev->drvcmds.cmdq,
diff --git a/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_uc_defs.h b/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_uc_defs.h
index 4090fd1b103e..d10784149140 100644
--- a/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_uc_defs.h
+++ b/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_uc_defs.h
@@ -11,8 +11,8 @@
 
 /* UC version */
 #define UC_VERSION_MAJOR (1)
-#define UC_VERSION_MINOR (15)
-#define UC_VERSION_BUILD (2)
+#define UC_VERSION_MINOR (16)
+#define UC_VERSION_BUILD (0)
 
 #define QOS_MAX_PREDECESSORS        (6)
 #define QOS_AQM_CONTEXT_MAX_QUEUES  (8)
@@ -1005,6 +1005,7 @@ struct fw_cmd_move_queue {
 	u32 dst_port; /*! Dst Port */
 	u32 rlm; /*! Physical queue */
 	u32 preds[QOS_MAX_PREDECESSORS]; /*! Dst Node Predecessors */
+	u32 is_alias; /*! is_alias */
 } __attribute__((packed));
 
 struct fw_cmd_remove_queue {
diff --git a/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.c b/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.c
index e723dffd4040..250c7a3a6eef 100644
--- a/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.c
+++ b/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.c
@@ -4240,6 +4240,9 @@ static void qos_dbg_dump_subtree(struct pp_qos_dev *qdev, struct qos_node *node,
 		else
 			snprintf(indent_str, 64, "%s|-- ", tabs_str);
 
+		bw_str[0] = '\0';
+		weight_str[0] = '\0';
+		aqm_codel_str[0] = '\0';
 		if (node_sched(child)) {
 			if (child->bandwidth_limit)
 				snprintf(bw_str, 64, ", bw %u",
