From 00674c10d56a23ef903ad00f1bbf1eec37b1159d Mon Sep 17 00:00:00 2001
From: Xu Liang <liang.xu@intel.com>
Date: Fri, 13 Sep 2019 23:16:15 +0800
Subject: [PATCH] DRVLIB_SW-2887: GSW API - Fix PCE Rule entry index to HW
 index mapping. INVALID entry 0xFFFFFFFF is used to remove assignment to CTP.

---
 drivers/net/ethernet/lantiq/switch-api/gsw_debug.c |  16 +-
 .../net/ethernet/lantiq/switch-api/gsw_flow_core.c | 226 ++++++++++++---------
 .../net/ethernet/lantiq/switch-api/gsw_flow_core.h |  20 +-
 .../net/ethernet/lantiq/switch-api/gsw_flow_pce.c  |   2 +-
 .../net/ethernet/lantiq/switch-api/gsw_ll_func.h   |   8 +-
 drivers/net/ethernet/lantiq/switch-api/gsw_pae.c   |   6 +-
 include/net/switch_api/gsw_flow_ops.h              |   6 +-
 include/net/switch_api/lantiq_gsw.h                |  22 +-
 include/net/switch_api/lantiq_gsw_flow.h           |  41 ++--
 9 files changed, 177 insertions(+), 170 deletions(-)

diff --git a/drivers/net/ethernet/lantiq/switch-api/gsw_debug.c b/drivers/net/ethernet/lantiq/switch-api/gsw_debug.c
index 8491a90a5423..ff03a24a3b5c 100644
--- a/drivers/net/ethernet/lantiq/switch-api/gsw_debug.c
+++ b/drivers/net/ethernet/lantiq/switch-api/gsw_debug.c
@@ -1189,7 +1189,7 @@ GSW_return_t GSW_MacsecCfg(void *cdev, GSW_MAC_cfg_t *macsec_cfg)
 	return GSW_statusOk;
 }
 
-GSW_return_t gsw_debug_tflow_tablestatus(void *cdev, GSW_debug_t *parm)
+GSW_return_t GSW_Debug_PceRuleTableStatus(void *cdev, GSW_debug_t *parm)
 {
 	ethsw_api_dev_t *gswdev = GSW_PDATA_GET(cdev);
 	u32 i, blockid = 0;
@@ -1205,10 +1205,11 @@ GSW_return_t gsw_debug_tflow_tablestatus(void *cdev, GSW_debug_t *parm)
 		for (i = 0; i < gswdev->tftblsize; i++) {
 			if (gswdev->tflow_idx.flow_idx[i].indexinuse) {
 				blockid = gswdev->tflow_idx.flow_idx[i].tflowblockid;
-				pr_info("TFLOW Table Index  %d = InUse, Associated to TFLOW Block Id %d.\n",
+				pr_info("TFLOW Table Index %u = InUse, Associated to TFLOW Block Id %u.\n",
 					i, blockid);
 			}
 		}
+		pr_info("Total used entries = %u\n", gswdev->tflow_idx.usedentry);
 
 		return GSW_statusOk;
 	}
@@ -1217,16 +1218,15 @@ GSW_return_t gsw_debug_tflow_tablestatus(void *cdev, GSW_debug_t *parm)
 		gswdev->tflow_idx.flow_idx[parm->nTableIndex].indexinuse = 1;
 		gswdev->tflow_idx.flow_idx[parm->nTableIndex].tflowblockid = parm->nblockid;
 		gswdev->tflow_idx.usedentry++;
-		pr_info("TFLOW Table Index  %d is Forced to InUSe\n",
+		pr_info("TFLOW Table Index %u is Forced to InUse\n",
 			parm->nTableIndex);
 	} else {
-		pr_info("TFLOW  Table Index %d:\n\n",
-			parm->nTableIndex);
-		pr_info("BlockId						= %d\n",
+		pr_info("TFLOW  Table Index %u:\n\n", parm->nTableIndex);
+		pr_info("BlockId          = %u\n",
 			gswdev->tflow_idx.flow_idx[parm->nTableIndex].tflowblockid);
-		pr_info("IndexInUse					= %d\n",
+		pr_info("IndexInUse       = %u\n",
 			gswdev->tflow_idx.flow_idx[parm->nTableIndex].indexinuse);
-		pr_info("IndexInUsageCnt				= %d\n",
+		pr_info("IndexInUsageCnt  = %u\n",
 			gswdev->tflow_idx.flow_idx[parm->nTableIndex].indexinusagecnt);
 	}
 
diff --git a/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c b/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c
index 14f940078e25..2422ccc4d7aa 100644
--- a/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c
+++ b/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c
@@ -2600,7 +2600,8 @@ static void get_gsw_hw_cap(void *cdev)
 		gswdev->pce_tbl_info = gsw_pce_tbl_info_22;
 	}
 
-	if (IS_VRSN_31_OR_32(gswdev->gipver) && gswdev->num_of_bridge_port) {
+	if (VRSN_CMP(gswdev->gipver, LTQ_GSWIP_3_1) >= 0
+	    && gswdev->num_of_bridge_port) {
 		hitstatus = gswdev->num_of_bridge_port - 1;
 		u = hitstatus / (sizeof(gswdev->hitstatus_mask) * 8);
 		gswdev->hitstatus_idx = u;
@@ -3036,6 +3037,7 @@ static GSW_return_t switch_core_init(void *cdev)
 			gswdev->ctpportconfig_idx[j].IngressExVlanNonIgmpBlkId = EXVLAN_ENTRY_INVALID;
 			gswdev->ctpportconfig_idx[j].EgressExVlanIgmpBlkId = EXVLAN_ENTRY_INVALID;
 			gswdev->ctpportconfig_idx[j].EgressExVlanNonIgmpBlkId = EXVLAN_ENTRY_INVALID;
+			gswdev->ctpportconfig_idx[j].IngressTflowFirstIdx = TFLOW_ENTRY_INVALID;
 			memset(&ctp_config, 0, sizeof(GSW_CTP_portConfig_t));
 			ctp_config.nLogicalPortId = j;
 			ctp_config.nSubIfIdGroup = 0;
@@ -3063,6 +3065,7 @@ static GSW_return_t switch_core_init(void *cdev)
 			gswdev->ctpportconfig_idx[j].IngressExVlanNonIgmpBlkId = EXVLAN_ENTRY_INVALID;
 			gswdev->ctpportconfig_idx[j].EgressExVlanIgmpBlkId = EXVLAN_ENTRY_INVALID;
 			gswdev->ctpportconfig_idx[j].EgressExVlanNonIgmpBlkId = EXVLAN_ENTRY_INVALID;
+			gswdev->ctpportconfig_idx[j].IngressTflowFirstIdx = TFLOW_ENTRY_INVALID;
 
 			/*Same ctp port idx for ingress and egress ctp port configuration*/
 			memset(&tbl_prog_ctpport_ingress, 0, sizeof(pctbl_prog_t));
@@ -3282,12 +3285,12 @@ void *ethsw_api_core_init(ethsw_core_init_t *ethcinit)
 	pce_table_init(&PrvData->phandler);
 
 	if (!PrvData->num_of_global_rules) {
-		if (IS_VRSN_30_31_32(PrvData->gipver)) {
+		if (VRSN_CMP(PrvData->gipver, LTQ_GSWIP_3_0) >= 0) {
 			gsw_r32(cdev, PCE_TFCR_NUM_NUM_OFFSET,
 				PCE_TFCR_NUM_NUM_SHIFT,
 				PCE_TFCR_NUM_NUM_SIZE, &PrvData->num_of_global_rules);
 			PrvData->num_of_global_rules = PrvData->num_of_global_rules << 2;
-		} else if (IS_VRSN_BELOW_30(PrvData->gipver))
+		} else
 			PrvData->num_of_global_rules = PrvData->tftblsize;
 	}
 
@@ -3298,7 +3301,7 @@ void *ethsw_api_core_init(ethsw_core_init_t *ethcinit)
 		PrvData->tflow_idx.flow_idx[i].indexinusagecnt++;
 	}
 
-	if (IS_VRSN_30_31_32(PrvData->gipver)) {
+	if (VRSN_CMP(PrvData->gipver, LTQ_GSWIP_3_0) >= 0) {
 		/* First Entry of Common Region in TFLOW Table */
 		gsw_w32(cdev, PCE_TFCR_ID_INDEX_OFFSET, PCE_TFCR_ID_INDEX_SHIFT,
 			PCE_TFCR_ID_INDEX_SIZE, 0x0);
@@ -11022,7 +11025,7 @@ GSW_return_t GSW_MulticastSnoopCfgSet(void *cdev,
 				pcrule.pattern.nPortId = parm->nForwardPortId;
 			} else if (parm->eForwardPort == GSW_PORT_FORWARD_CPU) {
 
-				if (IS_VRSN_31_OR_32(gswdev->gipver)) {
+				if (VRSN_CMP(gswdev->gipver, LTQ_GSWIP_3_1) >= 0) {
 					pcrule.pattern.bInsertionFlag_Enable = 1;
 					pcrule.pattern.nInsertionFlag = 0;
 				}
@@ -11876,7 +11879,7 @@ GSW_return_t GSW_CapGet(void *cdev, GSW_cap_t *parm)
 		parm->nCap = gswdev->num_of_bridge_port;
 		break;
 
-	case GSW_CAP_TYPE_COMMON_TFLOW_RULES:
+	case GSW_CAP_TYPE_COMMON_PCE_RULES:
 		parm->nCap = gswdev->num_of_global_rules;
 		break;
 
@@ -18116,12 +18119,11 @@ GSW_return_t GSW_IrqStatusClear(void *cdev, GSW_irq_t *parm)
  */
 static GSW_return_t gsw_pcerulemanage(void *cdev, GSW_PCE_rule_t *parm)
 {
+	int ret;
 	ethsw_api_dev_t *gswdev = GSW_PDATA_GET(cdev);
-	u32 idx, firstidx, lastidx;
-	int ret = GSW_statusOk;
-	GSW_CTP_portConfig_t ctpget;
-	/*TFlow table index */
-	idx = parm->pattern.nIndex;
+	u32 idx, base, num;
+	u32 ctp_port;
+	GSW_CTP_portAssignment_t ctpget;
 
 	if (!gswdev) {
 		pr_err("%s:%s:%d", __FILE__, __func__, __LINE__);
@@ -18129,33 +18131,39 @@ static GSW_return_t gsw_pcerulemanage(void *cdev, GSW_PCE_rule_t *parm)
 	}
 
 	switch (parm->region) {
-	case GSW_TFLOW_COMMMON_REGION:
-		if (idx >= gswdev->num_of_global_rules) {
-			pr_err("\n\tERROR: Index %d is greater than common region Entries = %d\n",
-			       idx, gswdev->num_of_global_rules);
+	case GSW_PCE_RULE_COMMMON:
+		gsw_r32(cdev, PCE_TFCR_ID_INDEX_OFFSET, PCE_TFCR_ID_INDEX_SHIFT,
+			PCE_TFCR_ID_INDEX_SIZE, &base);
+		if (parm->pattern.nIndex >= gswdev->num_of_global_rules) {
+			pr_err("\n\tERROR: Index %u is greater than common region (%u entries) start at %u\n",
+			       parm->pattern.nIndex,
+			       gswdev->num_of_global_rules, base);
 			return GSW_statusErr;
 		}
-
+		idx = base + parm->pattern.nIndex;
 		break;
 
-	case GSW_TFLOW_CTP_REGION:
+	case GSW_PCE_RULE_CTP:
 		ctpget.nLogicalPortId = parm->logicalportid;
-		ctpget.nSubIfIdGroup = parm->subifidgroup;
-		ctpget.eMask =  GSW_CTP_PORT_CONFIG_FLOW_ENTRY;
-		GSW_CtpPortConfigGet(cdev, &ctpget);
-		firstidx = ctpget.nFirstFlowEntryIndex;
-		lastidx = ctpget.nFirstFlowEntryIndex + ctpget.nNumberOfFlowEntries;
-
-		if (idx < firstidx || idx >= lastidx) {
-			pr_err("\n\tERROR: Index %d is Didn't match CTP region Entries, StartEntryIndex = %d NumberofEntries = %d\n",
-			       idx, ctpget.nFirstFlowEntryIndex,
-				   ctpget.nNumberOfFlowEntries);
+		ret = GSW_CTP_PortAssignmentGet(cdev, &ctpget);
+		if (ret != GSW_statusOk)
+			return ret;
+		ctp_port = ctpget.nFirstCtpPortId + parm->subifidgroup;
+		if (!gswdev->ctpportconfig_idx[ctp_port].IngressTflowAssigned)
 			return GSW_statusErr;
-		}
+		base = gswdev->ctpportconfig_idx[ctp_port].IngressTflowFirstIdx;
+		num = gswdev->ctpportconfig_idx[ctp_port].IngressTflowNumberOfEntrys;
 
+		if (parm->pattern.nIndex >= num) {
+			pr_err("\n\tERROR: Index %u is not in CTP region (%u entries) start at %u\n",
+			       parm->pattern.nIndex, num, base);
+			return GSW_statusErr;
+		}
+		idx = base + parm->pattern.nIndex;
 		break;
 
-	case GSW_TFLOW_DEBUG:
+	case GSW_PCE_RULE_DEBUG:
+		idx = parm->pattern.nIndex;
 		PCE_ASSERT(idx >= (gswdev->tftblsize));
 		break;
 
@@ -18164,7 +18172,8 @@ static GSW_return_t gsw_pcerulemanage(void *cdev, GSW_PCE_rule_t *parm)
 		return GSW_statusErr;
 	}
 
-	return ret;
+	parm->pattern.nIndex = idx;
+	return GSW_statusOk;
 }
 
 GSW_return_t GSW_PceRuleRead(void *cdev, GSW_PCE_rule_t *parm)
@@ -24938,46 +24947,66 @@ GSW_return_t GSW_CtpPortConfigSet(void *cdev, GSW_CTP_portConfig_t *param)
 	}
 
 	if (param->eMask & GSW_CTP_PORT_CONFIG_FLOW_ENTRY) {
-		if (param->nFirstFlowEntryIndex > gswdev->tftblsize) {
-			ret = GSW_statusErr;
-			goto UNLOCK_AND_RETURN;
-		}
+		gsw_tflow_entry_t *pflow = gswdev->tflow_idx.flow_idx;
+		u32 idx;
 
-		/*Check whether this index is InUse
-		 *Since it will be marked as InUse during allocation.
-		 */
-		if (!gswdev->tflow_idx.flow_idx[param->nFirstFlowEntryIndex].indexinuse) {
-			ret = GSW_statusErr;
-			goto UNLOCK_AND_RETURN;
-		}
+		tbl_prog_ctpport_ingress.val[7] &= ~0x1FC;
+		tbl_prog_ctpport_ingress.val[8] &= ~0x3FC;
 
-		/*Check whether this index belongs to this BlockID
-		 *Since it will be marked during allocation.
-		 */
-		if (gswdev->tflow_idx.flow_idx[param->nFirstFlowEntryIndex].tflowblockid
-		    != param->nFirstFlowEntryIndex) {
-			ret = GSW_statusErr;
-			goto UNLOCK_AND_RETURN;
+		if (gswdev->ctpportconfig_idx[ctp_port].IngressTflowAssigned) {
+			idx = gswdev->ctpportconfig_idx[ctp_port].IngressTflowFirstIdx;
+
+			pflow[idx].indexinusagecnt--;
+			gswdev->ctpportconfig_idx[ctp_port].IngressTflowAssigned = 0;
+			gswdev->ctpportconfig_idx[ctp_port].IngressTflowFirstIdx = TFLOW_ENTRY_INVALID;
+			gswdev->ctpportconfig_idx[ctp_port].IngressTflowNumberOfEntrys = 0;
 		}
 
-		/*Search for the Last Index of this block.
-		 *Note: The Blocks are always allocated contiguously.
-		 */
-		ctplastidx = param->nFirstFlowEntryIndex;
+		if (param->nFirstFlowEntryIndex != ~0) {
+			idx = param->nFirstFlowEntryIndex;
 
-		while (gswdev->tflow_idx.flow_idx[ctplastidx].tflowblockid ==
-			   param->nFirstFlowEntryIndex &&
-			   gswdev->tflow_idx.flow_idx[ctplastidx].indexinuse) {
-			   ctplastidx++;
-		}
+			if (idx >= gswdev->tftblsize) {
+				ret = GSW_statusErr;
+				goto UNLOCK_AND_RETURN;
+			}
+
+			/*Check whether this index is InUse
+			 *Since it will be marked as InUse during allocation.
+			 */
+			if (!pflow[idx].indexinuse) {
+				ret = GSW_statusErr;
+				goto UNLOCK_AND_RETURN;
+			}
 
-		param->nNumberOfFlowEntries = ctplastidx - param->nFirstFlowEntryIndex;
-		gswdev->tflow_idx.flow_idx[param->nFirstFlowEntryIndex].indexinuse = 1;
-		gswdev->tflow_idx.flow_idx[param->nFirstFlowEntryIndex].indexinusagecnt++;
-		tbl_prog_ctpport_ingress.val[7] &= ~(0x7F << 2);
-		tbl_prog_ctpport_ingress.val[7] |= (param->nFirstFlowEntryIndex & 0x1FC);
-		tbl_prog_ctpport_ingress.val[8] &= ~(0xFF << 2);
-		tbl_prog_ctpport_ingress.val[8] |= (param->nNumberOfFlowEntries & 0x3FC);
+			/*Check whether this index belongs to this BlockID
+			 *Since it will be marked during allocation.
+			 */
+			if (pflow[idx].tflowblockid != idx) {
+				ret = GSW_statusErr;
+				goto UNLOCK_AND_RETURN;
+			}
+
+			/*Search for the Last Index of this block.
+			 *Note: The Blocks are always allocated contiguously.
+			 */
+			ctplastidx = param->nFirstFlowEntryIndex;
+
+			while (pflow[ctplastidx].tflowblockid == idx &&
+			       pflow[ctplastidx].indexinuse) {
+				ctplastidx++;
+			}
+
+			param->nNumberOfFlowEntries = ctplastidx - idx;
+			pflow[idx].indexinusagecnt++;
+
+			gswdev->ctpportconfig_idx[ctp_port].IngressTflowAssigned = 1;
+			gswdev->ctpportconfig_idx[ctp_port].IngressTflowFirstIdx = idx;
+			gswdev->ctpportconfig_idx[ctp_port].IngressTflowNumberOfEntrys = 
+				param->nNumberOfFlowEntries;
+
+			tbl_prog_ctpport_ingress.val[7] |= (param->nFirstFlowEntryIndex & 0x1FC);
+			tbl_prog_ctpport_ingress.val[8] |= (param->nNumberOfFlowEntries & 0x3FC);
+		}
 	}
 
 	if (param->eMask & GSW_CTP_PORT_CONFIG_LOOPBACK_AND_MIRROR) {
@@ -25671,9 +25700,15 @@ GSW_return_t GSW_CtpPortConfigReset(void *cdev, GSW_CTP_portConfig_t *param)
 	param->nFirstFlowEntryIndex = (tbl_prog_ctpport_ingress.val[7] & 0x1FC);
 	param->nNumberOfFlowEntries = (tbl_prog_ctpport_ingress.val[8] & 0x3FC);
 
-	if (param->nNumberOfFlowEntries)
+	if (gswdev->ctpportconfig_idx[ctp_port].IngressTflowAssigned) {
 		/*Release this TFLOW blk from this CTP Port*/
-		gswdev->tflow_idx.flow_idx[param->nFirstFlowEntryIndex].indexinusagecnt--;
+		u32 idx = gswdev->ctpportconfig_idx[ctp_port].IngressTflowFirstIdx;
+
+		gswdev->tflow_idx.flow_idx[idx].indexinusagecnt--;
+		gswdev->ctpportconfig_idx[ctp_port].IngressTflowAssigned = 0;
+		gswdev->ctpportconfig_idx[ctp_port].IngressTflowFirstIdx = TFLOW_ENTRY_INVALID;
+		gswdev->ctpportconfig_idx[ctp_port].IngressTflowNumberOfEntrys = 0;
+	}
 
 	/*Zero the ingress/egress ctp port table index*/
 	/*Same ctp port idx for ingress and egress ctp port configuration*/
@@ -25921,7 +25956,7 @@ GSW_return_t GSW_RMON_ExtendGet(void *cdev, GSW_RMON_extendGet_t *parm)
 	spin_lock_bh(&gswdev->lock_bm);
 #endif
 
-	if (IS_VRSN_31_OR_32(gswdev->gipver)) {
+	if (VRSN_CMP(gswdev->gipver, LTQ_GSWIP_3_1) >= 0) {
 		/* GSW_RMON_ExtendGet will not support above 3.0 */
 		ret = GSW_statusNoSupport;
 		goto UNLOCK_AND_RETURN;
@@ -26703,7 +26738,7 @@ static u8 gsw_search_tflowcontiguousblock
 	return 1;
 }
 
-GSW_return_t gsw_tflow_alloc(void *cdev, gsw_tflow_alloc_t *parm)
+GSW_return_t GSW_PceRuleAlloc(void *cdev, GSW_PCE_rule_alloc_t *parm)
 {
 	ethsw_api_dev_t *gswdev = GSW_PDATA_GET(cdev);
 	u16 tflowindex = 0;
@@ -26719,8 +26754,8 @@ GSW_return_t gsw_tflow_alloc(void *cdev, gsw_tflow_alloc_t *parm)
 	spin_lock_bh(&gswdev->lock_pce);
 #endif
 
-	parm->num_of_pcerules = (parm->num_of_pcerules + 3) & ~0x03;
-	if (parm->num_of_pcerules >
+	parm->num_of_rules = (parm->num_of_rules + 3) & ~0x03;
+	if (parm->num_of_rules >
 		(gswdev->tftblsize -
 		gswdev->tflow_idx.usedentry)) {
 		pr_err(" nNumberOfRules requested is more than TFLOW index limit  %s:%s:%d",
@@ -26733,28 +26768,28 @@ GSW_return_t gsw_tflow_alloc(void *cdev, gsw_tflow_alloc_t *parm)
 	 *The Block must be allocated with contiguous table index
 	 */
 	for (tflowindex = gswdev->num_of_global_rules;
-		tflowindex < gswdev->tftblsize  &&
+		tflowindex < gswdev->tftblsize &&
 		!contiguousblockfound; tflowindex++) {
 		/*Table Index not in use*/
 		if (!gswdev->tflow_idx.flow_idx[tflowindex].indexinuse) {
 			contiguousblockfound =
 				gsw_search_tflowcontiguousblock
-				(gswdev, tflowindex, parm->num_of_pcerules);
+				(gswdev, tflowindex, parm->num_of_rules);
 		}
 
 		/*Contiguous block found in the table*/
 		if (contiguousblockfound) {
-			parm->tflowblockid = tflowindex;
+			parm->blockid = tflowindex;
 
 			/*Mark the contiguous table indexes as InUse
 			 *and tag it with block id
 			 */
-			for (i = parm->tflowblockid; i <
-			     (parm->tflowblockid + parm->num_of_pcerules);
-				 i++) {
+			for (i = parm->blockid;
+			     i < parm->blockid + parm->num_of_rules;
+			     i++) {
 				gswdev->tflow_idx.flow_idx[i].indexinuse = 1;
 				gswdev->tflow_idx.flow_idx[i].tflowblockid =
-				   parm->tflowblockid;
+				   parm->blockid;
 				gswdev->tflow_idx.usedentry++;
 			}
 		}
@@ -26776,7 +26811,7 @@ GSW_return_t gsw_tflow_alloc(void *cdev, gsw_tflow_alloc_t *parm)
 	return ret;
 }
 
-GSW_return_t gsw_tflow_free(void *cdev, gsw_tflow_alloc_t *parm)
+GSW_return_t GSW_PceRuleFree(void *cdev, GSW_PCE_rule_alloc_t *parm)
 {
 	ethsw_api_dev_t *gswdev = GSW_PDATA_GET(cdev);
 	u32 ret = GSW_statusOk, idx = 0;
@@ -26790,38 +26825,37 @@ GSW_return_t gsw_tflow_free(void *cdev, gsw_tflow_alloc_t *parm)
 	spin_lock_bh(&gswdev->lock_pce);
 #endif
 
-	if (parm->tflowblockid >= gswdev->tftblsize) {
+	if (parm->blockid >= gswdev->tftblsize) {
 		pr_err("tflowblockid %d out of range Supported num_of_tflowrules = %d]\n",
-		       parm->tflowblockid, gswdev->tftblsize);
+		       parm->blockid, gswdev->tftblsize);
 		ret = GSW_statusErr;
 		goto UNLOCK_AND_RETURN;
 	}
 
 	/*tflow blockid should be in use,if not in use return error*/
-	if (!gswdev->tflow_idx.flow_idx[parm->tflowblockid].indexinuse) {
+	if (!gswdev->tflow_idx.flow_idx[parm->blockid].indexinuse) {
 		pr_err("Blockid %u is Not inUse -> need to allocate before freeing\n",
-		       parm->tflowblockid);
+		       parm->blockid);
