From d886ecb5c30cb9dbd7c47dd0bbe05a4701327cfe Mon Sep 17 00:00:00 2001
From: Rekha Eswaran <rekha.eswaran@intel.com>
Date: Fri, 17 Jul 2020 14:53:15 +0800
Subject: [PATCH] DRV_DPM_SW-327 - verify and free FID allocation from dp
 notifier event

---
 drivers/net/datapath/dpm/datapath_notifier.c  |  5 +++++
 drivers/net/datapath/dpm/datapath_swdev.c     | 26 ++++++++++++++++++++++----
 drivers/net/datapath/dpm/datapath_swdev_api.h |  1 +
 3 files changed, 28 insertions(+), 4 deletions(-)

diff --git a/drivers/net/datapath/dpm/datapath_notifier.c b/drivers/net/datapath/dpm/datapath_notifier.c
index 3b524a300ba6..9ace803efc14 100644
--- a/drivers/net/datapath/dpm/datapath_notifier.c
+++ b/drivers/net/datapath/dpm/datapath_notifier.c
@@ -101,6 +101,11 @@ int dp_event(struct notifier_block *this, unsigned long event, void *ptr)
 		DP_DEBUG(DP_DBG_FLAG_NOTIFY,
 			 "datapath dev(%s) not exists!!,No mac config\n",
 			 dev ? dev->name : "NULL");
+		if ((netif_is_bridge_master(dev)) &&
+				(event == NETDEV_UNREGISTER)) {
+			dp_notif_br_free(dev);
+		}
+
 		DP_LIB_UNLOCK(&dp_lock);
 		return 0;
 	}
diff --git a/drivers/net/datapath/dpm/datapath_swdev.c b/drivers/net/datapath/dpm/datapath_swdev.c
index be9384d34d57..bc88cf7bb134 100644
--- a/drivers/net/datapath/dpm/datapath_swdev.c
+++ b/drivers/net/datapath/dpm/datapath_swdev.c
@@ -290,8 +290,6 @@ static int dp_swdev_clr_gswip_cfg(struct bridge_id_entry_item *br_item,
 		return DP_SUCCESS;
 	}
 
-	rcu_read_lock();
-
 	br_info = dp_swdev_bridge_entry_lookup_rcu(br_item->dev);
 	if (!br_info)
 		goto EXIT;
@@ -322,8 +320,6 @@ static int dp_swdev_clr_gswip_cfg(struct bridge_id_entry_item *br_item,
 	}
 
 EXIT:
-	rcu_read_unlock();
-
 	DP_DEBUG(DP_DBG_FLAG_SWDEV, "remove bport(%d)\n", br_item->bportid);
 
 	return DP_SUCCESS;
@@ -1060,6 +1056,28 @@ static int dp_swdev_port_obj_del(struct net_device *dev,
 	return -EOPNOTSUPP;
 }
 
+/* API to free bridge id from DP notifier event */
+int dp_notif_br_free(struct net_device *br_dev)
+{
+	struct inst_info *i_info = get_dp_prop_info(0);
+	struct br_info *br_info;
+
+	br_info = dp_swdev_bridge_entry_lookup_rcu(br_dev);
+	if (!br_info)
+		goto EXIT;
+
+	i_info->swdev_free_brcfg(0, br_info->fid);
+
+	i_info->dp_reg_br_vlan(br_info, DP_OPS_RESET);
+
+	dp_swdev_remove_bridge_id_entry(br_info);
+
+	DP_DEBUG(DP_DBG_FLAG_SWDEV, "Freed device(%s)\n", br_dev->name);
+EXIT:
+	return DP_SUCCESS;
+}
+
+/* API to alloc bridge id from DP notifier event */
 int dp_notif_br_alloc(struct net_device *br_dev)
 {
 	struct inst_info *dp_info = get_dp_prop_info(0);
diff --git a/drivers/net/datapath/dpm/datapath_swdev_api.h b/drivers/net/datapath/dpm/datapath_swdev_api.h
index 77941e304211..2a6fd3a49396 100644
--- a/drivers/net/datapath/dpm/datapath_swdev_api.h
+++ b/drivers/net/datapath/dpm/datapath_swdev_api.h
@@ -11,6 +11,7 @@ int dp_register_switchdev_ops(struct dp_dev *dp_dev, int reset);
 int dp_del_br_if(struct net_device *dev, struct net_device *br_dev,
 		 int inst, int bport);
 int dp_notif_br_alloc(struct net_device *br_dev);
+int dp_notif_br_free(struct net_device *br_dev);
 
 #endif
 /*DATAPATH_SWIHDEV_API_H*/
