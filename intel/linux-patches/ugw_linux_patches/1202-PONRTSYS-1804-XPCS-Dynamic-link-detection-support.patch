From a865cccf91f839f3963fba78dbdcbe72becb55e7 Mon Sep 17 00:00:00 2001
From: Dinesh Sudham <dineshx.sudham@intel.com>
Date: Sun, 7 Jun 2020 23:25:07 +0800
Subject: [PATCH] PONRTSYS-1804:XPCS: Dynamic link detection support

Signed-off-by: Dinesh Sudham <dineshx.sudham@intel.com>
---
 drivers/net/ethernet/lantiq/xpcs/xpcs.c | 107 ++++++++++++++------------------
 drivers/net/ethernet/lantiq/xpcs/xpcs.h |  22 +++----
 2 files changed, 54 insertions(+), 75 deletions(-)

diff --git a/drivers/net/ethernet/lantiq/xpcs/xpcs.c b/drivers/net/ethernet/lantiq/xpcs/xpcs.c
index db8edb786d67..1a3c4f07dbe7 100644
--- a/drivers/net/ethernet/lantiq/xpcs/xpcs.c
+++ b/drivers/net/ethernet/lantiq/xpcs/xpcs.c
@@ -1288,8 +1288,6 @@ static int xpcs_parse_dts(struct platform_device *pdev,
 			  struct xpcs_prv_data **pdata)
 {
 	struct device *dev = &pdev->dev;
-	struct of_phandle_args args;
-	int i;
 	u32 prop = 0;
 
 	(*pdata) = devm_kzalloc(dev, sizeof(**pdata), GFP_KERNEL);
@@ -1338,25 +1336,6 @@ static int xpcs_parse_dts(struct platform_device *pdev,
 		return -EINVAL;
 	}
 
-	/* Retrieve the dynamic link cfg sequence */
-	if (of_parse_phandle_with_fixed_args(dev->of_node,
-	    LINK_MODE_CFG, MAX_XPCS, 0, &args) < 0)
-		dev_dbg(dev, "Using static link configuration\n");
-	else {
-		(*pdata)->link_cfg = true;
-		/* Retrieve the jiffies to wait */
-		if (!device_property_read_u32
-		    (dev, LINK_POLL_TIME, &prop)) {
-			(*pdata)->poll_interval = prop;
-		} else {
-			dev_err(dev, "cannot get property poll_interval \n");
-			return -EINVAL;
-		}
-
-		for (i = 0; i < MAX_XPCS; i++)
-			(*pdata)->link_change_seq[i] = args.args[i];
-	}
-
 	platform_set_drvdata(pdev, (void *)(*pdata));
 
 	return XPCS_SUCCESS;
@@ -1563,41 +1542,26 @@ static void xpcs_link_poll_work(struct work_struct *work)
 	 * is no link, try switching modes and checking the status
 	 * again
 	 */
-	if (pdata->link_mode > (MAX_XPCS - 1))
+	if (pdata->link_mode > (MAX_XPCS_MODE - 1))
 		pdata->link_mode = 0;
 	
 	mode = pdata->link_change_seq[pdata->link_mode];
+	xpcs_reinit(pdata->dev, mode);
+	pdata->link_mode++;
 
 	switch (mode) {
 	case TENG_KR_MODE:
+		link_status  = get_xpcs_link_status(pdata) > 0 ? 1 : 0;
+		break;
 	case TENG_XAUI_MODE:
+		break;
 	case ONEG_XAUI_MODE:
 	case TWOP5G_SGMII_MODE:
-		link_status  = get_xpcs_link_status(pdata) > 0 ? 1 : 0;
-		/* 10000BaseX or 1000BaseX and 2500BaseX SGMII
-		 * cannot negotiate So disable Auto Negotiation.
-		 */
-		pdata->conntype = CONN_TYPE_ANEG_DIS;
-		break;
-	case SGMII_MODE_1000BASET:
-	case SGMII_MODE_2500BASET:
 		link_status = get_sgmii_link_status(pdata) > 0 ? 1 : 0;
-		/* 1000BaseT and 2500BaseT SGMII can negotiate
-		 * speed and duplex, So enable Auto Negotiation.
-		 */
-		pdata->conntype = CONN_TYPE_ANEG_PHY;
 		break;
 	}
 
 	if (!link_status) {
-		if (mode == SGMII_MODE_1000BASET)
-			mode = ONEG_XAUI_MODE;
-
-		if (mode == SGMII_MODE_2500BASET)
-			mode = TWOP5G_SGMII_MODE;
-
-		xpcs_reinit(pdata->dev, mode);
-		pdata->link_mode++;
 		/* Reschedule work for every poll interval */
 		queue_delayed_work(pdata->link_poll,
 				   &pdata->link_change_work,
@@ -1605,6 +1569,42 @@ static void xpcs_link_poll_work(struct work_struct *work)
 	}
 }
 
+static int dynamic_link_detection(struct xpcs_prv_data *pdata)
+{
+	int err;
+
+	if (device_property_present(pdata->dev, LINK_MODE_CFG)) {
+		err = device_property_read_u32_array(pdata->dev,
+						     LINK_MODE_CFG,
+							 pdata->link_change_seq,
+							 MAX_XPCS_MODE);
+		if (err) {
+			dev_err(pdata->dev, "invalid %s property\n",
+				LINK_MODE_CFG);
+			return err;
+		}
+	err = device_property_read_u32 (pdata->dev, LINK_POLL_TIME,
+					&pdata->poll_interval);
+	if (err) {
+		dev_warn(pdata->dev, "using default poll interval\n");
+		pdata->poll_interval = 3;
+	}
+	pdata->link_poll =
+		create_singlethread_workqueue("xpcs_dynamic_link");
+	if (!pdata->link_poll) {
+		dev_err(pdata->dev, "Cannot create link change workqueue\n");
+		return -ENOMEM;
+	}
+
+	INIT_DELAYED_WORK(&pdata->link_change_work,
+			  xpcs_link_poll_work);
+	queue_delayed_work(pdata->link_poll,
+			   &pdata->link_change_work, (15 * HZ));
+	}
+
+	return 0;
+}
+
 static int xpcs_probe(struct platform_device *pdev)
 {
 	struct resource *res;
@@ -1704,28 +1704,15 @@ static int xpcs_probe(struct platform_device *pdev)
 		return -EINVAL;
 	}
 
+	/* Schedule the link poll task if link is dynmically configurable*/
+	ret = dynamic_link_detection(pdata);
+	if (ret)
+		return ret;
+
 	/* Phy calibrate for RX Signal Adaption */
 	if (!serdes_cfg->no_phy_rx_auto_adapt)
 		ret = phy_calibrate(pdata->phy);
 
-	/* Schedule the link poll task if link is dynmically configurable*/
-	if (pdata->link_cfg) {
-		/* good to use the dev name */
-		snprintf(pdata->workqueue_name, sizeof(pdata->workqueue_name),
-			 "%s", pdata->name);
-		pdata->link_poll =
-			create_singlethread_workqueue(pdata->workqueue_name);
-		if (!pdata->link_poll) {
-			dev_err(dev, "Cannot create link change workqueue\n");
-			return -ENOMEM;
-		}
-
-		INIT_DELAYED_WORK(&pdata->link_change_work,
-				  xpcs_link_poll_work);
-		queue_delayed_work(pdata->link_poll,
-				   &pdata->link_change_work, (15 * HZ));
-	}
-
 	return XPCS_SUCCESS;
 }
 
diff --git a/drivers/net/ethernet/lantiq/xpcs/xpcs.h b/drivers/net/ethernet/lantiq/xpcs/xpcs.h
index 6f99cc000955..4d5560872175 100644
--- a/drivers/net/ethernet/lantiq/xpcs/xpcs.h
+++ b/drivers/net/ethernet/lantiq/xpcs/xpcs.h
@@ -562,7 +562,8 @@
 #define PMA_RX_EQ_CTRL0_VGA1_GAIN_0_POS	12
 #define PMA_RX_EQ_CTRL0_VGA1_GAIN_0_WIDTH	4
 
-#define MAX_XPCS				6
+#define PCS_KR_STS1_PLU_POS	12
+#define PCS_KR_STS1_PLU_WIDTH	1
 
 enum {
 	BACKPL_ETH_PCS = 0,
@@ -622,11 +623,6 @@ enum {
 	PCS_TYPE_RESERVED,
 };
 
-enum {
-	 SGMII_MODE_1000BASET = 4,
-	 SGMII_MODE_2500BASET,
-};
-
 struct xpcs_prv_data;
 
 /* 10G XAUI Mode Switching */
@@ -819,18 +815,14 @@ struct xpcs_prv_data {
 
 	/* Scheduled link poll workitem */
 	struct workqueue_struct *link_poll;
-	/* Workqueue name */
-	char workqueue_name[16];
 	/* Delayable work to queue */
 	struct delayed_work link_change_work;
 	/* link cfg sequence */
-	u32 link_change_seq[MAX_XPCS];
+	u32 link_change_seq[MAX_XPCS_MODE];
 	/* Current state of the XPCS link mode */
 	u32 link_mode;
 	/* jiffies to wait before queueing */
 	unsigned int poll_interval;
-	/* Link is Dynamic or static */
-	bool link_cfg;
 
 	/* Serdes configurable data */
 	void *serdes_cfg;
@@ -930,11 +922,11 @@ static inline int get_sgmii_link_status(struct xpcs_prv_data *pdata)
 {
 	bool link_status = false;
 
-	link_status = XPCS_RGRD_VAL(pdata, VR_MII_AN_CTRL, SGMII_LINK_STS);
+	link_status = XPCS_RGRD_VAL(pdata, SR_MII_STS, LINK_STS);
 	/* Link status is latched low, so read again to get
 	 * current state
 	 */
-	link_status = XPCS_RGRD_VAL(pdata, VR_MII_AN_CTRL, SGMII_LINK_STS);
+	link_status = XPCS_RGRD_VAL(pdata, SR_MII_STS, LINK_STS);
 
 	return link_status;
 }
@@ -943,11 +935,11 @@ static inline int get_xpcs_link_status(struct xpcs_prv_data *pdata)
 {
 	bool link_status = false;
 
-	link_status = XPCS_RGRD_VAL(pdata, PCS_STS1, RLU);
+	link_status = XPCS_RGRD_VAL(pdata, PCS_KR_STS1, PLU);
 	/* Link status is latched low, so read again to get
 	 * current state
 	 */
-	link_status = XPCS_RGRD_VAL(pdata, PCS_STS1, RLU);
+	link_status = XPCS_RGRD_VAL(pdata, PCS_KR_STS1, PLU);
 
 	return link_status;
 }
