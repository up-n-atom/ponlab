From 36ffc4d2f0540f4f4a6d73407b3f4de7865081f8 Mon Sep 17 00:00:00 2001
From: Gu Chao <gux.chao@intel.com>
Date: Thu, 28 May 2020 11:57:38 +0800
Subject: [PATCH] DRV_DPM_SW-221: FLM DPM fix debugfs qos info tree view

---
 drivers/net/datapath/dpm/datapath_proc_qos.c | 29 ++++++++++------------------
 1 file changed, 10 insertions(+), 19 deletions(-)

diff --git a/drivers/net/datapath/dpm/datapath_proc_qos.c b/drivers/net/datapath/dpm/datapath_proc_qos.c
index 5667c8184b30..95b441a0250a 100644
--- a/drivers/net/datapath/dpm/datapath_proc_qos.c
+++ b/drivers/net/datapath/dpm/datapath_proc_qos.c
@@ -11,8 +11,10 @@
 /* max direct child per scheduler/port */
 #define PROC_DP_MAX_CHILD_PER_SCH_PORT DP_MAX_CHILD_PER_NODE
 #define PROC_MAX_Q_PER_PORT 16 /* max queues per port */
-#define PROC_DP_MAX_SCH_PER_PORT 4 /* max schedulers per port */
+/* max schedulers per port */
+#define PROC_DP_MAX_SCH_PER_PORT ((PROC_MAX_Q_PER_PORT) * (DP_MAX_SCH_LVL))
 #define PROC_DP_MAX_LEAF 8 /* max leaf per scheduler */
+
 struct location {
 	int x1, y1; /* start axis */
 	int x2, y2; /* end axis */
@@ -62,7 +64,7 @@ struct q_print_info {
 	int sch_lvl[PROC_MAX_Q_PER_PORT];
 
 	/* point to one of box entry */
-	struct box_info *sch_box[PROC_MAX_Q_PER_PORT][PROC_MAX_BOX_LVL];
+	struct box_info *sch_box[PROC_MAX_Q_PER_PORT][DP_MAX_SCH_LVL];
 	struct box_info port_box;
 	int box_num;
 	struct box_info box[PROC_DP_MAX_SCH_PER_PORT]; /* need kmalloc/kfree */
@@ -533,7 +535,7 @@ struct q_print_info *collect_info(struct seq_file *s,
 				  struct dp_dequeue_res *res,
 				  int print_box_lvl)
 {
-	int i, j, size, curr_box_y = 0, curr_box_x;
+	int i, j, curr_box_y = 0, curr_box_x;
 	struct q_print_info *q_info = NULL;
 	struct box_info *box;
 	char f_new_box;
@@ -541,17 +543,14 @@ struct q_print_info *collect_info(struct seq_file *s,
 	if (!res || !res->num_q || res->num_deq_ports < 1)
 		goto ERR_EXIT;
 
-	if (res->num_q >= PROC_MAX_Q_PER_PORT) {
-		seq_printf(s, "too many queues in one port:%d should <%d\n",
+	if (res->num_q > PROC_MAX_Q_PER_PORT) {
+		seq_printf(s, "too many queues (%d) in one port: expect<=%d\n",
 			   res->num_q, PROC_MAX_Q_PER_PORT);
 		return NULL;
 	}
-
-	size = sizeof(*q_info) + 1;
-	q_info = devm_kzalloc(&g_dp_dev->dev, size, GFP_ATOMIC);
+	q_info = devm_kzalloc(&g_dp_dev->dev, sizeof(*q_info), GFP_ATOMIC);
 	if (!q_info)
 		return NULL;
-	memset(q_info, 0, size);
 
 	q_info->port_box.filled = 1;
 	q_info->port_box.id = res->q_res[0].cqm_deq_port;
@@ -564,10 +563,9 @@ struct q_print_info *collect_info(struct seq_file *s,
 		q_info->q_node_id[i] = res->q_res[i].q_node;
 		if (res->q_res[i].sch_lvl <= 0)
 			continue;
-		if (res->q_res[i].sch_lvl > PROC_MAX_BOX_LVL - 1) {
+		if (res->q_res[i].sch_lvl > DP_MAX_SCH_LVL) {
 			pr_err("Too many sched lvl(%d): expect<=%d\n",
-			       res->q_res[i].sch_lvl,
-			       PROC_MAX_BOX_LVL - 1);
+			       res->q_res[i].sch_lvl, DP_MAX_SCH_LVL);
 			goto ERR_EXIT;
 		}
 		f_new_box = 0;
@@ -591,13 +589,6 @@ struct q_print_info *collect_info(struct seq_file *s,
 			q_info->box[q_info->box_num].box_y = curr_box_y;
 			q_info->sch_box[i][j] = &q_info->box[q_info->box_num];
 			q_info->box_num++;
-			if (q_info->box_num == ARRAY_SIZE(q_info->box)) {
-				pr_err("sched+port (%d) in one node: %s<%zd\n",
-				       q_info->box_num,
-				       "expect",
-				       ARRAY_SIZE(q_info->box));
-				goto ERR_EXIT;
-			}
 			f_new_box = 1;
 		}
 		q_info->sch_lvl[i] = res->q_res[i].sch_lvl;
