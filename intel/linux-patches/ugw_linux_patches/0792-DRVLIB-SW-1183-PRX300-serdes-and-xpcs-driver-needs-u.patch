+	int err, max_retry_cnt = 2;
 	u32 val;
 	struct device *dev;
 
 	iphy = phy_get_drvdata(phy);
 	dev = iphy->dev;
-	/* RAWLANEN_RX_OV_IN_3 */
-	/* 15		CONT_OVRD_EN = 0
-	 * 14		OFFCAN_CONT = 0
