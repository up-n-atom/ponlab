From c9d36bb9d6479f72cb213855f4d97dd6edc581cc Mon Sep 17 00:00:00 2001
From: Elad Fernandes <elad.fernandes@intel.com>
Date: Sun, 6 Sep 2020 12:06:03 +0300
Subject: [PATCH] PONRTSYS-7979: drop in FW for parser error L3 processing
 timeout

---
 drivers/net/ppv4/pp-hal/parser/parser.c | 12 ++++++++----
 1 file changed, 8 insertions(+), 4 deletions(-)

diff --git a/drivers/net/ppv4/pp-hal/parser/parser.c b/drivers/net/ppv4/pp-hal/parser/parser.c
index ce4bec69a35f..c4991183b870 100644
--- a/drivers/net/ppv4/pp-hal/parser/parser.c
+++ b/drivers/net/ppv4/pp-hal/parser/parser.c
@@ -1053,6 +1053,10 @@ static void prsr_hw_drop_flags_init_astep(u32 *flags)
 				0);
 	/* don't drop if l3 packet len doesn't match stw length */
 	*flags |= PP_FIELD_PREP(PP_PRSR_ABORT_CFG_DROP_IP_LEN_ERR_MSK, 0);
+
+	*flags |= PP_FIELD_PREP(PP_PRSR_ABORT_CFG_DROP_ABORT_CNT_ERR_MSK, 0);
+	*flags |= PP_FIELD_PREP(PP_PRSR_ABORT_CFG_DROP_EOF_NO_PAYLOAD_ERR_MSK,
+                                0);
 }
 
 static void prsr_hw_drop_flags_init(u32 *flags)
@@ -1080,6 +1084,10 @@ static void prsr_hw_drop_flags_init(u32 *flags)
 				0);
 	/* don't drop if l3 packet len doesn't match stw length */
 	*flags |= PP_FIELD_PREP(PP_PRSR_ABORT_CFG_DROP_IP_LEN_ERR_MSK, 0);
+
+	*flags |= PP_FIELD_PREP(PP_PRSR_ABORT_CFG_DROP_ABORT_CNT_ERR_MSK, 1);
+	*flags |= PP_FIELD_PREP(PP_PRSR_ABORT_CFG_DROP_EOF_NO_PAYLOAD_ERR_MSK,
+				1);
 }
 
 void prsr_hw_err_flags_init(void)
@@ -1144,10 +1152,6 @@ void prsr_hw_err_flags_init(void)
 	flags |= PP_FIELD_PREP(PP_PRSR_ABORT_CFG_IP_LEN_ABORT_EN_MSK, 0);
 
 	/* use reset values */
-	flags |= PP_FIELD_PREP(PP_PRSR_ABORT_CFG_DROP_ABORT_CNT_ERR_MSK,
-			       PP_PRSR_ABORT_CFG_DROP_ABORT_CNT_ERR_RST);
-	flags |= PP_FIELD_PREP(PP_PRSR_ABORT_CFG_DROP_EOF_NO_PAYLOAD_ERR_MSK,
-			       PP_PRSR_ABORT_CFG_DROP_EOF_NO_PAYLOAD_ERR_RST);
 	flags |= PP_FIELD_PREP(PP_PRSR_ABORT_CFG_ERROR_ABORT_CNT_ERR_MSK,
 			       PP_PRSR_ABORT_CFG_ERROR_ABORT_CNT_ERR_RST);
 	flags |= PP_FIELD_PREP(PP_PRSR_ABORT_CFG_ERROR_EOF_NO_PAYLOAD_ERR_MSK,
