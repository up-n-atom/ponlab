From 2a379f5b8a88dee66ea074c167d98aa722bbf67e Mon Sep 17 00:00:00 2001
From: Rekha Eswaran <rekha.eswaran@intel.com>
Date: Fri, 1 Nov 2019 13:04:12 +0800
Subject: [PATCH] DRV_DPM_SW-63 - Fix to solve sw bridging when one bp not part
 of swdev

---
 drivers/net/datapath/dpm/datapath_instance.c | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/drivers/net/datapath/dpm/datapath_instance.c b/drivers/net/datapath/dpm/datapath_instance.c
index d553c7f8de43..0c6eba53f0a5 100644
--- a/drivers/net/datapath/dpm/datapath_instance.c
+++ b/drivers/net/datapath/dpm/datapath_instance.c
@@ -248,6 +248,8 @@ int dp_inst_add_dev(struct net_device *dev, char *subif_name, int inst,
 #if IS_ENABLED(CONFIG_PPA)
 	int err = DP_SUCCESS;
 #endif
+	struct pmac_port_info *port_info = get_dp_port_info(inst, ep);
+
 	if (!dev && !subif_name) {
 		pr_err("Why dev/subif_name both NULL?\n");
 		return -1;
@@ -313,7 +315,8 @@ int dp_inst_add_dev(struct net_device *dev, char *subif_name, int inst,
 		}
 #endif
 #if IS_ENABLED(CONFIG_INTEL_DATAPATH_SWITCHDEV)
-	if (!(flag & DP_F_SUBIF_LOGICAL))
+	if ((!(flag & DP_F_SUBIF_LOGICAL)) &&
+		(port_info->swdev_en == 1))
 		dp_port_register_switchdev(dp_dev, dev);
 #endif
 #if IS_ENABLED(CONFIG_INTEL_DATAPATH_PTP1588)
