From 70a43d1e01c7d518dbca94f0c14da58cb8f427c6 Mon Sep 17 00:00:00 2001
From: Rekha Eswaran <rekha.eswaran@intel.com>
Date: Wed, 12 Aug 2020 17:18:42 +0800
Subject: [PATCH] DRV_DPM_SW-365 - DPM avoid incorrect error message

---
 drivers/net/datapath/dpm/datapath.h      |  1 +
 drivers/net/datapath/dpm/datapath_api.c  | 15 ++++++++++-----
 drivers/net/datapath/dpm/datapath_misc.c |  7 ++++---
 3 files changed, 15 insertions(+), 8 deletions(-)

diff --git a/drivers/net/datapath/dpm/datapath.h b/drivers/net/datapath/dpm/datapath.h
index 9663a5d150a1..ba914aa0fd82 100644
--- a/drivers/net/datapath/dpm/datapath.h
+++ b/drivers/net/datapath/dpm/datapath.h
@@ -242,6 +242,7 @@ enum PARSER_FLAGS {
 };
 
 enum dp_message_errors {
+	DP_ERR_SUBIF_NOT_FOUND = -7,
 	DP_ERR_INIT_FAIL = -6,
 	DP_ERR_INVALID_PORT_ID = -5,
 	DP_ERR_MEM = -4,
diff --git a/drivers/net/datapath/dpm/datapath_api.c b/drivers/net/datapath/dpm/datapath_api.c
index db87369025c7..c7c162569521 100644
--- a/drivers/net/datapath/dpm/datapath_api.c
+++ b/drivers/net/datapath/dpm/datapath_api.c
@@ -242,8 +242,11 @@ int parser_enabled(int ep, struct dma_rx_desc_1 *desc_1)
 void dp_print_err_info(int res)
 {
 	switch (res) {
+	case DP_ERR_SUBIF_NOT_FOUND:
+		pr_err("DPM subif not found\n");
+		break;
 	case DP_ERR_INIT_FAIL:
-		pr_err("DPM init not donei\n");
+		pr_err("DPM init not done\n");
 		break;
 	case DP_ERR_INVALID_PORT_ID:
 		pr_err("DPM invalid port id\n");
@@ -701,6 +704,9 @@ int32_t dp_register_subif_private(int inst, struct module *owner,
 		sif = get_dp_port_subif(port_info, i);
 		if (!sif->flags)
 			break;
+		if ((subif_id->subif > 0) && (start == i))
+			pr_err("subifid(%d) is duplicated! vap(%d)\n",
+			       subif_id->subif, start);
 	}
 	if (i >= end) {
 		pr_err("register subif failed for no matched vap(%s)\n",
@@ -1831,7 +1837,8 @@ int32_t dp_get_netif_subifid_priv(int inst, struct net_device *netif,
 		if (match)
 			break;
 	}
-
+	if (flags & DP_F_DEREGISTER)
+		goto EXIT;
 	if (port_id < 0) {
 		if (subif_data)
 			DP_DEBUG(DP_DBG_FLAG_DBG,
@@ -1840,7 +1847,7 @@ int32_t dp_get_netif_subifid_priv(int inst, struct net_device *netif,
 		else /*netif must should be valid */
 			DP_DEBUG(DP_DBG_FLAG_DBG,
 				 "%s failed: %s\n", __func__, netif->name);
-		res = DP_ERR_INVALID_PORT_ID;
+		res = DP_ERR_SUBIF_NOT_FOUND;
 		goto EXIT;
 	}
 	subif->inst = inst;
@@ -1856,8 +1863,6 @@ int32_t dp_get_netif_subifid_priv(int inst, struct net_device *netif,
 EXIT:
 	devm_kfree(&g_dp_dev->dev, subifs);
 	devm_kfree(&g_dp_dev->dev, subif_flag);
-	if (unlikely(res))
-		dp_print_err_info(res);
 	return res;
 }
 
diff --git a/drivers/net/datapath/dpm/datapath_misc.c b/drivers/net/datapath/dpm/datapath_misc.c
index ceac4a1be35a..8cf4d4f6b8d6 100644
--- a/drivers/net/datapath/dpm/datapath_misc.c
+++ b/drivers/net/datapath/dpm/datapath_misc.c
@@ -1002,9 +1002,10 @@ int32_t dp_sync_subifid(struct net_device *dev, char *subif_name,
 	/*check flag for register / deregister to update/del */
 	if (flags & DP_F_DEREGISTER) {
 		/* subif info not required for data->ctp_dev */
-		if (dp_get_netif_subifid_priv(subif_id->inst, dev, NULL,
-					      subif_data, NULL,
-					      &subif_id[0], 0))
+		res = dp_get_netif_subifid_priv(subif_id->inst, dev, NULL,
+						subif_data, NULL,
+						&subif_id[0], flags);
+		if (res)
 			*f_subif_up = 0;
 		else
 			*f_subif_up = 1;
