From 755a1b8f398b8567c8697648e714d35c24954f49 Mon Sep 17 00:00:00 2001
From: Robert Dabrowski <robertx.dabrowski@intel.com>
Date: Wed, 26 Feb 2020 10:03:43 +0100
Subject: [PATCH] PONRTSYS-6739: dp: sleeping function called from invalid
 context

---
 drivers/net/datapath/mib_counters/dp_mib_counters.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/drivers/net/datapath/mib_counters/dp_mib_counters.c b/drivers/net/datapath/mib_counters/dp_mib_counters.c
index 06fb5b7216f0..7da60d499117 100644
--- a/drivers/net/datapath/mib_counters/dp_mib_counters.c
+++ b/drivers/net/datapath/mib_counters/dp_mib_counters.c
@@ -81,7 +81,7 @@ static void update_dev_counters(struct mib_counters *cnt)
 
 	tmp_counters = devm_kzalloc(&g_dp_dev->dev,
 				    (2 * sizeof(GSW_RMON_Port_cnt_t)),
-				    GFP_KERNEL);
+				    GFP_ATOMIC);
 	if (!tmp_counters) {
 		netdev_err(cnt->dev, "failed to get memory for counters");
 		return;
@@ -335,7 +335,7 @@ void mib_cnt_get_ethtool_stats_31(struct net_device *dev,
 	int ret;
 
 	ps_subif = devm_kzalloc(&g_dp_dev->dev, (sizeof(dp_subif_t)),
-				GFP_KERNEL);
+				GFP_ATOMIC);
 	if (!ps_subif)
 		return;
 
