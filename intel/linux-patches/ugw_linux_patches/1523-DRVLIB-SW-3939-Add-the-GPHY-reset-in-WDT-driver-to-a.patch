From abb9e8d40e1cef53458cda0efae8a5142cbd52f5 Mon Sep 17 00:00:00 2001
From: arathinx <ayyappanx.rathinam@intel.com>
Date: Mon, 9 Nov 2020 11:33:28 +0800
Subject: [PATCH] DRVLIB_SW-3939: Add the GPHY reset in WDT driver to avoid
 U-Boot stuck issue

---
 drivers/net/ethernet/lantiq/xrx500_phy_fw.c | 5 +++--
 drivers/watchdog/grx500_wdt.c               | 6 ++++++
 2 files changed, 9 insertions(+), 2 deletions(-)

diff --git a/drivers/net/ethernet/lantiq/xrx500_phy_fw.c b/drivers/net/ethernet/lantiq/xrx500_phy_fw.c
index d7f01bd05c22..618f7ee437ff 100644
--- a/drivers/net/ethernet/lantiq/xrx500_phy_fw.c
+++ b/drivers/net/ethernet/lantiq/xrx500_phy_fw.c
@@ -535,13 +535,14 @@ static int prx300_dt_parse(struct xway_gphy_data *priv)
 		return PTR_ERR(rst->gphy);
 	}
 
-	rst->gphy_cdb = devm_reset_control_get(priv->dev, "gphy_cdb");
+	rst->gphy_cdb = devm_reset_control_get_shared(priv->dev, "gphy_cdb");
 	if (IS_ERR(rst->gphy_cdb)) {
 		dev_err(priv->dev, "fail to get gphy_cdb prop\n");
 		return PTR_ERR(rst->gphy_cdb);
 	}
 
-	rst->gphy_pwr_down = devm_reset_control_get(priv->dev, "gphy_pwr_down");
+	rst->gphy_pwr_down = devm_reset_control_get_shared(priv->dev,
+							   "gphy_pwr_down");
 	if (IS_ERR(rst->gphy_pwr_down)) {
 		dev_err(priv->dev, "fail to get gphy_pwr_down prop\n");
 		return PTR_ERR(rst->gphy_pwr_down);
diff --git a/drivers/watchdog/grx500_wdt.c b/drivers/watchdog/grx500_wdt.c
index beebd909895b..2e4cc6150530 100644
--- a/drivers/watchdog/grx500_wdt.c
+++ b/drivers/watchdog/grx500_wdt.c
@@ -399,6 +399,12 @@ static int grx500wdt_probe(struct platform_device *pdev)
 				i);
 			return PTR_ERR(priv->resets[i]);
 		}
+		ret = reset_control_deassert(priv->resets[i]);
+		if (ret) {
+			while (--i >= 0)
+				reset_control_assert(priv->resets[i]);
+			return ret;
+		}
 	}
 
 	/* set up per-cpu IRQ */
