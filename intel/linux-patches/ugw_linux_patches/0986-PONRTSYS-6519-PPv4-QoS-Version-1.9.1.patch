From 069689886bad40c46f2f1d379bad6e42dbdb7ac8 Mon Sep 17 00:00:00 2001
From: ofirbitt <ofir1.bitton@intel.com>
Date: Wed, 8 Jan 2020 15:09:47 +0200
Subject: [PATCH] PONRTSYS-6519: PPv4 QoS Version 1.9.1

---
 drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_debugfs.c | 4 ++--
 drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_uc_defs.h | 2 +-
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_debugfs.c b/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_debugfs.c
index 8321d7ef543e..8f9054670826 100644
--- a/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_debugfs.c
+++ b/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_debugfs.c
@@ -1957,9 +1957,9 @@ void pp_qos_dbg_system_stats_show(struct seq_file *s)
 			   sys_stats.wred_pop_underflow_count);
 		seq_printf(s, "wred_pop_underflow_sum: %u\n",
 			   sys_stats.wred_pop_underflow_sum);
-		seq_printf(s, "wred_last_push_address_high: %u\n",
+		seq_printf(s, "wred_last_push_address_high: %#x\n",
 			   sys_stats.wred_last_push_address_high);
-		seq_printf(s, "wred_last_push_address_low: %u\n",
+		seq_printf(s, "wred_last_push_address_low: %#x\n",
 			   sys_stats.wred_last_push_address_low);
 		seq_printf(s, "wred_last_push_drop: %u\n",
 			   sys_stats.wred_last_push_drop);
diff --git a/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_uc_defs.h b/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_uc_defs.h
index 4313f106aa7c..097acea5c1b4 100644
--- a/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_uc_defs.h
+++ b/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_uc_defs.h
@@ -12,7 +12,7 @@
 /* UC version */
 #define UC_VERSION_MAJOR (1)
 #define UC_VERSION_MINOR (9)
-#define UC_VERSION_BUILD (0)
+#define UC_VERSION_BUILD (1)
 
 #define QOS_MAX_PREDECESSORS       (6)
 #define QOS_AQM_CONTEXT_MAX_QUEUES (8)
