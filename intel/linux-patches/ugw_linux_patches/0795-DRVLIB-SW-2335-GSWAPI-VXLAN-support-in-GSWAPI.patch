 	ops->gsw_vlan_ops.SVLAN_PortCfgSet				= GSW_SVLAN_PortCfgSet;
+	ops->gsw_vlan_ops.vxlan_cfg_get					= gsw_vxlan_cfg_get;
+	ops->gsw_vlan_ops.vxlan_cfg_set					= gsw_vxlan_cfg_set;
 
 #ifdef __KERNEL__
 	/*PAE operation*/
