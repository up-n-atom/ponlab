diff --git a/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c b/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c
index e1af30c1e9bb..40959b084575 100644
--- a/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c
+++ b/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c
@@ -26861,6 +26861,112 @@ GSW_return_t gsw_tflow_free(void *cdev, gsw_tflow_alloc_t *parm)
 #endif
 	return ret;
 }
+
+GSW_return_t gsw_vxlan_cfg_get(void *cdev,
+			       gsw_vxlan_cfg_t *parm)
+{
+	pctbl_prog_t vxlan_tbl_entry;
+	int ret = GSW_statusOk;
+	ethsw_api_dev_t *gswdev = GSW_PDATA_GET(cdev);
+
+	if (gswdev == NULL) {
+		pr_err("%s:%s:%d", __FILE__, __func__, __LINE__);
+		return GSW_statusErr;
+	}
+
+	if (VRSN_CMP(gswdev->gipver, LTQ_GSWIP_3_0) != 0)
+		return GSW_statusErr;
+
+	memset(&vxlan_tbl_entry, 0, sizeof(vxlan_tbl_entry));
+	vxlan_tbl_entry.table = PCE_PARS_INDEX;
+	CLEAR_U16(vxlan_tbl_entry.pcindex);
+
+	switch (parm->index) {
+	case 0:
+		vxlan_tbl_entry.pcindex = PCE_VXLAN_INDEX_0;
+		break;
+
+	case 1:
+		vxlan_tbl_entry.pcindex = PCE_VXLAN_INDEX_1;
+		break;
+
+	default:
+		pr_err("\nERROR: Index is not Valid \n");
+		return GSW_statusErr;
+	}
+
+#ifdef __KERNEL__
+	spin_lock_bh(&gswdev->lock_pce);
+#endif
+
+	ret = gsw_pce_table_read(cdev, &vxlan_tbl_entry);
+	if (ret != GSW_statusOk) {
+		pr_err("Failed to read PCE TABLE %s:%s:%d\n", __FILE__, __func__, __LINE__);
+		ret = GSW_statusErr;
+		goto UNLOCK_AND_RETURN;
+	}
+	parm->vxlan_value = (vxlan_tbl_entry.val[3] & 0xFFFF);
+
+UNLOCK_AND_RETURN:
+#ifdef __KERNEL__
+	spin_unlock_bh(&gswdev->lock_pce);
+#endif
+	return ret;
+}
+
+GSW_return_t gsw_vxlan_cfg_set(void *cdev,
+			       gsw_vxlan_cfg_t *parm)
+{
+	int  ret = GSW_statusOk;
+	pctbl_prog_t vxlan_tbl_entry;
+	ethsw_api_dev_t *gswdev = GSW_PDATA_GET(cdev);
+
+	if (gswdev == NULL) {
+		pr_err("%s:%s:%d", __FILE__, __func__, __LINE__);
+		return GSW_statusErr;
+	}
+
+	if (VRSN_CMP(gswdev->gipver, LTQ_GSWIP_3_0) != 0)
+		return GSW_statusErr;
+
+	memset(&vxlan_tbl_entry, 0, sizeof(vxlan_tbl_entry));
+	CLEAR_U16(vxlan_tbl_entry.pcindex);
+
+	switch (parm->index) {
+	case 0:
+		vxlan_tbl_entry.pcindex = PCE_VXLAN_INDEX_0;
+		break;
+
+	case 1:
+		vxlan_tbl_entry.pcindex = PCE_VXLAN_INDEX_1;
+		break;
+
+	default:
+		pr_err("\nERROR: Index is not Valid \n");
+		return GSW_statusErr;
+	}
+
+	vxlan_tbl_entry.val[3] = parm->vxlan_value & 0xFFFF;
+	vxlan_tbl_entry.table = PCE_PARS_INDEX;
+
+#ifdef __KERNEL__
+	spin_lock_bh(&gswdev->lock_pce);
+#endif
+
+	ret = gsw_pce_table_write(cdev, &vxlan_tbl_entry);
+	if (ret != GSW_statusOk) {
+		pr_err("Failed to write PCE TABLE %s:%s:%d\n", __FILE__, __func__, __LINE__);
+		ret = GSW_statusErr;
+		goto UNLOCK_AND_RETURN;
+	}
+
+UNLOCK_AND_RETURN:
+#ifdef __KERNEL__
+	spin_unlock_bh(&gswdev->lock_pce);
+#endif
+	return ret;
+}
+
 static GSW_return_t gsw_init_fn_ptrs(struct core_ops *ops)
 {
 
