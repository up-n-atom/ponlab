From 13eaba7876e4327fe6705a2a48767bb4ee6e3e35 Mon Sep 17 00:00:00 2001
From: ofirbitt <ofir1.bitton@intel.com>
Date: Sun, 23 Feb 2020 10:38:47 +0200
Subject: [PATCH] LMTSYS-6681: Support cached DDR allocations

---
 .../net/ppv4/pp-api/pp-buffer-mgr/pp_buffer_mgr.c  |  20 ++---
 drivers/net/ppv4/pp-api/pp-misc/pp_misc.h          |   4 +-
 drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_fw.c     |  91 ++++++++-----------
 drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_main.c   | 100 ++++++++++++---------
 drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.c  |   9 +-
 drivers/net/ppv4/pp-dev/pp_regs.c                  |  41 ++++++++-
 drivers/net/ppv4/pp-hal/buffer-manager/bm.c        |  16 ++--
 drivers/net/ppv4/pp-headers/pp_common.h            |  30 +++++++
 .../ppv4/pp-tools/unit-test/tests/pp_bm_tests.c    |  13 ++-
 .../ppv4/pp-tools/unit-test/tests/pp_qos_tests.c   |  16 ++--
 10 files changed, 201 insertions(+), 139 deletions(-)

diff --git a/drivers/net/ppv4/pp-api/pp-buffer-mgr/pp_buffer_mgr.c b/drivers/net/ppv4/pp-api/pp-buffer-mgr/pp_buffer_mgr.c
index afda63102ebe..ba9fd894373b 100644
--- a/drivers/net/ppv4/pp-api/pp-buffer-mgr/pp_buffer_mgr.c
+++ b/drivers/net/ppv4/pp-api/pp-buffer-mgr/pp_buffer_mgr.c
@@ -547,10 +547,9 @@ __bmgr_pool_configure(const struct pp_bmgr_pool_params * const pool_params,
 	/* Allocate pool_param->pool_num_of_buff * POINTER_SIZE bytes array */
 	pool->internal_ptrs_sz = PAGE_ALIGN(sizeof(unsigned int) *
 					    pool_params->num_buffers);
-	pool->internal_ptrs_virt =
-		dma_zalloc_coherent(NULL, pool->internal_ptrs_sz,
-				    &pool->internal_ptrs_phys,
-				    GFP_ATOMIC);
+	pool->internal_ptrs_virt = pp_dma_alloc(pool->internal_ptrs_sz,
+						GFP_ATOMIC,
+						&pool->internal_ptrs_phys);
 
 	if (!pool->internal_ptrs_virt) {
 		pr_err("Could not allocate %u bytes for pool %u pointers\n",
@@ -574,6 +573,7 @@ __bmgr_pool_configure(const struct pp_bmgr_pool_params * const pool_params,
 		temp_pointers_table_ptr++;
 		user_array_ptr += pool_params->size_of_buffer;
 	}
+	pp_cache_writeback(pool->internal_ptrs_virt, pool->internal_ptrs_sz);
 
 	cfg.num_buffers = pool_params->num_buffers;
 	cfg.ptr_table_addr_low = (u32)pool->internal_ptrs_phys;
@@ -615,9 +615,9 @@ __bmgr_pool_configure(const struct pp_bmgr_pool_params * const pool_params,
 
 free_memory:
 	/* free pointers_table */
-	dma_free_coherent(NULL, pool->internal_ptrs_sz,
-			  (void *)pool->internal_ptrs_virt,
-			  pool->internal_ptrs_phys);
+	pp_dma_free(pool->internal_ptrs_sz,
+		    (void *)pool->internal_ptrs_virt,
+		    &pool->internal_ptrs_phys);
 	pool->is_busy = 0;
 	__bmgr_db_unlock();
 	return ret;
@@ -746,9 +746,9 @@ static s32 __bmgr_pool_remove(u8 pool_id, bool lock)
 	pool = &db->pools[pool_id];
 
 	/* free pointers_table */
-	dma_free_coherent(NULL, pool->internal_ptrs_sz,
-			  (void *)pool->internal_ptrs_virt,
-			  pool->internal_ptrs_phys);
+	pp_dma_free(pool->internal_ptrs_sz,
+		    (void *)pool->internal_ptrs_virt,
+		    &pool->internal_ptrs_phys);
 
 	/* Reset pool config */
 	cfg.min_guaranteed_enable = false;
diff --git a/drivers/net/ppv4/pp-api/pp-misc/pp_misc.h b/drivers/net/ppv4/pp-api/pp-misc/pp_misc.h
index 230ec6241d1e..8837487e3018 100644
--- a/drivers/net/ppv4/pp-api/pp-misc/pp_misc.h
+++ b/drivers/net/ppv4/pp-api/pp-misc/pp_misc.h
@@ -29,9 +29,9 @@
  */
 struct pp_misc_init_param {
 	bool        valid;
-	u32         hw_clk;       /*! hw_clk HW Clock in MHz             */
+	u32         hw_clk;       /*! hw_clk HW Clock in MHz */
 	u32         ppv4_regs_sz; /*! size of ppv4 io registers in bytes */
-	phys_addr_t ppv4_base;    /*! PP HW phyisical base addres        */
+	phys_addr_t ppv4_base;    /*! PP HW phyisical base addres */
 	struct dentry *root_dbgfs;
 	struct dentry *hal_dbgfs;
 	struct kobject *sysfs;
diff --git a/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_fw.c b/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_fw.c
index a406ae0504a4..d683b3cf3e71 100644
--- a/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_fw.c
+++ b/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_fw.c
@@ -37,26 +37,6 @@ struct ppv4_qos_fw_sec {
 	u32 size;
 };
 
-void ddr_cache_flush(struct pp_qos_dev *qdev, void *addr, u32 size)
-{
-	if (!qdev) {
-		QOS_LOG_ERR("Qos device NULL\n");
-		return;
-	}
-
-	dma_map_single(pp_dev_get(), addr, size, DMA_TO_DEVICE);
-}
-
-void ddr_cache_invalidate(struct pp_qos_dev *qdev, void *addr, u32 size)
-{
-	if (!qdev) {
-		QOS_LOG_ERR("Qos device NULL\n");
-		return;
-	}
-
-	dma_map_single(pp_dev_get(), addr, size, DMA_FROM_DEVICE);
-}
-
 enum fw_soc_rev {
 	FW_SOC_REV_A = 0,
 	FW_SOC_REV_B,
@@ -262,8 +242,7 @@ s32 do_load_firmware(struct pp_qos_dev *qdev,
 			     ALIGN(stack_sz, align);
 	}
 
-	virt_txt = dmam_alloc_coherent(pp_dev_get(), alloc_size,
-				       &phys_txt, GFP_KERNEL);
+	virt_txt = pp_dma_alloc(alloc_size, GFP_KERNEL, &phys_txt);
 	if (!virt_txt) {
 		pr_err("Could not allocate %u bytes for fw\n", alloc_size);
 		kfree(secs);
@@ -293,23 +272,19 @@ s32 do_load_firmware(struct pp_qos_dev *qdev,
 
 	kfree(secs);
 
+	/* Write back all elf sections */
+	pp_cache_writeback(virt_txt, alloc_size);
+
 	/* Set Guard Regions */
 	PP_REG_WR32((ulong)qdev->init_params.qos_uc_base
 		    + PPV4_QOS_CMD_BUF_GUARD_OFFSET,
 		    PPV4_QOS_UC_GUARD_MAGIC);
 
-	/* Flush cache before uc read FW code */
-	ddr_cache_flush(qdev, virt_txt, alloc_size);
-
 	ret = wake_uc(wakeuc);
 	if (ret) {
 		pr_err("wake_uc failed\n");
 		return ret;
 	}
-
-	/* Invalidate cache */
-	ddr_cache_invalidate(qdev, virt_txt, alloc_size);
-
 	QOS_LOG_DEBUG("waked fw\n");
 
 	if (pp_reg_poll_x(qdev->init_params.fwcom.cmdbuf, U32_MAX,
@@ -1858,6 +1833,9 @@ static void create_update_port_tree_cmd(struct pp_qos_dev *qdev, u32 phy)
 	for (word_idx = 0; word_idx < QOS_MAX_NUM_QUEUES >> 5; word_idx++)
 		cmd.fw.bitmap[word_idx] = bitmap_word[word_idx];
 
+	pp_cache_writeback(qdev->hwconf.rlms_container,
+			   QOS_MAX_NUM_QUEUES * sizeof(u16));
+
 	/* Update BWL buffer before tree update */
 	update_bwl_buffer(qdev, phy);
 
@@ -1974,6 +1952,15 @@ void update_preds(struct pp_qos_dev *qdev, u32 phy, bool queue_port_changed)
 	}
 }
 
+void stats_identifier_put(struct pp_qos_dev *qdev, u32 cmd_size)
+{
+	u32 *addr;
+
+	addr = (u32 *)(qdev->hwconf.fw_stats_ddr_virt + cmd_size);
+	*addr = FW_OK_CODE;
+	pp_cache_writeback(addr, 4);
+}
+
 void create_get_port_stats_cmd(struct pp_qos_dev *qdev, u32 phy, u32 addr,
 			       struct pp_qos_port_stat *pstat)
 {
@@ -1982,10 +1969,7 @@ void create_get_port_stats_cmd(struct pp_qos_dev *qdev, u32 phy, u32 addr,
 	if (PP_QOS_DEVICE_IS_ASSERT(qdev))
 		return;
 
-	/* Put identifier at end of statistics buffer */
-	*(u32 *)(qdev->hwconf.fw_stats_ddr_virt +
-	sizeof(struct port_stats_s)) = FW_OK_CODE;
-
+	stats_identifier_put(qdev, sizeof(struct port_stats_s));
 	memset(&cmd, 0, sizeof(cmd));
 	cmd_init(qdev, &cmd.base, CMD_TYPE_GET_PORT_STATS,
 		 sizeof(cmd), CMD_FLAGS_POST_PROCESS_EXT, (void *)pstat,
@@ -2014,10 +1998,7 @@ void create_get_queue_stats_cmd(struct pp_qos_dev *qdev,
 	if (PP_QOS_DEVICE_IS_ASSERT(qdev))
 		return;
 
-	/* Put identifier at end of statistics buffer */
-	*(u32 *)(qdev->hwconf.fw_stats_ddr_virt +
-		sizeof(struct queue_stats_s)) = FW_OK_CODE;
-
+	stats_identifier_put(qdev, sizeof(struct queue_stats_s));
 	memset(&cmd, 0, sizeof(cmd));
 	cmd_init(qdev, &cmd.base, CMD_TYPE_GET_QUEUE_STATS,
 		 sizeof(cmd), CMD_FLAGS_POST_PROCESS_EXT, (void *)qstat,
@@ -2054,9 +2035,7 @@ void create_get_qm_stats_cmd(struct pp_qos_dev *qdev, u32 rlm, u32 addr,
 	if (PP_QOS_DEVICE_IS_ASSERT(qdev))
 		return;
 
-	/* Put identifier at end of statistics buffer */
-	*(u32 *)(qdev->hwconf.fw_stats_ddr_virt + sizeof(struct qm_info)) =
-	FW_OK_CODE;
+	stats_identifier_put(qdev, sizeof(struct qm_info));
 	memset(&cmd, 0, sizeof(cmd));
 	cmd_init(qdev, &cmd.base, CMD_TYPE_GET_QM_STATS,
 		 sizeof(cmd), CMD_FLAGS_POST_PROCESS_EXT, (void *)qstat,
@@ -2197,10 +2176,7 @@ void create_get_codel_stats_cmd(struct pp_qos_dev *qdev, u32 rlm, u32 addr,
 	if (PP_QOS_DEVICE_IS_ASSERT(qdev))
 		return;
 
-	/* Put identifier at end of statistics buffer */
-	*(u32 *)(qdev->hwconf.fw_stats_ddr_virt +
-	sizeof(struct codel_qstats_s)) = FW_OK_CODE;
-
+	stats_identifier_put(qdev, sizeof(struct codel_qstats_s));
 	memset(&cmd, 0, sizeof(cmd));
 	cmd_init(qdev, &cmd.base, CMD_TYPE_GET_CODEL_STATS,
 		 sizeof(cmd), CMD_FLAGS_POST_PROCESS_EXT, (void *)qstat,
@@ -2225,10 +2201,7 @@ void create_get_node_info_cmd(struct pp_qos_dev *qdev, u32 phy, u32 addr,
 	if (PP_QOS_DEVICE_IS_ASSERT(qdev))
 		return;
 
-	/* Put identifier at end of statistics buffer */
-	*(u32 *)(qdev->hwconf.fw_stats_ddr_virt +
-	sizeof(struct hw_node_info_s)) = FW_OK_CODE;
-
+	stats_identifier_put(qdev, sizeof(struct hw_node_info_s));
 	memset(&cmd, 0, sizeof(cmd));
 	cmd_init(qdev, &cmd.base, CMD_TYPE_GET_NODE_INFO,
 		 sizeof(cmd), CMD_FLAGS_POST_PROCESS_EXT, (void *)info,
@@ -2274,10 +2247,7 @@ void create_get_sys_info_cmd(struct pp_qos_dev *qdev,
 	if (PP_QOS_DEVICE_IS_ASSERT(qdev))
 		return;
 
-	/* Put identifier at end of statistics buffer */
-	*(u32 *)(qdev->hwconf.fw_stats_ddr_virt +
-	sizeof(struct system_stats_s)) = FW_OK_CODE;
-
+	stats_identifier_put(qdev, sizeof(struct system_stats_s));
 	memset(&cmd, 0, sizeof(cmd));
 	cmd_init(qdev, &cmd.base, CMD_TYPE_GET_SYSTEM_INFO,
 		 sizeof(cmd), CMD_FLAGS_POST_PROCESS_EXT, (void *)info,
@@ -2805,6 +2775,7 @@ static s32 post_process_external(struct pp_qos_dev *qdev,
 	struct qm_info *qminfo, *qminfo_ptr;
 	u32 stats_poll = 0;
 	u32 fw_signal = FW_OK_CODE;
+	volatile u32 *fw_signal_addr;
 	void *qinfo_entry;
 	void *response = NULL;
 	s32 ret = 0;
@@ -2814,8 +2785,11 @@ static s32 post_process_external(struct pp_qos_dev *qdev,
 
 	/* Validate statistics buffer is ready before read */
 	while (fw_signal == FW_OK_CODE) {
-		fw_signal = *(volatile u32 *)(qdev->hwconf.fw_stats_ddr_virt +
-				     dcmd->cmd.response_sz);
+		fw_signal_addr =
+			(volatile u32 *)(qdev->hwconf.fw_stats_ddr_virt +
+					 dcmd->cmd.response_sz);
+		pp_cache_invalidate(fw_signal_addr, 4);
+		fw_signal = *fw_signal_addr;
 		if (stats_poll++ > PP_REG_DFLT_RETRIES) {
 			QOS_LOG_ERR("DDR stats poll exceeded %u thr\n",
 				    PP_REG_DFLT_RETRIES);
@@ -3027,6 +3001,8 @@ s32 check_completion(struct pp_qos_dev *qdev)
 		QOS_ASSERT(ret == len,
 			   "Command queue does not contain a full command\n");
 		if (dcmd.cmd.flags & CMD_FLAGS_POST_PROCESS_EXT) {
+			pp_cache_invalidate(qdev->hwconf.fw_stats_ddr_virt,
+					    qdev->hwconf.fw_stats_sz);
 			ret = post_process_external(qdev, &dcmd);
 			if (ret)
 				return ret;
@@ -3055,8 +3031,10 @@ s32 check_completion(struct pp_qos_dev *qdev)
 	internals->pushed = 0;
 
 	memset((void *)qdev->hwconf.bwl_ddr_virt, 0, qdev->hwconf.bwl_sz);
-	memset(qdev->hwconf.sbwl_ddr_virt, 0, qdev->hwconf.sbwl_sz);
+	pp_cache_writeback(qdev->hwconf.bwl_ddr_virt, qdev->hwconf.bwl_sz);
 
+	memset(qdev->hwconf.sbwl_ddr_virt, 0, qdev->hwconf.sbwl_sz);
+	pp_cache_writeback(qdev->hwconf.sbwl_ddr_virt, qdev->hwconf.sbwl_sz);
 	return 0;
 }
 
@@ -3082,6 +3060,8 @@ void print_fw_log(struct pp_qos_dev *qdev)
 	unsigned long msg_addr;
 	unsigned long addr, cur;
 
+	pp_cache_invalidate(qdev->hwconf.fw_logger_ddr_virt,
+			    qdev->hwconf.fw_logger_sz);
 	addr = (unsigned long)(qdev->hwconf.fw_logger_ddr_virt);
 	num_messages = *(u32 *)(addr + PPV4_QOS_LOGGER_WRITE_IDX_OFFSET);
 	msg_read_count = *(u32 *)(addr + PPV4_QOS_LOGGER_READ_IDX_OFFSET);
@@ -3108,6 +3088,7 @@ void print_fw_log(struct pp_qos_dev *qdev)
 
 	/* When done write the correct read count */
 	*(u32 *)(addr + PPV4_QOS_LOGGER_READ_IDX_OFFSET) = num_messages;
+	pp_cache_writeback((void *)addr + PPV4_QOS_LOGGER_READ_IDX_OFFSET, 4);
 }
 
 /* Post commands to be pushed at the end of cmdq */
diff --git a/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_main.c b/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_main.c
index 074d646eee7b..b47004188059 100644
--- a/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_main.c
+++ b/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_main.c
@@ -659,6 +659,8 @@ s32 store_queue_list_max_allowed(struct pp_qos_dev *qdev,
 		*(u32 *)addr = node->data.queue.max_allowed;
 		rlms++;
 	}
+	pp_cache_writeback(qdev->hwconf.max_allow_ddr_virt,
+			   qdev->hwconf.max_allow_sz);
 
 	/* Read last address to make sure data is written */
 	if (addr)
@@ -3893,8 +3895,7 @@ s32 __qos_ddr_allocate(struct pp_qos_dev *qdev)
 	cfg->qm_sz = PAGE_ALIGN(qdev->init_params.wred_total_avail_resources *
 				PPV4_QOS_DESC_SIZE);
 
-	cfg->qm_ddr_virt = dma_zalloc_coherent(NULL, cfg->qm_sz,
-					       &dma, GFP_KERNEL);
+	cfg->qm_ddr_virt = pp_dma_alloc(cfg->qm_sz, GFP_KERNEL, &dma);
 	if (unlikely(!cfg->qm_ddr_virt)) {
 		pr_err("Could not allocate %u bytes for queue manager\n",
 		       (u32)cfg->qm_sz);
@@ -3912,9 +3913,8 @@ s32 __qos_ddr_allocate(struct pp_qos_dev *qdev)
 
 	/* Allocate FW Logger buffer */
 	cfg->fw_logger_sz = PAGE_ALIGN(PPV4_QOS_LOGGER_BUF_SIZE);
-	cfg->fw_logger_ddr_virt = dma_zalloc_coherent(NULL, cfg->fw_logger_sz,
-						      &cfg->fw_logger_ddr_phys,
-						      GFP_KERNEL);
+	cfg->fw_logger_ddr_virt = pp_dma_alloc(cfg->fw_logger_sz, GFP_KERNEL,
+					       &cfg->fw_logger_ddr_phys);
 	if (unlikely(!cfg->fw_logger_ddr_virt)) {
 		pr_err("Could not allocate %u bytes for logger\n",
 		       (u32)cfg->fw_logger_sz);
@@ -3923,9 +3923,8 @@ s32 __qos_ddr_allocate(struct pp_qos_dev *qdev)
 
 	/* Allocate FW Statistics buffer */
 	cfg->fw_stats_sz = PAGE_ALIGN(PPV4_QOS_STAT_SIZE);
-	cfg->fw_stats_ddr_virt = dma_zalloc_coherent(NULL, cfg->fw_stats_sz,
-						     &cfg->fw_stats_ddr_phys,
-						     GFP_KERNEL);
+	cfg->fw_stats_ddr_virt = pp_dma_alloc(cfg->fw_stats_sz, GFP_KERNEL,
+					      &cfg->fw_stats_ddr_phys);
 	if (unlikely(!cfg->fw_stats_ddr_virt)) {
 		pr_err("Could not allocate %u bytes for stats buffer\n",
 		       (u32)cfg->fw_stats_sz);
@@ -3935,10 +3934,8 @@ s32 __qos_ddr_allocate(struct pp_qos_dev *qdev)
 	/* Allocate max allowed buffer */
 	cfg->max_allow_sz =
 		PAGE_ALIGN(qdev->init_params.max_queues * sizeof(u32));
-	cfg->max_allow_ddr_virt =
-		dma_zalloc_coherent(NULL, cfg->max_allow_sz,
-				    &cfg->max_allow_ddr_phys,
-				    GFP_KERNEL);
+	cfg->max_allow_ddr_virt = pp_dma_alloc(cfg->max_allow_sz, GFP_KERNEL,
+					       &cfg->max_allow_ddr_phys);
 	if (unlikely(!cfg->max_allow_ddr_virt)) {
 		pr_err("Could not allocate %u bytes for max allowed buffer\n",
 		       (u32)cfg->max_allow_sz);
@@ -3962,10 +3959,8 @@ s32 __qos_ddr_allocate(struct pp_qos_dev *qdev)
 
 	/* Allocate BWL allowed buffer */
 	cfg->bwl_sz = PAGE_ALIGN(NUM_OF_NODES * sizeof(u32));
-	cfg->bwl_ddr_virt =
-		dma_zalloc_coherent(NULL, cfg->bwl_sz,
-				    &cfg->bwl_ddr_phys,
-				    GFP_KERNEL);
+	cfg->bwl_ddr_virt = pp_dma_alloc(cfg->bwl_sz, GFP_KERNEL,
+					 &cfg->bwl_ddr_phys);
 	if (unlikely(!cfg->bwl_ddr_virt)) {
 		pr_err("Could not allocate %u bytes for bwl buffer\n",
 		       (u32)cfg->bwl_sz);
@@ -3974,10 +3969,8 @@ s32 __qos_ddr_allocate(struct pp_qos_dev *qdev)
 
 	/* Allocate SBWL allowed buffer */
 	cfg->sbwl_sz = PAGE_ALIGN(NUM_OF_NODES * sizeof(u32));
-	cfg->sbwl_ddr_virt =
-		dma_zalloc_coherent(NULL, cfg->sbwl_sz,
-				    &cfg->sbwl_ddr_phys,
-				    GFP_KERNEL);
+	cfg->sbwl_ddr_virt = pp_dma_alloc(cfg->sbwl_sz, GFP_KERNEL,
+					  &cfg->sbwl_ddr_phys);
 	if (unlikely(!cfg->sbwl_ddr_virt)) {
 		pr_err("Could not allocate %u bytes for sbwl buffer\n",
 		       (u32)cfg->sbwl_sz);
@@ -3987,9 +3980,7 @@ s32 __qos_ddr_allocate(struct pp_qos_dev *qdev)
 	return 0;
 
 sbwl_alloc_err:
-	dma_free_coherent(NULL, cfg->bwl_sz,
-			  cfg->bwl_ddr_virt,
-			  cfg->bwl_ddr_phys);
+	pp_dma_free(cfg->bwl_sz, cfg->bwl_ddr_virt, &cfg->bwl_ddr_phys);
 
 bwl_alloc_err:
 	kfree(qdev->hwconf.rlms_container);
@@ -3999,26 +3990,26 @@ s32 __qos_ddr_allocate(struct pp_qos_dev *qdev)
 
 api_str_alloc_err:
 	/* Free max allowed buffer */
-	dma_free_coherent(NULL, cfg->max_allow_sz,
-			  cfg->max_allow_ddr_virt,
-			  cfg->max_allow_ddr_phys);
+	pp_dma_free(cfg->max_allow_sz,
+		    cfg->max_allow_ddr_virt,
+		    &cfg->max_allow_ddr_phys);
 
 max_allowed_alloc_err:
 	/* Free stats buffer */
-	dma_free_coherent(NULL, cfg->fw_stats_sz,
-			  cfg->fw_stats_ddr_virt,
-			  cfg->fw_stats_ddr_phys);
+	pp_dma_free(cfg->fw_stats_sz,
+		    cfg->fw_stats_ddr_virt,
+		    &cfg->fw_stats_ddr_phys);
 
 stats_alloc_err:
 	/* Free Logger */
