From 2c1c0c6b826676548d73aaf94a615d40b2614d34 Mon Sep 17 00:00:00 2001
From: ofirbitt <ofir1.bitton@intel.com>
Date: Thu, 19 Sep 2019 09:04:16 +0300
Subject: [PATCH] PONRTSYS-5043 - DP fix PP QoS Queue block issue

---
 .../net/datapath/dpm/gswip31/datapath_ppv4_api.c   | 24 +++++++++++++++---
 .../net/datapath/dpm/gswip32/datapath_ppv4_api.c   | 29 +++++++++++++++++-----
 2 files changed, 44 insertions(+), 9 deletions(-)

diff --git a/drivers/net/datapath/dpm/gswip31/datapath_ppv4_api.c b/drivers/net/datapath/dpm/gswip31/datapath_ppv4_api.c
index a74eb4516ba0..5d6714b8f36d 100644
--- a/drivers/net/datapath/dpm/gswip31/datapath_ppv4_api.c
+++ b/drivers/net/datapath/dpm/gswip31/datapath_ppv4_api.c
@@ -267,6 +267,21 @@ static int get_cqm_deq_port_by_node(int inst, int node_id, int flag)
 	return DP_FAILURE;
 }
 
+static int dp_qos_queue_set_spl_31(struct pp_qos_dev *qdev,
+				   unsigned int node_id,
+				   unsigned int qid,
+				   struct pp_qos_queue_conf *cfg)
+{
+	/* To set queue to blocking state during Q movement */
+	cfg->blocked = 1;
+	if (qos_queue_set(qdev, node_id, cfg)) {
+		pr_err("qos_queue_set fail: q[%d/%d]\n",
+		       qid, node_id);
+		return DP_FAILURE;
+	}
+	return DP_SUCCESS;
+}
+
 #ifndef DP_FLUSH_VIA_AUTO
 static int cqm_queue_flush_31(int cqm_inst, int cqm_drop_port, int qid)
 {
@@ -365,7 +380,8 @@ static int queue_flush_31(int inst, int node_id, int flag)
 		tmp_q_cfg.wred_enable = 0;
 		tmp_q_cfg.queue_wred_max_allowed = DEF_QRED_MAX_ALLOW;
 		tmp_q_cfg.queue_child_prop.parent = priv->ppv4_drop_p;
-		if (qos_queue_set(priv->qdev, node_id, &tmp_q_cfg)) {
+		if (dp_qos_queue_set_spl_31(priv->qdev, node_id, qid,
+					    &tmp_q_cfg)) {
 			pr_err("qos_queue_set fail for queue=%d to parent=%d\n",
 			       qid, tmp_q_cfg.queue_child_prop.parent);
 			goto EXIT;
@@ -390,7 +406,8 @@ static int queue_flush_31(int inst, int node_id, int flag)
 		/* move back the queue to original parent
 		 * with orignal variable queue_cfg
 		 */
-		if (qos_queue_set(priv->qdev, node_id, &queue_cfg)) {
+		if (dp_qos_queue_set_spl_31(priv->qdev, node_id, qid,
+					    &queue_cfg)) {
 			pr_err("qos_queue_conf_get fail: q[%d/%d]\n",
 			       qid, node_id);
 			res = DP_FAILURE;
@@ -2313,7 +2330,8 @@ static int dp_link_set(struct dp_node_link *info, int parent_node, int flag)
 			 info->p_node_id.cqm_deq_port,
 			 queue_cfg->queue_child_prop.parent,
 			 info->cqm_deq_port.cqm_deq_port);
-		if (qos_queue_set(priv->qdev, node_id, queue_cfg)) {
+		if (dp_qos_queue_set_spl_31(priv->qdev, node_id,
+					    info->node_id.q_id, queue_cfg)) {
 			pr_err("failed to qos_queue_set\n");
 			qos_queue_remove(priv->qdev, node_id);
 			goto ERROR_EXIT;
diff --git a/drivers/net/datapath/dpm/gswip32/datapath_ppv4_api.c b/drivers/net/datapath/dpm/gswip32/datapath_ppv4_api.c
index 926c9c0bd102..ade53c89baa9 100644
--- a/drivers/net/datapath/dpm/gswip32/datapath_ppv4_api.c
+++ b/drivers/net/datapath/dpm/gswip32/datapath_ppv4_api.c
@@ -300,6 +300,21 @@ static int get_cqm_deq_port_by_node(int inst, int node_id, int flag)
 	return DP_FAILURE;
 }
 
+static int dp_qos_queue_set_spl_32(struct pp_qos_dev *qdev,
+				   unsigned int node_id,
+				   unsigned int qid,
+				   struct pp_qos_queue_conf *cfg)
+{
+	/* To set queue to blocking state during Q movement */
+	cfg->blocked = 1;
+	if (qos_queue_set(qdev, node_id, cfg)) {
+		pr_err("qos_queue_set fail: q[%d/%d]\n",
+		       qid, node_id);
+		return DP_FAILURE;
+	}
+	return DP_SUCCESS;
+}
+
 #ifndef DP_FLUSH_VIA_AUTO
 static int cqm_queue_flush_32(int cqm_inst, int cqm_drop_port, int qid)
 {
@@ -398,10 +413,10 @@ static int queue_flush_32(int inst, int node_id, int flag)
 		qos_queue_conf_set_default_32(&tmp_q_cfg); /*use new variable */
 		dp_wred_def(&tmp_q_cfg);
 		tmp_q_cfg.queue_child_prop.parent = priv->ppv4_drop_p;
-		if (qos_queue_set_32(priv->qdev, node_id, &tmp_q_cfg)) {
-			pr_err(
-			    "qos_queue_set_32 fail for queue=%d to parent=%d\n",
-			    qid, tmp_q_cfg.queue_child_prop.parent);
+		if (dp_qos_queue_set_spl_32(priv->qdev, node_id, qid,
+					    &tmp_q_cfg)) {
+			pr_err("qos_queue_set_32 fail for queue=%d to parent=%d\n",
+			       qid, tmp_q_cfg.queue_child_prop.parent);
 			goto EXIT;
 		}
 		DP_DEBUG(DP_DBG_FLAG_QOS,
@@ -424,7 +439,8 @@ static int queue_flush_32(int inst, int node_id, int flag)
 		/* move back the queue to original parent
 		 * with orignal variable queue_cfg
 		 */
-		if (qos_queue_set_32(priv->qdev, node_id, &queue_cfg)) {
+		if (dp_qos_queue_set_spl_32(priv->qdev, node_id, qid,
+					    &queue_cfg)) {
 			pr_err("qos_queue_conf_get_32 fail: q[%d/%d]\n",
 			       qid, node_id);
 			res = DP_FAILURE;
@@ -2230,7 +2246,8 @@ static int dp_link_set(struct dp_node_link *info, int parent_node, int flag)
 			 info->p_node_id.cqm_deq_port,
 			 queue_cfg->queue_child_prop.parent,
 			 info->cqm_deq_port.cqm_deq_port);
-		if (qos_queue_set_32(priv->qdev, node_id, queue_cfg)) {
+		if (dp_qos_queue_set_spl_32(priv->qdev, node_id,
+					    info->node_id.q_id, queue_cfg)) {
 			pr_err("failed to qos_queue_set_32\n");
 			qos_queue_remove_32(priv->qdev, node_id);
 			goto ERROR_EXIT;
