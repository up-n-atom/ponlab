From a0c3c5f0abac3a4ae4cfa64aa2c7769119748f20 Mon Sep 17 00:00:00 2001
From: arathinx <ayyappanx.rathinam@intel.com>
Date: Tue, 2 Jun 2020 17:53:53 +0800
Subject: [PATCH] PONRTSYS-7427: Cannot get Xpcs pdef for eth0_1 error printed

---
 drivers/net/ethernet/lantiq/ltq_eth_drv_xrx500.c | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/drivers/net/ethernet/lantiq/ltq_eth_drv_xrx500.c b/drivers/net/ethernet/lantiq/ltq_eth_drv_xrx500.c
index ef8afb44f721..903c8184077d 100644
--- a/drivers/net/ethernet/lantiq/ltq_eth_drv_xrx500.c
+++ b/drivers/net/ethernet/lantiq/ltq_eth_drv_xrx500.c
@@ -624,6 +624,7 @@ static int eth_serdes_power(struct net_device *dev, bool up)
 /* open the network device interface*/
 static int ltq_eth_open(struct net_device *dev)
 {
+	struct ltq_eth_priv *priv = netdev_priv(dev);
 	int ret;
 
 	pr_debug("%s called for device %s\n", __func__, dev->name);
@@ -643,7 +644,8 @@ static int ltq_eth_open(struct net_device *dev)
 		return -1;
 	}
 
-	eth_serdes_power(dev, true);
+	if (of_device_is_available(priv->xpcs_node))
+		eth_serdes_power(dev, true);
 
 	return 0;
 }
@@ -651,11 +653,13 @@ static int ltq_eth_open(struct net_device *dev)
 /* Stop the network device interface*/
 static int ltq_eth_stop(struct net_device *dev)
 {
+	struct ltq_eth_priv *priv = netdev_priv(dev);
 	int ret;
 
 	pr_debug("%s called for device %s\n", __func__, dev->name);
 
-	eth_serdes_power(dev, false);
+	if (of_device_is_available(priv->xpcs_node))
+		eth_serdes_power(dev, false);
 
 	ret = dp_rx_enable(dev, dev->name, DP_RX_DISABLE);
 
