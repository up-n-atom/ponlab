+
+s32 uc_tdox_dbg_state_set(u16 tdox_id, enum tdox_uc_state state)
+{
+	u32 word_offset, bit_offset, states_word, offset;
+
+	if (tdox_id >= UC_MAX_TDOX_SESSIONS)
+		return -EINVAL;
+
+	word_offset = (tdox_id / 4) * 4; /* Round down */
+	offset = tdox_state_arr_offset + word_offset;
+	bit_offset = (tdox_id % 4) * BITS_PER_BYTE;
+	states_word = PP_REG_RD32(UC_SSRAM(EGRESS, offset));
+	states_word &= ~(0xFF << bit_offset);
+	states_word |= state << bit_offset;
+	PP_REG_WR32(UC_SSRAM(EGRESS, offset), states_word);
+
+	return 0;
+}
+
+s32 uc_tdox_state_get(u16 tdox_id, enum tdox_uc_state *state)
+{
+	u32 offset;
+
+	if (tdox_id >= UC_MAX_TDOX_SESSIONS)
+		return -EINVAL;
+
+	offset = tdox_state_arr_offset + tdox_id;
+	*state = PP_REG_RD8(UC_SSRAM(EGRESS, offset));
+
+	pr_debug("Tdox record %u. state %u. state addr %#x\n", tdox_id, *state,
+		 (u32)UC_SSRAM(EGRESS, offset));
+
+	return 0;
+}
