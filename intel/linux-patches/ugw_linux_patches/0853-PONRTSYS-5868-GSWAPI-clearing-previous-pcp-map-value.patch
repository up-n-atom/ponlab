From f2b1114b186552916b0e8ca5a911aac3d6d5b0ac Mon Sep 17 00:00:00 2001
From: Dinesh Sudham <dineshx.sudham@intel.com>
Date: Tue, 12 Nov 2019 11:46:49 +0800
Subject: [PATCH] PONRTSYS-5868: GSWAPI: clearing previous pcp map value before
 setting new value

---
 drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c b/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c
index cad2d61a381e..1a782e2490c0 100644
--- a/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c
+++ b/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c
@@ -19047,6 +19047,8 @@ GSW_return_t GSW_QOS_Dscp2PcpTableSet(void *cdev, GSW_DSCP2PCP_map_t *parm)
 		/*Address-based read - make sure the other pointer values are not disturbed*/
 		tbl_prog.table = PCE_DSCP2PCP_INDEX;
 		gsw_pce_table_read(cdev, &tbl_prog);
+		/*Clear the previous value before setting to new value */
+		tbl_prog.val[reg_index] &= ~(0x7 << bitshift);
 		/*Set map DSCP value to PCP value in PCE_TBL_VAL 0 or PCE_TBL_VAL 1
 		based on DSCP2PCP pointer index*/
 		tbl_prog.val[reg_index] |= ((parm->nMap[dscp] & 0x7) << bitshift);
