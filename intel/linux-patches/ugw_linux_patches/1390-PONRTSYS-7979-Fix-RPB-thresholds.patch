From 03eb1159a13741a6bcecdeef55ee0b3cc0f8dd91 Mon Sep 17 00:00:00 2001
From: avishalo <avi1.shalom@intel.com>
Date: Thu, 16 Jul 2020 10:56:37 +0300
Subject: [PATCH] PONRTSYS-7979 : Fix RPB thresholds

Signed-off-by: avishalo <avi1.shalom@intel.com>
---
 drivers/net/ppv4/pp-hal/receive-packet-buffer/rpb.c | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/drivers/net/ppv4/pp-hal/receive-packet-buffer/rpb.c b/drivers/net/ppv4/pp-hal/receive-packet-buffer/rpb.c
index d45d5039dfed..4555cb872620 100644
--- a/drivers/net/ppv4/pp-hal/receive-packet-buffer/rpb.c
+++ b/drivers/net/ppv4/pp-hal/receive-packet-buffer/rpb.c
@@ -1122,9 +1122,15 @@ static void __rpb_default_profile_init(void)
 	/* global bytes watermarks */
 	prof_cfg->high_thr = db->mem_sz - (1  * ETH_FRAME_LEN);
 	prof_cfg->low_thr  = db->mem_sz - (10 * ETH_FRAME_LEN);
+
 	/* global packets watermarks */
-	prof_cfg->pkt_high_thr = db->max_pending_pkts - 1;
-	prof_cfg->pkt_low_thr  = db->max_pending_pkts - 10;
+	if (db->max_pending_pkts > 500) {
+		prof_cfg->pkt_high_thr = db->max_pending_pkts - 148;
+		prof_cfg->pkt_low_thr  = db->max_pending_pkts - 348;
+	} else {
+		prof_cfg->pkt_high_thr = db->max_pending_pkts - 5;
+		prof_cfg->pkt_low_thr  = db->max_pending_pkts - 10;
+	}
 
 	/* set port pool size base on his type */
 	prof_cfg->port[RPB_PORT_STR_FLOW0].pool_sz = (db->mem_sz * 3) / 8 -
