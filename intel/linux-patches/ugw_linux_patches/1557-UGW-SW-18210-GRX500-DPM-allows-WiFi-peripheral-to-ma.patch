From: agaraix <anath.bandux.garai@intel.com>
Date: Thu, 19 Jul 2018 09:02:50 +0530
Subject: [PATCH] UGW_SW-18210 : GRX500 DPM allows WiFi peripheral to mark wmm
 tid in tx_desc dw1[7:4]

---
 drivers/net/datapath/dpm/gswip30/datapath_misc.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/drivers/net/datapath/dpm/gswip30/datapath_misc.c b/drivers/net/datapath/dpm/gswip30/datapath_misc.c
index 1cc6b803eab8..2242a60a49fe 100644
--- a/drivers/net/datapath/dpm/gswip30/datapath_misc.c
+++ b/drivers/net/datapath/dpm/gswip30/datapath_misc.c
@@ -64,6 +64,7 @@ static void init_dma_desc_mask(void)
 	dma_tx_desc_mask1.field.mpe1 = 0x1;
 	dma_tx_desc_mask1.field.color = 0x3;
 	dma_tx_desc_mask1.field.ep = 0xF;
+	dma_tx_desc_mask1.field.resv1 = 0xF; /* mask for WMM */
 }
 
 static void init_dma_pmac_template(int portid, u32 flags)
