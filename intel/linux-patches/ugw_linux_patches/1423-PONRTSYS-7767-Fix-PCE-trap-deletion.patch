From d552bd8da33e8798427145ffc692fe2850d23bbc Mon Sep 17 00:00:00 2001
From: Jan Dominiak <janx.dominiak@intel.com>
Date: Fri, 25 Sep 2020 12:08:40 +0200
Subject: [PATCH] PONRTSYS-7767: Fix PCE trap deletion

---
 drivers/net/datapath/pon_qos/pon_qos_tc_trap.c | 20 ++++++++++++++------
 1 file changed, 14 insertions(+), 6 deletions(-)

diff --git a/drivers/net/datapath/pon_qos/pon_qos_tc_trap.c b/drivers/net/datapath/pon_qos/pon_qos_tc_trap.c
index 4aa556c19c40..a29dbd9fc7ca 100644
--- a/drivers/net/datapath/pon_qos/pon_qos_tc_trap.c
+++ b/drivers/net/datapath/pon_qos/pon_qos_tc_trap.c
@@ -21,6 +21,8 @@ LIST_HEAD(tc_trap_storage);
 struct pce_rule_storage {
 	/** TC command handle used as dual identificator */
 	s32 handle;
+	/** TC command preference used as dual identificator */
+	int pref;
 	/** Logical Port Id. The valid range is hardware dependent */
 	u32 logicalportid;
 	/** Sub interface ID group,
@@ -253,7 +255,8 @@ static void pon_qos_trap_set_traffic_class(struct net_device *dev,
 static int pon_qos_trap_storage_add(struct net_device *dev,
 				    GSW_PCE_rule_t *pce_rule,
 				    struct dp_pce_blk_info *pce_blk_info,
-				    uint32_t tc_handle)
+				    uint32_t tc_handle,
+				    int pref)
 {
 	struct pce_rule_storage *pce_rule_storage;
 
@@ -262,6 +265,7 @@ static int pon_qos_trap_storage_add(struct net_device *dev,
 		return -ENOMEM;
 
 	pce_rule_storage->handle = tc_handle;
+	pce_rule_storage->pref = pref;
 	pce_rule_storage->nIndex = pce_rule->pattern.nIndex;
 	pce_rule_storage->logicalportid = pce_rule->logicalportid;
 	pce_rule_storage->subifidgroup = pce_rule->subifidgroup;
@@ -279,6 +283,7 @@ int pon_qos_trap_offload(struct net_device *dev,
 {
 	struct dp_pce_blk_info *pce_blk_info;
 	GSW_PCE_rule_t *pce_rule;
+	int pref = f->common.prio >> 16;
 	int ret, index;
 
 	pce_rule = kzalloc(sizeof(*pce_rule), GFP_ATOMIC);
@@ -322,10 +327,12 @@ int pon_qos_trap_offload(struct net_device *dev,
 		kfree(pce_blk_info);
 		return -1;
 	}
-	netdev_info(dev, "%s: pce rule added with index %d\n", __func__, index);
+	netdev_dbg(dev, "%s: pce rule added with index %d\n", __func__, index);
 
 	/* Save data needed for rule deletion */
-	ret = pon_qos_trap_storage_add(dev, pce_rule, pce_blk_info, tc_handle);
+	ret = pon_qos_trap_storage_add(dev, pce_rule,
+				       pce_blk_info,
+				       tc_handle, pref);
 	if (ret != DP_SUCCESS) {
 		kfree(pce_rule);
 		kfree(pce_blk_info);
@@ -351,11 +358,12 @@ int pon_qos_trap_unoffload(struct net_device *dev,
 	struct dp_pce_blk_info pce_blk_info = {0};
 	struct pce_rule_storage *p;
 	GSW_PCE_ruleDelete_t *pce_rule;
+	int pref = f->common.prio >> 16;
 	bool deletion = false;
 	int ret;
 
 	list_for_each_entry(p, &tc_trap_storage, list) {
-		if (tc_handle == p->handle) {
+		if (tc_handle == p->handle && pref == p->pref) {
 			deletion = true;
 			break;
 		}
@@ -395,11 +403,11 @@ int pon_qos_trap_unoffload(struct net_device *dev,
 
 	ret = dp_pce_rule_del(&pce_blk_info, pce_rule);
 	if (ret < 0) {
-		netdev_info(dev, "%s: dp_pce_rule_del failed err %d\n",
+		netdev_err(dev, "%s: dp_pce_rule_del failed err %d\n",
 			    __func__, ret);
 		return -1;
 	}
-	netdev_info(dev, "%s: deleted pce rule with index %d\n", __func__,
+	netdev_dbg(dev, "%s: deleted pce rule with index %d\n", __func__,
 		    pce_rule->nIndex);
 
 	list_del(&p->list);
