From f6cc265236a5e9c65e643529de25071f15ead6f5 Mon Sep 17 00:00:00 2001
From: arathinx <ayyappanx.rathinam@intel.com>
Date: Wed, 17 Jun 2020 11:51:18 +0800
Subject: [PATCH] DRVLIB_SW-3672: Resolve assignment in condition warning in
 phy driver

---
 drivers/phy/intel/phy-intel-combo.c    | 5 ++++-
 drivers/phy/intel/phy-intel-wan-xpcs.c | 5 ++++-
 2 files changed, 8 insertions(+), 2 deletions(-)

diff --git a/drivers/phy/intel/phy-intel-combo.c b/drivers/phy/intel/phy-intel-combo.c
index edd200c5c8a4..7fabb284f15b 100644
--- a/drivers/phy/intel/phy-intel-combo.c
+++ b/drivers/phy/intel/phy-intel-combo.c
@@ -1062,6 +1062,7 @@ intel_combo_phy_serdes_write(struct file *s, const char __user *buffer,
 	u32 main_cur = 0, pre_cur = 0, post_cur = 0;
 	char buf[32] = {0};
 	size_t buf_size;
+	int ret;
 
 	if (!capable(CAP_SYS_ADMIN))
 		return -EPERM;
@@ -1071,7 +1072,9 @@ intel_combo_phy_serdes_write(struct file *s, const char __user *buffer,
 
 	memset(buf, 0, sizeof(buf));
 	buf_size = min(count, sizeof(buf) - 1);
-	if (copy_from_user(buf, buffer, buf_size))
+
+	ret = copy_from_user(buf, buffer, buf_size);
+	if (ret)
 		return -EFAULT;
 
 	if (strcmp(buf, "help") == 0)
diff --git a/drivers/phy/intel/phy-intel-wan-xpcs.c b/drivers/phy/intel/phy-intel-wan-xpcs.c
index 5704219d81dd..ffadc7c70e1e 100644
--- a/drivers/phy/intel/phy-intel-wan-xpcs.c
+++ b/drivers/phy/intel/phy-intel-wan-xpcs.c
@@ -102,6 +102,7 @@ intel_wan_xpcs_phy_serdes_write(struct file *s, const char __user *buffer,
 	u32 main_cur = 0, pre_cur = 0, post_cur = 0;
 	char buf[32] = {0};
 	size_t buf_size;
+	int ret;
 
 	if (!capable(CAP_SYS_ADMIN))
 		return -EPERM;
@@ -111,7 +112,9 @@ intel_wan_xpcs_phy_serdes_write(struct file *s, const char __user *buffer,
 
 	memset(buf, 0, sizeof(buf));
 	buf_size = min(count, sizeof(buf) - 1);
-	if (copy_from_user(buf, buffer, buf_size))
+
+	ret = copy_from_user(buf, buffer, buf_size);
+	if (ret)
 		return -EFAULT;
 
 	if (strcmp(buf, "help") == 0)
