From 7d28e5522a9d2688fc0cc7d6459cf09628e0a9ec Mon Sep 17 00:00:00 2001
From: Xu Liang <liang.xu@intel.com>
Date: Sun, 7 Jun 2020 12:12:03 +0800
Subject: [PATCH] PONRTSYS-7568: GSW API - fix comments for ingress/egress BP
 state check

---
 drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c | 4 +++-
 drivers/net/ethernet/lantiq/switch-api/gsw_tbl_rw.c    | 4 ++--
 2 files changed, 5 insertions(+), 3 deletions(-)

diff --git a/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c b/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c
index 7f8be442b8ad..01392a1c0239 100644
--- a/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c
+++ b/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c
@@ -2068,7 +2068,6 @@ static int gsw2x_msw_table_rm(void *cdev, GSW_multicastTable_t *parm)
 	return GSW_statusOk;
 }
 #endif /*CONFIG_LTQ_MULTICAST */
-#if	((defined(CONFIG_LTQ_STP) && CONFIG_LTQ_STP) ||  (defined(CONFIG_LTQ_8021X) && CONFIG_LTQ_8021X))
 
 static inline int gswip31_stp_chk(ethsw_api_dev_t *gswdev, pctbl_prog_t *ig,
 				  pctbl_prog_t *eg)
@@ -2078,11 +2077,14 @@ static inline int gswip31_stp_chk(ethsw_api_dev_t *gswdev, pctbl_prog_t *ig,
 	if (!IS_VRSN_31(gswdev->gipver))
 		return 0;
 
+	/* The port state defined in 802.1X should be same on both ingress
+	   and egress bridge port configuration. */
 	vig = ig->val[0] & 7;
 	veg = eg->val[0] & 7;
 	return vig == veg ? 0 : 1;
 }
 
+#if	((defined(CONFIG_LTQ_STP) && CONFIG_LTQ_STP) ||  (defined(CONFIG_LTQ_8021X) && CONFIG_LTQ_8021X))
 /* Function: Internal function to program the registers */
 /* when 802.1x and STP API are called. */
 /* Description: Referene the matrix table to program the  */
diff --git a/drivers/net/ethernet/lantiq/switch-api/gsw_tbl_rw.c b/drivers/net/ethernet/lantiq/switch-api/gsw_tbl_rw.c
index ccdec51920a4..fc38d7f76409 100644
--- a/drivers/net/ethernet/lantiq/switch-api/gsw_tbl_rw.c
+++ b/drivers/net/ethernet/lantiq/switch-api/gsw_tbl_rw.c
@@ -667,8 +667,8 @@ int gsw_pce_table_read(void *cdev, pctbl_prog_t *ptdata)
 			continue;
 
 		/* Go through port state at val[0] and port map at val[10~18]
-		   to ensure at lease 1 valid non-zero value is available for
-		   reading and table entry load is completed.
+		   to ensure at least 1 valid non-zero value is available for
+		   reading and table entry is completely loaded.
 		 */
 		val = ptdata->val[0];
 		for (i = 10; i < 18; i++)
