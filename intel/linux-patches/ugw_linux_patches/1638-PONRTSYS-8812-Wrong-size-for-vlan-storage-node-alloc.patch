From 250933e8641637ee9e781d7a29d40c451c9df9ee Mon Sep 17 00:00:00 2001
From: "Lenzeder, Joerg" <joerg.lenzeder@intel.com>
Date: Wed, 7 Apr 2021 18:06:55 +0200
Subject: [PATCH] PONRTSYS-8812: Wrong size for vlan storage node allocation

Size parameter for memory allocation corrected
---
 drivers/net/datapath/pon_qos/pon_qos_tc_vlan_storage.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/net/datapath/pon_qos/pon_qos_tc_vlan_storage.c b/drivers/net/datapath/pon_qos/pon_qos_tc_vlan_storage.c
index 0f6883a90cf6..a0e98d11a1a9 100644
--- a/drivers/net/datapath/pon_qos/pon_qos_tc_vlan_storage.c
+++ b/drivers/net/datapath/pon_qos/pon_qos_tc_vlan_storage.c
@@ -37,7 +37,7 @@ int pon_qos_tc_vlan_storage_crt(struct net_device *dev,
 				enum tc_flower_vlan_tag tag,
 				struct pon_qos_vlan_storage_node **node)
 {
-	*node = kzalloc(sizeof(*node), GFP_KERNEL);
+	*node = kzalloc(sizeof(**node), GFP_KERNEL);
 	if (!*node) {
 		netdev_err(dev, "Out of memory!\n");
 		return -ENOMEM;
