From b761cd6aecea94ad3b9c39bd82ca4dd4678fe532 Mon Sep 17 00:00:00 2001
From: ofirbitt <ofir1.bitton@intel.com>
Date: Wed, 11 Dec 2019 14:05:24 +0200
Subject: [PATCH] PONRTSYS-6135: Disable PPv4 QoS default debug prints

---
 drivers/net/ppv4/pp-dev/pp_dev.c | 42 ----------------------------------------
 1 file changed, 42 deletions(-)

diff --git a/drivers/net/ppv4/pp-dev/pp_dev.c b/drivers/net/ppv4/pp-dev/pp_dev.c
index 72f7af2a3a33..ed59b32b30ad 100644
--- a/drivers/net/ppv4/pp-dev/pp_dev.c
+++ b/drivers/net/ppv4/pp-dev/pp_dev.c
@@ -17,7 +17,6 @@
 #include <linux/slab.h>
 #include <linux/clk.h>
 #include <linux/uaccess.h>
-#include <linux/fs.h>
 #include <linux/pp_qos_api.h>
 #include "pp_dev.h"
 #include "pp_common.h"
@@ -571,41 +570,6 @@ static void __pp_dev_exit(void)
 	pr_info("done\n");
 }
 
-#ifdef CONFIG_DYNAMIC_DEBUG
-#define DYNAMIC_DBG_FILENAME "/sys/kernel/debug/dynamic_debug/control"
-static s32 __enable_pr_debug(char *filename)
-{
-	struct file *f;
-	char *buffer;
-	s32 ret = 0;
-
-	buffer = kmalloc(PAGE_SIZE, GFP_KERNEL);
-	if (unlikely(!buffer))
-		return -ENOMEM;
-
-	f = filp_open(DYNAMIC_DBG_FILENAME, O_RDWR, 0600);
-	if (unlikely(IS_ERR(f))) {
-		pr_err("error opening %s\n", filename);
-		ret = -EIO;
-		goto out;
-	}
-
-	snprintf(buffer, PAGE_SIZE, "file %s +p\n", filename);
-
-#if LINUX_VERSION_CODE <= KERNEL_VERSION(4,13,16)
-	kernel_write(f, buffer, strlen(buffer) + 1, f->f_pos);
-#else
-	kernel_write(f, buffer, strlen(buffer) + 1, &f->f_pos);
-#endif
-	filp_close(f, NULL);
-
-out:
-	kfree(buffer);
-
-	return ret;
-}
-#endif
-
 /**
  * @brief PP driver late init call, mainly for initializing
  *        the UCs FWs
@@ -631,12 +595,6 @@ s32 pp_dev_late_init(void)
 	if (unlikely(ptr_is_null(dts_cfg)))
 		return -EPERM;
 
-#ifdef CONFIG_DYNAMIC_DEBUG
-	ret = __enable_pr_debug("pp_qos_main.c");
-	if (ret)
-		pr_err("Enabling debug failed\n");
-#endif
-
 	/* init pp uc */
 	ret = uc_init(&dts_cfg->uc_params);
 	if (unlikely(ret)) {
