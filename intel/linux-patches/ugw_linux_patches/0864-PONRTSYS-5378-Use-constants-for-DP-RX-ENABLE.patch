From f54397e0227ec59c9c2f1a260e029b782eeb2c81 Mon Sep 17 00:00:00 2001
From: Hauke Mehrtens <hauke.mehrtens@intel.com>
Date: Wed, 20 Nov 2019 11:50:57 +0100
Subject: [PATCH] PONRTSYS-5378: Use constants for DP_RX_ENABLE

The code is doing the same as before.
---
 drivers/net/ethernet/lantiq/ltq_eth_drv_xrx500.c | 6 ++----
 1 file changed, 2 insertions(+), 4 deletions(-)

diff --git a/drivers/net/ethernet/lantiq/ltq_eth_drv_xrx500.c b/drivers/net/ethernet/lantiq/ltq_eth_drv_xrx500.c
index 9631924f2232..079ab990c6c6 100644
--- a/drivers/net/ethernet/lantiq/ltq_eth_drv_xrx500.c
+++ b/drivers/net/ethernet/lantiq/ltq_eth_drv_xrx500.c
@@ -474,7 +474,6 @@ static const struct ethtool_ops serdes_ethtool_ops = {
 static int ltq_eth_open(struct net_device *dev)
 {
 	int ret;
-	int flags = 1;  /* flag 1 for enable */
 
 	pr_debug("%s called for device %s\n", __func__, dev->name);
 #ifdef CONFIG_GRX500_CBM
@@ -485,7 +484,7 @@ static int ltq_eth_open(struct net_device *dev)
 		pr_info("p2p channel already ON !\n");
 #endif
 
-	ret = dp_rx_enable(dev, dev->name, flags);
+	ret = dp_rx_enable(dev, dev->name, DP_RX_ENABLE);
 
 	if (ret != DP_SUCCESS) {
 		pr_err("%s: failed to enable for device: %s ret %d\n",
@@ -500,10 +499,9 @@ static int ltq_eth_open(struct net_device *dev)
 static int ltq_eth_stop(struct net_device *dev)
 {
 	int ret;
-	int flags = 0;  /* flag 0 for disable */
 
 	pr_debug("%s called for device %s\n", __func__, dev->name);
-	ret = dp_rx_enable(dev, dev->name, flags);
+	ret = dp_rx_enable(dev, dev->name, DP_RX_DISABLE);
 
 	if (ret != DP_SUCCESS) {
 		pr_err("%s: failed to disable for device: %s ret %d\n",
