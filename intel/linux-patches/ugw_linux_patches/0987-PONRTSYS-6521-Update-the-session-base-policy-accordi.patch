From 253f50ebb896e3261deb69fc1fff6e650adf9476 Mon Sep 17 00:00:00 2001
From: Elad Fernandes <elad.fernandes@intel.com>
Date: Sun, 19 Jan 2020 14:45:22 +0200
Subject: [PATCH] PONRTSYS-6521: Update the session base policy according to
 policy bitmap

---
 drivers/net/ppv4/pp-hal/session-info/pp_si.c | 15 +++++++++------
 1 file changed, 9 insertions(+), 6 deletions(-)

diff --git a/drivers/net/ppv4/pp-hal/session-info/pp_si.c b/drivers/net/ppv4/pp-hal/session-info/pp_si.c
index 925a75f34e56..ce2187f27c46 100644
--- a/drivers/net/ppv4/pp-hal/session-info/pp_si.c
+++ b/drivers/net/ppv4/pp-hal/session-info/pp_si.c
@@ -2,7 +2,7 @@
  * Description: PP Session Information module
  *
  * SPDX-License-Identifier: GPL-2.0-only
- * Copyright (C) 2018-2019 Intel Corporation
+ * Copyright (C) 2018-2020 Intel Corporation
  */
 
 #define pr_fmt(fmt) "[PP_SI]:%s:%d: " fmt, __func__, __LINE__
@@ -1043,6 +1043,9 @@ s32 pp_si_port_info_set(u16 in_port, u16 eg_port, struct pp_si *si)
 		}
 	}
 
+	pr_debug("port_rx_map %#x, port_tx_map %#x, port_tx_base_policy %u\n",
+		 rx_map, tx_map, si->base_policy);
+
 	/* build the session policies bitmap, the bitmap it built from rx & tx
 	 * common policies and from all policies of the tx that are higher
 	 * than the lowest common policy, this is only true in case rx policies
@@ -1055,17 +1058,17 @@ s32 pp_si_port_info_set(u16 in_port, u16 eg_port, struct pp_si *si)
 	 */
 	if (!rx_map || !(rx_map & tx_map)) {
 		si->policies_map = tx_map;
-		return ret;
+		goto done;
 	}
 
 	si->policies_map = rx_map & tx_map;
 	mask = ~((u8)GENMASK(__ffs(si->policies_map) - 1, 0));
 	si->policies_map |= tx_map & mask;
-	pr_debug("rx_map %#x, tx_map %#x, rx & tx %#x\n", rx_map, tx_map,
-		 tx_map & rx_map);
-	pr_debug("ffs(tx_map) %lu, mask %#x, tx & mask %#x, policy_map %#x\n",
-		 __ffs(tx_map), mask, tx_map & mask, si->policies_map);
+	si->base_policy += __ffs(si->policies_map) - __ffs(tx_map);
 
+done:
+	pr_debug("si->base_policy %u, si->policies_map %#x\n",
+		 si->base_policy, si->policies_map);
 	return ret;
 }
 
