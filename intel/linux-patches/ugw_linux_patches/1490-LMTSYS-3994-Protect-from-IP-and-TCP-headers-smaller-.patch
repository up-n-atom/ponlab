From 3c85543439de1be107a98e127d1ff05c554a1937 Mon Sep 17 00:00:00 2001
From: Elad Fernandes <elad.fernandes@intel.com>
Date: Wed, 16 Sep 2020 18:54:09 +0300
Subject: [PATCH] LMTSYS-3994: Protect from IP and TCP headers smaller than 20
 bytes in LGM PPv4

---
 drivers/net/ppv4/pp-hal/parser/parser_protocols.c | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/drivers/net/ppv4/pp-hal/parser/parser_protocols.c b/drivers/net/ppv4/pp-hal/parser/parser_protocols.c
index 2c84569ef086..8364f6377881 100644
--- a/drivers/net/ppv4/pp-hal/parser/parser_protocols.c
+++ b/drivers/net/ppv4/pp-hal/parser/parser_protocols.c
@@ -779,6 +779,8 @@ static void __proto_ipv4_common_init(struct protocol_info *info, char *name)
 	skip->logic       = SKIP_LOGIC_ALU;
 	/* don't care as we use IM for skip logic */
 	skip->op          = ALU_OP_4XLEN_PLUS_IM;
+	skip->hdr_len_min = sizeof(struct iphdr);
+	skip->hdr_len_max = 0xFF;
 	/* extract info */
 	/* only ToS and the protocol fields are required for classification so
 	 * we configure to extract all fields up to the protocol and will use
@@ -1450,6 +1452,8 @@ static void __proto_tcp_common_init(struct protocol_info *info, char *name)
 	skip->logic      = SKIP_LOGIC_ALU;
 	skip->op         = ALU_OP_4XLEN_PLUS_IM;
 	skip->hdr_len_im = 0;
+	skip->hdr_len_min = sizeof(struct tcphdr);
+	skip->hdr_len_max = 0xFF;
 	/* extract info */
 	/* extracting source and destination ports */
 	fld = &params->ext.fld[params->ext.n_fld++];
