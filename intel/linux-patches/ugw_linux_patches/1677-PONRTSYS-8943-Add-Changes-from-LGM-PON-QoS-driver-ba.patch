From a1e1ab6249b404bc467f43bafd4b27db738caae3 Mon Sep 17 00:00:00 2001
From: "Lenzeder, Joerg" <joerg.lenzeder@intel.com>
Date: Wed, 19 May 2021 15:56:10 +0200
Subject: [PATCH] PONRTSYS-8943: Add Changes from LGM PON QoS driver back to
 PRX

Missing change added
---
 drivers/net/datapath/pon_qos/pon_qos_tc_main.c | 31 +++++++++++++++++---------
 1 file changed, 21 insertions(+), 10 deletions(-)

diff --git a/drivers/net/datapath/pon_qos/pon_qos_tc_main.c b/drivers/net/datapath/pon_qos/pon_qos_tc_main.c
index dfc41f27ee9a..3cd1a0800cfb 100644
--- a/drivers/net/datapath/pon_qos/pon_qos_tc_main.c
+++ b/drivers/net/datapath/pon_qos/pon_qos_tc_main.c
@@ -80,23 +80,32 @@ int pon_qos_setup_tc(struct net_device *dev,
 
 	ASSERT_RTNL();
 	netdev_dbg(dev, "%s: start type %d\n", __func__, type);
+
+	trace_pon_qos_setup_tc_enter(dev, type);
+
 	switch (type) {
 	case TC_SETUP_QDISC_MQPRIO:
-		return pon_qos_tc_mqprio_offload(dev,
-			((struct tc_mqprio_qopt_offload *)type_data)->handle,
-			type_data, port_id, deq_idx);
+		ret = pon_qos_tc_mqprio_offload(dev,
+		      ((struct tc_mqprio_qopt_offload *)type_data)->handle,
+		      type_data, port_id, deq_idx);
+		break;
 	case TC_SETUP_QDISC_PRIO:
-		return pon_qos_tc_prio_offload(dev, type_data,
-			port_id, deq_idx);
+		ret = pon_qos_tc_prio_offload(dev, type_data,
+					      port_id, deq_idx);
+		break;
 	case TC_SETUP_QDISC_DRR:
-		return pon_qos_tc_drr_offload(dev, type_data,
-			port_id, deq_idx);
+		ret = pon_qos_tc_drr_offload(dev, type_data,
+					     port_id, deq_idx);
+		break;
 	case TC_SETUP_QDISC_RED:
-		return pon_qos_tc_red_offload(dev, type_data);
+		ret = pon_qos_tc_red_offload(dev, type_data);
+		break;
 	case TC_SETUP_QDISC_TBF:
-		return pon_qos_tc_tbf_offload(dev, type_data);
+		ret = pon_qos_tc_tbf_offload(dev, type_data);
+		break;
 	case TC_SETUP_BLOCK:
-		return pon_qos_tc_block_offload(dev, type_data);
+		ret = pon_qos_tc_block_offload(dev, type_data);
+		break;
 	case TC_SETUP_QDISC_MQ:
 		/* ToDo: Support to be added */
 		ret = -EOPNOTSUPP;
@@ -107,6 +116,8 @@ int pon_qos_setup_tc(struct net_device *dev,
 		break;
 	}
 
+	trace_pon_qos_setup_tc_exit(dev, type);
+
 	return ret;
 }
 #endif
