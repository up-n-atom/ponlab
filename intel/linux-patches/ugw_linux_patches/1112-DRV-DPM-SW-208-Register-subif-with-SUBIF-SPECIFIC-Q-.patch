 #endif
@@ -194,7 +194,7 @@ int dp_qos_port_set(struct pp_qos_dev *qdev, u32 id,
 		    const struct pp_qos_port_conf *conf)
 {
 #if IS_ENABLED(CONFIG_INTEL_DATAPATH_DBG)
