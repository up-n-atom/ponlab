 		pr_info("================================\n");
@@ -159,7 +159,7 @@ int dp_qos_sched_allocate(struct pp_qos_dev *qdev, u32 *id)
 	ret = pp_qos_sched_allocate(qdev, id);
 
 #if IS_ENABLED(CONFIG_INTEL_DATAPATH_DBG)
