From e935e5c4e2b522142ac0b462e627e8e2d7de752a Mon Sep 17 00:00:00 2001
From: Emergi Idan <idan.emergi@intel.com>
Date: Wed, 4 Dec 2019 14:44:37 +0200
Subject: [PATCH] PONRTSYS-6250: change ppv4 driver init to use device_initcall

Signed-off-by: Emergi Idan <idan.emergi@intel.com>
---
 drivers/net/ppv4/pp-dev/pp_dev.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/net/ppv4/pp-dev/pp_dev.c b/drivers/net/ppv4/pp-dev/pp_dev.c
index 0f2414601916..72f7af2a3a33 100644
--- a/drivers/net/ppv4/pp-dev/pp_dev.c
+++ b/drivers/net/ppv4/pp-dev/pp_dev.c
@@ -726,5 +726,5 @@ MODULE_AUTHOR("Intel Corporation");
 MODULE_DESCRIPTION(DRV_NAME);
 MODULE_LICENSE("GPL");
 MODULE_VERSION(DRV_VERSION);
-arch_initcall(__pp_dev_init);
+device_initcall(__pp_dev_init);
 module_exit(__pp_dev_exit);
