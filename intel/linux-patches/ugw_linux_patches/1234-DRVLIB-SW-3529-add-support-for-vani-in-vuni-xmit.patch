From 09df6f7ecc4525f4886fff53f8c963b0dc279aa3 Mon Sep 17 00:00:00 2001
From: Lishan Liu <lishan.liu@intel.com>
Date: Wed, 10 Jun 2020 16:12:00 +0800
Subject: [PATCH] DRVLIB_SW-3529: add support for vani in vuni xmit

---
 drivers/net/ethernet/lantiq/intel_pon_hgu_vuni.c | 12 ++++++++++--
 1 file changed, 10 insertions(+), 2 deletions(-)

diff --git a/drivers/net/ethernet/lantiq/intel_pon_hgu_vuni.c b/drivers/net/ethernet/lantiq/intel_pon_hgu_vuni.c
index 73b90d24798e..bd14ecd4014e 100644
--- a/drivers/net/ethernet/lantiq/intel_pon_hgu_vuni.c
+++ b/drivers/net/ethernet/lantiq/intel_pon_hgu_vuni.c
@@ -280,14 +280,22 @@ static int vuni_xmit(struct sk_buff *skb, struct net_device *dev)
 	int ret;
 	int len;
 	struct net_device *vuni_dev;
+	struct net_device *vani_dev;
 
 	if (skb_put_padto(skb, ETH_ZLEN)) {
 		priv->stats.tx_dropped++;
 		return NETDEV_TX_OK;
 	}
 
-	if (strcmp(dev->name, eth_dev[priv->id][0]->name) != 0) {
-		/*drop the packet*/
+	if (dev != eth_dev[priv->id][0]) {
+		vani_dev = eth_dev[priv->id][0];
+		skb->dev = vani_dev;
+		skb->offload_fwd_mark = 0;
+		if (vani_dev) {
+			eth_rx(vani_dev, skb->len, skb);
+			return 0;
+		}
+		pr_err("Invalid Tx\n");
 		priv->stats.tx_dropped++;
 		kfree_skb(skb);
 		return 0;
