From 2a970f2c3ad949c9c62af82336dc2be8f5db1238 Mon Sep 17 00:00:00 2001
From: Rekha Eswaran <rekha.eswaran@intel.com>
Date: Tue, 23 Jun 2020 11:34:50 +0800
Subject: [PATCH] DRV_DPM_SW-300 - DPM enhance dp_sync_subifid()

---
 drivers/net/datapath/dpm/datapath.h          |  2 +-
 drivers/net/datapath/dpm/datapath_api.c      | 11 ++++-------
 drivers/net/datapath/dpm/datapath_misc.c     | 11 +++++++----
 drivers/net/datapath/dpm/datapath_notifier.c |  5 +++--
 4 files changed, 15 insertions(+), 14 deletions(-)

diff --git a/drivers/net/datapath/dpm/datapath.h b/drivers/net/datapath/dpm/datapath.h
index a03a4f6bf002..54bc0bff74a4 100644
--- a/drivers/net/datapath/dpm/datapath.h
+++ b/drivers/net/datapath/dpm/datapath.h
@@ -1029,7 +1029,7 @@ u32 dp_subif_hash(struct net_device *dev);
 int dp_cbm_deq_port_enable(struct module *owner, int inst, int port_id,
 			   int deq_port_idx, int num_deq_port, int flags,
 			   u32 dma_ch_off);
-int32_t dp_get_netif_subifid_priv(struct net_device *netif,
+int32_t dp_get_netif_subifid_priv(int inst, struct net_device *netif,
 				  struct sk_buff *skb, void *subif_data,
 				  u8 dst_mac[DP_MAX_ETH_ALEN],
 				  dp_subif_t *subif, uint32_t flags);
diff --git a/drivers/net/datapath/dpm/datapath_api.c b/drivers/net/datapath/dpm/datapath_api.c
index 4194068910de..fffef71b2d37 100644
--- a/drivers/net/datapath/dpm/datapath_api.c
+++ b/drivers/net/datapath/dpm/datapath_api.c
@@ -1631,7 +1631,7 @@ EXPORT_SYMBOL(dp_get_netif_subifid);
  * Note: subif_data is mainly used for DSL WAN mode, esp ATM.
  * If subif->port_id valid, take it, otherwise search all to get the port_id
  */
-int32_t dp_get_netif_subifid_priv(struct net_device *netif,
+int32_t dp_get_netif_subifid_priv(int inst, struct net_device *netif,
 				  struct sk_buff *skb, void *subif_data,
 				  u8 dst_mac[DP_MAX_ETH_ALEN],
 				  dp_subif_t *subif, u32 flags)
@@ -1639,7 +1639,7 @@ int32_t dp_get_netif_subifid_priv(struct net_device *netif,
 	int res = -1;
 	int i, k;
 	int port_id = -1;
-	int inst, start, end;
+	int start, end;
 	u8 match = 0;
 	u8 num = 0;
 	u16 *subifs = NULL;
@@ -1670,10 +1670,6 @@ int32_t dp_get_netif_subifid_priv(struct net_device *netif,
 			 "%s failed:subif=%px\n", __func__, subif);
 		goto EXIT;
 	}
-	if (!netif && subif_data)
-		inst = 0;
-	else
-		inst = dp_get_inst_via_dev(netif, NULL, 0);
 	start = 0;
 	end = dp_port_prop[inst].info.cap.max_num_dp_ports;
 #ifdef DP_FAST_SEARCH /* Don't enable since need to be back-compatible */
@@ -2640,7 +2636,8 @@ int dp_set_bp_attr(struct dp_bp_attr *conf, u32 flag)
 
 	DP_LIB_LOCK(&dp_lock);
 
-	if (dp_get_netif_subifid_priv(conf->dev, NULL, NULL, NULL, &subif, 0)) {
+	if (dp_get_netif_subifid_priv(conf->inst, conf->dev, NULL, NULL,
+				      NULL, &subif, 0)) {
 		DP_LIB_UNLOCK(&dp_lock);
 		return DP_FAILURE;
 	}
diff --git a/drivers/net/datapath/dpm/datapath_misc.c b/drivers/net/datapath/dpm/datapath_misc.c
index ab44385fea71..16bea00afb30 100644
--- a/drivers/net/datapath/dpm/datapath_misc.c
+++ b/drivers/net/datapath/dpm/datapath_misc.c
@@ -991,19 +991,22 @@ int32_t dp_sync_subifid(struct net_device *dev, char *subif_name,
 	/*check flag for register / deregister to update/del */
 	if (flags & DP_F_DEREGISTER) {
 		/* subif info not required for data->ctp_dev */
-		if (dp_get_netif_subifid_priv(dev, NULL, subif_data, NULL,
+		if (dp_get_netif_subifid_priv(subif_id->inst, dev, NULL,
+					      subif_data, NULL,
 					      &subif_id[0], 0))
 			*f_subif_up = 0;
 		else
 			*f_subif_up = 1;
 	} else {
-		if (dp_get_netif_subifid_priv(dev, NULL, subif_data,
-					      NULL, &subif_id[0], 0)) {
+		if (dp_get_netif_subifid_priv(subif_id->inst, dev, NULL,
+					      subif_data, NULL,
+					      &subif_id[0], 0)) {
 			pr_err("DP subif synchronization fail\n");
 			return DP_FAILURE;
 		}
 		if (data && data->ctp_dev) {
-			if (dp_get_netif_subifid_priv(data->ctp_dev, NULL,
+			if (dp_get_netif_subifid_priv(subif_id->inst,
+						      data->ctp_dev, NULL,
 						      subif_data, NULL,
 						      &subif_id[1], 0))
 				return DP_FAILURE;
diff --git a/drivers/net/datapath/dpm/datapath_notifier.c b/drivers/net/datapath/dpm/datapath_notifier.c
index 5d8f19e2c882..91cab8cfecf9 100644
--- a/drivers/net/datapath/dpm/datapath_notifier.c
+++ b/drivers/net/datapath/dpm/datapath_notifier.c
@@ -58,10 +58,11 @@ int dp_notifier_invoke(int inst, struct net_device *dev,
 		break;
 	case DP_EVENT_REGISTER_SUBIF:
 	case DP_EVENT_DE_REGISTER_SUBIF:
-		ret = dp_get_netif_subifid_priv(dev, NULL, NULL, NULL, &subif, 0);
+		ret = dp_get_netif_subifid_priv(inst, dev, NULL, NULL, NULL,
+						&subif, 0);
 		if (ret) {
 			pr_err("%s: failed to get subif info for %s\n",
-				__func__, dev->name);
+			       __func__, dev->name);
 			return DP_FAILURE;
 		}
 		notif_data.subif = subif.subif;
