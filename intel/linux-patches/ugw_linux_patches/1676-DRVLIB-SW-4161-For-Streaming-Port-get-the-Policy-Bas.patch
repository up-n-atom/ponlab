From 9744e7552dcd379560b9137f386cf8ec9ad1d4a2 Mon Sep 17 00:00:00 2001
From: thampan <joby.thampan@intel.com>
Date: Wed, 19 May 2021 18:04:47 +0800
Subject: [PATCH] DRVLIB_SW-4161: For Streaming Port get the Policy Base/Num
 from CQM and display in proc

---
 drivers/net/datapath/dpm/datapath.h                |  6 +++---
 drivers/net/datapath/dpm/datapath_api.c            | 25 +++++++++++++---------
 drivers/net/datapath/dpm/datapath_proc.c           |  9 +++-----
 drivers/net/datapath/dpm/gswip31/datapath_misc.c   | 10 +++++----
 .../datapath/dpm/gswip31/datapath_ppv4_session.c   |  6 +++---
 .../net/datapath/dpm/gswip31/datapath_spl_conn.c   |  4 ++--
 include/net/datapath_api.h                         |  6 ++++++
 7 files changed, 38 insertions(+), 28 deletions(-)

diff --git a/drivers/net/datapath/dpm/datapath.h b/drivers/net/datapath/dpm/datapath.h
index 353608df1d54..b599801d4f94 100644
--- a/drivers/net/datapath/dpm/datapath.h
+++ b/drivers/net/datapath/dpm/datapath.h
@@ -557,9 +557,9 @@ struct dp_subif_info {
 	u16 tailroom_size;
 	u16 min_pkt_len;
 	int min_pkt_len_cfg;
-	u16 policy_base;    /* TX policy base */
-	u8 policy_num;      /* TX policy number */
-	u8 policy_map;      /* TX policy map */
+	u16 tx_policy_base;    /* TX policy base */
+	u8 tx_policy_num;      /* TX policy number */
+	u8 tx_policy_map;      /* TX policy map */
 	u16 rx_policy_base; /* RX policy base */
 	u8 rx_policy_num;   /* RX policy number */
 	u8 rx_policy_map;   /* RX policy map */
diff --git a/drivers/net/datapath/dpm/datapath_api.c b/drivers/net/datapath/dpm/datapath_api.c
index 6f99626fddd8..0405b52dff08 100644
--- a/drivers/net/datapath/dpm/datapath_api.c
+++ b/drivers/net/datapath/dpm/datapath_api.c
@@ -729,13 +729,13 @@ int32_t dp_register_subif_private(int inst, struct module *owner,
 	}
 
 	if (data->f_policy) {
-		sif->policy_num = cbm_data.tx_policy_num;
-		sif->policy_base = cbm_data.tx_policy_base;
+		sif->tx_policy_num = cbm_data.tx_policy_num;
+		sif->tx_policy_base = cbm_data.tx_policy_base;
 		sif->rx_policy_num = cbm_data.rx_policy_num;
 		sif->rx_policy_base = cbm_data.rx_policy_base;
 	} else {
-		sif->policy_num = port_info->tx_policy_num;
-		sif->policy_base = port_info->tx_policy_base;
+		sif->tx_policy_num = port_info->tx_policy_num;
+		sif->tx_policy_base = port_info->tx_policy_base;
 		sif->rx_policy_num = port_info->rx_policy_num;
 		sif->rx_policy_base = port_info->rx_policy_base;
 	}
@@ -1514,6 +1514,12 @@ int32_t dp_register_dev_ext(int inst, struct module *owner, u32 port_id,
 				       flags))
 		goto exit;
 
+	/* For Streaming port save the policy base/num from CQM
+	 * For DC port, dp_register_dc will overwrite from ring info
+	 */
+	port_info->tx_policy_base = cbm_data->tx_policy_base;
+	port_info->tx_policy_num = cbm_data->tx_policy_num;
+
 	res = dp_register_dc(inst, port_id, data, flags);
 	if (res)
 		goto exit;
@@ -3046,8 +3052,8 @@ int dp_get_io_port_info(struct dp_io_port_info *info, u32 flag)
 		core_info = &info->info.info.info[k++];
 		core_info->core_id = i;
 		info->info.info.num++;
-		core_info->num_policy = subif_info->policy_num;
-		core_info->policy_base = subif_info->policy_base;
+		core_info->num_policy = subif_info->tx_policy_num;
+		core_info->policy_base = subif_info->tx_policy_base;
 		core_info->num_tx_push = subif_info->tx_pkt_credit;
 		core_info->num_igp = 2;
 		core_info->num_egp = 1;
@@ -3298,8 +3304,7 @@ int dp_get_mtu_size(struct net_device *dev, u32 *mtu_size)
 	return cbm_get_mtu_size(mtu_size);
 #endif
 #if IS_ENABLED(CONFIG_INTEL_DATAPATH_HAL_GSWIP32)
-	if (unlikely(dp_get_netif_subifid(dev, NULL, NULL, NULL, &subif,
-					  0)))
+	if (unlikely(dp_get_netif_subifid(dev, NULL, NULL, NULL, &subif, 0)))
 		return DP_FAILURE;
 
 	port = get_dp_port_info(subif.inst, subif.port_id);
@@ -3308,8 +3313,8 @@ int dp_get_mtu_size(struct net_device *dev, u32 *mtu_size)
 
 	mtu.cbm_inst = dp_port_prop[subif.inst].cbm_inst;
 	mtu.dp_port = subif.port_id;
-	mtu.policy_map = cqm_get_policy_map(subif.inst, sif->policy_base,
-					    sif->policy_num,
+	mtu.policy_map = cqm_get_policy_map(subif.inst, sif->tx_policy_base,
+					    sif->tx_policy_num,
 					    port->alloc_flags,
 					    TX_POLICYMAP);
 	mtu.alloc_flag = port->alloc_flags;
diff --git a/drivers/net/datapath/dpm/datapath_proc.c b/drivers/net/datapath/dpm/datapath_proc.c
index 5a403fc6c678..f9f3f0f0a407 100644
--- a/drivers/net/datapath/dpm/datapath_proc.c
+++ b/drivers/net/datapath/dpm/datapath_proc.c
@@ -564,11 +564,9 @@ void dump_subif_info(struct seq_file *s, struct pmac_port_info *port, int n)
 		   STATS_GET(mib->tx_clone_pkt));
 	seq_printf(s, "           tx_hdr_room_pkt 0x%08x\n",
 		   STATS_GET(mib->tx_hdr_room_pkt));
-#if IS_ENABLED(CONFIG_INTEL_DATAPATH_HAL_GSWIP32)
 	seq_printf(s, "           rx_fn           0x%px\n", sif->rx_fn);
 	seq_printf(s, "           get_subifid_fn  0x%px\n",
 		   sif->get_subifid_fn);
-#endif
 #if IS_ENABLED(CONFIG_INTEL_DATAPATH_SWITCHDEV)
 	seq_printf(s, "           swdev:	   %d (%s)\n", sif->swdev_en,
 		   sif->swdev_en ? "Enabled" : "Disabled");
@@ -616,12 +614,11 @@ void dump_subif_info(struct seq_file *s, struct pmac_port_info *port, int n)
 	seq_puts(s, "\n");
 	seq_printf(s, "           rx_en_flag:     %d\n",
 		   STATS_GET(sif->rx_flag));
-#if IS_ENABLED(CONFIG_INTEL_DATAPATH_HAL_GSWIP32)
 	seq_printf(s, "           tx_policy base/num/map:      %d/%d/%x\n",
-		   sif->policy_base, sif->policy_num, sif->policy_map);
+		   sif->tx_policy_base, sif->tx_policy_num, sif->tx_policy_map);
 	seq_printf(s, "           rx_policy base/num/map:      %d/%d/%x\n",
 		   sif->rx_policy_base, sif->rx_policy_num, sif->rx_policy_map);
-
+#if IS_ENABLED(CONFIG_INTEL_DATAPATH_HAL_GSWIP32)
 	/* CPU Special path config */
 	if (sif->spl_cfg)
 		dump_subif_spl_cfg_info(s, sif);
@@ -762,11 +759,11 @@ int proc_port_dump(struct seq_file *s, int pos)
 	seq_printf(s, "    PTP:               %d (%s)\n", port->f_ptp,
 		   port->f_ptp ? "Enabled" : "Disabled");
 	seq_printf(s, "    loop_dis:          %d\n", port->loop_dis);
-#if IS_ENABLED(CONFIG_INTEL_DATAPATH_HAL_GSWIP32)
 	seq_printf(s, "    tx_policy_base/num:%d/%d\n",
 		   port->tx_policy_base, port->tx_policy_num);
 	seq_printf(s, "    rx_policy_base/num:%d/%d\n",
 		   port->rx_policy_base, port->rx_policy_num);
+#if IS_ENABLED(CONFIG_INTEL_DATAPATH_HAL_GSWIP32)
 	seq_printf(s, "    spl_tx_policy_base/num/map:%d/%d/%x\n",
 		   port->spl_tx_policy_base, port->spl_tx_policy_num,
 		   port->spl_tx_policy_map);
diff --git a/drivers/net/datapath/dpm/gswip31/datapath_misc.c b/drivers/net/datapath/dpm/gswip31/datapath_misc.c
index bff02040de50..e629af3538bc 100644
--- a/drivers/net/datapath/dpm/gswip31/datapath_misc.c
+++ b/drivers/net/datapath/dpm/gswip31/datapath_misc.c
@@ -1124,10 +1124,12 @@ void save_subif_info(int inst, struct cbm_cpu_port_data *cpu_data,
 	subif_info->cqm_port_idx = q_port->cqe_deq;
 
 #if IS_ENABLED(CONFIG_INTEL_DATAPATH_HAL_GSWIP32)
-	subif_info->policy_base = cpu_data->policy_base[cpu_idx][port_per_cpu];
-	subif_info->policy_num = cpu_data->policy_num[cpu_idx][port_per_cpu];
-	subif_info->rx_policy_base = subif_info->policy_base;
-	subif_info->rx_policy_num = subif_info->policy_num;
+	subif_info->tx_policy_base =
+		cpu_data->policy_base[cpu_idx][port_per_cpu];
+	subif_info->tx_policy_num =
+		cpu_data->policy_num[cpu_idx][port_per_cpu];
+	subif_info->rx_policy_base = subif_info->tx_policy_base;
+	subif_info->rx_policy_num = subif_info->tx_policy_num;
 	subif_info->type = cpu_data->type[cpu_idx][port_per_cpu];
 	subif_info->igp_id =
 		cpu_data->dq_tx_push_info[cpu_idx][port_per_cpu].igp_id;
diff --git a/drivers/net/datapath/dpm/gswip31/datapath_ppv4_session.c b/drivers/net/datapath/dpm/gswip31/datapath_ppv4_session.c
index 2dff01f97e64..4f20de379e67 100644
--- a/drivers/net/datapath/dpm/gswip31/datapath_ppv4_session.c
+++ b/drivers/net/datapath/dpm/gswip31/datapath_ppv4_session.c
@@ -223,8 +223,8 @@ static int dp_set_policy(int inst, int dpid, int vap,
 		flags |= SP_GPID_POLICYMAP;
 	} else {
 		sif = get_dp_port_subif(port, vap);
-		tx_base = (s16)sif->policy_base;
-		tx_range = (s8)sif->policy_num;
+		tx_base = (s16)sif->tx_policy_base;
+		tx_range = (s8)sif->tx_policy_num;
 		rx_base = (s16)sif->rx_policy_base;
 		rx_range = (s8)sif->rx_policy_num;
 	}
@@ -239,7 +239,7 @@ static int dp_set_policy(int inst, int dpid, int vap,
 		port->spl_tx_policy_map = p->tx.policies_map;
 		port->spl_rx_policy_map = p->rx.policies_map;
 	} else {
-		sif->policy_map = p->tx.policies_map;
+		sif->tx_policy_map = p->tx.policies_map;
 		sif->rx_policy_map = p->rx.policies_map;
 	}
 	return DP_SUCCESS;
diff --git a/drivers/net/datapath/dpm/gswip31/datapath_spl_conn.c b/drivers/net/datapath/dpm/gswip31/datapath_spl_conn.c
index 1ed1fe6946e3..6a287925a040 100644
--- a/drivers/net/datapath/dpm/gswip31/datapath_spl_conn.c
+++ b/drivers/net/datapath/dpm/gswip31/datapath_spl_conn.c
@@ -427,8 +427,8 @@ static int add_spl_conn(int inst, struct dp_spl_cfg *conn,
 	sif->subif = conn->subif;
 	sif->gpid = conn->gpid;
 	sif->netif = conn->dev;
-	sif->policy_base = conn->policy[0].tx_policy_base;
-	sif->policy_num = conn->policy[0].tx_policy_num;
+	sif->tx_policy_base = conn->policy[0].tx_policy_base;
+	sif->tx_policy_num = conn->policy[0].tx_policy_num;
 	sif->rx_policy_base = conn->policy[0].rx_policy_base;
 	sif->rx_policy_num = conn->policy[0].rx_policy_num;
 	sif->qid = conn->egp[0].qid;
diff --git a/include/net/datapath_api.h b/include/net/datapath_api.h
index df5559c25e0b..a13dd8931b47 100644
--- a/include/net/datapath_api.h
+++ b/include/net/datapath_api.h
@@ -829,6 +829,12 @@ enum DP_SUBIF_DATA_FLAG {
 	DP_SUBIF_BP_CPU_DISABLE = BIT(10), /*!< To remove CPU bridge port
 					   * from bridge port member list
 					   */
+	DP_SUBIF_SEG_EN = BIT(11), /*!< if this flag is set seg_en will be set to 1
+								* to use FSQM buffer,
+								*/
+	DP_SUBIF_SEG_DIS = BIT(12), /*!< if this flag is set seg_en=0 to use
+								 * BM buffer
+								 */
 };
 
 /*! @brief dp_subif_id struct for get_netif_subif */
