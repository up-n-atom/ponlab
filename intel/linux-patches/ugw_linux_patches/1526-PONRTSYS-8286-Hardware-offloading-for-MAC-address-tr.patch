From 85f4cef3f72e20e10a0adb91c90459b9003f868f Mon Sep 17 00:00:00 2001
From: Jan Dominiak <janx.dominiak@intel.com>
Date: Mon, 16 Nov 2020 08:16:24 +0100
Subject: [PATCH] PONRTSYS-8286: Hardware offloading for MAC address trap
 action with mask

---
 drivers/net/datapath/pon_qos/pon_qos_tc_trap.c | 49 ++++++++++++++++++--------
 1 file changed, 34 insertions(+), 15 deletions(-)

diff --git a/drivers/net/datapath/pon_qos/pon_qos_tc_trap.c b/drivers/net/datapath/pon_qos/pon_qos_tc_trap.c
index 83ef0cdd9767..72cb4000a479 100644
--- a/drivers/net/datapath/pon_qos/pon_qos_tc_trap.c
+++ b/drivers/net/datapath/pon_qos/pon_qos_tc_trap.c
@@ -1,6 +1,7 @@
 // SPDX-License-Identifier: GPL-2.0
 /******************************************************************************
  *
+ * Copyright (c) 2020 MaxLinear, Inc.
  * Copyright (c) 2020 Intel Corporation
  *
  *****************************************************************************/
@@ -215,9 +216,8 @@ static void pon_qos_trap_parse_key_eth(struct net_device *dev,
 				       const struct tc_cls_flower_offload *f,
 				       GSW_PCE_rule_t *pce_rule)
 {
-	int cnt_dst = 0;
-	int cnt_src = 0;
 	int i = 0;
+	int idx = 0;
 
 	if (dissector_uses_key(f->dissector, FLOW_DISSECTOR_KEY_ETH_ADDRS)) {
 		struct flow_dissector_key_eth_addrs *key =
@@ -229,25 +229,44 @@ static void pon_qos_trap_parse_key_eth(struct net_device *dev,
 						  FLOW_DISSECTOR_KEY_ETH_ADDRS,
 						  f->mask);
 
-		for (i = 0; i < ARRAY_SIZE(mask->dst); i++) {
-			if (mask->dst[i] != 0)
-				cnt_dst++;
-			if (mask->src[i] != 0)
-				cnt_src++;
+		pce_rule->pattern.bMAC_DstEnable = is_zero_ether_addr(key->dst);
+		pce_rule->pattern.bMAC_SrcEnable = is_zero_ether_addr(key->src);
+
+		netdev_dbg(dev, "%s: bMAC_DstEnable = %d bMAC_SrcEnable = %d\n",
+			   __func__, pce_rule->pattern.bMAC_DstEnable,
+			   pce_rule->pattern.bMAC_SrcEnable);
+
+		/* Set bit in mask for each nibble different from F */
+		for (i = ETH_ALEN - 1; i >= 0; i--, idx += 2) {
+			if ((mask->dst[i] & 0x0f) != 0xf)
+				pce_rule->pattern.nMAC_DstMask |= 1 << idx;
+			if ((mask->dst[i] & 0xf0) != 0xf0)
+				pce_rule->pattern.nMAC_DstMask |=
+					1 << (idx + 1);
+
+			if ((mask->src[i] & 0x0f) != 0xf)
+				pce_rule->pattern.nMAC_SrcMask |= 1 << idx;
+			if ((mask->src[i] & 0xf0) != 0xf0)
+				pce_rule->pattern.nMAC_SrcMask |=
+					1 << (idx + 1);
 		}
 
-		if (cnt_dst == ARRAY_SIZE(mask->dst)) {
-			pce_rule->pattern.bMAC_DstEnable = 1;
-
-			for (i = 0; i < ARRAY_SIZE(key->dst); i++)
+		if (pce_rule->pattern.bMAC_DstEnable == 1) {
+			for (i = 0; i < ARRAY_SIZE(key->dst); i++) {
 				pce_rule->pattern.nMAC_Dst[i] = key->dst[i];
+				netdev_dbg(dev, "%s: pce_rule->pattern.nMAC_Dst[i] = %d\n",
+					   __func__,
+					   pce_rule->pattern.nMAC_Dst[i]);
+			}
 		}
 
-		if (cnt_src == ARRAY_SIZE(mask->src)) {
-			pce_rule->pattern.bMAC_SrcEnable = 1;
-
-			for (i = 0; i < ARRAY_SIZE(key->src); i++)
+		if (pce_rule->pattern.bMAC_SrcEnable == 1) {
+			for (i = 0; i < ARRAY_SIZE(key->src); i++) {
 				pce_rule->pattern.nMAC_Src[i] = key->src[i];
+				netdev_dbg(dev, "%s: pce_rule->pattern.nMAC_Src[i] = %d\n",
+					   __func__,
+					   pce_rule->pattern.nMAC_Src[i]);
+			}
 		}
 	}
 
