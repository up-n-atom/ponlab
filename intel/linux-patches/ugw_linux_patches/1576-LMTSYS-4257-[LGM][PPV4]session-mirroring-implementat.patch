index bdec70c279b2..9ea58bf8cc98 100644
--- a/drivers/net/ppv4/pp-api/pp-misc/pp_misc.c
+++ b/drivers/net/ppv4/pp-api/pp-misc/pp_misc.c
@@ -1074,11 +1074,11 @@ s32 pp_hal_global_stats_show(char *buf, size_t sz, size_t *n, void *stats,
 		   "| Drop          %10llu  | Drop        %10llu  | Drop        %10llu  |\n",
 		   mcast->drop_pkt, reass->err.dropped, frag->total_drops);
 	pr_buf_cat(buf, sz, *n,
