 	pr_buf_cat(buf, sz, *n,
-		   "|                           | Accelerated %10llu  | df drops    %10llu  |\n",
-		   reass->accelerated, frag->df_drops);
+		   "| Mirror Drop   %10llu  | Accelerated %10llu  | df drops    %10llu  |\n",
