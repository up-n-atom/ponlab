From 128e17a1ece56eb7e0b0d77ee850baac50579c5e Mon Sep 17 00:00:00 2001
From: "Rywacki, Kamil" <kamil.rywacki@intel.com>
Date: Thu, 3 Dec 2020 15:53:18 +0100
Subject: [PATCH] PONRTSYS-8069: Extend SW default multicast config

---
 drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c b/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c
index 251aa0621678..dfa2234c78d5 100644
--- a/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c
+++ b/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c
@@ -3593,6 +3593,8 @@ void *ethsw_api_core_init(ethsw_core_init_t *ethcinit)
 	if (PrvData->mcsthw_snoop == MCAST_HWSNOOP_DIS) {
 		gsw_w32(cdev, PCE_GCTRL_0_IGMP_OFFSET, PCE_GCTRL_0_IGMP_SHIFT,
 			PCE_GCTRL_0_IGMP_SIZE, 1);
+		PrvData->iflag.igmode = GSW_MULTICAST_SNOOP_MODE_FORWARD;
+		PrvData->iflag.igv3 = true;
 	}
 
 	/** Parser Micro Code Init */
