From 784eab16a082caa04ec54fa1996e6beab094e99c Mon Sep 17 00:00:00 2001
From: Elad Fernandes <elad.fernandes@intel.com>
Date: Tue, 31 Mar 2020 13:22:09 +0300
Subject: [PATCH] PONRTSYS-7747: Update vxlan and geneve entry type to reserve
 L4

---
 drivers/net/ppv4/pp-hal/parser/parser.c           |  7 ++++---
 drivers/net/ppv4/pp-hal/parser/parser_debugfs.c   |  2 +-
 drivers/net/ppv4/pp-hal/parser/parser_protocols.c | 18 +++++++-----------
 3 files changed, 12 insertions(+), 15 deletions(-)

diff --git a/drivers/net/ppv4/pp-hal/parser/parser.c b/drivers/net/ppv4/pp-hal/parser/parser.c
index 2238e6ea1809..2bf8ff9ce485 100644
--- a/drivers/net/ppv4/pp-hal/parser/parser.c
+++ b/drivers/net/ppv4/pp-hal/parser/parser.c
@@ -2,7 +2,7 @@
  * Description: PP Parser Driver
  *
  * SPDX-License-Identifier: GPL-2.0-only
- * Copyright (C) 2018-2019 Intel Corporation
+ * Copyright (C) 2018-2020 Intel Corporation
  */
 
 #define pr_fmt(fmt) "[PP_PARSER]: %s:%d: " fmt, __func__, __LINE__
@@ -1478,7 +1478,7 @@ static bool __prsr_imem_entry_is_valid(u16 idx, const struct imem_entry *ent)
 
 	/* if header check is enable but max and min are wrong */
 	if (unlikely(ent->hdr_len_chck) &&
-	    unlikely(ent->hdr_len_max <= ent->hdr_len_min)) {
+	    unlikely(ent->hdr_len_max < ent->hdr_len_min)) {
 		prsr_err("invalid hdr_len_min %u and hdr_len_max %u\n",
 			 ent->hdr_len_min, ent->hdr_len_max);
 		res = false;
@@ -2704,7 +2704,8 @@ __prsr_up_params_to_imem_entry(const struct prsr_up_layer_proto_params *params,
 	ent->hdr_len_im1 = params->skip.hdr_len_im;
 	ent->skip_logic  = params->skip.logic;
 	ent->skip_op     = params->skip.op;
-	if (params->skip.hdr_len_min < params->skip.hdr_len_max) {
+	if ((params->skip.hdr_len_min <= params->skip.hdr_len_max) &&
+		(params->skip.hdr_len_min)) {
 		ent->hdr_len_chck = true;
 		ent->hdr_len_max  = params->skip.hdr_len_max;
 		ent->hdr_len_min  = params->skip.hdr_len_min;
diff --git a/drivers/net/ppv4/pp-hal/parser/parser_debugfs.c b/drivers/net/ppv4/pp-hal/parser/parser_debugfs.c
index 1f811865abe6..20e508ab15aa 100644
--- a/drivers/net/ppv4/pp-hal/parser/parser_debugfs.c
+++ b/drivers/net/ppv4/pp-hal/parser/parser_debugfs.c
@@ -2259,7 +2259,7 @@ static void __prsr_fv_tunn_show(struct seq_file *f, union pp_fv_tunnel *tunn,
 				u16 udp_dst_port)
 {
 	if (PP_FV_IS_L4_UDP(pinfo)) {
-		switch (udp_dst_port) {
+		switch (ntohs(udp_dst_port)) {
 		case VXLAN_UDP_DPORT:
 			seq_printf(f, "| Tunnel  | VNI              | %-39x |\n",
 				   ntohl(tunn->vxlan.vni));
diff --git a/drivers/net/ppv4/pp-hal/parser/parser_protocols.c b/drivers/net/ppv4/pp-hal/parser/parser_protocols.c
index c565cea48cb2..9cde969d0b5b 100644
--- a/drivers/net/ppv4/pp-hal/parser/parser_protocols.c
+++ b/drivers/net/ppv4/pp-hal/parser/parser_protocols.c
@@ -2,7 +2,7 @@
  * Description: Parser protocols specific functions
  *
  * SPDX-License-Identifier: GPL-2.0-only
- * Copyright (C) 2018-2019 Intel Corporation
+ * Copyright (C) 2018-2020 Intel Corporation
  */
 
 #define pr_fmt(fmt) "[PP_PARSER_PROTO]: %s:%d: " fmt, __func__, __LINE__
@@ -2114,8 +2114,9 @@ static s32 __proto_vxlan_init(struct protocol_info *info)
 	/* parsing info */
 	params->proto_id   = VXLAN_UDP_DPORT;
 	params->hw_idx     = TABLE_ENTRY_INVALID_IDX;
-	params->hdr_len    = 0;
-	params->entry_type = ETYPE_NONE;
+	params->hdr_len    = sizeof(struct vxlanhdr);
+	/* TBD - type NONE is bypassing the HW abort validation */
+	params->entry_type = ETYPE_RSRV_L4;
 	/* next protocol info - next protocol is always MAC header */
 	np = &params->np;
 	np->logic = NP_LOGIC_END;
@@ -2171,8 +2172,9 @@ static s32 __proto_geneve_init(struct protocol_info *info)
 	/* parsing info */
 	params->proto_id   = GENEVE_UDP_DPORT;
 	params->hw_idx     = TABLE_ENTRY_INVALID_IDX;
-	params->hdr_len    = 4;
-	params->entry_type = ETYPE_NONE;
+	params->hdr_len    = offsetof(struct genevehdr, options);
+	/* TBD - type NONE is bypassing the HW abort validation */
+	params->entry_type = ETYPE_RSRV_L4;
 	/* next protocol info - next protocol is always MAC header */
 	np = &params->np;
 	np->logic = NP_LOGIC_END;
@@ -2387,12 +2389,6 @@ s32 __prsr_protocols_init(struct protocols *protos)
 	INIT_MERGE(PRSR_PROFILE_COMMON, PRSR_PROTO_MAC_INT,
 		   PRSR_PROTO_QINQ, PRSR_PROTO_QINQ,
 		   protos, ret, i);
-	INIT_MERGE(PRSR_PROFILE_COMMON, PRSR_PROTO_UDP,
-		   PRSR_PROTO_VXLAN, PRSR_PROTO_VXLAN,
-		   protos, ret, i);
-	INIT_MERGE(PRSR_PROFILE_COMMON, PRSR_PROTO_UDP,
-		   PRSR_PROTO_GENEVE, PRSR_PROTO_GENEVE,
-		   protos, ret, i);
 	protos->n_merge = i;
 
 	return ret;
