From 3e9b2fbb42166d53016f50543d6104d0634e1974 Mon Sep 17 00:00:00 2001
From: "Druzga, LukaszX" <lukaszx.druzga@intel.com>
Date: Tue, 9 Jun 2020 09:58:00 +0200
Subject: [PATCH] PONRTSYS-6758: Get the pmapper ID that corresponding to the
 VLAN ID

---
 drivers/net/datapath/pon_qos/pon_qos_tc_ext_vlan.c |  5 ++
 drivers/net/datapath/pon_qos/pon_qos_tc_ext_vlan.h |  2 +
 .../net/datapath/pon_qos/pon_qos_tc_vlan_filter.c  | 80 ++++++++++++++++++++++
 3 files changed, 87 insertions(+)

diff --git a/drivers/net/datapath/pon_qos/pon_qos_tc_ext_vlan.c b/drivers/net/datapath/pon_qos/pon_qos_tc_ext_vlan.c
index 23fdc5a37417..2fa0d0298a31 100644
--- a/drivers/net/datapath/pon_qos/pon_qos_tc_ext_vlan.c
+++ b/drivers/net/datapath/pon_qos/pon_qos_tc_ext_vlan.c
@@ -335,3 +335,8 @@ int pon_qos_tc_ext_vlan_del(struct net_device *dev,
 
 	return dp_update(dev, &dp_vlan, ingress);
 }
+
+struct list_head *pon_qos_tc_get_ext_vlan_storage(void)
+{
+	return &tc_ext_vlan_storage;
+}
diff --git a/drivers/net/datapath/pon_qos/pon_qos_tc_ext_vlan.h b/drivers/net/datapath/pon_qos/pon_qos_tc_ext_vlan.h
index 869da96486fd..8e09077507a3 100644
--- a/drivers/net/datapath/pon_qos/pon_qos_tc_ext_vlan.h
+++ b/drivers/net/datapath/pon_qos/pon_qos_tc_ext_vlan.h
@@ -15,4 +15,6 @@ int pon_qos_tc_ext_vlan_del(struct net_device *dev,
 			    void *vlan_storage,
 			    void *rule);
 
+struct list_head *pon_qos_tc_get_ext_vlan_storage(void);
+
 #endif
diff --git a/drivers/net/datapath/pon_qos/pon_qos_tc_vlan_filter.c b/drivers/net/datapath/pon_qos/pon_qos_tc_vlan_filter.c
index de9007193963..c0d8a2a39793 100644
--- a/drivers/net/datapath/pon_qos/pon_qos_tc_vlan_filter.c
+++ b/drivers/net/datapath/pon_qos/pon_qos_tc_vlan_filter.c
@@ -20,6 +20,7 @@
 #include "pon_qos_tc_vlan_storage.h"
 #include "pon_qos_tc_vlan_filter.h"
 #include "pon_qos_tc_lct.h"
+#include "pon_qos_tc_ext_vlan.h"
 
 #define PON_QOS_TC_FILTER_DEF_PRIO_THRESHOLD 64000
 
@@ -273,3 +274,82 @@ int pon_qos_tc_vlan_filter_del(struct net_device *dev,
 
 	return dp_update(dev, &dp_vlan, ingress);
 }
+
+static bool pon_qos_tc_is_pmapper_check(struct net_device *dev)
+{
+	dp_subif_t subif = {0};
+	int ret;
+
+	ret = dp_get_netif_subifid(dev, NULL, NULL, NULL, &subif, 0);
+	if (ret != DP_SUCCESS) {
+		netdev_err(dev, "can not get subif\n");
+		return false;
+	}
+
+	if (subif.flag_pmapper)
+		return true;
+
+	return false;
+}
+
+static bool pon_qos_tc_lookup_by_cvid(struct pon_qos_vlan_storage_node *node,
+				      int cvid)
+{
+	struct dp_vlan1 *p1;
+	struct dp_vlan2 *p2;
+
+	switch (node->tag) {
+	case TC_VLAN_UNTAGGED:
+		break;
+	case TC_VLAN_SINGLE_TAGGED:
+		list_for_each_entry(p1, &node->rules, list) {
+			if (p1->outer.vid == cvid)
+				return true;
+		}
+		break;
+	case TC_VLAN_DOUBLE_TAGGED:
+		list_for_each_entry(p2, &node->rules, list) {
+			if (p2->inner.vid == cvid)
+				return true;
+		}
+		break;
+	default:
+		break;
+	}
+
+	return false;
+}
+
+static struct net_device *pon_qos_tc_search_pmapper_on_list(int cvid,
+						      bool ingress,
+						      struct list_head *storage)
+{
+	struct pon_qos_vlan_storage_node *p;
+	list_for_each_entry(p, storage, list) {
+		rtnl_lock();
+		if (p->ingress == ingress &&
+		    pon_qos_tc_is_pmapper_check(p->dev)) {
+			if (pon_qos_tc_lookup_by_cvid(p, cvid)) {
+				rtnl_unlock();
+				return p->dev;
+			}
+		}
+		rtnl_unlock();
+	}
+
+	return NULL;
+}
+
+struct net_device *pon_qos_tc_find_pmapper_via_cvid(int cvid, bool ingress)
+{
+	struct net_device *dev = NULL;
+
+	dev = pon_qos_tc_search_pmapper_on_list(cvid, ingress,
+						&tc_vlan_filter_storage);
+
+	if (dev == NULL)
+		dev = pon_qos_tc_search_pmapper_on_list(cvid, ingress,
+					pon_qos_tc_get_ext_vlan_storage());
+	return dev;
+}
+EXPORT_SYMBOL(pon_qos_tc_find_pmapper_via_cvid);
