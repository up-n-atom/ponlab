From 7cebe62d020be4a41dcc1af1a83c687a2d50b69b Mon Sep 17 00:00:00 2001
From: arathinx <ayyappanx.rathinam@intel.com>
Date: Mon, 30 Mar 2020 11:42:57 +0800
Subject: [PATCH] DRVLIB_SW-3532: XPCS Driver calls reset of WANSS and PHY
 together which causes PON FW restart

---
 drivers/phy/intel/phy-intel-wan-xpcs.c | 26 ++++++++++----------------
 1 file changed, 10 insertions(+), 16 deletions(-)

diff --git a/drivers/phy/intel/phy-intel-wan-xpcs.c b/drivers/phy/intel/phy-intel-wan-xpcs.c
index 4ee9d28babff..5704219d81dd 100644
--- a/drivers/phy/intel/phy-intel-wan-xpcs.c
+++ b/drivers/phy/intel/phy-intel-wan-xpcs.c
@@ -79,7 +79,7 @@ static void intel_wan_xpcs_w32(void __iomem *base, u32 val,  u32 reg)
 }
 
 static void intel_wan_xpcs_w32_off_mask(void __iomem *base, u32 off,
-					       u32 mask, u32 set, u32 reg)
+					u32 mask, u32 set, u32 reg)
 {
 	u32 val;
 
@@ -106,11 +106,11 @@ intel_wan_xpcs_phy_serdes_write(struct file *s, const char __user *buffer,
 	if (!capable(CAP_SYS_ADMIN))
 		return -EPERM;
 
-	if (count > sizeof(buf) -1)
+	if (count > sizeof(buf) - 1)
 		return -EINVAL;
 
 	memset(buf, 0, sizeof(buf));
-	buf_size = min(count, sizeof(buf) -1);
+	buf_size = min(count, sizeof(buf) - 1);
 	if (copy_from_user(buf, buffer, buf_size))
 		return -EFAULT;
 
@@ -248,13 +248,6 @@ static int intel_wan_xpcs_phy_power_on(struct phy *phy)
 		return ret;
 	}
 
-	ret = reset_control_deassert(priv->resets[WANSS_RST]);
-	if (ret) {
-		dev_err(dev, "Failed to deassert wanss reset\n");
-		return ret;
-	}
-	udelay(2);
-
 	return 0;
 }
 
@@ -271,12 +264,6 @@ static int intel_wan_xpcs_phy_power_off(struct phy *phy)
 		dev_err(dev, "Failed to assert phy reset\n");
 		return ret;
 	}
-
-	ret = reset_control_assert(priv->resets[WANSS_RST]);
-	if (ret) {
-		dev_err(dev, "Failed to assert WANSS reset\n");
-		return ret;
-	}
 	clk_disable_unprepare(priv->clk);
 
 	return 0;
@@ -409,6 +396,13 @@ static int intel_wan_xpcs_phy_probe(struct platform_device *pdev)
 		return PTR_ERR(phy_provider);
 	}
 
+	ret = reset_control_deassert(priv->resets[WANSS_RST]);
+	if (ret) {
+		dev_err(dev, "Failed to deassert wanss reset\n");
+		return ret;
+	}
+	udelay(2);
+
 	if (intel_wan_xpcs_phy_debugfs_init(priv))
 		return -EINVAL;
 
