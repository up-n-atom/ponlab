From f3fe80cfaa49a935a21574e5ca48475fbb1131fc Mon Sep 17 00:00:00 2001
From: Elad Fernandes <elad.fernandes@intel.com>
Date: Tue, 22 Sep 2020 16:26:04 +0300
Subject: [PATCH] LMTSYS-3967: Fixing the ipv4 over ipv4 tunnel recipe ALU
 actions in LGM PPv4

---
 .../net/ppv4/pp-hal/modifier/modifier_recipes.c    | 42 +++++++++++-----------
 1 file changed, 20 insertions(+), 22 deletions(-)

diff --git a/drivers/net/ppv4/pp-hal/modifier/modifier_recipes.c b/drivers/net/ppv4/pp-hal/modifier/modifier_recipes.c
index f444bd3858b9..5af212bb1c19 100644
--- a/drivers/net/ppv4/pp-hal/modifier/modifier_recipes.c
+++ b/drivers/net/ppv4/pp-hal/modifier/modifier_recipes.c
@@ -529,34 +529,32 @@ static s32 mod_rcp_ipv4_routed_set(s32 rcp_idx, enum mod_eu_stw_mux_sel l3_off,
 	/*=========================*/
 	/*      ALU operations     */
 	/*=========================*/
-	/*  |------------------------|------------------------------------|
-	 *  |      ALU0              |      ALU1                          |
-	 *  |------------------------|------------------------------------|
-	 *  | sync                   |                                    |
-	 *  | TTL decrement          | sync                               |
-	 *  | ID inc (nhdr v4)       | pkt l3 csum + si delta             |
-	 *  | csum ID (nhdr v4)      | nhdr tot len (nhdr or pppoe_encap) |
-	 *  | csum tot len (nhdr v4) | pppoe pkt len (pppoe_encap)        |
-	 *  |                        | pkt l4 csum step 1                 |
-	 *  |                        | pkt l4 csum step 2                 |
-	 *  |------------------------|------------------------------------|
+
+	/*  |-----------------------------------|------------------------|
+	 *  |      ALU0                         |      ALU1              |
+	 *  |-----------------------------------|------------------------|
+	 *  | sync to L3 csum                   |                        |
+	 *  | TTL decrement                     | sync to L4 dport (napt)|
+	 *  | nhdr tot len (nhdr or pppoe_encap)| pkt l3 csum + si delta |
+	 *  | pppoe pkt len (pppoe_encap)       | pkt l4 csum step 1     |
+	 *  | ID inc (nhdr v4)                  | pkt l4 csum step 2     |
+	 *  | csum ID (nhdr v4)                 |                        |
+	 *  | csum tot len (nhdr v4)            |                        |
+	 *  |-----------------------------------|------------------------|
 	 */
+
 	/* Synchronize ALU0 to latest fetched information of STORE command */
 	ret |= mod_alu_synch(EU_ALU0, &rcp, l3_off,
 			     offsetof(struct iphdr, check),
 			     FIELD_SIZEOF(struct iphdr, check));
 	if (l4_napt) {
-		/* Here we need to sync up to the L4 checksum field,
-		 * according to flow limitation we need to sync few bytes
-		 * before as we dont want to sync on the last bytes of the
-		 * header which can delayed the alu operation and anyway
-		 * we have at least 8 cycles from store engine to alu1 engine
-		 * so for UDP and TCP we synched on the L4 dest port field
-		 * (byte 4 from the L4 offset)
+		/* Synchronize ALU1 to L4 checksum field,
+		 * The offset value is taken from the SI and it will be
+		 * Different value for UDP and TCP
 		 */
 		ret |= mod_alu_synch(EU_ALU1, &rcp, STW_NEXT_LAYER(l3_off),
-				     offsetof(struct udphdr, dest),
-				     FIELD_SIZEOF(struct udphdr, dest));
+				     MOD_SI_PKT_OFF,
+				     FIELD_SIZEOF(struct udphdr, check));
 	} else {
 		ret |= mod_alu_synch(EU_ALU1, &rcp, l3_off,
 				     offsetof(struct iphdr, check),
@@ -573,12 +571,12 @@ static s32 mod_rcp_ipv4_routed_set(s32 rcp_idx, enum mod_eu_stw_mux_sel l3_off,
 
 	/* Calculate new header total length */
 	if (nhdr != RCP_NEW_HDR_NO_IP || pppoe_encap) {
-		ret |= mod_alu_add(EU_ALU1, &rcp, si_l3_tot_len_diff, 1,
+		ret |= mod_alu_add(EU_ALU0, &rcp, si_l3_tot_len_diff, 1,
 				   pkt_l3_tot_len, 2, pkt_l3_tot_len);
 
 		/* pppoe_len = pppoe_diff ? pppoe_diff + l3 len : l2_org_val */
 		if (pppoe_encap) {
-			ret |= mod_alu_add_cond(EU_ALU1, &rcp, pppoe_diff, 1,
+			ret |= mod_alu_add_cond(EU_ALU0, &rcp, pppoe_diff, 1,
 						pkt_l3_tot_len, 2, pppoe_len,
 						EU_ALU_L0_BIG_R2,
 						EU_ALU_COND_MET);
