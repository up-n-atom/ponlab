From fea530e86bbc924aebd6915cb5f6620fbff5bcec Mon Sep 17 00:00:00 2001
From: Rekha Eswaran <rekha.eswaran@intel.com>
Date: Sun, 7 Jun 2020 00:12:18 +0800
Subject: [PATCH] DRV_DPM_SW-297 dpm to support bridge_port_CPU enable/disable

---
 drivers/net/datapath/dpm/datapath_api.c   | 6 +++++-
 drivers/net/datapath/dpm/datapath_proc.c  | 3 +++
 drivers/net/datapath/dpm/datapath_swdev.c | 9 +++++++++
 include/net/datapath_api.h                | 6 +++++-
 4 files changed, 22 insertions(+), 2 deletions(-)

diff --git a/drivers/net/datapath/dpm/datapath_api.c b/drivers/net/datapath/dpm/datapath_api.c
index 7b5e172a4a47..9403aac6b278 100644
--- a/drivers/net/datapath/dpm/datapath_api.c
+++ b/drivers/net/datapath/dpm/datapath_api.c
@@ -720,7 +720,11 @@ int32_t dp_register_subif_private(int inst, struct module *owner,
 			sif->swdev_en = port_info->swdev_en;
 #endif
 		port_info->status = PORT_SUBIF_REGISTERED;
-		sif->cpu_port_en = 1;
+		/* to disable CPU bridge port from bp member list */
+		if (data->flag_ops & DP_SUBIF_BP_CPU_DISABLE)
+			sif->cpu_port_en = 0;
+		else
+			sif->cpu_port_en = 1;
 		subif_id->port_id = port_id;
 		subif_id->subif = sif->subif;
 		sif->subif_groupid = i;
diff --git a/drivers/net/datapath/dpm/datapath_proc.c b/drivers/net/datapath/dpm/datapath_proc.c
index 781706281df8..01617351603e 100644
--- a/drivers/net/datapath/dpm/datapath_proc.c
+++ b/drivers/net/datapath/dpm/datapath_proc.c
@@ -376,6 +376,9 @@ int proc_port_dump(struct seq_file *s, int pos)
 		seq_printf(s, "           mac_learn_dis:  %d\n",
 			   sif->mac_learn_dis);
 		seq_printf(s, "           gpid:           %d\n", sif->gpid);
+		seq_printf(s, "           cpu_port_en:    %d (%s)\n",
+			   sif->cpu_port_en,
+			   sif->cpu_port_en ? "Enabled" : "Disabled");
 		seq_puts(s, "           ctp_dev:        ");
 		if (sif->ctp_dev && sif->ctp_dev->name)
 			seq_puts(s, sif->ctp_dev->name);
diff --git a/drivers/net/datapath/dpm/datapath_swdev.c b/drivers/net/datapath/dpm/datapath_swdev.c
index 923ff35cfc82..8ba4c25e17f3 100644
--- a/drivers/net/datapath/dpm/datapath_swdev.c
+++ b/drivers/net/datapath/dpm/datapath_swdev.c
@@ -405,11 +405,20 @@ static int dp_swdev_cfg_gswip(struct bridge_id_entry_item *br_item,
 {
 	struct inst_info *i_info;
 	struct br_info *br_info;
+	struct dp_bp_attr conf;
 	int ret;
 
 	i_info = get_dp_prop_info(br_item->inst);
 	DP_DEBUG(DP_DBG_FLAG_SWDEV, "britem flags:%x\n", br_item->flags);
 
+	if (br_item->flags & CPU_PORT_DISABLE) {
+		/* Remove CPU bridge port from bp member list */
+		conf.inst = br_item->inst;
+		conf.dev = dev;
+		conf.en = 0;
+		i_info->dp_set_bp_attr(&conf, br_item->bportid, 0);
+	}
+
 	if (br_item->flags & ADD_BRENTRY) {
 		DP_DEBUG(DP_DBG_FLAG_SWDEV, "Add bridge entry %s\n",
 			 br_item->dev->name);
diff --git a/include/net/datapath_api.h b/include/net/datapath_api.h
index bd5cb311f522..8b58d24ec4a5 100644
--- a/include/net/datapath_api.h
+++ b/include/net/datapath_api.h
@@ -838,6 +838,10 @@ enum DP_SUBIF_DATA_FLAG {
 	DP_SUBIF_SWDEV = BIT(6), /*!< To specify subif level swdev
 				  * enable/disable
 				  */
+	DP_SUBIF_BP_CPU_DISABLE = BIT(7), /*!< To remove CPU bridge port
+					   * from bridge port member list
+					   */
+
 };
 
 /*! @brief dp_subif_id struct for get_netif_subif */
@@ -1083,7 +1087,7 @@ struct dp_buf_info {
  */
 int dp_free_dc_buf(struct dp_buf_info *buf, int flag);
 
-/*! @brief enum DP_SUBIF_DATA_FLAG */
+/*! @brief enum DP_DEV_DATA_FLAG */
 enum DP_DEV_DATA_FLAG {
 	DP_F_DEV_RESV_Q = BIT(0), /*!< Reserve queues for this dev
 				   * based on num_resv_q
