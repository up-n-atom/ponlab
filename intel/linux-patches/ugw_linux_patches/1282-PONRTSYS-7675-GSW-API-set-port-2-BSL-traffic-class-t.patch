From 260719317bbfbfdf5726fab030c77008f84639b5 Mon Sep 17 00:00:00 2001
From: Xu Liang <liang.xu@intel.com>
Date: Mon, 22 Jun 2020 19:48:17 +0800
Subject: [PATCH] PONRTSYS-7675: GSW API - set port 2 BSL traffic class to 2 to
 leave some FSQM segments for downstream traffic

---
 drivers/net/ethernet/lantiq/switch-api/gsw_defconf.c | 11 ++++++++---
 1 file changed, 8 insertions(+), 3 deletions(-)

diff --git a/drivers/net/ethernet/lantiq/switch-api/gsw_defconf.c b/drivers/net/ethernet/lantiq/switch-api/gsw_defconf.c
index a2091ba22ab6..f204690d97b4 100644
--- a/drivers/net/ethernet/lantiq/switch-api/gsw_defconf.c
+++ b/drivers/net/ethernet/lantiq/switch-api/gsw_defconf.c
@@ -499,10 +499,15 @@ static int pmac_eg_cfg(struct core_ops *ops, u8 pmacid, u8 dpu)
 					/* Pmac1, PCE bypass traffic to MAC2*/
 					/* Pmac0, PCE-Bypass Traf to MAC3-MAC4*/
 					else {
-						if (m == 3 || m == 4)
-							/* BSL priority to 1 for Dest port 3 and 4*/
+						if (pmacid == 1 && m == 2)
+							/* BSL priority to 2 for upstream port
+							   to leave some FSQM segments for
+							   downstream traffic */
+							eg_cfg.nBslTrafficClass = 2;
+						else if (m == 3 || m == 4)
+							/* BSL priority to 3 for Dest port 3 and 4*/
 							/* support for above 3.0 GSWIP versions */
-							eg_cfg.nBslTrafficClass =1;
+							eg_cfg.nBslTrafficClass = 3;
 						/* Every Pkt has Pmac header */
 						eg_cfg.bPmacEna = 1;
 						/* Pkt can be segmented. */
