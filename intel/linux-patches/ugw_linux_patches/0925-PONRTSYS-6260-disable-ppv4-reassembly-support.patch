From 3e05a82342e83492766041e89193573546ccb332 Mon Sep 17 00:00:00 2001
From: Emergi Idan <idan.emergi@intel.com>
Date: Wed, 11 Dec 2019 12:06:35 +0200
Subject: [PATCH] PONRTSYS-6260: disable ppv4 reassembly support

Signed-off-by: Emergi Idan <idan.emergi@intel.com>
---
 drivers/net/ppv4/pp-api/pp-misc/pp_misc.c     | 3 ++-
 drivers/net/ppv4/pp-hal/checker/checker.h     | 1 +
 drivers/net/ppv4/pp-hal/micro-controller/uc.c | 1 +
 3 files changed, 4 insertions(+), 1 deletion(-)

diff --git a/drivers/net/ppv4/pp-api/pp-misc/pp_misc.c b/drivers/net/ppv4/pp-api/pp-misc/pp_misc.c
index 6490a3246c0f..cfb260db03b3 100644
--- a/drivers/net/ppv4/pp-api/pp-misc/pp_misc.c
+++ b/drivers/net/ppv4/pp-api/pp-misc/pp_misc.c
@@ -255,7 +255,8 @@ s32 pp_nf_set(enum pp_nf_type type, struct pp_nf_info *nf)
 	}
 
 	/* store nf info */
-	set_bit(type, &db->nf_en);
+	if (type != PP_NF_REASSEMBLY)
+		set_bit(type, &db->nf_en);
 	memcpy(&db->nf[type], nf, sizeof(*nf));
 
 	/* Notify session manager of the new NF added */
diff --git a/drivers/net/ppv4/pp-hal/checker/checker.h b/drivers/net/ppv4/pp-hal/checker/checker.h
index 16c5a44eb68c..a7693aea1429 100644
--- a/drivers/net/ppv4/pp-hal/checker/checker.h
+++ b/drivers/net/ppv4/pp-hal/checker/checker.h
@@ -76,6 +76,7 @@
  */
 #define SESS_CHCK_DFLT_FLAGS                       \
 		(BIT(SI_CHCK_FLAG_UPDT_SESS_CNT) | \
+		 BIT(SI_CHCK_FLAG_DVRT_FRAG)     | \
 		 BIT(SI_CHCK_FLAG_DYN_SESS))
 
 /**
diff --git a/drivers/net/ppv4/pp-hal/micro-controller/uc.c b/drivers/net/ppv4/pp-hal/micro-controller/uc.c
index 2bb5b78eaf36..83291dcec809 100644
--- a/drivers/net/ppv4/pp-hal/micro-controller/uc.c
+++ b/drivers/net/ppv4/pp-hal/micro-controller/uc.c
@@ -1220,6 +1220,7 @@ s32 uc_nf_set(enum pp_nf_type nf, u16 pid, u16 qos_port, u16 tx_queue,
 			return ret;
 		break;
 	case PP_NF_REASSEMBLY:
+		return 0; /* temporary workaround due to FW issue */
 		uc_port = UC_REASS_PORT;
 
 		ret = __nf_reass_set(tx_queue, dflt_hif);
