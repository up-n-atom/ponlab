From 5419580658549925648cb42eacc6b0ef0ec3588b Mon Sep 17 00:00:00 2001
From: Rekha Eswaran <rekha.eswaran@intel.com>
Date: Fri, 18 Sep 2020 16:53:08 +0800
Subject: [PATCH] DRV_DPM_SW-387 - DPM fix qos debugfs incorrect dump

---
 drivers/net/datapath/dpm/datapath_proc_qos.c | 67 +++++++++++++---------------
 1 file changed, 31 insertions(+), 36 deletions(-)

diff --git a/drivers/net/datapath/dpm/datapath_proc_qos.c b/drivers/net/datapath/dpm/datapath_proc_qos.c
index 0741b1bb7e7d..8f27dea5ae7d 100644
--- a/drivers/net/datapath/dpm/datapath_proc_qos.c
+++ b/drivers/net/datapath/dpm/datapath_proc_qos.c
@@ -631,8 +631,6 @@ struct q_print_info *collect_info(struct seq_file *s,
 static struct dp_queue_res q_res[PROC_MAX_Q_PER_PORT * 4];
 static int qos_layout_inst;
 static int qos_layout_max_lvl = PROC_MAX_BOX_LVL; /* sched/port box */
-static int max_tconf_idx;
-static int curr_tconf_idx;
 struct dp_dequeue_res tmp_res;
 struct dp_queue_res tmp_q_res[PROC_MAX_Q_PER_PORT] = {0};
 #define DP_PROC_BUF_LEN 20
@@ -816,9 +814,8 @@ int get_res(int inst, int dp_port, int tconf_idx)
 	DP_DEBUG(DP_DBG_FLAG_QOS_DETAIL, "%s: dp_port=%d tconf_idx=%d\n",
 		 __func__, tmp_res.dp_port, tmp_res.cqm_deq_idx);
 	if (dp_deq_port_res_get(&tmp_res, 0)) {
-		pr_err("dp_deq_port_res_get fail: inst=%d dp_port=%d, %s=%d\n",
-		       qos_layout_inst, tmp_res.dp_port,
-		       "tconf_idx", curr_tconf_idx);
+		pr_err("dp_deq_port_res_get fail: inst=%d dp_port=%d\n",
+		       qos_layout_inst, tmp_res.dp_port);
 		return -1;
 	}
 	return 0;
@@ -841,9 +838,29 @@ int dump_q_info_dbg(struct seq_file *s, struct dp_dequeue_res *res)
 	return 0;
 }
 
-int qos_dump(struct seq_file *s, int pos)
+static bool print_qos_entry(struct seq_file *s, u8 dpid, u8 egp)
 {
 	struct q_print_info *q_info;
+
+	if (get_res(qos_layout_inst, dpid, egp))
+		return true;
+	dump_q_info_dbg(s, &tmp_res);
+	if (!tmp_res.num_q)
+		return true;
+	q_info = collect_info(s, &tmp_res, qos_layout_max_lvl);
+	if (!q_info)
+		return false;
+	set_child_per_box(q_info);
+	set_location_size(&q_info->port_box, 0);
+	if (!check_location(q_info))
+		print_all(s, q_info);
+	devm_kfree(&g_dp_dev->dev, q_info);
+	return true;
+}
+
+int qos_dump(struct seq_file *s, int pos)
+{
+	int cnt;
 	int i;
 
 	if (!capable(CAP_NET_ADMIN))
@@ -860,38 +877,17 @@ int qos_dump(struct seq_file *s, int pos)
 		seq_puts(s, "  p   :pbs in bytes\n");
 		seq_puts(s, "\n");
 	}
-	max_tconf_idx = get_num_deq_ports(qos_layout_inst, pos);
-	DP_DEBUG(DP_DBG_FLAG_QOS, "dp_port=%d  max_tconf=%d\n",
-		 pos, max_tconf_idx);
-	if (max_tconf_idx <= 0)
-		goto NEXT_DP_PORT;
-	curr_tconf_idx = 0;
-	for (i = 0; i < max_tconf_idx; i++) {
+	cnt = get_num_deq_ports(qos_layout_inst, pos);
+	DP_DEBUG(DP_DBG_FLAG_QOS, "dp_port=%d qos cnt=%d\n", pos, cnt);
+	for (i = 0; i < cnt; i++) {
 		/* get qos resource and store into tmp_res */
-		if (get_res(qos_layout_inst, pos, i))
-			continue;
-		dump_q_info_dbg(s, &tmp_res);
-		if (!tmp_res.num_q)
-			continue;
-		q_info = collect_info(s, &tmp_res, qos_layout_max_lvl);
-		if (!q_info)
-			goto NEXT_DP_PORT;
-		set_child_per_box(q_info);
-		set_location_size(&q_info->port_box, 0);
-		if (check_location(q_info)) {
-			devm_kfree(&g_dp_dev->dev, q_info);
-			continue;
-		}
-		print_all(s, q_info);
-		devm_kfree(&g_dp_dev->dev, q_info);
+		if (!print_qos_entry(s, pos, i))
+			break;
+		if (seq_has_overflowed(s))
+			return pos;
 	}
-NEXT_DP_PORT:
-	if (!seq_has_overflowed(s))
-		pos++;
-	if (pos >= 16)
-		pos = -1;
 
-	return pos;
+	return ++pos >= 16 ? -1 : pos;
 }
 
 int qos_dump_start(void)
@@ -905,7 +901,6 @@ int qos_dump_start(void)
 	 */
 	dp_qos_level_get(&dp, 0);
 	qos_layout_max_lvl = dp.max_sch_lvl + 1;
-	max_tconf_idx = 0;
 	return 0;
 }
 
