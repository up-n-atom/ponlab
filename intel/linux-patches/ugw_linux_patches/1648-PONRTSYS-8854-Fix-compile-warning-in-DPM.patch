From efefd91f5012c2905fac1b26eeff4f365f271f0b Mon Sep 17 00:00:00 2001
From: thampan <joby.thampan@intel.com>
Date: Thu, 15 Apr 2021 14:37:41 +0800
Subject: [PATCH] PONRTSYS-8854: Fix compile warning in DPM

---
 drivers/net/datapath/dpm/gswip31/datapath_switchdev.c | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/drivers/net/datapath/dpm/gswip31/datapath_switchdev.c b/drivers/net/datapath/dpm/gswip31/datapath_switchdev.c
index 5dcb5b3f9658..42a11fe124c6 100644
--- a/drivers/net/datapath/dpm/gswip31/datapath_switchdev.c
+++ b/drivers/net/datapath/dpm/gswip31/datapath_switchdev.c
@@ -114,7 +114,8 @@ int dp_cfg_own_bridgeport(struct br_info *br_item, int inst, int bport,
 	if (!reset) {
 		dp_port = dp_swdev_get_dp_port_from_bp(br_item, bport, &priv_flag);
 		if (dp_port < 0) {
-			pr_err("%s portid:%d for bport=%d invalid\n", __func__, dp_port);
+			pr_err("%s portid:%d for bport=%d invalid\n", __func__, dp_port,
+			       bport);
 			return DP_FAILURE;
 		}
 	}
@@ -200,7 +201,8 @@ int dp_cfg_other_bridgeport(struct br_info *br_item, int inst,
 	if (!reset) {
 		dp_port = dp_swdev_get_dp_port_from_bp(br_item, bport, &priv_flag);
 		if (dp_port < 0) {
-			pr_err("%s portid:%d for bport=%d invalid\n", __func__, dp_port);
+			pr_err("%s portid:%d for bport=%d invalid\n", __func__, dp_port,
+			       bport);
 			return DP_FAILURE;
 		}
 	}
