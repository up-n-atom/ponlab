From 962cf007dce2904d6dfe08e9fc41507ffdaaffd0 Mon Sep 17 00:00:00 2001
From: Xu Liang <liang.xu@intel.com>
Date: Wed, 8 Jul 2020 19:22:35 +0800
Subject: [PATCH] PONRTSYS-7706: ETH - change info message to debug message for
 XPCS ethtool handling

---
 drivers/net/ethernet/lantiq/ltq_eth_drv_xrx500.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/drivers/net/ethernet/lantiq/ltq_eth_drv_xrx500.c b/drivers/net/ethernet/lantiq/ltq_eth_drv_xrx500.c
index c9b05ee50faa..5f17859dd960 100644
--- a/drivers/net/ethernet/lantiq/ltq_eth_drv_xrx500.c
+++ b/drivers/net/ethernet/lantiq/ltq_eth_drv_xrx500.c
@@ -248,7 +248,8 @@ static int set_link_ksettings(struct net_device *dev,
 			    dev->phydev->extended_advertising);
 
 	ret = serdes_ethtool_set_link_ksettings(dev, cmd);
-	pr_info("debug: serdes_ethtool_set_link_ksettings return %d\n", ret);
+	if (ret)
+		pr_debug("debug: serdes_ethtool_set_link_ksettings return %d\n", ret);
 
 	return phy_ethtool_set_link_ksettings(dev, cmd);
 }
@@ -445,7 +446,7 @@ static int serdes_ethtool_set_link_ksettings(struct net_device *dev,
 	int ret = 0;
 	struct platform_device *pdev;
 
-	if (!priv->xpcs_node)
+	if (!priv->xpcs_node || !of_device_is_available(priv->xpcs_node))
 		return -1;
 
 	/* Speed Set in Ethtool */
@@ -463,7 +464,7 @@ static int serdes_ethtool_set_link_ksettings(struct net_device *dev,
 			ret = ops->ethtool_ksettings_set(&pdev->dev, cmd);
 #endif
 	} else {
-		 pr_err("Cannot get Xpcs pdev for %s\n", dev->name);
+		pr_err("Cannot get Xpcs pdev for %s\n", dev->name);
 		ret = -1;
 	}
 
