From fba2d1fd85959949e44db45d52871b4191b6b465 Mon Sep 17 00:00:00 2001
From: Rekha Eswaran <rekha.eswaran@intel.com>
Date: Wed, 3 Jun 2020 21:26:38 +0800
Subject: [PATCH] DRV_DPM_SW-283 : Support reset of PON config during PON port
 de-allocation

---
 drivers/net/datapath/dpm/gswip31/datapath_misc.c | 60 ++++++++++++++++--------
 drivers/net/datapath/dpm/gswip31/datapath_misc.h | 15 ++++++
 2 files changed, 55 insertions(+), 20 deletions(-)

diff --git a/drivers/net/datapath/dpm/gswip31/datapath_misc.c b/drivers/net/datapath/dpm/gswip31/datapath_misc.c
index db4962d102c5..903b0f2d14b3 100644
--- a/drivers/net/datapath/dpm/gswip31/datapath_misc.c
+++ b/drivers/net/datapath/dpm/gswip31/datapath_misc.c
@@ -19,6 +19,17 @@
 #include "datapath_switchdev.h"
 #endif
 
+#define DP_GSWIP_CRC_DISABLE 1
+#define DP_GSWIP_CRC_ENABLE 0
+static struct pon_spl_cfg pon_cfg[] = {
+	{DP_F_DEREGISTER, 0, 1, DP_GSWIP_CRC_ENABLE, GSW_CRC_PAD_INS_EN,
+	 GSW_FLOW_RXTX, TX_SPTAG_REMOVE, RX_TIME_NOTS, RX_SPTAG_INSERT,
+	 RX_FCS_REMOVE},
+	{DP_F_GPON | DP_F_EPON, 1, 1, DP_GSWIP_CRC_DISABLE, GSW_CRC_PAD_INS_DIS,
+	 GSW_FLOW_OFF, TX_SPTAG_REPLACE, RX_TIME_NO_INSERT, RX_SPTAG_NO_INSERT,
+	 0},
+};
+
 static void init_dma_desc_mask(void)
 {
 	/*mask 0: to remove the bit, 1 -- keep the bit */
@@ -1327,8 +1338,6 @@ static int dp_platform_set(int inst, u32 flag)
 	return 0;
 }
 
-#define DP_GSWIP_CRC_DISABLE 1
-#define DP_GSWIP_FLOW_CTL_DISABLE 4
 static int pon_config(int inst, int ep, struct dp_port_data *data, u32 flags)
 {
 	struct core_ops *gsw_handle;
@@ -1336,10 +1345,15 @@ static int pon_config(int inst, int ep, struct dp_port_data *data, u32 flags)
 	GSW_return_t ret;
 	struct mac_ops *mac_ops;
 	GSW_CPU_PortCfg_t cpu_port_cfg;
+	struct pon_spl_cfg *cfg = &pon_cfg[0];
+	int i;
 
-	 /* De-register */
-	if (flags & DP_F_DEREGISTER)
-		return 0;
+	for (i = 0; i < ARRAY_SIZE(pon_cfg); i++) {
+		if ((pon_cfg[i].flag & flags) == flags) {
+			cfg = &pon_cfg[i];
+			break;
+		}
+	}
 
 	mac_ops = dp_port_prop[inst].mac_ops[ep];
 	gsw_handle = dp_port_prop[inst].ops[GSWIP_L];
@@ -1350,38 +1364,42 @@ static int pon_config(int inst, int ep, struct dp_port_data *data, u32 flags)
 		pr_err("fail in getting CPU port config\r\n");
 		return -1;
 	}
-	/* Enable the Egress and Ingress Special Tag */
+	/* Setting Egress and Ingress Special Tag */
 	cpu_port_cfg.nPortId = ep;
-	cpu_port_cfg.bSpecialTagIngress = 1;
-	cpu_port_cfg.bSpecialTagEgress = 1;
+	cpu_port_cfg.bSpecialTagIngress = cfg->ingress;
+	cpu_port_cfg.bSpecialTagEgress = cfg->egress;
 	ret = gsw_com->CPU_PortCfgSet(gsw_handle, &cpu_port_cfg);
 	if (ret != GSW_statusOk) {
 		pr_err("Fail in configuring CPU port\n");
 		return -1;
 	}
 
-	/* Disable Rx CRC check. Value '0'-enable, '1'-disable */
-	mac_ops->set_rx_crccheck(mac_ops, DP_GSWIP_CRC_DISABLE);
+	/* Rx CRC check. Value '0'-enable, '1'-disable */
+	mac_ops->set_rx_crccheck(mac_ops, cfg->crc_check);
 
-	/* TX FCS generation disable, Padding Insertion disable. */
+	/* TX FCS generation*/
 	if (data->flag_ops & DP_F_DATA_FCS_DISABLE)
-		mac_ops->set_fcsgen(mac_ops, GSW_CRC_PAD_INS_DIS);
+		mac_ops->set_fcsgen(mac_ops, cfg->fcs_gen);
 
-	/* Disables RX/TX Flow control */
-	mac_ops->set_flow_ctl(mac_ops, DP_GSWIP_FLOW_CTL_DISABLE);
+	/* RX/TX Flow control */
+	mac_ops->set_flow_ctl(mac_ops, cfg->flow_ctrl);
 
-	/* Replace Tx Special Tag Byte 2 & Byte 3 with packet length */
-	mac_ops->mac_op_cfg(mac_ops, TX_SPTAG_REPLACE);
+	/* Replace Tx Special Tag for PON registration */
+	mac_ops->mac_op_cfg(mac_ops, cfg->tx_spl_tag);
 
 	/* Indicate GSWIP that packet coming from PON have timestamp
 	 * In acceleration path, GSWIP can remove the timestamp
+	 * during registration
 	 */
-	mac_ops->mac_op_cfg(mac_ops, RX_TIME_NO_INSERT);
+	mac_ops->mac_op_cfg(mac_ops, cfg->rx_time_stamp);
 
 	/* PON Interface always have a Special Tag from PON -> Xgmac
-	 * so should disable the Dummy Special Tag
+	 * so should disable the Dummy Special Tag for PON registration
 	 */
-	mac_ops->mac_op_cfg(mac_ops, RX_SPTAG_NO_INSERT);
+	mac_ops->mac_op_cfg(mac_ops, cfg->rx_spl_tag);
+
+	if (flags & DP_F_DEREGISTER)
+		mac_ops->mac_op_cfg(mac_ops, cfg->rx_fcs);
 
 	/* Reset the MAC, without this reset the downstream from the PON IP
 	 * will not work when the MAC is not reset in U-Boot before.
@@ -1394,7 +1412,9 @@ static int pon_config(int inst, int ep, struct dp_port_data *data, u32 flags)
 static int dp_port_spl_cfg(int inst, int ep, struct dp_port_data *data,
 			   u32 flags)
 {
-	if (flags & (DP_F_GPON | DP_F_EPON))
+	struct pmac_port_info *port_info = get_dp_port_info(inst, ep);
+
+	if (port_info->alloc_flags & (DP_F_GPON | DP_F_EPON))
 		pon_config(inst, ep, data, flags);
 	return 0;
 }
diff --git a/drivers/net/datapath/dpm/gswip31/datapath_misc.h b/drivers/net/datapath/dpm/gswip31/datapath_misc.h
index 7284403527c6..f3b98e70f034 100644
--- a/drivers/net/datapath/dpm/gswip31/datapath_misc.h
+++ b/drivers/net/datapath/dpm/gswip31/datapath_misc.h
@@ -198,6 +198,21 @@ struct ctp_assign {
 	u16 swdev_enable; /* To enable or disable switchdev feature */
 };
 
+/* brief structure to set special config for PON port registration */
+struct pon_spl_cfg {
+	int flag;
+	u8 ingress; /* ingress special tag */
+	u8 egress; /* egress special tag */
+	u8 crc_check; /* Rx CRC check */
+	u32 fcs_gen; /* Tx FCS */
+	u32 flow_ctrl; /* Rx/Tx flow control */
+	/* special Mac operations */
+	MAC_OPER_CFG tx_spl_tag;
+	MAC_OPER_CFG rx_time_stamp;
+	MAC_OPER_CFG rx_spl_tag;
+	MAC_OPER_CFG rx_fcs;
+};
+
 #define SET_PMAC_IGP_EGP(pmac, port_id) ((pmac)->igp_egp = (port_id) & 0xF)
 
 #define SET_PMAC_SUBIF(pmac, subif) do { \
