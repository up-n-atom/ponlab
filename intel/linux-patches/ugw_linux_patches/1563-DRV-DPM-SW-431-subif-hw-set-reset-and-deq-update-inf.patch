+	struct bp_pmapper *bp_info;
+	bool bp_cfg = false;
+	int vap = 0;
+
+	port_info = get_dp_port_info(inst, portid);
+	sif = get_dp_port_subif(port_info, subif_idx);
+
+	/* CTP Max = 1 only in case of DSL now */
+	if (port_info->ctp_max == 1) {
+		if (!port_info->num_subif)
+			bp_cfg = true;
+	} else {
+		vap = subif_idx;
+		bp_cfg = true;
+	}
+
