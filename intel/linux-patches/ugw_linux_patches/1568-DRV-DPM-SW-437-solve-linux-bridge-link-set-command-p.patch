From a93a82355fb5942cc66a28881733081f837d975c Mon Sep 17 00:00:00 2001
From: Rekha Eswaran <rekha.eswaran@intel.com>
Date: Wed, 23 Dec 2020 13:08:05 +0800
Subject: [PATCH] DRV_DPM_SW-437 - solve linux bridge link set command parsing
 error

---
 drivers/net/datapath/dpm/datapath_br_vlan.c | 11 ++++++++---
 drivers/net/datapath/dpm/datapath_swdev.c   |  3 ++-
 2 files changed, 10 insertions(+), 4 deletions(-)

diff --git a/drivers/net/datapath/dpm/datapath_br_vlan.c b/drivers/net/datapath/dpm/datapath_br_vlan.c
index 979ce5f67f10..bbdc36776f22 100644
--- a/drivers/net/datapath/dpm/datapath_br_vlan.c
+++ b/drivers/net/datapath/dpm/datapath_br_vlan.c
@@ -1096,10 +1096,15 @@ static int dp_register_master(struct br_info *br_info,
 static int parse_netlink_msg(struct nlmsghdr *nlh, u16 *vid,
 			     u16 *br_flags)
 {
-	struct nlattr *attr, *br_spec;
+	struct nlattr *attr, *br_spec, *protinfo;
 	int rem;
 	struct bridge_vlan_info *vinfo = NULL;
 
+	protinfo = nlmsg_find_attr(nlh, sizeof(struct ifinfomsg),
+				   IFLA_PROTINFO);
+	if (protinfo)
+		return DP_SUCCESS;
+
 	br_spec = nlmsg_find_attr(nlh, sizeof(struct ifinfomsg), IFLA_AF_SPEC);
 	if (!br_spec)
 		return -EINVAL;
@@ -1158,7 +1163,7 @@ int dp_ndo_bridge_setlink(struct net_device *dev, struct nlmsghdr *nlh,
 	}
 
 	DP_LIB_LOCK(&dp_lock);
-	dp_dev = dp_dev_lookup(br_dev);
+	dp_dev = dp_dev_lookup(dev);
 	if (!dp_dev) {
 		pr_err("%s: dp_dev NULL\n", __func__);
 		ret = -EINVAL;
@@ -1168,7 +1173,7 @@ int dp_ndo_bridge_setlink(struct net_device *dev, struct nlmsghdr *nlh,
 	/* if Vland ID and Bridge Flags are not set return the original ops */
 	if (!vid && !br_flags) {
 		if (dp_dev->old_dev_ops->ndo_bridge_setlink)
-			ret = dp_dev->old_dev_ops->ndo_bridge_setlink(br_dev,
+			ret = dp_dev->old_dev_ops->ndo_bridge_setlink(dev,
 					nlh, flags);
 		else
 			ret = -EFAULT;
diff --git a/drivers/net/datapath/dpm/datapath_swdev.c b/drivers/net/datapath/dpm/datapath_swdev.c
index 9de28ea29659..135b19bbb616 100644
--- a/drivers/net/datapath/dpm/datapath_swdev.c
+++ b/drivers/net/datapath/dpm/datapath_swdev.c
@@ -311,7 +311,8 @@ static int dp_swdev_clr_gswip_cfg(struct bridge_id_entry_item *br_item,
 	if (ret == DEL_BRENTRY) {
 		i_info->swdev_free_brcfg(br_item->inst, br_item->fid);
 
-		dp_register_br_vlan(br_info, DP_OPS_RESET);
+		if (i_info->vlan_aware_flag)
+			dp_register_br_vlan(br_info, DP_OPS_RESET);
 
 		dp_swdev_remove_bridge_id_entry(br_info);
 
