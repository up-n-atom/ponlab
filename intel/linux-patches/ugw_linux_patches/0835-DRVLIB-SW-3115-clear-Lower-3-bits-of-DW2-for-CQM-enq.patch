From fd97d6c46e5c253f006523f55a9ae7fd11cba94a Mon Sep 17 00:00:00 2001
From: kavitha3 <k.subramanian@intel.com>
Date: Fri, 18 Oct 2019 14:44:17 +0800
Subject: [PATCH] DRVLIB_SW-3115: clear Lower 3 bits of DW2 for CQM enqueue
 descriptors

---
 drivers/net/ethernet/lantiq/cqm/prx300/cqm.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/net/ethernet/lantiq/cqm/prx300/cqm.c b/drivers/net/ethernet/lantiq/cqm/prx300/cqm.c
index b15504841e6c..46f51c28115a 100644
--- a/drivers/net/ethernet/lantiq/cqm/prx300/cqm.c
+++ b/drivers/net/ethernet/lantiq/cqm/prx300/cqm.c
@@ -1688,7 +1688,7 @@ static int setup_desc(struct cbm_desc *desc, u32 data_ptr, u32 data_len,
 	if (!desc)
 		return CBM_FAILURE;
 	memset(&temp_desc, 0, sizeof(struct dma_desc));
-	temp_desc.data_ptr		= data_ptr;
+	temp_desc.data_ptr		= data_ptr & (~0x7);
 	temp_desc.data_len		= data_len;
 	temp_desc.byte_offset	= data_ptr & 0x7;
 	temp_desc.sop			= 1;
