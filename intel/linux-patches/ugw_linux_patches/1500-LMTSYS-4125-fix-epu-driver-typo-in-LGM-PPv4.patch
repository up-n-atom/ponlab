From 59830ed1e794996b28c9a9726e26b975602d157c Mon Sep 17 00:00:00 2001
From: yixin zhu <yixin.zhu@intel.com>
Date: Fri, 30 Oct 2020 11:01:57 +0800
Subject: [PATCH] LMTSYS-4125: fix epu driver typo in LGM PPv4

---
 drivers/net/ppv4/pp-api/pp-misc/pp_misc.c | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/drivers/net/ppv4/pp-api/pp-misc/pp_misc.c b/drivers/net/ppv4/pp-api/pp-misc/pp_misc.c
index e0dc243d825c..833dd86fc9ed 100644
--- a/drivers/net/ppv4/pp-api/pp-misc/pp_misc.c
+++ b/drivers/net/ppv4/pp-api/pp-misc/pp_misc.c
@@ -1348,9 +1348,9 @@ s32 pp_misc_init(struct pp_misc_init_param *init_param)
 		return ret;
 	}
 
-	ret = epu_adp_lvl_notitfy_register(&nb);
+	ret = epu_adp_lvl_notify_register(&nb);
 	if (unlikely(ret))
-		pr_err("Failed to epu_adp_lvl_notitfy_register\n");
+		pr_err("Failed to epu_adp_lvl_notify_register\n");
 
 #endif /* CONFIG_PPV4_LGM */
 
@@ -1381,7 +1381,7 @@ void pp_misc_exit(void)
 		kfree(db);
 		db = NULL;
 	}
-	epu_adp_lvl_notitfy_unregister(&nb);
+	epu_adp_lvl_notify_unregister(&nb);
 #endif
 
 	pr_debug("done\n");
