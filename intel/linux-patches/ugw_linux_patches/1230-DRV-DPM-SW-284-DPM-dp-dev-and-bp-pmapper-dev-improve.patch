-	if (!subif)
-		return DP_FAILURE;
-
-	subif->subif = ctp;
-
 	dp_dev = dp_dev_lookup(dev);
 	if (!dp_dev) {
 		dp_dev = devm_kzalloc(&g_dp_dev->dev, sizeof(*dp_dev),
 				      GFP_ATOMIC);
-		if (dp_dev) {
-			INIT_LIST_HEAD(&dp_dev->ctp_list);
+		if (dp_dev)
