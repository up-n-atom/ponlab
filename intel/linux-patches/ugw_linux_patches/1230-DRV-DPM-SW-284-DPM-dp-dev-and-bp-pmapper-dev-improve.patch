From b922f2d78a70fc1ea22013a4abd4cb06fc2f6c29 Mon Sep 17 00:00:00 2001
From: Shahed Shaikh <shahedx.shaikh@intel.com>
Date: Thu, 4 Jun 2020 16:06:39 +0800
Subject: [PATCH] DRV_DPM_SW-284: DPM dp_dev and bp_pmapper_dev improvements

Signed-off-by: Shahed Shaikh <shahedx.shaikh@intel.com>
---
 drivers/net/datapath/dpm/datapath.h              | 10 +--
 drivers/net/datapath/dpm/datapath_api.c          | 19 ++---
 drivers/net/datapath/dpm/datapath_instance.c     | 89 ++++++++++--------------
 drivers/net/datapath/dpm/datapath_instance.h     | 11 ---
 drivers/net/datapath/dpm/gswip31/datapath_misc.c | 14 ++--
 5 files changed, 57 insertions(+), 86 deletions(-)

diff --git a/drivers/net/datapath/dpm/datapath.h b/drivers/net/datapath/dpm/datapath.h
index 68cfaae5d56a..13a7f2c3ff3e 100644
--- a/drivers/net/datapath/dpm/datapath.h
+++ b/drivers/net/datapath/dpm/datapath.h
@@ -647,7 +647,7 @@ struct pmac_port_info {
 };
 
 /*bridge port with pmapper supported dev structure */
-struct bp_pmapper_dev {
+struct bp_pmapper {
 	int flag;/*0-FREE, 1-Used*/
 	struct net_device *dev; /*bridge port device pointer */
 	int pcp[DP_PMAP_PCP_NUM];  /*PCP table */
@@ -814,7 +814,7 @@ extern struct pmac_port_info *dp_port_info[DP_MAX_INST];
 extern struct q_info dp_q_tbl[DP_MAX_INST][DP_MAX_QUEUE_NUM];
 extern struct dp_sched_info dp_sched_tbl[DP_MAX_INST][DP_MAX_SCHED_NUM];
 extern struct cqm_port_info dp_deq_port_tbl[DP_MAX_INST][DP_MAX_CQM_DEQ];
-extern struct bp_pmapper_dev dp_bp_dev_tbl[DP_MAX_INST][DP_MAX_BP_NUM];
+extern struct bp_pmapper dp_bp_tbl[DP_MAX_INST][DP_MAX_BP_NUM];
 extern struct dma_chan_info *dp_dma_chan_tbl[DP_MAX_INST];
 extern u32 reinsert_deq_port;
 
@@ -833,9 +833,9 @@ static inline struct cqm_port_info *get_dp_deqport_info(int inst, int idx)
 	return &dp_deq_port_tbl[inst][idx];
 }
 
-static inline struct bp_pmapper_dev *get_dp_bp_info(int inst, int idx)
+static inline struct bp_pmapper *get_dp_bp_info(int inst, int idx)
 {
-	return &dp_bp_dev_tbl[inst][idx];
+	return &dp_bp_tbl[inst][idx];
 }
 
 static inline struct q_info *get_dp_q_info(int inst, int idx)
@@ -980,7 +980,7 @@ int get_dp_port_status_str_size(void);
 
 int dp_request_inst(struct dp_inst_info *info, u32 flag);
 int register_dp_cap(u32 flag);
-int bp_pmapper_dev_get(int inst, struct net_device *dev);
+int bp_pmapper_get(int inst, struct net_device *dev);
 extern int dp_init_ok;
 extern int dp_cpu_init_ok;
 void set_chksum(struct pmac_tx_hdr *pmac, u32 tcp_type,
diff --git a/drivers/net/datapath/dpm/datapath_api.c b/drivers/net/datapath/dpm/datapath_api.c
index d5c4ea6a06e5..c4798f1ad65c 100644
--- a/drivers/net/datapath/dpm/datapath_api.c
+++ b/drivers/net/datapath/dpm/datapath_api.c
@@ -75,12 +75,13 @@ struct inst_property dp_port_prop[DP_MAX_INST];
 /* Keep all subif information per instance/LPID/subif */
 struct pmac_port_info *dp_port_info[DP_MAX_INST];
 
-/* bp_mapper_dev[] is mainly for PON case
+/* dp_bp_tbl[] is mainly for PON case.
  * Only if multiple gem port are attached to same bridge port,
- * This bridge port device will be recorded into this bp_mapper_dev[].
+ * ie, both dev and data->ctp_dev are provided when calling dp_register_subif_ext API
+ * This bridge port device will be recorded into this dp_bp_tbl[].
  * later other information, like pmapper ID/mapping table will be put here also
  */
-struct bp_pmapper_dev dp_bp_dev_tbl[DP_MAX_INST][DP_MAX_BP_NUM];
+struct bp_pmapper dp_bp_tbl[DP_MAX_INST][DP_MAX_BP_NUM];
 /* q_tbl[] is mainly for the queue created/used during dp_register_subif_ext
  */
 struct q_info dp_q_tbl[DP_MAX_INST][DP_MAX_QUEUE_NUM];
@@ -1028,7 +1029,7 @@ int32_t dp_update_subif_info(struct dp_subif_upd_info *info)
 	int vap, bp = 0, fid = 0, res = DP_FAILURE;
 	int f_new_subif = -1, f_old_subif = -1, f_rem_old_dev = 0;
 	struct net_device *old_dev, *old_ctp_dev;
-	struct bp_pmapper_dev *bp_info;
+	struct bp_pmapper *bp_info;
 	dp_subif_t *new_subif_id_sync, *old_subif_id_sync;
 	dp_get_netif_subifid_fn_t subifid_fn = NULL;
 	struct dp_subif_data old_data = {0}, new_data = {0};
@@ -1134,7 +1135,7 @@ int32_t dp_update_subif_info(struct dp_subif_upd_info *info)
 		old_data.ctp_dev = old_ctp_dev;
 	}
 	/* remove old dev */
-	if ((!bp_info->dev) && (f_rem_old_dev)) {
+	if ((!bp_info->ref_cnt) && (f_rem_old_dev)) {
 		DP_DEBUG(DP_DBG_FLAG_REG,
 			 "del old master dev(%s) from dp_dev list\n",
 			 old_dev->name);
@@ -2294,7 +2295,7 @@ int dp_set_pmapper(struct net_device *dev, struct dp_pmapper *mapper, u32 flag)
 	dp_subif_t subif = {0};
 	struct dp_pmapper *map = NULL;
 	int res = DP_FAILURE;
-	struct bp_pmapper_dev *bp_info;
+	struct bp_pmapper *bp_info;
 	struct inst_info *dp_info;
 
 	if (!dev || !mapper) {
@@ -2682,14 +2683,14 @@ EXPORT_SYMBOL(dp_set_bp_attr);
  *success: >=0
  *fail: DP_FAILURE
  */
-int bp_pmapper_dev_get(int inst, struct net_device *dev)
+int bp_pmapper_get(int inst, struct net_device *dev)
 {
 	int i;
-	struct bp_pmapper_dev *bp_info;
+	struct bp_pmapper *bp_info;
 
 	if (!dev)
 		return -1;
-	for (i = 0; i < ARRAY_SIZE(dp_bp_dev_tbl[inst]); i++) {
+	for (i = 0; i < ARRAY_SIZE(dp_bp_tbl[inst]); i++) {
 		bp_info = get_dp_bp_info(inst, i);
 		if (!bp_info->flag)
 			continue;
