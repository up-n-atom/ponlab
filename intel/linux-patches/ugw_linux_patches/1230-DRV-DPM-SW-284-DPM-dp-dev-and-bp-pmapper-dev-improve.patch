-			devm_kfree(&g_dp_dev->dev, subif);
+		else
 			return DP_FAILURE;
-		}
 	}
 
 	if (new_f || !(dp_dev->owner & DP_OPS_OWNER_DPM)) {
@@ -299,7 +289,6 @@ int dp_inst_add_dev(struct net_device *dev, char *subif_name, int inst,
 	}
 
 	dp_dev->count++;
-	list_add(&subif->list, &dp_dev->ctp_list);
 
