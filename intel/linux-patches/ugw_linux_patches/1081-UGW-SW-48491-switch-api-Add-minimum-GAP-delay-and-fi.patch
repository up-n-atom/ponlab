From e797034b5dcb83d833722c826a7c006d1c2f060c Mon Sep 17 00:00:00 2001
From: "Vishnu Swaroop Kumar Sarma, Duddu" <duddu.swaroop@intel.com>
Date: Mon, 23 Mar 2020 17:12:16 +0530
Subject: [PATCH] UGW_SW-48491 switch_api: Add minimum GAP delay and fix
 indexing for GSWIP-3.0

---
 .../net/ethernet/lantiq/switch-api/gsw_flow_core.c | 44 ++++++++++++----------
 1 file changed, 24 insertions(+), 20 deletions(-)

diff --git a/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c b/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c
index 45f2d6a3d9e2..13aa259bf32b 100644
--- a/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c
+++ b/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c
@@ -12648,14 +12648,13 @@ GSW_return_t GSW_MDIO_DataWrite(void *cdev, GSW_MDIO_data_t *parm)
 
 }
 
-static inline void ltq_mdelay(int delay)
+static inline void ltq_mdelay_for_mdio(void)
 {
-	int i;
-
-	for (i = delay; i > 0; i--)
-		;
-
-	//udelay(1000);
+	/* After disabling auto polling need to wait
+	 * for atleast 256 * GAP MDIO cycles
+	 * Considering min MDI0 clk of 97.6Khz and autopolling
+	 * gap as (0xF)* 256 cycles it comes to around 40 ms */
+	mdelay(40);
 }
 
 static int force_to_configure_phy_settings(void *cdev, u8 pidx, u8 link_status)
@@ -12830,13 +12829,15 @@ GSW_return_t GSW_MmdDataRead(void *cdev, GSW_MMD_data_t *parm)
 		if (gswdev->gipver == LTQ_GSWIP_3_0) {
 			gsw_r32(cdev, (GSWT_MDCCFG_0_PEN_1_OFFSET + GSW30_TOP_OFFSET),
 				GSWT_MDCCFG_0_PEN_1_SHIFT, 6, &mdc_reg);
+			rmdc = mdc_reg;
+			mdc_reg &= ~(1 << (pidx - 1));
 		} else {
 			gsw_r32(cdev, (MDC_CFG_0_PEN_0_OFFSET + GSW_TREG_OFFSET),
 				MDC_CFG_0_PEN_0_SHIFT, 6, &mdc_reg);
+			rmdc = mdc_reg;
+			mdc_reg &= ~(1 << pidx);
 		}
 
-		rmdc = mdc_reg;
-		mdc_reg &= ~(1 << pidx);
 		dev = ((parm->nAddressReg >> 16) & 0x1F);
 
 		if (gswdev->gipver == LTQ_GSWIP_3_0) {
@@ -12847,7 +12848,7 @@ GSW_return_t GSW_MmdDataRead(void *cdev, GSW_MMD_data_t *parm)
 				MDC_CFG_0_PEN_0_SHIFT, 6, mdc_reg);
 		}
 
-		ltq_mdelay(20);
+		ltq_mdelay_for_mdio();
 		mmd_data.nAddressDev = parm->nAddressDev;
 		mmd_data.nAddressReg = 0xd;
 		mmd_data.nData = dev;
@@ -12881,7 +12882,7 @@ GSW_return_t GSW_MmdDataRead(void *cdev, GSW_MMD_data_t *parm)
 				MDC_CFG_0_PEN_0_SHIFT, 6, rmdc);
 		}
 
-		ltq_mdelay(100);
+		ltq_mdelay_for_mdio();
 		force_to_configure_phy_settings(cdev, pidx, 0);
 	} else {
 		pr_err("(Invalid PHY Address) %s:%s:%d\n",
@@ -12962,14 +12963,16 @@ GSW_return_t GSW_MmdDataWrite(void *cdev, GSW_MMD_data_t *parm)
 			gsw_r32(cdev, (GSWT_MDCCFG_0_PEN_1_OFFSET
 				       + GSW30_TOP_OFFSET),
 				GSWT_MDCCFG_0_PEN_1_SHIFT, 6, &mdc_reg);
+			rmdc = mdc_reg;
+			mdc_reg &= ~(1 << (pidx - 1));
 		} else {
 			gsw_r32(cdev, (MDC_CFG_0_PEN_0_OFFSET
 				       + GSW_TREG_OFFSET),
 				MDC_CFG_0_PEN_0_SHIFT, 6, &mdc_reg);
+			rmdc = mdc_reg;
+			mdc_reg &= ~(1 << pidx);
 		}
 
-		rmdc = mdc_reg;
-		mdc_reg &= ~(1 << pidx);
 		dev = ((parm->nAddressReg >> 16) & 0x1F);
 
 		if (gswdev->gipver == LTQ_GSWIP_3_0) {
@@ -12982,7 +12985,7 @@ GSW_return_t GSW_MmdDataWrite(void *cdev, GSW_MMD_data_t *parm)
 				MDC_CFG_0_PEN_0_SHIFT, 6, mdc_reg);
 		}
 
-		ltq_mdelay(20);
+		ltq_mdelay_for_mdio();
 		mmd_data.nAddressDev = parm->nAddressDev;
 		mmd_data.nAddressReg = 0xd;
 		mmd_data.nData = dev;
@@ -13016,7 +13019,7 @@ GSW_return_t GSW_MmdDataWrite(void *cdev, GSW_MMD_data_t *parm)
 				MDC_CFG_0_PEN_0_SHIFT, 6, rmdc);
 		}
 
-		ltq_mdelay(100);
+		ltq_mdelay_for_mdio();
 		force_to_configure_phy_settings(cdev, pidx, 0);
 	} else {
 		pr_err("(Invalid PHY Address)  %s:%s:%d\n",
@@ -13062,13 +13065,13 @@ static GSW_return_t GSW_MMD_MDIO_DataWrite(void *cdev,
 		gsw_r32(cdev, (GSWT_MDCCFG_0_PEN_1_OFFSET
 			       + GSW30_TOP_OFFSET),
 			GSWT_MDCCFG_0_PEN_1_SHIFT, 6, &mdc_reg);
+		mdc_reg &= ~(1 << (pidx - 1));
 	} else {
 		gsw_r32(cdev, (MDC_CFG_0_PEN_0_OFFSET + GSW_TREG_OFFSET),
 			MDC_CFG_0_PEN_0_SHIFT, 6, &mdc_reg);
+		mdc_reg &= ~(1 << pidx);
 	}
 
-	mdc_reg &= ~(1 << pidx);
-
 	if (gswdev->gipver == LTQ_GSWIP_3_0) {
 		gsw_w32(cdev, (GSWT_MDCCFG_0_PEN_1_OFFSET
 			       + GSW30_TOP_OFFSET),
@@ -13078,7 +13081,7 @@ static GSW_return_t GSW_MMD_MDIO_DataWrite(void *cdev,
 			MDC_CFG_0_PEN_0_SHIFT, 6, mdc_reg);
 	}
 
-	ltq_mdelay(20);
+	ltq_mdelay_for_mdio();
 
 	mmd_data.nAddressDev = parm->nAddressDev;
 	mmd_data.nAddressReg = 0xd;
@@ -13100,18 +13103,19 @@ static GSW_return_t GSW_MMD_MDIO_DataWrite(void *cdev,
 	mmd_data.nData = parm->nData;
 	GSW_MDIO_DataWrite(cdev, &mmd_data);
 
-	mdc_reg |= (1 << pidx);
 
 	if (gswdev->gipver == LTQ_GSWIP_3_0) {
+		mdc_reg |= (1 << (pidx - 1));
 		gsw_w32(cdev, (GSWT_MDCCFG_0_PEN_1_OFFSET
 			       + GSW30_TOP_OFFSET),
 			GSWT_MDCCFG_0_PEN_1_SHIFT, 6, mdc_reg);
 	} else {
+		mdc_reg |= (1 << pidx);
 		gsw_w32(cdev, (MDC_CFG_0_PEN_0_OFFSET + GSW_TREG_OFFSET),
 			MDC_CFG_0_PEN_0_SHIFT, 6, mdc_reg);
 	}
 
-	ltq_mdelay(100);
+	ltq_mdelay_for_mdio();
 	force_to_configure_phy_settings(cdev, pidx, 0);
 	ret = GSW_statusOk;
 
