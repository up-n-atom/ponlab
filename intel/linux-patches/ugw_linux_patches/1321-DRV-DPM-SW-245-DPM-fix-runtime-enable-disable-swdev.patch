From bb9a4b3f2457f2f69655fbafdc8d98da9bf5b4eb Mon Sep 17 00:00:00 2001
From: Gu Chao <gux.chao@intel.com>
Date: Tue, 7 Jul 2020 14:53:11 +0800
Subject: [PATCH] DRV_DPM_SW-245: DPM fix runtime enable/disable swdev

---
 drivers/net/datapath/dpm/datapath_proc.c | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/drivers/net/datapath/dpm/datapath_proc.c b/drivers/net/datapath/dpm/datapath_proc.c
index b540075645f6..2de745d4b1f5 100644
--- a/drivers/net/datapath/dpm/datapath_proc.c
+++ b/drivers/net/datapath/dpm/datapath_proc.c
@@ -705,11 +705,11 @@ static int set_switchdev(int inst, int ep, int vap, bool enable)
 	rtnl_unlock();
 
 	if (enable) {
+		sif->swdev_en = 1;
 		if (dp_register_switchdev_ops(dp_dev, 0)) {
 			pr_err("fail to register swdev ops\n");
 			return DP_FAILURE;
 		}
-		sif->swdev_en = 1;
 		pr_info("swdev is enabled\n");
 		if (br_dev) {
 			pr_info("master upper device (bridge?) detected\n");
@@ -721,9 +721,9 @@ static int set_switchdev(int inst, int ep, int vap, bool enable)
 			pr_err("please remove link to upper dev before disabling switchdev\n");
 			return DP_FAILURE;
 		}
-		if (dev->switchdev_ops == &dp_dev->new_swdev_ops) {
-			dev->switchdev_ops = dp_dev->old_swdev_ops;
-			dp_dev->old_swdev_ops = NULL;
+		if (dp_register_switchdev_ops(dp_dev, 1)) {
+			pr_err("fail to deregister swdev ops\n");
+			return DP_FAILURE;
 		}
 		sif->swdev_en = 0;
 		pr_info("swdev is disabled\n");
