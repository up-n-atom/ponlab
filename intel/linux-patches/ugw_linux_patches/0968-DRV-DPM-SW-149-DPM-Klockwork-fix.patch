 2 files changed, 188 insertions(+), 55 deletions(-)

diff --git a/drivers/net/datapath/dpm/datapath_notifier.c b/drivers/net/datapath/dpm/datapath_notifier.c
index 30a4e0946438..fb658fd75407 100644
--- a/drivers/net/datapath/dpm/datapath_notifier.c
+++ b/drivers/net/datapath/dpm/datapath_notifier.c
@@ -293,13 +293,15 @@ int register_dp_event_notifier(struct dp_event *info)
 	struct notifier_block *nb = NULL;
 
 	if (!info->id) {
-		evt_notif = kzalloc(sizeof(*evt_notif), GFP_ATOMIC);
+		evt_notif = devm_kzalloc(&g_dp_dev->dev, sizeof(*evt_notif), GFP_ATOMIC);
 		if (!evt_notif)
 			return DP_FAILURE;
 
-		nb = kzalloc(sizeof(*nb), GFP_ATOMIC);
-		if (!nb)
+		nb = devm_kzalloc(&g_dp_dev->dev, sizeof(*nb), GFP_ATOMIC);
+		if (!nb) {
+			devm_kfree(&g_dp_dev->dev, evt_notif);
 			return DP_FAILURE;
+		}
 
 		nb->notifier_call = dp_notifier;
 	} else {
@@ -350,7 +352,8 @@ int unregister_dp_event_notifier(struct dp_event *info)
 	}
 
 	atomic_notifier_chain_unregister(&dp_evt_notif_list, evt_notif->nb);
-	kfree(evt_notif->nb);
+	devm_kfree(&g_dp_dev->dev, evt_notif->nb);
+	devm_kfree(&g_dp_dev->dev, evt_notif);
 
 	return 0;
 }
