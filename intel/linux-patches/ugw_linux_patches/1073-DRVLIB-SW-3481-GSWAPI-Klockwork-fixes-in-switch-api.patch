From 495775981d7f7c665e34f4feb58a65df5cafb637 Mon Sep 17 00:00:00 2001
From: Dinesh Sudham <dineshx.sudham@intel.com>
Date: Mon, 9 Mar 2020 17:21:14 +0800
Subject: [PATCH] DRVLIB_SW-3481:GSWAPI:Klockwork fixes in switch_api

Signed-off-by: Dinesh Sudham <dineshx.sudham@intel.com>
---
 drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c    | 15 ++++++---------
 .../net/ethernet/lantiq/switch-api/gsw_ioctl_wrapper.c    |  4 ++--
 drivers/net/ethernet/lantiq/switch-api/gsw_swmcast.c      |  8 +++++---
 3 files changed, 13 insertions(+), 14 deletions(-)

diff --git a/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c b/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c
index 5c7d8473ad09..45f2d6a3d9e2 100644
--- a/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c
+++ b/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c
@@ -1350,9 +1350,8 @@ static int gsw3x_msw_table_rm(void *cdev, GSW_multicastTable_t *parm)
 		return GSW_statusErr;
 	}
 
-	if ((parm->eModeMember != GSW_IGMP_MEMBER_INCLUDE) &&
-	    (parm->eModeMember != GSW_IGMP_MEMBER_EXCLUDE) &&
-	    (parm->eModeMember != GSW_IGMP_MEMBER_DONT_CARE)) {
+	if ((parm->eModeMember < GSW_IGMP_MEMBER_INCLUDE) ||
+	    (parm->eModeMember > GSW_IGMP_MEMBER_DONT_CARE)) {
 		pr_err("%s:%s:%d (!!!)\n", __FILE__, __func__, __LINE__);
 		return GSW_statusErr;
 	}
@@ -1694,9 +1693,8 @@ static int gsw2x_msw_table_rm(void *cdev, GSW_multicastTable_t *parm)
 		return GSW_statusErr;
 	}
 
-	if ((parm->eModeMember != GSW_IGMP_MEMBER_INCLUDE)
-	    && (parm->eModeMember != GSW_IGMP_MEMBER_EXCLUDE)
-	    && (parm->eModeMember != GSW_IGMP_MEMBER_DONT_CARE)) {
+	if ((parm->eModeMember < GSW_IGMP_MEMBER_INCLUDE) ||
+	    (parm->eModeMember > GSW_IGMP_MEMBER_DONT_CARE)) {
 		pr_err("%s:%s:%d (!!!)\n", __FILE__, __func__, __LINE__);
 		return GSW_statusErr;
 	}
@@ -9276,9 +9274,8 @@ GSW_return_t GSW_QoS_ShaperQueueDeassign(void *cdev,
 		gsw_w32(cdev, RS_CTRL_RSEN_OFFSET + (rshid * 0x5),
 			RS_CTRL_RSEN_SHIFT, RS_CTRL_RSEN_SIZE, 0);
 	}
-#endif
-
 	ret = GSW_statusOk;
+#endif
 
 UNLOCK_AND_RETURN:
 
@@ -15027,7 +15024,7 @@ static GSW_return_t GSW_RMON_Meter_Get_Legacy(void *cdev, GSW_RMON_Meter_cnt_t *
 		u8 index, addr;
 		u32 data, data0, data1;
 		u8 i, j, m, rpt, loc, hc, crd[MAX_READ] = {0};
-		u32 rdcount[MAX_READ], br;
+		u32 rdcount[MAX_READ] = {0}, br;
 		u8 meterid = parm->nMeterId;
 
 		if (parm->nMeterId >= gswdev->num_of_meters)
diff --git a/drivers/net/ethernet/lantiq/switch-api/gsw_ioctl_wrapper.c b/drivers/net/ethernet/lantiq/switch-api/gsw_ioctl_wrapper.c
index d3f8215fd0e9..b921227c98a2 100644
--- a/drivers/net/ethernet/lantiq/switch-api/gsw_ioctl_wrapper.c
+++ b/drivers/net/ethernet/lantiq/switch-api/gsw_ioctl_wrapper.c
@@ -305,7 +305,7 @@ int gsw_api_drv_register(u32 major)
 
 	/* Register the device class */
 	gswss_class = class_create(THIS_MODULE, ETHSW_API_DEV_NAME);
-	if (IS_ERR_OR_NULL(gswss_class)) {
+	if (IS_ERR(gswss_class)) {
 		result = -EEXIST;
 		pr_err("SWAPI: failed to create class %d\n", result);
 		goto fail_create_class;
@@ -318,7 +318,7 @@ int gsw_api_drv_register(u32 major)
 	unregister_chrdev_region(MKDEV(major, 0), MINORMASK);
 	return -1;
 fail_register_chrdev_region:
-	return result;
+	return -1;
 }
 
 int gsw_api_drv_unregister(u32 major)
diff --git a/drivers/net/ethernet/lantiq/switch-api/gsw_swmcast.c b/drivers/net/ethernet/lantiq/switch-api/gsw_swmcast.c
index e93da6c65a26..2e881484f7dc 100644
--- a/drivers/net/ethernet/lantiq/switch-api/gsw_swmcast.c
+++ b/drivers/net/ethernet/lantiq/switch-api/gsw_swmcast.c
@@ -383,6 +383,7 @@ int gsw_insert_hashtable_entry(void *cdev, GSW_multicastTable_t *parm)
 	u32 loc = 0, found_loc = 0;
 	u32 hashidx;
 	int i = 0, ret = 0;
+	int new_hash_slot = 0;
 	u32 portId;
 	MCAST_HASHTBL  *table_ptr = NULL, *new_table_ptr = NULL;
 	MCAST_HASHTBL_PTN pattern;
@@ -454,15 +455,16 @@ int gsw_insert_hashtable_entry(void *cdev, GSW_multicastTable_t *parm)
 	   1. New hashidx entry
 	   2. Existing hashidx with a new entry
 	 */
-	loc = (u32)get_hashtable_empty_slot(cdev, phtable);
-	if (loc == TBL_FULL) {
+	new_hash_slot = get_hashtable_empty_slot(cdev, phtable);
+	if (new_hash_slot == TBL_FULL) {
 		pr_err("Hash Table FULL\n");
 		return TBL_FULL;
-	} else if (loc > MCAST_TABLE_SIZE) {
+	} else if (new_hash_slot > MCAST_TABLE_SIZE) {
 		pr_err("Location got is wrong\n");
 		return FAIL;
 	}
 
+	loc = (u32)new_hash_slot;
 	pr_debug("Got new location %d\n", loc);
 
 	new_table_ptr = &phtable[loc];
