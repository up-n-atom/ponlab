From a647507821564227be8e3bce2858c0a828ddebe3 Mon Sep 17 00:00:00 2001
From: kavitha3 <k.subramanian@intel.com>
Date: Thu, 5 Mar 2020 15:58:13 +0800
Subject: [PATCH] DRVLIB_SW-3446:VUNI driver special handling for switchdev

---
 drivers/net/ethernet/lantiq/intel_pon_hgu_vuni.c | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/drivers/net/ethernet/lantiq/intel_pon_hgu_vuni.c b/drivers/net/ethernet/lantiq/intel_pon_hgu_vuni.c
index 2ffb243e1e86..a8c684524560 100644
--- a/drivers/net/ethernet/lantiq/intel_pon_hgu_vuni.c
+++ b/drivers/net/ethernet/lantiq/intel_pon_hgu_vuni.c
@@ -151,7 +151,7 @@ static void vuni_uninit(struct net_device *dev)
 	if (priv->vani == 1) {
 		priv->dp_subif.subif = -1;
 		priv->dp_subif.port_id = priv->dp_port_id;
-		data.flag_ops = DP_SUBIF_VANI;
+		data.flag_ops = DP_SUBIF_VANI | DP_SUBIF_SWDEV;
 		ret = dp_register_subif_ext(0, priv->owner,
 					    dev, dev->name,
 					    &priv->dp_subif,
@@ -236,7 +236,7 @@ static int32_t dp_fp_rx(struct net_device *rxif, struct net_device *txif,
 		priv = netdev_priv(txif);
 		vani_dev = eth_dev[priv->id][0];
 		skb->dev = vani_dev;
-
+		skb->offload_fwd_mark = 0;
 		if (vani_dev) {
 			eth_rx(vani_dev, len, skb);
 		} else {
@@ -448,7 +448,7 @@ static int vuni_dev_dereg_subif(int dev_num, int start, int end)
 			pr_info("owner = %s portid = %d subifid = %d dev= %s\n",
 				priv->owner->name, priv->dp_port_id,
 				priv->dp_subif.subif, dev->name);
-			data.flag_ops = DP_SUBIF_VANI;
+			data.flag_ops = DP_SUBIF_VANI | DP_SUBIF_SWDEV;
 			res = dp_register_subif_ext(0, priv->owner,
 						    dev, dev->name,
 						    &priv->dp_subif,
