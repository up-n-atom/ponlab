From 07d2cd2ec100394a792ea3a6178f76b5eab6c0c4 Mon Sep 17 00:00:00 2001
From: Xu Liang <lxu@maxlinear.com>
Date: Tue, 27 Apr 2021 19:02:26 +0800
Subject: [PATCH] PONRTSYS-8925: ETH Driver - trace to physical interface for
 XPCS entity

---
 drivers/net/ethernet/lantiq/ltq_eth_drv_xrx500.c | 12 ++++++------
 1 file changed, 6 insertions(+), 6 deletions(-)

diff --git a/drivers/net/ethernet/lantiq/ltq_eth_drv_xrx500.c b/drivers/net/ethernet/lantiq/ltq_eth_drv_xrx500.c
index ab6f364b6111..bad6c250dd0d 100644
--- a/drivers/net/ethernet/lantiq/ltq_eth_drv_xrx500.c
+++ b/drivers/net/ethernet/lantiq/ltq_eth_drv_xrx500.c
@@ -595,6 +595,9 @@ static int eth_serdes_power(struct net_device *dev, bool up)
 	if (priv->master)
 		priv = priv->master;
 
+	if (!of_device_is_available(priv->xpcs_node))
+		return 0;
+
 	if ((!up || atomic_inc_return(&priv->powerup) != 1)
 	    && (up || atomic_dec_if_positive(&priv->powerup) != 0))
 		return 0;
@@ -681,10 +684,8 @@ static int ltq_eth_open(struct net_device *dev)
 		return -1;
 	}
 
-	if (of_device_is_available(priv->xpcs_node)) {
-		eth_serdes_power(dev, true);
-		usleep_range(20, 30);
-	}
+	eth_serdes_power(dev, true);
+	usleep_range(20, 30);
 
 	xgmac_rx(priv, true);
 
@@ -701,8 +702,7 @@ static int ltq_eth_stop(struct net_device *dev)
 
 	xgmac_rx(priv, false);
 
-	if (of_device_is_available(priv->xpcs_node))
-		eth_serdes_power(dev, false);
+	eth_serdes_power(dev, false);
 
 	ret = dp_rx_enable(dev, dev->name, DP_RX_DISABLE);
 
