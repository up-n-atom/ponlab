+static int xpcs_power_off(struct device *dev)
+{
+	struct xpcs_prv_data *pdata = dev_get_drvdata(dev);
+	struct phy *phy = pdata->phy;
+
+	dev_dbg(dev, "%s: %s\n", __func__, pdata->name);
+
+	if (!dev || !phy) {
+		dev_err(dev, "XPCS Power Off: Cannot get phy or dev\n");
+		return -EINVAL;
+	}
+
+	if (!pdata->state)
+		return 0;
+
+	pdata->state = 0;
+
+	/* Xpcs reset assert */
+	reset_control_assert(pdata->xpcs_rst);
+
+	/* RCU reset PHY */
+	phy_power_off(phy);
+
+	/* Exit PHY */
+	phy_exit(phy);
+
+	return 0;
+}
+
+static int xpcs_power_on(struct device *dev)
+{
+	struct xpcs_prv_data *pdata = dev_get_drvdata(dev);
+	struct phy *phy = pdata->phy;
+	int ret = 0;
+
+	dev_dbg(dev, "%s: %s\n", __func__, pdata->name);
+
+	if (!dev || !phy) {
+		dev_err(dev, "XPCS Power On: Cannot get phy or dev\n");
+		return -EINVAL;
+	}
+
+	if (pdata->state)
+		return 0;
+
+	/* Init PHY */
+	ret = phy_init(phy);
+
+	if (ret < 0) {
+		dev_dbg(dev, "phy_init err %s.\n", pdata->name);
+		return ret;
+	}
+
+	/* Power ON PHY */
+	phy_power_on(phy);
+
+	/* Xpcs reset deassert */
+	reset_control_deassert(pdata->xpcs_rst);
+
+	/* Power ON XPCS */
+	ret = xpcs_init(pdata);
+
+	if (ret < 0) {
+		dev_dbg(dev, "xpcs_init err %s.\n", pdata->name);
+		return ret;
+	}
+
+	pdata->state = 1;
+
+	ret = phy_calibrate(phy);
+
+	return ret;
+}
+
+static int xpcs_reinit(struct device *dev, u32 mode)
+{
+	struct xpcs_prv_data *pdata = dev_get_drvdata(dev);
+	int ret;
+
+	if (!dev) {
+		dev_err(dev, "XPCS Reinit: Cannot get phy or dev\n");
+		return -EINVAL;
+	}
+
+	ret = xpcs_power_off(dev);
+	if (ret)
+		return ret;
+
+	/* Change mode to new mode */
+	pdata->mode = mode;
+
+	ret = xpcs_power_on(dev);
+
+	return ret;
+}
