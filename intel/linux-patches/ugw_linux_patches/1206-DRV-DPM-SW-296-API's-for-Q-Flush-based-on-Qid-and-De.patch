From 38373ead3db49a732a33b44ecec336c8b0c1e6e7 Mon Sep 17 00:00:00 2001
From: thampan <joby.thampan@intel.com>
Date: Sat, 6 Jun 2020 18:43:16 +0800
Subject: [PATCH] DRV_DPM_SW-296: API's for Q Flush based on Qid and Deq Port

---
 drivers/net/datapath/dpm/datapath.h                |  2 +
 drivers/net/datapath/dpm/datapath_qos.c            | 69 ++++++++++++++--
 drivers/net/datapath/dpm/gswip31/datapath_misc.h   |  4 +
 .../net/datapath/dpm/gswip31/datapath_ppv4_api.c   | 92 ++++++++++++++++++++++
 include/net/datapath_api_qos.h                     | 39 +++++++++
 5 files changed, 201 insertions(+), 5 deletions(-)

diff --git a/drivers/net/datapath/dpm/datapath.h b/drivers/net/datapath/dpm/datapath.h
index dd18482bcb42..e636d87bb1e0 100644
--- a/drivers/net/datapath/dpm/datapath.h
+++ b/drivers/net/datapath/dpm/datapath.h
@@ -354,6 +354,8 @@ enum QOS_FLAG {
 	QOS_Q_LOGIC,       /* get logical queue ID based on physical queue ID */
 	QOS_GLOBAL_CFG_GET, /* get global qos config info */
 	QOS_PORT_CFG_SET, /* set qos port config info */
+	QOS_BLOCK_FLUSH_PORT, /* Block and Flush all QiD's in the port */
+	QOS_BLOCK_FLUSH_QUEUE, /* Block and Flush particular QiD */
 };
 
 /* Tx counters serviced by CTP bypass registers */
diff --git a/drivers/net/datapath/dpm/datapath_qos.c b/drivers/net/datapath/dpm/datapath_qos.c
index ca8ac2f6ac32..83a08ec31789 100644
--- a/drivers/net/datapath/dpm/datapath_qos.c
+++ b/drivers/net/datapath/dpm/datapath_qos.c
@@ -330,7 +330,6 @@ EXPORT_SYMBOL(dp_node_children_free);
 int dp_deq_port_res_get(struct dp_dequeue_res *res, int flag)
 {
 	dp_subif_t *subif;
-	struct pmac_port_info *port_info;
 	struct inst_info *dp_info;
 
 	if (unlikely(!dp_init_ok)) {
@@ -345,21 +344,22 @@ int dp_deq_port_res_get(struct dp_dequeue_res *res, int flag)
 
 	if (!dp_info || !dp_info->dp_qos_platform_set)
 		return DP_FAILURE;
+
+	/* if res->dev is NULL, res->dp_port should be valid */
 	if (res->dev) { /*fill dp_port if dev is provided */
-		subif = devm_kzalloc(&g_dp_dev->dev, sizeof(*subif),
-				     GFP_ATOMIC);
+		subif = kzalloc(sizeof(*subif), GFP_ATOMIC);
 		if (!subif)
 			return DP_FAILURE;
 		dp_get_netif_subifid(res->dev, NULL, NULL, NULL, subif, 0);
 		if (!subif->subif_num) {
 			pr_err("Not found dev %s\n", res->dev->name);
+			kfree(subif);
 			return DP_FAILURE;
 		}
 		res->dp_port = subif->port_id;
-		devm_kfree(&g_dp_dev->dev, subif);
+		kfree(subif);
 		subif = NULL;
 	}
-	port_info = get_dp_port_info(res->inst, res->dp_port);
 	DP_DEBUG(DP_DBG_FLAG_QOS_DETAIL, "%s: dp_port=%d tconf_idx=%d\n",
 		 __func__, res->dp_port, res->cqm_deq_idx);
 	return dp_info->dp_qos_platform_set(DEQ_PORT_RES_GET, res, flag);
@@ -544,6 +544,65 @@ int dp_qos_port_conf_set(struct dp_port_cfg_info *info, int flag)
 
 	if (!dp_info || !dp_info->dp_qos_platform_set)
 		return DP_FAILURE;
+
 	return dp_info->dp_qos_platform_set(QOS_PORT_CFG_SET, info, flag);
 }
 EXPORT_SYMBOL(dp_qos_port_conf_set);
+
+int dp_block_flush_port(struct dp_qos_blk_flush_port *cfg, int flag)
+{
+	struct inst_info *dp_info;
+	int ret = DP_FAILURE;
+
+	if (unlikely(!dp_init_ok)) {
+		pr_err("%s failed: datapath not initialized yet\n", __func__);
+		return DP_FAILURE;
+	}
+
+	if (!cfg || is_invalid_inst(cfg->inst))
+		return DP_FAILURE;
+
+	dp_info = get_dp_prop_info(cfg->inst);
+
+	if (!dp_info || !dp_info->dp_qos_platform_set)
+		return DP_FAILURE;
+
+	if (cfg->dp_port >= dp_info->cap.max_num_dp_ports) {
+		pr_err("%s dp_port %d should be valid\n",
+		       __func__, cfg->dp_port);
+		return DP_FAILURE;
+	}
+
+	DP_LIB_LOCK(&dp_lock);
+	ret = dp_info->dp_qos_platform_set(QOS_BLOCK_FLUSH_PORT, cfg, flag);
+	DP_LIB_UNLOCK(&dp_lock);
+
+	return ret;
+}
+EXPORT_SYMBOL(dp_block_flush_port);
+
+int dp_block_flush_queue(struct dp_qos_blk_flush_queue *cfg, int flag)
+{
+	struct inst_info *dp_info;
+	int ret = DP_FAILURE;
+
+	if (unlikely(!dp_init_ok)) {
+		pr_err("%s failed: datapath not initialized yet\n", __func__);
+		return DP_FAILURE;
+	}
+
+	if (!cfg || is_invalid_inst(cfg->inst))
+		return DP_FAILURE;
+
+	dp_info = get_dp_prop_info(cfg->inst);
+
+	if (!dp_info || !dp_info->dp_qos_platform_set)
+		return DP_FAILURE;
+
+	DP_LIB_LOCK(&dp_lock);
+	ret = dp_info->dp_qos_platform_set(QOS_BLOCK_FLUSH_QUEUE, cfg, flag);
+	DP_LIB_UNLOCK(&dp_lock);
+
+	return ret;
+}
+EXPORT_SYMBOL(dp_block_flush_queue);
diff --git a/drivers/net/datapath/dpm/gswip31/datapath_misc.h b/drivers/net/datapath/dpm/gswip31/datapath_misc.h
index 9b928cf4e0c6..7284403527c6 100644
--- a/drivers/net/datapath/dpm/gswip31/datapath_misc.h
+++ b/drivers/net/datapath/dpm/gswip31/datapath_misc.h
@@ -305,5 +305,9 @@ int tc_vlan_set_31(struct core_ops *ops, struct dp_tc_vlan *vlan,
 		   int flag);
 int dp_get_reinsert_cnt_31(int inst, int dp_port, int vap, int flag,
 			   struct dp_reinsert_count *dp_reins_count);
+int dp_queue_block_flush_31(struct dp_qos_blk_flush_queue *cfg,
+			    int flag);
+int dp_port_block_flush_31(struct dp_qos_blk_flush_port *cfg,
+			   int flag);
 
 #endif /* DATAPATH_MISC31_H */
diff --git a/drivers/net/datapath/dpm/gswip31/datapath_ppv4_api.c b/drivers/net/datapath/dpm/gswip31/datapath_ppv4_api.c
index 10f570f8d2e4..7e870b982f0e 100644
--- a/drivers/net/datapath/dpm/gswip31/datapath_ppv4_api.c
+++ b/drivers/net/datapath/dpm/gswip31/datapath_ppv4_api.c
@@ -143,6 +143,14 @@ int qos_platform_set(int cmd_id, void *node, int flag)
 		res = dp_qos_port_conf_set_31((struct dp_port_cfg_info *)node,
 					      flag);
 		break;
+	case QOS_BLOCK_FLUSH_PORT:
+		res = dp_port_block_flush_31((struct dp_qos_blk_flush_port *)node,
+					     flag);
+		break;
+	case QOS_BLOCK_FLUSH_QUEUE:
+		res = dp_queue_block_flush_31((struct dp_qos_blk_flush_queue *)node,
+					      flag);
+		break;
 	default:
 		pr_err("no support yet cmd_id %d\n", cmd_id);
 		break;
@@ -4323,3 +4331,87 @@ int dp_qos_port_conf_set_31(struct dp_port_cfg_info *info, int flag)
 	}
 	return DP_SUCCESS;
 }
+
+int dp_queue_block_flush_31(struct dp_qos_blk_flush_queue *cfg,
+			    int flag)
+{
+	struct hal_priv *priv;
+	struct pp_queue_stat *qos_queue_stat;
+	int node_id;
+
+	priv = HAL(cfg->inst);
+	if (!priv || !priv->qdev) {
+		pr_err("%s failed: qdev NULL with inst=%d\n", __func__,
+		       cfg->inst);
+		return DP_FAILURE;
+	}
+
+	if (!is_qid_valid(cfg->q_id) || is_q_node_free(priv, cfg->q_id))
+		return DP_FAILURE;
+
+	qos_queue_stat = &priv->qos_queue_stat[cfg->q_id];
+	node_id = qos_queue_stat->node_id;
+
+	/* Flush the Queue and Restore Q back to original Deq Port */
+	if (queue_flush_31(cfg->inst, node_id, flag | FLUSH_RESTORE_QOS_PORT)) {
+		pr_err("%s queue_flush for Phy Queue[%d] failed\n",
+		       __func__, cfg->q_id);
+		return DP_FAILURE;
+	}
+
+	/* Unblock the Q, Since Q is mapped to Drop port */
+	if (pp_qos_queue_unblock(priv->qdev, node_id)) {
+		pr_err("%s pp_qos_queue_unblock fail for Phy Queue[%d]\n",
+		       __func__, cfg->q_id);
+		return DP_FAILURE;
+	}
+	qos_queue_stat->blocked = 0;
+
+	return DP_SUCCESS;
+}
+
+int dp_port_block_flush_31(struct dp_qos_blk_flush_port *cfg,
+			   int flag)
+{
+	struct hal_priv *priv;
+	struct dp_dequeue_res deq = {0};
+	struct dp_queue_res *q_res;
+	int i = 0;
+	struct dp_qos_blk_flush_queue q_cfg;
+
+	if (is_deqport_valid(cfg->deq_port))
+		return DP_FAILURE;
+
+	priv = HAL(cfg->inst);
+	if (!priv || !priv->qdev) {
+		pr_err("%s failed: qdev NULL with inst=%d\n", __func__,
+		       cfg->inst);
+		return DP_FAILURE;
+	}
+
+	q_res = kzalloc((sizeof(*q_res) * MAX_Q_PER_PORT), GFP_ATOMIC);
+	if (!q_res)
+		return DP_FAILURE;
+
+	deq.dp_port = cfg->dp_port;
+	deq.cqm_deq_idx = cfg->deq_port;
+	deq.q_res = q_res;
+	deq.q_res_size = MAX_Q_PER_PORT;
+
+	if (dp_deq_port_res_get_31(&deq, flag)) {
+		pr_err("%s dp_deq_port_res_get failed\n", __func__);
+		kfree(q_res);
+		return DP_FAILURE;
+	}
+
+	q_cfg.inst = cfg->inst;
+
+	/* Even if fail, continue to block and flush other queues */
+	for (i = 0; i < deq.num_q; i++) {
+		q_cfg.q_id = deq.q_res[i].q_id;
+		dp_queue_block_flush_31(&q_cfg, flag);
+	}
+
+	kfree(q_res);
+	return DP_SUCCESS;
+}
diff --git a/include/net/datapath_api_qos.h b/include/net/datapath_api_qos.h
index f8c7d4d42897..f7595989228c 100644
--- a/include/net/datapath_api_qos.h
+++ b/include/net/datapath_api_qos.h
@@ -1320,6 +1320,45 @@ struct dp_qos_q_logic {
  */
 int dp_qos_get_q_logic(struct dp_qos_q_logic *cfg, int flag);
 
+/*!
+ * @struct dp_qos_blk_flush_port
+ *
+ * Structure to flush Q based on Deq Port
+ *
+ */
+struct dp_qos_blk_flush_port {
+	int inst;	/*!< [in] DP instance */
+	u32 dp_port;	/*!< [in] Logical port id */
+	int deq_port;	/*!< [in] Flushes Q based  on deq port specified */
+};
+
+/*!< dp_block_flush_port: Flush all the Q's associated with the deq port
+ *   @param [in/out] cfg
+ *   @param [in] flag: reserved only
+ *   @return failure DP_FAILURE
+ *           succeed DP_SUCCESS
+ */
+int dp_block_flush_port(struct dp_qos_blk_flush_port *cfg, int flag);
+
+/*!
+ * @struct dp_qos_q_logic
+ *
+ * Structure to flush Q based on specified physical qid
+ *
+ */
+struct dp_qos_blk_flush_queue {
+	int inst;  /*!< [in] DP instance */
+	int q_id;  /*!< [in] physical queue id */
+};
+
+/*!< dp_block_flush_queue: Flush the packets specified in QiD 
+ *   @param [in/out] cfg
+ *   @param [in] flag: reserved only
+ *   @return failure DP_FAILURE
+ *           succeed DP_SUCCESS
+ */
+int dp_block_flush_queue(struct dp_qos_blk_flush_queue *cfg, int flag);
+
 #ifdef ENABLE_QOS_EXAMPLE
 /*! \ingroup APIs_dp_qos_example
  * @brief example1: use basic node_link API to create complex QOS structure
