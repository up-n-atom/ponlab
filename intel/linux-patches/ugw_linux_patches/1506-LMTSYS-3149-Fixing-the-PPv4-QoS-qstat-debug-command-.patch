From ce64d517acb62a8974841a0241a35ccfb92a0e61 Mon Sep 17 00:00:00 2001
From: Elad Fernandes <elad.fernandes@intel.com>
Date: Wed, 4 Nov 2020 18:29:33 +0200
Subject: [PATCH] LMTSYS-3149: Fixing the PPv4 QoS qstat debug command buffer
 copy size

---
 drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_fw.c    | 4 +---
 drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.c | 6 ++----
 drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.h | 4 ++--
 3 files changed, 5 insertions(+), 9 deletions(-)

diff --git a/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_fw.c b/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_fw.c
index 1f1f8f068b80..2e9d8c9d1b59 100644
--- a/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_fw.c
+++ b/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_fw.c
@@ -2935,7 +2935,6 @@ static s32 post_process_external(struct pp_qos_dev *qdev,
 	u32 stats_poll = 0;
 	u32 fw_signal = FW_OK_CODE;
 	volatile u32 *fw_signal_addr;
-	void *qinfo_entry;
 	void *response = NULL;
 	s32 ret = 0;
 
@@ -2976,7 +2975,6 @@ static s32 post_process_external(struct pp_qos_dev *qdev,
 		qminfo = (struct qm_info *)response;
 		qminfo_ptr = ((struct qm_info *)qdev->hwconf.fw_stats_ddr_virt);
 		qminfo->num_queues = qminfo_ptr->num_queues;
-		qinfo_entry = qdev->hwconf.fw_stats_ddr_virt + 4;
 
 		if (qminfo->num_queues > NUM_Q_ON_QUERY) {
 			QOS_LOG_ERR("QM stats: Num queues %d exceeds max %u\n",
@@ -2986,7 +2984,7 @@ static s32 post_process_external(struct pp_qos_dev *qdev,
 		}
 
 		memcpy((void *)qminfo->qstat, (void *)qminfo_ptr->qstat,
-		       sizeof(qstat[0]) * qminfo->num_queues);
+		       sizeof(qminfo->qstat[0]) * qminfo->num_queues);
 		break;
 
 	case CMD_TYPE_GET_CODEL_STATS:
diff --git a/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.c b/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.c
index bb8b34d5d662..e723dffd4040 100644
--- a/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.c
+++ b/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.c
@@ -4365,10 +4365,8 @@ s32 qos_dbg_qm_stat_show(struct pp_qos_dev *qdev, struct seq_file *s)
 
 	QOS_LOCK(qdev);
 	for (rlm_idx = 0; rlm_idx < num_rlms; rlm_idx += NUM_Q_ON_QUERY) {
-		create_get_qm_stats_cmd(qdev,
-					rlm_idx,
-					qdev->hwconf.fw_stats_ddr_phys,
-					qminfo);
+		create_get_qm_stats_cmd(qdev, rlm_idx,
+					qdev->hwconf.fw_stats_ddr_phys, qminfo);
 
 		update_cmd_id(&qdev->drvcmds);
 		ret = transmit_cmds(qdev);
diff --git a/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.h b/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.h
index 76288926e2b0..f406f0252736 100644
--- a/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.h
+++ b/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.h
@@ -254,8 +254,8 @@ struct pp_pool {
 };
 
 /* Additional 4 bytes for the validation signature */
-#define PPV4_QOS_STAT_SIZE                                    \
-	(max(sizeof(struct queue_stat_info) * NUM_Q_ON_QUERY, \
+#define PPV4_QOS_STAT_SIZE           \
+	(max(sizeof(struct qm_info), \
 	sizeof(struct system_stats_s)) + 4)
 
 /**
