From e9e327c0432d15fda7e5a8ca2436a2682acb5b51 Mon Sep 17 00:00:00 2001
From: ofirbitt <ofir1.bitton@intel.com>
Date: Wed, 1 Apr 2020 13:39:38 +0300
Subject: [PATCH] PONRTSYS-7747: PPv4 Parser adjust correct error flags

---
 drivers/net/ppv4/pp-hal/parser/parser_debugfs.c | 20 ++++++++++----------
 1 file changed, 10 insertions(+), 10 deletions(-)

diff --git a/drivers/net/ppv4/pp-hal/parser/parser_debugfs.c b/drivers/net/ppv4/pp-hal/parser/parser_debugfs.c
index 20e508ab15aa..452abb125e33 100644
--- a/drivers/net/ppv4/pp-hal/parser/parser_debugfs.c
+++ b/drivers/net/ppv4/pp-hal/parser/parser_debugfs.c
@@ -95,8 +95,8 @@ const char * const err_flag_str[PRSR_NUM_ERR_FLAGS] = {
 	"Abort on Payload Timeout",
 	"Abort on L3 Processing Timeout",
 	"Abort on IP Len Error",
-	"Abort on Header Len Overflow",
-	"Abort on Max Header Len Exceeded",
+	"Abort on IMEM protocol Overflow",
+	"Abort on L3 hdr len longer than cfg",
 	"Abort on Unknown Last Ethertype",
 	NULL,
 	NULL,
@@ -104,9 +104,9 @@ const char * const err_flag_str[PRSR_NUM_ERR_FLAGS] = {
 	"Error on Payload Timeout",
 	"Error on L3 Processing Timeout",
 	"Error on IP Len Error",
-	"Error on Header Len Overflow",
-	"Error on Max Header Len Exceeded",
-	"Error on IMEM Header Len",
+	"Error on IMEM protocol Overflow",
+	"Error on L3 hdr len longer than cfg",
+	"Error on L3 hdr len exceeds min-max",
 	"Error on Unknown Last Ethertype",
 	"Error on RPB Zero Len",
 	"Error on RPB Error",
@@ -114,9 +114,9 @@ const char * const err_flag_str[PRSR_NUM_ERR_FLAGS] = {
 	"Drop on Payload Timeout",
 	"Drop on L3 Processing Timeout",
 	"Drop on IP Len Error",
-	"Drop on Header Len Overflow",
-	"Drop on Max Header Len Exceeded",
-	"Drop on IMEM Header Len Error",
+	"Drop on IMEM protocol Overflow",
+	"Drop on L3 hdr len longer than cfg",
+	"Drop on L3 hdr len exceeds min-max",
 	"Drop on Unknown Last Ethertype",
 	"Drop on RPB Zero Len",
 	"Drop on RPB Error",
@@ -215,10 +215,10 @@ void __prsr_stats_show(struct seq_file *f)
 	seq_printf(f, " | %-25s | %10u |\n", "No Last ETH Type",
 		   st.last_eth_err);
 	seq_puts(f,   " +---------------------------+------------+\n");
-	seq_printf(f, " | %-25s | %10u |\n", "Protocol length Error",
+	seq_printf(f, " | %-25s | %10u |\n", "L3 Hdr Exceeds Min-Max",
 		   st.proto_len_err);
 	seq_puts(f,   " +---------------------------+------------+\n");
-	seq_printf(f, " | %-25s | %10u |\n", "Header Length Error",
+	seq_printf(f, " | %-25s | %10u |\n", "L3 Hdr Longer Than Cfg",
 		   st.hdr_len_err);
 	seq_puts(f,   " +---------------------------+------------+\n");
 	seq_printf(f, " | %-25s | %10u |\n", "Protocol Overflow",
