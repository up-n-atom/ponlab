From 477af6581878c4049ef7d9837600cedbf754e87b Mon Sep 17 00:00:00 2001
From: Rekha Eswaran <rekha.eswaran@intel.com>
Date: Mon, 23 Sep 2019 17:47:57 +0800
Subject: [PATCH] DRV_DPM_SW-43 - avoid flooding of packets in upstream,
 downstream with BC, MC gem (PONRTSYS-5038)

---
 drivers/net/datapath/dpm/datapath.h                |  4 ++
 drivers/net/datapath/dpm/datapath_swdev.c          | 25 +++++----
 drivers/net/datapath/dpm/datapath_swdev.h          | 15 +++---
 drivers/net/datapath/dpm/gswip31/datapath_misc.c   |  3 ++
 .../net/datapath/dpm/gswip31/datapath_switchdev.c  | 60 ++++++++++++++--------
 include/net/datapath_api.h                         | 13 +++--
 6 files changed, 81 insertions(+), 39 deletions(-)

diff --git a/drivers/net/datapath/dpm/datapath.h b/drivers/net/datapath/dpm/datapath.h
index 64b46428901c..c2187fc5f404 100644
--- a/drivers/net/datapath/dpm/datapath.h
+++ b/drivers/net/datapath/dpm/datapath.h
@@ -512,6 +512,10 @@ struct pmac_port_info {
 #if IS_ENABLED(CONFIG_INTEL_DATAPATH_SWITCHDEV)
 	u32 swdev_en; /* switchdev enable/disable flag for port */
 #endif
+	u16 loop_dis; /*!< If set do not add this dp port's bp
+		       * into other bp's member port map
+		       * if source = dest dp port
+		       */
 	/*only valid for 1st dp instanace which need dp_xmit/dp_rx*/
 	/*[0] for non-checksum case,
 	 *[1] for checksum offload
diff --git a/drivers/net/datapath/dpm/datapath_swdev.c b/drivers/net/datapath/dpm/datapath_swdev.c
index 0f74fe44d184..dcd8f829f754 100644
--- a/drivers/net/datapath/dpm/datapath_swdev.c
+++ b/drivers/net/datapath/dpm/datapath_swdev.c
@@ -231,9 +231,13 @@ static int dp_swdev_add_bport_to_list(struct br_info *br_item,
 		}
 		bport_list->dev_reg_flag = br_item->flag;
 		bport_list->portid = bport;
-		bport_list->alloc_flag = br_item->alloc_flag;
-		DP_DEBUG(DP_DBG_FLAG_SWDEV, "bport:%d reg_flag:%d\n",
-			 bport_list->portid, bport_list->dev_reg_flag);
+		bport_list->no_loop_flag = br_item->no_loop_flag;
+		bport_list->dev_priv_flag = br_item->bp_priv_flag;
+		bport_list->dp_port = br_item->dp_port;
+		DP_DEBUG(DP_DBG_FLAG_SWDEV,
+			 "bport:%d reg_flag:%d priv_flag:0x%x\n",
+			 bport_list->portid, bport_list->dev_reg_flag,
+			 bport_list->dev_priv_flag);
 		list_add(&bport_list->list, &br_item->bp_list);
 	}
 	return 0;
@@ -380,8 +384,9 @@ static int dp_swdev_cfg_gswip(struct bridge_id_entry_item *br_item,
 
 			br_info->fid = br_item->fid;
 			br_info->inst = br_item->inst;
-			br_info->cpu_port = ENABLE;
-			br_info->alloc_flag = br_item->alloc_flag;
+			br_info->no_loop_flag = br_item->no_loop_flag;
+			br_info->bp_priv_flag = br_item->priv_flag;
+			br_info->dp_port = br_item->dp_port;
 
 			/* Logic dev flag added to verify if SWDEV registered
 			 * the logical i.e. VLAN device.Helpful during
@@ -396,7 +401,6 @@ static int dp_swdev_cfg_gswip(struct bridge_id_entry_item *br_item,
 			dp_swdev_insert_bridge_id_entry(br_info);
 			dp_swdev_add_bport_to_list(br_info, br_item->portid);
 
-
 			i_info->swdev_bridge_port_cfg_set(br_info,
 							  br_item->inst,
 							  br_item->portid,
@@ -413,8 +417,9 @@ static int dp_swdev_cfg_gswip(struct bridge_id_entry_item *br_item,
 		if (!br_info)
 			return 0;
 		br_info->flag = 0;
-
-		br_info->alloc_flag = br_item->alloc_flag;
+		br_info->no_loop_flag = br_item->no_loop_flag;
+		br_info->bp_priv_flag = br_item->priv_flag;
+		br_info->dp_port = br_item->dp_port;
 
 		if (br_item->flags & LOGIC_DEV_REGISTER)
 			br_info->flag = LOGIC_DEV_REGISTER;
@@ -505,12 +510,13 @@ static int dp_swdev_add_if(struct net_device *dev,
 		/* Alloc Flag is needed by HAL layer to see the interface is
 		 * LAN or GPON or EPON
 		 */
-		br_item->alloc_flag = subif.alloc_flag;
+		br_item->priv_flag = dev->priv_flags;
 
 		swdev_lock();
 		br_info = dp_swdev_bridge_entry_lookup(br_dev->name);
 		p_info = get_dp_port_info(br_item->inst, br_item->dp_port);
 		i_info = &dp_port_prop[br_item->inst].info;
+		br_item->no_loop_flag = p_info->loop_dis;
 		if (br_info) {
 			strcpy(br_item->br_device_name,
 			       br_info->br_device_name);
@@ -1028,7 +1034,6 @@ int dp_notif_br_alloc(struct net_device *br_dev)
 			}
 			br_info->fid = br_id;
 			br_info->inst = 0;
-			br_info->cpu_port = ENABLE;
 			br_info->flag = 0;
 			strcpy(br_info->br_device_name, br_dev->name);
 			INIT_LIST_HEAD(&br_info->bp_list);
diff --git a/drivers/net/datapath/dpm/datapath_swdev.h b/drivers/net/datapath/dpm/datapath_swdev.h
index 7e9867393dbf..526ae5980b46 100644
--- a/drivers/net/datapath/dpm/datapath_swdev.h
+++ b/drivers/net/datapath/dpm/datapath_swdev.h
@@ -2,7 +2,6 @@
 #define DATAPATH_SWDEV_H
 
 #include <linux/if.h>
-//TODO added below header for local compilation
 #include <linux/etherdevice.h>
 #include <net/switchdev.h>
 #include <net/switch_api/lantiq_gsw_api.h> /*Switch related structures */
@@ -30,27 +29,31 @@ struct bridge_id_entry_item {
 	u32 portid; /*Bridge port*/
 	u32 dp_port; /*DP port*/
 	u32 inst;
-	int alloc_flag; /* Same as alloc flag passed from dp_alloc_port */
+	u32 priv_flag;
+	u32 no_loop_flag; /* same as loop_dis flag during dp_alloc_port*/
 	struct switchdev_trans_item tritem;
 };
 
 struct br_info {
 	struct hlist_node br_hlist;
 	u8 br_device_name[IFNAMSIZ];
-	u8  cpu_port; /*To set CPU port as member or not*/
 	u16 fid;
 	u32 flag;
 	u32 inst;
-	int alloc_flag; /* Same as alloc flag passed from dp_alloc_port */
+	u32 bp_priv_flag; /* to store bp dev priv flags (like IFF_NO_QUEUE) */
+	u32 no_loop_flag; /* same as loop_dis flag during dp_alloc_port*/
+	u32 dp_port;
 	struct list_head bp_list;
 };
 
 struct bridge_member_port {
 	struct list_head list;
-	u32 portid;
+	u32 portid; /* bridge port */
 	u32 dev_reg_flag;
 	u16 bport[8];
-	int alloc_flag; /* Same as alloc flag passed from dp_alloc_port */
+	u32 dev_priv_flag; /* to store bp dev priv flags (like IFF_NO_QUEUE) */
+	u32 dp_port;
+	u32 no_loop_flag; /* same as loop_dis flag during dp_alloc_port*/
 };
 
 struct fdb_tbl {
diff --git a/drivers/net/datapath/dpm/gswip31/datapath_misc.c b/drivers/net/datapath/dpm/gswip31/datapath_misc.c
index 5c31c7d7b9d6..b23c40512307 100644
--- a/drivers/net/datapath/dpm/gswip31/datapath_misc.c
+++ b/drivers/net/datapath/dpm/gswip31/datapath_misc.c
@@ -1365,6 +1365,9 @@ static int port_platform_set(int inst, u8 ep, struct dp_port_data *data,
 		 priv ? priv->qdev : NULL);
 	idx = port_info->deq_port_base;
 
+	/* Later enhance below with  DP_F_DATA_NO_LOOP flag */
+	if (flags & (DP_F_GPON | DP_F_EPON))
+		port_info->loop_dis = 1;
 	dma_chan =  port_info->dma_chan;
 	dma_ch_base = port_info->dma_ch_base;
 	for (i = 0; i < port_info->deq_port_num; i++) {
diff --git a/drivers/net/datapath/dpm/gswip31/datapath_switchdev.c b/drivers/net/datapath/dpm/gswip31/datapath_switchdev.c
index 3b4a47b8a051..bde4560fcfa9 100644
--- a/drivers/net/datapath/dpm/gswip31/datapath_switchdev.c
+++ b/drivers/net/datapath/dpm/gswip31/datapath_switchdev.c
@@ -32,6 +32,20 @@ int dp_swdev_alloc_bridge_id(int inst)
 	return br.nBridgeId;
 }
 
+int dp_swdev_get_bport_dp_port(struct br_info *br_item,	int bport,
+			       u32 *priv_flag)
+{
+	struct bridge_member_port *bport_list = NULL;
+
+	list_for_each_entry(bport_list, &br_item->bp_list, list) {
+		if (bport_list->portid == bport) {
+			*priv_flag = bport_list->dev_priv_flag;
+			return bport_list->dp_port;
+		}
+	}
+	return 0;
+}
+
 int dp_swdev_bridge_port_cfg_set(struct br_info *br_item,
 				 int inst, int bport, u32 flags)
 {
@@ -40,6 +54,7 @@ int dp_swdev_bridge_port_cfg_set(struct br_info *br_item,
 	GSW_BRIDGE_portConfig_t brportcfg;
 	struct core_ops *gsw_handle;
 	struct brdgport_ops *gsw_bp;
+	u32 dport, priv_flag = 0;
 
 	gsw_handle = dp_port_prop[inst].ops[0];
 	gsw_bp = &gsw_handle->gsw_brdgport_ops;
@@ -54,19 +69,19 @@ int dp_swdev_bridge_port_cfg_set(struct br_info *br_item,
 		pr_err("fail in getting bridge port config\r\n");
 		return -1;
 	}
+	dport = dp_swdev_get_bport_dp_port(br_item, bport,
+					   &priv_flag);
 	list_for_each_entry(bport_list, &br_item->bp_list, list) {
 		if (bport_list->portid != bport) {
-
-			/* ----- Downstream ------
-			 * WAN Brodcast or Mcast Gem port, if the member
-			 * going to add is a GPON or EPON subif
-			 * (It can be pmapper or gemport or llid), then don't
-			 * add the member to the portmap
+			/* if member to be added for current bp,
+			 * share same dp_port with no loop set or
+			 * with IFF_NO_QUEUE set
+			 * adding brige port,
+			 * then don't add the member to its portmap
 			 */
-			if ((flags & IFF_NO_QUEUE) &&
-			    (bport_list->alloc_flag &
-			     (DP_F_GPON | DP_F_EPON))) {
-
+			if ((bport_list->dev_priv_flag & IFF_NO_QUEUE) ||
+			    ((bport_list->no_loop_flag) &&
+			    (bport_list->dp_port == dport))) {
 				DP_DEBUG(DP_DBG_FLAG_SWDEV,
 					 "IFF_NO_QUEUE Don't add if to pmap\n");
 				UNSET_BP_MAP(brportcfg.nBridgePortMap,
@@ -90,15 +105,6 @@ int dp_swdev_bridge_port_cfg_set(struct br_info *br_item,
 	list_for_each_entry(bport_list, &br_item->bp_list, list) {
 		if (bport_list->portid == bport)
 			continue;
-		/* ----- Upstream ------
-		 * If netdevice have Flag IFF_NO_QUEUE,
-		 * dont add the interface to gswip bridge portmap
-		 */
-		if (flags & IFF_NO_QUEUE) {
-			DP_DEBUG(DP_DBG_FLAG_SWDEV,
-				 "IFF_NO_QUEUE Don't add if to pmap\n");
-			continue;
-		}
 		memset(&brportcfg, 0, sizeof(GSW_BRIDGE_portConfig_t));
 		brportcfg.nBridgePortId = bport_list->portid;
 		DP_DEBUG(DP_DBG_FLAG_SWDEV, "Set other BP=%d inst:%d\n",
@@ -109,7 +115,21 @@ int dp_swdev_bridge_port_cfg_set(struct br_info *br_item,
 			pr_err("fail in getting br port config\r\n");
 			return -1;
 		}
-		SET_BP_MAP(brportcfg.nBridgePortMap, bport);
+		/* If netdevice have Flag IFF_NO_QUEUE or
+		 * share same dp_port,
+		 * with no_loop set between bridge port's
+		 * then dont add the interface to gswip bridge portmap
+		 */
+		if ((priv_flag & IFF_NO_QUEUE) ||
+		    ((bport_list->no_loop_flag) &&
+		    (bport_list->dp_port == dport))) {
+			DP_DEBUG(DP_DBG_FLAG_SWDEV,
+				 "IFF_NO_QUEUE/no_loop Don't add if to pmap\n");
+			UNSET_BP_MAP(brportcfg.nBridgePortMap,
+				     bport);
+		} else {
+			SET_BP_MAP(brportcfg.nBridgePortMap, bport);
+		}
 		brportcfg.nBridgeId = br_item->fid;
 		brportcfg.nBridgePortId = bport_list->portid;
 		brportcfg.eMask = GSW_BRIDGE_PORT_CONFIG_MASK_BRIDGE_ID |
diff --git a/include/net/datapath_api.h b/include/net/datapath_api.h
index 9c38128b4f86..93f6fed5bb67 100644
--- a/include/net/datapath_api.h
+++ b/include/net/datapath_api.h
@@ -897,9 +897,16 @@ enum dp_port_data_flag {
 					*   packet from PP QOS port via credit
 					*   left and credit add
 					*/
-	DP_F_DATA_CONTINUOUS_Q_RESV = BIT(7) /*!< reserve continuous physical
-					      *   queue ID
-					      */
+	DP_F_DATA_CONTINUOUS_Q_RESV = BIT(7), /*!< reserve continuous physical
+					       *   queue ID
+					       */
+	DP_F_DATA_NO_LOOP = BIT(8)	/*!< Once this flag is set,Bridge
+					 * forwarding among subif which belongs
+					 * to same DP port/llid is disabled.
+					 * It can be used for PON application,
+					 * but may not for others like WIFI
+					 * bridging between diff subif/vap
+					 */
 };
 
 /*! @brief typedef struct dp_port_data */
