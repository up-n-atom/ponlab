From 0708a11f54fa2e20b214ec5347d89a3a63a8a9c7 Mon Sep 17 00:00:00 2001
From: Oren Bakshe <oren.bakshe@intel.com>
Date: Thu, 13 Aug 2020 14:10:26 +0300
Subject: [PATCH] PONRTSYS-7979: Traffic Stop when running 64k UDP sessions

---
 drivers/net/ppv4/pp-hal/parser/parser.c           | 4 ++++
 drivers/net/ppv4/pp-hal/parser/parser_protocols.c | 6 ------
 2 files changed, 4 insertions(+), 6 deletions(-)

diff --git a/drivers/net/ppv4/pp-hal/parser/parser.c b/drivers/net/ppv4/pp-hal/parser/parser.c
index 2bf8ff9ce485..a0780385045b 100644
--- a/drivers/net/ppv4/pp-hal/parser/parser.c
+++ b/drivers/net/ppv4/pp-hal/parser/parser.c
@@ -21,6 +21,7 @@
 #include "pp_fv.h"
 #include "parser.h"
 #include "parser_internal.h"
+#include "infra.h"
 
 /* local struct/enum */
 /**
@@ -3224,6 +3225,9 @@ static void __prsr_hw_init(void)
 	/* init ports table */
 	memset(&cfg, 0, sizeof(cfg));
 	cfg.skip_l2_pc = PRSR_PORT_NO_L2_SKIP_VAL;
+	/* for A-step, sending all ip packets to the ingress uc */
+	if (pp_silicon_step_get() == PP_SSTEP_A)
+		cfg.fallback = true;
 	for (i = 0; i < PP_MAX_PORT; i++)
 		prsr_port_cfg_entry_set(i, &cfg);
 	/* init all tables entries */
diff --git a/drivers/net/ppv4/pp-hal/parser/parser_protocols.c b/drivers/net/ppv4/pp-hal/parser/parser_protocols.c
index b69cc5bac2a4..2c84569ef086 100644
--- a/drivers/net/ppv4/pp-hal/parser/parser_protocols.c
+++ b/drivers/net/ppv4/pp-hal/parser/parser_protocols.c
@@ -835,9 +835,6 @@ static s32 __proto_ipv4_init(struct protocol_info *info)
 	/* set fv index value to the first IPv4 */
 	params->ext.fld[0].fv_idx = offsetof(struct pp_fv, first.l3.v4);
 	params->ext.fld[1].fv_idx = offsetof(struct pp_fv, first.l3.v4.saddr);
-	/* for A-step, sending all ip packets to the ingress uc */
-	if (pp_silicon_step_get() == PP_SSTEP_A)
-		params->fallback = true;
 
 	__proto_pr_debug(info);
 	pr_debug("done\n");
@@ -971,9 +968,6 @@ static s32 __proto_ipv6_init(struct protocol_info *info)
 	/* extracting info */
 	params->ext.fld[0].fv_idx = offsetof(struct pp_fv, first.l3.v6);
 	params->ext.fld[1].fv_idx = offsetof(struct pp_fv, first.l3.v6.saddr);
-	/* for A-step, sending all ip packets to the ingress uc */
-	if (pp_silicon_step_get() == PP_SSTEP_A)
-		params->fallback = true;
 
 	__proto_pr_debug(info);
 	pr_debug("done\n");
