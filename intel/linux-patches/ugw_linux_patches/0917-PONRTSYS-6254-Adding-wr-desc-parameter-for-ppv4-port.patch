From 1ce49be6b742fedb80456f36f51e31ff32acc4e2 Mon Sep 17 00:00:00 2001
From: Elad Fernandes <elad.fernandes@intel.com>
Date: Sun, 8 Dec 2019 16:27:42 +0200
Subject: [PATCH] PONRTSYS-6254: Adding wr_desc parameter for ppv4 port tx
 configuration

---
 drivers/net/ppv4/pp-api/pp-port-mgr/pp_port_mgr.c  | 25 ++++++++++++++--------
 .../ppv4/pp-api/pp-port-mgr/pp_port_mgr_debugfs.c  |  7 ++++++
 .../ppv4/pp-tools/init/pp_init_sequence_debugfs.c  |  4 ++++
 .../pp-tools/unit-test/tests/pp_session_tests.c    |  1 +
 4 files changed, 28 insertions(+), 9 deletions(-)

diff --git a/drivers/net/ppv4/pp-api/pp-port-mgr/pp_port_mgr.c b/drivers/net/ppv4/pp-api/pp-port-mgr/pp_port_mgr.c
index a9278b46d75c..2cd9915b128b 100644
--- a/drivers/net/ppv4/pp-api/pp-port-mgr/pp_port_mgr.c
+++ b/drivers/net/ppv4/pp-api/pp-port-mgr/pp_port_mgr.c
@@ -46,7 +46,8 @@ static s32  __pmgr_port_flow_ctr_param_check(u8 flow_ctrl_en);
 static s32  __pmgr_port_tx_cfg_set(u16 pid, struct pp_port_tx_info *tx);
 static s32  __pmgr_port_rx_cfg_set(u16 pid, struct pp_port_rx_info *rx);
 static s32  __pmgr_port_rxdma_param_check(u16 headroom_size, u16 tailroom_size,
-					  bool prel2_en, bool seg_en);
+					  bool prel2_en, bool seg_en,
+					  bool wr_desc);
 static s32  __pmgr_port_tx_policies_param_check(u16 base_policy,
 						ulong policies_map);
 static s32  __pmgr_port_rx_policies_param_check(bool mem_port,
@@ -992,7 +993,8 @@ static s32 __pmgr_port_param_check(u16 pid, struct pp_port_cfg *cfg)
 
 	ret = __pmgr_port_rxdma_param_check(cfg->tx.headroom_size,
 					    cfg->tx.tailroom_size,
-					    cfg->tx.prel2_en, cfg->tx.seg_en);
+					    cfg->tx.prel2_en, cfg->tx.seg_en,
+					    cfg->tx.wr_desc);
 	if (unlikely(ret))
 		goto out;
 
@@ -1106,7 +1108,7 @@ static s32 __pmgr_port_tx_cfg_set(u16 pid, struct pp_port_tx_info *tx)
 	rxdma_port.port_id       = pid;
 	rxdma_port.headroom_size = tx->headroom_size;
 	rxdma_port.tailroom_size = tx->tailroom_size;
-	rxdma_port.wr_desc       = tx->seg_en ? 0 : 1;
+	rxdma_port.wr_desc       = tx->wr_desc;
 	rxdma_port.pkt_only      = tx->pkt_only_en;
 	rxdma_port.min_pkt_size  = tx->min_pkt_len;
 
@@ -1278,10 +1280,12 @@ static s32 __pmgr_port_flow_ctr_param_check(u8 flow_ctrl_en)
  * @param tailroom_size port's tailroom size
  * @param prel2_en If set, port support pre l2
  * @param seg_en If set, port support segmentation
+ * @param wr_desc If set, port support wr descriptor to buffer
  * @return s32 0 for success, non-zero otherwise
  */
 static s32 __pmgr_port_rxdma_param_check(u16 headroom_size, u16 tailroom_size,
-					 bool prel2_en, bool seg_en)
+					 bool prel2_en, bool seg_en,
+					 bool wr_desc)
 {
 	s32 ret = 0;
 	u32 headroom_min_sz = 0;
@@ -1290,23 +1294,26 @@ static s32 __pmgr_port_rxdma_param_check(u16 headroom_size, u16 tailroom_size,
 		 headroom_size, prel2_en, seg_en);
 
 	if (seg_en) {
-		if (unlikely(headroom_size)) {
+		if (headroom_size) {
 			pr_err("Headroom must be 0 if seg_en is enabled\n");
 			ret = -EINVAL;
 			goto out;
 		}
-
-		if (unlikely(tailroom_size)) {
+		if (tailroom_size) {
 			pr_err("Tailroom must be 0 if seg_en is enabled\n");
 			ret = -EINVAL;
 			goto out;
 		}
-
-		if (unlikely(prel2_en)) {
+		if (prel2_en) {
 			pr_err("PreL2 cannot co-exist with segmentation\n");
 			ret = -EINVAL;
 			goto out;
 		}
+		if (wr_desc) {
+			pr_err("Wr_desc cannot co-exist with segmentation\n");
+			ret = -EINVAL;
+			goto out;
+		}
 	} else {
 		/* Verify enough headroom (descriptor + prel2) */
 		if (IS_ENABLED(CONFIG_PPV4_FPGA))
diff --git a/drivers/net/ppv4/pp-api/pp-port-mgr/pp_port_mgr_debugfs.c b/drivers/net/ppv4/pp-api/pp-port-mgr/pp_port_mgr_debugfs.c
index 4816b91b4947..71e47dabb569 100644
--- a/drivers/net/ppv4/pp-api/pp-port-mgr/pp_port_mgr_debugfs.c
+++ b/drivers/net/ppv4/pp-api/pp-port-mgr/pp_port_mgr_debugfs.c
@@ -162,6 +162,7 @@ static void __pmgr_dbg_port_add_set(char *cmd_buf, void *data)
 	cfg.tx.pkt_only_en = false;
 	cfg.tx.policies_map = 0xF;
 	cfg.tx.seg_en = false;
+	cfg.tx.wr_desc = true;
 
 	if (unlikely(pp_port_add(id, &cfg))) {
 		pr_err("failed to add port %hu\n", id);
@@ -322,6 +323,9 @@ void __pmgr_dbg_port_cfg_show(struct seq_file *f)
 	seq_printf(f, "| %-30s | %-10s |\n", "PreL2",
 		   BOOL2STR(cfg.tx.prel2_en));
 	seq_puts(f, "+--------------------------------+------------+\n");
+	seq_printf(f, "| %-30s | %-10s |\n", "Wr Desc",
+		   BOOL2STR(cfg.tx.wr_desc));
+	seq_puts(f, "+--------------------------------+------------+\n");
 	if (unlikely(pmgr_port_rpb_map_get(p, &rpb_port)))
 		seq_puts(f, "  ERROR: Can't get RPB mapping\n");
 	else
@@ -368,6 +372,9 @@ static u16 create_port_props(struct pp_dbg_prop *props, u16 size,
 	pp_dbg_add_prop(props, &num, size, "prel2_en", "Prel2 en",
 			&pconf->tx.prel2_en,
 			sizeof(pconf->tx.prel2_en));
+	pp_dbg_add_prop(props, &num, size, "wr_desc", "Write Descriptor",
+			&pconf->tx.wr_desc,
+			sizeof(pconf->tx.wr_desc));
 
 	return num;
 }
diff --git a/drivers/net/ppv4/pp-tools/init/pp_init_sequence_debugfs.c b/drivers/net/ppv4/pp-tools/init/pp_init_sequence_debugfs.c
index 5c222e4241a5..24fe8a93dda9 100644
--- a/drivers/net/ppv4/pp-tools/init/pp_init_sequence_debugfs.c
+++ b/drivers/net/ppv4/pp-tools/init/pp_init_sequence_debugfs.c
@@ -80,6 +80,7 @@ static s32 __port_mng_init(void)
 	cfg.tx.policies_map = (u8)BIT(0);   /* set policy 0 bit */
 	cfg.tx.pkt_only_en = false;         /* packet+descriptor */
 	cfg.tx.seg_en = false;              /* no segmentation */
+	cfg.tx.wr_desc = true;              /* write descriptor */
 
 	if (unlikely(pp_port_add(0, &cfg))) {
 		pr_err("pp_port_add failed, port%u\n", 0);
@@ -109,6 +110,7 @@ static s32 __port_mng_init(void)
 	cfg.tx.policies_map = 0xF;          /* set policy 0 bit */
 	cfg.tx.pkt_only_en = false;         /* packet+descriptor */
 	cfg.tx.seg_en = false;              /* segmentation disabled*/
+	cfg.tx.wr_desc = true;              /* write descriptor */
 
 	if (unlikely(pp_port_add(mcast_pid, &cfg))) {
 		pr_err("pp_port_add failed, port%u\n", 32);
@@ -145,6 +147,7 @@ static s32 __port_mng_init(void)
 	cfg.tx.pkt_only_en = false; /* packet+descriptor */
 	cfg.tx.seg_en = true;       /* segmentation enabled */
 	cfg.tx.prel2_en = false;    /* prel2 disabled */
+	cfg.tx.wr_desc = true;      /* write descriptor */
 
 	if (unlikely(pp_port_add(32, &cfg))) {
 		pr_err("pp_port_add failed, port%u\n", 32);
@@ -169,6 +172,7 @@ static s32 __port_mng_init(void)
 	cfg.tx.policies_map = 0xF;          /* set policy 0-3 bits */
 	cfg.tx.pkt_only_en = false;         /* packet+descriptor */
 	cfg.tx.seg_en = false;              /* no segmentation */
+	cfg.tx.wr_desc = true;              /* write descriptor */
 
 	if (unlikely(pp_port_add(16, &cfg))) {
 		pr_err("pp_port_add failed, port%u\n", 32);
diff --git a/drivers/net/ppv4/pp-tools/unit-test/tests/pp_session_tests.c b/drivers/net/ppv4/pp-tools/unit-test/tests/pp_session_tests.c
index fefd887a10e1..c8ecb4c302be 100644
--- a/drivers/net/ppv4/pp-tools/unit-test/tests/pp_session_tests.c
+++ b/drivers/net/ppv4/pp-tools/unit-test/tests/pp_session_tests.c
@@ -237,6 +237,7 @@ static int pp_sess_pre_test(void *data)
 	cfg.rx.flow_ctrl_en = 1;
 	cfg.tx.max_pkt_size = 2000;
 	cfg.tx.policies_map = (u8)BIT(0);
+	cfg.tx.wr_desc = true;
 	if (IS_ENABLED(CONFIG_PPV4_FPGA))
 		cfg.tx.headroom_size = 16;
 	else
