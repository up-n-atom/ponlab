From 45637ae819520b3510fcafcf52a0de1b9e6ceaad Mon Sep 17 00:00:00 2001
From: "Rywacki, Kamil" <kamil.rywacki@intel.com>
Date: Mon, 31 Aug 2020 14:04:47 +0200
Subject: [PATCH] PONRTSYS-7943 && PONRTSYS-7944

- Do not update lookup table for existing downstream QID
---
 drivers/net/datapath/pon_qos/pon_qos_tc_qos.c | 11 ++++++++---
 1 file changed, 8 insertions(+), 3 deletions(-)

diff --git a/drivers/net/datapath/pon_qos/pon_qos_tc_qos.c b/drivers/net/datapath/pon_qos/pon_qos_tc_qos.c
index 534960c1f4a5..1c6b5e9f2c70 100644
--- a/drivers/net/datapath/pon_qos/pon_qos_tc_qos.c
+++ b/drivers/net/datapath/pon_qos/pon_qos_tc_qos.c
@@ -866,11 +866,16 @@ static int pon_qos_reassign_tc(struct pon_qos_qdisc *sch, int tc, bool en)
 }
 
 static int pon_qos_map_qid(struct pon_qos_q_data *qid,
-			   int port, int tc, bool en)
+			   struct pon_qos_qdisc *sch,
+			   int tc, bool en)
 {
 	int ret;
 
-	ret = pon_qos_set_qmap(qid, port, tc, en);
+	/* Do not overwrite lookup table for active downstream QID */
+	if (sch->ds && (atomic_read(&qid->ref_cnt) > 0))
+		return 0;
+
+	ret = pon_qos_set_qmap(qid, sch->port, tc, en);
 	if (ret != 0)
 		return -EFAULT;
 
@@ -928,7 +933,7 @@ int pon_qos_update_qmap(struct net_device *dev,
 
 		ret = pon_qos_config_cpu_port(qid, sch->port, tc, en);
 	} else {
-		ret = pon_qos_map_qid(qid, sch->port, tc, en);
+		ret = pon_qos_map_qid(qid, sch, tc, en);
 		if (ret != 0) {
 			netdev_err(dev, "%s: qid map err\n", __func__);
 			return -EFAULT;
