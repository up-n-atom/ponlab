From 10f4fbd4040d1d795309513a4ffe9044c67cf98a Mon Sep 17 00:00:00 2001
From: thampan <joby.thampan@intel.com>
Date: Thu, 18 Jun 2020 19:34:47 +0800
Subject: [PATCH] DRV_DPM_SW-322: Bug Fix for Deq port check in Port Block and
 Flush API

---
 drivers/net/datapath/dpm/gswip31/datapath_lookup_proc.c | 2 +-
 drivers/net/datapath/dpm/gswip31/datapath_ppv4_api.c    | 9 +++++----
 include/net/datapath_api_qos.h                          | 6 +++---
 3 files changed, 9 insertions(+), 8 deletions(-)

diff --git a/drivers/net/datapath/dpm/gswip31/datapath_lookup_proc.c b/drivers/net/datapath/dpm/gswip31/datapath_lookup_proc.c
index c75c60f5ff0a..e912f10d30c0 100644
--- a/drivers/net/datapath/dpm/gswip31/datapath_lookup_proc.c
+++ b/drivers/net/datapath/dpm/gswip31/datapath_lookup_proc.c
@@ -329,7 +329,7 @@ int find_pattern(int port_id, struct seq_file *s, int qid)
 	int inst = 0;
 	struct hal_priv *priv = (struct hal_priv *)dp_port_prop[inst].priv_hal;
 	u32 mode = get_dp_port_info(inst, port_id)->cqe_lu_mode;
-	int match;
+	int match = 0;
 
 	left_n = 1 << (LOOKUP_FIELD_BITS - 4);	/*maximum lookup entried */
 	lookup_match_num = 0;
diff --git a/drivers/net/datapath/dpm/gswip31/datapath_ppv4_api.c b/drivers/net/datapath/dpm/gswip31/datapath_ppv4_api.c
index 7e870b982f0e..dd33ad9d2b1b 100644
--- a/drivers/net/datapath/dpm/gswip31/datapath_ppv4_api.c
+++ b/drivers/net/datapath/dpm/gswip31/datapath_ppv4_api.c
@@ -2652,6 +2652,10 @@ int dp_deq_port_res_get_31(struct dp_dequeue_res *res, int flag)
 		res->cqm_deq_port = port_info->deq_port_base + res->cqm_deq_idx;
 		res->num_deq_ports = 1;
 	}
+
+	if (!is_deqport_valid(res->cqm_deq_port))
+		return DP_FAILURE;
+
 	DP_DEBUG(DP_DBG_FLAG_QOS_DETAIL,
 		 "%s:dp_port=%d cqm_deq_port=(%d ~%d) %d\n",
 		 __func__,
@@ -4379,9 +4383,6 @@ int dp_port_block_flush_31(struct dp_qos_blk_flush_port *cfg,
 	int i = 0;
 	struct dp_qos_blk_flush_queue q_cfg;
 
-	if (is_deqport_valid(cfg->deq_port))
-		return DP_FAILURE;
-
 	priv = HAL(cfg->inst);
 	if (!priv || !priv->qdev) {
 		pr_err("%s failed: qdev NULL with inst=%d\n", __func__,
@@ -4394,7 +4395,7 @@ int dp_port_block_flush_31(struct dp_qos_blk_flush_port *cfg,
 		return DP_FAILURE;
 
 	deq.dp_port = cfg->dp_port;
-	deq.cqm_deq_idx = cfg->deq_port;
+	deq.cqm_deq_idx = cfg->deq_port_idx;
 	deq.q_res = q_res;
 	deq.q_res_size = MAX_Q_PER_PORT;
 
diff --git a/include/net/datapath_api_qos.h b/include/net/datapath_api_qos.h
index f7595989228c..5ee8ca305add 100644
--- a/include/net/datapath_api_qos.h
+++ b/include/net/datapath_api_qos.h
@@ -1327,9 +1327,9 @@ int dp_qos_get_q_logic(struct dp_qos_q_logic *cfg, int flag);
  *
  */
 struct dp_qos_blk_flush_port {
-	int inst;	/*!< [in] DP instance */
-	u32 dp_port;	/*!< [in] Logical port id */
-	int deq_port;	/*!< [in] Flushes Q based  on deq port specified */
+	int inst;	 /*!< [in] DP instance */
+	u32 dp_port;	 /*!< [in] Logical port id */
+	int deq_port_idx;/*!< [in] Flushes Q based  on deq port idx specified */
 };
 
 /*!< dp_block_flush_port: Flush all the Q's associated with the deq port
