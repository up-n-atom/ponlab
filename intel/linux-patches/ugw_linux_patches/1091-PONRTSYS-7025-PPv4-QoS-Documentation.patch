From def972f4d0d1f530ed2cb8eeafa2d8a73bacd07e Mon Sep 17 00:00:00 2001
From: ofirbitt <ofir1.bitton@intel.com>
Date: Mon, 16 Mar 2020 17:14:01 +0200
Subject: [PATCH] PONRTSYS-7025: PPv4 QoS Documentation

---
 drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_fw.c    | 23 ++++----
 drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.h | 68 +++++++++++++++++------
 2 files changed, 60 insertions(+), 31 deletions(-)

diff --git a/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_fw.c b/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_fw.c
index 5fd4ad7f3271..94a5e708979b 100644
--- a/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_fw.c
+++ b/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_fw.c
@@ -349,12 +349,7 @@ bool is_uc_awake(unsigned long wake_addr)
 #ifndef PP_QOS_DISABLE_CMDQ
 #define CMD_INT_RESPONSE_SZ        4
 
-/* Post process returning data to an external buffer */
-#define CMD_FLAGS_POST_PROCESS_EXT BIT(0)
-
-/* Post process returning data to a DCCM buffer */
-#define CMD_FLAGS_POST_PROCESS_INT BIT(1)
-
+/* @brief driver internal command id - for debug */
 enum cmd_type {
 	CMD_TYPE_INIT_LOGGER,
 	CMD_TYPE_INIT_QOS,
@@ -436,14 +431,16 @@ static const char *const cmd_str[] = {
 /*                         Driver commands structures	                      */
 /******************************************************************************/
 struct cmd {
-	u32           id;
+	u32           id; /* command sequence id - for debug */
+#define CMD_FLAGS_POST_PROCESS_EXT BIT(0) /* Post process data from ext buff */
+#define CMD_FLAGS_POST_PROCESS_INT BIT(1) /* Post process data from int buff */
 	u32           flags;
-	enum cmd_type type;
-	size_t        len;
-	void          *response;
-	u32           int_response_offset;
-	u32           response_sz;
-	unsigned long pos;
+	enum cmd_type type; /* command type - for debug */
+	size_t        len; /* Command length */
+	void          *response; /* response address */
+	u32           int_response_offset; /* response offset in command */
+	u32           response_sz; /* num bytes of response */
+	unsigned long pos; /* Command offset in FW buffer */
 } __attribute__((packed));
 
 struct cmd_internal {
diff --git a/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.h b/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.h
index b0f3081909f7..b8912ef7cf1c 100644
--- a/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.h
+++ b/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.h
@@ -42,9 +42,24 @@
 /*                              DEFINES                                       */
 /******************************************************************************/
 
+/**
+ * @define non allocated octet is marked as invalid
+ */
 #define QOS_INVALID_OCTET   0xFFFFU
+
+/**
+ * @define non allocated phy is marked as invalid
+ */
 #define QOS_INVALID_PHY     0xFFFFU
+
+/**
+ * @define non allocated rlm is marked as invalid
+ */
 #define QOS_INVALID_RLM     (QOS_INVALID_PHY)
+
+/**
+ * @define allocated logical id is marked as unmapped until actual mapping
+ */
 #define QOS_UNMAPPED_PHY    0xFFFEU
 
 #define QOS_CHILD_UNLIMITED_WEIGHT 127
@@ -228,10 +243,19 @@ struct pp_pool {
 	(max(sizeof(struct queue_stat_info) * NUM_Q_ON_QUERY, \
 	sizeof(struct system_stats_s)) + 4)
 
+/**
+ * @struct pp_mapping
+ * @brief Holds mapping between a logical id and a physical id. Used for:
+ * 	  1. Logical id to physical node id mapping
+ * 	  2. Logical id to physical queue id (rlm) mapping
+ */
 struct pp_mapping {
+	/* phyical id mapped to a logical id */
 	u16 id2phy[NUM_OF_NODES];
+	/* logical id mapped to a physical id */
 	u16 phy2id[NUM_OF_NODES];
-	u16 id2rep_id[NUM_OF_NODES]; /* replication tree id's */
+	/* replication tree id's */
+	u16 id2rep_id[NUM_OF_NODES];
 };
 
 struct octet_info {
@@ -279,12 +303,18 @@ struct parent_node_properties {
 #define WRED_MAX_ALLOWED_DEFAULT (0x400)
 
 struct qos_node {
+	/* Port / Sched / Queue */
 	enum node_type                type;
+	/* Configured BW limit by user */
 	u32                           bandwidth_limit;
+	/* Actual configured BW limit */
 	u32                           actual_bandwidth_limit;
 	u16                           shared_bw_group;
+	/* child properties, relevant for sched and queue */
 	struct child_node_properties  child_prop;
+	/* parent properties, relevant for port and sched */
 	struct parent_node_properties parent_prop;
+	/* Dual rate shaper scheduler logical id */
 	u16                           dr_sched_id;
 	union _data {
 		struct {
@@ -321,19 +351,19 @@ struct qos_node {
 		} queue;
 	} data;
 
-#define NODE_FLAGS_USED                          BIT(0)
-#define NODE_FLAGS_INTERNAL                      BIT(1)
-#define NODE_FLAGS_QUEUE_NEW_SYNCQ               BIT(2)
-#define NODE_FLAGS_QUEUE_CONNECTED_SYNCQ         BIT(3)
-#define NODE_FLAGS_PARENT_BEST_EFFORT_EN         BIT(4)
-#define NODE_FLAGS_REPLICATION_NODE              BIT(5)
-#define NODE_FLAGS_SCHED_SYNCQ                   BIT(6)
-#define NODE_FLAGS_PORT_PACKET_CREDIT_EN         BIT(7)
-#define NODE_FLAGS_PORT_BYTE_CREDIT_EN           BIT(8)
-#define NODE_FLAGS_QUEUE_WRED_EN                 BIT(10)
-#define NODE_FLAGS_QUEUE_BLOCKED                 BIT(11)
-#define NODE_FLAGS_QUEUE_WRED_FIXED_DROP_PROB_EN BIT(12)
-#define NODE_FLAGS_QUEUE_AQM                     BIT(13)
+#define NODE_FLAGS_USED                  BIT(0) /* Active node */
+#define NODE_FLAGS_INTERNAL              BIT(1) /* Internal node */
+#define NODE_FLAGS_QUEUE_NEW_SYNCQ       BIT(2) /* SQ allocated */
+#define NODE_FLAGS_QUEUE_CONNECTED_SYNCQ BIT(3) /* SQ connected to tree */
+#define NODE_FLAGS_PARENT_BEST_EFFORT_EN BIT(4) /* Best effort */
+#define NODE_FLAGS_REPLICATION_NODE      BIT(5) /* Dual rate shaper replica */
+#define NODE_FLAGS_SCHED_SYNCQ           BIT(6) /* Sched for SQ */
+#define NODE_FLAGS_PORT_PACKET_CREDIT_EN BIT(7) /* Packet credit mode */
+#define NODE_FLAGS_PORT_BYTE_CREDIT_EN   BIT(8) /* Byte credit - DEPRECATED */
+#define NODE_FLAGS_QUEUE_WRED_EN         BIT(10) /* WRED algorithm enabled */
+#define NODE_FLAGS_QUEUE_BLOCKED         BIT(11) /* Queue is blocked */
+#define NODE_FLAGS_QUEUE_WRED_FIXED_DROP_PROB_EN BIT(12) /* Fixed drop prob */
+#define NODE_FLAGS_QUEUE_AQM             BIT(13) /* Connected to AQM context */
 	u16 flags;
 };
 
@@ -421,8 +451,8 @@ struct pp_qos_dev {
 	struct range                   rlm_ranges[RLM_RANGES_MAX];
 	struct pp_pool                 *portsphys;
 	struct pp_nodes                *nodes;
-	struct pp_mapping              *mapping;
-	struct pp_mapping              *rlm_mapping;
+	struct pp_mapping              *mapping; /* logical id/phy id mapping */
+	struct pp_mapping              *rlm_mapping; /* logical id/rlm mapping*/
 	struct pp_octets               *octets;
 	struct pp_queue                *queue;
 	struct pp_syncq                *syncq;
@@ -737,7 +767,7 @@ u32 get_phy_from_id(const struct pp_mapping *map, u32 id);
 /* Map id <==> phy */
 void map_id_phy(struct pp_mapping *map, u32 id, u32 phy);
 
-/* Map id ==>  QOS_UNKNOWN_PHY */
+/* Map id ==>  QOS_UNMAPPED_PHY */
 void map_id_reserved(struct pp_mapping *map, u32 id);
 
 /* Invalidate id */
@@ -758,10 +788,12 @@ void map_invalidate_phy(struct pp_mapping *map, u32 phy);
 /* Invalidate both the id and the phy that is currently mapped to it */
 void map_invalidate_id_phy(struct pp_mapping *map, u32 id);
 
-/* Phy node mapping */
+/* Get db node structure from physical node id */
 struct qos_node *get_node_from_phy(struct pp_nodes *nodes, u32 phy);
 const struct qos_node *get_const_node_from_phy(const struct pp_nodes *nodes,
 					       u32 phy);
+
+/* Get physical node id from db node structure */
 u32 get_phy_from_node(const struct pp_nodes *nodes,
 		      const struct qos_node *node);
 
