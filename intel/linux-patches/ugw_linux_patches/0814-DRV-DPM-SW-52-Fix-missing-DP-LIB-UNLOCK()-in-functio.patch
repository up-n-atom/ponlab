From 229a9a7c363bb95bf06b2d5fddd29f15b4e5ee57 Mon Sep 17 00:00:00 2001
From: Gu Chao <gux.chao@intel.com>
Date: Mon, 30 Sep 2019 16:35:59 +0800
Subject: [PATCH] DRV_DPM_SW-52: Fix missing DP_LIB_UNLOCK() in function
 dp_register_subif_ext()

- fix minor coding style issue
---
 drivers/net/datapath/dpm/datapath_api.c  | 38 +++++++++++---------------------
 drivers/net/datapath/dpm/datapath_misc.c |  6 ++---
 2 files changed, 15 insertions(+), 29 deletions(-)

diff --git a/drivers/net/datapath/dpm/datapath_api.c b/drivers/net/datapath/dpm/datapath_api.c
index 3e2bb5f70ee7..7f866a4c516f 100644
--- a/drivers/net/datapath/dpm/datapath_api.c
+++ b/drivers/net/datapath/dpm/datapath_api.c
@@ -478,8 +478,7 @@ static int32_t dp_alloc_port_private(int inst,
 	if (cbm_data.flags & CBM_PORT_DMA_CHAN_SET)
 		port->dma_chan = cbm_data.dma_chan;
 	if (cbm_data.flags & CBM_PORT_PKT_CRDT_SET)
-		port->tx_pkt_credit =
-				cbm_data.tx_pkt_credit;
+		port->tx_pkt_credit = cbm_data.tx_pkt_credit;
 	if (cbm_data.flags & CBM_PORT_BYTE_CRDT_SET)
 		port->tx_b_credit = cbm_data.tx_b_credit;
 	if (cbm_data.flags & CBM_PORT_RING_ADDR_SET) {
@@ -489,8 +488,7 @@ static int32_t dp_alloc_port_private(int inst,
 	if (cbm_data.flags & CBM_PORT_RING_SIZE_SET)
 	port->tx_ring_size = cbm_data.tx_ring_size;
 	if (cbm_data.flags & CBM_PORT_RING_OFFSET_SET)
-		port->tx_ring_offset =
-				cbm_data.tx_ring_offset;
+		port->tx_ring_offset = cbm_data.tx_ring_offset;
 	if ((cbm_data.num_dma_chan > 1) && (cbm_data.deq_port_num !=
 	    cbm_data.num_dma_chan)) {
 		pr_err("ERROR:deq_port_num=%d not equal to num_dma_chan=%d\n",
@@ -505,8 +503,7 @@ static int32_t dp_alloc_port_private(int inst,
 		cbm_dp_port_dealloc(owner, dev_port, port_id, &cbm_data,
 				    flags | DP_F_DEREGISTER);
 		/* Only clear those fields we need to clear */
-		memset(port, 0,
-		       offsetof(struct pmac_port_info, tail));
+		memset(port, 0, offsetof(struct pmac_port_info, tail));
 		return DP_FAILURE;
 	}
 	if (pmac_cfg)
@@ -627,8 +624,8 @@ int32_t dp_register_subif_private(int inst, struct module *owner,
 					     port_info->vap_mask);
 		else /*provided by caller since it is alerady shifted properly*/
 			sif->subif = subif_id->subif;
-		strncpy(sif->device_name,
-			subif_name, sizeof(sif->device_name) - 1);
+		strncpy(sif->device_name, subif_name,
+			sizeof(sif->device_name) - 1);
 		sif->subif_flag = flags;
 		sif->data_flag_ops = data->flag_ops;
 		if (data->flag_ops & DP_SUBIF_RX_FLAG)
@@ -906,9 +903,7 @@ int32_t dp_alloc_port_ext(int inst, struct module *owner,
 	/*For VRX518, it will always carry DP_F_FAST_WLAN flag for
 	 * ACA HW resource purpose in CBM
 	 */
-	if ((res > 0) &&
-	    (flags & DP_F_FAST_WLAN) &&
-	    (aca_portid < 0)) {
+	if ((res > 0) && (flags & DP_F_FAST_WLAN) && (aca_portid < 0)) {
 		dp_subif_t subif_id;
 		#define ACA_CSUM_NAME "aca_csum"
 		strcpy(aca_owner.name, ACA_CSUM_NAME);
@@ -996,10 +991,8 @@ int32_t dp_register_dev_ext(int inst, struct module *owner, uint32_t port_id,
 		if (port_info->status != PORT_DEV_REGISTERED) {
 			DP_DEBUG(DP_DBG_FLAG_REG,
 				 "No or %s to de-register for num_subif=%d\n",
-				 owner->name,
-				 port_info->num_subif);
-		} else if (port_info->status ==
-			   PORT_DEV_REGISTERED) {
+				 owner->name, port_info->num_subif);
+		} else if (port_info->status == PORT_DEV_REGISTERED) {
 			port_info->status = PORT_ALLOCATED;
 			DP_CB(inst, dev_platform_set)(inst, port_id, data,
 						      flags);
@@ -1167,15 +1160,11 @@ int32_t dp_register_subif_ext(int inst, struct module *owner,
 	}
 
 	if (flags & DP_F_DEREGISTER) /*de-register */
-		res =
-		dp_deregister_subif_private(inst, owner, dev,
-					    subif_name,
-					    subif_id, data, flags);
+		res = dp_deregister_subif_private(inst, owner, dev, subif_name,
+						  subif_id, data, flags);
 	else /*register */
-		res =
-		dp_register_subif_private(inst, owner, dev,
-					  subif_name,
-					  subif_id, data, flags);
+		res = dp_register_subif_private(inst, owner, dev, subif_name,
+						subif_id, data, flags);
 	if (!(flags & DP_F_SUBIF_LOGICAL))
 		subifid_fn_t = port_info->cb.get_subifid_fn;
 
@@ -1299,8 +1288,7 @@ int32_t dp_get_netif_subifid_priv(struct net_device *netif, struct sk_buff *skb,
 	struct logic_dev *tmp = NULL;
 	u16 gpid = 0;
 
-	subifs = kmalloc(sizeof(*subifs) * DP_MAX_CTP_PER_DEV,
-			 GFP_ATOMIC);
+	subifs = kmalloc(sizeof(*subifs) * DP_MAX_CTP_PER_DEV, GFP_ATOMIC);
 	if (!subifs) {
 		pr_err("Failed to alloc %zu bytes\n",
 		       sizeof(*subifs) * DP_MAX_CTP_PER_DEV);
diff --git a/drivers/net/datapath/dpm/datapath_misc.c b/drivers/net/datapath/dpm/datapath_misc.c
index f7d517d009d0..81cea023a2b4 100644
--- a/drivers/net/datapath/dpm/datapath_misc.c
+++ b/drivers/net/datapath/dpm/datapath_misc.c
@@ -1123,8 +1123,7 @@ int dp_meter_alloc(int inst, int *meterid, int flag)
 }
 EXPORT_SYMBOL(dp_meter_alloc);
 
-int dp_meter_add(struct net_device *dev, struct dp_meter_cfg *meter,
-		 int flag)
+int dp_meter_add(struct net_device *dev, struct dp_meter_cfg *meter, int flag)
 {
 	struct dp_meter_subif mtr_subif = {0};
 
@@ -1157,8 +1156,7 @@ int dp_meter_add(struct net_device *dev, struct dp_meter_cfg *meter,
 }
 EXPORT_SYMBOL(dp_meter_add);
 
-int dp_meter_del(struct net_device *dev, struct dp_meter_cfg *meter,
-		 int flag)
+int dp_meter_del(struct net_device *dev, struct dp_meter_cfg *meter, int flag)
 {
 	struct dp_meter_subif mtr_subif = {0};
 
