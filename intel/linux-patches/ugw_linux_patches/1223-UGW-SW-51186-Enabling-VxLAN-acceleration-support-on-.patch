@@ -2297,6 +2297,20 @@ static netdev_tx_t vxlan_xmit(struct sk_buff *skb, struct net_device *dev)
 	return NETDEV_TX_OK;
 }
 
+#if IS_ENABLED(CONFIG_PPA)
+extern int32_t (*ppa_is_vxlan_fn)
+	(struct net_device *dev);
+
+static int32_t ppa_if_dev_is_vxlan(struct net_device *netdev)
+{
+	int ret = 0;
+
+	ret = (netdev->netdev_ops->ndo_start_xmit == vxlan_xmit) ? 1 : 0;
+
+	return ret;
+}
+#endif
+
 /* Walk the forwarding table and purge stale entries */
