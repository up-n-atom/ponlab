From c63898906291324a87b7c91127aab9067924a000 Mon Sep 17 00:00:00 2001
From: "Rywacki, Kamil" <kamil.rywacki@intel.com>
Date: Fri, 12 Mar 2021 12:12:25 +0100
Subject: [PATCH] PONRTSYS-8622: Fix IP drop rule version selection

---
 drivers/net/datapath/pon_qos/pon_qos_tc_ip_drop.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/drivers/net/datapath/pon_qos/pon_qos_tc_ip_drop.c b/drivers/net/datapath/pon_qos/pon_qos_tc_ip_drop.c
index af761a32b8d8..c160097a2171 100644
--- a/drivers/net/datapath/pon_qos/pon_qos_tc_ip_drop.c
+++ b/drivers/net/datapath/pon_qos/pon_qos_tc_ip_drop.c
@@ -43,7 +43,7 @@ static int parse_mask(struct net_device *dev,
 		}
 	}
 
-	netdev_dbg(dev, "%s: nDstIP_Mask: %u\n",
+	netdev_dbg(dev, "%s: nDstIP_Mask: %x\n",
 		   __func__, rule->pattern.nDstIP_Mask);
 
 	return 0;
@@ -66,6 +66,7 @@ static int parse_ipv4(struct net_device *dev,
 					 FLOW_DISSECTOR_KEY_IPV4_ADDRS,
 					 f->mask);
 
+	rule->pattern.eDstIP_Select = GSW_PCE_IP_V4;
 	memcpy(&rule->pattern.nDstIP.nIPv4, &key->dst, sizeof(key->dst));
 	if (ipv4_is_multicast(key->dst))
 		rule->action.ePortFilterType_Action =
@@ -91,6 +92,7 @@ static int parse_ipv6(struct net_device *dev,
 					 FLOW_DISSECTOR_KEY_IPV6_ADDRS,
 					 f->mask);
 
+	rule->pattern.eDstIP_Select = GSW_PCE_IP_V6;
 	memcpy(rule->pattern.nDstIP.nIPv6, &key->dst, sizeof(key->dst));
 	if (ipv6_addr_is_multicast(&key->dst))
 		rule->action.ePortFilterType_Action =
@@ -114,7 +116,6 @@ static int parse_ip(struct net_device *dev,
 					f->key);
 	addr_type = key->addr_type;
 
-	pce_rule->pattern.eDstIP_Select = 1;
 	pce_rule->action.ePortFilterType_Action = GSW_PCE_PORT_FILTER_ACTION_1;
 
 	switch (addr_type) {
