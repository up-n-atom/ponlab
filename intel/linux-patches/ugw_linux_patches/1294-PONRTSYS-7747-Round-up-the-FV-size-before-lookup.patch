From 61478f8e623f39a659ff8ddd42e7e83dc2aa8c44 Mon Sep 17 00:00:00 2001
From: Elad Fernandes <elad.fernandes@intel.com>
Date: Thu, 16 Apr 2020 14:07:59 +0300
Subject: [PATCH] PONRTSYS-7747: Round up the FV size before lookup

---
 drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c | 10 +++-------
 drivers/net/ppv4/pp-hal/session-info/pp_si.c            |  2 --
 2 files changed, 3 insertions(+), 9 deletions(-)

diff --git a/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c b/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c
index 80dda55a9418..119319929d04 100644
--- a/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c
+++ b/drivers/net/ppv4/pp-api/pp-session-mgr/pp_session_mgr.c
@@ -1815,7 +1815,7 @@ static s32 __smgr_calc_fv_real_sz(struct sess_info *s)
 	/* oob always exist */
 	s->si.fv_sz = sizeof(s->si.fv.oob);
 	if (!SESS_RX_PKT(s))
-		return 0;
+		goto roundup;
 
 	/* outer l2 */
 	if (PKTPRS_IS_MAC(SESS_RX_PKT(s), HDR_OUTER))
@@ -1841,6 +1841,8 @@ static s32 __smgr_calc_fv_real_sz(struct sess_info *s)
 	if (SESS_RX_IS_INNER_L4(s))
 		s->si.fv_sz = sizeof(s->si.fv);
 
+roundup:
+	s->si.fv_sz = roundup(s->si.fv_sz, 16);
 	return 0;
 }
 
@@ -2414,7 +2416,6 @@ static void __smgr_si_newhdr_set(struct sess_info *s)
 		s->si.pkt_len_diff =
 			dpu->nhdr_sz -
 			pktprs_hdr_off(SESS_RX_PKT(s), outer_ip, HDR_OUTER);
-
 	} else if (__smgr_is_esp_encp_sess(s)) {
 		/* new header size should include the ESP header w/o the IV */
 		dpu->nhdr_sz = pktprs_hdr_off(SESS_TX_PKT(s),
@@ -2837,11 +2838,6 @@ static s32 __smgr_si_create(struct sess_info *s)
 		goto done;
 
 	ret = pp_si_encode(&s->hw_si, &s->si);
-
-	/* si encoding might change the field vector size so we must save
-	 * the latest one
-	 */
-	s->db_ent->info.fv_sz = si->fv_sz;
 done:
 	if (unlikely(ret)) {
 		pr_err("failed to create si\n");
diff --git a/drivers/net/ppv4/pp-hal/session-info/pp_si.c b/drivers/net/ppv4/pp-hal/session-info/pp_si.c
index 5da13403279f..56e12a24b87e 100644
--- a/drivers/net/ppv4/pp-hal/session-info/pp_si.c
+++ b/drivers/net/ppv4/pp-hal/session-info/pp_si.c
@@ -737,8 +737,6 @@ static s32 __pp_si_bce_encode(struct pp_hw_si *hw_si, struct pp_si *si)
  */
 static s32 __pp_si_fv_encode(struct pp_hw_si *hw_si, struct pp_si *si)
 {
-	si->fv_sz = roundup(si->fv_sz, 16);
-
 	/* make sure fv doesn't overlap bce */
 	if ((sizeof(*hw_si) - si->fv_sz) < (si->bce_start + si->bce_sz)) {
 		pr_err("FV overlap bce region, fv sz %u, bce start %u, bce sz %u",
