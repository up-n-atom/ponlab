From 1a5c685d726d01b22b10dacd6dbb5d353b8c3e54 Mon Sep 17 00:00:00 2001
From: thampan <joby.thampan@intel.com>
Date: Tue, 21 Apr 2020 13:56:31 +0800
Subject: [PATCH] DRV_DPM_SW-233: DPM Enhanced WSP configuration support

---
 .../net/datapath/dpm/gswip31/datapath_ppv4_api.c   | 46 ++++++++++++++++------
 include/net/datapath_api_qos.h                     |  4 ++
 2 files changed, 37 insertions(+), 13 deletions(-)

diff --git a/drivers/net/datapath/dpm/gswip31/datapath_ppv4_api.c b/drivers/net/datapath/dpm/gswip31/datapath_ppv4_api.c
index 03dd39926d12..a0a36e79c5c4 100644
--- a/drivers/net/datapath/dpm/gswip31/datapath_ppv4_api.c
+++ b/drivers/net/datapath/dpm/gswip31/datapath_ppv4_api.c
@@ -711,8 +711,8 @@ static int node_queue_rst(int inst, int node_id, int flag)
 			 __func__, phy_id, node_id, resv_idx, dp_port);
 	}
 	/* Remove resource from global table */
-	memset(qos_queue_stat, 0, sizeof(priv->qos_queue_stat[phy_id]));
-	memset(qos_sch_stat, 0, sizeof(priv->qos_sch_stat[node_id]));
+	memset(qos_queue_stat, 0, sizeof(*qos_queue_stat));
+	memset(qos_sch_stat, 0, sizeof(*qos_sch_stat));
 	qos_queue_stat->resv_idx = INV_RESV_IDX;
 	qos_sch_stat->resv_idx = INV_RESV_IDX;
 	DP_DEBUG(DP_DBG_FLAG_QOS,
@@ -932,7 +932,7 @@ static int node_sched_rst(int inst, int node_id, int flag)
 			 node_id, resv_idx, dp_port);
 	}
 	/* Free Global Resource */
-	memset(qos_sch_stat, 0, sizeof(priv->qos_sch_stat[node_id]));
+	memset(qos_sch_stat, 0, sizeof(*qos_sch_stat));
 	qos_sch_stat->resv_idx = INV_RESV_IDX;
 	DP_DEBUG(DP_DBG_FLAG_QOS,
 		 "%s:%s SCH:[/%d] resv_idx:%d dp_port=%d\n",
@@ -1061,7 +1061,7 @@ static int node_port_rst(int inst, int node_id, int flag)
 		       "Expect ALLOC Or non-zero child_num");
 		return DP_FAILURE;
 	}
-	memset(deq_port_stat, 0, sizeof(priv->deq_port_stat[phy_id]));
+	memset(deq_port_stat, 0, sizeof(*deq_port_stat));
 	memset(&priv->qos_sch_stat[node_id], 0,
 	       sizeof(priv->qos_sch_stat[node_id]));
 	return DP_SUCCESS;
@@ -2101,6 +2101,8 @@ int dp_node_link_get_31(struct dp_node_link *info, int flag)
 			info->prio_wfq = queue_cfg.queue_child_prop.wrr_weight;
 		else if (info->arbi == ARBITRATION_WSP)
 			info->prio_wfq = queue_cfg.queue_child_prop.priority;
+		else
+			pr_err("Invalid Arbi %s %d\n", __func__, info->arbi);
 
 		info->leaf = 0;
 		return DP_SUCCESS;
@@ -2132,6 +2134,9 @@ int dp_node_link_get_31(struct dp_node_link *info, int flag)
 			info->prio_wfq = sched_cfg.sched_child_prop.wrr_weight;
 		else if (info->arbi == ARBITRATION_WSP)
 			info->prio_wfq = sched_cfg.sched_child_prop.priority;
+		else
+			pr_err("Invalid Arbi %s %d\n", __func__, info->arbi);
+
 		info->leaf = 0;
 		return DP_SUCCESS;
 	}
@@ -2230,7 +2235,7 @@ static int is_prio_used(int inst, int parent_node, int prio_wfq)
 
 		/* No free priority found return fail */
 		if (i >= MAX_PP_CHILD_PER_NODE) {
-			pr_err("Cannot get a free priority,%s",
+			pr_err("Cannot get a free priority, %s",
 			       "upper layer need to handle proper priority\n");
 			goto EXIT;
 		}
@@ -2293,6 +2298,8 @@ static int dp_link_set(struct dp_node_link *info, int parent_node, int flag)
 			queue_cfg->queue_child_prop.wrr_weight = info->prio_wfq;
 		else if (info->arbi == ARBITRATION_WSP)
 			queue_cfg->queue_child_prop.priority = info->prio_wfq;
+		else
+			pr_err("Invalid Arbi %s %d\n", __func__, info->arbi);
 
 		DP_DEBUG(DP_DBG_FLAG_QOS,
 			 "Try to link Q[%d/%d] to parent[%d/%d] port[%d]\n",
@@ -2316,6 +2323,8 @@ static int dp_link_set(struct dp_node_link *info, int parent_node, int flag)
 			sched_cfg->sched_child_prop.wrr_weight = info->prio_wfq;
 		else if (info->arbi == ARBITRATION_WSP)
 			sched_cfg->sched_child_prop.priority = info->prio_wfq;
+		else
+			pr_err("Invalid Arbi %s %d\n", __func__, info->arbi);
 
 		sched_cfg->sched_parent_prop.arbitration =
 			arbi_dp2pp(info->arbi);
@@ -2508,6 +2517,8 @@ int dp_qos_link_prio_set_31(struct dp_node_prio *info, int flag)
 			sched_cfg.sched_child_prop.wrr_weight = info->prio_wfq;
 		else if (info->arbi == ARBITRATION_WSP)
 			sched_cfg.sched_child_prop.priority = info->prio_wfq;
+		else
+			pr_err("Invalid Arbi %s %d\n", __func__, info->arbi);
 
 		DP_DEBUG(DP_DBG_FLAG_QOS_DETAIL,
 			 "Prio:%d paased to low level for Sched[%d]\n",
@@ -4398,25 +4409,34 @@ int dp_qos_port_conf_set_31(struct dp_port_cfg_info *info, int flag)
 	struct hal_priv *priv;
 	struct pp_qos_port_conf port_cfg = {0};
 	int node_id;
+	struct cqm_deq_stat *deq_port_stat;
 
-	if (!info) {
-		pr_err("info cannot be NULL\n");
-		return DP_FAILURE;
-	}
 	priv = HAL(info->inst);
 	if (!priv) {
-		pr_err("priv cannot be NULL\n");
+		pr_err("%s priv cannot be NULL\n", __func__);
 		return DP_FAILURE;
 	}
-	node_id = priv->deq_port_stat[info->pid].node_id;
+
+	if (!is_deqport_valid(info->pid) || is_port_node_free(priv, info->pid))
+		return DP_FAILURE;
+
+	deq_port_stat = &priv->deq_port_stat[info->pid];
+	node_id = deq_port_stat->node_id;
+
 	DP_DEBUG(DP_DBG_FLAG_QOS, "%s cqm_deq:%d, qos_port:%d\n",
 		 __func__, info->pid, node_id);
 	if (dp_qos_port_conf_get(priv->qdev, node_id, &port_cfg)) {
 		pr_err("failed qos_port_conf_get_32\n");
 		return DP_FAILURE;
 	}
-	port_cfg.green_threshold = info->green_threshold;
-	port_cfg.yellow_threshold = info->yellow_threshold;
+
+	if (flag & DP_PORT_CFG_GREEN_THRESHOLD)
+		port_cfg.green_threshold = info->green_threshold;
+	if (flag & DP_PORT_CFG_YELLOW_THRESHOLD)
+		port_cfg.yellow_threshold = info->yellow_threshold;
+	if (flag & DP_PORT_CFG_EWSP)
+		port_cfg.enhanced_wsp = info->ewsp;
+
 	if (dp_qos_port_set(priv->qdev, node_id, &port_cfg)) {
 		pr_err("fail to set yellow:%d green:%d for node:%d\n",
 		       info->yellow_threshold, info->green_threshold, node_id);
diff --git a/include/net/datapath_api_qos.h b/include/net/datapath_api_qos.h
index 1e97fc79aa91..77713a8b86e1 100644
--- a/include/net/datapath_api_qos.h
+++ b/include/net/datapath_api_qos.h
@@ -1277,6 +1277,10 @@ struct dp_port_cfg_info {
 	int pid; /*!< [in] physical qos port id */
 	u32 green_threshold; /*!< [in] QoS port Egress green bytes threshold*/
 	u32 yellow_threshold; /*!< [in] QoS port Egress yellow bytes threshold*/
+	u32 ewsp; /*!< [in] Enhanced EWSP Operation */
+#define DP_PORT_CFG_GREEN_THRESHOLD	BIT(0) /*!< [in] config Green thresh */
+#define DP_PORT_CFG_YELLOW_THRESHOLD	BIT(1) /*!< [in] config Yellow thresh */
+#define DP_PORT_CFG_EWSP		BIT(2) /*!< [in] config EWSP */
 };
 
 /*!< API dp_qos_port_conf_set: Helps to retrieve global QoS
