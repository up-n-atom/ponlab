From 98ee91637fec45b361c65f5451ff6483bf85bfe3 Mon Sep 17 00:00:00 2001
From: Rekha Eswaran <rekha.eswaran@intel.com>
Date: Thu, 16 Jul 2020 11:21:45 +0800
Subject: [PATCH] DRV_DPM_SW-347 - DPM Klockwork warnings

---
 drivers/net/datapath/dpm/datapath_api.c             | 2 +-
 drivers/net/datapath/dpm/datapath_instance.c        | 2 +-
 drivers/net/datapath/dpm/datapath_misc.c            | 2 +-
 drivers/net/datapath/dpm/datapath_proc.c            | 2 --
 drivers/net/datapath/dpm/datapath_swdev.c           | 5 ++---
 drivers/net/datapath/dpm/gswip31/datapath_br_vlan.c | 4 ++++
 6 files changed, 9 insertions(+), 8 deletions(-)

diff --git a/drivers/net/datapath/dpm/datapath_api.c b/drivers/net/datapath/dpm/datapath_api.c
index d1df23202086..d7332c4dfe40 100644
--- a/drivers/net/datapath/dpm/datapath_api.c
+++ b/drivers/net/datapath/dpm/datapath_api.c
@@ -988,7 +988,7 @@ int32_t dp_update_subif_info(struct dp_subif_upd_info *info)
 	dp_subif_t *new_subif_id_sync, *old_subif_id_sync;
 	dp_get_netif_subifid_fn_t subifid_fn = NULL;
 	struct dp_subif_data old_data = {0}, new_data = {0};
-	int flags; /*to set CPU BP member */
+	int flags = 0; /*to set CPU BP member */
 
 	if (unlikely(!dp_init_ok)) {
 		pr_err("%s failed: datapath not initialized yet\n", __func__);
diff --git a/drivers/net/datapath/dpm/datapath_instance.c b/drivers/net/datapath/dpm/datapath_instance.c
index 1b160ee3a951..9a997f926144 100644
--- a/drivers/net/datapath/dpm/datapath_instance.c
+++ b/drivers/net/datapath/dpm/datapath_instance.c
@@ -774,7 +774,7 @@ int dp_inst_init(u32 flag)
 		return -ENOMEM;
 	cache_mod_list = kmem_cache_create("dp_mod_list", sizeof(struct dp_mod),
 					   0, SLAB_HWCACHE_ALIGN, NULL);
-	if (!cache_dev_list) {
+	if (!cache_mod_list) {
 		kmem_cache_destroy(cache_dev_list);
 		return -ENOMEM;
 	}
diff --git a/drivers/net/datapath/dpm/datapath_misc.c b/drivers/net/datapath/dpm/datapath_misc.c
index 3d1d9d05d6d7..ec350c2906ce 100644
--- a/drivers/net/datapath/dpm/datapath_misc.c
+++ b/drivers/net/datapath/dpm/datapath_misc.c
@@ -1293,7 +1293,7 @@ int dp_get_dma_ch_num(int inst, int ep, int num_deq_port)
 	int idx, i;
 	struct pmac_port_info *port_info = get_dp_port_info(inst, ep);
 	struct cqm_port_info *deq_pinfo;
-	u32 dma_ch_num = 0, dma_ch;
+	u32 dma_ch_num = 0, dma_ch = 0;
 
 	idx = port_info->deq_port_base;
 	for (i = 0; i < num_deq_port; i++) {
diff --git a/drivers/net/datapath/dpm/datapath_proc.c b/drivers/net/datapath/dpm/datapath_proc.c
index 73cabfb5fa0d..6de0e1ab4b46 100644
--- a/drivers/net/datapath/dpm/datapath_proc.c
+++ b/drivers/net/datapath/dpm/datapath_proc.c
@@ -125,8 +125,6 @@ static int proc_brvlan_dump(struct seq_file *s, int pos)
 		vlan_entry = 0;
 		list_for_each_entry(vlist_entry, &tmp->bport_vlan_list,
 				    list) {
-			if (bp_entry == 0)
-				seq_printf(s, "%-10s", "");
 			if (!vlist_entry->vlan_entry)
 				continue;
 			if (vlan_entry) {
diff --git a/drivers/net/datapath/dpm/datapath_swdev.c b/drivers/net/datapath/dpm/datapath_swdev.c
index 9a437b55b2e9..bbb698ffa13a 100644
--- a/drivers/net/datapath/dpm/datapath_swdev.c
+++ b/drivers/net/datapath/dpm/datapath_swdev.c
@@ -181,7 +181,6 @@ void dp_swdev_bridge_id_entry_free(void)
 	kmem_cache_destroy(cache_br_port_list);
 	kmem_cache_destroy(cache_br_entry_list);
 	kmem_cache_destroy(cache_br_info_list);
-	return DP_SUCCESS;
 }
 
 int dp_swdev_bridge_id_entry_init(void)
@@ -1158,7 +1157,7 @@ int dp_ndo_bridge_setlink(struct net_device *dev, struct nlmsghdr *nlh,
 	struct inst_info *dp_info = get_dp_prop_info(0);
 	int ret = 0;
 
-	if (!dev || !nlh || !dp_info || dp_info->dp_ndo_br_setlink)
+	if (!dev || !nlh || !dp_info || !dp_info->dp_ndo_br_setlink)
 		return -EINVAL;
 
 	DP_LIB_LOCK(&dp_lock);
@@ -1174,7 +1173,7 @@ int dp_ndo_bridge_dellink(struct net_device *dev, struct nlmsghdr *nlh,
 	struct inst_info *dp_info = get_dp_prop_info(0);
 	int ret = 0;
 
-	if (!dev || !nlh || !dp_info || dp_info->dp_ndo_br_dellink)
+	if (!dev || !nlh || !dp_info || !dp_info->dp_ndo_br_dellink)
 		return -EINVAL;
 
 	DP_LIB_LOCK(&dp_lock);
diff --git a/drivers/net/datapath/dpm/gswip31/datapath_br_vlan.c b/drivers/net/datapath/dpm/gswip31/datapath_br_vlan.c
index 6257e55a3002..de7ef5ee0d51 100644
--- a/drivers/net/datapath/dpm/gswip31/datapath_br_vlan.c
+++ b/drivers/net/datapath/dpm/gswip31/datapath_br_vlan.c
@@ -668,6 +668,8 @@ int dp_ndo_br_setlink(struct net_device *dev, struct nlmsghdr *nlh,
 	struct br_info *br_info;
 	int ret = 0;
 
+	if (!dev)
+		return -EOPNOTSUPP;
 	DP_DEBUG(DP_DBG_FLAG_BR_VLAN, "%s: dev=%s\n", __func__,
 		 dev ? dev->name : "NULL");
 
@@ -725,6 +727,8 @@ int dp_ndo_br_dellink(struct net_device *dev, struct nlmsghdr *nlh,
 	struct net_device *br_dev;
 	struct br_info *br_info;
 
+	if (!dev)
+		return -EOPNOTSUPP;
 	DP_DEBUG(DP_DBG_FLAG_BR_VLAN, "%s: dev=%s\n", __func__,
 		 dev ? dev->name : "NULL");
 
