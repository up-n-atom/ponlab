From 56cb9dfe8c6418a9aa6fed0074da4f52287d854e Mon Sep 17 00:00:00 2001
From: Shahed Shaikh <shahedx.shaikh@intel.com>
Date: Tue, 4 Aug 2020 15:53:23 +0800
Subject: [PATCH] DRV_DPM_SW-349: DPM PCE rule handling for meter rule

Signed-off-by: Shahed Shaikh <shahedx.shaikh@intel.com>
---
 drivers/net/datapath/dpm/gswip31/datapath_gswip.c | 46 ++++++++++++++---------
 include/net/datapath_api_qos.h                    |  2 -
 2 files changed, 29 insertions(+), 19 deletions(-)

diff --git a/drivers/net/datapath/dpm/gswip31/datapath_gswip.c b/drivers/net/datapath/dpm/gswip31/datapath_gswip.c
index 0b3b5634b0a6..02aaba3cd5e7 100644
--- a/drivers/net/datapath/dpm/gswip31/datapath_gswip.c
+++ b/drivers/net/datapath/dpm/gswip31/datapath_gswip.c
@@ -1110,6 +1110,21 @@ static int dp_set_col_mark(struct net_device *dev,
 	return 0;
 }
 
+struct dp_meter_pce_info {
+	struct dp_pce_blk_info pce_meter_blk;
+	int pce_index;
+};
+
+struct dp_meter_pce_info meter_pce_info = {
+		.pce_meter_blk = {
+			.info = {
+				.subblk_size = 1,
+				.subblk_name = "dp_action_meter_1",
+			},
+			.region = GSW_PCE_RULE_COMMMON,
+		},
+	};
+
 int dp_meter_add_31(struct net_device *dev,  struct dp_meter_cfg  *meter,
 		    int flag, struct dp_meter_subif *mtr_subif)
 {
@@ -1125,7 +1140,7 @@ int dp_meter_add_31(struct net_device *dev,  struct dp_meter_cfg  *meter,
 	GSW_CTP_portConfig_t *ctp_cfg = NULL;
 	GSW_BRIDGE_config_t *br_cfg = NULL;
 	GSW_return_t ret;
-	int bret = -1;
+	int bret = DP_FAILURE;
 
 	if (!mtr_subif) {
 		pr_err("mtr_subif NULL\n");
@@ -1173,17 +1188,16 @@ int dp_meter_add_31(struct net_device *dev,  struct dp_meter_cfg  *meter,
 		pce_rule = devm_kzalloc(&g_dp_dev->dev,
 					sizeof(GSW_PCE_rule_t), GFP_ATOMIC);
 		if (!pce_rule) {
-			pr_err("ctp_cfg alloc failed\n");
+			pr_err("pce_rule alloc failed\n");
 			goto err;
 		}
-		pce_rule->pattern.nIndex = meter->dp_pce.pce_idx;
-		pce_rule->pattern.bEnable = 1;
 		/* action setting */
 		pce_rule->action.eMeterAction = GSW_PCE_ACTION_METER_1;
 		pce_rule->action.nMeterId =  meter->meter_id;
-		ret = gsw_tflow->TFLOW_PceRuleWrite(gsw_handle, pce_rule);
-		if (ret != GSW_statusOk) {
-			pr_err("PceRule Write API failed :%d\n", ret);
+		meter_pce_info.pce_index = dp_pce_rule_add(&meter_pce_info.pce_meter_blk,
+										pce_rule);
+		if (meter_pce_info.pce_index == DP_FAILURE) {
+			pr_err("pce_rule add failed\n");
 			goto err;
 		}
 	}
@@ -1349,11 +1363,11 @@ int dp_meter_del_31(struct net_device *dev,  struct dp_meter_cfg  *meter,
 	struct brdgport_ops *gsw_bp;
 	struct brdg_ops *gsw_brdg;
 	GSW_BRIDGE_portConfig_t *bp_cfg = NULL;
-	GSW_PCE_rule_t *pce_rule = NULL;
+	GSW_PCE_ruleDelete_t *pce_rule = NULL;
 	GSW_CTP_portConfig_t *ctp_cfg = NULL;
 	GSW_BRIDGE_config_t *br_cfg = NULL;
 	GSW_return_t ret;
-	int bret = -1;
+	int bret = DP_FAILURE;
 
 	if (!mtr_subif) {
 		pr_err(" mtr_subif NULL\n");
@@ -1367,20 +1381,18 @@ int dp_meter_del_31(struct net_device *dev,  struct dp_meter_cfg  *meter,
 	gsw_bp = &gsw_handle->gsw_brdgport_ops;
 	gsw_brdg = &gsw_handle->gsw_brdg_ops;
 	if (meter->dir & DP_METER_ATTACH_PCE) {
-		pce_rule = devm_kzalloc(&g_dp_dev->dev, sizeof(GSW_PCE_rule_t),
+		pce_rule = devm_kzalloc(&g_dp_dev->dev, sizeof(GSW_PCE_ruleDelete_t),
 					GFP_ATOMIC);
 		if (!pce_rule) {
 			pr_err("pce_rule alloc failed\n");
-			bret = -1;
+			bret = DP_FAILURE;
 			goto err;
 		}
 		/* pattern setting */
-		pce_rule->pattern.nIndex = meter->dp_pce.pce_idx;
-		pce_rule->pattern.bEnable = 0;
-		ret = gsw_tflow->TFLOW_PceRuleWrite(gsw_handle, pce_rule);
-		if (ret != GSW_statusOk) {
-			pr_err("PceRule Write API failed :%d\n", ret);
-			bret = -1;
+		pce_rule->nIndex = meter_pce_info.pce_index;
+		bret = dp_pce_rule_del(&meter_pce_info.pce_meter_blk, pce_rule);
+		if (bret != DP_SUCCESS) {
+			pr_err("pce_rule delete failed\n");
 			goto err;
 		}
 	}
diff --git a/include/net/datapath_api_qos.h b/include/net/datapath_api_qos.h
index fcc763765791..6b9ddf160856 100644
--- a/include/net/datapath_api_qos.h
+++ b/include/net/datapath_api_qos.h
@@ -1173,8 +1173,6 @@ struct dp_meter_cfg {
 	 /*!< traffic flow type for bridge/PCE rule mode only */
 	union dp_pce {
 		enum dp_meter_traffic_type flow;
-		/*!< PCE table rule index */
-		u32 pce_idx;
 	} dp_pce;
 };
 
