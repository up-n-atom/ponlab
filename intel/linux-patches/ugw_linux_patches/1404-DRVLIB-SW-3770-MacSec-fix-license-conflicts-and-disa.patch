From db615ab3366ccfd30cbd0db35acd6c16078b460f Mon Sep 17 00:00:00 2001
From: Xu Liang <liang.xu@intel.com>
Date: Mon, 14 Sep 2020 21:52:48 +0800
Subject: [PATCH] DRVLIB_SW-3770: MacSec - fix license conflicts and disable
 debug message by default

---
 drivers/net/ethernet/lantiq/e160/macsec.c               | 1 -
 drivers/net/ethernet/lantiq/e160/macsec_genl_ops.c      | 1 -
 drivers/net/ethernet/lantiq/switch-api/mac/macsec_drv.c | 4 ++--
 drivers/net/ethernet/lantiq/switch-api/mac/macsec_drv.h | 2 +-
 4 files changed, 3 insertions(+), 5 deletions(-)

diff --git a/drivers/net/ethernet/lantiq/e160/macsec.c b/drivers/net/ethernet/lantiq/e160/macsec.c
index d88fb89de160..321c4b7d28cf 100644
--- a/drivers/net/ethernet/lantiq/e160/macsec.c
+++ b/drivers/net/ethernet/lantiq/e160/macsec.c
@@ -5,7 +5,6 @@
  * Copyright 2019 - 2020 Intel Corporation
  */
 
-#define DEBUG
 #include <linux/kernel.h>
 #include <linux/module.h>
 #include <linux/slab.h>
diff --git a/drivers/net/ethernet/lantiq/e160/macsec_genl_ops.c b/drivers/net/ethernet/lantiq/e160/macsec_genl_ops.c
index dc54f75622cd..14ddb7b3a880 100644
--- a/drivers/net/ethernet/lantiq/e160/macsec_genl_ops.c
+++ b/drivers/net/ethernet/lantiq/e160/macsec_genl_ops.c
@@ -5,7 +5,6 @@
  * Copyright 2019 - 2020 Intel Corporation
  */
 
-#define DEBUG
 #include <linux/kernel.h>
 #include <linux/module.h>
 #include <net/rtnetlink.h>
diff --git a/drivers/net/ethernet/lantiq/switch-api/mac/macsec_drv.c b/drivers/net/ethernet/lantiq/switch-api/mac/macsec_drv.c
index fe4d9d91d356..eb38d73ed61b 100644
--- a/drivers/net/ethernet/lantiq/switch-api/mac/macsec_drv.c
+++ b/drivers/net/ethernet/lantiq/switch-api/mac/macsec_drv.c
@@ -1,4 +1,4 @@
-// SPDX-License-Identifier: (BSD-3-Clause OR GPL-2.0-only)
+// SPDX-License-Identifier: GPL-2.0
 /*
  * Driver for MACsec Engine inside Intel CHD GSWIP
  *
@@ -90,7 +90,7 @@ static int e160_macsec_probe(struct platform_device *pdev)
 		return -ENODEV;
 	}
 
-	dev_info(dev, "EIP160 %d: Initialized!!\n", pdata->devid);
+	dev_dbg(dev, "EIP160 %d: Initialized!!\n", pdata->devid);
 
 	return 0;
 }
diff --git a/drivers/net/ethernet/lantiq/switch-api/mac/macsec_drv.h b/drivers/net/ethernet/lantiq/switch-api/mac/macsec_drv.h
index 82090a7c2e69..c26b90def5b8 100644
--- a/drivers/net/ethernet/lantiq/switch-api/mac/macsec_drv.h
+++ b/drivers/net/ethernet/lantiq/switch-api/mac/macsec_drv.h
@@ -1,4 +1,4 @@
-// SPDX-License-Identifier: (BSD-3-Clause OR GPL-2.0-only)
+// SPDX-License-Identifier: GPL-2.0
 /*
  * Driver for MACsec Engine inside Intel CHD GSWIP
  *
