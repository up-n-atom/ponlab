diff --git a/drivers/net/ppv4/pp-hal/parser/parser.c b/drivers/net/ppv4/pp-hal/parser/parser.c
index 4d48eef47342..2238e6ea1809 100644
--- a/drivers/net/ppv4/pp-hal/parser/parser.c
+++ b/drivers/net/ppv4/pp-hal/parser/parser.c
@@ -2722,8 +2722,10 @@ s32 prsr_up_layer_proto_pre_proto_add(enum prsr_proto_id id,
 	struct proto_db_e *proto;
 	char name[PRSR_MAX_NAME];
 	u16 i, idx;
-	s32 ret, n;
-
+	s32 ret;
+#ifdef CONFIG_DEBUG_FS
+	s32 n;
+#endif
 	pr_debug("id %u, pre %p, pre_n %u\n", id, pre, pre_n);
 
 	proto = __get_proto(id);
@@ -2744,8 +2746,12 @@ s32 prsr_up_layer_proto_pre_proto_add(enum prsr_proto_id id,
 		// add next protocol select entry
 		np_e.imem_idx = proto->imem_idx;
 		np_e.key = PRSR_NP_SEL_KEY_BUILD(pre[i].val, pre[i].np_logic);
