From dec145fdcfa97ac4528a249d8c2351b7ac61c569 Mon Sep 17 00:00:00 2001
From: "Vishnu Swaroop Kumar Sarma, Duddu" <duddu.swaroop@intel.com>
Date: Mon, 20 Apr 2020 11:02:31 +0530
Subject: [PATCH] UGW_SW-49843 array out of bounds fix in gphy reset api

---
 drivers/net/ethernet/lantiq/xrx500_phy_fw.c | 13 ++++++-------
 1 file changed, 6 insertions(+), 7 deletions(-)

diff --git a/drivers/net/ethernet/lantiq/xrx500_phy_fw.c b/drivers/net/ethernet/lantiq/xrx500_phy_fw.c
index d45f6853d5a3..806ea8fb48e8 100644
--- a/drivers/net/ethernet/lantiq/xrx500_phy_fw.c
+++ b/drivers/net/ethernet/lantiq/xrx500_phy_fw.c
@@ -218,13 +218,12 @@ static void xrx500_gphy_reset(u32 phy_id)
 {
 	struct xrx500_reset_control *rst = &xrx500_rst;
 
-	if (phy_id >= XRX500_GPHY_NUM && !rst->phy[phy_id])
-		return;
-
-	reset_control_assert(rst->phy[phy_id]);
-	udelay(1);
-	reset_control_deassert(rst->phy[phy_id]);
-	pr_info("Reset GPHY%u for GRX500\n", phy_id);
+	if (phy_id < XRX500_GPHY_NUM && rst->phy[phy_id] != NULL) {
+		reset_control_assert(rst->phy[phy_id]);
+		udelay(1);
+		reset_control_deassert(rst->phy[phy_id]);
+		pr_info("Reset GPHY%u for GRX500\n", phy_id);
+	}
 }
 
 /* prx300 rcal/rc_count value calculation.
