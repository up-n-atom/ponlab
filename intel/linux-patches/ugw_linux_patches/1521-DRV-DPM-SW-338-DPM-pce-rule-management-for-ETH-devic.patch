+/* Remove PCE BLK for CTP region and delete pce rule */
+static int dp_delete_pce(int pceidx, struct dp_pce_blk_info *blk_info)
+{
+	GSW_PCE_ruleDelete_t pce_del;
+
+	pce_del.logicalportid = blk_info->info.portid;
+	pce_del.subifidgroup = blk_info->info.subif;
+	pce_del.region = blk_info->region;
+	pce_del.nIndex = pceidx;
+
+	dp_pce_rule_del_priv(blk_info, &pce_del);
+
+	return 0;
+}
+
+/* Alloc PCE BLK for CTP region and create a new pce rule */
+static int dp_add_new_pce(struct br_info *br_info,
+			  struct vlan_entry *ventry,
+			  struct bridge_member_port *bmp)
+{
+	GSW_PCE_rule_t *pce_rule;
+	struct dp_subblk_info *blk_info;
+	dp_subif_t subif;
+	u32 flag;
+	int idx = 0;
+
+	if (!bmp->blk_info) {
+		pr_err("%s: pce_blk %x info not present\n",
+		       __func__, (u32)bmp->blk_info);
+		return -1;
+	}
+	
+	if (dp_get_netif_subifid(bmp->dev, NULL, NULL, NULL, &subif, 0)) {
+		pr_err("%s: dp_get_netif_subifid failed\n", __func__);
+		return DP_FAILURE;
+	}
+
+	pce_rule = kzalloc(sizeof(*pce_rule), GFP_ATOMIC);
+	if (!pce_rule)
+		return -1;
+
+	blk_info = &bmp->blk_info->info;
+	/* TODO-Update subif group */
+	if (!blk_info->subif)
+		blk_info->subif = subif.subif;
+	if (!blk_info->subblk_size)
+		blk_info->subblk_size = VLAN_PCE_MAX_SUBBLK_SIZE;
+	if (!blk_info->portid)
+		blk_info->portid = subif.port_id;
+	if (!strlen(blk_info->subblk_name)) {
+		strncpy(blk_info->subblk_name, "dp_br_vlan",
+			sizeof(blk_info->subblk_name) - 1);
+	}
+	bmp->blk_info->region = GSW_PCE_RULE_CTP;
+
+	pce_rule->logicalportid = subif.port_id;
+	pce_rule->subifidgroup = subif.subif_groupid;
+
+	/* pce_rule pattern setting */
+	pce_rule->region = GSW_PCE_RULE_CTP;
+	pce_rule->pattern.bEnable = 1;
+	pce_rule->pattern.bSubIfIdEnable = 1;
+	pce_rule->pattern.eSubIfIdType = GSW_PCE_SUBIFID_TYPE_BRIDGEPORT;
+	pce_rule->pattern.nSubIfId = bmp->bportid;
+	pce_rule->pattern.bSLAN_Vid = 1;
+	pce_rule->pattern.nSLAN_Vid = ventry->vlan_id;
+
+	/* action setting */
+	pce_rule->action.bFidEnable = 1;
+	pce_rule->action.nFId = ventry->fid;
+
+	idx = dp_pce_rule_add_priv(bmp->blk_info, pce_rule);
+	kfree(pce_rule);
+	return idx;
+}
+
+/* Delete pce entry from bridge port list
+ * pce_dis = 1 -> Disable the PCE index
+ * pce_dis = 0 -> Delete the PCE rule and remove from BP list
+ */
+static int dp_del_pce_entry_from_bp_list(struct vlan_entry *ventry,
+		struct bridge_member_port *bmp, int pce_dis)
+{
+	struct pce_entry *pce_entry = NULL;
+
+	pce_entry = get_vlan_pce_entry_in_bp(ventry, bmp);
+	if (!pce_entry) {
+		pr_err("%s: Cannot find vlanid %d in Bp %d\n", __func__,
+		       ventry->vlan_id, bmp->bportid);
+		return -1;
+	}
+
+	if (!pce_dis) {
+		DP_DEBUG(DP_DBG_FLAG_BR_VLAN,
+			 "%s: delete pce idx(%d) for vid:%d\n",
+			 __func__, pce_entry->idx, pce_entry->vid);
+		dp_delete_pce(pce_entry->idx, bmp->blk_info);
+		list_del(&pce_entry->plist);
+		kfree(pce_entry);
+	} else {
+		DP_DEBUG(DP_DBG_FLAG_BR_VLAN,
+			 "%s: disable pce idx(%d) for vid:%d\n",
+			 __func__, pce_entry->idx, pce_entry->vid);
+		dp_update_pce_rule(pce_entry->idx, bmp->blk_info, pce_dis);
+		pce_entry->disable = pce_dis;
+	}
+	return 0;
+}
+
+/* Delete a pce rule, If vlan FID is deleted */
+static int dp_del_vlan_pce_rule(struct vlan_entry *ventry,
+				struct br_info *br_info, int bport,
+				int pce_dis)
+{
+	struct bridge_member_port *bmp = NULL;
+	int ret = DP_SUCCESS;
+	struct vlist_entry *list_entry;
+
+	/* check if vlan id present in bridge port ventry list */
+	list_for_each_entry(bmp, &br_info->bp_list, list) {
+		list_for_each_entry(list_entry, &bmp->bport_vlan_list, list) {
+			if (ventry->vlan_id != list_entry->vlan_entry->vlan_id)
+				continue;
+			ret = dp_del_pce_entry_from_bp_list(ventry,
+							    bmp,
+							    pce_dis);
+			break;
+		}
+	}
+	return ret;
+}
+
+/* Add pce entry to the bridge port list */
+static int dp_add_pce_entry_to_bp_list(struct vlan_entry *ventry,
+				       struct br_info *br_info,
+				       struct bridge_member_port *bmp)
+{
+	struct pce_entry *pce = NULL;
+
+	pce = kzalloc(sizeof(*pce), GFP_ATOMIC);
+	if (!pce)
+		return -1;
+
+	pce->idx = dp_add_new_pce(br_info, ventry, bmp);
+	if (pce->idx < 0) {
+		pr_err("%s: dp_add_new_pce for Vlan %d Bport %d failed\n",
+		       __func__, ventry->vlan_id, bmp->bportid);
+		return -1;
+	}
+
+	pce->vid = ventry->vlan_id;
+
+	/* Mark this PCE rule is enabled/disabled */
+	if (ventry->fid)
+		pce->disable = 0;
+	else
+		pce->disable = 1;
+	list_add(&pce->plist, &bmp->pce_list);
+
+	DP_DEBUG(DP_DBG_FLAG_BR_VLAN, "%s: In vlan_id %d added(%s)\n",
+		 __func__, ventry->vlan_id,
+		 pce->disable ? "Disable" : "Enable");
+	return 0;
+}
+
+/* Add a new pce rule, If new vlan FID is created
+ * If PCE index exists already for a BP, Enable the previously added rule index
+ */
+static int dp_add_vlan_pce_rule(struct vlan_entry *ventry,
+				struct br_info *br_info, int bport)
+{
+	int ret = DP_SUCCESS;
+	struct pce_entry *pce_entry = NULL;
+	struct bridge_member_port *bmp = NULL;
+	struct vlist_entry *list_entry = NULL;
+
+	/* Go through all the Bridge Port members
+	 * check if vlan id present in bridge port ventry list
+	 */
+	list_for_each_entry(bmp, &br_info->bp_list, list) {
+		list_for_each_entry(list_entry, &bmp->bport_vlan_list, list) {
+			if (ventry->vlan_id != list_entry->vlan_entry->vlan_id)
+				continue;
+
+			/* First time when PCE list is empty */
+			if (list_empty(&bmp->pce_list))
+				goto ADD_NEW_PCE_RULE;
+
+			/* VLAN entry is there but no PCE rule yet, add it */
+			pce_entry = get_vlan_pce_entry_in_bp(ventry, bmp);
+			if (!pce_entry)
+				goto ADD_NEW_PCE_RULE;
+
+			/* Vlan Entry + PCE rule present, but rule disabled */
+			if (pce_entry->disable) {
+				DP_DEBUG(DP_DBG_FLAG_BR_VLAN,
+					 "%s: %s Bport %d vlanid %d\n",
+					 __func__,
+					 "Enabling PCE rule for",
+					 bmp->bportid,
+					 ventry->vlan_id);
+				dp_update_pce_rule(pce_entry->idx,
+						   bmp->blk_info,
+						   0);
+				pce_entry->disable = 0;
+			}
+			continue;
+			
+ADD_NEW_PCE_RULE:
+			DP_DEBUG(DP_DBG_FLAG_BR_VLAN,
+				 "%s: Creating PCE rule Bport %d vlanid %d\n",
+				 __func__,
+				 bmp->bportid,
+				 ventry->vlan_id);
+
+			/* It's a new pce rule for this bridge port add it */
+			if (dp_add_pce_entry_to_bp_list(list_entry->vlan_entry,
+							br_info, bmp))
+				return DP_FAILURE;
+		}
+	}
+	return ret;
+}
+
