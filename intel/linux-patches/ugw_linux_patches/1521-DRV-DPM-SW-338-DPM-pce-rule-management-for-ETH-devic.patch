+/* Update current PCE rule index with enable/disable */
+int dp_update_pce_rule(int pceidx, struct dp_pce_blk_info *blk_info,
+		       int pce_dis)
+{
+	GSW_PCE_rule_t pce;
+	struct core_ops *ops;
+
+	ops = gsw_get_swcore_ops(0);
+	if (!ops)
+		return -1;
+
+	pce.logicalportid = blk_info->info.portid;
+	pce.subifidgroup = blk_info->info.subif;
+	pce.region = blk_info->region;
+	dp_pce_rule_get_priv(blk_info, &pce);
+	DP_DEBUG(DP_DBG_FLAG_PCE, "%s:region:%d index:%d\n",
+		 __func__, pce.region, pce.pattern.nIndex);
+
+	/* PCE struct is reset except for index after calling pce get */
+	pce.logicalportid = blk_info->info.portid;
+	pce.subifidgroup = blk_info->info.subif;
+	pce.region = blk_info->region;
+	if (pce_dis)
+		pce.pattern.bEnable = 0;
+	else
+		pce.pattern.bEnable = 1;
+	pce.pattern.nIndex = pceidx;
+	if (ops->gsw_tflow_ops.TFLOW_PceRuleWrite(ops, &pce)) {
