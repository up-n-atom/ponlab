+	struct ctp_dev *tmp;
+	struct bp_pmapper *bp_info;
+
+	if (!capable(CAP_SYS_PACCT))
+		return count;
+	len = (sizeof(str) > count) ? count : sizeof(str) - 1;
+	len -= copy_from_user(str, buf, len);
+	str[len] = 0;
+	num = dp_split_buffer(str, param_list, ARRAY_SIZE(param_list));
+
+	if (num <= 1)
+		goto help;
+	if (param_list[1])
+		bp = dp_atoi(param_list[1]);
+
+	if (strcasecmp(param_list[0], "bp_ctp") == 0) {
+		bp_info = get_dp_bp_info(0, bp);
+		if (!bp_info)
+			pr_info("bp:%d info not found\n", bp);
+		pr_info("%-10s%-10d\n", "Bp", bp);
+		list_for_each_entry(tmp, &bp_info->ctp_dev, list) {
+			if(!tmp->dev)
+				break;
+			pr_info("%-s:%-s(%-s:%-d)\n", "ctp_dev",
+				tmp->dev->name, "ctp", tmp->ctp);
+		}
+	} else {
+		goto help;
+	}
+
+	return count;
+help:
+	pr_info("usage:\n");
+	pr_info("  echo bp_ctp [bp] > %s\n", DBG_CTP);
+	return count;
+
+}
