+/* Get PCE Entry base on VLAN from a Bridge port */
+static
+struct pce_entry *get_vlan_pce_entry_in_bp(struct vlan_entry *ventry,
+		struct bridge_member_port *bmp)
+{
+	struct pce_entry *pce_entry = NULL;
+
