+		       __func__, pce.pattern.nIndex);
+		return -1;
+	}
+	DP_DEBUG(DP_DBG_FLAG_PCE, "%s:%s for pce idx(%d)\n",
+		 __func__,
+		 (pce.pattern.bEnable) ? "Enabled" : "Disabled",
+		 pce.pattern.nIndex);
+
+	return 0;
