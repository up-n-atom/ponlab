+static int proc_vlanpce_start(void)
+{
+	br_hash_index = 0;
+	brdev_info = hlist_entry_safe
+		     ((get_dp_g_bridge_id_entry_hash_table_info(
+				     br_hash_index))->first,
+		      struct br_info, br_hlist);
+	return 0;
+}
+
+static int proc_vlanpce_dump(struct seq_file *s, int pos)
+{
+	struct pce_entry *pce = NULL;
+	struct bridge_member_port *tmp = NULL;
+	int pce_entry = 0, bp_entry = 0, i = 0;
+
+	while (!brdev_info) {
+		br_hash_index++;
+		pos = 0;
+		if (br_hash_index == BR_ID_ENTRY_HASH_TABLE_SIZE) {
+			seq_puts(s, "end\n");
+			return -1;
+		}
+		brdev_info = hlist_entry_safe
+			     ((get_dp_g_bridge_id_entry_hash_table_info(
+					     br_hash_index))->first,
+			      struct br_info, br_hlist);
+	}
+	if (!brdev_info->br_vlan_en)
+		goto EXIT;
+
+	if (pos == 0) {
+		seq_printf(s, "%-10s%-18s\n",
+			   "BP", "VLAN/PCEIDX/STATUS");
+		for (i = 0; i < 25; i++)
+			seq_printf(s, "=");
+		seq_printf(s, "\n");
+	}
+
+	bp_entry = 0;
+	list_for_each_entry(tmp, &brdev_info->bp_list, list) {
+		if (bp_entry) {
+			seq_printf(s, "\n");
+			seq_printf(s, "%-10s%-18s\n", "", "");
+		}
+		seq_printf(s, "%-10d", tmp->bportid);
+		bp_entry = 1;
+		pce_entry = 0;
+		list_for_each_entry(pce, &tmp->pce_list, plist) {
+			if (pce_entry) {
+				seq_printf(s, "\n");
+				seq_printf(s, "%-10s", "");
+			}
+			seq_printf(s, "%-4d/%-4d/%-4s",
+				   pce->vid, pce->idx,
+				   (pce->disable ? "Disabled" : "Enable"));
+			pce_entry = 1;
+		}
+	}
+	seq_puts(s, "\n");
+
+EXIT:
+	brdev_info = hlist_entry_safe((brdev_info)->br_hlist.next,
+				      struct br_info, br_hlist);
+	if (!seq_has_overflowed(s))
+		pos++;
+	return pos;
+}
 #endif
 
