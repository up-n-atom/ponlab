From 26e69c7fab7b8279c029372b24fa04c0924c1cfc Mon Sep 17 00:00:00 2001
From: Oren Bakshe <oren.bakshe@intel.com>
Date: Thu, 2 Jan 2020 12:13:10 +0200
Subject: [PATCH] PONRTSYS-6513: Increase max session from 32k to 64k

---
 drivers/net/ppv4/pp-hal/classifier/classifier.c | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/drivers/net/ppv4/pp-hal/classifier/classifier.c b/drivers/net/ppv4/pp-hal/classifier/classifier.c
index 5114510d7348..54dd20518121 100644
--- a/drivers/net/ppv4/pp-hal/classifier/classifier.c
+++ b/drivers/net/ppv4/pp-hal/classifier/classifier.c
@@ -3,7 +3,7 @@
  * Description: PP Classifier Driver
  *
  * SPDX-License-Identifier: GPL-2.0-only
- * Copyright (C) 2018-2019 Intel Corporation
+ * Copyright (C) 2018-2020 Intel Corporation
  */
 #include <linux/types.h>
 #include <linux/init.h>
@@ -359,12 +359,12 @@ s32 cls_sess_cache_stats_get(u64 *read_trans, u64 *read_hits)
 	if (unlikely(ptr_is_null(read_trans) || ptr_is_null(read_hits)))
 		return -EINVAL;
 
-	l = PP_REG_RD32(PP_SESS_CACHE_READ_TRANS_CNT_L_REG);
 	h = PP_REG_RD32(PP_SESS_CACHE_READ_TRANS_CNT_H_REG);
+	l = PP_REG_RD32(PP_SESS_CACHE_READ_TRANS_CNT_L_REG);
 	*read_trans = PP_BUILD_64BIT_WORD(l, h);
 
-	l = PP_REG_RD32(PP_SESS_CACHE_READ_HIT_TRANS_CNT_L_REG);
 	h = PP_REG_RD32(PP_SESS_CACHE_READ_HIT_TRANS_CNT_H_REG);
+	l = PP_REG_RD32(PP_SESS_CACHE_READ_HIT_TRANS_CNT_L_REG);
 	*read_hits = PP_BUILD_64BIT_WORD(l, h);
 
 	return 0;
@@ -1187,7 +1187,7 @@ s32 __cls_ddr_allocate(void)
 	return 0;
 #else
 	db->si_sz =
-		PAGE_ALIGN((db->num_sessions >> 1) * sizeof(struct pp_hw_si));
+		PAGE_ALIGN((db->num_sessions) * sizeof(struct pp_hw_si));
 	db->si_base_virt = dma_zalloc_coherent(NULL, db->si_sz,
 					       &db->si_base_phys,
 					       GFP_KERNEL);
