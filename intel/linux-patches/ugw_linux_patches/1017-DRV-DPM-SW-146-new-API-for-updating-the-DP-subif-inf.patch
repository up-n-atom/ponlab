+int deq_update_info(struct dp_subif_upd_info *info)
+{
+	int old_cqm_deq_idx, old_num_cqm_deq, old_def_qid, old_cqm_deq_port;
+	int new_cqm_deq_idx, new_num_cqm_deq, new_def_qid, i;
+	static cbm_queue_map_entry_t lookup = {0};
+	u32 lookup_f;
+	struct cqm_port_info *old_deq_pinfo, *new_deq_pinfo;
+	int inst, subif_ix, f_clear_dq_info = 0;
+	u32 dma_ch_offset, dma_ch_ref;
+	struct dp_node_alloc node;
+	struct ppv4_q_sch_port q_port = {0};
+	struct q_info *q_info;
+	struct cbm_dp_en_data cbm_data = {0};
+	struct dp_subif_info *sif;
+	struct pmac_port_info *port_info;
+
+	port_info = get_dp_port_info(info->inst, info->dp_port);
+	subif_ix = GET_VAP(info->subif, port_info->vap_offset,
+			   port_info->vap_mask);
+	sif = get_dp_port_subif(port_info, subif_ix);
+	old_cqm_deq_idx = sif->cqm_port_idx;
+	old_num_cqm_deq = port_info->deq_port_num; //sif-> num_of qid
+	new_cqm_deq_idx = info->new_cqm_deq_idx;
+	new_num_cqm_deq = info->new_num_cqm_deq;
+	inst = info->inst;
+
+	if ((!info) && (!sif) && (!port_info))
+		return DP_FAILURE;
+	/* no need any queue modification */
+	if (old_cqm_deq_idx == new_cqm_deq_idx)
+		return DP_SUCCESS;
+	/* update new deq info */
+	for (i = 0; i < info->new_num_cqm_deq; i++) {
+		int cqe_deq;
+		lookup_f = CBM_QUEUE_MAP_F_FLOWID_L_DONTCARE |
+			   CBM_QUEUE_MAP_F_FLOWID_H_DONTCARE |
+			   CBM_QUEUE_MAP_F_EN_DONTCARE |
+			   CBM_QUEUE_MAP_F_DE_DONTCARE |
+			   CBM_QUEUE_MAP_F_MPE1_DONTCARE |
+			   CBM_QUEUE_MAP_F_MPE2_DONTCARE |
+			   CBM_QUEUE_MAP_F_TC_DONTCARE;
+		q_port.cqe_deq = port_info->deq_port_base + new_cqm_deq_idx + i;
+		cqe_deq = q_port.cqe_deq;
+
+		new_deq_pinfo = get_dp_deqport_info(inst, cqe_deq);
+		if (new_deq_pinfo->ref_cnt == 0) {
+			q_port.inst = inst;
+			q_port.dp_port = info->dp_port;
+			q_port.ctp = subif_ix;
+			if (alloc_q_to_port(&q_port, 0)) {
+				pr_err("%s fail for dp_port=%d\n",
+				       "alloc_q_to_port", q_port.dp_port);
+				return -1;
+			}
+			q_info = get_dp_q_info(inst, q_port.qid);
+
+			if (q_info->flag) {
+				pr_err("Why dp_q_tbl[%d][%d].flag =%d%s?\n",
+				       inst, q_port.qid,
+				       q_info->flag,
+				       ":expect 0");
+				return -1;
+			}
+			if (q_info->ref_cnt) {
+				pr_err("Why dp_q_tbl[%d][%d].ref_cnt =%d%s?\n",
+				       inst, q_port.qid,
+				       q_info->ref_cnt,
+				       ":expect 0");
+				return -1;
+			}
+			/* update queue table */
+			q_info->flag = 1;
+			q_info->need_free = 1;
+			q_info->ref_cnt = 1;
+			q_info->q_node_id = q_port.q_node;
+			q_info->cqm_dequeue_port = q_port.cqe_deq;
+			new_def_qid = q_port.qid;
+			if (!new_deq_pinfo->f_first_qid) {
+				new_deq_pinfo->first_qid = q_port.qid;
+				new_deq_pinfo->f_first_qid = 1;
+			}
+			/* update port table */
+			new_deq_pinfo->ref_cnt++;
+			f_clear_dq_info = 1;
+		} else {
+			new_def_qid = new_deq_pinfo->first_qid;
+		}
+		DP_DEBUG(DP_DBG_FLAG_REG,
+			 "%s:%s=%d %s=%d q[%d].cnt=%d cqm_p[%d].cnt=%d\n",
+			 "dp_deq_update_info",
+			 "dp_port", info->dp_port,
+			 "vap", subif_ix,
+			 q_port.qid, get_dp_q_info(inst, q_port.qid)->ref_cnt,
+			 q_port.cqe_deq,
+			 new_deq_pinfo->ref_cnt);
+		/* update subif table with new info*/
+		sif->qid_list[i] = new_def_qid;
+		sif->q_node[i] = q_port.q_node;
+		sif->qos_deq_port[i] = q_port.port_node;
+		sif->cqm_deq_port[i] = q_port.cqe_deq;
+		sif->cqm_port_idx = new_cqm_deq_idx;
+		port_info->subif_info[subif_ix].cqm_port_idx = new_cqm_deq_idx;
+		/* Map this port's lookup to its 1st queue only */
+		lookup.ep = info->dp_port;
+
+		cbm_queue_map_set(dp_port_prop[inst].cbm_inst, q_port.qid,
+				  &lookup, lookup_f);
+		DP_DEBUG(DP_DBG_FLAG_REG,
+			 "%s %s=%d %s=%d %s=%d %s=%d %s=0x%x %s=0x%x(%d)\n",
+			 "cbm_queue_map_set",
+			 "qid", new_def_qid, "for dp_port", lookup.ep,
+			 "num_subif", port_info->num_subif,
+			 "lu_mode", port_info->cqe_lu_mode, "flag", lookup_f,
+			 "subif", info->subif, subif_ix); //Later check subif,qid print
+	}
+	if (!f_clear_dq_info)
+		return DP_SUCCESS;
+	/* remove old deq port info */
+	for (i = 0; i < old_num_cqm_deq; i++) {
+		old_cqm_deq_port = port_info->deq_port_base + old_cqm_deq_idx + i;
+		old_deq_pinfo = get_dp_deqport_info(inst, old_cqm_deq_port);
+		/* retrieve the qid corresponding to old deq port */
+		old_def_qid = old_deq_pinfo->first_qid;
+		q_info = get_dp_q_info(inst, old_def_qid);
+		q_info->ref_cnt--;
+		old_deq_pinfo->ref_cnt--;
+		if (q_info->flag && !q_info->ref_cnt && q_info->need_free) {
+			DP_DEBUG(DP_DBG_FLAG_QOS, "Free qid %d\n", old_def_qid); //check print
+			node.id.q_id = old_def_qid;
+			/* if no subif using this queue, need to delete it */
+			node.inst = inst;
+			node.dp_port = info->dp_port;
+			node.type = DP_NODE_QUEUE;
+			dp_node_free(&node, 0);
+
+			/* update dp_q_tbl */
+			q_info->flag = 0;
+			q_info->need_free = 0;
+			if (old_deq_pinfo->f_first_qid) {
+				old_deq_pinfo->f_first_qid = 0;
+				old_deq_pinfo->first_qid = 0;
+				DP_DEBUG(DP_DBG_FLAG_QOS, "q_id[%d] is freed\n",
+					 old_def_qid);
+				DP_DEBUG(DP_DBG_FLAG_QOS,
+					 "dp_deq_port_tbl[%d][%d].f_first_qid reset\n",
+					 inst, old_cqm_deq_port);
+			}
+		}
+		dma_ch_offset =	old_deq_pinfo->dma_ch_offset;
+		dma_ch_ref = atomic_read(&(dp_dma_chan_tbl[inst] +
+					   dma_ch_offset)->ref_cnt);
+
+		/* Disable old dq port in CQM */
+		if (!dma_ch_ref)
+			cbm_data.dma_chnl_init = 1;
+		if (cbm_dp_enable(port_info->owner, info->dp_port, &cbm_data,
+				  CBM_PORT_F_DISABLE,
+				  port_info->alloc_flags)) { //Later check owner field
+			return DP_FAILURE;
+		}
+	}
+	return DP_SUCCESS;
+}
