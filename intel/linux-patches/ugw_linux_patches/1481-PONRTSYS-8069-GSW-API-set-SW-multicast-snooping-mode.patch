From 11db5f929cfbcb222e845b1702f20bda84a22eb4 Mon Sep 17 00:00:00 2001
From: Xu Liang <liang.xu@intel.com>
Date: Fri, 6 Nov 2020 13:11:20 +0800
Subject: [PATCH] PONRTSYS-8069: GSW API - set SW multicast snooping mode by
 default if HW snooping is not supported

---
 drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c | 13 +++++++++++--
 1 file changed, 11 insertions(+), 2 deletions(-)

diff --git a/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c b/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c
index fc3a34a0d2d3..a29dac8df592 100644
--- a/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c
+++ b/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c
@@ -2658,7 +2658,7 @@ static void get_gsw_hw_cap(void *cdev)
 	}
 
 	/*Applicable only for 3.1*/
-	if (gswdev->gipver >= LTQ_GSWIP_3_1) {
+	if (VRSN_CMP(gswdev->gipver, LTQ_GSWIP_3_1) >= 0) {
 		gsw_r32(cdev, ETHSW_CAP_16_VLANMAP_OFFSET,
 			ETHSW_CAP_16_VLANMAP_SHIFT,
 			ETHSW_CAP_16_VLANMAP_SIZE, &reg_val);
@@ -2690,6 +2690,8 @@ static void get_gsw_hw_cap(void *cdev)
 			ETHSW_CAP_18_CTP_SHIFT,
 			ETHSW_CAP_18_CTP_SIZE, &reg_val);
 		gswdev->num_of_ctp = (reg_val & 0xFFFF);
+	} else {
+		gswdev->mcsthw_snoop = MCAST_HWSNOOP_EN;
 	}
 
 	/*load PCE parameters*/
@@ -3587,6 +3589,12 @@ void *ethsw_api_core_init(ethsw_core_init_t *ethcinit)
 	gsw_w32(cdev, PCE_OVERHD_OVERHD_OFFSET, PCE_OVERHD_OVERHD_SHIFT,
 		PCE_OVERHD_OVERHD_SIZE, 20);
 
+	/* Set SW multicast snooping mode, if HW snooping is not supported */
+	if (PrvData->mcsthw_snoop == MCAST_HWSNOOP_DIS) {
+		gsw_w32(cdev, PCE_GCTRL_0_IGMP_OFFSET, PCE_GCTRL_0_IGMP_SHIFT,
+			PCE_GCTRL_0_IGMP_SIZE, 1);
+	}
+
 	/** Parser Micro Code Init */
 #if defined(CONFIG_USE_EMULATOR)
 	gsw_w32(cdev, PCE_GCTRL_0_MC_VALID_OFFSET,
@@ -10992,7 +11000,8 @@ GSW_return_t GSW_MulticastSnoopCfgSet(void *cdev,
 			PCE_IGMP_CTRL_SRPEN_SIZE, 0);
 		gsw_w32(cdev, PCE_GCTRL_0_IGMP_OFFSET,
 			PCE_GCTRL_0_IGMP_SHIFT,
-			PCE_GCTRL_0_IGMP_SIZE, 0);
+			PCE_GCTRL_0_IGMP_SIZE,
+			gswdev->mcsthw_snoop == MCAST_HWSNOOP_DIS ? 1 : 0);
 
 		for (i = 0; i <= gswdev->tpnum; i++) {
 			gsw_w32(cdev, PCE_PCTRL_0_MCST_OFFSET + (0xA * i),
