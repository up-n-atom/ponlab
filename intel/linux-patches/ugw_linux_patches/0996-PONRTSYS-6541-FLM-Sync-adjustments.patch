From a7237dd5905d55c63490341eda6657a9790a376e Mon Sep 17 00:00:00 2001
From: ofirbitt <ofir1.bitton@intel.com>
Date: Mon, 3 Feb 2020 16:34:42 +0200
Subject: [PATCH] PONRTSYS-6541: FLM Sync adjustments

---
 drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_uc_defs.h |  2 +-
 drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.c   |  3 ++-
 drivers/net/ppv4/pp-dev/pp_dts.c                    | 10 +++++++++-
 drivers/net/ppv4/pp-hal/descriptor/pp_desc.h        | 12 ++++++++++++
 4 files changed, 24 insertions(+), 3 deletions(-)

diff --git a/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_uc_defs.h b/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_uc_defs.h
index 546903c504f2..3f2d2d3a3150 100644
--- a/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_uc_defs.h
+++ b/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_uc_defs.h
@@ -12,7 +12,7 @@
 /* UC version */
 #define UC_VERSION_MAJOR (1)
 #define UC_VERSION_MINOR (10)
-#define UC_VERSION_BUILD (0)
+#define UC_VERSION_BUILD (1)
 
 #define QOS_MAX_PREDECESSORS       (6)
 #define QOS_AQM_CONTEXT_MAX_QUEUES (8)
diff --git a/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.c b/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.c
index 3cd70688401c..94fe70b4ba4f 100644
--- a/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.c
+++ b/drivers/net/ppv4/pp-api/pp-qos-mgr/pp_qos_utils.c
@@ -4150,7 +4150,8 @@ void qos_descriptor_push(struct pp_qos_dev *qdev, u32 queue_id, u32 size,
 	}
 
 	create_push_desc_cmd(qdev, node->data.queue.rlm, size, pool, policy,
-			     color, gpid, data_off, addr >> 7);
+			     color, gpid, data_off,
+			     addr >> QOS_DESC_PKT_PTR_SHIFT);
 	update_cmd_id(&qdev->drvcmds);
 	ret = transmit_cmds(qdev);
 	if (unlikely(ret))
diff --git a/drivers/net/ppv4/pp-dev/pp_dts.c b/drivers/net/ppv4/pp-dev/pp_dts.c
index 689bbe8941f9..28f35f688c52 100644
--- a/drivers/net/ppv4/pp-dev/pp_dts.c
+++ b/drivers/net/ppv4/pp-dev/pp_dts.c
@@ -514,10 +514,18 @@ static s32 __dts_bmgr_cfg(struct pp_dts_cfg *dts_cfg)
 	}
 
 	ret = __dts_phys_addr_get(pdev, "bmgr-pop-push",
-				  &dts_cfg->bm_params.bm_pop_push_addr);
+					&dts_cfg->bm_params.bm_pop_push_addr);
 	if (unlikely(ret))
 		return ret;
 
+	/* for FLM address handling differs */
+	if (!IS_ENABLED(CONFIG_PPV4_LGM)) {
+		ret = __dts_u32_param_get(pdev, np, "bmgr-pop-push-hw",
+					  &dts_cfg->bm_params.bm_pop_push_addr);
+		if (unlikely(ret))
+			return ret;
+	}
+
 	/* Fetch bm base address */
 	ret = __dts_virt_addr_remap(pdev, "reg-config",
 				    &dts_cfg->bm_params.bm_base);
diff --git a/drivers/net/ppv4/pp-hal/descriptor/pp_desc.h b/drivers/net/ppv4/pp-hal/descriptor/pp_desc.h
index 5ef749d20986..0ec43b07e0c7 100644
--- a/drivers/net/ppv4/pp-hal/descriptor/pp_desc.h
+++ b/drivers/net/ppv4/pp-hal/descriptor/pp_desc.h
@@ -200,6 +200,12 @@ enum pp_desc_fld {
 #define DESC_FLD_PRV_PS_B_LSB          (0  + 13 * BITS_PER_U32)
 #define DESC_FLD_PRV_PS_B_MSB          (15 + 13 * BITS_PER_U32)
 
+/**
+ * @define QOS_DESC_PKT_PTR_SHIFT
+ * @brief Once packet pointer is written to descriptor is must be shifted
+ */
+#define QOS_DESC_PKT_PTR_SHIFT         (7)
+
 /**
  * @define UD_DESC_WORDS_CNT
  * @brief ud size in descriptor in 32bit words granularity
@@ -305,6 +311,12 @@ s32 pp_desc_dump(struct pp_desc *desc);
  */
 void pp_desc_init(void);
 #else
+/**
+ * @define QOS_DESC_PKT_PTR_SHIFT
+ * @brief Once packet pointer is written to descriptor is must be shifted
+ */
+#define QOS_DESC_PKT_PTR_SHIFT         (0)
+
 static inline void pp_desc_init(void)
 {
 }
