From 56cf3f2bb08ac92d324f038db2a29be92d0aa559 Mon Sep 17 00:00:00 2001
From: vrp <vijaykumar.rp@intel.com>
Date: Thu, 1 Oct 2020 11:43:30 +0530
Subject: [PATCH] UGW_SW-52923: Adding QoS OP flag which indicates vap qos

---
 drivers/net/ethernet/lantiq/ppa/ppa_drv_wrapper.c | 6 +++---
 include/net/ppa/ltq_mpe_hal.h                     | 2 +-
 include/uapi/net/ppa_api.h                        | 3 +++
 3 files changed, 7 insertions(+), 4 deletions(-)

diff --git a/drivers/net/ethernet/lantiq/ppa/ppa_drv_wrapper.c b/drivers/net/ethernet/lantiq/ppa/ppa_drv_wrapper.c
index e632cfa5704b..6c6586dfd89b 100644
--- a/drivers/net/ethernet/lantiq/ppa/ppa_drv_wrapper.c
+++ b/drivers/net/ethernet/lantiq/ppa/ppa_drv_wrapper.c
@@ -232,7 +232,7 @@ int32_t (*tmu_hal_set_lro_queue_map_hook_fn)(uint32_t pmac_port) = NULL;
 EXPORT_SYMBOL(tmu_hal_set_lro_queue_map_hook_fn);
 
 int32_t (*mpe_hal_set_checksum_queue_map_hook_fn)(
-		uint32_t pmac_port, bool is_pmac_hdr_req, bool is_pon) = NULL;
+		uint32_t pmac_port, uint32_t flags) = NULL;
 EXPORT_SYMBOL(mpe_hal_set_checksum_queue_map_hook_fn);
 
 #if IS_ENABLED(CONFIG_PPA_TMU_MIB_SUPPORT)
@@ -317,11 +317,11 @@ int32_t ppa_drv_tmu_set_lro_queue_map(uint32_t pmac_port)
 }
 EXPORT_SYMBOL(ppa_drv_tmu_set_lro_queue_map);
 
-int32_t ppa_drv_mpe_set_checksum_queue_map(uint32_t pmac_port, bool is_pmac_hdr_req, bool is_pon)
+int32_t ppa_drv_mpe_set_checksum_queue_map(uint32_t pmac_port, uint32_t flags)
 {
 	if(!mpe_hal_set_checksum_queue_map_hook_fn)
 		return PPA_EINVAL;
-	return mpe_hal_set_checksum_queue_map_hook_fn(pmac_port, is_pmac_hdr_req, is_pon);
+	return mpe_hal_set_checksum_queue_map_hook_fn(pmac_port, flags);
 }
 EXPORT_SYMBOL(ppa_drv_mpe_set_checksum_queue_map);
 #endif
diff --git a/include/net/ppa/ltq_mpe_hal.h b/include/net/ppa/ltq_mpe_hal.h
index 56a4838a3e94..990ded16a917 100644
--- a/include/net/ppa/ltq_mpe_hal.h
+++ b/include/net/ppa/ltq_mpe_hal.h
@@ -65,6 +65,6 @@ extern int (*mpe_hal_feature_start_fn)(
 
 #if defined(CONFIG_SOC_GRX500) && CONFIG_SOC_GRX500
 extern int32_t (*mpe_hal_set_checksum_queue_map_hook_fn) (uint32_t pmac_port,
-		bool is_pmac_hdr_req, bool is_pon);
+		uint32_t flags);
 #endif
 #endif  /*  ___MPE_HAL_H__20081119_1144__*/
diff --git a/include/uapi/net/ppa_api.h b/include/uapi/net/ppa_api.h
index d36e6f8cdbdc..5fdad78baf82 100755
--- a/include/uapi/net/ppa_api.h
+++ b/include/uapi/net/ppa_api.h
@@ -420,6 +420,9 @@
 /*!
   \brief PPA_QOS_Q_F_SP_WFQ */
 #define PPA_QOS_Q_F_SP_WFQ	0x00020000 /*!< QoS configured in SP+WFQ mode */
+/*!
+  \brief Macro specifying VAP QoS Operations */
+#define PPA_QOS_Q_F_VAP_QOS		0x00040000
 /*!
 	\brief PPA_F_PPPOATM */
 #define PPA_F_PPPOATM				0x80000000
