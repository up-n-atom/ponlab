From f1d677f620ccdfd33728e6f52eaadef95da49253 Mon Sep 17 00:00:00 2001
From: Jack Ping CHNG <jack.ping.chng@linux.intel.com>
Date: Wed, 16 Sep 2020 20:17:44 +0800
Subject: [PATCH] DRV_DPM_SW-383: DPM check and free dp_dev when no ops is
 register

---
 drivers/net/datapath/dpm/datapath_instance.c | 28 ++++++++++++++++++++++------
 1 file changed, 22 insertions(+), 6 deletions(-)

diff --git a/drivers/net/datapath/dpm/datapath_instance.c b/drivers/net/datapath/dpm/datapath_instance.c
index 9a997f926144..f274c175d7e9 100644
--- a/drivers/net/datapath/dpm/datapath_instance.c
+++ b/drivers/net/datapath/dpm/datapath_instance.c
@@ -226,6 +226,22 @@ static int dp_ndo_setup_tc(struct net_device *dev,
 #endif /* LINUX_VERSION_CODE */
 #endif /* CONFIG_QOS_MGR */
 
+static void dp_check_and_free_dp_dev(struct net_device *dev)
+{
+	struct dp_dev *dp_dev;
+
+	dp_dev = dp_dev_lookup(dev);
+	if (!dp_dev)
+		return;
+
+	/* If failed to set ops, and no other owner */
+	if (!dp_dev->cb_cnt && !(dp_dev->owner & DP_OPS_OWNER_DPM)) {
+		hlist_del(&dp_dev->hlist);
+		dp_ops_reset(dp_dev, dev);
+		kmem_cache_free(cache_dev_list, dp_dev);
+	}
+}
+
 int dp_inst_add_dev(struct net_device *dev, int inst,
 		    int ep, int bp, int ctp, u32 flag)
 {
@@ -360,6 +376,11 @@ int dp_inst_del_dev(struct net_device *dev, int inst,
 #if IS_ENABLED(CONFIG_INTEL_DATAPATH_PTP1588)
 			dp_register_ptp_ioctl(dp_dev, 1);
 #endif
+			/* Since all the ops are enable by CONFIG,
+			 * there is a possibility that no ops are set.
+			 * Check again to avoid not freeing dp_dev.
+			 */
+			dp_check_and_free_dp_dev(dev);
 		}
 		return 0;
 	}
@@ -475,12 +496,7 @@ int dp_set_net_dev_ops_priv(struct net_device *dev, void *ops_cb,
 	}
 
 ERR:
-	/* If failed to set ops, and no other owner */
-	if (!dp_dev->cb_cnt && !(dp_dev->owner & DP_OPS_OWNER_DPM)) {
-		hlist_del(&dp_dev->hlist);
-		dp_ops_reset(dp_dev, dev);
-		kmem_cache_free(cache_dev_list, dp_dev);
-	}
+	dp_check_and_free_dp_dev(dev);
 
 EXIT:
 	return err;
