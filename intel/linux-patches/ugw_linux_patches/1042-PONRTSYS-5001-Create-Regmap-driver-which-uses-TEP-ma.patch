+
+	msg.src_client_id = RM;
+	msg.dst_client_id = RM;
+	msg.msg_id = REGMAP_RD_MSGID;
+	msg.param[0] = (uint32_t)paddr;
+
+	retmsg = icc_sync_write(RM, &msg);
