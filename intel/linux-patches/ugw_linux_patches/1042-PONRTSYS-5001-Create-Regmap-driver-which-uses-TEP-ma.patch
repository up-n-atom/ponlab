 #ifndef __LIBRARY__
+/*******************************************************************************
+Description:
+Arguments:
+Note:
+*******************************************************************************/
+icc_msg_t *icc_sync_write(icc_devices icdev, icc_msg_t *buf)
+{
+	int ret;
+	int i = 0;
+	icc_msg_t *rx_icc;
+	
+	if(icdev < MAX_CLIENT && icdev > ICC_Client && iccdev[icdev].Installed == 0) {
+		icc_open((struct inode *)icdev,NULL);
+	}
+	
+	if(down_interruptible(&icc_sync_sem))
+		return NULL;
+	ret = icc_write(icdev,buf);
+	if(ret < 0){
+		TRACE(ICC, DBG_LEVEL_HIGH, ("icc write failed\n"));
+		up(&icc_sync_sem);
+		return NULL;
+	}
+	ret = wait_event_interruptible_timeout(
+			 iccdev[icdev].wakeuplist,
+			(icc_excpt[icdev] != 0),HZ);
+	if (ret == 0 || ret == -ERESTARTSYS) {
+		TRACE(ICC, DBG_LEVEL_HIGH, ("Peer side not responding\n"));
+		up(&icc_sync_sem);
+		return NULL;
+	}
+	icc_excpt[icdev] = 0;
+	rx_icc = kzalloc(sizeof(icc_msg_t), GFP_KERNEL);
+	if (rx_icc == NULL) {
+		printk("alloc failed\n");
+		up(&icc_sync_sem);
+		return NULL;
+	}
+        ret = icc_read(icdev, rx_icc);
+	up(&icc_sync_sem);
+	if (ret < 0) {
+		printk("Read from ICC failed\n");
+		kfree(rx_icc);
+		return NULL;
+	}
+	return rx_icc;
+}
+EXPORT_SYMBOL(icc_sync_write);
