From 1923f3e8e75d376c5a20274f63dd98ebf76a3b26 Mon Sep 17 00:00:00 2001
From: Jan Dominiak <janx.dominiak@intel.com>
Date: Tue, 10 Nov 2020 15:37:36 +0100
Subject: [PATCH] PONRTSYS-8252: BBF-247 fails: TC_6.1.13...6.1.18 failing due
 to "Error on received stream"

* only untagged ARP packets are trapped in CPU
---
 drivers/net/datapath/pon_qos/pon_qos_tc_trap.c | 41 ++++++++++++++------------
 1 file changed, 22 insertions(+), 19 deletions(-)

diff --git a/drivers/net/datapath/pon_qos/pon_qos_tc_trap.c b/drivers/net/datapath/pon_qos/pon_qos_tc_trap.c
index aafcee503e4d..83ef0cdd9767 100644
--- a/drivers/net/datapath/pon_qos/pon_qos_tc_trap.c
+++ b/drivers/net/datapath/pon_qos/pon_qos_tc_trap.c
@@ -51,6 +51,7 @@ static void pon_qos_trap_set_default(struct net_device *dev,
 	pce_rule->pattern.bEnable = 1;
 	pce_rule->pattern.bInsertionFlag_Enable = 1;
 	pce_rule->pattern.nInsertionFlag = 0;
+	pce_rule->pattern.bSLAN_Vid = 1;
 	pce_rule->region = GSW_PCE_RULE_COMMMON;
 
 	pce_blk_info->region = pce_rule->region;
@@ -175,36 +176,38 @@ static void pon_qos_trap_parse_key_vlan(struct net_device *dev,
 					const struct tc_cls_flower_offload *f,
 					GSW_PCE_rule_t *pce_rule)
 {
+	struct flow_dissector_key_vlan *key = NULL;
+	struct flow_dissector_key_vlan *mask = NULL;
+
 	if (dissector_uses_key(f->dissector, FLOW_DISSECTOR_KEY_VLAN)) {
-		struct flow_dissector_key_vlan *key =
-			skb_flow_dissector_target(f->dissector,
+		key = skb_flow_dissector_target(f->dissector,
 						  FLOW_DISSECTOR_KEY_VLAN,
 						  f->key);
-		struct flow_dissector_key_vlan *mask =
-			skb_flow_dissector_target(f->dissector,
+		mask = skb_flow_dissector_target(f->dissector,
 						  FLOW_DISSECTOR_KEY_VLAN,
 						  f->mask);
-
-		if (mask->vlan_id == 0xfff) {
-			pce_rule->pattern.bSLAN_Vid = 1;
+		if (!key && key->vlan_id && !mask && mask->vlan_id == 0xfff) {
 			pce_rule->pattern.nSLAN_Vid = key->vlan_id;
-			netdev_dbg(dev, "%s: bSLAN_Vid = %d\n",
-				   __func__, pce_rule->pattern.bSLAN_Vid);
-			netdev_dbg(dev, "%s: nSLAN_Vid = %d\n",
-				   __func__, pce_rule->pattern.nSLAN_Vid);
+			return;
 		}
 	}
 
-	if (pce_rule->pattern.nSLAN_Vid == 0 &&
-	    eth_type_vlan(f->common.protocol)) {
-		pce_rule->pattern.bSVidRange_Select = 1;
-		pce_rule->pattern.nOuterVidRange = 4095;
-		netdev_dbg(dev, "%s: nOuterVidRange = %d\n",
-			   __func__, pce_rule->pattern.nOuterVidRange);
-		netdev_dbg(dev, "%s: bSVidRange_Select = %d\n",
-			   __func__, pce_rule->pattern.bSVidRange_Select);
+	pce_rule->pattern.nOuterVidRange = 4095;
+	pce_rule->pattern.bSVidRange_Select = 1;
+
+	if (eth_type_vlan(f->common.protocol)) {
+		pce_rule->pattern.bSLANVid_Exclude = 0;
+	} else {
+		pce_rule->pattern.bSLANVid_Exclude = 1;
 	}
 
+	netdev_dbg(dev, "%s: nOuterVidRange = %d\n",
+			__func__, pce_rule->pattern.nOuterVidRange);
+	netdev_dbg(dev, "%s: bSVidRange_Select = %d\n",
+			__func__, pce_rule->pattern.bSVidRange_Select);
+	netdev_dbg(dev, "%s: bSLANVid_Exclude = %d\n",
+			__func__, pce_rule->pattern.bSLANVid_Exclude);
+
 	return;
 }
 
