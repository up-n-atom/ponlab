-	dp->max_sch_lvl = 0;
-	priv = HAL(dp->inst);
-	if (!priv) {
-		pr_err("priv cannot be NULL\n");
-		return DP_FAILURE;
-	}
-
-	for (i = 0; i < MAX_QUEUE; i++) {
-		if (priv->qos_queue_stat[i].flag & PP_NODE_FREE)
-			continue;
-		id = priv->qos_queue_stat[i].node_id;
