-		vcfg->sFilter.eEtherType = vlan_list[i].ether_type;
-
-		if (drop) {
-			vcfg->sTreatment.eRemoveTag =
-				GSW_EXTENDEDVLAN_TREATMENT_DISCARD_UPSTREAM;
-		} else {
-			vcfg->sTreatment.eRemoveTag =
-				GSW_EXTENDEDVLAN_TREATMENT_REMOVE_1_TAG;
