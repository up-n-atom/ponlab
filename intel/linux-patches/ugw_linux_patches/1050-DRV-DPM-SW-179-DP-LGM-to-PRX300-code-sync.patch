-static int write_vtetype(struct core_ops *ops, u16 val)
-{
-	int ret;
-	GSW_register_t reg = {0};
-
-	reg.nRegAddr = 0xA42;
-	reg.nData = val;
-	ret = ops->gsw_common_ops.RegisterSet(ops, &reg);
-	if (ret == GSW_statusOk)
-		return 0;
-	else
-		return -EIO;
-}
