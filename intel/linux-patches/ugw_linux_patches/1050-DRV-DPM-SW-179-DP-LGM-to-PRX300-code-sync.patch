-static int bp_diff(u32 *bp0, u32 num_bp0, u32 *bp1)
-{
-	u32 i, j;
-
-	for (i = 0; i < num_bp0; i++) {
-		for (j = 0; j < num_bp0 && bp0[j] != bp1[i]; j++)
-			;
-		if (j >= num_bp0)
-			break;
-	}
-	return i;
-}
