-			 temp.type,
-			 id);
-		if ((temp.type == DP_NODE_SCH &&
-		     priv->qos_sch_stat[id].child_num) ||
-		    (temp.type == DP_NODE_PORT &&
-		     priv->deq_port_stat[id].child_num)) {
