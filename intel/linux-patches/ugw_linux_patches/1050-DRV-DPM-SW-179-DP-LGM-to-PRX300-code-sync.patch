-	     k < (res->cqm_deq_port + port_num);
-	     k++) {
-		if (priv->deq_port_stat[k].flag == PP_NODE_FREE)
-			continue;
-		q_num = 0;
-		if (qos_port_get_queues_32(priv->qdev,
