From 708565adb6c3f7d15ff024b25c937c50c84ae701 Mon Sep 17 00:00:00 2001
From: mdonthir <reddy.mallikarjun@intel.com>
Date: Fri, 18 Sep 2020 12:38:35 +0800
Subject: [PATCH] Bug fixed for Parser flag not getting set when vxlan port
 configured

Signed-off-by: mdonthir <reddy.mallikarjun@intel.com>
---
 drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c b/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c
index 7f5e79d61532..a04b828345b7 100644
--- a/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c
+++ b/drivers/net/ethernet/lantiq/switch-api/gsw_flow_core.c
@@ -27797,12 +27797,18 @@ GSW_return_t gsw_vxlan_cfg_set(void *cdev,
 		return GSW_statusErr;
 	}
 
-	vxlan_tbl_entry.val[3] = parm->vxlan_value & 0xFFFF;
 	vxlan_tbl_entry.table = PCE_PARS_INDEX;
 
 #ifdef __KERNEL__
 	spin_lock_bh(&gswdev->lock_pce);
 #endif
+	ret = gsw_pce_table_read(cdev, &vxlan_tbl_entry);
+	if (ret != GSW_statusOk) {
+		pr_err("Failed to read PCE TABLE %s:%s:%d\n", __FILE__, __func__, __LINE__);
+		ret = GSW_statusErr;
+		goto UNLOCK_AND_RETURN;
+	}
+	vxlan_tbl_entry.val[3] = parm->vxlan_value & 0xFFFF;
 
 	ret = gsw_pce_table_write(cdev, &vxlan_tbl_entry);
 	if (ret != GSW_statusOk) {
