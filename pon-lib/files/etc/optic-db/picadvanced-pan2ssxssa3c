# This file contains the transceiver pan2ssxssa3c settings
# Some technical identical transceiver  but  with a slightly different
# model name read out over i2c are covered by a corresponding symbolic links

package 'optic'

config 'optic' 'common'
	option 'mode' 'ngpon2_10G' # only for identification
	option 'bias_hold_time' '38580'
	option 'bias_setup_time' '0'
	option 'serdes_hold_time' '12860'
	option 'serdes_setup_time' '70730'
	option 'burst_idle_pattern' '0x00000000'
	option 'burst_en_mode' '1'
	option 'tx_en_mode' '0'
	option 'tx_pup_mode' '0'
	option 'sd_polarity' '0'
	option 'tx_power_scale' '0'
	option 'laser_setup_time' '16075'
	option 'laser_hold_time' '0'
	option 'gpio24_mode' '0'

config 'optic' 'twdm'
	option 'channel_count'	'4'
	option 'rx_wl_switch_time' '8000'
	option 'tx_wl_switch_time' '10'
	option 'free_spectral_range' '3000'
	option 'wl_ch_spacing' '100'
	option 'spectral_excursion' '20'
	option 'one_step_tuning_granularity' '0'
	option 'one_step_tuning_time' '0'
	option 'optical_link_type' 'AB'
	option 'tx_power_min' '4'
	option 'tx_power_max' '9'
	option 'cal_status_record' '0x3333000000000000'
	option 'channel_partition_index' '0'
	option 'dwlch_id' '0'
	option 'config_method' '3'
