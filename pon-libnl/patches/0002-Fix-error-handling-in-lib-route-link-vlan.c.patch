From bd9bd4c332913e1f731d1008962160cf8a42deb9 Mon Sep 17 00:00:00 2001
From: Thomas Langer <tlanger@maxlinear.com>
Date: Mon, 22 Mar 2021 13:08:58 +0100
Subject: Fix error handling in 'lib/route/link/vlan.c'

related to goto label nla_put_failure

Signed-off-by: Langer Thomas <tlanger@maxlinear.com>

Co-Authored-By: Kacper Ludwinski <kludwinski@maxlinear.com>
---
 lib/route/link/vlan.c | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/lib/route/link/vlan.c b/lib/route/link/vlan.c
index 7c5aa06..a075325 100644
--- a/lib/route/link/vlan.c
+++ b/lib/route/link/vlan.c
@@ -319,7 +319,7 @@ static int vlan_put_attrs(struct nl_msg *msg, struct rtnl_link *link)
 		int i;
 
 		if (!(qos = nla_nest_start(msg, IFLA_VLAN_INGRESS_QOS)))
-			goto nla_put_failure;
+			return -NLE_MSGSIZE;
 
 		for (i = 0; i <= VLAN_PRIO_MAX; i++) {
 			if (vi->vi_ingress_qos_mask & (1 << i)) {
@@ -339,7 +339,7 @@ static int vlan_put_attrs(struct nl_msg *msg, struct rtnl_link *link)
 		uint32_t i;
 
 		if (!(qos = nla_nest_start(msg, IFLA_VLAN_EGRESS_QOS)))
-			goto nla_put_failure;
+			return -NLE_MSGSIZE;
 
 		for (i = 0; i < vi->vi_negress; i++) {
 			map.from = vi->vi_egress_qos[i].vm_from;
@@ -352,10 +352,11 @@ static int vlan_put_attrs(struct nl_msg *msg, struct rtnl_link *link)
 	}
 
 	nla_nest_end(msg, data);
+	return 0;
 
 nla_put_failure:
-
-	return 0;
+	nla_nest_cancel(msg, data);
+	return -NLE_MSGSIZE;
 }
 
 static struct rtnl_link_info_ops vlan_info_ops = {
