+
+	if (tb[TCA_FLOWER_KEY_CVLAN_ID]) {
+		f->fl_cvlan_id = nla_get_u16(tb[TCA_FLOWER_KEY_CVLAN_ID]);
+		f->fl_mask |= FLOWER_ATTR_KEY_CVLAN_ID;
