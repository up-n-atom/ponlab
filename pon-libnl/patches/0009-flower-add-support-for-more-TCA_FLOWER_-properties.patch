+#define FLOWER_ATTR_FLAGS			(0x1 << 5)
+#define FLOWER_ATTR_CLASSID			(0x1 << 6)
+#define FLOWER_ATTR_KEY_ETH_DST			(0x1 << 7)
+#define FLOWER_ATTR_KEY_ETH_DST_MASK		(0x1 << 8)
+#define FLOWER_ATTR_KEY_ETH_SRC			(0x1 << 9)
+#define FLOWER_ATTR_KEY_ETH_SRC_MASK		(0x1 << 10)
+#define FLOWER_ATTR_KEY_IP_TOS			(0x1 << 11)
+#define FLOWER_ATTR_KEY_IP_TOS_MASK		(0x1 << 12)
+#define FLOWER_ATTR_KEY_CVLAN_ID		(0x1 << 13)
