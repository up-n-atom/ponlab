+
+	if (tb[TCA_FLOWER_KEY_CVLAN_PRIO]) {
+		f->fl_cvlan_prio = nla_get_u8(tb[TCA_FLOWER_KEY_CVLAN_PRIO]);
+		f->fl_mask |= FLOWER_ATTR_KEY_CVLAN_PRIO;
