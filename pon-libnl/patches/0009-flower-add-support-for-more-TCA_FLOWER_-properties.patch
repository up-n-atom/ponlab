+#define FLOWER_ATTR_KEY_VLAN_PRIO		(0x1 << 1)
+#define FLOWER_ATTR_KEY_VLAN_ETH_TYPE		(0x1 << 2)
+#define FLOWER_ATTR_INDEV			(0x1 << 3)
