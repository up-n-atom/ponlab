 include/netlink/route/link/bridge.h      |  3 +++
 lib/route/link.c                         | 26 ++++++++++++++++++++++++
 lib/route/link/bridge.c                  | 21 +++++++++++++++++++
 libnl-route-3.sym                        |  1 +
 5 files changed, 55 insertions(+)

