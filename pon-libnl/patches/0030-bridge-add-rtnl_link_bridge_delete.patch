diff --git a/lib/route/link.c b/lib/route/link.c
index 260185b..5bd8b3f 100644
--- a/lib/route/link.c
+++ b/lib/route/link.c
@@ -1704,6 +1704,32 @@ int rtnl_link_build_add_request(struct rtnl_link *link, int flags,
 	return build_link_msg(RTM_NEWLINK, &ifi, link, flags, result);
 }
 
+/**
+ * Build a netlink message requesting operation on the virtual link
+ * @arg link		link
+ * @arg flags		additional netlink message flags
+ * @arg result		pointer to store resulting netlink message
+ *
+ * The behaviour of this function is identical to rtnl_link_build_add_request()
+ * with the exception that it allows to specify message type
+ *
+ * @see rtnl_build_add_request()
+ *
+ * @return 0 on success or a negative error code.
+ */
+int rtnl_link_build_link_request(int cmd, struct rtnl_link *link, int flags,
+				 struct nl_msg **result)
+{
+	struct ifinfomsg ifi = {
+		.ifi_family = link->l_family,
+		.ifi_index = link->l_index,
+		.ifi_flags = link->l_flags,
+		.ifi_change = link->l_flag_mask,
+	};
+
+	return build_link_msg(cmd, &ifi, link, flags, result);
+}
+
 /**
  * Add virtual link
  * @arg sk		netlink socket.
diff --git a/lib/route/link/bridge.c b/lib/route/link/bridge.c
index 1e8d37d..03e49c9 100644
--- a/lib/route/link/bridge.c
+++ b/lib/route/link/bridge.c
@@ -609,6 +609,27 @@ int rtnl_link_bridge_add(struct nl_sock *sk, const char *name)
 	return err;
 }
 
+/**
+ * Send a RTM_DELLINK netlink message
+ * @arg sk              netlink socket
+ * @arg bridge          link object
+ *
+ * @return 0 on success or a negative error code
+*/
+int rtnl_link_bridge_delete(struct nl_sock *sk, struct rtnl_link *link)
+{
+	struct nl_msg *msg;
+	int err;
+
+	IS_BRIDGE_LINK_ASSERT(link);
+
+	err = rtnl_link_build_link_request(RTM_DELLINK, link, 0, &msg);
+	if (err < 0)
+		return err;
+
+	return nl_send_sync(sk, msg);
+}
+
