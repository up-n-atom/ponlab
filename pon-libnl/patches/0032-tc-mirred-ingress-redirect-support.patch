From 63891b19b6d693c04add1ad99c59f4ced2df3eec Mon Sep 17 00:00:00 2001
From: "Lenzeder, Joerg" <jlenzeder@maxlinear.com>
Date: Thu, 22 Jun 2023 12:43:24 +0200
Subject: Add support for VLAN forwarding using extvlan BP reassign action

Allow for tc action mirred ingress redirect
---
 lib/route/act/mirred.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/lib/route/act/mirred.c b/lib/route/act/mirred.c
index b674fb8..1d4cb8e 100644
--- a/lib/route/act/mirred.c
+++ b/lib/route/act/mirred.c
@@ -141,9 +141,9 @@ int rtnl_mirred_set_action(struct rtnl_act *act, int action)
 	switch (action) {
 	case TCA_EGRESS_MIRROR:
 	case TCA_EGRESS_REDIR:
+	case TCA_INGRESS_REDIR:
 		u->m_parm.eaction = action;
 		break;
-	case TCA_INGRESS_REDIR:
 	case TCA_INGRESS_MIRROR:
 	default:
 		return NLE_OPNOTSUPP;
@@ -193,9 +193,9 @@ int rtnl_mirred_set_policy(struct rtnl_act *act, int policy)
 	switch (u->m_parm.eaction) {
 	case TCA_EGRESS_MIRROR:
 	case TCA_EGRESS_REDIR:
+	case TCA_INGRESS_REDIR:
 		u->m_parm.action = policy;
 		break;
-	case TCA_INGRESS_REDIR:
 	case TCA_INGRESS_MIRROR:
 	default:
 		return NLE_OPNOTSUPP;
-- 
2.17.1

