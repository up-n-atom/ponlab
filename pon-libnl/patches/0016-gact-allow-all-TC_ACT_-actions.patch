From d1842fb3140355b1e032cde3cc783c3a2111bc22 Mon Sep 17 00:00:00 2001
From: Przemyslaw Czarnota <przemyslawx.czarnota@intel.com>
Date: Fri, 11 Sep 2020 17:13:07 +0200
Subject: gact: allow all TC_ACT_* actions

---
 lib/route/act/gact.c | 14 +-------------
 1 file changed, 1 insertion(+), 13 deletions(-)

diff --git a/lib/route/act/gact.c b/lib/route/act/gact.c
index e37ef9f..159eace 100644
--- a/lib/route/act/gact.c
+++ b/lib/route/act/gact.c
@@ -126,19 +126,7 @@ int rtnl_gact_set_action(struct rtnl_act *act, int action)
 	if (!(u = (struct rtnl_gact *) rtnl_tc_data(TC_CAST(act))))
 		return -NLE_NOMEM;
 
-	if (action > TC_ACT_SHOT || action < TC_ACT_UNSPEC)
-		return -NLE_INVAL;
-
-	switch (action) {
-	case TC_ACT_UNSPEC:
-	case TC_ACT_SHOT:
-		u->g_parm.action = action;
-		break;
-	case TC_ACT_OK:
-	case TC_ACT_RECLASSIFY:
-	default:
-		return NLE_OPNOTSUPP;
-	}
+	u->g_parm.action = action;
 
 	return 0;
 }
