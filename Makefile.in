install-exec-hook: $(bin_PROGRAMS)
	@for p in $(bin_PROGRAMS); do \
		$(STRIP) --strip-debug $(DESTDIR)$(bindir)/$$p; \
		echo "  $(STRIP) --strip-debug $(DESTDIR)$(bindir)/$$p"; \
	done

@KERNEL_2_6_TRUE@drv_kpi2udp.ko: $(drv_kpi2udp_SOURCES) $(nodist_EXTRA_drv_kpi2udp_SOURCES) $(EXTRA_DIST)
@KERNEL_2_6_TRUE@	@echo -e "Making Linux 2.6.x kernel object"
@KERNEL_2_6_TRUE@	@for f in $(drv_kpi2udp_SOURCES) ; do \
@KERNEL_2_6_TRUE@		if test ! -e $(top_builddir)/$$f; then \
@KERNEL_2_6_TRUE@			echo "  LN      $$f" ; \
@KERNEL_2_6_TRUE@			mkdir -p $(PWD)/`dirname $$f`/; \
@KERNEL_2_6_TRUE@			ln -s @abs_srcdir@/$$f $(top_builddir)/$$f; \
@KERNEL_2_6_TRUE@		fi; \
@KERNEL_2_6_TRUE@	done;
@KERNEL_2_6_TRUE@	@echo -e "# drv_kpi2udp: Generated to build Linux 2.6.x kernel object" > $(top_builddir)/Kbuild
@KERNEL_2_6_TRUE@	@echo -e "obj-m := $(subst .ko,.o,$@)"			>> $(top_builddir)/Kbuild
@KERNEL_2_6_TRUE@	@echo -e "$(subst .ko,,$@)-y := $(drv_kpi2udp_OBJS)"	>> $(top_builddir)/Kbuild
@KERNEL_2_6_TRUE@	@echo -e "EXTRA_CFLAGS := -DHAVE_CONFIG_H  $(drv_kpi2udp_CFLAGS) $(INCLUDES)"	>> $(top_builddir)/Kbuild
@KERNEL_2_6_TRUE@	$(MAKE) ARCH=@KERNEL_ARCH@ -C @KERNEL_BUILD_PATH@ O=@KERNEL_BUILD_PATH@ M=`pwd` modules

@KERNEL_2_6_TRUE@clean-generic:
@KERNEL_2_6_TRUE@	@echo "drv_kpi2udp: Cleanup Linux 2.6.x kernel object build"
@KERNEL_2_6_TRUE@	@- find . -name ".*.cmd" | xargs rm -f
@KERNEL_2_6_TRUE@	@- find . -name "*.o" | xargs rm -f
@KERNEL_2_6_TRUE@	@- rm -f Module.symvers Kbuild modules.order
@KERNEL_2_6_TRUE@	@- rm -rf .tmp_versions drv_kpi2udp.mod.c

# Make subdirectories inside tar.gz writable for everyone
# (required for 2.6 kbuild)
dist-hook:
	find $(distdir) -type d -exec chmod 777 {} \; -print

# Create self extracting linux distribution
distcheck-hook:
	@echo -n "Checking for the line ending style... "; \
	failure_list="`find $(distdir) -path '$(distdir)/doc' -prune -o -type f -exec grep -UIqsc $$'\r$$' {} \; -printf '\tDOS line ending style: %p\n'`"; \
	if test -z "$$failure_list"; then \
		echo "Ok"; \
	else \
		echo "FAIL"; \
		echo "$$failure_list"; \
		echo; \
		exit -1; \
	fi
	makeself.sh --gzip --notemp $(distdir) drv_kpi2udp-${PACKAGE_VERSION}.sh \
	"${PACKAGE_NAME}"

distvob:
	cleartool mkact -nc distvob_drv_tapi_kpi2udp_${PACKAGE_VERSION}_`date +"%H%M"`
	@if test `\ls /var/vob/comacsd/comacsd_dist/ifx-voice-tapi-kpi2udp/*.tar.gz` != "/var/vob/comacsd/comacsd_dist/ifx-voice-tapi-kpi2udp/drv_kpi2udp-${PACKAGE_VERSION}.tar.gz"; then\
	   cleartool co -nc /var/vob/comacsd/comacsd_dist/ifx-voice-tapi-kpi2udp; \
	   cleartool mv `\ls /var/vob/comacsd/comacsd_dist/ifx-voice-tapi-kpi2udp/*.tar.gz` /var/vob/comacsd/comacsd_dist/ifx-voice-tapi-kpi2udp/drv_kpi2udp-${PACKAGE_VERSION}.tar.gz; \
	   cleartool ci -nc /var/vob/comacsd/comacsd_dist/ifx-voice-tapi-kpi2udp; \
	fi;
	cleartool co -nc /var/vob/comacsd/comacsd_dist/ifx-voice-tapi-kpi2udp/drv_kpi2udp-${PACKAGE_VERSION}.tar.gz
	cp drv_kpi2udp-${PACKAGE_VERSION}.tar.gz /var/vob/comacsd/comacsd_dist/ifx-voice-tapi-kpi2udp
	cleartool ci -nc /var/vob/comacsd/comacsd_dist/ifx-voice-tapi-kpi2udp/drv_kpi2udp-${PACKAGE_VERSION}.tar.gz

# Tell versions [3.59,3.63) of GNU make to not export all variables.
# Otherwise a system limit (for SysV at least) may be exceeded.
.NOEXPORT:
